// Draw a single character. Positions are rounded to whole pixels.
// Uses run-length row rendering for vertex efficiency.
void draw_char(f32 x, f32 y, f32 scale, i32 ch, f32 r, f32 g, f32 b) {
    if ch < 32 || ch > 127 { return; }
    i32 idx = (ch - 32) * 8;
    f32 bx = floorf(x);
    f32 by = floorf(y);
    f32 sc = floorf(scale);

    for i32 row = 0; row < 8; row = row + 1 {
        i32 byte = cast(i32, font_data[idx + row]);
        if byte != 0 {
            i32 col = 0;
            while col < 8 {
                if (byte & (128 >> col)) != 0 {
                    i32 run_start = col;
                    while col < 8 && (byte & (128 >> col)) != 0 {
                        col = col + 1;
                    }
                    i32 run_len = col - run_start;
                    draw_rect(bx + cast(f32, run_start) * sc,
                              by + cast(f32, row) * sc,
                              cast(f32, run_len) * sc,
                              sc, r, g, b);
                } else {
                    col = col + 1;
                }
            }
        }
    }
    return;
}

// Draw a null-terminated string. Returns the x position after the last character.
f32 draw_text(f32 x, f32 y, f32 scale, u8* text, f32 r, f32 g, f32 b) {
    f32 cx = floorf(x);
    f32 sc = floorf(scale);
    i32 i = 0;
    while *(text + i) != 0 {
        draw_char(cx, y, sc, cast(i32, *(text + i)), r, g, b);
        cx = cx + 8.0f * sc;
        i = i + 1;
    }
    return cx;
}

// Draw an integer value. Returns the x position after the last digit.
f32 draw_int(f32 x, f32 y, f32 scale, i32 val, f32 r, f32 g, f32 b) {
    f32 sc = floorf(scale);
    if val < 0 {
        draw_char(x, y, sc, 45, r, g, b);
        x = x + 8.0f * sc;
        val = 0 - val;
    }
    if val == 0 {
        draw_char(x, y, sc, 48, r, g, b);
        return x + 8.0f * sc;
    }

    i32[10] digits;
    i32 n = 0;
    i32 v = val;
    while v > 0 {
        digits[n] = v % 10;
        v = v / 10;
        n = n + 1;
    }

    f32 cx = floorf(x);
    for i32 i = n - 1; i >= 0; i = i - 1 {
        draw_char(cx, y, sc, 48 + digits[i], r, g, b);
        cx = cx + 8.0f * sc;
    }
    return cx;
}
