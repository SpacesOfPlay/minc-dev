// sokol_debugtext_font.mc — 8x8 bitmap font rendering for sokol apps
//
// Uses the Atari 400 ROM font (characters 0x20-0x7F, 96 glyphs).
// Renders text as colored rectangles into a vertex buffer.
//
// Requires: draw_rect(f32 x, f32 y, f32 w, f32 h, f32 r, f32 g, f32 b)
//           to be defined by the including file.
//
// Positions and scale are f32, rounded to whole pixels internally.
// Scale is floored to integer (1.0, 2.0, 3.0).
//
// Usage:
//   draw_text(10.0, 10.0, 2.0, "HELLO WORLD", 1.0f, 1.0f, 1.0f);

// From: https://github.com/floooh/sokol-samples/blob/master/sapp/debugtext-userfont-sapp.c
//
// Atari 400 ROM font — 96 characters (0x20 to 0x7F), 8 bytes each.
// Each byte is one row of 8 pixels, MSB = leftmost pixel.
//
