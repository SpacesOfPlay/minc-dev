WGPUStringView _sg_wgpu_stringview(u8* str_var) {
    noinit WGPUStringView res;
    if str_var != null {
        res.data = str_var;
        res.length = strlen(str_var);
    } else {
        res.data = null;
        res.length = 0;
    }
    return res;
}

WGPUOptionalBool _sg_wgpu_optional_bool(bool b) {
    return b != 0 ? WGPUOptionalBool_True : WGPUOptionalBool_False;
}

WGPUBufferUsage _sg_wgpu_buffer_usage(sg_buffer_usage* usg) {
    i32 res = 0;
    if usg.vertex_buffer != 0 {
        res |= cast(i32, WGPUBufferUsage_Vertex);
    }
    if usg.index_buffer != 0 {
        res |= cast(i32, WGPUBufferUsage_Index);
    }
    if usg.storage_buffer != 0 {
        res |= cast(i32, WGPUBufferUsage_Storage);
    }
    if usg.immutable == 0 {
        res |= cast(i32, WGPUBufferUsage_CopyDst);
    }
    return cast(WGPUBufferUsage, res);
}

WGPULoadOp _sg_wgpu_load_op(WGPUTextureView view, sg_load_action a) {
    if null == view {
        return WGPULoadOp_Undefined;
    } else {
        switch a {
            case SG_LOADACTION_CLEAR, SG_LOADACTION_DONTCARE: {
                return WGPULoadOp_Clear;
            }
            case SG_LOADACTION_LOAD: {
                return WGPULoadOp_Load;
            }
            default: {
                assert(cast(i64, false));
                return WGPULoadOp_Force32;
            }
        }
    }
}

WGPUStoreOp _sg_wgpu_store_op(WGPUTextureView view, sg_store_action a) {
    if null == view {
        return WGPUStoreOp_Undefined;
    } else {
        switch a {
            case SG_STOREACTION_STORE: {
                return WGPUStoreOp_Store;
            }
            case SG_STOREACTION_DONTCARE: {
                return WGPUStoreOp_Discard;
            }
            default: {
                assert(cast(i64, false));
                return WGPUStoreOp_Force32;
            }
        }
    }
}

WGPUTextureViewDimension _sg_wgpu_texture_view_dimension(sg_image_type t) {
    switch t {
        case SG_IMAGETYPE_2D: {
            return WGPUTextureViewDimension_2D;
        }
        case SG_IMAGETYPE_CUBE: {
            return WGPUTextureViewDimension_Cube;
        }
        case SG_IMAGETYPE_3D: {
            return WGPUTextureViewDimension_3D;
        }
        case SG_IMAGETYPE_ARRAY: {
            return WGPUTextureViewDimension_2DArray;
        }
        default: {
            assert(cast(i64, false));
            return WGPUTextureViewDimension_Force32;
        }
    }
}

WGPUTextureViewDimension _sg_wgpu_attachment_view_dimension(sg_image_type t) {
    switch t {
        case SG_IMAGETYPE_2D: {
            return WGPUTextureViewDimension_2D;
        }
        case SG_IMAGETYPE_CUBE: {
            return WGPUTextureViewDimension_2DArray;
        }
        case SG_IMAGETYPE_3D: {
            return WGPUTextureViewDimension_2D;
        }
        case SG_IMAGETYPE_ARRAY: {
            return WGPUTextureViewDimension_2DArray;
        }
        default: {
            assert(cast(i64, false));
            return WGPUTextureViewDimension_Force32;
        }
    }
}

WGPUTextureDimension _sg_wgpu_texture_dimension(sg_image_type t) {
    if SG_IMAGETYPE_3D == t {
        return WGPUTextureDimension_3D;
    } else {
        return WGPUTextureDimension_2D;
    }
}

WGPUTextureSampleType _sg_wgpu_texture_sample_type(sg_image_sample_type t, bool msaa) {
    switch t {
        case SG_IMAGESAMPLETYPE_FLOAT: {
            return msaa != 0 ? WGPUTextureSampleType_UnfilterableFloat : WGPUTextureSampleType_Float;
        }
        case SG_IMAGESAMPLETYPE_DEPTH: {
            return WGPUTextureSampleType_Depth;
        }
        case SG_IMAGESAMPLETYPE_SINT: {
            return WGPUTextureSampleType_Sint;
        }
        case SG_IMAGESAMPLETYPE_UINT: {
            return WGPUTextureSampleType_Uint;
        }
        case SG_IMAGESAMPLETYPE_UNFILTERABLE_FLOAT: {
            return WGPUTextureSampleType_UnfilterableFloat;
        }
        default: {
            assert(cast(i64, false));
            return WGPUTextureSampleType_Force32;
        }
    }
}

WGPUSamplerBindingType _sg_wgpu_sampler_binding_type(sg_sampler_type t) {
    switch t {
        case SG_SAMPLERTYPE_FILTERING: {
            return WGPUSamplerBindingType_Filtering;
        }
        case SG_SAMPLERTYPE_COMPARISON: {
            return WGPUSamplerBindingType_Comparison;
        }
        case SG_SAMPLERTYPE_NONFILTERING: {
            return WGPUSamplerBindingType_NonFiltering;
        }
        default: {
            assert(cast(i64, false));
            return WGPUSamplerBindingType_Force32;
        }
    }
}

WGPUAddressMode _sg_wgpu_sampler_address_mode(sg_wrap m) {
    switch m {
        case SG_WRAP_REPEAT: {
            return WGPUAddressMode_Repeat;
        }
        case SG_WRAP_CLAMP_TO_EDGE, SG_WRAP_CLAMP_TO_BORDER: {
            return WGPUAddressMode_ClampToEdge;
        }
        case SG_WRAP_MIRRORED_REPEAT: {
            return WGPUAddressMode_MirrorRepeat;
        }
        default: {
            assert(cast(i64, false));
            return WGPUAddressMode_Force32;
        }
    }
}

WGPUFilterMode _sg_wgpu_sampler_minmag_filter(sg_filter f) {
    switch f {
        case SG_FILTER_NEAREST: {
            return WGPUFilterMode_Nearest;
        }
        case SG_FILTER_LINEAR: {
            return WGPUFilterMode_Linear;
        }
        default: {
            assert(cast(i64, false));
            return WGPUFilterMode_Force32;
        }
    }
}

WGPUMipmapFilterMode _sg_wgpu_sampler_mipmap_filter(sg_filter f) {
    switch f {
        case SG_FILTER_NEAREST: {
            return WGPUMipmapFilterMode_Nearest;
        }
        case SG_FILTER_LINEAR: {
            return WGPUMipmapFilterMode_Linear;
        }
        default: {
            assert(cast(i64, false));
            return WGPUMipmapFilterMode_Force32;
        }
    }
}

WGPUIndexFormat _sg_wgpu_indexformat(sg_index_type t) {
    return t == SG_INDEXTYPE_UINT16 ? WGPUIndexFormat_Uint16 : WGPUIndexFormat_Uint32;
}

WGPUIndexFormat _sg_wgpu_stripindexformat(sg_primitive_type prim_type, sg_index_type idx_type) {
    if idx_type == SG_INDEXTYPE_NONE {
        return WGPUIndexFormat_Undefined;
    } else if prim_type == SG_PRIMITIVETYPE_LINE_STRIP || prim_type == SG_PRIMITIVETYPE_TRIANGLE_STRIP {
        return _sg_wgpu_indexformat(idx_type);
    } else {
        return WGPUIndexFormat_Undefined;
    }
}

WGPUVertexStepMode _sg_wgpu_stepmode(sg_vertex_step s) {
    return s == SG_VERTEXSTEP_PER_VERTEX ? WGPUVertexStepMode_Vertex : WGPUVertexStepMode_Instance;
}

