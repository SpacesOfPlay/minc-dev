    switch f {
        case SG_BLENDFACTOR_ZERO: {
            return GL_ZERO;
        }
        case SG_BLENDFACTOR_ONE: {
            return GL_ONE;
        }
        case SG_BLENDFACTOR_SRC_COLOR: {
            return GL_SRC_COLOR;
        }
        case SG_BLENDFACTOR_ONE_MINUS_SRC_COLOR: {
            return GL_ONE_MINUS_SRC_COLOR;
