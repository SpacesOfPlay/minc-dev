            return 0x8006;
        }
        case SG_BLENDOP_SUBTRACT: {
            return 0x800A;
        }
        case SG_BLENDOP_REVERSE_SUBTRACT: {
            return 0x800B;
        }
        case SG_BLENDOP_MIN: {
            return 0x8007;
