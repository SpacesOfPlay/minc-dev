MTLColorWriteMask _sg_mtl_color_write_mask(sg_color_mask m) {
    MTLColorWriteMask mtl_mask = MTLColorWriteMaskNone;
    if (m & SG_COLORMASK_R) != 0 {
        mtl_mask |= MTLColorWriteMaskRed;
    }
    if (m & SG_COLORMASK_G) != 0 {
        mtl_mask |= MTLColorWriteMaskGreen;
    }
    if (m & SG_COLORMASK_B) != 0 {
        mtl_mask |= MTLColorWriteMaskBlue;
    }
    if (m & SG_COLORMASK_A) != 0 {
        mtl_mask |= MTLColorWriteMaskAlpha;
    }
    return mtl_mask;
}
MTLBlendOperation _sg_mtl_blend_op(sg_blend_op op) {
    switch op {
        case SG_BLENDOP_ADD: {
            return MTLBlendOperationAdd;
        }
        case SG_BLENDOP_SUBTRACT: {
            return MTLBlendOperationSubtract;
        }
        case SG_BLENDOP_REVERSE_SUBTRACT: {
            return MTLBlendOperationReverseSubtract;
