void _sg_mtl_apply_uniforms(i32 ub_slot, sg_range* data) {
    assert(ub_slot >= 0 && ub_slot < SG_MAX_UNIFORMBLOCK_BINDSLOTS);
    assert(cast(u64, _sg.mtl.cur_ub_offset) + data.size <= cast(u64, _sg.mtl.ub_size));
    assert((_sg.mtl.cur_ub_offset & 16 - 1) == 0);
    _sg_pipeline_t* pip = _sg_pipeline_ref_ptr(&_sg.cur_pip);
    assert(cast(i64, pip));
    _sg_shader_t* shd = _sg_shader_ref_ptr(&pip.cmn.shader);
    assert(data.size == shd.cmn.uniform_blocks[ub_slot].size);
    sg_shader_stage stage = shd.cmn.uniform_blocks[ub_slot].stage;
    NSUInteger mtl_slot = shd.mtl.ub_buffer_n[ub_slot];
    u8* dst = &_sg.mtl.cur_ub_base_ptr[_sg.mtl.cur_ub_offset];
    memcpy(dst, data.ptr, data.size);
    if stage == SG_SHADERSTAGE_VERTEX {
        assert(null != _sg.mtl.render_cmd_encoder);
        cast(fn(void*, void*, u64, u64): void, objc.raw)(_sg.mtl.render_cmd_encoder, objc_selref("setVertexBufferOffset:atIndex:"), cast(u64, cast(NSUInteger, _sg.mtl.cur_ub_offset)), mtl_slot);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.metal.uniforms.num_set_vertex_buffer_offset++;
            }
        }
    } else if stage == SG_SHADERSTAGE_FRAGMENT {
        assert(null != _sg.mtl.render_cmd_encoder);
        cast(fn(void*, void*, u64, u64): void, objc.raw)(_sg.mtl.render_cmd_encoder, objc_selref("setFragmentBufferOffset:atIndex:"), cast(u64, cast(NSUInteger, _sg.mtl.cur_ub_offset)), mtl_slot);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.metal.uniforms.num_set_fragment_buffer_offset++;
            }
        }
    } else if stage == SG_SHADERSTAGE_COMPUTE {
        assert(null != _sg.mtl.compute_cmd_encoder);
        cast(fn(void*, void*, u64, u64): void, objc.raw)(_sg.mtl.compute_cmd_encoder, objc_selref("setBufferOffset:atIndex:"), cast(u64, cast(NSUInteger, _sg.mtl.cur_ub_offset)), mtl_slot);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.metal.uniforms.num_set_compute_buffer_offset++;
            }
        }
    } else {
        assert(cast(i64, false));
    }
    _sg.mtl.cur_ub_offset = _sg_roundup_pow2(_sg.mtl.cur_ub_offset + cast(i32, data.size), 16);
}



void _sg_mtl_update_buffer(_sg_buffer_t* buf, sg_range* data) {
    assert(buf && data && data.ptr && data.size > 0);
    if ++buf.cmn.active_slot >= buf.cmn.num_slots {
        buf.cmn.active_slot = 0;
    }
    ObjcId mtl_buf = _sg_mtl_id(buf.mtl.buf[buf.cmn.active_slot]);
    void* dst_ptr = objc.msg_id_v(mtl_buf, objc_selref("contents"));
    memcpy(dst_ptr, data.ptr, data.size);
}

void _sg_mtl_append_buffer(_sg_buffer_t* buf, sg_range* data, bool new_frame) {
    assert(buf && data && data.ptr && data.size > 0);
    if new_frame != 0 {
        if ++buf.cmn.active_slot >= buf.cmn.num_slots {
            buf.cmn.active_slot = 0;
        }
    }
    ObjcId mtl_buf = _sg_mtl_id(buf.mtl.buf[buf.cmn.active_slot]);
    var dst_ptr = cast(u8*, objc.msg_id_v(mtl_buf, objc_selref("contents")));
    dst_ptr += buf.cmn.append_pos;
    memcpy(dst_ptr, data.ptr, data.size);
}







































