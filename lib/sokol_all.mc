i8 _objc__sapp_textfield_dlg_textField_shouldChangeCharactersInRange_replacementString(void* self, void* _cmd, void* textField, NSRange range, void* string) {
    if _sapp_events_enabled() != 0 {
        NSUInteger len = cast(fn(void*, void*): u64, objc.raw)(string, objc_selref("length"));
        if len > 0 {
            for NSUInteger i = 0; i < len; i++ {
                unichar c = cast(fn(void*, void*, u64): u16, objc.raw)(string, objc_selref("characterAtIndex:"), i);
                if c >= 32 {
                    if c < 0xD800 || c > 0xDFFF {
                        _sapp_init_event(SAPP_EVENTTYPE_CHAR);
                        _sapp.event.char_code = c;
                        _sapp_call_event(&_sapp.event);
                    }
                }
                if c <= 32 {
                    sapp_keycode k = SAPP_KEYCODE_INVALID;
                    switch c {
                        case 10: {
                            k = SAPP_KEYCODE_ENTER;
                        }
                        case 32: {
                            k = SAPP_KEYCODE_SPACE;
                        }
                        default: {
                        }
                    }
                    if k != SAPP_KEYCODE_INVALID {
                        _sapp_init_event(SAPP_EVENTTYPE_KEY_DOWN);
                        _sapp.event.key_code = k;
                        _sapp_call_event(&_sapp.event);
                        _sapp_init_event(SAPP_EVENTTYPE_KEY_UP);
                        _sapp.event.key_code = k;
                        _sapp_call_event(&_sapp.event);
                    }
                }
            }
        } else {
            _sapp_init_event(SAPP_EVENTTYPE_KEY_DOWN);
            _sapp.event.key_code = SAPP_KEYCODE_BACKSPACE;
            _sapp_call_event(&_sapp.event);
            _sapp_init_event(SAPP_EVENTTYPE_KEY_UP);
            _sapp.event.key_code = SAPP_KEYCODE_BACKSPACE;
            _sapp_call_event(&_sapp.event);
        }
    }
    return false;
}

