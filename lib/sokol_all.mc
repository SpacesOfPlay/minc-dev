UINT8 _sg_d3d11_color_write_mask(sg_color_mask m) {
    UINT8 res = 0;
    if (m & SG_COLORMASK_R) != 0 {
        res |= cast(u8, D3D11_COLOR_WRITE_ENABLE_RED);
    }
    if (m & SG_COLORMASK_G) != 0 {
        res |= cast(u8, D3D11_COLOR_WRITE_ENABLE_GREEN);
    }
    if (m & SG_COLORMASK_B) != 0 {
        res |= cast(u8, D3D11_COLOR_WRITE_ENABLE_BLUE);
    }
    if (m & SG_COLORMASK_A) != 0 {
        res |= cast(u8, D3D11_COLOR_WRITE_ENABLE_ALPHA);
    }
    return res;
}

UINT _sg_d3d11_dxgi_fmt_caps(DXGI_FORMAT dxgi_fmt) {
    UINT dxgi_fmt_caps = 0;
    if dxgi_fmt != DXGI_FORMAT_UNKNOWN {
        HRESULT hr = _sg_d3d11_CheckFormatSupport(_sg.d3d11.dev, dxgi_fmt, &dxgi_fmt_caps);
        assert(hr >= 0 || E_FAIL == hr);
        if hr >= 0 == 0 {
            dxgi_fmt_caps = 0;
        }
    }
    return dxgi_fmt_caps;
}

void _sg_d3d11_init_caps() {
    _sg.backend = SG_BACKEND_D3D11;
    _sg.features.origin_top_left = true;
    _sg.features.image_clamp_to_border = true;
    _sg.features.mrt_independent_blend_state = true;
    _sg.features.mrt_independent_write_mask = true;
    _sg.features.compute = true;
    _sg.features.msaa_texture_bindings = true;
    _sg.features.draw_base_vertex = true;
    _sg.features.draw_base_instance = true;
    _sg.features.dual_source_blending = true;
    _sg.features.vertexformat_int10_n2 = false;
    _sg.limits.max_image_size_2d = 16 * 1024;
    _sg.limits.max_image_size_cube = 16 * 1024;
    _sg.limits.max_image_size_3d = 2 * 1024;
    _sg.limits.max_image_size_array = 16 * 1024;
    _sg.limits.max_image_array_layers = 2048;
    _sg.limits.max_vertex_attrs = SG_MAX_VERTEX_ATTRIBUTES;
    _sg.limits.max_color_attachments = 8 < SG_MAX_COLOR_ATTACHMENTS ? 8 : SG_MAX_COLOR_ATTACHMENTS;
    _sg.limits.max_texture_bindings_per_stage = 128 < SG_MAX_VIEW_BINDSLOTS ? 128 : SG_MAX_VIEW_BINDSLOTS;
    _sg.limits.max_storage_buffer_bindings_per_stage = 64 < SG_MAX_VIEW_BINDSLOTS ? 64 : SG_MAX_VIEW_BINDSLOTS;
    if _sg_d3d11_GetFeatureLevel(_sg.d3d11.dev) >= D3D_FEATURE_LEVEL_11_1 {
        _sg.limits.d3d11_max_unordered_access_views = 64 < SG_MAX_VIEW_BINDSLOTS ? 64 : SG_MAX_VIEW_BINDSLOTS;
    } else {
        _sg.limits.d3d11_max_unordered_access_views = 8 < SG_MAX_VIEW_BINDSLOTS ? 8 : SG_MAX_VIEW_BINDSLOTS;
    }
    _sg.limits.max_storage_image_bindings_per_stage = _sg.limits.d3d11_max_unordered_access_views;
    for i32 fmt = SG_PIXELFORMAT_NONE + 1; fmt < _SG_PIXELFORMAT_NUM; fmt++ {
        UINT srv_dxgi_fmt_caps = _sg_d3d11_dxgi_fmt_caps(_sg_d3d11_srv_pixel_format(cast(sg_pixel_format, fmt)));
        UINT rtv_uav_dxgi_fmt_caps = _sg_d3d11_dxgi_fmt_caps(_sg_d3d11_rtv_uav_pixel_format(cast(sg_pixel_format, fmt)));
        UINT dsv_dxgi_fmt_caps = _sg_d3d11_dxgi_fmt_caps(_sg_d3d11_dsv_pixel_format(cast(sg_pixel_format, fmt)));
        _sg_pixelformat_info_t* info = &_sg.formats[fmt];
        bool render = 0 != (rtv_uav_dxgi_fmt_caps & D3D11_FORMAT_SUPPORT_RENDER_TARGET);
        bool depth = 0 != (dsv_dxgi_fmt_caps & D3D11_FORMAT_SUPPORT_DEPTH_STENCIL);
        info.sample = 0 != (srv_dxgi_fmt_caps & D3D11_FORMAT_SUPPORT_TEXTURE2D);
        info.filter = 0 != (srv_dxgi_fmt_caps & D3D11_FORMAT_SUPPORT_SHADER_SAMPLE);
        info.render = render || depth;
        if depth != 0 {
            info.blend = 0 != (dsv_dxgi_fmt_caps & D3D11_FORMAT_SUPPORT_BLENDABLE);
            info.msaa = 0 != (dsv_dxgi_fmt_caps & D3D11_FORMAT_SUPPORT_MULTISAMPLE_RENDERTARGET);
        } else {
            info.blend = 0 != (rtv_uav_dxgi_fmt_caps & D3D11_FORMAT_SUPPORT_BLENDABLE);
            info.msaa = 0 != (rtv_uav_dxgi_fmt_caps & D3D11_FORMAT_SUPPORT_MULTISAMPLE_RENDERTARGET);
        }
        info.depth = depth;
        info.write = 0 != (rtv_uav_dxgi_fmt_caps & D3D11_FORMAT_SUPPORT_TYPED_UNORDERED_ACCESS_VIEW);
        info.read = info.write;
    }
}

void _sg_d3d11_setup_backend(sg_desc* desc) {
    assert(cast(i64, desc));
    assert(cast(i64, desc.environment.d3d11.device));
    assert(cast(i64, desc.environment.d3d11.device_context));
    _sg.d3d11.valid = true;
    _sg.d3d11.dev = cast(ID3D11Device*, desc.environment.d3d11.device);
    _sg.d3d11.ctx = cast(ID3D11DeviceContext*, desc.environment.d3d11.device_context);
    _sg_d3d11_init_caps();
    if _sg_d3d11_GetFeatureLevel(_sg.d3d11.dev) == D3D_FEATURE_LEVEL_11_0 {
        _sg_log(SG_LOGITEM_D3D11_FEATURE_LEVEL_0_DETECTED, 2, null, 7223);
    }
}

void _sg_d3d11_discard_backend() {
    assert(cast(i64, _sg.d3d11.valid));
    _sg.d3d11.valid = false;
}

void _sg_d3d11_clear_state() {
    _sg_d3d11_ClearState(_sg.d3d11.ctx);
}

void _sg_d3d11_reset_state_cache() {
}

sg_resource_state _sg_d3d11_create_buffer(_sg_buffer_t* buf, sg_buffer_desc* desc) {
    assert(buf && desc);
    assert(cast(i64, !buf.d3d11.buf));
    bool injected = null != desc.d3d11_buffer;
    if injected != 0 {
        buf.d3d11.buf = cast(ID3D11Buffer*, desc.d3d11_buffer);
        buf.d3d11.buf.lpVtbl.AddRef(buf.d3d11.buf);
    } else {
        D3D11_BUFFER_DESC d3d11_buf_desc;
        d3d11_buf_desc.ByteWidth = cast(UINT, buf.cmn.size);
        d3d11_buf_desc.Usage = _sg_d3d11_buffer_usage(&buf.cmn.usage);
        d3d11_buf_desc.BindFlags = _sg_d3d11_buffer_bind_flags(&buf.cmn.usage);
        d3d11_buf_desc.CPUAccessFlags = _sg_d3d11_buffer_cpu_access_flags(&buf.cmn.usage);
        d3d11_buf_desc.MiscFlags = _sg_d3d11_buffer_misc_flags(&buf.cmn.usage);
        D3D11_SUBRESOURCE_DATA* init_data_ptr = null;
        D3D11_SUBRESOURCE_DATA init_data;
        if desc.data.ptr != null {
            init_data.pSysMem = desc.data.ptr;
            init_data_ptr = &init_data;
        }
        HRESULT hr = _sg_d3d11_CreateBuffer(_sg.d3d11.dev, &d3d11_buf_desc, init_data_ptr, &buf.d3d11.buf);
        if (hr >= 0 && buf.d3d11.buf) == 0 {
            _sg_log(SG_LOGITEM_D3D11_CREATE_BUFFER_FAILED, 1, null, 7222);
            return SG_RESOURCESTATE_FAILED;
        }
    }
    return SG_RESOURCESTATE_VALID;
}

void _sg_d3d11_discard_buffer(_sg_buffer_t* buf) {
    assert(cast(i64, buf));
    if buf.d3d11.buf != null {
        buf.d3d11.buf.lpVtbl.Release(buf.d3d11.buf);
    }
}

void _sg_d3d11_seal_buffer(_sg_buffer_t* buf) {
    assert(cast(i64, buf));
    ignore buf;
}

void _sg_d3d11_fill_subres_data(_sg_image_t* img, sg_image_data* data) {
    i32 num_slices = img.cmn.type == SG_IMAGETYPE_3D ? 1 : img.cmn.num_slices;
    i32 subres_index = 0;
    for i32 slice_index = 0; slice_index < num_slices; slice_index++ {
        for i32 mip_index = 0; mip_index < img.cmn.num_mipmaps; mip_index++ {
            assert(subres_index < SG_MAX_MIPMAPS * 2048);
            D3D11_SUBRESOURCE_DATA* subres_data = &_sg.d3d11.subres_data[subres_index];
            i32 mip_width = _sg_miplevel_dim(img.cmn.width, mip_index);
            i32 mip_height = _sg_miplevel_dim(img.cmn.height, mip_index);
            sg_range* miplevel_data = &data.mip_levels[mip_index];
            u64 slice_size = miplevel_data.size / cast(u64, num_slices);
            u64 slice_offset = slice_size * cast(u64, slice_index);
            var ptr = cast(u8*, miplevel_data.ptr);
            subres_data.pSysMem = ptr + slice_offset;
            subres_data.SysMemPitch = cast(UINT, _sg_row_pitch(img.cmn.pixel_format, mip_width, 1));
            if img.cmn.type == SG_IMAGETYPE_3D {
                subres_data.SysMemSlicePitch = cast(UINT, _sg_surface_pitch(img.cmn.pixel_format, mip_width, mip_height, 1));
            } else {
                subres_data.SysMemSlicePitch = 0;
            }
            subres_index++;
        }
    }
}

sg_resource_state _sg_d3d11_create_image(_sg_image_t* img, sg_image_desc* desc) {
    assert(img && desc);
    assert(null == img.d3d11.tex2d && null == img.d3d11.tex3d && null == img.d3d11.res);
