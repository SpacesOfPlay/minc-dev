// ██     ██ ██ ███    ██ ██████   ██████  ██     ██ ███████
// ██     ██ ██ ████   ██ ██   ██ ██    ██ ██     ██ ██
// ██  █  ██ ██ ██ ██  ██ ██   ██ ██    ██ ██  █  ██ ███████
// ██ ███ ██ ██ ██  ██ ██ ██   ██ ██    ██ ██ ███ ██      ██
//  ███ ███  ██ ██   ████ ██████   ██████   ███ ███  ███████
//
// >>windows
bool _sapp_win32_utf8_to_wide(u8* src, u16* dst, i32 dst_num_bytes) {
    assert(src && dst && dst_num_bytes > 1);
    _sapp_clear(dst, cast(u64, dst_num_bytes));
    i32 dst_chars = dst_num_bytes / cast(i32, sizeof(u16));
    i32 dst_needed = MultiByteToWideChar(CP_UTF8, 0, src, -1, null, 0);
    if dst_needed > 0 && dst_needed < dst_chars {
        MultiByteToWideChar(CP_UTF8, 0, src, -1, dst, dst_chars);
        return true;
    } else {
        return false;
    }
}



void _sapp_wgl_init() {
    _sapp.wgl.opengl32 = LoadLibraryA("opengl32.dll");
    if _sapp.wgl.opengl32 == null {
        _sapp_log(SAPP_LOGITEM_WIN32_LOAD_OPENGL32_DLL_FAILED, 0, null, 3246);
    }
    assert(cast(i64, _sapp.wgl.opengl32));
    _sapp.wgl.CreateContext = cast(PFN_wglCreateContext, cast(void*, GetProcAddress(_sapp.wgl.opengl32, "wglCreateContext")));
    assert(cast(i64, _sapp.wgl.CreateContext));
    _sapp.wgl.DeleteContext = cast(PFN_wglDeleteContext, cast(void*, GetProcAddress(_sapp.wgl.opengl32, "wglDeleteContext")));
    assert(cast(i64, _sapp.wgl.DeleteContext));
    _sapp.wgl.GetProcAddress = cast(PFN_wglGetProcAddress, cast(void*, GetProcAddress(_sapp.wgl.opengl32, "wglGetProcAddress")));
    assert(cast(i64, _sapp.wgl.GetProcAddress));
    _sapp.wgl.GetCurrentDC = cast(PFN_wglGetCurrentDC, cast(void*, GetProcAddress(_sapp.wgl.opengl32, "wglGetCurrentDC")));
    assert(cast(i64, _sapp.wgl.GetCurrentDC));
    _sapp.wgl.MakeCurrent = cast(PFN_wglMakeCurrent, cast(void*, GetProcAddress(_sapp.wgl.opengl32, "wglMakeCurrent")));
    assert(cast(i64, _sapp.wgl.MakeCurrent));
    _sapp.wgl.GetIntegerv = cast(fn(u32, i32*): void, GetProcAddress(_sapp.wgl.opengl32, "glGetIntegerv"));
    assert(cast(i64, _sapp.wgl.GetIntegerv));
    _sapp.wgl.msg_hwnd = CreateWindowExW(WS_EX_OVERLAPPEDWINDOW, cast(u16*, __wide_literal("SOKOLAPP")), cast(u16*, __wide_literal("sokol-app message window")), WS_CLIPSIBLINGS | WS_CLIPCHILDREN, 0, 0, 1, 1, null, null, GetModuleHandleW(null), null);
    if _sapp.wgl.msg_hwnd == null {
        _sapp_log(SAPP_LOGITEM_WIN32_CREATE_HELPER_WINDOW_FAILED, 0, null, 3246);
    }
    assert(cast(i64, _sapp.wgl.msg_hwnd));
    ShowWindow(_sapp.wgl.msg_hwnd, SW_HIDE);
    noinit MSG msg;
    while PeekMessageW(&msg, _sapp.wgl.msg_hwnd, 0, 0, PM_REMOVE) != 0 {
        TranslateMessage(&msg);
        DispatchMessageW(&msg);
    }
    _sapp.wgl.msg_dc = GetDC(_sapp.wgl.msg_hwnd);
    if _sapp.wgl.msg_dc == null {
        _sapp_log(SAPP_LOGITEM_WIN32_HELPER_WINDOW_GETDC_FAILED, 0, null, 3246);
    }
}

void _sapp_wgl_shutdown() {
    assert(_sapp.wgl.opengl32 && _sapp.wgl.msg_hwnd);
    DestroyWindow(_sapp.wgl.msg_hwnd);
    _sapp.wgl.msg_hwnd = null;
    FreeLibrary(_sapp.wgl.opengl32);
    _sapp.wgl.opengl32 = null;
}

bool _sapp_wgl_has_ext(u8* ext, u8* extensions) {
    assert(ext && extensions);
    u8* start = extensions;
    while true {
        u8* where = strstr(start, ext);
        if where == null {
            return false;
        }
        u8* terminator = where + strlen(ext);
        if where == start || *(where - 1) == 32 {
            if *terminator == 32 || *terminator == 0 {
                break;
            }
        }
        start = terminator;
    }
    return true;
}

bool _sapp_wgl_ext_supported(u8* ext) {
    assert(cast(i64, ext));
    if _sapp.wgl.GetExtensionsStringEXT != null {
        u8* extensions = _sapp.wgl.GetExtensionsStringEXT();
        if extensions != null {
            if _sapp_wgl_has_ext(ext, extensions) != 0 {
                return true;
            }
        }
    }
    if _sapp.wgl.GetExtensionsStringARB != null {
        u8* extensions = _sapp.wgl.GetExtensionsStringARB(_sapp.wgl.GetCurrentDC());
        if extensions != null {
            if _sapp_wgl_has_ext(ext, extensions) != 0 {
                return true;
            }
        }
    }
    return false;
}

void _sapp_wgl_load_extensions() {
    assert(cast(i64, _sapp.wgl.msg_dc));
    PIXELFORMATDESCRIPTOR pfd;
    pfd.nSize = cast(WORD, sizeof(pfd));
    pfd.nVersion = 1;
    pfd.dwFlags = PFD_DRAW_TO_WINDOW | PFD_SUPPORT_OPENGL | PFD_DOUBLEBUFFER;
    pfd.iPixelType = PFD_TYPE_RGBA;
    pfd.cColorBits = 24;
    if SetPixelFormat(_sapp.wgl.msg_dc, ChoosePixelFormat(_sapp.wgl.msg_dc, &pfd), &pfd) == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_DUMMY_CONTEXT_SET_PIXELFORMAT_FAILED, 0, null, 3246);
    }
    HGLRC rc = _sapp.wgl.CreateContext(_sapp.wgl.msg_dc);
    if rc == null {
        _sapp_log(SAPP_LOGITEM_WIN32_CREATE_DUMMY_CONTEXT_FAILED, 0, null, 3246);
    }
    if _sapp.wgl.MakeCurrent(_sapp.wgl.msg_dc, rc) == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_DUMMY_CONTEXT_MAKE_CURRENT_FAILED, 0, null, 3246);
    }
    _sapp.wgl.GetExtensionsStringEXT = cast(PFNWGLGETEXTENSIONSSTRINGEXTPROC, cast(void*, _sapp.wgl.GetProcAddress("wglGetExtensionsStringEXT")));
    _sapp.wgl.GetExtensionsStringARB = cast(PFNWGLGETEXTENSIONSSTRINGARBPROC, cast(void*, _sapp.wgl.GetProcAddress("wglGetExtensionsStringARB")));
    _sapp.wgl.CreateContextAttribsARB = cast(PFNWGLCREATECONTEXTATTRIBSARBPROC, cast(void*, _sapp.wgl.GetProcAddress("wglCreateContextAttribsARB")));
    _sapp.wgl.SwapIntervalEXT = cast(PFNWGLSWAPINTERVALEXTPROC, cast(void*, _sapp.wgl.GetProcAddress("wglSwapIntervalEXT")));
    _sapp.wgl.GetPixelFormatAttribivARB = cast(PFNWGLGETPIXELFORMATATTRIBIVARBPROC, cast(void*, _sapp.wgl.GetProcAddress("wglGetPixelFormatAttribivARB")));
    _sapp.wgl.arb_multisample = _sapp_wgl_ext_supported("WGL_ARB_multisample");
    _sapp.wgl.arb_create_context = _sapp_wgl_ext_supported("WGL_ARB_create_context");
    _sapp.wgl.arb_create_context_profile = _sapp_wgl_ext_supported("WGL_ARB_create_context_profile");
    _sapp.wgl.ext_swap_control = _sapp_wgl_ext_supported("WGL_EXT_swap_control");
    _sapp.wgl.arb_pixel_format = _sapp_wgl_ext_supported("WGL_ARB_pixel_format");
    _sapp.wgl.arb_framebuffer_srgb = _sapp_wgl_ext_supported("WGL_ARB_framebuffer_sRGB");
    _sapp.wgl.MakeCurrent(_sapp.wgl.msg_dc, null);
    _sapp.wgl.DeleteContext(rc);
}

i32 _sapp_wgl_attrib(i32 pixel_format, i32 attrib) {
    assert(cast(i64, _sapp.wgl.arb_pixel_format));
    i32 value = 0;
    if _sapp.wgl.GetPixelFormatAttribivARB(_sapp.win32.dc, pixel_format, 0, 1, &attrib, &value) == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_GET_PIXELFORMAT_ATTRIB_FAILED, 0, null, 3246);
    }
    return value;
}

void _sapp_wgl_attribiv(i32 pixel_format, i32 num_attribs, i32* attribs, i32* results) {
    assert(cast(i64, _sapp.wgl.arb_pixel_format));
    if _sapp.wgl.GetPixelFormatAttribivARB(_sapp.win32.dc, pixel_format, 0, cast(UINT, num_attribs), attribs, results) == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_GET_PIXELFORMAT_ATTRIB_FAILED, 0, null, 3246);
    }
}

i32 _sapp_wgl_find_pixel_format() {
    assert(cast(i64, _sapp.win32.dc));
    assert(cast(i64, _sapp.wgl.arb_pixel_format));
    i32[13] query_tags;
    i32[13] query_results;
    i32 query_count = 0;
    i32 support_opengl_idx = -1;
    i32 draw_to_window_idx = -1;
    i32 pixel_type_idx = -1;
    i32 acceleration_idx = -1;
    i32 double_buffer_idx = -1;
    i32 red_bits_idx = -1;
    i32 green_bits_idx = -1;
    i32 blue_bits_idx = -1;
    i32 alpha_bits_idx = -1;
    i32 depth_bits_idx = -1;
    i32 stencil_bits_idx = -1;
    i32 samples_idx = -1;
    i32 framebuffer_srgb_capable_idx = -1;
    assert(query_count < 13);
    query_tags[query_count] = 0x2010;
    support_opengl_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x2001;
    draw_to_window_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x2013;
    pixel_type_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x2003;
    acceleration_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x2011;
    double_buffer_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x2015;
    red_bits_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x2017;
    green_bits_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x2019;
    blue_bits_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x201b;
    alpha_bits_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x2022;
    depth_bits_idx = query_count++;
    assert(query_count < 13);
    query_tags[query_count] = 0x2023;
    stencil_bits_idx = query_count++;
    if _sapp.wgl.arb_multisample != 0 {
        assert(query_count < 13);
        query_tags[query_count] = 0x2042;
        samples_idx = query_count++;
    }
    if _sapp.wgl.arb_framebuffer_srgb != 0 {
        assert(query_count < 13);
        query_tags[query_count] = 0x20a9;
        framebuffer_srgb_capable_idx = query_count++;
    }
    bool wants_depth = _sapp.desc.depth_format != SAPP_PIXELFORMAT_NONE;
    bool wants_stencil = _sapp.desc.depth_format == SAPP_PIXELFORMAT_DEPTH_STENCIL;
    bool wants_msaa = _sapp.desc.sample_count > 1 && _sapp.wgl.arb_multisample;
    bool wants_srgb = _sapp.desc.srgb && _sapp.wgl.arb_framebuffer_srgb;
    noinit _sapp_gl_fbconfig desired;
    _sapp_gl_init_fbconfig(&desired);
    desired.red_bits = 8;
    desired.green_bits = 8;
    desired.blue_bits = 8;
    desired.alpha_bits = 8;
    if wants_depth != 0 {
        desired.depth_bits = 24;
    } else {
        desired.depth_bits = 0;
    }
    if wants_stencil != 0 {
        desired.stencil_bits = 8;
    } else {
        desired.stencil_bits = 0;
    }
    desired.doublebuffer = true;
    if wants_msaa != 0 {
        desired.samples = _sapp.desc.sample_count;
    } else {
        desired.samples = 0;
    }
    desired.srgb_capable = wants_srgb;
    i32 pixel_format = 0;
    noinit _sapp_gl_fbselect fbselect;
    _sapp_gl_init_fbselect(&fbselect);
    i32 native_count = _sapp_wgl_attrib(1, 0x2000);
    for i32 i = 0; i < native_count; i++ {
        i32 n = i + 1;
        _sapp_wgl_attribiv(n, query_count, query_tags, query_results);
        if query_results[support_opengl_idx] == 0 || query_results[draw_to_window_idx] == 0 || query_results[pixel_type_idx] != 0x202b || query_results[acceleration_idx] == 0x2025 {
            continue;
        }
        _sapp_gl_fbconfig u;
        u.red_bits = query_results[red_bits_idx];
        u.green_bits = query_results[green_bits_idx];
        u.blue_bits = query_results[blue_bits_idx];
        u.alpha_bits = query_results[alpha_bits_idx];
        u.depth_bits = query_results[depth_bits_idx];
        u.stencil_bits = query_results[stencil_bits_idx];
        u.doublebuffer = 0 != query_results[double_buffer_idx];
        if _sapp.wgl.arb_multisample != 0 {
            assert(cast(i64, samples_idx));
            u.samples = query_results[samples_idx];
        }
        if _sapp.wgl.arb_framebuffer_srgb != 0 {
            assert(cast(i64, framebuffer_srgb_capable_idx));
            u.srgb_capable = 0 != query_results[framebuffer_srgb_capable_idx];
        }
        if _sapp_gl_select_fbconfig(&fbselect, &desired, &u) != 0 {
            pixel_format = cast(i32, cast(u64, n));
            if fbselect.best_match != 0 {
                break;
            }
        }
    }
    return pixel_format;
}

void _sapp_wgl_create_context() {
    i32 pixel_format = _sapp_wgl_find_pixel_format();
    if 0 == pixel_format {
        _sapp_log(SAPP_LOGITEM_WIN32_WGL_FIND_PIXELFORMAT_FAILED, 0, null, 3246);
    }
    noinit PIXELFORMATDESCRIPTOR pfd;
    if DescribePixelFormat(_sapp.win32.dc, pixel_format, sizeof(pfd), &pfd) == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_WGL_DESCRIBE_PIXELFORMAT_FAILED, 0, null, 3246);
    }
    if SetPixelFormat(_sapp.win32.dc, pixel_format, &pfd) == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_WGL_SET_PIXELFORMAT_FAILED, 0, null, 3246);
    }
    if _sapp.wgl.arb_create_context == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_WGL_ARB_CREATE_CONTEXT_REQUIRED, 0, null, 3246);
    }
    if _sapp.wgl.arb_create_context_profile == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_WGL_ARB_CREATE_CONTEXT_PROFILE_REQUIRED, 0, null, 3246);
    }
    i32[10] attrs = {
        0x2091, _sapp.desc.gl.major_version, 0x2092, _sapp.desc.gl.minor_version, 0x2094,
        0x00000002, 0x9126, 0x00000001, 0, 0,
    };
    when defined(SOKOL_DEBUG) {
        attrs[4] = 0x2094;
        attrs[5] = 0x00000002 | 0x00000001;
    }
    _sapp.wgl.gl_ctx = _sapp.wgl.CreateContextAttribsARB(_sapp.win32.dc, null, attrs);
    if _sapp.wgl.gl_ctx == null {
        DWORD err = GetLastError();
        if err == cast(u32, 0xc0070000 | 0x2095) {
            _sapp_log(SAPP_LOGITEM_WIN32_WGL_OPENGL_VERSION_NOT_SUPPORTED, 0, null, 3246);
        } else if err == cast(u32, 0xc0070000 | 0x2096) {
            _sapp_log(SAPP_LOGITEM_WIN32_WGL_OPENGL_PROFILE_NOT_SUPPORTED, 0, null, 3246);
        } else if err == cast(u32, 0xc0070000 | 0x2054) {
            _sapp_log(SAPP_LOGITEM_WIN32_WGL_INCOMPATIBLE_DEVICE_CONTEXT, 0, null, 3246);
        } else {
            _sapp_log(SAPP_LOGITEM_WIN32_WGL_CREATE_CONTEXT_ATTRIBS_FAILED_OTHER, 0, null, 3246);
        }
    }
    _sapp.wgl.MakeCurrent(_sapp.win32.dc, _sapp.wgl.gl_ctx);
    if _sapp.wgl.ext_swap_control != 0 {
        if _sapp.desc.disable_vsync != 0 {
            _sapp.wgl.SwapIntervalEXT(0);
        } else {
            _sapp.wgl.SwapIntervalEXT(_sapp.desc.swap_interval);
        }
    }
    u32 gl_framebuffer_binding = 0x8CA6;
    _sapp.wgl.GetIntegerv(gl_framebuffer_binding, cast(i32*, &_sapp.gl.framebuffer));
}

void _sapp_wgl_destroy_context() {
    assert(cast(i64, _sapp.wgl.gl_ctx));
    _sapp.wgl.DeleteContext(_sapp.wgl.gl_ctx);
    _sapp.wgl.gl_ctx = null;
}

void _sapp_wgl_swap_buffers() {
    assert(cast(i64, _sapp.win32.dc));
    SwapBuffers(_sapp.win32.dc);
}




























void _sapp_win32_frame(bool from_winproc) {
    _sapp_frame();
    _sapp_wgl_swap_buffers();
    if from_winproc == 0 {
        if IsIconic(_sapp.win32.hwnd) != 0 {
            Sleep(cast(DWORD, 16 * _sapp.desc.swap_interval));
        }
    }
}







void _sapp_win32_init_dpi() {
    SETPROCESSDPIAWARE_T fn_setprocessdpiaware = null;
    SETPROCESSDPIAWARENESS_T fn_setprocessdpiawareness = null;
    GETDPIFORMONITOR_T fn_getdpiformonitor = null;
    SETPROCESSDPIAWARENESSCONTEXT_T fn_setprocessdpiawarenesscontext = null;
    HINSTANCE user32 = LoadLibraryA("user32.dll");
    if user32 != null {
        fn_setprocessdpiaware = cast(SETPROCESSDPIAWARE_T, cast(void*, GetProcAddress(user32, "SetProcessDPIAware")));
        fn_setprocessdpiawarenesscontext = cast(SETPROCESSDPIAWARENESSCONTEXT_T, cast(void*, GetProcAddress(user32, "SetProcessDpiAwarenessContext")));
    }
    HINSTANCE shcore = LoadLibraryA("shcore.dll");
    if shcore != null {
        fn_setprocessdpiawareness = cast(SETPROCESSDPIAWARENESS_T, cast(void*, GetProcAddress(shcore, "SetProcessDpiAwareness")));
        fn_getdpiformonitor = cast(GETDPIFORMONITOR_T, cast(void*, GetProcAddress(shcore, "GetDpiForMonitor")));
    }
    bool init_dpi_awareness = true;
    if _sapp.desc.high_dpi == 0 {
        _sapp.win32.dpi.aware = false;
        fn_setprocessdpiawareness(PROCESS_DPI_UNAWARE);
        init_dpi_awareness = false;
    }
    if init_dpi_awareness != 0 {
        if fn_setprocessdpiawareness != null {
            _sapp.win32.dpi.aware = true;
            var per_monitor_aware_v2 = cast(DPI_AWARENESS_CONTEXT_T, -4);
            if (fn_setprocessdpiawarenesscontext && fn_setprocessdpiawarenesscontext(per_monitor_aware_v2)) == 0 {
                fn_setprocessdpiawareness(PROCESS_SYSTEM_DPI_AWARE);
            }
        } else if fn_setprocessdpiaware != null {
            _sapp.win32.dpi.aware = true;
            fn_setprocessdpiaware();
        }
    }
    if fn_getdpiformonitor && _sapp.win32.dpi.aware {
        var pt = POINT{1, 1};
        HMONITOR hm = MonitorFromPoint(pt, MONITOR_DEFAULTTONEAREST);
        UINT dpix;
        UINT dpiy;
        HRESULT hr = fn_getdpiformonitor(hm, MDT_EFFECTIVE_DPI, &dpix, &dpiy);
        ignore hr;
        assert(cast(i64, SUCCEEDED(hr)));
        _sapp.win32.dpi.window_scale = cast(f32, dpix) / 96.0f;
    } else {
        _sapp.win32.dpi.window_scale = 1.0f;
    }
    if _sapp.desc.high_dpi != 0 {
        _sapp.win32.dpi.content_scale = _sapp.win32.dpi.window_scale;
        _sapp.win32.dpi.mouse_scale = 1.0f;
    } else {
        _sapp.win32.dpi.content_scale = 1.0f;
        _sapp.win32.dpi.mouse_scale = 1.0f / _sapp.win32.dpi.window_scale;
    }
    _sapp.dpi_scale = _sapp.win32.dpi.content_scale;
    if user32 != null {
        FreeLibrary(user32);
    }
    if shcore != null {
        FreeLibrary(shcore);
    }
}







void _sapp_win32_run(sapp_desc* desc) {
    _sapp_init_state(desc);
    _sapp_win32_init_console();
    _sapp.win32.is_win10_or_greater = _sapp_win32_is_win10_or_greater();
    _sapp_win32_init_keytable();
    _sapp_win32_utf8_to_wide(_sapp.window_title, _sapp.window_title_wide, cast(i32, sizeof(_sapp.window_title_wide)));
    _sapp_win32_init_dpi();
    _sapp_win32_init_cursors();
    _sapp_win32_create_window();
    sapp_set_icon(&desc.icon);
    _sapp_wgl_init();
    _sapp_wgl_load_extensions();
    _sapp_wgl_create_context();
    _sapp.valid = true;
    bool window_shown = false;
    bool done = false;
    while (done || _sapp.quit_ordered) == 0 {
        _sapp_timing_update(&_sapp.timing, 0.0);
        noinit MSG msg;
        while PeekMessageW(&msg, null, 0, 0, PM_REMOVE) != 0 {
            if WM_QUIT == msg.message {
                done = true;
                continue;
            } else {
                TranslateMessage(&msg);
                DispatchMessageW(&msg);
            }
        }
        _sapp_win32_frame(false);
        if window_shown == 0 {
            window_shown = true;
            ShowWindow(_sapp.win32.hwnd, SW_SHOW);
        }
        if _sapp_win32_update_dimensions() != 0 {
            _sapp_win32_app_event(SAPP_EVENTTYPE_RESIZED);
        }
        if _sapp.quit_requested != 0 {
            PostMessage(_sapp.win32.hwnd, WM_CLOSE, 0, 0);
        }
        _sapp_win32_update_mouse_lock();
    }
    _sapp_call_cleanup();
    _sapp_wgl_destroy_context();
    _sapp_wgl_shutdown();
    _sapp_win32_destroy_window();
    _sapp_win32_destroy_icons();
    _sapp_win32_restore_console();
    _sapp_win32_free_raw_input_data();
    _sapp_discard_state();
}



}
























private {
}


































