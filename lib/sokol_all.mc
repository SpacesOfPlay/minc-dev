    _sg.limits.max_image_size_array = 16 * 1024;
    _sg.limits.max_image_array_layers = 2 * 1024;
    _sg.limits.max_texture_bindings_per_stage = 128 < SG_MAX_VIEW_BINDSLOTS ? 128 : SG_MAX_VIEW_BINDSLOTS;
    _sg.limits.max_storage_image_bindings_per_stage = _sg.limits.max_texture_bindings_per_stage;
    _sg.limits.max_storage_buffer_bindings_per_stage = 31 - (SG_MAX_VERTEXBUFFER_BINDSLOTS + SG_MAX_UNIFORMBLOCK_BINDSLOTS) < SG_MAX_VIEW_BINDSLOTS ? 31 - (SG_MAX_VERTEXBUFFER_BINDSLOTS + SG_MAX_UNIFORMBLOCK_BINDSLOTS) : SG_MAX_VIEW_BINDSLOTS;
    _sg.limits.max_color_attachments = 8 < SG_MAX_COLOR_ATTACHMENTS ? 8 : SG_MAX_COLOR_ATTACHMENTS;
    _sg.limits.max_vertex_attrs = SG_MAX_VERTEX_ATTRIBUTES;
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_R8]);
