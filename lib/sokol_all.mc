WGPUColorWriteMask _sg_wgpu_colorwritemask(sg_color_mask m) {
    i32 res = 0;
    if 0 != (m & SG_COLORMASK_R) {
        res |= cast(i32, WGPUColorWriteMask_Red);
    }
    if 0 != (m & SG_COLORMASK_G) {
        res |= cast(i32, WGPUColorWriteMask_Green);
    }
    if 0 != (m & SG_COLORMASK_B) {
        res |= cast(i32, WGPUColorWriteMask_Blue);
    }
    if 0 != (m & SG_COLORMASK_A) {
        res |= cast(i32, WGPUColorWriteMask_Alpha);
    }
    return cast(WGPUColorWriteMask, res);
}

WGPUShaderStage _sg_wgpu_shader_stage(sg_shader_stage stage) {
    switch stage {
        case SG_SHADERSTAGE_VERTEX: {
            return WGPUShaderStage_Vertex;
        }
        case SG_SHADERSTAGE_FRAGMENT: {
            return WGPUShaderStage_Fragment;
        }
        case SG_SHADERSTAGE_COMPUTE: {
            return WGPUShaderStage_Compute;
        }
        default: {
            assert(cast(i64, false));
            return WGPUShaderStage_None;
        }
    }
}

void _sg_wgpu_init_caps() {
    _sg.backend = SG_BACKEND_WGPU;
    _sg.features.origin_top_left = true;
    _sg.features.image_clamp_to_border = false;
    _sg.features.mrt_independent_blend_state = true;
    _sg.features.mrt_independent_write_mask = true;
    _sg.features.compute = true;
    _sg.features.msaa_texture_bindings = true;
    _sg.features.draw_base_vertex = true;
    _sg.features.draw_base_instance = true;
    _sg.features.dual_source_blending = wgpuDeviceHasFeature(_sg.wgpu.dev, WGPUFeatureName_DualSourceBlending) != 0;
    _sg.features.vertexformat_int10_n2 = false;
    wgpuDeviceGetLimits(_sg.wgpu.dev, &_sg.wgpu.limits);
    WGPULimits* l = &_sg.wgpu.limits;
    _sg.limits.max_image_size_2d = cast(i32, l.maxTextureDimension2D);
    _sg.limits.max_image_size_cube = cast(i32, l.maxTextureDimension2D);
    _sg.limits.max_image_size_3d = cast(i32, l.maxTextureDimension3D);
    _sg.limits.max_image_size_array = cast(i32, l.maxTextureDimension2D);
    _sg.limits.max_image_array_layers = cast(i32, l.maxTextureArrayLayers);
    _sg.limits.max_vertex_attrs = SG_MAX_VERTEX_ATTRIBUTES;
    _sg.limits.max_color_attachments = cast(i32, l.maxColorAttachments) < SG_MAX_COLOR_ATTACHMENTS ? cast(i32, l.maxColorAttachments) : SG_MAX_COLOR_ATTACHMENTS;
    _sg.limits.max_texture_bindings_per_stage = cast(i32, l.maxSampledTexturesPerShaderStage) < SG_MAX_VIEW_BINDSLOTS ? cast(i32, l.maxSampledTexturesPerShaderStage) : SG_MAX_VIEW_BINDSLOTS;
    _sg.limits.max_storage_buffer_bindings_per_stage = cast(i32, l.maxStorageBuffersPerShaderStage) < SG_MAX_VIEW_BINDSLOTS ? cast(i32, l.maxStorageBuffersPerShaderStage) : SG_MAX_VIEW_BINDSLOTS;
    _sg.limits.max_storage_image_bindings_per_stage = cast(i32, l.maxStorageTexturesPerShaderStage) < SG_MAX_VIEW_BINDSLOTS ? cast(i32, l.maxStorageTexturesPerShaderStage) : SG_MAX_VIEW_BINDSLOTS;
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_R8]);
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_RG8]);
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_RGBA8]);
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_SRGB8A8]);
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_BGRA8]);
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_R16F]);
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_RG16F]);
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_RGBA16F]);
    _sg_pixelformat_all(&_sg.formats[SG_PIXELFORMAT_RGB10A2]);
    _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_R8SN]);
    _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_RG8SN]);
    _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_RGBA8SN]);
    _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_RG11B10F]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_R8UI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_R8SI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RG8UI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RG8SI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RGBA8UI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RGBA8SI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_R16UI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_R16SI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RG16UI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RG16SI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RGBA16UI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RGBA16SI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_R32UI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_R32SI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RG32UI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RG32SI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RGBA32UI]);
    _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RGBA32SI]);
    if wgpuDeviceHasFeature(_sg.wgpu.dev, WGPUFeatureName_Float32Filterable) != 0 {
        _sg_pixelformat_sfr(&_sg.formats[SG_PIXELFORMAT_R32F]);
        _sg_pixelformat_sfr(&_sg.formats[SG_PIXELFORMAT_RG32F]);
        _sg_pixelformat_sfr(&_sg.formats[SG_PIXELFORMAT_RGBA32F]);
    } else {
        _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_R32F]);
        _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RG32F]);
        _sg_pixelformat_sr(&_sg.formats[SG_PIXELFORMAT_RGBA32F]);
    }
    if wgpuDeviceHasFeature(_sg.wgpu.dev, WGPUFeatureName_Float32Blendable) != 0 {
        _sg.formats[SG_PIXELFORMAT_R32F].blend = true;
        _sg.formats[SG_PIXELFORMAT_RG32F].blend = true;
        _sg.formats[SG_PIXELFORMAT_RGBA32F].blend = true;
    }
    if wgpuDeviceHasFeature(_sg.wgpu.dev, WGPUFeatureName_TextureFormatsTier1) != 0 {
        _sg_pixelformat_sbr(&_sg.formats[SG_PIXELFORMAT_R16]);
        _sg_pixelformat_sbr(&_sg.formats[SG_PIXELFORMAT_R16SN]);
        _sg_pixelformat_sbr(&_sg.formats[SG_PIXELFORMAT_RG16]);
        _sg_pixelformat_sbr(&_sg.formats[SG_PIXELFORMAT_RG16SN]);
        _sg_pixelformat_sbr(&_sg.formats[SG_PIXELFORMAT_RGBA16]);
        _sg_pixelformat_sbr(&_sg.formats[SG_PIXELFORMAT_RGBA16SN]);
        _sg_pixelformat_sbr(&_sg.formats[SG_PIXELFORMAT_R8SN]);
        _sg_pixelformat_sbr(&_sg.formats[SG_PIXELFORMAT_RG8SN]);
        _sg_pixelformat_sbr(&_sg.formats[SG_PIXELFORMAT_RGBA8SN]);
    }
    _sg_pixelformat_srmd(&_sg.formats[SG_PIXELFORMAT_DEPTH]);
    _sg_pixelformat_srmd(&_sg.formats[SG_PIXELFORMAT_DEPTH_STENCIL]);
    _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_RGB9E5]);
    if wgpuDeviceHasFeature(_sg.wgpu.dev, WGPUFeatureName_TextureCompressionBC) != 0 {
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC1_RGBA]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC2_RGBA]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC3_RGBA]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC3_SRGBA]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC4_R]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC4_RSN]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC5_RG]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC5_RGSN]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC6H_RGBF]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC6H_RGBUF]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC7_RGBA]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_BC7_SRGBA]);
    }
    if wgpuDeviceHasFeature(_sg.wgpu.dev, WGPUFeatureName_TextureCompressionETC2) != 0 {
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_ETC2_RGB8]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_ETC2_SRGB8]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_ETC2_RGB8A1]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_ETC2_RGBA8]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_ETC2_SRGB8A8]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_EAC_R11]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_EAC_R11SN]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_EAC_RG11]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_EAC_RG11SN]);
    }
    if wgpuDeviceHasFeature(_sg.wgpu.dev, WGPUFeatureName_TextureCompressionASTC) != 0 {
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_ASTC_4x4_RGBA]);
        _sg_pixelformat_sf(&_sg.formats[SG_PIXELFORMAT_ASTC_4x4_SRGBA]);
    }
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA8]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA8SN]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA8UI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA8SI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA16UI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA16SI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA16F]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_R32UI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_R32SI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_R32F]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RG32UI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RG32SI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RG32F]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA32UI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA32SI]);
    _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_RGBA32F]);
    if wgpuDeviceHasFeature(_sg.wgpu.dev, WGPUFeatureName_TextureFormatsTier2) != 0 {
        _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_R8]);
        _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_R8UI]);
        _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_R8SI]);
        _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_R16UI]);
        _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_R16SI]);
        _sg_pixelformat_compute_all(&_sg.formats[SG_PIXELFORMAT_R16F]);
    }
}

void _sg_wgpu_uniform_system_init(sg_desc* desc) {
    assert(null == _sg.wgpu.uniform.staging);
    assert(null == _sg.wgpu.uniform.buf);
    _sg.wgpu.uniform.num_bytes = cast(u32, desc.uniform_buffer_size + (1 << 16));
    _sg.wgpu.uniform.staging = cast(u8*, _sg_malloc(_sg.wgpu.uniform.num_bytes));
    WGPUBufferDescriptor ub_desc;
    ub_desc.size = _sg.wgpu.uniform.num_bytes;
    ub_desc.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst;
    _sg.wgpu.uniform.buf = wgpuDeviceCreateBuffer(_sg.wgpu.dev, &ub_desc);
    assert(cast(i64, _sg.wgpu.uniform.buf));
}

void _sg_wgpu_uniform_system_discard() {
    if _sg.wgpu.uniform.buf != null {
        wgpuBufferRelease(_sg.wgpu.uniform.buf);
        _sg.wgpu.uniform.buf = null;
    }
    if _sg.wgpu.uniform.staging != null {
        _sg_free(_sg.wgpu.uniform.staging);
        _sg.wgpu.uniform.staging = null;
    }
}

void _sg_wgpu_uniform_system_set_bindgroup() {
    assert(cast(i64, _sg.wgpu.uniform.dirty));
    _sg.wgpu.uniform.dirty = false;
    _sg_pipeline_t* pip = _sg_pipeline_ref_ptr(&_sg.cur_pip);
    _sg_shader_t* shd = _sg_shader_ref_ptr(&pip.cmn.shader);
    assert(cast(i32, shd.wgpu.ub_num_dynoffsets) < SG_MAX_UNIFORMBLOCK_BINDSLOTS);
    u32[8] dyn_offsets;
    for u64 i = 0; i < cast(u64, SG_MAX_UNIFORMBLOCK_BINDSLOTS); i++ {
        if shd.cmn.uniform_blocks[i].stage == SG_SHADERSTAGE_NONE {
            continue;
        }
        u8 dynoffset_index = shd.wgpu.ub_dynoffsets[i];
        assert(dynoffset_index < shd.wgpu.ub_num_dynoffsets);
        dyn_offsets[dynoffset_index] = _sg.wgpu.uniform.bind_offsets[i];
    }
    if _sg.cur_pass.is_compute != 0 {
        assert(cast(i64, _sg.wgpu.cpass_enc));
        wgpuComputePassEncoderSetBindGroup(_sg.wgpu.cpass_enc, 0, shd.wgpu.bg_ub, shd.wgpu.ub_num_dynoffsets, dyn_offsets);
    } else {
        assert(cast(i64, _sg.wgpu.rpass_enc));
        wgpuRenderPassEncoderSetBindGroup(_sg.wgpu.rpass_enc, 0, shd.wgpu.bg_ub, shd.wgpu.ub_num_dynoffsets, dyn_offsets);
    }
}

void _sg_wgpu_uniform_system_on_apply_pipeline() {
    _sg.wgpu.uniform.dirty = false;
}

void _sg_wgpu_uniform_system_on_commit() {
    wgpuQueueWriteBuffer(_sg.wgpu.queue, _sg.wgpu.uniform.buf, 0, _sg.wgpu.uniform.staging, _sg.wgpu.uniform.offset);
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.wgpu.uniforms.size_write_buffer += _sg.wgpu.uniform.offset;
        }
    }
    _sg.wgpu.uniform.offset = 0;
    _sg_clear(_sg.wgpu.uniform.bind_offsets, cast(u64, sizeof(_sg.wgpu.uniform.bind_offsets)));
}

void _sg_wgpu_bindgroups_pool_init(sg_desc* desc) {
    assert(desc.wgpu.bindgroups_cache_size > 0 && desc.wgpu.bindgroups_cache_size < _SG_MAX_POOL_SIZE);
    _sg_wgpu_bindgroups_pool_t* p = &_sg.wgpu.bindgroups_pool;
    assert(null == p.bindgroups);
    i32 pool_size = desc.wgpu.bindgroups_cache_size;
    _sg_pool_init(&p.pool, pool_size);
    u64 pool_byte_size = cast(u64, sizeof(_sg_wgpu_bindgroup_t)) * cast(u64, p.pool.size);
    p.bindgroups = cast(_sg_wgpu_bindgroup_t*, _sg_malloc_clear(pool_byte_size));
}

void _sg_wgpu_bindgroups_pool_discard() {
    _sg_wgpu_bindgroups_pool_t* p = &_sg.wgpu.bindgroups_pool;
    assert(cast(i64, p.bindgroups));
    _sg_free(p.bindgroups);
    p.bindgroups = null;
    _sg_pool_discard(&p.pool);
}

_sg_wgpu_bindgroup_t* _sg_wgpu_bindgroup_at(u32 bg_id) {
    assert(cast(u32, SG_INVALID_ID) != bg_id);
    _sg_wgpu_bindgroups_pool_t* p = &_sg.wgpu.bindgroups_pool;
    i32 slot_index = _sg_slot_index(bg_id);
    assert(slot_index > 0 && slot_index < p.pool.size);
    return &p.bindgroups[slot_index];
}

_sg_wgpu_bindgroup_t* _sg_wgpu_lookup_bindgroup(u32 bg_id) {
    if cast(u32, SG_INVALID_ID) != bg_id {
        _sg_wgpu_bindgroup_t* bg = _sg_wgpu_bindgroup_at(bg_id);
        if bg.slot.id == bg_id {
            return bg;
        }
    }
    return null;
}

_sg_wgpu_bindgroup_handle_t _sg_wgpu_alloc_bindgroup() {
    _sg_wgpu_bindgroups_pool_t* p = &_sg.wgpu.bindgroups_pool;
    noinit _sg_wgpu_bindgroup_handle_t res;
    i32 slot_index = _sg_pool_alloc_index(&p.pool);
    if 0 != slot_index {
        res.id = _sg_slot_alloc(&p.pool, &p.bindgroups[slot_index].slot, slot_index);
    } else {
        res.id = cast(u32, SG_INVALID_ID);
        _sg_log(SG_LOGITEM_WGPU_BINDGROUPS_POOL_EXHAUSTED, 1, null, 7222);
    }
    return res;
}

void _sg_wgpu_dealloc_bindgroup(_sg_wgpu_bindgroup_t* bg) {
    assert(bg && bg.slot.state == SG_RESOURCESTATE_ALLOC && bg.slot.id != cast(u32, SG_INVALID_ID));
    _sg_wgpu_bindgroups_pool_t* p = &_sg.wgpu.bindgroups_pool;
    _sg_pool_free_index(&p.pool, _sg_slot_index(bg.slot.id));
    _sg_slot_reset(&bg.slot);
}

void _sg_wgpu_reset_bindgroup_to_alloc_state(_sg_wgpu_bindgroup_t* bg) {
    assert(cast(i64, bg));
    _sg_slot_t slot = bg.slot;
    _sg_clear(bg, cast(u64, sizeof(_sg_wgpu_bindgroup_t)));
    bg.slot = slot;
    bg.slot.state = SG_RESOURCESTATE_ALLOC;
}

u64 _sg_wgpu_hash(void* key, i32 len, u64 seed) {
    u32 m = 0x5bd1e995;
    i32 r = 24;
    u32 h1 = cast(u32, seed) ^ cast(u32, len);
    var h2 = cast(u32, seed >> 32);
    var data = cast(u32*, key);
    while len >= 8 {
        u32 k1 = *data++;
        k1 *= m;
        k1 ^= k1 >> cast(u32, r);
        k1 *= m;
        h1 *= m;
        h1 ^= k1;
        len -= 4;
        u32 k2 = *data++;
        k2 *= m;
        k2 ^= k2 >> cast(u32, r);
        k2 *= m;
        h2 *= m;
        h2 ^= k2;
        len -= 4;
    }
    if len >= 4 {
        u32 k1 = *data++;
        k1 *= m;
        k1 ^= k1 >> cast(u32, r);
        k1 *= m;
        h1 *= m;
        h1 ^= k1;
        len -= 4;
    }
    switch len {
        case 3: {
            h2 ^= cast(u32, cast(i32, cast(u8*, data)[2]) << 16);
            fallthrough;
        }
        case 2: {
            h2 ^= cast(u32, cast(i32, cast(u8*, data)[1]) << 8);
            fallthrough;
        }
        case 1: {
            h2 ^= cast(u8*, data)[0];
            h2 *= m;
        }
    }
    h1 ^= h2 >> 18;
    h1 *= m;
    h2 ^= h1 >> 22;
    h2 *= m;
    h1 ^= h2 >> 17;
    h1 *= m;
    h2 ^= h1 >> 19;
    h2 *= m;
    u64 h = h1;
    h = h << 32 | h2;
    return h;
}

u64 _sg_wgpu_bindgroups_cache_item(_sg_wgpu_bindgroups_cache_item_type_t type, u8 wgpu_binding, u32 id, u32 uninit_count) {
    u64 bb = wgpu_binding;
    var t = cast(u64, type & 3);
    u64 ccccc = uninit_count & cast(u32, (1 << 22) - 1);
    u64 iiiiiiii = id;
    return bb << 56 | t << 54 | ccccc << 32 | iiiiiiii;
}

u64 _sg_wgpu_bindgroups_cache_pip_item(_sg_slot_t* slot) {
    return _sg_wgpu_bindgroups_cache_item(_SG_WGPU_BINDGROUPSCACHEITEMTYPE_PIPELINE, 0xFF, slot.id, slot.uninit_count);
}

u64 _sg_wgpu_bindgroups_cache_view_item(u8 wgpu_binding, _sg_slot_t* slot) {
    return _sg_wgpu_bindgroups_cache_item(_SG_WGPU_BINDGROUPSCACHEITEMTYPE_VIEW, wgpu_binding, slot.id, slot.uninit_count);
}

u64 _sg_wgpu_bindgroups_cache_sampler_item(u8 wgpu_binding, _sg_slot_t* slot) {
    return _sg_wgpu_bindgroups_cache_item(_SG_WGPU_BINDGROUPSCACHEITEMTYPE_SAMPLER, wgpu_binding, slot.id, slot.uninit_count);
}

void _sg_wgpu_init_bindgroups_cache_key(_sg_wgpu_bindgroups_cache_key_t* key, _sg_bindings_ptrs_t* bnd) {
    assert(cast(i64, bnd));
    assert(cast(i64, bnd.pip));
    _sg_shader_t* shd = _sg_shader_ref_ptr(&bnd.pip.cmn.shader);
    _sg_clear(key.items, cast(u64, sizeof(key.items)));
    key.items[0] = _sg_wgpu_bindgroups_cache_pip_item(&bnd.pip.slot);
    for u64 i = 0; i < cast(u64, SG_MAX_VIEW_BINDSLOTS); i++ {
        if shd.cmn.views[i].stage == SG_SHADERSTAGE_NONE {
            continue;
        }
        assert(cast(i64, bnd.views[i]));
        u64 item_idx = i + 1;
        assert(item_idx < cast(u64, 1 + (SG_MAX_VIEW_BINDSLOTS + SG_MAX_SAMPLER_BINDSLOTS)));
        assert(0 == key.items[item_idx]);
        u8 wgpu_binding = shd.wgpu.view_grp1_bnd_n[i];
        key.items[item_idx] = _sg_wgpu_bindgroups_cache_view_item(wgpu_binding, &bnd.views[i].slot);
    }
    for u64 i = 0; i < cast(u64, SG_MAX_SAMPLER_BINDSLOTS); i++ {
        if shd.cmn.samplers[i].stage == SG_SHADERSTAGE_NONE {
            continue;
        }
        assert(cast(i64, bnd.smps[i]));
        u64 item_idx = i + 1 + cast(u64, SG_MAX_VIEW_BINDSLOTS);
        assert(item_idx < cast(u64, 1 + (SG_MAX_VIEW_BINDSLOTS + SG_MAX_SAMPLER_BINDSLOTS)));
        assert(0 == key.items[item_idx]);
        u8 wgpu_binding = shd.wgpu.smp_grp1_bnd_n[i];
        key.items[item_idx] = _sg_wgpu_bindgroups_cache_sampler_item(wgpu_binding, &bnd.smps[i].slot);
    }
    key.hash = _sg_wgpu_hash(&key.items, cast(i32, sizeof(key.items)), 0x1234567887654321);
}

bool _sg_wgpu_compare_bindgroups_cache_key(_sg_wgpu_bindgroups_cache_key_t* k0, _sg_wgpu_bindgroups_cache_key_t* k1) {
    assert(k0 && k1);
    if k0.hash != k1.hash {
        return false;
    }
    if memcmp(&k0.items, &k1.items, cast(u64, sizeof(k0.items))) != 0 {
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.wgpu.bindings.num_bindgroup_cache_hash_vs_key_mismatch++;
            }
        }
        return false;
    }
    return true;
}

_sg_wgpu_bindgroup_t* _sg_wgpu_create_bindgroup(_sg_bindings_ptrs_t* bnd) {
    assert(cast(i64, _sg.wgpu.dev));
    assert(cast(i64, bnd.pip));
    _sg_shader_t* shd = _sg_shader_ref_ptr(&bnd.pip.cmn.shader);
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.wgpu.bindings.num_create_bindgroup++;
        }
    }
    _sg_wgpu_bindgroup_handle_t bg_id = _sg_wgpu_alloc_bindgroup();
    if bg_id.id == cast(u32, SG_INVALID_ID) {
        return null;
    }
    _sg_wgpu_bindgroup_t* bg = _sg_wgpu_bindgroup_at(bg_id.id);
    assert(bg && bg.slot.state == SG_RESOURCESTATE_ALLOC);
    WGPUBindGroupLayout bgl = shd.wgpu.bgl_view_smp;
    assert(cast(i64, bgl));
    WGPUBindGroupEntry[44] bg_entries;
    u64 bgl_index = 0;
    for u64 i = 0; i < cast(u64, SG_MAX_VIEW_BINDSLOTS); i++ {
        if shd.cmn.views[i].stage == SG_SHADERSTAGE_NONE {
            continue;
        }
        _sg_view_t* view = bnd.views[i];
        assert(cast(i64, view));
        assert(bgl_index < cast(u64, SG_MAX_VIEW_BINDSLOTS + SG_MAX_SAMPLER_BINDSLOTS));
        WGPUBindGroupEntry* bg_entry = &bg_entries[bgl_index];
        bg_entry.binding = shd.wgpu.view_grp1_bnd_n[i];
        if view.cmn.type == SG_VIEWTYPE_STORAGEBUFFER {
            _sg_buffer_t* buf = _sg_buffer_ref_ptr(&view.cmn.buf.ref);
            assert(cast(i64, buf.wgpu.buf));
            assert(view.cmn.buf.offset < buf.cmn.size);
            bg_entry.buffer = buf.wgpu.buf;
            bg_entry.offset = cast(u64, view.cmn.buf.offset);
            bg_entry.size = cast(u64, buf.cmn.size - view.cmn.buf.offset);
        } else {
            assert(cast(i64, view.wgpu.view));
            bg_entry.textureView = view.wgpu.view;
        }
        bgl_index += 1;
    }
    for u64 i = 0; i < cast(u64, SG_MAX_SAMPLER_BINDSLOTS); i++ {
        if shd.cmn.samplers[i].stage == SG_SHADERSTAGE_NONE {
            continue;
        }
        assert(cast(i64, bnd.smps[i]));
        assert(bgl_index < cast(u64, SG_MAX_VIEW_BINDSLOTS + SG_MAX_SAMPLER_BINDSLOTS));
        WGPUBindGroupEntry* bg_entry = &bg_entries[bgl_index];
        bg_entry.binding = shd.wgpu.smp_grp1_bnd_n[i];
        bg_entry.sampler = bnd.smps[i].wgpu.smp;
        bgl_index += 1;
    }
    WGPUBindGroupDescriptor bg_desc;
    bg_desc.layout = bgl;
    bg_desc.entryCount = bgl_index;
    bg_desc.entries = bg_entries;
    bg.bindgroup = wgpuDeviceCreateBindGroup(_sg.wgpu.dev, &bg_desc);
    if bg.bindgroup == null {
        _sg_log(SG_LOGITEM_WGPU_CREATEBINDGROUP_FAILED, 1, null, 7222);
        bg.slot.state = SG_RESOURCESTATE_FAILED;
        return bg;
    }
    _sg_wgpu_init_bindgroups_cache_key(&bg.key, bnd);
    bg.slot.state = SG_RESOURCESTATE_VALID;
    return bg;
}

void _sg_wgpu_discard_bindgroup(_sg_wgpu_bindgroup_t* bg) {
    assert(cast(i64, bg));
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.wgpu.bindings.num_discard_bindgroup++;
        }
    }
    if bg.slot.state == SG_RESOURCESTATE_VALID {
        if bg.bindgroup != null {
            wgpuBindGroupRelease(bg.bindgroup);
            bg.bindgroup = null;
        }
        _sg_wgpu_reset_bindgroup_to_alloc_state(bg);
        assert(bg.slot.state == SG_RESOURCESTATE_ALLOC);
    }
    if bg.slot.state == SG_RESOURCESTATE_ALLOC {
        _sg_wgpu_dealloc_bindgroup(bg);
        assert(bg.slot.state == SG_RESOURCESTATE_INITIAL);
    }
}

void _sg_wgpu_discard_all_bindgroups() {
    _sg_wgpu_bindgroups_pool_t* p = &_sg.wgpu.bindgroups_pool;
    for i32 i = 0; i < p.pool.size; i++ {
        sg_resource_state state = p.bindgroups[i].slot.state;
        if _sg_resource_state_valid_failed(state) != 0 {
            _sg_wgpu_discard_bindgroup(&p.bindgroups[i]);
        }
    }
}

void _sg_wgpu_bindgroups_cache_init(sg_desc* desc) {
    assert(cast(i64, desc));
    assert(_sg.wgpu.bindgroups_cache.num == 0);
    assert(_sg.wgpu.bindgroups_cache.index_mask == 0);
    assert(_sg.wgpu.bindgroups_cache.items == null);
    i32 num = desc.wgpu.bindgroups_cache_size;
    if num <= 1 {
        _sg_log(SG_LOGITEM_WGPU_BINDGROUPSCACHE_SIZE_GREATER_ONE, 0, null, 7221);
    }
    if (num & num - 1) == 0 == 0 {
        _sg_log(SG_LOGITEM_WGPU_BINDGROUPSCACHE_SIZE_POW2, 0, null, 7221);
    }
    _sg.wgpu.bindgroups_cache.num = cast(u32, desc.wgpu.bindgroups_cache_size);
    _sg.wgpu.bindgroups_cache.index_mask = _sg.wgpu.bindgroups_cache.num - 1;
    u64 size_in_bytes = cast(u64, sizeof(_sg_wgpu_bindgroup_handle_t)) * cast(u64, num);
    _sg.wgpu.bindgroups_cache.items = cast(_sg_wgpu_bindgroup_handle_t*, _sg_malloc_clear(size_in_bytes));
}

void _sg_wgpu_bindgroups_cache_discard() {
    if _sg.wgpu.bindgroups_cache.items != null {
        _sg_free(_sg.wgpu.bindgroups_cache.items);
        _sg.wgpu.bindgroups_cache.items = null;
    }
    _sg.wgpu.bindgroups_cache.num = 0;
    _sg.wgpu.bindgroups_cache.index_mask = 0;
}

void _sg_wgpu_bindgroups_cache_set(u64 hash, u32 bg_id) {
    var index = cast(u32, hash & _sg.wgpu.bindgroups_cache.index_mask);
    assert(index < _sg.wgpu.bindgroups_cache.num);
    assert(cast(i64, _sg.wgpu.bindgroups_cache.items));
    _sg.wgpu.bindgroups_cache.items[index].id = bg_id;
}

u32 _sg_wgpu_bindgroups_cache_get(u64 hash) {
    var index = cast(u32, hash & _sg.wgpu.bindgroups_cache.index_mask);
    assert(index < _sg.wgpu.bindgroups_cache.num);
    assert(cast(i64, _sg.wgpu.bindgroups_cache.items));
    return _sg.wgpu.bindgroups_cache.items[index].id;
}

void _sg_wgpu_bindgroups_cache_invalidate(_sg_wgpu_bindgroups_cache_item_type_t type, _sg_slot_t* slot) {
    u64 key_mask = _sg_wgpu_bindgroups_cache_item(type, 0xFF, 0xFFFFFFFF, 0xFFFFFFFF);
    u64 key_item = _sg_wgpu_bindgroups_cache_item(type, 0, slot.id, slot.uninit_count) & key_mask;
    assert(cast(i64, _sg.wgpu.bindgroups_cache.items));
    for u32 cache_item_idx = 0; cache_item_idx < _sg.wgpu.bindgroups_cache.num; cache_item_idx++ {
        u32 bg_id = _sg.wgpu.bindgroups_cache.items[cache_item_idx].id;
        if bg_id != cast(u32, SG_INVALID_ID) {
            _sg_wgpu_bindgroup_t* bg = _sg_wgpu_lookup_bindgroup(bg_id);
            assert(bg && bg.slot.state == SG_RESOURCESTATE_VALID);
            bool invalidate_cache_item = false;
            for i32 key_item_idx = 0; key_item_idx < 1 + (SG_MAX_VIEW_BINDSLOTS + SG_MAX_SAMPLER_BINDSLOTS); key_item_idx++ {
                if (bg.key.items[key_item_idx] & key_mask) == key_item {
                    invalidate_cache_item = true;
                    break;
                }
            }
            if invalidate_cache_item != 0 {
                _sg_wgpu_discard_bindgroup(bg);
                bg = null;
                _sg_wgpu_bindgroups_cache_set(cache_item_idx, cast(u32, SG_INVALID_ID));
                {
                    if _sg.stats_enabled != 0 {
                        _sg.stats.cur_frame.wgpu.bindings.num_bindgroup_cache_invalidates++;
                    }
                }
            }
        }
    }
}

void _sg_wgpu_bindings_cache_clear() {
    memset(&_sg.wgpu.bindings_cache, 0, cast(u64, sizeof(_sg.wgpu.bindings_cache)));
}

bool _sg_wgpu_bindings_cache_vb_dirty(u64 index, _sg_buffer_t* vb, u64 offset) {
    assert(index < cast(u64, SG_MAX_VERTEXBUFFER_BINDSLOTS));
    if vb != null {
        return _sg.wgpu.bindings_cache.vbs[index].buffer.id != vb.slot.id || _sg.wgpu.bindings_cache.vbs[index].offset != offset;
    } else {
        return _sg.wgpu.bindings_cache.vbs[index].buffer.id != cast(u32, SG_INVALID_ID);
    }
}

void _sg_wgpu_bindings_cache_vb_update(u64 index, _sg_buffer_t* vb, u64 offset) {
    assert(index < cast(u64, SG_MAX_VERTEXBUFFER_BINDSLOTS));
    if vb != null {
        _sg.wgpu.bindings_cache.vbs[index].buffer.id = vb.slot.id;
        _sg.wgpu.bindings_cache.vbs[index].offset = offset;
    } else {
        _sg.wgpu.bindings_cache.vbs[index].buffer.id = cast(u32, SG_INVALID_ID);
        _sg.wgpu.bindings_cache.vbs[index].offset = 0;
    }
}

bool _sg_wgpu_bindings_cache_ib_dirty(_sg_buffer_t* ib, u64 offset, WGPUIndexFormat format_var) {
    if ib != null {
        return _sg.wgpu.bindings_cache.ib.buffer.id != ib.slot.id || _sg.wgpu.bindings_cache.ib.offset != offset || _sg.wgpu.bindings_cache.ib.format != format_var;
    } else {
        return _sg.wgpu.bindings_cache.ib.buffer.id != cast(u32, SG_INVALID_ID);
    }
}

void _sg_wgpu_bindings_cache_ib_update(_sg_buffer_t* ib, u64 offset, WGPUIndexFormat format_var) {
    if ib != null {
        _sg.wgpu.bindings_cache.ib.buffer.id = ib.slot.id;
        _sg.wgpu.bindings_cache.ib.offset = offset;
        _sg.wgpu.bindings_cache.ib.format = format_var;
    } else {
        _sg.wgpu.bindings_cache.ib.buffer.id = cast(u32, SG_INVALID_ID);
        _sg.wgpu.bindings_cache.ib.offset = 0;
        _sg.wgpu.bindings_cache.ib.format = WGPUIndexFormat_Undefined;
    }
}

bool _sg_wgpu_bindings_cache_bg_dirty(_sg_wgpu_bindgroup_t* bg) {
    if bg != null {
        return _sg.wgpu.bindings_cache.bg.id != bg.slot.id;
    } else {
        return _sg.wgpu.bindings_cache.bg.id != cast(u32, SG_INVALID_ID);
    }
}

void _sg_wgpu_bindings_cache_bg_update(_sg_wgpu_bindgroup_t* bg) {
    if bg != null {
        _sg.wgpu.bindings_cache.bg.id = bg.slot.id;
    } else {
        _sg.wgpu.bindings_cache.bg.id = cast(u32, SG_INVALID_ID);
    }
}

void _sg_wgpu_set_bindgroup(u32 bg_idx, _sg_wgpu_bindgroup_t* bg) {
    if _sg_wgpu_bindings_cache_bg_dirty(bg) != 0 {
        _sg_wgpu_bindings_cache_bg_update(bg);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.wgpu.bindings.num_set_bindgroup++;
            }
        }
        if _sg.cur_pass.is_compute != 0 {
            assert(cast(i64, _sg.wgpu.cpass_enc));
            if bg != null {
                assert(bg.slot.state == SG_RESOURCESTATE_VALID);
                assert(cast(i64, bg.bindgroup));
                wgpuComputePassEncoderSetBindGroup(_sg.wgpu.cpass_enc, bg_idx, bg.bindgroup, 0, null);
            } else {
                wgpuComputePassEncoderSetBindGroup(_sg.wgpu.cpass_enc, bg_idx, null, 0, null);
            }
        } else {
            assert(cast(i64, _sg.wgpu.rpass_enc));
            if bg != null {
                assert(bg.slot.state == SG_RESOURCESTATE_VALID);
                assert(cast(i64, bg.bindgroup));
                wgpuRenderPassEncoderSetBindGroup(_sg.wgpu.rpass_enc, bg_idx, bg.bindgroup, 0, null);
            } else {
                wgpuRenderPassEncoderSetBindGroup(_sg.wgpu.rpass_enc, bg_idx, null, 0, null);
            }
        }
    } else {
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.wgpu.bindings.num_skip_redundant_bindgroup++;
            }
        }
    }
}

bool _sg_wgpu_apply_bindings_bindgroup(_sg_bindings_ptrs_t* bnd) {
    if _sg.desc.wgpu.disable_bindgroups_cache == 0 {
        _sg_wgpu_bindgroup_t* bg = null;
        noinit _sg_wgpu_bindgroups_cache_key_t key;
        _sg_wgpu_init_bindgroups_cache_key(&key, bnd);
        u32 bg_id = _sg_wgpu_bindgroups_cache_get(key.hash);
        if bg_id != cast(u32, SG_INVALID_ID) {
            bg = _sg_wgpu_lookup_bindgroup(bg_id);
            assert(bg && bg.slot.state == SG_RESOURCESTATE_VALID);
            if _sg_wgpu_compare_bindgroups_cache_key(&key, &bg.key) == 0 {
                {
                    if _sg.stats_enabled != 0 {
                        _sg.stats.cur_frame.wgpu.bindings.num_bindgroup_cache_collisions++;
                    }
                }
                _sg_wgpu_discard_bindgroup(bg);
                _sg_wgpu_bindgroups_cache_set(key.hash, cast(u32, SG_INVALID_ID));
                bg = null;
            } else {
                {
                    if _sg.stats_enabled != 0 {
                        _sg.stats.cur_frame.wgpu.bindings.num_bindgroup_cache_hits++;
                    }
                }
            }
        } else {
            {
                if _sg.stats_enabled != 0 {
                    _sg.stats.cur_frame.wgpu.bindings.num_bindgroup_cache_misses++;
                }
            }
        }
        if bg == null {
            bg = _sg_wgpu_create_bindgroup(bnd);
            _sg_wgpu_bindgroups_cache_set(key.hash, bg.slot.id);
        }
        if bg && bg.slot.state == SG_RESOURCESTATE_VALID {
            _sg_wgpu_set_bindgroup(1, bg);
        } else {
            return false;
        }
    } else {
        _sg_wgpu_bindgroup_t* bg = _sg_wgpu_create_bindgroup(bnd);
        if bg != null {
            if bg.slot.state == SG_RESOURCESTATE_VALID {
                _sg_wgpu_set_bindgroup(1, bg);
            }
            _sg_wgpu_discard_bindgroup(bg);
        } else {
            return false;
        }
    }
    return true;
}

bool _sg_wgpu_apply_index_buffer(_sg_bindings_ptrs_t* bnd) {
    assert(cast(i64, _sg.wgpu.rpass_enc));
    _sg_buffer_t* ib = bnd.ib;
    var offset = cast(u64, bnd.ib_offset);
    WGPUIndexFormat format_var = _sg_wgpu_indexformat(bnd.pip.cmn.index_type);  // renamed from: format
    if _sg_wgpu_bindings_cache_ib_dirty(ib, offset, format_var) != 0 {
        _sg_wgpu_bindings_cache_ib_update(ib, offset, format_var);
        if ib != null {
            var buf_size = cast(u64, ib.cmn.size);
            assert(buf_size > offset);
            u64 max_bytes = buf_size - offset;
            wgpuRenderPassEncoderSetIndexBuffer(_sg.wgpu.rpass_enc, ib.wgpu.buf, format_var, offset, max_bytes);
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.wgpu.bindings.num_set_index_buffer++;
            }
        }
    } else {
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.wgpu.bindings.num_skip_redundant_index_buffer++;
            }
        }
    }
    return true;
}

bool _sg_wgpu_apply_vertex_buffers(_sg_bindings_ptrs_t* bnd) {
    assert(cast(i64, _sg.wgpu.rpass_enc));
    for u32 slot = 0; slot < cast(u32, SG_MAX_VERTEXBUFFER_BINDSLOTS); slot++ {
        _sg_buffer_t* vb = bnd.vbs[slot];
        var offset = cast(u64, bnd.vb_offsets[slot]);
        if _sg_wgpu_bindings_cache_vb_dirty(slot, vb, offset) != 0 {
            _sg_wgpu_bindings_cache_vb_update(slot, vb, offset);
            if vb != null {
                var buf_size = cast(u64, vb.cmn.size);
                assert(buf_size > offset);
                u64 max_bytes = buf_size - offset;
                wgpuRenderPassEncoderSetVertexBuffer(_sg.wgpu.rpass_enc, slot, vb.wgpu.buf, offset, max_bytes);
            } else {
                wgpuRenderPassEncoderSetVertexBuffer(_sg.wgpu.rpass_enc, slot, null, 0, 0);
            }
            {
                if _sg.stats_enabled != 0 {
                    _sg.stats.cur_frame.wgpu.bindings.num_set_vertex_buffer++;
                }
            }
        } else {
            {
                if _sg.stats_enabled != 0 {
                    _sg.stats.cur_frame.wgpu.bindings.num_skip_redundant_vertex_buffer++;
                }
            }
        }
    }
    return true;
}

void _sg_wgpu_setup_backend(sg_desc* desc) {
    assert(cast(i64, desc));
    assert(cast(i64, desc.environment.wgpu.device));
    assert(desc.uniform_buffer_size > 0);
    _sg.wgpu.valid = true;
    _sg.wgpu.dev = cast(WGPUDevice, desc.environment.wgpu.device);
    _sg.wgpu.queue = wgpuDeviceGetQueue(_sg.wgpu.dev);
    assert(cast(i64, _sg.wgpu.queue));
    _sg_wgpu_init_caps();
    _sg_wgpu_uniform_system_init(desc);
    _sg_wgpu_bindgroups_pool_init(desc);
    _sg_wgpu_bindgroups_cache_init(desc);
    _sg_wgpu_bindings_cache_clear();
}

void _sg_wgpu_discard_backend() {
    assert(cast(i64, _sg.wgpu.valid));
    _sg.wgpu.valid = false;
    _sg_wgpu_discard_all_bindgroups();
    _sg_wgpu_bindgroups_cache_discard();
    _sg_wgpu_bindgroups_pool_discard();
    _sg_wgpu_uniform_system_discard();
    if _sg.wgpu.cmd_enc != null {
        wgpuCommandEncoderRelease(_sg.wgpu.cmd_enc);
        _sg.wgpu.cmd_enc = null;
    }
    wgpuQueueRelease(_sg.wgpu.queue);
    _sg.wgpu.queue = null;
}

void _sg_wgpu_reset_state_cache() {
    _sg_wgpu_bindings_cache_clear();
}

sg_resource_state _sg_wgpu_create_buffer(_sg_buffer_t* buf, sg_buffer_desc* desc) {
    assert(buf && desc);
    assert(buf.cmn.size > 0);
    bool injected = null != desc.wgpu_buffer;
    if injected != 0 {
        buf.wgpu.buf = cast(WGPUBuffer, desc.wgpu_buffer);
        wgpuBufferAddRef(buf.wgpu.buf);
    } else {
        u64 wgpu_buf_size = _sg_roundup_pow2_u64(cast(u64, buf.cmn.size), 4);
        bool map_at_creation = buf.cmn.usage.immutable && (desc.data.ptr || buf.cmn.usage.write_unsealed);
        WGPUBufferDescriptor wgpu_buf_desc;
        wgpu_buf_desc.usage = _sg_wgpu_buffer_usage(&buf.cmn.usage);
        wgpu_buf_desc.size = wgpu_buf_size;
        wgpu_buf_desc.mappedAtCreation = cast(WGPUBool, map_at_creation);
        wgpu_buf_desc.label = _sg_wgpu_stringview(desc.label);
        buf.wgpu.buf = wgpuDeviceCreateBuffer(_sg.wgpu.dev, &wgpu_buf_desc);
        if null == buf.wgpu.buf {
            _sg_log(SG_LOGITEM_WGPU_CREATE_BUFFER_FAILED, 1, null, 7222);
            return SG_RESOURCESTATE_FAILED;
        }
        if map_at_creation != 0 {
            buf.wgpu.mapped_ptr = cast(u8*, wgpuBufferGetMappedRange(buf.wgpu.buf, 0, wgpu_buf_size));
            assert(cast(i64, buf.wgpu.mapped_ptr));
            if desc.data.ptr != null {
                assert(desc.data.ptr && desc.data.size > 0);
                assert(desc.data.size <= cast(u64, buf.cmn.size));
                memcpy(buf.wgpu.mapped_ptr, desc.data.ptr, desc.data.size);
                wgpuBufferUnmap(buf.wgpu.buf);
                buf.wgpu.mapped_ptr = null;
            }
        }
    }
    return SG_RESOURCESTATE_VALID;
}

void _sg_wgpu_discard_buffer(_sg_buffer_t* buf) {
    assert(cast(i64, buf));
    assert(cast(i64, buf.wgpu.buf));
    if buf.wgpu.mapped_ptr != null {
        wgpuBufferUnmap(buf.wgpu.buf);
        buf.wgpu.mapped_ptr = null;
    }
    wgpuBufferRelease(buf.wgpu.buf);
}

void _sg_wgpu_seal_buffer(_sg_buffer_t* buf) {
    assert(cast(i64, buf));
    assert(cast(i64, buf.wgpu.buf));
    assert(cast(i64, buf.wgpu.mapped_ptr));
    wgpuBufferUnmap(buf.wgpu.buf);
    buf.wgpu.mapped_ptr = null;
}

void _sg_wgpu_copy_buffer_data(_sg_buffer_t* buf, u64 offset, sg_range* data) {
    assert(offset + data.size <= cast(u64, buf.cmn.size));
    u64 clamped_size = data.size & cast(u64, ~3);
    u64 extra_size = data.size & 3;
    assert(extra_size < 4);
    wgpuQueueWriteBuffer(_sg.wgpu.queue, buf.wgpu.buf, offset, data.ptr, clamped_size);
    if extra_size > 0 {
        u64 extra_src_offset = clamped_size;
        u64 extra_dst_offset = offset + clamped_size;
        u8[4] extra_data;
        u8* extra_src_ptr = cast(u8*, data.ptr) + extra_src_offset;
        for u64 i = 0; i < extra_size; i++ {
            extra_data[i] = extra_src_ptr[i];
        }
        wgpuQueueWriteBuffer(_sg.wgpu.queue, buf.wgpu.buf, extra_dst_offset, extra_data, 4);
    }
}

void _sg_wgpu_write_miplevel_data(_sg_image_t* img, u8* src_ptr, u64 src_size, u64 src_offset, i32 src_bytes_per_row, i32 src_bytes_per_slice, i32 mip_level, i32 x, i32 y, i32 slice, i32 width, i32 height, i32 num_slices) {
    assert(cast(i64, img));
    assert(cast(i64, src_ptr));
    assert(src_size > 0);
    assert(src_bytes_per_row > 0);
    assert(src_bytes_per_slice > 0);
    assert(mip_level >= 0 && mip_level < img.cmn.num_mipmaps);
    assert(x >= 0 && x < _sg_miplevel_dim(img.cmn.width, mip_level));
    assert(y >= 0 && y < _sg_miplevel_dim(img.cmn.height, mip_level));
    assert(slice >= 0 && slice < img.cmn.num_slices);
    assert(width > 0 && x + width <= _sg_miplevel_dim(img.cmn.width, mip_level));
    assert(height > 0 && y + height <= _sg_miplevel_dim(img.cmn.height, mip_level));
    assert(num_slices > 0 && slice + num_slices <= img.cmn.num_slices);
    assert(src_offset + cast(u64, src_bytes_per_slice) * cast(u64, num_slices) <= src_size);
    assert(cast(i64, _sg_multiple(src_bytes_per_row, _sg_block_bytesize(img.cmn.pixel_format))));
    assert(cast(i64, _sg_multiple(src_bytes_per_slice, src_bytes_per_row)));
    i32 block_dim = _sg_block_dim(img.cmn.pixel_format);
    WGPUTexelCopyBufferLayout wgpu_layout;
    WGPUTexelCopyTextureInfo wgpu_copy_tex;
    WGPUExtent3D wgpu_extent;
    wgpu_layout.offset = src_offset;
    wgpu_layout.bytesPerRow = cast(u32, src_bytes_per_row);
    wgpu_layout.rowsPerImage = cast(u32, src_bytes_per_slice / src_bytes_per_row);
    wgpu_copy_tex.texture = img.wgpu.tex;
    wgpu_copy_tex.mipLevel = cast(u32, mip_level);
    wgpu_copy_tex.origin.x = cast(u32, x);
    wgpu_copy_tex.origin.y = cast(u32, y);
    wgpu_copy_tex.origin.z = cast(u32, slice);
    wgpu_copy_tex.aspect = WGPUTextureAspect_All;
    wgpu_extent.width = cast(u32, _sg_roundup_pow2(width, block_dim));
    wgpu_extent.height = cast(u32, _sg_roundup_pow2(height, block_dim));
    wgpu_extent.depthOrArrayLayers = cast(u32, num_slices);
    wgpuQueueWriteTexture(_sg.wgpu.queue, &wgpu_copy_tex, cast(void*, src_ptr), src_size, &wgpu_layout, &wgpu_extent);
}

void _sg_wgpu_copy_image_data(_sg_image_t* img, sg_image_data* data) {
    for i32 mip_level = 0; mip_level < img.cmn.num_mipmaps; mip_level++ {
        i32 mip_width = _sg_miplevel_dim(img.cmn.width, mip_level);
        i32 mip_height = _sg_miplevel_dim(img.cmn.height, mip_level);
        i32 mip_depth_or_slices = img.cmn.type == SG_IMAGETYPE_3D ? _sg_miplevel_dim(img.cmn.num_slices, mip_level) : img.cmn.num_slices;
        i32 bytes_per_row = _sg_row_pitch(img.cmn.pixel_format, mip_width, 1);
        i32 bytes_per_slice = _sg_surface_pitch(img.cmn.pixel_format, mip_width, mip_height, 1);
        _sg_wgpu_write_miplevel_data(img, cast(u8*, data.mip_levels[mip_level].ptr), data.mip_levels[mip_level].size, 0, bytes_per_row, bytes_per_slice, mip_level, 0, 0, 0, mip_width, mip_height, mip_depth_or_slices);
    }
}

sg_resource_state _sg_wgpu_create_image(_sg_image_t* img, sg_image_desc* desc) {
    assert(img && desc);
    bool injected = null != desc.wgpu_texture;
    if injected != 0 {
        img.wgpu.tex = cast(WGPUTexture, desc.wgpu_texture);
        wgpuTextureAddRef(img.wgpu.tex);
    } else {
        WGPUTextureDescriptor wgpu_tex_desc;
        wgpu_tex_desc.label = _sg_wgpu_stringview(desc.label);
        wgpu_tex_desc.usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
        if desc.usage.color_attachment || desc.usage.resolve_attachment || desc.usage.depth_stencil_attachment {
            wgpu_tex_desc.usage |= WGPUTextureUsage_RenderAttachment;
        }
        if desc.usage.storage_image != 0 {
            wgpu_tex_desc.usage |= WGPUTextureUsage_StorageBinding;
        }
        wgpu_tex_desc.dimension = _sg_wgpu_texture_dimension(img.cmn.type);
        wgpu_tex_desc.size.width = cast(u32, img.cmn.width);
        wgpu_tex_desc.size.height = cast(u32, img.cmn.height);
        wgpu_tex_desc.size.depthOrArrayLayers = cast(u32, img.cmn.num_slices);
        wgpu_tex_desc.format = _sg_wgpu_textureformat(img.cmn.pixel_format);
        wgpu_tex_desc.mipLevelCount = cast(u32, img.cmn.num_mipmaps);
        wgpu_tex_desc.sampleCount = cast(u32, img.cmn.sample_count);
        img.wgpu.tex = wgpuDeviceCreateTexture(_sg.wgpu.dev, &wgpu_tex_desc);
        if null == img.wgpu.tex {
            _sg_log(SG_LOGITEM_WGPU_CREATE_TEXTURE_FAILED, 1, null, 7222);
            return SG_RESOURCESTATE_FAILED;
        }
        if desc.data.mip_levels[0].ptr != null {
            _sg_wgpu_copy_image_data(img, &desc.data);
        }
    }
    return SG_RESOURCESTATE_VALID;
}

void _sg_wgpu_discard_image(_sg_image_t* img) {
    assert(cast(i64, img));
    if img.wgpu.tex != null {
        wgpuTextureRelease(img.wgpu.tex);
        img.wgpu.tex = null;
    }
}

void _sg_wgpu_seal_image(_sg_image_t* img) {
    assert(cast(i64, img));
    ignore img;
}

sg_resource_state _sg_wgpu_create_sampler(_sg_sampler_t* smp, sg_sampler_desc* desc) {
    assert(smp && desc);
    assert(cast(i64, _sg.wgpu.dev));
    bool injected = null != desc.wgpu_sampler;
    if injected != 0 {
        smp.wgpu.smp = cast(WGPUSampler, desc.wgpu_sampler);
        wgpuSamplerAddRef(smp.wgpu.smp);
    } else {
        WGPUSamplerDescriptor wgpu_desc;
        wgpu_desc.label = _sg_wgpu_stringview(desc.label);
        wgpu_desc.addressModeU = _sg_wgpu_sampler_address_mode(desc.wrap_u);
        wgpu_desc.addressModeV = _sg_wgpu_sampler_address_mode(desc.wrap_v);
        wgpu_desc.addressModeW = _sg_wgpu_sampler_address_mode(desc.wrap_w);
        wgpu_desc.magFilter = _sg_wgpu_sampler_minmag_filter(desc.mag_filter);
        wgpu_desc.minFilter = _sg_wgpu_sampler_minmag_filter(desc.min_filter);
        wgpu_desc.mipmapFilter = _sg_wgpu_sampler_mipmap_filter(desc.mipmap_filter);
        wgpu_desc.lodMinClamp = desc.min_lod;
        wgpu_desc.lodMaxClamp = desc.max_lod;
        wgpu_desc.compare = _sg_wgpu_comparefunc(desc.compare);
        if wgpu_desc.compare == WGPUCompareFunction_Never {
            wgpu_desc.compare = WGPUCompareFunction_Undefined;
        }
        wgpu_desc.maxAnisotropy = cast(u16, desc.max_anisotropy);
        smp.wgpu.smp = wgpuDeviceCreateSampler(_sg.wgpu.dev, &wgpu_desc);
        if null == smp.wgpu.smp {
            _sg_log(SG_LOGITEM_WGPU_CREATE_SAMPLER_FAILED, 1, null, 7222);
            return SG_RESOURCESTATE_FAILED;
        }
    }
    return SG_RESOURCESTATE_VALID;
}

void _sg_wgpu_discard_sampler(_sg_sampler_t* smp) {
    assert(cast(i64, smp));
    _sg_wgpu_bindgroups_cache_invalidate(_SG_WGPU_BINDGROUPSCACHEITEMTYPE_SAMPLER, &smp.slot);
    if smp.wgpu.smp != null {
        wgpuSamplerRelease(smp.wgpu.smp);
        smp.wgpu.smp = null;
    }
}

_sg_wgpu_shader_func_t _sg_wgpu_create_shader_func(sg_shader_function* func, u8* label) {
    assert(cast(i64, func));
    assert(cast(i64, func.source));
    assert(cast(i64, func.entry));
    _sg_wgpu_shader_func_t res;
    _sg_strcpy(&res.entry, func.entry);
    WGPUShaderSourceWGSL wgpu_shdsrc_wgsl;
    wgpu_shdsrc_wgsl.chain.sType = WGPUSType_ShaderSourceWGSL;
    wgpu_shdsrc_wgsl.code = _sg_wgpu_stringview(func.source);
    WGPUShaderModuleDescriptor wgpu_shdmod_desc;
    wgpu_shdmod_desc.nextInChain = &wgpu_shdsrc_wgsl.chain;
    wgpu_shdmod_desc.label = _sg_wgpu_stringview(label);
    res.module = wgpuDeviceCreateShaderModule(_sg.wgpu.dev, &wgpu_shdmod_desc);
    if null == res.module {
        _sg_log(SG_LOGITEM_WGPU_CREATE_SHADER_MODULE_FAILED, 1, null, 7222);
    }
    return res;
}

void _sg_wgpu_discard_shader_func(_sg_wgpu_shader_func_t* func) {
    if func.module != null {
        wgpuShaderModuleRelease(func.module);
        func.module = null;
    }
}

i32 _sg_wgpu_dynoffset_cmp(void* a, void* b) {
    var aa = cast(_sg_wgpu_dynoffset_mapping_t*, a);
    var bb = cast(_sg_wgpu_dynoffset_mapping_t*, b);
    if aa.wgpu_slot < bb.wgpu_slot {
        return -1;
    } else if aa.wgpu_slot > bb.wgpu_slot {
        return 1;
    }
    return 0;
}

bool _sg_wgpu_ensure_wgsl_bindslot_ranges(sg_shader_desc* desc) {
    assert(cast(i64, desc));
    for u64 i = 0; i < cast(u64, SG_MAX_UNIFORMBLOCK_BINDSLOTS); i++ {
        sg_shader_uniform_block* ub = &desc.uniform_blocks[i];
        if ub.stage != SG_SHADERSTAGE_NONE {
            if cast(i32, ub.wgsl_group0_binding_n) >= 2 * SG_MAX_UNIFORMBLOCK_BINDSLOTS {
                _sg_log(SG_LOGITEM_WGPU_UNIFORMBLOCK_WGSL_GROUP0_BINDING_OUT_OF_RANGE, 1, null, 7222);
                return false;
            }
        }
    }
    for u64 i = 0; i < cast(u64, SG_MAX_VIEW_BINDSLOTS); i++ {
        sg_shader_view* view = &desc.views[i];
        if view.texture.stage != SG_SHADERSTAGE_NONE {
            if view.texture.wgsl_group1_binding_n >= 128 {
                _sg_log(SG_LOGITEM_WGPU_TEXTURE_WGSL_GROUP1_BINDING_OUT_OF_RANGE, 1, null, 7222);
                return false;
            }
        }
        if view.storage_buffer.stage != SG_SHADERSTAGE_NONE {
            if view.storage_buffer.wgsl_group1_binding_n >= 128 {
                _sg_log(SG_LOGITEM_WGPU_STORAGEBUFFER_WGSL_GROUP1_BINDING_OUT_OF_RANGE, 1, null, 7222);
                return false;
            }
        }
        if view.storage_image.stage != SG_SHADERSTAGE_NONE {
            if view.storage_image.wgsl_group1_binding_n >= 128 {
                _sg_log(SG_LOGITEM_WGPU_STORAGEIMAGE_WGSL_GROUP1_BINDING_OUT_OF_RANGE, 1, null, 7222);
                return false;
            }
        }
    }
    for u64 i = 0; i < cast(u64, SG_MAX_SAMPLER_BINDSLOTS); i++ {
        sg_shader_sampler* smp = &desc.samplers[i];
        if smp.stage != SG_SHADERSTAGE_NONE {
            if smp.wgsl_group1_binding_n >= 128 {
                _sg_log(SG_LOGITEM_WGPU_SAMPLER_WGSL_GROUP1_BINDING_OUT_OF_RANGE, 1, null, 7222);
                return false;
            }
        }
    }
    return true;
}

sg_resource_state _sg_wgpu_create_shader(_sg_shader_t* shd, sg_shader_desc* desc) {
    assert(shd && desc);
    assert(shd.wgpu.vertex_func.module == null);
    assert(shd.wgpu.fragment_func.module == null);
    assert(shd.wgpu.compute_func.module == null);
    assert(shd.wgpu.bgl_ub == null);
    assert(shd.wgpu.bg_ub == null);
    assert(shd.wgpu.bgl_view_smp == null);
    if _sg_wgpu_ensure_wgsl_bindslot_ranges(desc) == 0 {
        return SG_RESOURCESTATE_FAILED;
    }
    bool shd_valid = true;
    if desc.vertex_func.source != null {
        shd.wgpu.vertex_func = _sg_wgpu_create_shader_func(&desc.vertex_func, desc.label);
        shd_valid &= shd.wgpu.vertex_func.module != null;
    }
    if desc.fragment_func.source != null {
        shd.wgpu.fragment_func = _sg_wgpu_create_shader_func(&desc.fragment_func, desc.label);
        shd_valid &= shd.wgpu.fragment_func.module != null;
    }
    if desc.compute_func.source != null {
        shd.wgpu.compute_func = _sg_wgpu_create_shader_func(&desc.compute_func, desc.label);
        shd_valid &= shd.wgpu.compute_func.module != null;
    }
    if shd_valid == 0 {
        _sg_wgpu_discard_shader_func(&shd.wgpu.vertex_func);
        _sg_wgpu_discard_shader_func(&shd.wgpu.fragment_func);
        _sg_wgpu_discard_shader_func(&shd.wgpu.compute_func);
        return SG_RESOURCESTATE_FAILED;
    }
    assert(SG_MAX_UNIFORMBLOCK_BINDSLOTS <= SG_MAX_VIEW_BINDSLOTS + SG_MAX_SAMPLER_BINDSLOTS);
    WGPUBindGroupLayoutEntry[44] bgl_entries;
    WGPUBindGroupLayoutDescriptor bgl_desc;
    WGPUBindGroupEntry[44] bg_entries;
    WGPUBindGroupDescriptor bg_desc;
    _sg_wgpu_dynoffset_mapping_t[8] dynoffset_map;
    u64 bgl_index = 0;
    for u64 i = 0; i < cast(u64, SG_MAX_UNIFORMBLOCK_BINDSLOTS); i++ {
        if shd.cmn.uniform_blocks[i].stage == SG_SHADERSTAGE_NONE {
            continue;
        }
        shd.wgpu.ub_grp0_bnd_n[i] = desc.uniform_blocks[i].wgsl_group0_binding_n;
        WGPUBindGroupEntry* bg_entry = &bg_entries[bgl_index];
        WGPUBindGroupLayoutEntry* bgl_entry = &bgl_entries[bgl_index];
        bgl_entry.binding = shd.wgpu.ub_grp0_bnd_n[i];
        bgl_entry.visibility = _sg_wgpu_shader_stage(shd.cmn.uniform_blocks[i].stage);
        bgl_entry.buffer.type = WGPUBufferBindingType_Uniform;
        bgl_entry.buffer.hasDynamicOffset = true;
        bg_entry.binding = bgl_entry.binding;
        bg_entry.buffer = _sg.wgpu.uniform.buf;
        bg_entry.size = cast(u64, 1 << 16);
        dynoffset_map[i].sokol_slot = cast(u8, i);
        dynoffset_map[i].wgpu_slot = cast(u8, bgl_entry.binding);
        bgl_index += 1;
    }
    bgl_desc.entryCount = bgl_index;
    bgl_desc.entries = bgl_entries;
    shd.wgpu.bgl_ub = wgpuDeviceCreateBindGroupLayout(_sg.wgpu.dev, &bgl_desc);
    assert(cast(i64, shd.wgpu.bgl_ub));
    bg_desc.layout = shd.wgpu.bgl_ub;
    bg_desc.entryCount = bgl_index;
    bg_desc.entries = bg_entries;
    shd.wgpu.bg_ub = wgpuDeviceCreateBindGroup(_sg.wgpu.dev, &bg_desc);
    assert(cast(i64, shd.wgpu.bg_ub));
    qsort(dynoffset_map, bgl_index, sizeof(_sg_wgpu_dynoffset_mapping_t), _sg_wgpu_dynoffset_cmp);
    shd.wgpu.ub_num_dynoffsets = cast(u8, bgl_index);
    for u8 i = 0; i < bgl_index; i++ {
        u8 sokol_slot = dynoffset_map[i].sokol_slot;
        shd.wgpu.ub_dynoffsets[sokol_slot] = i;
    }
    _sg_clear(bgl_entries, cast(u64, sizeof(bgl_entries)));
    _sg_clear(&bgl_desc, cast(u64, sizeof(bgl_desc)));
    bgl_index = 0;
    for u64 i = 0; i < cast(u64, SG_MAX_VIEW_BINDSLOTS); i++ {
        if shd.cmn.views[i].stage == SG_SHADERSTAGE_NONE {
            continue;
        }
        WGPUBindGroupLayoutEntry* bgl_entry = &bgl_entries[bgl_index];
        bgl_entry.visibility = _sg_wgpu_shader_stage(shd.cmn.views[i].stage);
        if shd.cmn.views[i].view_type == SG_VIEWTYPE_TEXTURE {
            shd.wgpu.view_grp1_bnd_n[i] = desc.views[i].texture.wgsl_group1_binding_n;
            bool msaa = shd.cmn.views[i].multisampled;
            bgl_entry.texture.viewDimension = _sg_wgpu_texture_view_dimension(shd.cmn.views[i].image_type);
            bgl_entry.texture.sampleType = _sg_wgpu_texture_sample_type(shd.cmn.views[i].sample_type, msaa);
            bgl_entry.texture.multisampled = cast(WGPUBool, msaa);
        } else if shd.cmn.views[i].view_type == SG_VIEWTYPE_STORAGEBUFFER {
            shd.wgpu.view_grp1_bnd_n[i] = desc.views[i].storage_buffer.wgsl_group1_binding_n;
            if shd.cmn.views[i].sbuf_readonly != 0 {
                bgl_entry.buffer.type = WGPUBufferBindingType_ReadOnlyStorage;
            } else {
                bgl_entry.buffer.type = WGPUBufferBindingType_Storage;
            }
        } else if shd.cmn.views[i].view_type == SG_VIEWTYPE_STORAGEIMAGE {
            shd.wgpu.view_grp1_bnd_n[i] = desc.views[i].storage_image.wgsl_group1_binding_n;
            if shd.cmn.views[i].simg_writeonly != 0 {
                bgl_entry.storageTexture.access = WGPUStorageTextureAccess_WriteOnly;
            } else {
                bgl_entry.storageTexture.access = WGPUStorageTextureAccess_ReadWrite;
            }
            bgl_entry.storageTexture.format = _sg_wgpu_textureformat(shd.cmn.views[i].access_format);
            bgl_entry.storageTexture.viewDimension = _sg_wgpu_texture_view_dimension(shd.cmn.views[i].image_type);
        } else {
            assert(cast(i64, false));
        }
        bgl_entry.binding = shd.wgpu.view_grp1_bnd_n[i];
        bgl_index += 1;
    }
    for u64 i = 0; i < cast(u64, SG_MAX_SAMPLER_BINDSLOTS); i++ {
        if shd.cmn.samplers[i].stage == SG_SHADERSTAGE_NONE {
            continue;
        }
        shd.wgpu.smp_grp1_bnd_n[i] = desc.samplers[i].wgsl_group1_binding_n;
        WGPUBindGroupLayoutEntry* bgl_entry = &bgl_entries[bgl_index];
        bgl_entry.binding = shd.wgpu.smp_grp1_bnd_n[i];
        bgl_entry.visibility = _sg_wgpu_shader_stage(shd.cmn.samplers[i].stage);
        bgl_entry.sampler.type = _sg_wgpu_sampler_binding_type(shd.cmn.samplers[i].sampler_type);
        bgl_index += 1;
    }
    bgl_desc.entryCount = bgl_index;
    bgl_desc.entries = bgl_entries;
    shd.wgpu.bgl_view_smp = wgpuDeviceCreateBindGroupLayout(_sg.wgpu.dev, &bgl_desc);
    if shd.wgpu.bgl_view_smp == null {
        _sg_log(SG_LOGITEM_WGPU_SHADER_CREATE_BINDGROUP_LAYOUT_FAILED, 1, null, 7222);
        return SG_RESOURCESTATE_FAILED;
    }
    return SG_RESOURCESTATE_VALID;
}

void _sg_wgpu_discard_shader(_sg_shader_t* shd) {
    assert(cast(i64, shd));
    _sg_wgpu_discard_shader_func(&shd.wgpu.vertex_func);
    _sg_wgpu_discard_shader_func(&shd.wgpu.fragment_func);
    _sg_wgpu_discard_shader_func(&shd.wgpu.compute_func);
    if shd.wgpu.bgl_ub != null {
        wgpuBindGroupLayoutRelease(shd.wgpu.bgl_ub);
        shd.wgpu.bgl_ub = null;
    }
    if shd.wgpu.bg_ub != null {
        wgpuBindGroupRelease(shd.wgpu.bg_ub);
        shd.wgpu.bg_ub = null;
    }
    if shd.wgpu.bgl_view_smp != null {
        wgpuBindGroupLayoutRelease(shd.wgpu.bgl_view_smp);
        shd.wgpu.bgl_view_smp = null;
    }
}

sg_resource_state _sg_wgpu_create_pipeline(_sg_pipeline_t* pip, sg_pipeline_desc* desc) {
    assert(pip && desc);
    _sg_shader_t* shd = _sg_shader_ref_ptr(&pip.cmn.shader);
    assert(cast(i64, shd.wgpu.bgl_ub));
    assert(cast(i64, shd.wgpu.bgl_view_smp));
    pip.wgpu.blend_color.r = cast(f64, desc.blend_color.r);
    pip.wgpu.blend_color.g = cast(f64, desc.blend_color.g);
    pip.wgpu.blend_color.b = cast(f64, desc.blend_color.b);
    pip.wgpu.blend_color.a = cast(f64, desc.blend_color.a);
    u64 num_bgls = 2;
    WGPUBindGroupLayout[2] wgpu_bgl;
    wgpu_bgl[0] = shd.wgpu.bgl_ub;
    wgpu_bgl[1] = shd.wgpu.bgl_view_smp;
    WGPUPipelineLayoutDescriptor wgpu_pl_desc;
    wgpu_pl_desc.bindGroupLayoutCount = num_bgls;
    wgpu_pl_desc.bindGroupLayouts = &wgpu_bgl[0];
    WGPUPipelineLayout wgpu_pip_layout = wgpuDeviceCreatePipelineLayout(_sg.wgpu.dev, &wgpu_pl_desc);
    if null == wgpu_pip_layout {
        _sg_log(SG_LOGITEM_WGPU_CREATE_PIPELINE_LAYOUT_FAILED, 1, null, 7222);
        return SG_RESOURCESTATE_FAILED;
    }
    assert(cast(i64, wgpu_pip_layout));
    if pip.cmn.is_compute != 0 {
        WGPUComputePipelineDescriptor wgpu_pip_desc;
        wgpu_pip_desc.label = _sg_wgpu_stringview(desc.label);
        wgpu_pip_desc.layout = wgpu_pip_layout;
        wgpu_pip_desc.compute.module = shd.wgpu.compute_func.module;
        wgpu_pip_desc.compute.entryPoint = _sg_wgpu_stringview(shd.wgpu.compute_func.entry.buf);
        pip.wgpu.cpip = wgpuDeviceCreateComputePipeline(_sg.wgpu.dev, &wgpu_pip_desc);
        wgpuPipelineLayoutRelease(wgpu_pip_layout);
        if null == pip.wgpu.cpip {
            _sg_log(SG_LOGITEM_WGPU_CREATE_COMPUTE_PIPELINE_FAILED, 1, null, 7222);
            return SG_RESOURCESTATE_FAILED;
        }
    } else {
        WGPUVertexBufferLayout[8] wgpu_vb_layouts;
        WGPUVertexAttribute:[8][16] wgpu_vtx_attrs;
        i32 wgpu_vb_num = 0;
        for i32 vb_idx = 0; vb_idx < SG_MAX_VERTEXBUFFER_BINDSLOTS; vb_idx++ {
            sg_vertex_buffer_layout_state* vbl_state = &desc.layout.buffers[vb_idx];
            if 0 == vbl_state.stride {
                break;
            }
            wgpu_vb_layouts[vb_idx].arrayStride = cast(u64, vbl_state.stride);
            wgpu_vb_layouts[vb_idx].stepMode = _sg_wgpu_stepmode(vbl_state.step_func);
            wgpu_vb_layouts[vb_idx].attributes = &wgpu_vtx_attrs[vb_idx][0];
            wgpu_vb_num++;
        }
        for i32 va_idx = 0; va_idx < SG_MAX_VERTEX_ATTRIBUTES; va_idx++ {
            sg_vertex_attr_state* va_state = &desc.layout.attrs[va_idx];
            if SG_VERTEXFORMAT_INVALID == va_state.format {
                break;
            }
            i32 vb_idx = va_state.buffer_index;
            assert(vb_idx < SG_MAX_VERTEXBUFFER_BINDSLOTS);
            assert(cast(i64, pip.cmn.vertex_buffer_layout_active[vb_idx]));
            u64 wgpu_attr_idx = wgpu_vb_layouts[vb_idx].attributeCount;
            wgpu_vb_layouts[vb_idx].attributeCount += 1;
            wgpu_vtx_attrs[vb_idx][wgpu_attr_idx].format = _sg_wgpu_vertexformat(va_state.format);
            wgpu_vtx_attrs[vb_idx][wgpu_attr_idx].offset = cast(u64, va_state.offset);
            wgpu_vtx_attrs[vb_idx][wgpu_attr_idx].shaderLocation = cast(u32, va_idx);
        }
        WGPURenderPipelineDescriptor wgpu_pip_desc;
        WGPUDepthStencilState wgpu_ds_state;
        WGPUFragmentState wgpu_frag_state;
        WGPUColorTargetState[8] wgpu_ctgt_state;
        WGPUBlendState[8] wgpu_blend_state;
        wgpu_pip_desc.label = _sg_wgpu_stringview(desc.label);
        wgpu_pip_desc.layout = wgpu_pip_layout;
        wgpu_pip_desc.vertex.module = shd.wgpu.vertex_func.module;
        wgpu_pip_desc.vertex.entryPoint = _sg_wgpu_stringview(shd.wgpu.vertex_func.entry.buf);
        wgpu_pip_desc.vertex.bufferCount = cast(u64, wgpu_vb_num);
        wgpu_pip_desc.vertex.buffers = &wgpu_vb_layouts[0];
        wgpu_pip_desc.primitive.topology = _sg_wgpu_topology(desc.primitive_type);
        wgpu_pip_desc.primitive.stripIndexFormat = _sg_wgpu_stripindexformat(desc.primitive_type, desc.index_type);
        wgpu_pip_desc.primitive.frontFace = _sg_wgpu_frontface(desc.face_winding);
        wgpu_pip_desc.primitive.cullMode = _sg_wgpu_cullmode(desc.cull_mode);
        if SG_PIXELFORMAT_NONE != desc.depth.pixel_format {
            wgpu_ds_state.format = _sg_wgpu_textureformat(desc.depth.pixel_format);
            wgpu_ds_state.depthWriteEnabled = _sg_wgpu_optional_bool(desc.depth.write_enabled);
            wgpu_ds_state.depthCompare = _sg_wgpu_comparefunc(desc.depth.compare);
            wgpu_ds_state.stencilFront.compare = _sg_wgpu_comparefunc(desc.stencil.front.compare);
            wgpu_ds_state.stencilFront.failOp = _sg_wgpu_stencilop(desc.stencil.front.fail_op);
            wgpu_ds_state.stencilFront.depthFailOp = _sg_wgpu_stencilop(desc.stencil.front.depth_fail_op);
            wgpu_ds_state.stencilFront.passOp = _sg_wgpu_stencilop(desc.stencil.front.pass_op);
            wgpu_ds_state.stencilBack.compare = _sg_wgpu_comparefunc(desc.stencil.back.compare);
            wgpu_ds_state.stencilBack.failOp = _sg_wgpu_stencilop(desc.stencil.back.fail_op);
            wgpu_ds_state.stencilBack.depthFailOp = _sg_wgpu_stencilop(desc.stencil.back.depth_fail_op);
            wgpu_ds_state.stencilBack.passOp = _sg_wgpu_stencilop(desc.stencil.back.pass_op);
            wgpu_ds_state.stencilReadMask = desc.stencil.read_mask;
            wgpu_ds_state.stencilWriteMask = desc.stencil.write_mask;
            wgpu_ds_state.depthBias = cast(i32, desc.depth.bias);
            wgpu_ds_state.depthBiasSlopeScale = desc.depth.bias_slope_scale;
            wgpu_ds_state.depthBiasClamp = desc.depth.bias_clamp;
            wgpu_pip_desc.depthStencil = &wgpu_ds_state;
        }
        wgpu_pip_desc.multisample.count = cast(u32, desc.sample_count);
        wgpu_pip_desc.multisample.mask = 0xFFFFFFFF;
        wgpu_pip_desc.multisample.alphaToCoverageEnabled = cast(WGPUBool, desc.alpha_to_coverage_enabled);
        if desc.color_count > 0 {
            wgpu_frag_state.module = shd.wgpu.fragment_func.module;
            wgpu_frag_state.entryPoint = _sg_wgpu_stringview(shd.wgpu.fragment_func.entry.buf);
            wgpu_frag_state.targetCount = cast(u64, desc.color_count);
            wgpu_frag_state.targets = &wgpu_ctgt_state[0];
            for i32 i = 0; i < desc.color_count; i++ {
                assert(i < SG_MAX_COLOR_ATTACHMENTS);
                wgpu_ctgt_state[i].format = _sg_wgpu_textureformat(desc.colors[i].pixel_format);
                wgpu_ctgt_state[i].writeMask = _sg_wgpu_colorwritemask(desc.colors[i].write_mask);
                if desc.colors[i].blend.enabled != 0 {
                    wgpu_ctgt_state[i].blend = &wgpu_blend_state[i];
                    wgpu_blend_state[i].color.operation = _sg_wgpu_blendop(desc.colors[i].blend.op_rgb);
                    wgpu_blend_state[i].color.srcFactor = _sg_wgpu_blendfactor(desc.colors[i].blend.src_factor_rgb);
                    wgpu_blend_state[i].color.dstFactor = _sg_wgpu_blendfactor(desc.colors[i].blend.dst_factor_rgb);
                    wgpu_blend_state[i].alpha.operation = _sg_wgpu_blendop(desc.colors[i].blend.op_alpha);
                    wgpu_blend_state[i].alpha.srcFactor = _sg_wgpu_blendfactor(desc.colors[i].blend.src_factor_alpha);
                    wgpu_blend_state[i].alpha.dstFactor = _sg_wgpu_blendfactor(desc.colors[i].blend.dst_factor_alpha);
                }
            }
            wgpu_pip_desc.fragment = &wgpu_frag_state;
        }
        pip.wgpu.rpip = wgpuDeviceCreateRenderPipeline(_sg.wgpu.dev, &wgpu_pip_desc);
        wgpuPipelineLayoutRelease(wgpu_pip_layout);
        if null == pip.wgpu.rpip {
            _sg_log(SG_LOGITEM_WGPU_CREATE_RENDER_PIPELINE_FAILED, 1, null, 7222);
            return SG_RESOURCESTATE_FAILED;
        }
    }
    return SG_RESOURCESTATE_VALID;
}

void _sg_wgpu_discard_pipeline(_sg_pipeline_t* pip) {
    assert(cast(i64, pip));
    _sg_wgpu_bindgroups_cache_invalidate(_SG_WGPU_BINDGROUPSCACHEITEMTYPE_PIPELINE, &pip.slot);
    if pip.wgpu.rpip != null {
        wgpuRenderPipelineRelease(pip.wgpu.rpip);
        pip.wgpu.rpip = null;
    }
    if pip.wgpu.cpip != null {
        wgpuComputePipelineRelease(pip.wgpu.cpip);
        pip.wgpu.cpip = null;
    }
}

sg_resource_state _sg_wgpu_create_view(_sg_view_t* view, sg_view_desc* desc) {
    assert(view && desc);
    if view.cmn.type != SG_VIEWTYPE_STORAGEBUFFER {
        _sg_image_t* img = _sg_image_ref_ptr(&view.cmn.img.ref);
        assert(cast(i64, img.wgpu.tex));
        assert(view.cmn.img.mip_level_count >= 1);
        assert(view.cmn.img.slice_count >= 1);
        WGPUTextureViewDescriptor wgpu_texview_desc;
        wgpu_texview_desc.label = _sg_wgpu_stringview(desc.label);
        wgpu_texview_desc.baseMipLevel = cast(u32, view.cmn.img.mip_level);
        wgpu_texview_desc.mipLevelCount = cast(u32, view.cmn.img.mip_level_count);
        wgpu_texview_desc.baseArrayLayer = cast(u32, view.cmn.img.slice);
        wgpu_texview_desc.arrayLayerCount = cast(u32, view.cmn.img.slice_count);
        if view.cmn.type == SG_VIEWTYPE_TEXTURE {
            wgpu_texview_desc.dimension = _sg_wgpu_texture_view_dimension(img.cmn.type);
        } else {
            wgpu_texview_desc.dimension = _sg_wgpu_attachment_view_dimension(img.cmn.type);
        }
        if view.cmn.type == SG_VIEWTYPE_DEPTHSTENCILATTACHMENT {
            wgpu_texview_desc.aspect = WGPUTextureAspect_All;
        } else if _sg_is_depth_or_depth_stencil_format(img.cmn.pixel_format) != 0 {
            wgpu_texview_desc.aspect = WGPUTextureAspect_DepthOnly;
        } else {
            wgpu_texview_desc.aspect = WGPUTextureAspect_All;
        }
        view.wgpu.view = wgpuTextureCreateView(img.wgpu.tex, &wgpu_texview_desc);
        if null == view.wgpu.view {
            _sg_log(SG_LOGITEM_WGPU_CREATE_TEXTURE_VIEW_FAILED, 1, null, 7222);
            return SG_RESOURCESTATE_FAILED;
        }
    }
    return SG_RESOURCESTATE_VALID;
}

void _sg_wgpu_discard_view(_sg_view_t* view) {
    assert(cast(i64, view));
    _sg_wgpu_bindgroups_cache_invalidate(_SG_WGPU_BINDGROUPSCACHEITEMTYPE_VIEW, &view.slot);
    if view.wgpu.view != null {
        wgpuTextureViewRelease(view.wgpu.view);
        view.wgpu.view = null;
    }
}

void _sg_wgpu_init_color_att(WGPURenderPassColorAttachment* wgpu_att, sg_color_attachment_action* action, WGPUTextureView color_view, WGPUTextureView resolve_view) {
    wgpu_att.depthSlice = UINT32_MAX;
    wgpu_att.view = color_view;
    wgpu_att.resolveTarget = resolve_view;
    wgpu_att.loadOp = _sg_wgpu_load_op(color_view, action.load_action);
    wgpu_att.storeOp = _sg_wgpu_store_op(color_view, action.store_action);
    wgpu_att.clearValue.r = action.clear_value.r;
    wgpu_att.clearValue.g = action.clear_value.g;
    wgpu_att.clearValue.b = action.clear_value.b;
    wgpu_att.clearValue.a = action.clear_value.a;
}

void _sg_wgpu_init_ds_att(WGPURenderPassDepthStencilAttachment* wgpu_att, sg_pass_action* action, sg_pixel_format fmt, WGPUTextureView view) {
    wgpu_att.view = view;
    wgpu_att.depthLoadOp = _sg_wgpu_load_op(view, action.depth.load_action);
    wgpu_att.depthStoreOp = _sg_wgpu_store_op(view, action.depth.store_action);
    wgpu_att.depthClearValue = action.depth.clear_value;
    wgpu_att.depthReadOnly = false;
    if _sg_is_depth_stencil_format(fmt) != 0 {
        wgpu_att.stencilLoadOp = _sg_wgpu_load_op(view, action.stencil.load_action);
        wgpu_att.stencilStoreOp = _sg_wgpu_store_op(view, action.stencil.store_action);
    } else {
        wgpu_att.stencilLoadOp = WGPULoadOp_Undefined;
        wgpu_att.stencilStoreOp = WGPUStoreOp_Undefined;
    }
    wgpu_att.stencilClearValue = action.stencil.clear_value;
    wgpu_att.stencilReadOnly = false;
}

void _sg_wgpu_begin_compute_pass(sg_pass* pass) {
    WGPUComputePassDescriptor wgpu_pass_desc;
    wgpu_pass_desc.label = _sg_wgpu_stringview(pass.label);
    _sg.wgpu.cpass_enc = wgpuCommandEncoderBeginComputePass(_sg.wgpu.cmd_enc, &wgpu_pass_desc);
    assert(cast(i64, _sg.wgpu.cpass_enc));
    wgpuComputePassEncoderSetBindGroup(_sg.wgpu.cpass_enc, 0, null, 0, null);
    wgpuComputePassEncoderSetBindGroup(_sg.wgpu.cpass_enc, 1, null, 0, null);
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.wgpu.bindings.num_set_bindgroup++;
        }
    }
}

void _sg_wgpu_begin_render_pass(sg_pass* pass, _sg_attachments_ptrs_t* atts) {
    sg_swapchain* swapchain = &pass.swapchain;
    sg_pass_action* action = &pass.action;
    WGPURenderPassDescriptor wgpu_pass_desc;
    WGPURenderPassColorAttachment[8] wgpu_color_att;
    WGPURenderPassDepthStencilAttachment wgpu_ds_att;
    wgpu_pass_desc.label = _sg_wgpu_stringview(pass.label);
    if atts.empty == 0 {
        assert(atts.num_color_views <= SG_MAX_COLOR_ATTACHMENTS);
        for i32 i = 0; i < atts.num_color_views; i++ {
            assert(cast(i64, atts.color_views[i]));
            WGPUTextureView wgpu_color_view = atts.color_views[i].wgpu.view;
            WGPUTextureView wgpu_resolve_view = null;
            if atts.resolve_views[i] != null {
                wgpu_resolve_view = atts.resolve_views[i].wgpu.view;
            }
            _sg_wgpu_init_color_att(&wgpu_color_att[i], &action.colors[i], wgpu_color_view, wgpu_resolve_view);
        }
        wgpu_pass_desc.colorAttachmentCount = cast(u64, atts.num_color_views);
        wgpu_pass_desc.colorAttachments = &wgpu_color_att[0];
        if atts.ds_view != null {
            _sg_image_t* img = _sg_image_ref_ptr(&atts.ds_view.cmn.img.ref);
            WGPUTextureView wgpu_ds_view = atts.ds_view.wgpu.view;
            assert(cast(i64, wgpu_ds_view));
            _sg_wgpu_init_ds_att(&wgpu_ds_att, action, img.cmn.pixel_format, wgpu_ds_view);
            wgpu_pass_desc.depthStencilAttachment = &wgpu_ds_att;
        }
    } else {
        var wgpu_color_view = cast(WGPUTextureView, swapchain.wgpu.render_view);
        var wgpu_resolve_view = cast(WGPUTextureView, swapchain.wgpu.resolve_view);
        var wgpu_depth_stencil_view = cast(WGPUTextureView, swapchain.wgpu.depth_stencil_view);
        _sg_wgpu_init_color_att(&wgpu_color_att[0], &action.colors[0], wgpu_color_view, wgpu_resolve_view);
        wgpu_pass_desc.colorAttachmentCount = 1;
        wgpu_pass_desc.colorAttachments = &wgpu_color_att[0];
        if wgpu_depth_stencil_view != null {
            assert(swapchain.depth_format > SG_PIXELFORMAT_NONE);
            _sg_wgpu_init_ds_att(&wgpu_ds_att, action, swapchain.depth_format, wgpu_depth_stencil_view);
            wgpu_pass_desc.depthStencilAttachment = &wgpu_ds_att;
        }
    }
    _sg.wgpu.rpass_enc = wgpuCommandEncoderBeginRenderPass(_sg.wgpu.cmd_enc, &wgpu_pass_desc);
    assert(cast(i64, _sg.wgpu.rpass_enc));
    wgpuRenderPassEncoderSetBindGroup(_sg.wgpu.rpass_enc, 0, null, 0, null);
    wgpuRenderPassEncoderSetBindGroup(_sg.wgpu.rpass_enc, 1, null, 0, null);
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.wgpu.bindings.num_set_bindgroup++;
        }
    }
}

void _sg_wgpu_begin_pass(sg_pass* pass, _sg_attachments_ptrs_t* atts) {
    assert(pass && atts);
    assert(cast(i64, _sg.wgpu.dev));
    assert(null == _sg.wgpu.rpass_enc);
    assert(null == _sg.wgpu.cpass_enc);
    if null == _sg.wgpu.cmd_enc {
        WGPUCommandEncoderDescriptor cmd_enc_desc;
        _sg.wgpu.cmd_enc = wgpuDeviceCreateCommandEncoder(_sg.wgpu.dev, &cmd_enc_desc);
        assert(cast(i64, _sg.wgpu.cmd_enc));
    }
    _sg_wgpu_bindings_cache_clear();
    if pass.compute != 0 {
        _sg_wgpu_begin_compute_pass(pass);
    } else {
        _sg_wgpu_begin_render_pass(pass, atts);
    }
}

void _sg_wgpu_end_pass(_sg_attachments_ptrs_t* atts) {
    ignore atts;
    if _sg.wgpu.rpass_enc != null {
        wgpuRenderPassEncoderEnd(_sg.wgpu.rpass_enc);
        wgpuRenderPassEncoderRelease(_sg.wgpu.rpass_enc);
        _sg.wgpu.rpass_enc = null;
    }
    if _sg.wgpu.cpass_enc != null {
        wgpuComputePassEncoderEnd(_sg.wgpu.cpass_enc);
        wgpuComputePassEncoderRelease(_sg.wgpu.cpass_enc);
        _sg.wgpu.cpass_enc = null;
    }
}

void _sg_wgpu_commit() {
    if _sg.wgpu.cmd_enc == null {
        return;
    }
    _sg_wgpu_uniform_system_on_commit();
    WGPUCommandBufferDescriptor cmd_buf_desc;
    WGPUCommandBuffer wgpu_cmd_buf = wgpuCommandEncoderFinish(_sg.wgpu.cmd_enc, &cmd_buf_desc);
    assert(cast(i64, wgpu_cmd_buf));
    wgpuCommandEncoderRelease(_sg.wgpu.cmd_enc);
    _sg.wgpu.cmd_enc = null;
    wgpuQueueSubmit(_sg.wgpu.queue, 1, &wgpu_cmd_buf);
    wgpuCommandBufferRelease(wgpu_cmd_buf);
}

void _sg_wgpu_apply_viewport(i32 x, i32 y, i32 w, i32 h, bool origin_top_left) {
    assert(cast(i64, _sg.wgpu.rpass_enc));
    var xf = cast(f32, x);
    var yf = cast(f32, origin_top_left != 0 ? y : _sg.cur_pass.dim.height - (y + h));
    var wf = cast(f32, w);
    var hf = cast(f32, h);
    wgpuRenderPassEncoderSetViewport(_sg.wgpu.rpass_enc, xf, yf, wf, hf, 0.0f, 1.0f);
}

void _sg_wgpu_apply_scissor_rect(i32 x, i32 y, i32 w, i32 h, bool origin_top_left) {
    assert(cast(i64, _sg.wgpu.rpass_enc));
    _sg_recti_t clip = _sg_clipi(x, y, w, h, _sg.cur_pass.dim.width, _sg.cur_pass.dim.height);
    var sx = cast(u32, clip.x);
    var sy = cast(u32, origin_top_left != 0 ? clip.y : _sg.cur_pass.dim.height - (clip.y + clip.h));
    var sw = cast(u32, clip.w);
    var sh = cast(u32, clip.h);
    wgpuRenderPassEncoderSetScissorRect(_sg.wgpu.rpass_enc, sx, sy, sw, sh);
}

void _sg_wgpu_apply_pipeline(_sg_pipeline_t* pip) {
    assert(cast(i64, pip));
    _sg_wgpu_uniform_system_on_apply_pipeline();
    if pip.cmn.is_compute != 0 {
        assert(cast(i64, _sg.cur_pass.is_compute));
        assert(cast(i64, pip.wgpu.cpip));
        assert(cast(i64, _sg.wgpu.cpass_enc));
        wgpuComputePassEncoderSetPipeline(_sg.wgpu.cpass_enc, pip.wgpu.cpip);
    } else {
        assert(cast(i64, !_sg.cur_pass.is_compute));
        assert(cast(i64, pip.wgpu.rpip));
        assert(cast(i64, _sg.wgpu.rpass_enc));
        wgpuRenderPassEncoderSetPipeline(_sg.wgpu.rpass_enc, pip.wgpu.rpip);
        wgpuRenderPassEncoderSetBlendConstant(_sg.wgpu.rpass_enc, &pip.wgpu.blend_color);
        wgpuRenderPassEncoderSetStencilReference(_sg.wgpu.rpass_enc, pip.cmn.stencil.ref);
    }
}

bool _sg_wgpu_apply_bindings(_sg_bindings_ptrs_t* bnd) {
    assert(cast(i64, bnd));
    bool retval = true;
    if _sg.cur_pass.is_compute == 0 {
        retval &= _sg_wgpu_apply_index_buffer(bnd);
        retval &= _sg_wgpu_apply_vertex_buffers(bnd);
    }
    retval &= _sg_wgpu_apply_bindings_bindgroup(bnd);
    return retval;
}

void _sg_wgpu_apply_uniforms(i32 ub_slot, sg_range* data) {
    u32 alignment = _sg.wgpu.limits.minUniformBufferOffsetAlignment;
    assert(cast(i64, _sg.wgpu.uniform.staging));
    assert(ub_slot >= 0 && ub_slot < SG_MAX_UNIFORMBLOCK_BINDSLOTS);
    assert(_sg.wgpu.uniform.offset + data.size <= _sg.wgpu.uniform.num_bytes);
    assert((_sg.wgpu.uniform.offset & alignment - 1) == 0);
    assert(data.size <= cast(u64, 1 << 16));
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.wgpu.uniforms.num_set_bindgroup++;
        }
    }
    memcpy(_sg.wgpu.uniform.staging + _sg.wgpu.uniform.offset, data.ptr, data.size);
    _sg.wgpu.uniform.bind_offsets[ub_slot] = _sg.wgpu.uniform.offset;
    _sg.wgpu.uniform.offset = _sg_roundup_pow2_u32(_sg.wgpu.uniform.offset + cast(u32, data.size), alignment);
    _sg.wgpu.uniform.dirty = true;
}

void _sg_wgpu_draw(i32 base_element, i32 num_elements, i32 num_instances, i32 base_vertex, i32 base_instance) {
    assert(cast(i64, _sg.wgpu.rpass_enc));
    if _sg.wgpu.uniform.dirty != 0 {
        _sg_wgpu_uniform_system_set_bindgroup();
    }
    if _sg.use_indexed_draw != 0 {
        wgpuRenderPassEncoderDrawIndexed(_sg.wgpu.rpass_enc, cast(u32, num_elements), cast(u32, num_instances), cast(u32, base_element), base_vertex, cast(u32, base_instance));
    } else {
        wgpuRenderPassEncoderDraw(_sg.wgpu.rpass_enc, cast(u32, num_elements), cast(u32, num_instances), cast(u32, base_element), cast(u32, base_instance));
    }
}

void _sg_wgpu_dispatch(i32 num_groups_x, i32 num_groups_y, i32 num_groups_z) {
    assert(cast(i64, _sg.wgpu.cpass_enc));
    if _sg.wgpu.uniform.dirty != 0 {
        _sg_wgpu_uniform_system_set_bindgroup();
    }
    wgpuComputePassEncoderDispatchWorkgroups(_sg.wgpu.cpass_enc, cast(u32, num_groups_x), cast(u32, num_groups_y), cast(u32, num_groups_z));
}

void _sg_wgpu_update_buffer(_sg_buffer_t* buf, sg_range* data) {
    assert(buf && data && data.ptr && data.size > 0);
    _sg_wgpu_copy_buffer_data(buf, 0, data);
}

void _sg_wgpu_append_buffer(_sg_buffer_t* buf, sg_range* data, bool new_frame) {
    assert(buf && data && data.ptr && data.size > 0);
    ignore new_frame;
    _sg_wgpu_copy_buffer_data(buf, cast(u64, buf.cmn.append_pos), data);
}

void _sg_wgpu_update_image(_sg_image_t* img, sg_image_data* data) {
    assert(img && data);
    _sg_wgpu_copy_image_data(img, data);
}

void _sg_wgpu_write_buffer_unsealed(_sg_buffer_t* buf, sg_write_buffer_desc* desc) {
    assert(buf && desc);
    assert(SG_RESOURCESTATE_UNSEALED == buf.slot.state);
    assert(cast(i64, buf.wgpu.mapped_ptr));
    assert(desc.src.data.ptr && desc.src.data.size > 0);
    assert(desc.dst.offset + desc.size <= cast(u64, buf.cmn.size));
    assert(desc.src.offset + desc.size <= desc.src.data.size);
    u8* dst_ptr = buf.wgpu.mapped_ptr + desc.dst.offset;
    u8* src_ptr = cast(u8*, desc.src.data.ptr) + desc.src.offset;
    memcpy(dst_ptr, src_ptr, desc.size);
}

void _sg_wgpu_write_image_unsealed(_sg_image_t* img, sg_write_image_desc* desc) {
    assert(img && desc);
    assert(SG_RESOURCESTATE_UNSEALED == img.slot.state);
    _sg_wgpu_write_miplevel_data(img, cast(u8*, desc.src.data.ptr), desc.src.data.size, desc.src.offset, desc.src.bytes_per_row, desc.src.bytes_per_slice, desc.dst.mip_level, desc.dst.x, desc.dst.y, desc.dst.slice, desc.size.width, desc.size.height, desc.size.num_slices);
}

