bool _sg_validate_shader_binding_limits(sg_shader_desc* desc) {
    assert(cast(i64, desc));
    i32 vs_num_tex = 0;
    i32 fs_num_tex = 0;
    i32 cs_num_tex = 0;
    i32 vs_num_sbuf = 0;
    i32 fs_num_sbuf = 0;
    i32 cs_num_sbuf = 0;
    i32 vs_num_simg = 0;
    i32 fs_num_simg = 0;
    i32 cs_num_simg = 0;
    i32 vs_num_texsmp = 0;
    i32 fs_num_texsmp = 0;
    i32 cs_num_texsmp = 0;
    for u64 i = 0; i < cast(u64, SG_MAX_VIEW_BINDSLOTS); i++ {
        switch desc.views[i].texture.stage {
            case SG_SHADERSTAGE_VERTEX: {
                vs_num_tex++;
            }
            case SG_SHADERSTAGE_FRAGMENT: {
                fs_num_tex++;
            }
            case SG_SHADERSTAGE_COMPUTE: {
                cs_num_tex++;
            }
            default: {
            }
        }
        switch desc.views[i].storage_buffer.stage {
            case SG_SHADERSTAGE_VERTEX: {
                vs_num_sbuf++;
            }
            case SG_SHADERSTAGE_FRAGMENT: {
                fs_num_sbuf++;
            }
            case SG_SHADERSTAGE_COMPUTE: {
                cs_num_sbuf++;
            }
            default: {
            }
        }
        switch desc.views[i].storage_image.stage {
            case SG_SHADERSTAGE_VERTEX: {
                vs_num_simg++;
            }
            case SG_SHADERSTAGE_FRAGMENT: {
                fs_num_simg++;
            }
            case SG_SHADERSTAGE_COMPUTE: {
                cs_num_simg++;
            }
            default: {
            }
        }
    }
    for u64 i = 0; i < cast(u64, SG_MAX_TEXTURE_SAMPLER_PAIRS); i++ {
        switch desc.texture_sampler_pairs[i].stage {
            case SG_SHADERSTAGE_VERTEX: {
                vs_num_texsmp++;
            }
            case SG_SHADERSTAGE_FRAGMENT: {
                fs_num_texsmp++;
            }
            case SG_SHADERSTAGE_COMPUTE: {
                cs_num_texsmp++;
            }
            default: {
            }
        }
    }
    i32 max_tex = _sg.limits.max_texture_bindings_per_stage;
    i32 max_sbuf = _sg.limits.max_storage_buffer_bindings_per_stage;
    i32 max_simg = _sg.limits.max_storage_image_bindings_per_stage;
    bool retval = true;
    if vs_num_tex > max_tex {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_VERTEXSTAGE_TEXTURES, 1, null, 7222);
        retval = false;
    }
    if fs_num_tex > max_tex {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_FRAGMENTSTAGE_TEXTURES, 1, null, 7222);
        retval = false;
    }
    if cs_num_tex > max_tex {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_COMPUTESTAGE_TEXTURES, 1, null, 7222);
        retval = false;
    }
    if vs_num_sbuf > max_sbuf {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_VERTEXSTAGE_STORAGEBUFFERS, 1, null, 7222);
        retval = false;
    }
    if fs_num_sbuf > max_sbuf {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_FRAGMENTSTAGE_STORAGEBUFFERS, 1, null, 7222);
        retval = false;
    }
    if cs_num_sbuf > max_sbuf {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_COMPUTESTAGE_STORAGEBUFFERS, 1, null, 7222);
        retval = false;
    }
    if vs_num_simg > max_simg {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_VERTEXSTAGE_STORAGEIMAGES, 1, null, 7222);
        retval = false;
    }
    if fs_num_simg > max_simg {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_FRAGMENTSTAGE_STORAGEIMAGES, 1, null, 7222);
        retval = false;
    }
    if cs_num_simg > max_simg {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_COMPUTESTAGE_STORAGEIMAGES, 1, null, 7222);
        retval = false;
    }
    if vs_num_texsmp > max_tex {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_VERTEXSTAGE_TEXTURESAMPLERPAIRS, 1, null, 7222);
        retval = false;
    }
    if fs_num_texsmp > max_tex {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_FRAGMENTSTAGE_TEXTURESAMPLERPAIRS, 1, null, 7222);
        retval = false;
    }
    if cs_num_texsmp > max_tex {
        _sg_log(SG_LOGITEM_SHADERDESC_TOO_MANY_COMPUTESTAGE_TEXTURESAMPLERPAIRS, 1, null, 7222);
        retval = false;
    }
    return retval;
}
bool _sg_validate_pass_attachment_limits(sg_pass* pass) {
    assert(cast(i64, pass));
    i32 num_color_atts = 0;
    i32 num_resolve_atts = 0;
    for i32 att_index = 0; att_index < SG_MAX_COLOR_ATTACHMENTS; att_index++ {
        if pass.attachments.colors[att_index].id != cast(u32, SG_INVALID_ID) {
            num_color_atts += 1;
        }
        if pass.attachments.resolves[att_index].id != cast(u32, SG_INVALID_ID) {
            num_resolve_atts += 1;
        }
    }
    bool retval = true;
    i32 max_color_atts = _sg.limits.max_color_attachments;
    if num_color_atts > max_color_atts {
        _sg_log(SG_LOGITEM_BEGINPASS_TOO_MANY_COLOR_ATTACHMENTS, 1, null, 7222);
        retval = false;
    }
    if num_resolve_atts > max_color_atts {
        _sg_log(SG_LOGITEM_BEGINPASS_TOO_MANY_RESOLVE_ATTACHMENTS, 1, null, 7222);
        retval = false;
    }
    return retval;
}
sg_buffer_usage _sg_buffer_usage_defaults(sg_buffer_usage* usg) {
    sg_buffer_usage def = *usg;
    if (def.vertex_buffer || def.index_buffer || def.storage_buffer) == 0 {
        def.vertex_buffer = true;
    }
    if (def.immutable || def.stream_update || def.dynamic_update) == 0 {
        def.immutable = true;
    }
    return def;
}
sg_buffer_desc _sg_buffer_desc_defaults(sg_buffer_desc* desc) {
    sg_buffer_desc def = *desc;
    def.usage = _sg_buffer_usage_defaults(&def.usage);
    if def.size == 0 {
        def.size = def.data.size;
    }
    return def;
}
sg_image_usage _sg_image_usage_defaults(sg_image_usage* usg) {
    sg_image_usage def = *usg;
    if (def.immutable || def.stream_update || def.dynamic_update) == 0 {
        def.immutable = true;
    }
    return def;
}
sg_image_desc _sg_image_desc_defaults(sg_image_desc* desc) {
    sg_image_desc def = *desc;
    def.type = def.type == 0 ? SG_IMAGETYPE_2D : def.type;
    def.usage = _sg_image_usage_defaults(&def.usage);
    def.num_slices = def.num_slices == 0 ? def.type == SG_IMAGETYPE_CUBE ? 6 : 1 : def.num_slices;
    def.num_mipmaps = def.num_mipmaps == 0 ? 1 : def.num_mipmaps;
    if def.usage.color_attachment || def.usage.resolve_attachment {
        def.pixel_format = def.pixel_format == 0 ? _sg.desc.environment.defaults.color_format : def.pixel_format;
        def.sample_count = def.sample_count == 0 ? _sg.desc.environment.defaults.sample_count : def.sample_count;
    } else if def.usage.depth_stencil_attachment != 0 {
        def.pixel_format = def.pixel_format == 0 ? _sg.desc.environment.defaults.depth_format : def.pixel_format;
        def.sample_count = def.sample_count == 0 ? _sg.desc.environment.defaults.sample_count : def.sample_count;
    } else {
        def.pixel_format = def.pixel_format == 0 ? SG_PIXELFORMAT_RGBA8 : def.pixel_format;
        def.sample_count = def.sample_count == 0 ? 1 : def.sample_count;
    }
    return def;
}
sg_sampler_desc _sg_sampler_desc_defaults(sg_sampler_desc* desc) {
    sg_sampler_desc def = *desc;
    def.min_filter = def.min_filter == 0 ? SG_FILTER_NEAREST : def.min_filter;
    def.mag_filter = def.mag_filter == 0 ? SG_FILTER_NEAREST : def.mag_filter;
    def.mipmap_filter = def.mipmap_filter == 0 ? SG_FILTER_NEAREST : def.mipmap_filter;
    def.wrap_u = def.wrap_u == 0 ? SG_WRAP_REPEAT : def.wrap_u;
    def.wrap_v = def.wrap_v == 0 ? SG_WRAP_REPEAT : def.wrap_v;
    def.wrap_w = def.wrap_w == 0 ? SG_WRAP_REPEAT : def.wrap_w;
    def.max_lod = def.max_lod == 0.0f ? FLT_MAX : def.max_lod;
    def.border_color = def.border_color == 0 ? SG_BORDERCOLOR_OPAQUE_BLACK : def.border_color;
    def.compare = def.compare == 0 ? SG_COMPAREFUNC_NEVER : def.compare;
    def.max_anisotropy = cast(u32, def.max_anisotropy == 0 ? 1 : def.max_anisotropy);
    return def;
}
sg_pipeline_desc _sg_pipeline_desc_defaults(sg_pipeline_desc* desc) {
    sg_pipeline_desc def = *desc;
    def.primitive_type = def.primitive_type == 0 ? SG_PRIMITIVETYPE_TRIANGLES : def.primitive_type;
    def.index_type = def.index_type == 0 ? SG_INDEXTYPE_NONE : def.index_type;
    def.cull_mode = def.cull_mode == 0 ? SG_CULLMODE_NONE : def.cull_mode;
    def.face_winding = def.face_winding == 0 ? SG_FACEWINDING_CW : def.face_winding;
    def.sample_count = def.sample_count == 0 ? _sg.desc.environment.defaults.sample_count : def.sample_count;
    def.stencil.front.compare = def.stencil.front.compare == 0 ? SG_COMPAREFUNC_ALWAYS : def.stencil.front.compare;
    def.stencil.front.fail_op = def.stencil.front.fail_op == 0 ? SG_STENCILOP_KEEP : def.stencil.front.fail_op;
    def.stencil.front.depth_fail_op = def.stencil.front.depth_fail_op == 0 ? SG_STENCILOP_KEEP : def.stencil.front.depth_fail_op;
    def.stencil.front.pass_op = def.stencil.front.pass_op == 0 ? SG_STENCILOP_KEEP : def.stencil.front.pass_op;
    def.stencil.back.compare = def.stencil.back.compare == 0 ? SG_COMPAREFUNC_ALWAYS : def.stencil.back.compare;
    def.stencil.back.fail_op = def.stencil.back.fail_op == 0 ? SG_STENCILOP_KEEP : def.stencil.back.fail_op;
    def.stencil.back.depth_fail_op = def.stencil.back.depth_fail_op == 0 ? SG_STENCILOP_KEEP : def.stencil.back.depth_fail_op;
    def.stencil.back.pass_op = def.stencil.back.pass_op == 0 ? SG_STENCILOP_KEEP : def.stencil.back.pass_op;
    def.depth.compare = def.depth.compare == 0 ? SG_COMPAREFUNC_ALWAYS : def.depth.compare;
    def.depth.pixel_format = def.depth.pixel_format == 0 ? _sg.desc.environment.defaults.depth_format : def.depth.pixel_format;
    if def.colors[0].pixel_format == SG_PIXELFORMAT_NONE {
        def.color_count = 0;
    } else {
        def.color_count = def.color_count == 0 ? 1 : def.color_count;
    }
    if def.color_count > SG_MAX_COLOR_ATTACHMENTS {
        def.color_count = SG_MAX_COLOR_ATTACHMENTS;
    }
    for i32 i = 0; i < def.color_count; i++ {
        sg_color_target_state* cs = &def.colors[i];
        cs.pixel_format = cs.pixel_format == 0 ? _sg.desc.environment.defaults.color_format : cs.pixel_format;
        cs.write_mask = cs.write_mask == 0 ? SG_COLORMASK_RGBA : cs.write_mask;
        sg_blend_state* bs = &def.colors[i].blend;
        bs.op_rgb = bs.op_rgb == 0 ? SG_BLENDOP_ADD : bs.op_rgb;
        bs.src_factor_rgb = bs.src_factor_rgb == 0 ? SG_BLENDFACTOR_ONE : bs.src_factor_rgb;
        if bs.op_rgb == SG_BLENDOP_MIN || bs.op_rgb == SG_BLENDOP_MAX {
            bs.dst_factor_rgb = bs.dst_factor_rgb == 0 ? SG_BLENDFACTOR_ONE : bs.dst_factor_rgb;
        } else {
            bs.dst_factor_rgb = bs.dst_factor_rgb == 0 ? SG_BLENDFACTOR_ZERO : bs.dst_factor_rgb;
        }
        bs.op_alpha = bs.op_alpha == 0 ? SG_BLENDOP_ADD : bs.op_alpha;
        bs.src_factor_alpha = bs.src_factor_alpha == 0 ? SG_BLENDFACTOR_ONE : bs.src_factor_alpha;
        if bs.op_alpha == SG_BLENDOP_MIN || bs.op_alpha == SG_BLENDOP_MAX {
            bs.dst_factor_alpha = bs.dst_factor_alpha == 0 ? SG_BLENDFACTOR_ONE : bs.dst_factor_alpha;
        } else {
            bs.dst_factor_alpha = bs.dst_factor_alpha == 0 ? SG_BLENDFACTOR_ZERO : bs.dst_factor_alpha;
        }
    }
    for i32 attr_index = 0; attr_index < SG_MAX_VERTEX_ATTRIBUTES; attr_index++ {
        sg_vertex_attr_state* a_state = &def.layout.attrs[attr_index];
        if a_state.format == SG_VERTEXFORMAT_INVALID {
            break;
        }
        assert(a_state.buffer_index >= 0 && a_state.buffer_index < SG_MAX_VERTEXBUFFER_BINDSLOTS);
        sg_vertex_buffer_layout_state* l_state = &def.layout.buffers[a_state.buffer_index];
        l_state.step_func = l_state.step_func == 0 ? SG_VERTEXSTEP_PER_VERTEX : l_state.step_func;
        l_state.step_rate = l_state.step_rate == 0 ? 1 : l_state.step_rate;
    }
    i32[8] auto_offset;
    bool[8] use_auto_offset;
    for i32 buf_index = 0; buf_index < SG_MAX_VERTEXBUFFER_BINDSLOTS; buf_index++ {
        use_auto_offset[buf_index] = true;
    }
    for i32 attr_index = 0; attr_index < SG_MAX_VERTEX_ATTRIBUTES; attr_index++ {
        sg_vertex_attr_state* a_state = &def.layout.attrs[attr_index];
        if a_state.format == SG_VERTEXFORMAT_INVALID {
            break;
        }
        if a_state.offset != 0 {
            assert(a_state.buffer_index >= 0 && a_state.buffer_index < SG_MAX_VERTEXBUFFER_BINDSLOTS);
            use_auto_offset[a_state.buffer_index] = false;
        }
    }
    for i32 attr_index = 0; attr_index < SG_MAX_VERTEX_ATTRIBUTES; attr_index++ {
        sg_vertex_attr_state* a_state = &def.layout.attrs[attr_index];
        if a_state.format == SG_VERTEXFORMAT_INVALID {
            break;
        }
        assert(a_state.buffer_index >= 0 && a_state.buffer_index < SG_MAX_VERTEXBUFFER_BINDSLOTS);
        if use_auto_offset[a_state.buffer_index] != 0 {
            a_state.offset = auto_offset[a_state.buffer_index];
        }
        auto_offset[a_state.buffer_index] += _sg_vertexformat_bytesize(a_state.format);
    }
    for i32 buf_index = 0; buf_index < SG_MAX_VERTEXBUFFER_BINDSLOTS; buf_index++ {
        sg_vertex_buffer_layout_state* l_state = &def.layout.buffers[buf_index];
        if l_state.stride == 0 {
            l_state.stride = auto_offset[buf_index];
        }
    }
    return def;
}
sg_view_desc _sg_view_desc_defaults(sg_view_desc* desc) {
    sg_view_desc def = *desc;
    return def;
