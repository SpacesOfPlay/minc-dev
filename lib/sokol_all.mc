        case SG_VERTEXFORMAT_USHORT2: {
            return 4;
        }
        case SG_VERTEXFORMAT_USHORT2N: {
            return 4;
        }
        case SG_VERTEXFORMAT_SHORT4: {
            return 8;
        }
        case SG_VERTEXFORMAT_SHORT4N: {
            return 8;
        }
        case SG_VERTEXFORMAT_USHORT4: {
            return 8;
        }
        case SG_VERTEXFORMAT_USHORT4N: {
