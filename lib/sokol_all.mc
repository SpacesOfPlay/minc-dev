    if _sapp.desc.composite_mode != SAPP_COMPOSITEMODE_OPAQUE {
        i32 opacity = 0;
        cast(fn(void*, void*, i32*, i32): void, objc.raw)(ctx, objc_selref("setValues:forParameter:"), &opacity, cast(i32, NSOpenGLContextParameterSurfaceOpacity));
    }
    objc.msg_id_v(ctx, objc_selref("makeCurrentContext"));
}

void _objc__sapp_macos_view_drawRect(void* self, void* _cmd, CGRect rect) {
    ignore rect;
    _sapp_macos_frame();
}





private {
void _sapp_gl_make_current() {
    objc.msg_id_v(objc.msg_id_v(_sapp.macos.view, objc_selref("openGLContext")), objc_selref("makeCurrentContext"));
}
}



















