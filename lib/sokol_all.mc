            return GL_FUNC_REVERSE_SUBTRACT;
        }
        case SG_BLENDOP_MIN: {
            return GL_MIN;
        }
        case SG_BLENDOP_MAX: {
            return GL_MAX;
        }
        default: {
            assert(cast(i64, false));
            return 0;
        }
