//
// >>windows
bool _sapp_win32_utf8_to_wide(u8* src, u16* dst, i32 dst_num_bytes) {
    assert(src && dst && dst_num_bytes > 1);
    _sapp_clear(dst, cast(u64, dst_num_bytes));
    i32 dst_chars = dst_num_bytes / cast(i32, sizeof(u16));
    i32 dst_needed = MultiByteToWideChar(CP_UTF8, 0, src, -1, null, 0);
    if dst_needed > 0 && dst_needed < dst_chars {
        MultiByteToWideChar(CP_UTF8, 0, src, -1, dst, dst_chars);
        return true;
    } else {
        return false;
    }
}


