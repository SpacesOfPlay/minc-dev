// ██       ██████  ██████  ███████ ██  ██████
//
// >>public
void sapp_run(sapp_desc* desc) {
    assert(cast(i64, desc));
    _sapp_macos_run(desc);
}






f64 sapp_frame_duration() {
    if _sapp.desc.disable_vsync != 0 {
        return _sapp.timing.dt;
    } else {
        return _sapp_macos_mtl_timing_frame_duration();
    }
}

















private {
}






















sapp_swapchain sapp_acquire_swapchain() {
    assert(cast(i64, _sapp.valid));
    sapp_swapchain res;
    if _sapp_macos_mtl_is_obscured() != 0 {
        res.invalid = true;
        return res;
    }
    res.metal.current_drawable = cast(void*, _sapp_mtl_swapchain_next());
    res.metal.depth_stencil_texture = cast(void*, _sapp.mtl.depth_tex);
    res.metal.msaa_color_texture = cast(void*, _sapp.mtl.msaa_tex);
    when defined(SOKOL_D3D11) {
        assert(cast(i64, _sapp.d3d11.rtv));
        if _sapp.desc.sample_count > 1 {
            assert(cast(i64, _sapp.d3d11.msaa_rtv));
            res.d3d11.render_view = cast(void*, _sapp.d3d11.msaa_rtv);
            res.d3d11.resolve_view = cast(void*, _sapp.d3d11.rtv);
        } else {
            res.d3d11.render_view = cast(void*, _sapp.d3d11.rtv);
        }
        res.d3d11.depth_stencil_view = cast(void*, _sapp.d3d11.dsv);
    }
    res.width = sapp_width();
    res.height = sapp_height();
    res.color_format = sapp_color_format();
    res.depth_format = sapp_depth_format();
    res.sample_count = sapp_sample_count();
    return res;
}













private {























































































































































MTLResourceOptions _sg_mtl_resource_options_storage_mode_managed_or_shared() {
    if _sg.mtl.use_shared_storage_mode != 0 {
        return MTLResourceStorageModeShared;
    } else {
        return MTLResourceStorageModeManaged;
    }
}





