sapp_desc _sapp_desc_defaults(sapp_desc* desc) {
    assert(desc && (desc.allocator.alloc_fn && desc.allocator.free_fn || !desc.allocator.alloc_fn && !desc.allocator.free_fn));
    sapp_desc res = *desc;
    res.depth_format = res.depth_format == 0 ? SAPP_PIXELFORMAT_DEPTH : res.depth_format;
    res.composite_mode = res.composite_mode == 0 ? SAPP_COMPOSITEMODE_OPAQUE : res.composite_mode;
    res.sample_count = res.sample_count == 0 ? 1 : res.sample_count;
    res.swap_interval = res.swap_interval == 0 ? 1 : res.swap_interval;
    if 0 == res.gl.major_version {
        when defined(SOKOL_GLCORE) {
            res.gl.major_version = 4;
            res.gl.minor_version = 3;
        } else when defined(SOKOL_GLES3) {
            res.gl.major_version = 3;
            res.gl.minor_version = 0;
        }
    }
    res.html5.canvas_selector = res.html5.canvas_selector == null ? "#canvas" : res.html5.canvas_selector;
    res.clipboard_size = res.clipboard_size == 0 ? 8192 : res.clipboard_size;
    res.max_dropped_files = res.max_dropped_files == 0 ? 1 : res.max_dropped_files;
    res.max_dropped_file_path_length = res.max_dropped_file_path_length == 0 ? 2048 : res.max_dropped_file_path_length;
    res.window_title = res.window_title == null ? "sokol" : res.window_title;
    return res;
}













}













sapp_pixel_format sapp_color_format() {
    switch _sapp.wgpu.swapchain_view_format {
        case WGPUTextureFormat_RGBA8Unorm: {
            return SAPP_PIXELFORMAT_RGBA8;
        }
        case WGPUTextureFormat_RGBA8UnormSrgb: {
            return SAPP_PIXELFORMAT_SRGB8A8;
        }
        case WGPUTextureFormat_BGRA8Unorm: {
            return SAPP_PIXELFORMAT_BGRA8;
        }
        case WGPUTextureFormat_BGRA8UnormSrgb: {
            return SAPP_PIXELFORMAT_SBGR8A8;
        }
        case WGPUTextureFormat_RGBA16Float: {
            return SAPP_PIXELFORMAT_RGBA16F;
        }
        default: {
            assert(cast(i64, false));
            return SAPP_PIXELFORMAT_NONE;
        }
    }
}











private {
}





















sapp_environment sapp_get_environment() {
    assert(cast(i64, _sapp.valid));
    sapp_environment res;
    res.defaults.color_format = sapp_color_format();
    res.defaults.depth_format = sapp_depth_format();
    res.defaults.sample_count = sapp_sample_count();
    when defined(SOKOL_D3D11) {
        res.d3d11.device = cast(void*, _sapp.d3d11.device);
        res.d3d11.device_context = cast(void*, _sapp.d3d11.device_context);
    }
    res.wgpu.device = cast(void*, _sapp.wgpu.device);
    when defined(SOKOL_VULKAN) {
        res.vulkan.instance = cast(void*, _sapp.vk.instance);
        res.vulkan.physical_device = cast(void*, _sapp.vk.physical_device);
        res.vulkan.device = cast(void*, _sapp.vk.device);
        res.vulkan.queue = cast(void*, _sapp.vk.queue);
        res.vulkan.queue_family_index = _sapp.vk.queue_family_index;
    }
    return res;
}

sapp_swapchain sapp_acquire_swapchain() {
    assert(cast(i64, _sapp.valid));
    sapp_swapchain res;
    when defined(SOKOL_D3D11) {
        assert(cast(i64, _sapp.d3d11.rtv));
        if _sapp.desc.sample_count > 1 {
            assert(cast(i64, _sapp.d3d11.msaa_rtv));
            res.d3d11.render_view = cast(void*, _sapp.d3d11.msaa_rtv);
            res.d3d11.resolve_view = cast(void*, _sapp.d3d11.rtv);
        } else {
            res.d3d11.render_view = cast(void*, _sapp.d3d11.rtv);
        }
        res.d3d11.depth_stencil_view = cast(void*, _sapp.d3d11.dsv);
    }
    assert(null == _sapp.wgpu.swapchain_view);
    if _sapp_wgpu_swapchain_next() == 0 {
        res.invalid = true;
        return res;
    }
    if _sapp.desc.sample_count > 1 {
        assert(cast(i64, _sapp.wgpu.msaa_view));
        res.wgpu.render_view = cast(void*, _sapp.wgpu.msaa_view);
        res.wgpu.resolve_view = cast(void*, _sapp.wgpu.swapchain_view);
    } else {
        res.wgpu.render_view = cast(void*, _sapp.wgpu.swapchain_view);
    }
    res.wgpu.depth_stencil_view = cast(void*, _sapp.wgpu.depth_stencil_view);
    res.width = sapp_width();
    res.height = sapp_height();
    res.color_format = sapp_color_format();
    res.depth_format = sapp_depth_format();
    res.sample_count = sapp_sample_count();
    return res;
}





i32 sapp_gl_get_major_version() {
    assert(cast(i64, _sapp.valid));
    return 0;
}

i32 sapp_gl_get_minor_version() {
    assert(cast(i64, _sapp.valid));
    return 0;
}

bool sapp_gl_is_gles() {
    when defined(SOKOL_GLES3) {
        return true;
    } else {
        return false;
    }
}





