    SG_PIXELFORMAT_BC2_RGBA = 47,
    SG_PIXELFORMAT_BC3_RGBA = 48,
    SG_PIXELFORMAT_BC3_SRGBA = 49,
    SG_PIXELFORMAT_BC4_R = 50,
    SG_PIXELFORMAT_BC4_RSN = 51,
