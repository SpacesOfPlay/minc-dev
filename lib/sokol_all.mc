void sapp_run(sapp_desc* desc) {
    assert(cast(i64, desc));
    _sapp_macos_run(desc);
}












sapp_pixel_format sapp_color_format() {
    if _sapp.desc.srgb != 0 {
        return SAPP_PIXELFORMAT_SRGB8A8;
    } else {
        return SAPP_PIXELFORMAT_RGBA8;
    }
}











