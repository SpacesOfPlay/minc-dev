private {








bool _sg_validate_shader_desc(sg_shader_desc* desc) {
    when !defined(SOKOL_DEBUG) {
        ignore desc;
        return true;
    } else {
        if _sg.desc.disable_validation != 0 {
            return true;
        }
        assert(cast(i64, desc));
        bool is_compute_shader = desc.compute_func.source != null || desc.compute_func.bytecode.ptr != null;
        _sg_validate_begin();
        if desc._start_canary == 0 == 0 {
            _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_CANARY;
            _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_CANARY, 1, null, 7226);
        }
        if desc._end_canary == 0 == 0 {
            _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_CANARY;
            _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_CANARY, 1, null, 7226);
        }
        if is_compute_shader != 0 {
            if null != desc.compute_func.source == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_COMPUTE_SOURCE;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_COMPUTE_SOURCE, 1, null, 7226);
            }
        } else {
            if null != desc.vertex_func.source == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_VERTEX_SOURCE;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_VERTEX_SOURCE, 1, null, 7226);
            }
            if null != desc.fragment_func.source == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_FRAGMENT_SOURCE;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_FRAGMENT_SOURCE, 1, null, 7226);
            }
        }
        if is_compute_shader != 0 {
            if (null == desc.vertex_func.source && null == desc.vertex_func.bytecode.ptr) == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_INVALID_SHADER_COMBO;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_INVALID_SHADER_COMBO, 1, null, 7226);
            }
            if (null == desc.fragment_func.source && null == desc.fragment_func.bytecode.ptr) == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_INVALID_SHADER_COMBO;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_INVALID_SHADER_COMBO, 1, null, 7226);
            }
        } else {
            if (null == desc.compute_func.source && null == desc.compute_func.bytecode.ptr) == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_INVALID_SHADER_COMBO;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_INVALID_SHADER_COMBO, 1, null, 7226);
            }
        }
        when defined(SOKOL_METAL) {
            if is_compute_shader != 0 {
                i32 x = desc.mtl_threads_per_threadgroup.x;
                i32 y = desc.mtl_threads_per_threadgroup.y;
                i32 z = desc.mtl_threads_per_threadgroup.z;
                if (x > 0 && y > 0 && z > 0) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_METAL_THREADS_PER_THREADGROUP_INITIALIZED;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_METAL_THREADS_PER_THREADGROUP_INITIALIZED, 1, null, 7226);
                }
                if (x * y * z & 31) == 0 == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_METAL_THREADS_PER_THREADGROUP_MULTIPLE_32;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_METAL_THREADS_PER_THREADGROUP_MULTIPLE_32, 1, null, 7226);
                }
            }
        }
        for u64 i = 0; i < cast(u64, SG_MAX_VERTEX_ATTRIBUTES); i++ {
            if desc.attrs[i].glsl_name != null {
                if strlen(desc.attrs[i].glsl_name) < cast(u64, _SG_STRING_SIZE) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_ATTR_STRING_TOO_LONG;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_ATTR_STRING_TOO_LONG, 1, null, 7226);
                }
            }
            if desc.attrs[i].hlsl_sem_name != null {
                if strlen(desc.attrs[i].hlsl_sem_name) < cast(u64, _SG_STRING_SIZE) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_ATTR_STRING_TOO_LONG;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_ATTR_STRING_TOO_LONG, 1, null, 7226);
                }
            }
        }
        if null != desc.vertex_func.bytecode.ptr {
            if desc.vertex_func.bytecode.size > 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_NO_BYTECODE_SIZE;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_NO_BYTECODE_SIZE, 1, null, 7226);
            }
        }
        if null != desc.fragment_func.bytecode.ptr {
            if desc.fragment_func.bytecode.size > 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_NO_BYTECODE_SIZE;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_NO_BYTECODE_SIZE, 1, null, 7226);
            }
        }
        if null != desc.compute_func.bytecode.ptr {
            if desc.compute_func.bytecode.size > 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_NO_BYTECODE_SIZE;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_NO_BYTECODE_SIZE, 1, null, 7226);
            }
        }
        _sg_u128_t glsl_sbuf_bnd_bits = _sg_u128();
        _sg_u128_t glsl_simg_bnd_bits = _sg_u128();
        for u64 ub_idx = 0; ub_idx < cast(u64, SG_MAX_UNIFORMBLOCK_BINDSLOTS); ub_idx++ {
            sg_shader_uniform_block* ub_desc = &desc.uniform_blocks[ub_idx];
            if ub_desc.stage == SG_SHADERSTAGE_NONE {
                continue;
            }
            if ub_desc.size > 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_SIZE_IS_ZERO;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_SIZE_IS_ZERO, 1, null, 7226);
            }
            when defined(SOKOL_METAL) {
                if _sg_validate_slot_bits(msl_buf_bits, ub_desc.stage, ub_desc.msl_buffer_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_METAL_BUFFER_SLOT_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_METAL_BUFFER_SLOT_COLLISION, 1, null, 7226);
                }
                msl_buf_bits = _sg_validate_set_slot_bit(msl_buf_bits, ub_desc.stage, ub_desc.msl_buffer_n);
            } else when defined(SOKOL_D3D11) {
                if _sg_validate_slot_bits(hlsl_buf_bits, ub_desc.stage, ub_desc.hlsl_register_b_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_HLSL_REGISTER_B_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_HLSL_REGISTER_B_COLLISION, 1, null, 7226);
                }
                hlsl_buf_bits = _sg_validate_set_slot_bit(hlsl_buf_bits, ub_desc.stage, ub_desc.hlsl_register_b_n);
            } else when defined(SOKOL_WGPU) {
                if _sg_validate_slot_bits(wgsl_group0_bits, SG_SHADERSTAGE_NONE, ub_desc.wgsl_group0_binding_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_WGSL_GROUP0_BINDING_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_WGSL_GROUP0_BINDING_COLLISION, 1, null, 7226);
                }
                wgsl_group0_bits = _sg_validate_set_slot_bit(wgsl_group0_bits, SG_SHADERSTAGE_NONE, ub_desc.wgsl_group0_binding_n);
            } else when defined(SOKOL_VULKAN) {
                if _sg_validate_slot_bits(spirv_set0_bits, SG_SHADERSTAGE_NONE, ub_desc.spirv_set0_binding_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_SPIRV_SET0_BINDING_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_SPIRV_SET0_BINDING_COLLISION, 1, null, 7226);
                }
                spirv_set0_bits = _sg_validate_set_slot_bit(spirv_set0_bits, SG_SHADERSTAGE_NONE, ub_desc.spirv_set0_binding_n);
            }
            bool uniforms_continuous = true;
            u32 uniform_offset = 0;
            i32 num_uniforms = 0;
            for u64 u_index = 0; u_index < cast(u64, SG_MAX_UNIFORMBLOCK_MEMBERS); u_index++ {
                sg_glsl_shader_uniform* u_desc = &ub_desc.glsl_uniforms[u_index];
                if u_desc.type != SG_UNIFORMTYPE_INVALID {
                    if uniforms_continuous == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_NO_CONT_MEMBERS;
                        _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_NO_CONT_MEMBERS, 1, null, 7226);
                    }
                    if u_desc.glsl_name == null {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_UNIFORM_GLSL_NAME;
                        _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_UNIFORM_GLSL_NAME, 1, null, 7226);
                    }
                    var array_count = cast(i32, u_desc.array_count);
                    if array_count > 0 == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_ARRAY_COUNT;
                        _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_ARRAY_COUNT, 1, null, 7226);
                    }
                    u32 u_align = _sg_uniform_alignment(u_desc.type, array_count, ub_desc.layout);
                    u32 u_size = _sg_uniform_size(u_desc.type, array_count, ub_desc.layout);
                    uniform_offset = _sg_align_u32(uniform_offset, u_align);
                    uniform_offset += u_size;
                    num_uniforms++;
                    if ub_desc.layout == SG_UNIFORMLAYOUT_STD140 {
                        if array_count > 1 {
                            if (u_desc.type == SG_UNIFORMTYPE_FLOAT4 || u_desc.type == SG_UNIFORMTYPE_INT4 || u_desc.type == SG_UNIFORMTYPE_MAT4) == 0 {
                                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_STD140_ARRAY_TYPE;
                                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_STD140_ARRAY_TYPE, 1, null, 7226);
                            }
                        }
                    }
                } else {
                    uniforms_continuous = false;
                }
            }
            if ub_desc.layout == SG_UNIFORMLAYOUT_STD140 {
                uniform_offset = _sg_align_u32(uniform_offset, 16);
            }
            if cast(u64, uniform_offset) == ub_desc.size == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_SIZE_MISMATCH;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_SIZE_MISMATCH, 1, null, 7226);
            }
            if num_uniforms > 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_NO_MEMBERS;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_UNIFORMBLOCK_NO_MEMBERS, 1, null, 7226);
            }
        }
        u32 texview_slot_mask = 0;
        for u64 view_idx = 0; view_idx < cast(u64, SG_MAX_VIEW_BINDSLOTS); view_idx++ {
            sg_shader_view* view_desc = &desc.views[view_idx];
            if view_desc.texture.stage != SG_SHADERSTAGE_NONE {
                sg_shader_texture_view* tex_desc = &view_desc.texture;
                texview_slot_mask |= cast(u32, 1 << view_idx);
                ignore tex_desc;
            } else if view_desc.storage_buffer.stage != SG_SHADERSTAGE_NONE {
                sg_shader_storage_buffer_view* sbuf_desc = &view_desc.storage_buffer;
                if _sg_validate_slot_bits(glsl_sbuf_bnd_bits, SG_SHADERSTAGE_NONE, sbuf_desc.glsl_binding_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_VIEW_STORAGEBUFFER_GLSL_BINDING_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_VIEW_STORAGEBUFFER_GLSL_BINDING_COLLISION, 1, null, 7226);
                }
                glsl_sbuf_bnd_bits = _sg_validate_set_slot_bit(glsl_sbuf_bnd_bits, SG_SHADERSTAGE_NONE, sbuf_desc.glsl_binding_n);
            } else if view_desc.storage_image.stage != SG_SHADERSTAGE_NONE {
                sg_shader_storage_image_view* simg_desc = &view_desc.storage_image;
                if simg_desc.stage == SG_SHADERSTAGE_COMPUTE == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_VIEW_STORAGEIMAGE_EXPECT_COMPUTE_STAGE;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_VIEW_STORAGEIMAGE_EXPECT_COMPUTE_STAGE, 1, null, 7226);
                }
                if _sg_validate_slot_bits(glsl_simg_bnd_bits, SG_SHADERSTAGE_NONE, simg_desc.glsl_binding_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_VIEW_STORAGEIMAGE_GLSL_BINDING_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_VIEW_STORAGEIMAGE_GLSL_BINDING_COLLISION, 1, null, 7226);
                }
                glsl_simg_bnd_bits = _sg_validate_set_slot_bit(glsl_simg_bnd_bits, SG_SHADERSTAGE_NONE, simg_desc.glsl_binding_n);
            }
        }
        u32 smp_slot_mask = 0;
        for u64 smp_idx = 0; smp_idx < cast(u64, SG_MAX_SAMPLER_BINDSLOTS); smp_idx++ {
            sg_shader_sampler* smp_desc = &desc.samplers[smp_idx];
            if smp_desc.stage == SG_SHADERSTAGE_NONE {
                continue;
            }
            smp_slot_mask |= cast(u32, 1 << smp_idx);
            when defined(SOKOL_METAL) {
                if _sg_validate_slot_bits(msl_smp_bits, smp_desc.stage, smp_desc.msl_sampler_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_METAL_SAMPLER_SLOT_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_METAL_SAMPLER_SLOT_COLLISION, 1, null, 7226);
                }
                msl_smp_bits = _sg_validate_set_slot_bit(msl_smp_bits, smp_desc.stage, smp_desc.msl_sampler_n);
            } else when defined(SOKOL_D3D11) {
                if _sg_validate_slot_bits(hlsl_smp_bits, smp_desc.stage, smp_desc.hlsl_register_s_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_HLSL_REGISTER_S_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_HLSL_REGISTER_S_COLLISION, 1, null, 7226);
                }
                hlsl_smp_bits = _sg_validate_set_slot_bit(hlsl_smp_bits, smp_desc.stage, smp_desc.hlsl_register_s_n);
            } else when defined(SOKOL_WGPU) {
                if _sg_validate_slot_bits(wgsl_group1_bits, SG_SHADERSTAGE_NONE, smp_desc.wgsl_group1_binding_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_WGSL_GROUP1_BINDING_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_WGSL_GROUP1_BINDING_COLLISION, 1, null, 7226);
                }
                wgsl_group1_bits = _sg_validate_set_slot_bit(wgsl_group1_bits, SG_SHADERSTAGE_NONE, smp_desc.wgsl_group1_binding_n);
            } else when defined(SOKOL_VULKAN) {
                if _sg_validate_slot_bits(spirv_set1_bits, SG_SHADERSTAGE_NONE, smp_desc.spirv_set1_binding_n) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_SPIRV_SET1_BINDING_COLLISION;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_SPIRV_SET1_BINDING_COLLISION, 1, null, 7226);
                }
                spirv_set1_bits = _sg_validate_set_slot_bit(spirv_set1_bits, SG_SHADERSTAGE_NONE, smp_desc.spirv_set1_binding_n);
            }
        }
        u32 ref_texview_slot_mask = 0;
        u32 ref_smp_slot_mask = 0;
        for u64 tex_smp_idx = 0; tex_smp_idx < cast(u64, SG_MAX_TEXTURE_SAMPLER_PAIRS); tex_smp_idx++ {
            sg_shader_texture_sampler_pair* tex_smp_desc = &desc.texture_sampler_pairs[tex_smp_idx];
            if tex_smp_desc.stage == SG_SHADERSTAGE_NONE {
                continue;
            }
            if tex_smp_desc.glsl_name != null == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_GLSL_NAME;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_GLSL_NAME, 1, null, 7226);
            }
            bool view_slot_in_range = cast(i32, tex_smp_desc.view_slot) < SG_MAX_VIEW_BINDSLOTS;
            bool smp_slot_in_range = cast(i32, tex_smp_desc.sampler_slot) < SG_MAX_SAMPLER_BINDSLOTS;
            if view_slot_in_range == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_VIEW_SLOT_OUT_OF_RANGE;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_VIEW_SLOT_OUT_OF_RANGE, 1, null, 7226);
            }
            if smp_slot_in_range == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_SAMPLER_SLOT_OUT_OF_RANGE;
                _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_SAMPLER_SLOT_OUT_OF_RANGE, 1, null, 7226);
            }
            if view_slot_in_range && smp_slot_in_range {
                ref_texview_slot_mask |= cast(u32, 1 << cast(i32, tex_smp_desc.view_slot));
                ref_smp_slot_mask |= cast(u32, 1 << cast(i32, tex_smp_desc.sampler_slot));
                sg_shader_view* view_desc = &desc.views[tex_smp_desc.view_slot];
                sg_shader_sampler* smp_desc = &desc.samplers[tex_smp_desc.sampler_slot];
                if view_desc.texture.stage != SG_SHADERSTAGE_NONE == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_EXPECT_TEXTURE_VIEW;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_EXPECT_TEXTURE_VIEW, 1, null, 7226);
                }
                if view_desc.texture.stage == tex_smp_desc.stage == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_TEXTURE_STAGE_MISMATCH;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_TEXTURE_STAGE_MISMATCH, 1, null, 7226);
                }
                if smp_desc.stage == tex_smp_desc.stage == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_SAMPLER_STAGE_MISMATCH;
                    _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_TEXTURE_SAMPLER_PAIR_SAMPLER_STAGE_MISMATCH, 1, null, 7226);
                }
                bool needs_nonfiltering = view_desc.texture.sample_type == SG_IMAGESAMPLETYPE_UINT || view_desc.texture.sample_type == SG_IMAGESAMPLETYPE_SINT || view_desc.texture.sample_type == SG_IMAGESAMPLETYPE_UNFILTERABLE_FLOAT;
                bool needs_comparison = view_desc.texture.sample_type == SG_IMAGESAMPLETYPE_DEPTH;
                if needs_nonfiltering != 0 {
                    if (needs_nonfiltering && smp_desc.sampler_type == SG_SAMPLERTYPE_NONFILTERING) == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_NONFILTERING_SAMPLER_REQUIRED;
                        _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_NONFILTERING_SAMPLER_REQUIRED, 1, null, 7226);
                    }
                }
                if needs_comparison != 0 {
                    if (needs_comparison && smp_desc.sampler_type == SG_SAMPLERTYPE_COMPARISON) == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_COMPARISON_SAMPLER_REQUIRED;
                        _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_COMPARISON_SAMPLER_REQUIRED, 1, null, 7226);
                    }
                }
            }
        }
        if texview_slot_mask == ref_texview_slot_mask == 0 {
            _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_TEXVIEW_NOT_REFERENCED_BY_TEXTURE_SAMPLER_PAIRS;
            _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_TEXVIEW_NOT_REFERENCED_BY_TEXTURE_SAMPLER_PAIRS, 1, null, 7226);
        }
        if smp_slot_mask == ref_smp_slot_mask == 0 {
            _sg.validate_error = SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_NOT_REFERENCED_BY_TEXTURE_SAMPLER_PAIRS;
            _sg_log(SG_LOGITEM_VALIDATE_SHADERDESC_SAMPLER_NOT_REFERENCED_BY_TEXTURE_SAMPLER_PAIRS, 1, null, 7226);
        }
        return _sg_validate_end();
    }
}



bool _sg_validate_begin_pass(sg_pass* pass) {
    when !defined(SOKOL_DEBUG) {
        ignore pass;
        return true;
    } else {
        if _sg.desc.disable_validation != 0 {
            return true;
        }
        bool is_invalid_swapchain_pass = pass.swapchain.invalid;
        bool is_compute_pass = pass.compute;
        bool is_swapchain_pass = !is_compute_pass && _sg_attachments_empty(&pass.attachments);
        bool is_offscreen_pass = !(is_compute_pass || is_swapchain_pass);
        _sg_validate_begin();
        if pass._start_canary == 0 == 0 {
            _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_CANARY;
            _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_CANARY, 1, null, 7226);
        }
        if pass._end_canary == 0 == 0 {
            _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_CANARY;
            _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_CANARY, 1, null, 7226);
        }
        if is_compute_pass != 0 {
            if _sg_attachments_empty(&pass.attachments) == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COMPUTEPASS_EXPECT_NO_ATTACHMENTS;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COMPUTEPASS_EXPECT_NO_ATTACHMENTS, 1, null, 7226);
            }
        } else if is_invalid_swapchain_pass != 0 {
        } else if is_swapchain_pass != 0 {
            if pass.swapchain.width > 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_WIDTH;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_WIDTH, 1, null, 7226);
            }
            if pass.swapchain.height > 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_HEIGHT;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_HEIGHT, 1, null, 7226);
            }
            if pass.swapchain.sample_count > 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_SAMPLECOUNT;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_SAMPLECOUNT, 1, null, 7226);
            }
            if pass.swapchain.color_format > SG_PIXELFORMAT_NONE == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_COLORFORMAT;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_COLORFORMAT, 1, null, 7226);
            }
            when defined(SOKOL_METAL) {
                if pass.swapchain.metal.current_drawable != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_CURRENTDRAWABLE;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_CURRENTDRAWABLE, 1, null, 7226);
                }
                if pass.swapchain.depth_format == SG_PIXELFORMAT_NONE {
                    if pass.swapchain.metal.depth_stencil_texture == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_DEPTHSTENCILTEXTURE_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_DEPTHSTENCILTEXTURE_NOTSET, 1, null, 7226);
                    }
                } else {
                    if pass.swapchain.metal.depth_stencil_texture != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_DEPTHSTENCILTEXTURE;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_DEPTHSTENCILTEXTURE, 1, null, 7226);
                    }
                }
                if pass.swapchain.sample_count > 1 {
                    if pass.swapchain.metal.msaa_color_texture != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_MSAACOLORTEXTURE;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_MSAACOLORTEXTURE, 1, null, 7226);
                    }
                } else {
                    if pass.swapchain.metal.msaa_color_texture == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_MSAACOLORTEXTURE_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_METAL_EXPECT_MSAACOLORTEXTURE_NOTSET, 1, null, 7226);
                    }
                }
            } else when defined(SOKOL_D3D11) {
                if pass.swapchain.d3d11.render_view != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_RENDERVIEW;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_RENDERVIEW, 1, null, 7226);
                }
                if pass.swapchain.depth_format == SG_PIXELFORMAT_NONE {
                    if pass.swapchain.d3d11.depth_stencil_view == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_DEPTHSTENCILVIEW_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_DEPTHSTENCILVIEW_NOTSET, 1, null, 7226);
                    }
                } else {
                    if pass.swapchain.d3d11.depth_stencil_view != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_DEPTHSTENCILVIEW;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_DEPTHSTENCILVIEW, 1, null, 7226);
                    }
                }
                if pass.swapchain.sample_count > 1 {
                    if pass.swapchain.d3d11.resolve_view != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_RESOLVEVIEW;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_RESOLVEVIEW, 1, null, 7226);
                    }
                } else {
                    if pass.swapchain.d3d11.resolve_view == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_RESOLVEVIEW_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_D3D11_EXPECT_RESOLVEVIEW_NOTSET, 1, null, 7226);
                    }
                }
            } else when defined(SOKOL_WGPU) {
                if pass.swapchain.wgpu.render_view != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_RENDERVIEW;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_RENDERVIEW, 1, null, 7226);
                }
                if pass.swapchain.depth_format == SG_PIXELFORMAT_NONE {
                    if pass.swapchain.wgpu.depth_stencil_view == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_DEPTHSTENCILVIEW_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_DEPTHSTENCILVIEW_NOTSET, 1, null, 7226);
                    }
                } else {
                    if pass.swapchain.wgpu.depth_stencil_view != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_DEPTHSTENCILVIEW;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_DEPTHSTENCILVIEW, 1, null, 7226);
                    }
                }
                if pass.swapchain.sample_count > 1 {
                    if pass.swapchain.wgpu.resolve_view != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_RESOLVEVIEW;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_RESOLVEVIEW, 1, null, 7226);
                    }
                } else {
                    if pass.swapchain.wgpu.resolve_view == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_RESOLVEVIEW_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_WGPU_EXPECT_RESOLVEVIEW_NOTSET, 1, null, 7226);
                    }
                }
            } else when defined(SOKOL_VULKAN) {
                if pass.swapchain.vulkan.render_image != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RENDERIMAGE;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RENDERIMAGE, 1, null, 7226);
                }
                if pass.swapchain.vulkan.render_view != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RENDERVIEW;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RENDERVIEW, 1, null, 7226);
                }
                if pass.swapchain.depth_format == SG_PIXELFORMAT_NONE {
                    if pass.swapchain.vulkan.depth_stencil_image == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_DEPTHSTENCILIMAGE_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_DEPTHSTENCILIMAGE_NOTSET, 1, null, 7226);
                    }
                    if pass.swapchain.vulkan.depth_stencil_view == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_DEPTHSTENCILVIEW_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_DEPTHSTENCILVIEW_NOTSET, 1, null, 7226);
                    }
                } else {
                    if pass.swapchain.vulkan.depth_stencil_image != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_DEPTHSTENCILIMAGE;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_DEPTHSTENCILIMAGE, 1, null, 7226);
                    }
                    if pass.swapchain.vulkan.depth_stencil_view != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_DEPTHSTENCILVIEW;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_DEPTHSTENCILVIEW, 1, null, 7226);
                    }
                }
                if pass.swapchain.sample_count > 1 {
                    if pass.swapchain.vulkan.resolve_image != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RESOLVEIMAGE;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RESOLVEIMAGE, 1, null, 7226);
                    }
                    if pass.swapchain.vulkan.resolve_view != null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RESOLVEVIEW;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RESOLVEVIEW, 1, null, 7226);
                    }
                } else {
                    if pass.swapchain.vulkan.resolve_image == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RESOLVEIMAGE_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RESOLVEIMAGE_NOTSET, 1, null, 7226);
                    }
                    if pass.swapchain.vulkan.resolve_view == null == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RESOLVEVIEW_NOTSET;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RESOLVEVIEW_NOTSET, 1, null, 7226);
                    }
                }
                if pass.swapchain.vulkan.render_finished_semaphore != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RENDERFINISHEDSEMAPHORE;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_RENDERFINISHEDSEMAPHORE, 1, null, 7226);
                }
                if pass.swapchain.vulkan.present_complete_semaphore != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_PRESENTCOMPLETESEMAPHORE;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_VULKAN_EXPECT_PRESENTCOMPLETESEMAPHORE, 1, null, 7226);
                }
            }
        } else {
            bool has_color_atts = false;
            bool has_depth_stencil_atts = false;
            bool atts_cont = true;
            i32 color_width = -1;
            i32 color_height = -1;
            i32 color_sample_count = -1;
            for i32 att_index = 0; att_index < SG_MAX_COLOR_ATTACHMENTS; att_index++ {
                if pass.attachments.colors[att_index].id == cast(u32, SG_INVALID_ID) {
                    atts_cont = false;
                    continue;
                }
                has_color_atts = true;
                if atts_cont == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEWS_CONTINUOUS;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEWS_CONTINUOUS, 1, null, 7226);
                }
                _sg_view_t* view = _sg_lookup_view(pass.attachments.colors[att_index].id);
                if view != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_ALIVE;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_ALIVE, 1, null, 7226);
                }
                if view != null {
                    if view.slot.state == SG_RESOURCESTATE_VALID == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_VALID;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_VALID, 1, null, 7226);
                    }
                    if view.slot.state == SG_RESOURCESTATE_VALID {
                        if view.cmn.type == SG_VIEWTYPE_COLORATTACHMENT == 0 {
                            _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_TYPE;
                            _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_TYPE, 1, null, 7226);
                        }
                        _sg_image_t* img = _sg_image_ref_ptr_or_null(&view.cmn.img.ref);
                        if img == null {
                            _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_IMAGE_ALIVE;
                            _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_IMAGE_ALIVE, 1, null, 7226);
                        }
                        if img != null {
                            if img.slot.state == SG_RESOURCESTATE_VALID == 0 {
                                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_IMAGE_VALID;
                                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_IMAGE_VALID, 1, null, 7226);
                            }
                            if img.slot.state == SG_RESOURCESTATE_VALID {
                                if color_width == -1 {
                                    color_width = _sg_image_view_dim(view).width;
                                    color_height = _sg_image_view_dim(view).height;
                                    color_sample_count = img.cmn.sample_count;
                                } else {
                                    if color_width == _sg_image_view_dim(view).width == 0 {
                                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_SIZES;
                                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_SIZES, 1, null, 7226);
                                    }
                                    if color_height == _sg_image_view_dim(view).height == 0 {
                                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_SIZES;
                                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_SIZES, 1, null, 7226);
                                    }
                                    if color_sample_count == img.cmn.sample_count == 0 {
                                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_SAMPLECOUNTS_EQUAL;
                                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_SAMPLECOUNTS_EQUAL, 1, null, 7226);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            for i32 att_index = 0; att_index < SG_MAX_COLOR_ATTACHMENTS; att_index++ {
                if pass.attachments.resolves[att_index].id == cast(u32, SG_INVALID_ID) {
                    continue;
                }
                if pass.attachments.colors[att_index].id != cast(u32, SG_INVALID_ID) == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_NO_COLORATTACHMENTVIEW;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_NO_COLORATTACHMENTVIEW, 1, null, 7226);
                }
                _sg_view_t* view = _sg_lookup_view(pass.attachments.resolves[att_index].id);
                if view != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_ALIVE;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_ALIVE, 1, null, 7226);
                }
                if view != null {
                    if view.slot.state == SG_RESOURCESTATE_VALID == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_VALID;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_VALID, 1, null, 7226);
                    }
                    if view.slot.state == SG_RESOURCESTATE_VALID {
                        if view.cmn.type == SG_VIEWTYPE_RESOLVEATTACHMENT == 0 {
                            _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_TYPE;
                            _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_TYPE, 1, null, 7226);
                        }
                        _sg_image_t* img = _sg_image_ref_ptr_or_null(&view.cmn.img.ref);
                        if img == null {
                            _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_IMAGE_ALIVE;
                            _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_IMAGE_ALIVE, 1, null, 7226);
                        }
                        if img != null {
                            if img.slot.state == SG_RESOURCESTATE_VALID == 0 {
                                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_IMAGE_VALID;
                                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_IMAGE_VALID, 1, null, 7226);
                            }
                            if img.slot.state == SG_RESOURCESTATE_VALID {
                                if color_width != -1 {
                                    if color_sample_count > 1 == 0 {
                                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_SAMPLECOUNT;
                                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_COLORATTACHMENTVIEW_SAMPLECOUNT, 1, null, 7226);
                                    }
                                    if color_width == _sg_image_view_dim(view).width == 0 {
                                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_SIZES;
                                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_SIZES, 1, null, 7226);
                                    }
                                    if color_height == _sg_image_view_dim(view).height == 0 {
                                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_SIZES;
                                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_RESOLVEATTACHMENTVIEW_SIZES, 1, null, 7226);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if pass.attachments.depth_stencil.id != cast(u32, SG_INVALID_ID) {
                has_depth_stencil_atts = true;
                _sg_view_t* view = _sg_lookup_view(pass.attachments.depth_stencil.id);
                if view != null == 0 {
                    _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_ALIVE;
                    _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_ALIVE, 1, null, 7226);
                }
                if view != null {
                    if view.slot.state == SG_RESOURCESTATE_VALID == 0 {
                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_VALID;
                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_VALID, 1, null, 7226);
                    }
                    if view.slot.state == SG_RESOURCESTATE_VALID {
                        if view.cmn.type == SG_VIEWTYPE_DEPTHSTENCILATTACHMENT == 0 {
                            _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_TYPE;
                            _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_TYPE, 1, null, 7226);
                        }
                        _sg_image_t* img = _sg_image_ref_ptr_or_null(&view.cmn.img.ref);
                        if img == null {
                            _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_IMAGE_ALIVE;
                            _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_IMAGE_ALIVE, 1, null, 7226);
                        }
                        if img != null {
                            if img.slot.state == SG_RESOURCESTATE_VALID == 0 {
                                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_IMAGE_VALID;
                                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_IMAGE_VALID, 1, null, 7226);
                            }
                            if img.slot.state == SG_RESOURCESTATE_VALID {
                                if color_width != -1 {
                                    if color_width == _sg_image_view_dim(view).width == 0 {
                                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_SIZES;
                                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_SIZES, 1, null, 7226);
                                    }
                                    if color_height == _sg_image_view_dim(view).height == 0 {
                                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_SIZES;
                                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_SIZES, 1, null, 7226);
                                    }
                                    if color_sample_count == img.cmn.sample_count == 0 {
                                        _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_SAMPLECOUNT;
                                        _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_DEPTHSTENCILATTACHMENTVIEW_SAMPLECOUNT, 1, null, 7226);
                                    }
                                }
                            }
                        }
                    }
                }
            }
            if (has_color_atts || has_depth_stencil_atts) == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_ATTACHMENTS_EXPECTED;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_ATTACHMENTS_EXPECTED, 1, null, 7226);
            }
        }
        if is_compute_pass || is_offscreen_pass || is_invalid_swapchain_pass {
            if pass.swapchain.width == 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_WIDTH_NOTSET;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_WIDTH_NOTSET, 1, null, 7226);
            }
            if pass.swapchain.height == 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_HEIGHT_NOTSET;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_HEIGHT_NOTSET, 1, null, 7226);
            }
            if pass.swapchain.sample_count == 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_SAMPLECOUNT_NOTSET;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_SAMPLECOUNT_NOTSET, 1, null, 7226);
            }
            if pass.swapchain.color_format == _SG_PIXELFORMAT_DEFAULT == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_COLORFORMAT_NOTSET;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_COLORFORMAT_NOTSET, 1, null, 7226);
            }
            if pass.swapchain.depth_format == _SG_PIXELFORMAT_DEFAULT == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_DEPTHFORMAT_NOTSET;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_EXPECT_DEPTHFORMAT_NOTSET, 1, null, 7226);
            }
            if pass.swapchain.gl.framebuffer == 0 == 0 {
                _sg.validate_error = SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_GL_EXPECT_FRAMEBUFFER_NOTSET;
                _sg_log(SG_LOGITEM_VALIDATE_BEGINPASS_SWAPCHAIN_GL_EXPECT_FRAMEBUFFER_NOTSET, 1, null, 7226);
            }
        }
        return _sg_validate_end();
    }
}























































sg_desc _sg_desc_defaults(sg_desc* desc) {
    sg_desc res = *desc;
    when defined(SOKOL_WGPU) {
        assert(SG_PIXELFORMAT_NONE < res.environment.defaults.color_format);
    } else when defined(SOKOL_METAL) || defined(SOKOL_D3D11) {
        res.environment.defaults.color_format = res.environment.defaults.color_format == 0 ? SG_PIXELFORMAT_BGRA8 : res.environment.defaults.color_format;
    } else {
        res.environment.defaults.color_format = res.environment.defaults.color_format == 0 ? SG_PIXELFORMAT_RGBA8 : res.environment.defaults.color_format;
    }
    res.environment.defaults.depth_format = res.environment.defaults.depth_format == 0 ? SG_PIXELFORMAT_DEPTH_STENCIL : res.environment.defaults.depth_format;
    res.environment.defaults.sample_count = res.environment.defaults.sample_count == 0 ? 1 : res.environment.defaults.sample_count;
    res.buffer_pool_size = res.buffer_pool_size == 0 ? _SG_DEFAULT_BUFFER_POOL_SIZE : res.buffer_pool_size;
    res.image_pool_size = res.image_pool_size == 0 ? _SG_DEFAULT_IMAGE_POOL_SIZE : res.image_pool_size;
    res.sampler_pool_size = res.sampler_pool_size == 0 ? _SG_DEFAULT_SAMPLER_POOL_SIZE : res.sampler_pool_size;
    res.shader_pool_size = res.shader_pool_size == 0 ? _SG_DEFAULT_SHADER_POOL_SIZE : res.shader_pool_size;
    res.pipeline_pool_size = res.pipeline_pool_size == 0 ? _SG_DEFAULT_PIPELINE_POOL_SIZE : res.pipeline_pool_size;
    res.view_pool_size = res.view_pool_size == 0 ? _SG_DEFAULT_VIEW_POOL_SIZE : res.view_pool_size;
    res.uniform_buffer_size = res.uniform_buffer_size == 0 ? _SG_DEFAULT_UB_SIZE : res.uniform_buffer_size;
    res.max_commit_listeners = res.max_commit_listeners == 0 ? _SG_DEFAULT_MAX_COMMIT_LISTENERS : res.max_commit_listeners;
    res.wgpu.bindgroups_cache_size = res.wgpu.bindgroups_cache_size == 0 ? _SG_DEFAULT_WGPU_BINDGROUP_CACHE_SIZE : res.wgpu.bindgroups_cache_size;
    res.vulkan.copy_staging_buffer_size = res.vulkan.copy_staging_buffer_size == 0 ? _SG_DEFAULT_VK_COPY_STAGING_SIZE : res.vulkan.copy_staging_buffer_size;
    res.vulkan.stream_staging_buffer_size = res.vulkan.stream_staging_buffer_size == 0 ? _SG_DEFAULT_VK_STREAM_STAGING_SIZE : res.vulkan.stream_staging_buffer_size;
    res.vulkan.descriptor_buffer_size = res.vulkan.descriptor_buffer_size == 0 ? _SG_DEFAULT_VK_DESCRIPTOR_BUFFER_SIZE : res.vulkan.descriptor_buffer_size;
    return res;
}





}





































































private {
}







































































void* sg_wgpu_device() {
    when defined(SOKOL_WGPU) {
        return cast(void*, _sg.wgpu.dev);
    } else {
        return null;
    }
}

void* sg_wgpu_queue() {
    when defined(SOKOL_WGPU) {
        return cast(void*, _sg.wgpu.queue);
    } else {
        return null;
    }
}

void* sg_wgpu_command_encoder() {
    when defined(SOKOL_WGPU) {
        return cast(void*, _sg.wgpu.cmd_enc);
    } else {
        return null;
    }
}

void* sg_wgpu_render_pass_encoder() {
    when defined(SOKOL_WGPU) {
        return cast(void*, _sg.wgpu.rpass_enc);
    } else {
        return null;
    }
}

void* sg_wgpu_compute_pass_encoder() {
    when defined(SOKOL_WGPU) {
        return cast(void*, _sg.wgpu.cpass_enc);
    } else {
        return null;
    }
}

sg_wgpu_buffer_info sg_wgpu_query_buffer_info(sg_buffer buf_id) {
    assert(cast(i64, _sg.valid));
    sg_wgpu_buffer_info res;
    when defined(SOKOL_WGPU) {
        _sg_buffer_t* buf = _sg_lookup_buffer(buf_id.id);
        if buf != null {
            res.buf = cast(void*, buf.wgpu.buf);
        }
    } else {
        ignore buf_id;
    }
    return res;
}

sg_wgpu_image_info sg_wgpu_query_image_info(sg_image img_id) {
    assert(cast(i64, _sg.valid));
    sg_wgpu_image_info res;
    when defined(SOKOL_WGPU) {
        _sg_image_t* img = _sg_lookup_image(img_id.id);
        if img != null {
            res.tex = cast(void*, img.wgpu.tex);
        }
    } else {
        ignore img_id;
    }
    return res;
}

sg_wgpu_sampler_info sg_wgpu_query_sampler_info(sg_sampler smp_id) {
    assert(cast(i64, _sg.valid));
    sg_wgpu_sampler_info res;
    when defined(SOKOL_WGPU) {
        _sg_sampler_t* smp = _sg_lookup_sampler(smp_id.id);
        if smp != null {
            res.smp = cast(void*, smp.wgpu.smp);
        }
    } else {
        ignore smp_id;
    }
    return res;
}

sg_wgpu_shader_info sg_wgpu_query_shader_info(sg_shader shd_id) {
    assert(cast(i64, _sg.valid));
    sg_wgpu_shader_info res;
    when defined(SOKOL_WGPU) {
        _sg_shader_t* shd = _sg_lookup_shader(shd_id.id);
        if shd != null {
            res.vs_mod = cast(void*, shd.wgpu.vertex_func.module);
            res.fs_mod = cast(void*, shd.wgpu.fragment_func.module);
            res.bgl = cast(void*, shd.wgpu.bgl_view_smp);
        }
    } else {
        ignore shd_id;
    }
    return res;
}

sg_wgpu_pipeline_info sg_wgpu_query_pipeline_info(sg_pipeline pip_id) {
    assert(cast(i64, _sg.valid));
    sg_wgpu_pipeline_info res;
    when defined(SOKOL_WGPU) {
        _sg_pipeline_t* pip = _sg_lookup_pipeline(pip_id.id);
        if pip != null {
            res.render_pipeline = cast(void*, pip.wgpu.rpip);
            res.compute_pipeline = cast(void*, pip.wgpu.cpip);
        }
    } else {
        ignore pip_id;
    }
    return res;
}

sg_wgpu_view_info sg_wgpu_query_view_info(sg_view view_id) {
    assert(cast(i64, _sg.valid));
    sg_wgpu_view_info res;
    when defined(SOKOL_WGPU) {
        _sg_view_t* view = _sg_lookup_view(view_id.id);
        if view != null {
            res.view = cast(void*, view.wgpu.view);
        }
    } else {
        ignore view_id;
    }
    return res;
}

sg_gl_buffer_info sg_gl_query_buffer_info(sg_buffer buf_id) {
    assert(cast(i64, _sg.valid));
    sg_gl_buffer_info res;
    _sg_buffer_t* buf = _sg_lookup_buffer(buf_id.id);
    if buf != null {
        for i32 i = 0; i < SG_NUM_INFLIGHT_FRAMES; i++ {
            res.buf[i] = buf.gl.buf[i];
        }
        res.active_slot = buf.cmn.active_slot;
    }
    return res;
}

sg_gl_image_info sg_gl_query_image_info(sg_image img_id) {
    assert(cast(i64, _sg.valid));
    sg_gl_image_info res;
    _sg_image_t* img = _sg_lookup_image(img_id.id);
    if img != null {
        for i32 i = 0; i < SG_NUM_INFLIGHT_FRAMES; i++ {
            res.tex[i] = img.gl.tex[i];
        }
        res.tex_target = img.gl.target;
        res.active_slot = img.cmn.active_slot;
    }
    return res;
}

sg_gl_sampler_info sg_gl_query_sampler_info(sg_sampler smp_id) {
    assert(cast(i64, _sg.valid));
    sg_gl_sampler_info res;
    _sg_sampler_t* smp = _sg_lookup_sampler(smp_id.id);
    if smp != null {
        res.smp = smp.gl.smp;
    }
    return res;
}

sg_gl_shader_info sg_gl_query_shader_info(sg_shader shd_id) {
    assert(cast(i64, _sg.valid));
    sg_gl_shader_info res;
    _sg_shader_t* shd = _sg_lookup_shader(shd_id.id);
    if shd != null {
        res.prog = shd.gl.prog;
    }
    return res;
}

sg_gl_view_info sg_gl_query_view_info(sg_view view_id) {
    assert(cast(i64, _sg.valid));
    sg_gl_view_info res;
    _sg_view_t* view = _sg_lookup_view(view_id.id);
    if view != null {
        for u64 i = 0; i < cast(u64, SG_NUM_INFLIGHT_FRAMES); i++ {
            res.tex_view[i] = view.gl.tex_view[i];
        }
        res.msaa_render_buffer = view.gl.msaa_render_buffer;
        res.msaa_resolve_frame_buffer = view.gl.msaa_resolve_frame_buffer;
    }
    return res;
}
private {
}


private { u32 _sg_gl_create_view__gl_draw_buf = GL_COLOR_ATTACHMENT0; }

// sokol_app backend for WebGL2 on the web.

// Staged next to the emitted .wasm and served by `minc run --target wasm`.
@wasm_host "sokol_wasm_host.js"
@wasm_html "sokol_wasm_harness.html"

// --- Host helpers (provided by sokol_wasm_host.js) ---
extern "sapp" i32  sapp_host_width();

// Entry point sapp_run dispatches into. The host owns the canvas size
// and creates the WebGL context; JS drives the frame loop through the
// exports below.
void _sapp_emsc_run(sapp_desc* desc) {
    _sapp_init_state(desc);
    _sapp.fullscreen = false;   // cannot start fullscreen on the web
    // The host reports the canvas drawing-buffer size in native pixels:
    // that is the framebuffer. window_* is the logical CSS size
    // (framebuffer / dpr), and sapp_dpi_scale() reports dpr.
    f64 dpr = cast(f64, sapp_host_dpi()) / 1000.0;
    if dpr <= 0.0 { dpr = 1.0; }
    f64 w = cast(f64, sapp_host_width());
    f64 h = cast(f64, sapp_host_height());
    _sapp.dpi_scale = cast(f32, dpr);
    _sapp.framebuffer_width = cast(i32, w);
    _sapp.framebuffer_height = cast(i32, h);
    _sapp.window_width = cast(i32, w / dpr);
    _sapp.window_height = cast(i32, h / dpr);
    _sapp.valid = true;
    // init_cb is not called here; _sapp_frame() runs it on the first frame.
    return;
}

// --- No-ops: fullscreen, cursors, clipboard, file drops ---
// Unavailable in the browser until wired through the JS host.
void _sapp_emsc_toggle_fullscreen() { return; }

// --- Frame loop and DOM events, driven from JS ---
// The host calls _sapp_wasm_frame once per animation frame, passing the
// requestAnimationFrame timestamp in milliseconds. That timestamp is the
// clock source: the web has no monotonic-clock backend.
export void _sapp_wasm_frame(f64 time_ms) {
    if !_sapp.valid { return; }
    _sapp_timing_update(&_sapp.timing, time_ms / 1000.0);
    _sapp_frame();
    if _sapp.quit_requested != 0 {
        _sapp_init_event(SAPP_EVENTTYPE_QUIT_REQUESTED);
        _sapp_call_event(&_sapp.event);
        if _sapp.quit_requested != 0 { _sapp.quit_ordered = true; }
    }
    if _sapp.quit_ordered != 0 {
        _sapp_call_cleanup();
        _sapp.valid = false;
        sapp_host_request_quit();
    }
}







export void _sapp_wasm_event_resized(i32 w, i32 h) {
    // w,h are native pixels. The size is updated even before events are
    // enabled; only the RESIZED event itself is gated.
    f64 dpr = cast(f64, sapp_host_dpi()) / 1000.0;
    if dpr <= 0.0 { dpr = 1.0; }
    _sapp.dpi_scale = cast(f32, dpr);
    _sapp.framebuffer_width = w;
    _sapp.framebuffer_height = h;
    _sapp.window_width = cast(i32, cast(f64, w) / dpr);
    _sapp.window_height = cast(i32, cast(f64, h) / dpr);
    if !_sapp_events_enabled() { return; }
    _sapp_init_event(SAPP_EVENTTYPE_RESIZED);
    _sapp_call_event(&_sapp.event);
}


}
}

when os(windows) { import ext_win_wgl; }
when os(linux) { import ext_x11; }

// sokol_shader.mc - @shader -> sg_shader bridge
//
// _SOKOL_GLSL_DESC marks targets whose sokol_gfx backend is
// GL-flavored and needs the glsl_* descriptor fields (uniform member
// descriptors, combined-sampler names, storage bindings): linux /
// android / wasm always, and Windows or macOS when the GLCORE backend
// is selected (-D SOKOL_GLCORE, paired with @gpu "opengl" so the
// shader text is GLSL too).
when os(linux) || os(android) || os(wasm) {
    when !defined(_SOKOL_GLSL_DESC) { @define "_SOKOL_GLSL_DESC" }
}
when (os(windows) || os(macos)) && defined(SOKOL_GLCORE) {
    when !defined(_SOKOL_GLSL_DESC) { @define "_SOKOL_GLSL_DESC" }
}
// The default logger for every sokol header: writes one line to stderr
// and aborts on a panic. Build with -D SOKOL_DEBUG to add sokol's
// validation layer, which reports through here.
//
// macOS/iOS use sokol_log.h's own implementation.
private {
    u8* _slog_level_str(u32 level) {
        if level == 0 { return "panic"; }
        if level == 1 { return "error"; }
        if level == 2 { return "warning"; }
        return "info";
    }

    // Append a NUL-terminated string, truncating at cap.
    i32 _slog_put(u8* dst, i32 pos, i32 cap, u8* s) {
        if s == null { return pos; }
        i32 i = 0;
        while *(s + i) != 0 && pos < cap - 1 {
            *(dst + pos) = *(s + i);
            pos = pos + 1;
            i = i + 1;
        }
        return pos;
    }

    i32 _slog_put_u32(u8* dst, i32 pos, i32 cap, u32 v) {
        noinit u8[12] tmp;
        i32 n = 0;
        if v == 0 { tmp[0] = cast(u8, 48); n = 1; }
        while v > 0 {
            tmp[n] = cast(u8, 48 + cast(i32, v % cast(u32, 10)));
            n = n + 1;
            v = v / cast(u32, 10);
        }
        while n > 0 && pos < cap - 1 {
            n = n - 1;
            *(dst + pos) = tmp[n];
            pos = pos + 1;
        }
        return pos;
    }
}

when os(windows) || os(linux) || os(wasm) || os(android) {
    void slog_func(u8* tag, u32 log_level, u32 log_item, u8* message, u32 line_nr, u8* filename, void* user_data) {
        ignore user_data;
        noinit u8[512] line;
        u8* buf = line;
        i32 cap = 512;
        i32 n = 0;
        if tag != null {
            n = _slog_put(buf, n, cap, "[");
            n = _slog_put(buf, n, cap, tag);
            n = _slog_put(buf, n, cap, "]");
        }
        n = _slog_put(buf, n, cap, "[");
        n = _slog_put(buf, n, cap, _slog_level_str(log_level));
        n = _slog_put(buf, n, cap, "][id:");
        n = _slog_put_u32(buf, n, cap, log_item);
        n = _slog_put(buf, n, cap, "] ");
        if filename != null {
            n = _slog_put(buf, n, cap, filename);
            n = _slog_put(buf, n, cap, ":");
            n = _slog_put_u32(buf, n, cap, line_nr);
            n = _slog_put(buf, n, cap, ": ");
        }
        // The message text is only compiled in under SOKOL_DEBUG; the
        // item id above identifies it either way.
        n = _slog_put(buf, n, cap, message);
        n = _slog_put(buf, n, cap, "\n");
        ignore write(stderr(), buf, n);
        if log_level == 0 { abort(); }
        return;
    }
}

// sg_logger wrapping sokol's default logger
sg_logger sglue_logger() {
    sg_logger log;
    log.func = slog_func;
    return log;
}

// --- Shader helper: build sg_shader from ShaderMeta pair (vertex + fragment) ---

sg_shader sokol_make_shader(ShaderMeta* vs, ShaderMeta* fs) {
    sg_shader_desc desc;
    desc.vertex_func.source = vs.source;
    desc.fragment_func.source = fs.source;

    when os(windows) {
        // Left unset, sokol compiles at vs_4_0 / ps_4_0, and Shader
        // Model 4.0 cannot express everything the @shader emitter
        // produces: SampleCmp on a Texture2DArray and
        // StructuredBuffer among them. Those fail inside D3DCompile at
        // run time, and a shader that fails to compile makes
        // sg_apply_bindings skip the draw, so the symptom is missing
        // geometry rather than an error.
        //
        // sokol_app only ever creates a feature-level 11_0 or 11_1
        // device, so Shader Model 5.0 is always available.
        //
        // Do not set these in the compute overload below: sokol
        // defaults the compute target by reading the *fragment* field,
        // so a fragment target set on a compute desc becomes the
        // compute target and fails to compile.
        desc.vertex_func.d3d11_target = "vs_5_0";
        desc.fragment_func.d3d11_target = "ps_5_0";
    }
    when os(macos) || os(ios) {
        desc.vertex_func.entry = "main0";
        desc.fragment_func.entry = "main0";
    }
    when os(wasm) {
        desc.vertex_func.entry = "main";
        desc.fragment_func.entry = "main";
    }

    // Uniform blocks. Block-level setup (stage, size, register/buffer
    // bindings) comes from ShaderMeta's ub_size0..3. Per-field GLSL
    // uniform descriptors (name + type + array_count) come from
    // ShaderMeta.uniforms[] populated by the compiler. SHADER_UTYPE_*
    // values match sg_uniform_type.
    i32 ub_idx = 0;
    // VS uniform blocks
    for i32 bi = 0; bi < vs.num_uniform_blocks; bi = bi + 1 {
        i32 bsz = 0;
        if bi == 0 { bsz = vs.ub_size0; }
        if bi == 1 { bsz = vs.ub_size1; }
        if bi == 2 { bsz = vs.ub_size2; }
        if bi == 3 { bsz = vs.ub_size3; }
        if bsz > 0 {
            desc.uniform_blocks[ub_idx].stage = SG_SHADERSTAGE_VERTEX;
            desc.uniform_blocks[ub_idx].size = _sokol_uniform_block_size(bsz);
            when os(windows) { desc.uniform_blocks[ub_idx].hlsl_register_b_n = cast(u8, bi); }
            when os(macos) || os(ios) { desc.uniform_blocks[ub_idx].msl_buffer_n = cast(u8, bi); }
            when defined(_SOKOL_GLSL_DESC) {
                // @gpu_layout block: the client data is std140-padded,
                // so sokol must compute member offsets by std140 rules
                // (NATIVE's packed sum would read the pre-pad bytes).
                // sokol's own round-to-16 of the member sum covers the
                // tail, so no synthetic pad member either.
                bool std140 = ((vs.ub_std140_mask >> bi) & 1) != 0;
                if std140 { desc.uniform_blocks[ub_idx].layout = SG_UNIFORMLAYOUT_STD140; }
                if ((vs.ub_flat_mask >> bi) & 1) != 0 {
                    // Flattened block: the compiler emitted one
                    // `uniform vec4 _mcub<bi>_vs[N]`: one FLOAT4
                    // member, no pad (N*16 == padded size).
                    _sokol_flat_glsl_uniform(&desc, ub_idx, bsz, bi, 1);
                } else {
                    // Per-field descriptors for this block (filled below
                    // by the descriptor-walk loop). sokol's sg_uniform_type
                    // has no unsigned variants, so map SHADER_UTYPE_UINT*
                    // (10..13) onto its signed twin (5..8): glUniform1iv
                    // writes raw bits, the shader's `uniform uint` decl
                    // reads them back as unsigned.
                    i32 k = 0;
                    for i32 di = 0; di < vs.uniforms_count; di = di + 1 {
                        ShaderUniformDesc* d = vs.uniforms + di;
                        if d.block != bi { continue; }
                        i32 t = d.type_kind;
                        if t >= 10 && t <= 13 { t = t - 5; }
                        desc.uniform_blocks[ub_idx].glsl_uniforms[k].type = t;
                        desc.uniform_blocks[ub_idx].glsl_uniforms[k].array_count = cast(u16, d.array_count);
                        desc.uniform_blocks[ub_idx].glsl_uniforms[k].glsl_name = d.name;
                        k = k + 1;
                    }
                    if !std140 { _sokol_pad_glsl_uniform(&desc, ub_idx, k, bsz); }
                }
                desc.uniform_blocks[ub_idx].wgsl_group0_binding_n = cast(u8, bi);
            }
            ub_idx = ub_idx + 1;
        }
    }
    // FS uniform blocks
    for i32 bi = 0; bi < fs.num_uniform_blocks; bi = bi + 1 {
        i32 bsz = 0;
        if bi == 0 { bsz = fs.ub_size0; }
        if bi == 1 { bsz = fs.ub_size1; }
        if bi == 2 { bsz = fs.ub_size2; }
        if bi == 3 { bsz = fs.ub_size3; }
        if bsz > 0 {
            desc.uniform_blocks[ub_idx].stage = SG_SHADERSTAGE_FRAGMENT;
            desc.uniform_blocks[ub_idx].size = _sokol_uniform_block_size(bsz);
            when os(windows) { desc.uniform_blocks[ub_idx].hlsl_register_b_n = cast(u8, bi); }
            when os(macos) || os(ios) { desc.uniform_blocks[ub_idx].msl_buffer_n = cast(u8, bi); }
            when defined(_SOKOL_GLSL_DESC) {
                // @gpu_layout block → std140 (see the VS arm above).
                bool std140 = ((fs.ub_std140_mask >> bi) & 1) != 0;
                if std140 { desc.uniform_blocks[ub_idx].layout = SG_UNIFORMLAYOUT_STD140; }
                if ((fs.ub_flat_mask >> bi) & 1) != 0 {
                    // Flattened block (see the VS arm above).
                    _sokol_flat_glsl_uniform(&desc, ub_idx, bsz, bi, 2);
                } else {
                    // Same UINT* → INT* mapping as the VS arm above.
                    i32 k = 0;
                    for i32 di = 0; di < fs.uniforms_count; di = di + 1 {
                        ShaderUniformDesc* d = fs.uniforms + di;
                        if d.block != bi { continue; }
                        i32 t = d.type_kind;
                        if t >= 10 && t <= 13 { t = t - 5; }
                        desc.uniform_blocks[ub_idx].glsl_uniforms[k].type = t;
                        desc.uniform_blocks[ub_idx].glsl_uniforms[k].array_count = cast(u16, d.array_count);
                        desc.uniform_blocks[ub_idx].glsl_uniforms[k].glsl_name = d.name;
                        k = k + 1;
                    }
                    if !std140 { _sokol_pad_glsl_uniform(&desc, ub_idx, k, bsz); }
                }
                // NOTE: FS uniform blocks share @group(0) with VS; the
                // @shader emitter must assign them distinct slots.
                desc.uniform_blocks[ub_idx].wgsl_group0_binding_n = cast(u8, bi);
            }
            ub_idx = ub_idx + 1;
        }
    }

    // Vertex attributes use ATTR semantics matching shader emitter
    when os(windows) {
        for i32 i = 0; i < vs.num_attrs; i = i + 1 {
            desc.attrs[i].hlsl_sem_name = "ATTR";
            desc.attrs[i].hlsl_sem_index = cast(u8, i);
        }
    }

    // Bindings, per stage. Vertex pulling reads a storage buffer in the
    // vertex shader and vertextexture samples a texture there, so both
    // metas are walked; sokol's views[] / samplers[] are one array
    // across stages, keyed by the @texture(N) / @sampler(N) / @buffer(N)
    // slot, so the two stages must not reuse a slot.
    i32 pair_idx = 0;
    pair_idx = _sokol_stage_bindings(&desc, vs, SG_SHADERSTAGE_VERTEX, pair_idx);
    pair_idx = _sokol_stage_bindings(&desc, fs, SG_SHADERSTAGE_FRAGMENT, pair_idx);

    return sg_make_shader(&desc);
}

// Describe one stage's @texture / @sampler / @buffer bindings and
// append its texture-sampler pairs. Returns the next free pair index.
// The @texture(N) / @sampler(N) slot IS the sg_bindings views[] /
// samplers[] index; shaders sharing one sg_bindings can pick distinct
// slots (sokol-samples' shared-bindings scrambles them deliberately).
i32 _sokol_stage_bindings(sg_shader_desc* desc, ShaderMeta* m, i32 stage, i32 pair_idx) {
    i32[8] tex_view_pos;
    i32[8] smp_slot_at;
    i32 tex_count = 0;
    i32 smp_count = 0;
    // HLSL u-registers are not the declared slot. The shader compiler
    // numbers storage images u0.. in declaration order, ignoring their
    // @storage(fmt, N), then starts storage buffers at u(images + N).
    // Every other backend uses the declared slot, so only the Windows
    // arm below diverges.
    i32 simg_total = 0;
    for i32 si = 0; si < m.bindings_count; si = si + 1 {
        if (m.bindings + si).kind == 2 { simg_total = simg_total + 1; }
    }
    i32 simg_seen = 0;
    for i32 bi = 0; bi < m.bindings_count; bi = bi + 1 {
        ShaderBinding* b = m.bindings + bi;
        if b.kind == 0 {     // TEXTURE
            i32 vslot = b.slot;
            desc.views[vslot].texture.stage = stage;
            desc.views[vslot].texture.image_type =
                _sokol_image_type_for(b.image_type);
            // sokol carries multisample as a flag beside the image type
            // rather than a type of its own, so Texture2DMS arrives as
            // an ordinary 2D image_type with this set.
            desc.views[vslot].texture.multisampled = b.multisampled != 0;
            // A texture the shader reaches through sample_cmp is a depth
            // texture; the compiler marks it in the binding. WebGPU
            // validates binding types, so guessing _FLOAT here fails
            // there even where D3D11 and GLES3 tolerate it.
            if b.sample_kind == 1 {
                desc.views[vslot].texture.sample_type = SG_IMAGESAMPLETYPE_DEPTH;
            } else if b.sample_kind == 2 {
                // @texture(N, unfilterable): the bound format can't be
                // filtered, which only the author can know.
                desc.views[vslot].texture.sample_type = SG_IMAGESAMPLETYPE_UNFILTERABLE_FLOAT;
            } else if b.sample_kind == 3 {
                desc.views[vslot].texture.sample_type = SG_IMAGESAMPLETYPE_SINT;
            } else if b.sample_kind == 4 {
                desc.views[vslot].texture.sample_type = SG_IMAGESAMPLETYPE_UINT;
            } else {
                desc.views[vslot].texture.sample_type = SG_IMAGESAMPLETYPE_FLOAT;
            }
            when os(windows)          { desc.views[vslot].texture.hlsl_register_t_n = cast(u8, b.slot); }
            when os(macos) || os(ios) { desc.views[vslot].texture.msl_texture_n = cast(u8, b.slot); }
            when os(linux) || os(android) || os(wasm) { desc.views[vslot].texture.wgsl_group1_binding_n = cast(u8, b.slot); }   // WGPU @group(1) tex base 0
            if tex_count < 8 {
                tex_view_pos[tex_count] = vslot;
                tex_count = tex_count + 1;
            }
        } else if b.kind == 1 {     // SAMPLER
            i32 sslot = b.slot;
            desc.samplers[sslot].stage = stage;
            // The sampler paired with a depth texture in that call does
            // the comparison.
            if b.sampler_kind == 1 {
                desc.samplers[sslot].sampler_type = SG_SAMPLERTYPE_COMPARISON;
            } else if b.sampler_kind == 2 {
                desc.samplers[sslot].sampler_type = SG_SAMPLERTYPE_NONFILTERING;
            } else {
                desc.samplers[sslot].sampler_type = SG_SAMPLERTYPE_FILTERING;
            }
            when os(windows)          { desc.samplers[sslot].hlsl_register_s_n = cast(u8, b.slot); }
            when os(macos) || os(ios) { desc.samplers[sslot].msl_sampler_n = cast(u8, b.slot); }
            when os(linux) || os(android) || os(wasm) { desc.samplers[sslot].wgsl_group1_binding_n = cast(u8, 16 + b.slot); }   // WGPU @group(1) smp base 16
            if smp_count < 8 {
                smp_slot_at[smp_count] = sslot;
                smp_count = smp_count + 1;
            }
        } else if b.kind == 3 {     // STORAGE_BUFFER
            // sokol's storage-buffer access is readonly OR readwrite
            // (no writeonly, sokol_gfx.h:3672). HLSL splits the
            // bind space: readonly → t-register (SRV), RW →
            // u-register (UAV). Other backends use a single binding
            // number per buffer regardless of access.
            i32 sbslot = b.slot;
            desc.views[sbslot].storage_buffer.stage = stage;
            desc.views[sbslot].storage_buffer.readonly = (b.access == 0);
            when os(windows) {
                if b.access == 0 {
                    desc.views[sbslot].storage_buffer.hlsl_register_t_n = cast(u8, b.slot);
                } else {
                    // Past the storage images, which hold u0..
                    desc.views[sbslot].storage_buffer.hlsl_register_u_n =
                        cast(u8, simg_total + b.slot);
                }
            }
            when defined(_SOKOL_GLSL_DESC) {
                desc.views[sbslot].storage_buffer.glsl_binding_n = cast(u8, b.slot);
                // WGPU: storage buffers share @group(1) at base 32 (additive;
                // GLES3 reads glsl_binding_n, WGPU reads wgsl_group1_binding_n).
                desc.views[sbslot].storage_buffer.wgsl_group1_binding_n = cast(u8, 32 + b.slot);
            }
            when os(macos) || os(ios) {
                // sokol reserves [[buffer(0..7)]] for uniform blocks and
                // puts storage buffers at [[buffer(8..23)]] in the vertex
                // and fragment stages alike (sokol_gfx.h "Metal:"
                // caveats). The shader emitter offsets by 8; mirror it
                // here or the buffer binds over a uniform block.
                desc.views[sbslot].storage_buffer.msl_buffer_n = cast(u8, b.slot + 8);
            }
        } else if b.kind == 2 {     // STORAGE_IMAGE
            // Compute-only in practice (sokol has no render-stage
            // storage images), but described here so every binding
            // kind is indexed by its declared slot from one place.
            // Currently the compiler only emits writeonly
            // RWTexture2D; the shape covers future formats /
            // readonly storage / 3D / cube.
            i32 sislot = b.slot;
            desc.views[sislot].storage_image.stage = stage;
            desc.views[sislot].storage_image.image_type =
                _sokol_image_type_for(b.image_type);
            desc.views[sislot].storage_image.access_format =
                _sokol_pixel_format_for(b.format, b.format_len);
            // sokol's storage-image access is binary: writeonly OR
            // readwrite (no readonly; that maps to a regular texture
            // binding per sokol_gfx.h:1521). access==1 → writeonly.
            desc.views[sislot].storage_image.writeonly = (b.access == 1);
            when os(windows)          { desc.views[sislot].storage_image.hlsl_register_u_n = cast(u8, simg_seen); }
            when defined(_SOKOL_GLSL_DESC) {
                desc.views[sislot].storage_image.glsl_binding_n = cast(u8, b.slot);
                // WGSL numbers storage images by declaration order, base 48.
                desc.views[sislot].storage_image.wgsl_group1_binding_n = cast(u8, 48 + simg_seen);
            }
            simg_seen = simg_seen + 1;
            when os(macos) || os(ios) { desc.views[sislot].storage_image.msl_texture_n = cast(u8, b.slot); }
        }
    }

    // One pair per texture, matched to the sampler declared at the
    // same position. GLSL wants a combined-sampler name per texture,
    // so a shader with fewer samplers than textures shares the last
    // one across the rest; mrt-sapp reads three offscreen targets
    // through a single sampler.
    i32 npairs = tex_count;
    if smp_count == 0 { npairs = 0; }
    i32 walk_tex = 0;
    for i32 bi = 0; bi < m.bindings_count && walk_tex < npairs; bi = bi + 1 {
        ShaderBinding* b = m.bindings + bi;
        if b.kind != 0 { continue; }
        i32 si = walk_tex;
        if si >= smp_count { si = smp_count - 1; }
        desc.texture_sampler_pairs[pair_idx].stage = stage;
        desc.texture_sampler_pairs[pair_idx].view_slot = cast(u8, tex_view_pos[walk_tex]);
        desc.texture_sampler_pairs[pair_idx].sampler_slot = cast(u8, smp_slot_at[si]);
        when defined(_SOKOL_GLSL_DESC) {
            if b.name != null { desc.texture_sampler_pairs[pair_idx].glsl_name = b.name; }
        }
        walk_tex = walk_tex + 1;
        pair_idx = pair_idx + 1;
    }
    return pair_idx;
}

// Map ShaderBinding.image_type (0=2D, 1=3D, 2=cube, 3=2D-array) to
// the sokol enum value. Centralized so neither helper duplicates the
// translation table.
i32 _sokol_image_type_for(i32 it) {
    if it == 1 { return SG_IMAGETYPE_3D; }
    if it == 2 { return SG_IMAGETYPE_CUBE; }
    if it == 3 { return SG_IMAGETYPE_ARRAY; }
    return SG_IMAGETYPE_2D;
}

// Byte-equality check used by the format-string lookup.
bool _sokol_bytes_eq(u8* a, u8* b, i32 n) {
    for i32 i = 0; i < n; i = i + 1 {
        if *(a + i) != *(b + i) { return false; }
    }
    return true;
}

// Pad a uniform-block size to a backend-appropriate cbuffer multiple.
// HLSL and MSL require cbuffer / argument-buffer sizes to be multiples
// of 16 bytes; GL accepts any size and uses per-uniform descriptors
// to write fields individually. ShaderMeta stores raw element-summed
// sizes (4 bytes for `@uniform f32 u_time`).
// GL validates that the glsl_uniforms member sizes sum to the declared
// block size. The declared size is now rounded to 16 on every backend,
// so a block whose raw (packed) size isn't a 16-multiple gets a
// synthetic trailing FLOAT-array pad member covering the gap. The
// shader source never declares "_sokol_ub_pad"; glGetUniformLocation
// answers -1 and sokol skips it at apply time.
// Blocks with ub_flat_mask's bit set skip both the walk and the pad:
// the compiler flattened them to one vec4 array, described below by
// _sokol_flat_glsl_uniform (member sum = N*16 = padded size).
when defined(_SOKOL_GLSL_DESC) {
    void _sokol_pad_glsl_uniform(sg_shader_desc* desc, i32 ub_idx, i32 k, i32 raw) {
        i32 pad = _sokol_uniform_block_size(raw) - raw;
        if pad <= 0 { return; }
        desc.uniform_blocks[ub_idx].glsl_uniforms[k].type = SG_UNIFORMTYPE_FLOAT;
        desc.uniform_blocks[ub_idx].glsl_uniforms[k].array_count = cast(u16, pad / 4);
        desc.uniform_blocks[ub_idx].glsl_uniforms[k].glsl_name = "_sokol_ub_pad";
    }

    // Flat-array uniform name for a flattened block. Must mirror the
    // compiler's shader_emit_flat_ub_name: _mcub<block> + a stage
    // suffix (VS and FS link into one GL program and share a uniform
    // namespace). stage: 1=vertex, 2=fragment, 3=compute.
    u8* _sokol_flat_ub_name(i32 blk, i32 stage) {
        if stage == 1 {
            if blk == 0 { return "_mcub0_vs"; }
            if blk == 1 { return "_mcub1_vs"; }
            if blk == 2 { return "_mcub2_vs"; }
            return "_mcub3_vs";
        }
        if stage == 2 {
            if blk == 0 { return "_mcub0_fs"; }
            if blk == 1 { return "_mcub1_fs"; }
            if blk == 2 { return "_mcub2_fs"; }
            return "_mcub3_fs";
        }
        if blk == 0 { return "_mcub0_cs"; }
        if blk == 1 { return "_mcub1_cs"; }
        if blk == 2 { return "_mcub2_cs"; }
        return "_mcub3_cs";
    }

    // Describe a flattened block: one FLOAT4 array member covering
    // the whole padded size, one glUniform4fv per draw instead of
    // one glUniform* per member, and the member-sum validation holds
    // by construction (no pad member needed).
    void _sokol_flat_glsl_uniform(sg_shader_desc* desc, i32 ub_idx, i32 raw, i32 blk, i32 stage) {
        desc.uniform_blocks[ub_idx].glsl_uniforms[0].type = SG_UNIFORMTYPE_FLOAT4;
        desc.uniform_blocks[ub_idx].glsl_uniforms[0].array_count = cast(u16, _sokol_uniform_block_size(raw) / 16);
        desc.uniform_blocks[ub_idx].glsl_uniforms[0].glsl_name = _sokol_flat_ub_name(blk, stage);
    }
}

i32 _sokol_uniform_block_size(i32 raw) {
    // Rounded to 16 on EVERY backend. D3D11/Metal require it; GL now
    // matches so one padded CPU-side buffer size satisfies
    // sg_apply_uniforms' size==declared validation everywhere (app code
    // passes sizeof of the tail-padded struct, or sokol_uniform_size).
    // The GL member-sum validation is closed by a synthetic trailing
    // pad member (see _sokol_pad_glsl_uniform) that the shader source
    // never declares: location -1, skipped at apply time.
    return (raw + 15) & cast(i32, 0xFFFFFFF0);
}

// sg_apply_uniforms expects a `size` matching what the shader's
// uniform block was declared with, which differs per backend (raw
// on GL, 16-byte multiples on HLSL/MSL). ShaderMeta carries the raw
// size; this helper returns the value to put in `sg_range.size` so
// app code can stay platform-agnostic. Apps must still declare their
// CPU-side uniform buffer at the *padded* size (typically `f32[4]`
// for a single-float uniform). HLSL/MSL will read the full 16
// bytes. GL reads only the first 4 of the same buffer.
i64 sokol_uniform_size(ShaderMeta* meta, i32 block) {
    i32 raw = 0;
    if block == 0 { raw = meta.ub_size0; }
    else if block == 1 { raw = meta.ub_size1; }
    else if block == 2 { raw = meta.ub_size2; }
    else if block == 3 { raw = meta.ub_size3; }
    return cast(i64, _sokol_uniform_block_size(raw));
}

// Map ShaderBinding.format strings ("rgba8", "r32f", …) to the sokol
// pixel-format enum. Only formats sokol_shdc supports for storage
// images are listed; everything else falls back to RGBA8 with a
// stderr note so the user gets a clear path to add the mapping.
i32 _sokol_pixel_format_for(u8* fmt, i32 fmt_len) {
    if fmt == null || fmt_len == 0 { return SG_PIXELFORMAT_RGBA8; }
    if fmt_len == 5 && _sokol_bytes_eq(fmt, "rgba8", 5) { return SG_PIXELFORMAT_RGBA8; }
    if fmt_len == 6 && _sokol_bytes_eq(fmt, "rgba8s", 6) { return SG_PIXELFORMAT_RGBA8SN; }
    if fmt_len == 7 && _sokol_bytes_eq(fmt, "rgba16f", 7) { return SG_PIXELFORMAT_RGBA16F; }
    if fmt_len == 7 && _sokol_bytes_eq(fmt, "rgba32f", 7) { return SG_PIXELFORMAT_RGBA32F; }
    if fmt_len == 5 && _sokol_bytes_eq(fmt, "rg16f", 5) { return SG_PIXELFORMAT_RG16F; }
    if fmt_len == 5 && _sokol_bytes_eq(fmt, "rg32f", 5) { return SG_PIXELFORMAT_RG32F; }
    if fmt_len == 4 && _sokol_bytes_eq(fmt, "r32f", 4) { return SG_PIXELFORMAT_R32F; }
    if fmt_len == 4 && _sokol_bytes_eq(fmt, "r16f", 4) { return SG_PIXELFORMAT_R16F; }
    return SG_PIXELFORMAT_RGBA8;
}

// Compute-shader overload. ShaderMeta carries everything sokol needs
// to build an sg_shader for a compute pass: the shader source per
// backend, the threadgroup dimensions for Metal, the storage image /
// uniform-block bindings via ShaderBinding[].
sg_shader sokol_make_shader(ShaderMeta* cs) {
    sg_shader_desc desc;
    desc.compute_func.source = cs.source;

    when os(macos) || os(ios) {
        desc.compute_func.entry = "main0";
        desc.mtl_threads_per_threadgroup.x = cs.group_size_x;
        desc.mtl_threads_per_threadgroup.y = cs.group_size_y;
        desc.mtl_threads_per_threadgroup.z = cs.group_size_z;
    }
    when os(wasm) { desc.compute_func.entry = "main"; }   // WGSL entry

    // Uniform blocks, same shape as the render path. Compute
    // shaders only have a compute stage, so all blocks land there.
    i32 ub_idx = 0;
    for i32 bi = 0; bi < cs.num_uniform_blocks; bi = bi + 1 {
        i32 bsz = 0;
        if bi == 0 { bsz = cs.ub_size0; }
        if bi == 1 { bsz = cs.ub_size1; }
        if bi == 2 { bsz = cs.ub_size2; }
        if bi == 3 { bsz = cs.ub_size3; }
        if bsz > 0 {
            desc.uniform_blocks[ub_idx].stage = SG_SHADERSTAGE_COMPUTE;
            desc.uniform_blocks[ub_idx].size = _sokol_uniform_block_size(bsz);
            when os(windows)          { desc.uniform_blocks[ub_idx].hlsl_register_b_n = cast(u8, bi); }
            when os(macos) || os(ios) { desc.uniform_blocks[ub_idx].msl_buffer_n = cast(u8, bi); }
            when defined(_SOKOL_GLSL_DESC) {
                // @gpu_layout block → std140 (see the render path).
                bool std140 = ((cs.ub_std140_mask >> bi) & 1) != 0;
                if std140 { desc.uniform_blocks[ub_idx].layout = SG_UNIFORMLAYOUT_STD140; }
                if ((cs.ub_flat_mask >> bi) & 1) != 0 {
                    // Flattened block (see the render path).
                    _sokol_flat_glsl_uniform(&desc, ub_idx, bsz, bi, 3);
                } else {
                    i32 k = 0;
                    for i32 di = 0; di < cs.uniforms_count; di = di + 1 {
                        ShaderUniformDesc* d = cs.uniforms + di;
                        if d.block != bi { continue; }
                        i32 t = d.type_kind;
                        if t >= 10 && t <= 13 { t = t - 5; }
                        desc.uniform_blocks[ub_idx].glsl_uniforms[k].type = t;
                        desc.uniform_blocks[ub_idx].glsl_uniforms[k].array_count = cast(u16, d.array_count);
                        desc.uniform_blocks[ub_idx].glsl_uniforms[k].glsl_name = d.name;
                        k = k + 1;
                    }
                    if !std140 { _sokol_pad_glsl_uniform(&desc, ub_idx, k, bsz); }
                }
                desc.uniform_blocks[ub_idx].wgsl_group0_binding_n = cast(u8, bi);
            }
            ub_idx = ub_idx + 1;
        }
    }

    // Every binding kind (@texture / @sampler / @storage / @buffer)
    // is described by the same helper the render path uses, so the
    // declared slot IS the sg_bindings views[] / samplers[] index.
    // Compute shaders have a single stage, so one call covers it.
    //
    // This used to be a bespoke loop here that handled only storage
    // images and buffers, indexed by a compacted running counter. It
    // silently dropped @texture / @sampler bindings in a compute
    // shader, and put a storage image declared at a non-zero slot at
    // the wrong views[] index; imageblur-sapp (@texture(0) +
    // @storage(rgba8, 1)) hit both and rendered black on every
    // backend: sokol saw views[1].stage == NONE, so it never issued
    // the storage-image bind and the dispatch wrote nowhere.
    ignore _sokol_stage_bindings(&desc, cs, SG_SHADERSTAGE_COMPUTE, 0);

    return sg_make_shader(&desc);
}

// sokol entry - main() functions
when os(wasm) {
    // sapp_run stores the desc + runs init; the JS host drives the frame
    // loop via the seam's exported _sapp_wasm_frame.
    i32 main() {
        sapp_desc desc = sokol_main();
        sapp_run(&desc);
        return 0;
    }
}
when os(linux) {
    i32 main() {
        sapp_desc desc = sokol_main();
        sapp_run(&desc);
        return 0;
    }
}
when os(windows) {
    i32 main() {
        SetConsoleOutputCP(CP_UTF8);   // UTF-8 console (window title / prints)
        sapp_desc desc = sokol_main();
        sapp_run(&desc);
        return 0;
    }
}
when os(macos) {
    // Bring up the ObjC bridge + Cocoa/Metal frameworks before sapp_run.
    i32 main() {
        if sokol_macos_boot() != 0 { return 1; }
        sapp_desc desc = sokol_main();
        sapp_run(&desc);
        return 0;
    }
}
when os(ios) {
    // Register the ObjC scene-delegate / view classes before sapp_run; the
    // iOS body's _sapp_ios_run hands off to UIApplicationMain.
    i32 main() {
        if sokol_ios_boot() != 0 { return 1; }
        sapp_desc desc = sokol_main();
        sapp_run(&desc);
        return 0;
    }
}
