/* MacOS entry function */
u32 _sapp_macos_mods(NSEvent* ev) {
    NSEventModifierFlags f = ev == null ? cast(fn(void*, void*): u64, objc.raw)(objc_classref("NSEvent", "/System/Library/Frameworks/AppKit.framework/AppKit"), objc_selref("modifierFlags")) : cast(fn(void*, void*): u64, objc.raw)(ev, objc_selref("modifierFlags"));
    NSUInteger b = cast(fn(void*, void*): u64, objc.raw)(objc_classref("NSEvent", "/System/Library/Frameworks/AppKit.framework/AppKit"), objc_selref("pressedMouseButtons"));
    u32 m = 0;
    if (f & NSEventModifierFlagShift) != 0 {
        m |= cast(u32, SAPP_MODIFIER_SHIFT);
    }
    if (f & NSEventModifierFlagControl) != 0 {
        m |= cast(u32, SAPP_MODIFIER_CTRL);
    }
    if (f & NSEventModifierFlagOption) != 0 {
        m |= cast(u32, SAPP_MODIFIER_ALT);
    }
    if (f & NSEventModifierFlagCommand) != 0 {
        m |= cast(u32, SAPP_MODIFIER_SUPER);
    }
    if 0 != (b & cast(u64, 1 << 0)) {
        m |= cast(u32, SAPP_MODIFIER_LMB);
    }
    if 0 != (b & cast(u64, 1 << 1)) {
        m |= cast(u32, SAPP_MODIFIER_RMB);
    }
    if 0 != (b & cast(u64, 1 << 2)) {
        m |= cast(u32, SAPP_MODIFIER_MMB);
    }
    return m;
}
void _sapp_macos_mouse_event(sapp_event_type type, sapp_mousebutton btn, u32 mod) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        _sapp.event.mouse_button = btn;
        _sapp.event.modifiers = mod;
        _sapp_call_event(&_sapp.event);
    }
}
void _sapp_macos_key_event(sapp_event_type type, sapp_keycode key, bool repeat, u32 mod) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        _sapp.event.key_code = key;
        _sapp.event.key_repeat = repeat;
        _sapp.event.modifiers = mod;
        _sapp_call_event(&_sapp.event);
    }
}
void _sapp_macos_app_event(sapp_event_type type) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        _sapp_call_event(&_sapp.event);
    }
}
// called in applicationDidFinishedLaunching when no window size was provided
void _sapp_macos_init_default_dimensions() {
    if _sapp.desc.high_dpi != 0 {
        _sapp.dpi_scale = cast(f32, cast(fn(void*, void*): f64, objc.raw)(objc.msg_id_v(objc_classref("NSScreen", "/System/Library/Frameworks/AppKit.framework/AppKit"), objc_selref("mainScreen")), objc_selref("backingScaleFactor")));
    } else {
        _sapp.dpi_scale = 1.0f;
    }
    NSRect screen_rect = cast(fn(void*, void*): NSRect, objc.raw)(objc.msg_id_v(objc_classref("NSScreen", "/System/Library/Frameworks/AppKit.framework/AppKit"), objc_selref("mainScreen")), objc_selref("frame"));
    var default_widthf = cast(f32, cast(f32, screen_rect.size.width) * 4.0f / 5.0f);
    var default_heightf = cast(f32, cast(f32, screen_rect.size.height) * 4.0f / 5.0f);
    if _sapp.window_width == 0 {
        _sapp.window_width = _sapp_roundf_gzero(default_widthf);
    }
    if _sapp.window_height == 0 {
        _sapp.window_height = _sapp_roundf_gzero(default_heightf);
    }
    _sapp.framebuffer_width = _sapp_roundf_gzero(default_widthf * _sapp.dpi_scale);
    _sapp.framebuffer_height = _sapp_roundf_gzero(default_heightf * _sapp.dpi_scale);
}
void _sapp_macos_toggle_fullscreen() {
    _sapp.fullscreen = !_sapp.fullscreen;
    objc.msg_id_i(_sapp.macos.window, objc_selref("toggleFullScreen:"), null);
}
void _sapp_macos_set_clipboard_string(u8* str_var) {
