NSInteger _sapp_macos_max_fps() {
    return cast(fn(void*, void*): i64, objc.raw)(objc.msg_id_v(objc_classref("NSScreen", "/System/Library/Frameworks/AppKit.framework/AppKit"), objc_selref("mainScreen")), objc_selref("maximumFramesPerSecond"));
}

bool _sapp_macos_mtl_display_link_active() {
    return null != _sapp.mtl.display_link && !cast(fn(void*, void*): bool, objc.raw)(_sapp.mtl.display_link, objc_selref("isPaused"));
}

void _sapp_macos_mtl_timing_init() {
    _sapp.mtl.timing.timestamp = 0.0;
    _sapp.mtl.timing.frame_duration_sec = 1.0 / cast(f64, _sapp_macos_max_fps());
}

void _sapp_macos_mtl_timing_update() {
    if _sapp_macos_mtl_display_link_active() != 0 {
