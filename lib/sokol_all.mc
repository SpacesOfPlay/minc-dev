// Linux
when !(defined(SOKOL_DEBUG)) {
}

private {

void _sapp_timestamp_init(_sapp_timestamp_t* ts) {
    timespec tspec;
    clock_gettime(1, &tspec);
    ts.posix.start = cast(u64, tspec.tv_sec) * 1000000000 + cast(u64, tspec.tv_nsec);
}

f64 _sapp_timestamp_now(_sapp_timestamp_t* ts) {
    timespec tspec;
    clock_gettime(1, &tspec);
    u64 now = cast(u64, tspec.tv_sec) * 1000000000 + cast(u64, tspec.tv_nsec) - ts.posix.start;
    return cast(f64, now) / 1000000000.0;
}





}

