// setup dynamic keycode/scancode mapping tables, this is required
// for getting layout-independent keycodes on X11.
//
// see GLFW x11_init.c/createKeyTables()
void _sapp_x11_init_keytable() {
    for i32 i = 0; i < SAPP_MAX_KEYCODES; i++ {
        _sapp.keycodes[i] = SAPP_KEYCODE_INVALID;
    }
    XkbDescPtr desc = XkbGetMap(_sapp.x11.display, 0, XkbUseCoreKbd);
    assert(cast(i64, desc));
    XkbGetNames(_sapp.x11.display, 1 << 2 | 1 << 3, desc);
    var scancode_min = cast(i32, desc.min_key_code);
    var scancode_max = cast(i32, desc.max_key_code);
    if cast(i64, desc.names.keys) == 0 { XDisplayKeycodes(_sapp.x11.display, &scancode_min, &scancode_max); }
    keymap_t[121] keymap = {
        keymap_t{SAPP_KEYCODE_GRAVE_ACCENT, "TLDE"},
        keymap_t{SAPP_KEYCODE_1, "AE01"},
        keymap_t{SAPP_KEYCODE_2, "AE02"},
        keymap_t{SAPP_KEYCODE_3, "AE03"},
        keymap_t{SAPP_KEYCODE_4, "AE04"},
        keymap_t{SAPP_KEYCODE_5, "AE05"},
        keymap_t{SAPP_KEYCODE_6, "AE06"},
        keymap_t{SAPP_KEYCODE_7, "AE07"},
        keymap_t{SAPP_KEYCODE_8, "AE08"},
        keymap_t{SAPP_KEYCODE_9, "AE09"},
        keymap_t{SAPP_KEYCODE_0, "AE10"},
        keymap_t{SAPP_KEYCODE_MINUS, "AE11"},
        keymap_t{SAPP_KEYCODE_EQUAL, "AE12"},
        keymap_t{SAPP_KEYCODE_Q, "AD01"},
        keymap_t{SAPP_KEYCODE_W, "AD02"},
        keymap_t{SAPP_KEYCODE_E, "AD03"},
        keymap_t{SAPP_KEYCODE_R, "AD04"},
        keymap_t{SAPP_KEYCODE_T, "AD05"},
        keymap_t{SAPP_KEYCODE_Y, "AD06"},
        keymap_t{SAPP_KEYCODE_U, "AD07"},
        keymap_t{SAPP_KEYCODE_I, "AD08"},
        keymap_t{SAPP_KEYCODE_O, "AD09"},
        keymap_t{SAPP_KEYCODE_P, "AD10"},
        keymap_t{SAPP_KEYCODE_LEFT_BRACKET, "AD11"},
        keymap_t{SAPP_KEYCODE_RIGHT_BRACKET, "AD12"},
        keymap_t{SAPP_KEYCODE_A, "AC01"},
        keymap_t{SAPP_KEYCODE_S, "AC02"},
        keymap_t{SAPP_KEYCODE_D, "AC03"},
        keymap_t{SAPP_KEYCODE_F, "AC04"},
        keymap_t{SAPP_KEYCODE_G, "AC05"},
        keymap_t{SAPP_KEYCODE_H, "AC06"},
        keymap_t{SAPP_KEYCODE_J, "AC07"},
        keymap_t{SAPP_KEYCODE_K, "AC08"},
        keymap_t{SAPP_KEYCODE_L, "AC09"},
        keymap_t{SAPP_KEYCODE_SEMICOLON, "AC10"},
        keymap_t{SAPP_KEYCODE_APOSTROPHE, "AC11"},
        keymap_t{SAPP_KEYCODE_Z, "AB01"},
        keymap_t{SAPP_KEYCODE_X, "AB02"},
        keymap_t{SAPP_KEYCODE_C, "AB03"},
        keymap_t{SAPP_KEYCODE_V, "AB04"},
        keymap_t{SAPP_KEYCODE_B, "AB05"},
        keymap_t{SAPP_KEYCODE_N, "AB06"},
        keymap_t{SAPP_KEYCODE_M, "AB07"},
        keymap_t{SAPP_KEYCODE_COMMA, "AB08"},
        keymap_t{SAPP_KEYCODE_PERIOD, "AB09"},
        keymap_t{SAPP_KEYCODE_SLASH, "AB10"},
        keymap_t{SAPP_KEYCODE_BACKSLASH, "BKSL"},
        keymap_t{SAPP_KEYCODE_WORLD_1, "LSGT"},
        keymap_t{SAPP_KEYCODE_SPACE, "SPCE"},
        keymap_t{SAPP_KEYCODE_ESCAPE, "ESC"},
        keymap_t{SAPP_KEYCODE_ENTER, "RTRN"},
        keymap_t{SAPP_KEYCODE_TAB, "TAB"},
        keymap_t{SAPP_KEYCODE_BACKSPACE, "BKSP"},
        keymap_t{SAPP_KEYCODE_INSERT, "INS"},
        keymap_t{SAPP_KEYCODE_DELETE, "DELE"},
        keymap_t{SAPP_KEYCODE_RIGHT, "RGHT"},
        keymap_t{SAPP_KEYCODE_LEFT, "LEFT"},
        keymap_t{SAPP_KEYCODE_DOWN, "DOWN"},
        keymap_t{SAPP_KEYCODE_UP, "UP"},
        keymap_t{SAPP_KEYCODE_PAGE_UP, "PGUP"},
        keymap_t{SAPP_KEYCODE_PAGE_DOWN, "PGDN"},
        keymap_t{SAPP_KEYCODE_HOME, "HOME"},
        keymap_t{SAPP_KEYCODE_END, "END"},
        keymap_t{SAPP_KEYCODE_CAPS_LOCK, "CAPS"},
        keymap_t{SAPP_KEYCODE_SCROLL_LOCK, "SCLK"},
        keymap_t{SAPP_KEYCODE_NUM_LOCK, "NMLK"},
        keymap_t{SAPP_KEYCODE_PRINT_SCREEN, "PRSC"},
        keymap_t{SAPP_KEYCODE_PAUSE, "PAUS"},
        keymap_t{SAPP_KEYCODE_F1, "FK01"},
        keymap_t{SAPP_KEYCODE_F2, "FK02"},
        keymap_t{SAPP_KEYCODE_F3, "FK03"},
        keymap_t{SAPP_KEYCODE_F4, "FK04"},
        keymap_t{SAPP_KEYCODE_F5, "FK05"},
        keymap_t{SAPP_KEYCODE_F6, "FK06"},
        keymap_t{SAPP_KEYCODE_F7, "FK07"},
        keymap_t{SAPP_KEYCODE_F8, "FK08"},
        keymap_t{SAPP_KEYCODE_F9, "FK09"},
        keymap_t{SAPP_KEYCODE_F10, "FK10"},
        keymap_t{SAPP_KEYCODE_F11, "FK11"},
        keymap_t{SAPP_KEYCODE_F12, "FK12"},
        keymap_t{SAPP_KEYCODE_F13, "FK13"},
        keymap_t{SAPP_KEYCODE_F14, "FK14"},
        keymap_t{SAPP_KEYCODE_F15, "FK15"},
        keymap_t{SAPP_KEYCODE_F16, "FK16"},
        keymap_t{SAPP_KEYCODE_F17, "FK17"},
        keymap_t{SAPP_KEYCODE_F18, "FK18"},
        keymap_t{SAPP_KEYCODE_F19, "FK19"},
        keymap_t{SAPP_KEYCODE_F20, "FK20"},
        keymap_t{SAPP_KEYCODE_F21, "FK21"},
        keymap_t{SAPP_KEYCODE_F22, "FK22"},
        keymap_t{SAPP_KEYCODE_F23, "FK23"},
        keymap_t{SAPP_KEYCODE_F24, "FK24"},
        keymap_t{SAPP_KEYCODE_F25, "FK25"},
        keymap_t{SAPP_KEYCODE_KP_0, "KP0"},
        keymap_t{SAPP_KEYCODE_KP_1, "KP1"},
        keymap_t{SAPP_KEYCODE_KP_2, "KP2"},
        keymap_t{SAPP_KEYCODE_KP_3, "KP3"},
        keymap_t{SAPP_KEYCODE_KP_4, "KP4"},
        keymap_t{SAPP_KEYCODE_KP_5, "KP5"},
        keymap_t{SAPP_KEYCODE_KP_6, "KP6"},
        keymap_t{SAPP_KEYCODE_KP_7, "KP7"},
        keymap_t{SAPP_KEYCODE_KP_8, "KP8"},
        keymap_t{SAPP_KEYCODE_KP_9, "KP9"},
        keymap_t{SAPP_KEYCODE_KP_DECIMAL, "KPDL"},
        keymap_t{SAPP_KEYCODE_KP_DIVIDE, "KPDV"},
        keymap_t{SAPP_KEYCODE_KP_MULTIPLY, "KPMU"},
        keymap_t{SAPP_KEYCODE_KP_SUBTRACT, "KPSU"},
        keymap_t{SAPP_KEYCODE_KP_ADD, "KPAD"},
        keymap_t{SAPP_KEYCODE_KP_ENTER, "KPEN"},
        keymap_t{SAPP_KEYCODE_KP_EQUAL, "KPEQ"},
        keymap_t{SAPP_KEYCODE_LEFT_SHIFT, "LFSH"},
        keymap_t{SAPP_KEYCODE_LEFT_CONTROL, "LCTL"},
        keymap_t{SAPP_KEYCODE_LEFT_ALT, "LALT"},
        keymap_t{SAPP_KEYCODE_LEFT_SUPER, "LWIN"},
        keymap_t{SAPP_KEYCODE_RIGHT_SHIFT, "RTSH"},
        keymap_t{SAPP_KEYCODE_RIGHT_CONTROL, "RCTL"},
        keymap_t{SAPP_KEYCODE_RIGHT_ALT, "RALT"},
        keymap_t{SAPP_KEYCODE_RIGHT_ALT, "LVL3"},
        keymap_t{SAPP_KEYCODE_RIGHT_ALT, "MDSW"},
        keymap_t{SAPP_KEYCODE_RIGHT_SUPER, "RWIN"},
        keymap_t{SAPP_KEYCODE_MENU, "MENU"},
    };
    var num_keymap_items = cast(i32, sizeof(keymap) / sizeof(keymap[0]));
    for i32 scancode = scancode_min; cast(i64, desc.names.keys) != 0 && scancode <= scancode_max; scancode++ {
        sapp_keycode key = SAPP_KEYCODE_INVALID;
        for i32 i = 0; i < num_keymap_items; i++ {
            if strncmp(desc.names.keys[scancode].name, keymap[i].name, cast(u64, XkbKeyNameLength)) == 0 {
                key = keymap[i].key;
                break;
            }
        }
        for i32 i = 0; i < cast(i32, desc.names.num_key_aliases); i++ {
            if key != SAPP_KEYCODE_INVALID {
                break;
            }
            if strncmp(desc.names.key_aliases[i].real, desc.names.keys[scancode].name, cast(u64, XkbKeyNameLength)) != 0 {
                continue;
            }
            for i32 j = 0; j < num_keymap_items; j++ {
                if strncmp(desc.names.key_aliases[i].alias, keymap[j].name, cast(u64, XkbKeyNameLength)) == 0 {
                    key = keymap[j].key;
                    break;
                }
            }
        }
        _sapp.keycodes[scancode] = key;
    }
    XkbFreeNames(desc, 1 << 2, True);
    XkbFreeKeyboard(desc, 0, True);
    i32 width = 0;
    KeySym* keysyms = XGetKeyboardMapping(_sapp.x11.display, scancode_min, scancode_max - scancode_min + 1, &width);
    for i32 scancode = scancode_min; scancode <= scancode_max; scancode++ {
        if _sapp.keycodes[scancode] == SAPP_KEYCODE_INVALID {
            var base = cast(u64, (scancode - scancode_min) * width);
            _sapp.keycodes[scancode] = _sapp_x11_translate_keysyms(&keysyms[base], width);
        }
    }
    XFree(keysyms);
}

void _sapp_x11_query_system_dpi() {
    bool dpi_ok = false;
    u8* rms = XResourceManagerString(_sapp.x11.display);
    if rms != null {
        XrmDatabase db = XrmGetStringDatabase(rms);
        if db != null {
            noinit XrmValue value;
            u8* type = null;
            if XrmGetResource(db, "Xft.dpi", "Xft.Dpi", &type, &value) != 0 {
                if type && strcmp(type, "String") == 0 {
                    _sapp.x11.dpi = cast(f32, atof(value.addr));
                    dpi_ok = true;
                }
            }
            XrmDestroyDatabase(db);
        }
    }
    if dpi_ok == 0 {
        _sapp.x11.dpi = 96.0f;
        _sapp_log(SAPP_LOGITEM_LINUX_X11_QUERY_SYSTEM_DPI_FAILED, 2, null, 3248);
    }
}

bool _sapp_glx_has_ext(u8* ext, u8* extensions) {
    assert(cast(i64, ext));
    u8* start = extensions;
    while true {
        u8* where = strstr(start, ext);
        if where == null {
            return false;
        }
        u8* terminator = where + strlen(ext);
        if where == start || *(where - 1) == 32 {
            if *terminator == 32 || *terminator == 0 {
                break;
            }
        }
        start = terminator;
    }
    return true;
}

bool _sapp_glx_extsupported(u8* ext, u8* extensions) {
    if extensions != null {
        return _sapp_glx_has_ext(ext, extensions);
    } else {
        return false;
    }
}

void* _sapp_glx_getprocaddr(u8* procname) {
    if _sapp.glx.GetProcAddress != null {
        return cast(void*, _sapp.glx.GetProcAddress(procname));
    } else if _sapp.glx.GetProcAddressARB != null {
        return cast(void*, _sapp.glx.GetProcAddressARB(procname));
    } else {
        return dlsym(_sapp.glx.libgl, procname);
    }
}

void _sapp_glx_init() {
    u8*[3] sonames = {"libGL.so.1", "libGL.so", null};
    for i32 i = 0; sonames[i] != null; i++ {
        _sapp.glx.libgl = dlopen(sonames[i], RTLD_LAZY | RTLD_GLOBAL);
        if _sapp.glx.libgl != null {
            break;
        }
    }
    if _sapp.glx.libgl == null {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_LOAD_LIBGL_FAILED, 0, null, 3246);
    }
    _sapp.glx.GetFBConfigs = cast(PFNGLXGETFBCONFIGSPROC, dlsym(_sapp.glx.libgl, "glXGetFBConfigs"));
    _sapp.glx.GetFBConfigAttrib = cast(PFNGLXGETFBCONFIGATTRIBPROC, dlsym(_sapp.glx.libgl, "glXGetFBConfigAttrib"));
    _sapp.glx.GetClientString = cast(PFNGLXGETCLIENTSTRINGPROC, dlsym(_sapp.glx.libgl, "glXGetClientString"));
    _sapp.glx.QueryExtension = cast(PFNGLXQUERYEXTENSIONPROC, dlsym(_sapp.glx.libgl, "glXQueryExtension"));
    _sapp.glx.QueryVersion = cast(PFNGLXQUERYVERSIONPROC, dlsym(_sapp.glx.libgl, "glXQueryVersion"));
    _sapp.glx.DestroyContext = cast(PFNGLXDESTROYCONTEXTPROC, dlsym(_sapp.glx.libgl, "glXDestroyContext"));
    _sapp.glx.MakeCurrent = cast(PFNGLXMAKECURRENTPROC, dlsym(_sapp.glx.libgl, "glXMakeCurrent"));
    _sapp.glx.SwapBuffers = cast(PFNGLXSWAPBUFFERSPROC, dlsym(_sapp.glx.libgl, "glXSwapBuffers"));
    _sapp.glx.QueryExtensionsString = cast(PFNGLXQUERYEXTENSIONSSTRINGPROC, dlsym(_sapp.glx.libgl, "glXQueryExtensionsString"));
    _sapp.glx.CreateWindow = cast(PFNGLXCREATEWINDOWPROC, dlsym(_sapp.glx.libgl, "glXCreateWindow"));
    _sapp.glx.DestroyWindow = cast(PFNGLXDESTROYWINDOWPROC, dlsym(_sapp.glx.libgl, "glXDestroyWindow"));
    _sapp.glx.GetProcAddress = cast(PFNGLXGETPROCADDRESSPROC, dlsym(_sapp.glx.libgl, "glXGetProcAddress"));
    _sapp.glx.GetProcAddressARB = cast(PFNGLXGETPROCADDRESSPROC, dlsym(_sapp.glx.libgl, "glXGetProcAddressARB"));
    _sapp.glx.GetVisualFromFBConfig = cast(PFNGLXGETVISUALFROMFBCONFIGPROC, dlsym(_sapp.glx.libgl, "glXGetVisualFromFBConfig"));
    if !_sapp.glx.GetFBConfigs || !_sapp.glx.GetFBConfigAttrib || !_sapp.glx.GetClientString || !_sapp.glx.QueryExtension || !_sapp.glx.QueryVersion || !_sapp.glx.DestroyContext || !_sapp.glx.MakeCurrent || !_sapp.glx.SwapBuffers || !_sapp.glx.QueryExtensionsString || !_sapp.glx.CreateWindow || !_sapp.glx.DestroyWindow || !_sapp.glx.GetProcAddress || !_sapp.glx.GetProcAddressARB || !_sapp.glx.GetVisualFromFBConfig {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_LOAD_ENTRY_POINTS_FAILED, 0, null, 3246);
    }
    if _sapp.glx.QueryExtension(_sapp.x11.display, &_sapp.glx.error_base, &_sapp.glx.event_base) == 0 {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_EXTENSION_NOT_FOUND, 0, null, 3246);
    }
    if _sapp.glx.QueryVersion(_sapp.x11.display, &_sapp.glx.major, &_sapp.glx.minor) == 0 {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_QUERY_VERSION_FAILED, 0, null, 3246);
    }
    if _sapp.glx.major == 1 && _sapp.glx.minor < 3 {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_VERSION_TOO_LOW, 0, null, 3246);
    }
    u8* exts = _sapp.glx.QueryExtensionsString(_sapp.x11.display, _sapp.x11.screen);
    if _sapp_glx_extsupported("GLX_EXT_swap_control", exts) != 0 {
        _sapp.glx.SwapIntervalEXT = cast(PFNGLXSWAPINTERVALEXTPROC, _sapp_glx_getprocaddr("glXSwapIntervalEXT"));
        _sapp.glx.EXT_swap_control = null != _sapp.glx.SwapIntervalEXT;
    }
    if _sapp_glx_extsupported("GLX_MESA_swap_control", exts) != 0 {
        _sapp.glx.SwapIntervalMESA = cast(PFNGLXSWAPINTERVALMESAPROC, _sapp_glx_getprocaddr("glXSwapIntervalMESA"));
        _sapp.glx.MESA_swap_control = null != _sapp.glx.SwapIntervalMESA;
    }
    _sapp.glx.ARB_multisample = _sapp_glx_extsupported("GLX_ARB_multisample", exts);
    _sapp.glx.ARB_framebuffer_srgb = _sapp_glx_extsupported("GLX_ARB_framebuffer_sRGB", exts);
    if _sapp_glx_extsupported("GLX_ARB_create_context", exts) != 0 {
        _sapp.glx.CreateContextAttribsARB = cast(PFNGLXCREATECONTEXTATTRIBSARBPROC, _sapp_glx_getprocaddr("glXCreateContextAttribsARB"));
        _sapp.glx.ARB_create_context = null != _sapp.glx.CreateContextAttribsARB;
    }
    _sapp.glx.ARB_create_context_profile = _sapp_glx_extsupported("GLX_ARB_create_context_profile", exts);
}

i32 _sapp_glx_attrib(GLXFBConfig fbconfig, i32 attrib) {
    i32 value;
    _sapp.glx.GetFBConfigAttrib(_sapp.x11.display, fbconfig, attrib, &value);
    return value;
}

GLXFBConfig _sapp_glx_choosefbconfig() {
    GLXFBConfig* native_configs;
    _sapp_gl_fbconfig* usable_configs;
    _sapp_gl_fbconfig* closest;
    i32 i;
    i32 native_count;
    i32 usable_count;
    u8* vendor;
    bool trust_window_bit = true;
    vendor = _sapp.glx.GetClientString(_sapp.x11.display, 1);
    if vendor && strcmp(vendor, "Chromium") == 0 {
        trust_window_bit = false;
    }
    native_configs = _sapp.glx.GetFBConfigs(_sapp.x11.display, _sapp.x11.screen, &native_count);
    if !native_configs || !native_count {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_NO_GLXFBCONFIGS, 0, null, 3246);
    }
    usable_configs = cast(_sapp_gl_fbconfig*, _sapp_malloc_clear(cast(u64, native_count) * cast(u64, sizeof(_sapp_gl_fbconfig))));
    usable_count = 0;
    for i = 0; i < native_count; i++ {
        GLXFBConfig n = native_configs[i];
        _sapp_gl_fbconfig* u = usable_configs + usable_count;
        _sapp_gl_init_fbconfig(u);
        if 0 == (_sapp_glx_attrib(n, 0x8011) & 0x00000001) {
            continue;
        }
        if 0 == (_sapp_glx_attrib(n, 0x8010) & 0x00000001) {
            if trust_window_bit != 0 {
                continue;
            }
        }
        u.red_bits = _sapp_glx_attrib(n, 8);
        u.green_bits = _sapp_glx_attrib(n, 9);
        u.blue_bits = _sapp_glx_attrib(n, 10);
        u.alpha_bits = _sapp_glx_attrib(n, 11);
        u.depth_bits = _sapp_glx_attrib(n, 12);
        u.stencil_bits = _sapp_glx_attrib(n, 13);
        if _sapp.glx.ARB_multisample != 0 {
            u.samples = _sapp_glx_attrib(n, 0x186a1);
        }
        u.doublebuffer = cast(bool, _sapp_glx_attrib(n, 5));
        if _sapp.glx.ARB_framebuffer_srgb != 0 {
            u.srgb_capable = cast(bool, _sapp_glx_attrib(n, 0x20B2));
        }
        u.handle = cast(u64, n);
        usable_count++;
    }
    bool wants_depth = _sapp.desc.depth_format != SAPP_PIXELFORMAT_NONE;
    bool wants_stencil = _sapp.desc.depth_format == SAPP_PIXELFORMAT_DEPTH_STENCIL;
    bool wants_msaa = _sapp.desc.sample_count > 1 && _sapp.glx.ARB_multisample;
    bool wants_srgb = _sapp.desc.srgb && _sapp.glx.ARB_framebuffer_srgb;
    noinit _sapp_gl_fbconfig desired;
    _sapp_gl_init_fbconfig(&desired);
    desired.red_bits = 8;
    desired.green_bits = 8;
    desired.blue_bits = 8;
    desired.alpha_bits = 8;
    if wants_depth != 0 {
        desired.depth_bits = 24;
    } else {
        desired.depth_bits = 0;
    }
    if wants_stencil != 0 {
        desired.stencil_bits = 8;
    } else {
        desired.stencil_bits = 0;
    }
    desired.doublebuffer = true;
    if wants_msaa != 0 {
        desired.samples = _sapp.desc.sample_count;
    } else {
        desired.samples = 0;
    }
    desired.srgb_capable = wants_srgb;
    closest = _sapp_gl_choose_fbconfig(&desired, usable_configs, usable_count);
    GLXFBConfig result = null;
    if closest != null {
        result = cast(GLXFBConfig, closest.handle);
    }
    XFree(native_configs);
    _sapp_free(usable_configs);
    return result;
}

void _sapp_glx_choose_visual(Visual** visual, i32* depth) {
    GLXFBConfig native = _sapp_glx_choosefbconfig();
    if null == native {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_NO_SUITABLE_GLXFBCONFIG, 0, null, 3246);
    }
    XVisualInfo* result = _sapp.glx.GetVisualFromFBConfig(_sapp.x11.display, native);
    if result == null {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_GET_VISUAL_FROM_FBCONFIG_FAILED, 0, null, 3246);
    }
    *visual = result.visual;
    *depth = result.depth;
    XFree(result);
}

void _sapp_glx_make_current() {
    _sapp.glx.MakeCurrent(_sapp.x11.display, _sapp.glx.window, _sapp.glx.ctx);
    glGetIntegerv(GL_FRAMEBUFFER_BINDING, cast(i32*, &_sapp.gl.framebuffer));
}

void _sapp_glx_create_context() {
    GLXFBConfig native = _sapp_glx_choosefbconfig();
    if null == native {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_NO_SUITABLE_GLXFBCONFIG, 0, null, 3246);
    }
    if (_sapp.glx.ARB_create_context && _sapp.glx.ARB_create_context_profile) == 0 {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_REQUIRED_EXTENSIONS_MISSING, 0, null, 3246);
    }
    _sapp_x11_grab_error_handler();
    i32[10] attribs = {
        0x2091, _sapp.desc.gl.major_version, 0x2092, _sapp.desc.gl.minor_version, 0x9126,
        0x00000001, 0x2094, 0x00000002, 0, 0,
    };
    _sapp.glx.ctx = _sapp.glx.CreateContextAttribsARB(_sapp.x11.display, native, null, True, attribs);
    if _sapp.glx.ctx == null {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_CREATE_CONTEXT_FAILED, 0, null, 3246);
    }
    _sapp_x11_release_error_handler();
    _sapp.glx.window = _sapp.glx.CreateWindow(_sapp.x11.display, native, _sapp.x11.window, null);
    if _sapp.glx.window == 0 {
        _sapp_log(SAPP_LOGITEM_LINUX_GLX_CREATE_WINDOW_FAILED, 0, null, 3246);
    }
    _sapp_glx_make_current();
}

void _sapp_glx_destroy_context() {
    if _sapp.glx.window != 0 {
        _sapp.glx.DestroyWindow(_sapp.x11.display, _sapp.glx.window);
        _sapp.glx.window = 0;
    }
    if _sapp.glx.ctx != null {
        _sapp.glx.DestroyContext(_sapp.x11.display, _sapp.glx.ctx);
        _sapp.glx.ctx = null;
    }
}

void _sapp_glx_swap_buffers() {
    _sapp.glx.SwapBuffers(_sapp.x11.display, _sapp.glx.window);
}

void _sapp_glx_swapinterval(i32 interval) {
    if _sapp.glx.EXT_swap_control != 0 {
        _sapp.glx.SwapIntervalEXT(_sapp.x11.display, _sapp.glx.window, interval);
    } else if _sapp.glx.MESA_swap_control != 0 {
        _sapp.glx.SwapIntervalMESA(interval);
    }
}

void _sapp_x11_send_event(Atom type, i32 a, i32 b, i32 c, i32 d, i32 e) {
    XEvent event;
    event.type = ClientMessage;
    event.xclient.window = _sapp.x11.window;
    event.xclient.format = 32;
    event.xclient.message_type = type;
    event.xclient.data.l[0] = a;
    event.xclient.data.l[1] = b;
    event.xclient.data.l[2] = c;
    event.xclient.data.l[3] = d;
    event.xclient.data.l[4] = e;
    XSendEvent(_sapp.x11.display, _sapp.x11.root, False, SubstructureNotifyMask | SubstructureRedirectMask, &event);
}

bool _sapp_x11_wait_for_event(i32 event_type, f64 timeout_sec, XEvent* out_event) {
    noinit _sapp_timestamp_t ts;
    _sapp_timestamp_init(&ts);
    while XCheckTypedWindowEvent(_sapp.x11.display, _sapp.x11.window, event_type, out_event) == 0 {
        var fd = pollfd{XConnectionNumber(_sapp.x11.display), POLLIN, 0};
        poll(&fd, 1, cast(i32, timeout_sec * 1000.0));
        if _sapp_timestamp_now(&ts) > timeout_sec {
            return false;
        }
    }
    return true;
}

void _sapp_x11_app_event(sapp_event_type type) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        _sapp_call_event(&_sapp.event);
    }
}

void _sapp_x11_update_dimensions(i32 x11_window_width, i32 x11_window_height) {
    f32 window_scale = _sapp.x11.dpi / 96.0f;
    _sapp.window_width = _sapp_roundf_gzero(cast(f32, x11_window_width) / window_scale);
    _sapp.window_height = _sapp_roundf_gzero(cast(f32, x11_window_height) / window_scale);
    i32 cur_fb_width = _sapp.framebuffer_width;
    i32 cur_fb_height = _sapp.framebuffer_height;
    _sapp.framebuffer_width = _sapp_roundf_gzero(cast(f32, _sapp.window_width) * _sapp.dpi_scale);
    _sapp.framebuffer_height = _sapp_roundf_gzero(cast(f32, _sapp.window_height) * _sapp.dpi_scale);
    bool dim_changed = _sapp.framebuffer_width != cur_fb_width || _sapp.framebuffer_height != cur_fb_height;
    if dim_changed != 0 {
        if _sapp.first_frame == 0 {
            _sapp_x11_app_event(SAPP_EVENTTYPE_RESIZED);
        }
    }
}

void _sapp_x11_update_dimensions_from_window_size() {
    noinit XWindowAttributes attribs;
    XGetWindowAttributes(_sapp.x11.display, _sapp.x11.window, &attribs);
    _sapp_x11_update_dimensions(attribs.width, attribs.height);
}

void _sapp_x11_set_fullscreen(bool enable) {
    if _sapp.x11.NET_WM_STATE && _sapp.x11.NET_WM_STATE_FULLSCREEN {
        if enable != 0 {
            i32 _NET_WM_STATE_ADD = 1;
            _sapp_x11_send_event(_sapp.x11.NET_WM_STATE, _NET_WM_STATE_ADD, cast(i32, _sapp.x11.NET_WM_STATE_FULLSCREEN), 0, 1, 0);
        } else {
            i32 _NET_WM_STATE_REMOVE = 0;
            _sapp_x11_send_event(_sapp.x11.NET_WM_STATE, _NET_WM_STATE_REMOVE, cast(i32, _sapp.x11.NET_WM_STATE_FULLSCREEN), 0, 1, 0);
        }
    }
    XFlush(_sapp.x11.display);
}

void _sapp_x11_create_hidden_cursor() {
    assert(0 == _sapp.x11.hidden_cursor);
    i32 w = 16;
    i32 h = 16;
    XcursorImage* img = XcursorImageCreate(w, h);
    assert(img && img.width == 16 && img.height == 16 && img.pixels);
    img.xhot = 0;
    img.yhot = 0;
    u64 num_bytes = cast(u64, w * h) * cast(u64, sizeof(XcursorPixel));
    _sapp_clear(img.pixels, num_bytes);
    _sapp.x11.hidden_cursor = XcursorImageLoadCursor(_sapp.x11.display, img);
    XcursorImageDestroy(img);
}

void _sapp_x11_create_standard_cursor(sapp_mouse_cursor cursor, u8* name, u8* theme, i32 size, u32 fallback_native) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    assert(cast(i64, _sapp.x11.display));
    if theme != null {
        XcursorImage* img = XcursorLibraryLoadImage(name, theme, size);
        if img != null {
            _sapp.x11.standard_cursors[cursor] = XcursorImageLoadCursor(_sapp.x11.display, img);
            XcursorImageDestroy(img);
        }
    }
    if 0 == _sapp.x11.standard_cursors[cursor] {
        _sapp.x11.standard_cursors[cursor] = XCreateFontCursor(_sapp.x11.display, fallback_native);
    }
}

void _sapp_x11_create_standard_cursors() {
    assert(cast(i64, _sapp.x11.display));
    u8* cursor_theme = XcursorGetTheme(_sapp.x11.display);
    i32 size = XcursorGetDefaultSize(_sapp.x11.display);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_ARROW, "default", cursor_theme, size, XC_left_ptr);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_IBEAM, "text", cursor_theme, size, XC_xterm);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_CROSSHAIR, "crosshair", cursor_theme, size, XC_crosshair);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_POINTING_HAND, "pointer", cursor_theme, size, XC_hand2);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_RESIZE_EW, "ew-resize", cursor_theme, size, XC_sb_h_double_arrow);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_RESIZE_NS, "ns-resize", cursor_theme, size, XC_sb_v_double_arrow);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_RESIZE_NWSE, "nwse-resize", cursor_theme, size, 0);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_RESIZE_NESW, "nesw-resize", cursor_theme, size, 0);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_RESIZE_ALL, "all-scroll", cursor_theme, size, XC_fleur);
    _sapp_x11_create_standard_cursor(SAPP_MOUSECURSOR_NOT_ALLOWED, "not-allowed", cursor_theme, size, 0);
    _sapp_x11_create_hidden_cursor();
}

void _sapp_x11_destroy_standard_cursors() {
    assert(cast(i64, _sapp.x11.display));
    if _sapp.x11.hidden_cursor != 0 {
        XFreeCursor(_sapp.x11.display, _sapp.x11.hidden_cursor);
        _sapp.x11.hidden_cursor = 0;
    }
    for i32 i = 0; i < _SAPP_MOUSECURSOR_NUM; i++ {
        if _sapp.x11.standard_cursors[i] != 0 {
            XFreeCursor(_sapp.x11.display, _sapp.x11.standard_cursors[i]);
            _sapp.x11.standard_cursors[i] = 0;
        }
    }
}

bool _sapp_x11_make_custom_mouse_cursor(sapp_mouse_cursor cursor, sapp_image_desc* desc) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    assert(0 == _sapp.x11.custom_cursors[cursor]);
    XcursorImage* img = XcursorImageCreate(desc.width, desc.height);
    assert(img && cast(i32, img.width) == desc.width && cast(i32, img.height) == desc.height && img.pixels);
    img.xhot = cast(XcursorDim, desc.cursor_hotspot_x);
    img.yhot = cast(XcursorDim, desc.cursor_hotspot_y);
    u64 dest_num_bytes = cast(u64, img.width * img.height) * cast(u64, sizeof(XcursorPixel));
    assert(dest_num_bytes == desc.pixels.size);
    for u64 i = 0; i < dest_num_bytes; i += 4 {
        cast(u8*, img.pixels)[i + 0] = cast(u8*, desc.pixels.ptr)[i + 2];
        cast(u8*, img.pixels)[i + 1] = cast(u8*, desc.pixels.ptr)[i + 1];
        cast(u8*, img.pixels)[i + 2] = cast(u8*, desc.pixels.ptr)[i + 0];
        cast(u8*, img.pixels)[i + 3] = cast(u8*, desc.pixels.ptr)[i + 3];
    }
    _sapp.x11.custom_cursors[cursor] = XcursorImageLoadCursor(_sapp.x11.display, img);
    XcursorImageDestroy(img);
    return 0 != _sapp.x11.custom_cursors[cursor];
}

void _sapp_x11_destroy_custom_mouse_cursor(sapp_mouse_cursor cursor) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    Cursor xcursor = _sapp.x11.custom_cursors[cursor];
    _sapp.x11.custom_cursors[cursor] = 0;
    assert(cast(i64, xcursor));
    XFreeCursor(_sapp.x11.display, xcursor);
}

void _sapp_x11_toggle_fullscreen() {
    _sapp.fullscreen = !_sapp.fullscreen;
    _sapp_x11_set_fullscreen(_sapp.fullscreen);
    _sapp_x11_update_dimensions_from_window_size();
}

void _sapp_x11_update_cursor(sapp_mouse_cursor cursor, bool shown) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    if shown != 0 {
        if _sapp.custom_cursor_bound[cursor] != 0 {
            Cursor xcursor = _sapp.x11.custom_cursors[cursor];
            assert(0 != xcursor);
            XDefineCursor(_sapp.x11.display, _sapp.x11.window, xcursor);
        } else if _sapp.x11.standard_cursors[cursor] != 0 {
            XDefineCursor(_sapp.x11.display, _sapp.x11.window, _sapp.x11.standard_cursors[cursor]);
        } else {
            XUndefineCursor(_sapp.x11.display, _sapp.x11.window);
        }
    } else {
        XDefineCursor(_sapp.x11.display, _sapp.x11.window, _sapp.x11.hidden_cursor);
    }
    XFlush(_sapp.x11.display);
}

void _sapp_x11_lock_mouse(bool lock) {
    if lock == _sapp.mouse.locked {
        return;
    }
    _sapp.mouse.dx = 0.0f;
    _sapp.mouse.dy = 0.0f;
    _sapp.mouse.locked = lock;
    if _sapp.mouse.locked != 0 {
        if _sapp.x11.xi.available != 0 {
            noinit XIEventMask em;
            u8[3] mask;
            em.deviceid = XIAllMasterDevices;
            em.mask_len = cast(i32, sizeof(mask));
            em.mask = mask;
            mask[XI_RawMotion >> 3] |= cast(u8, 1 << (XI_RawMotion & 7));
            XISelectEvents(_sapp.x11.display, _sapp.x11.root, &em, 1);
        }
        XGrabPointer(_sapp.x11.display, _sapp.x11.window, True, ButtonPressMask | ButtonReleaseMask | PointerMotionMask, GrabModeAsync, GrabModeAsync, _sapp.x11.window, _sapp.x11.hidden_cursor, CurrentTime);
    } else {
        if _sapp.x11.xi.available != 0 {
            noinit XIEventMask em;
            u8[1] mask;
            em.deviceid = XIAllMasterDevices;
            em.mask_len = cast(i32, sizeof(mask));
            em.mask = mask;
            XISelectEvents(_sapp.x11.display, _sapp.x11.root, &em, 1);
        }
        XWarpPointer(_sapp.x11.display, None, _sapp.x11.window, 0, 0, 0, 0, cast(i32, _sapp.mouse.x), cast(i32, _sapp.mouse.y));
        XUngrabPointer(_sapp.x11.display, CurrentTime);
    }
    XFlush(_sapp.x11.display);
}

void _sapp_x11_set_clipboard_string(u8* str_var) {
    assert(_sapp.clipboard.enabled && _sapp.clipboard.buffer);
    _sapp.clipboard.buffer[0] = 0;
    if strlen(str_var) >= cast(u64, _sapp.clipboard.buf_size) {
        _sapp_log(SAPP_LOGITEM_CLIPBOARD_STRING_TOO_BIG, 1, null, 3247);
    }
    XSetSelectionOwner(_sapp.x11.display, _sapp.x11.CLIPBOARD, _sapp.x11.window, CurrentTime);
    if XGetSelectionOwner(_sapp.x11.display, _sapp.x11.CLIPBOARD) != _sapp.x11.window {
        _sapp_log(SAPP_LOGITEM_LINUX_X11_FAILED_TO_BECOME_OWNER_OF_CLIPBOARD, 1, null, 3247);
    }
}

u8* _sapp_x11_get_clipboard_string() {
    assert(_sapp.clipboard.enabled && _sapp.clipboard.buffer);
    Atom none = XInternAtom(_sapp.x11.display, "SAPP_SELECTION", False);
    Atom incremental = XInternAtom(_sapp.x11.display, "INCR", False);
    if XGetSelectionOwner(_sapp.x11.display, _sapp.x11.CLIPBOARD) == _sapp.x11.window {
        return _sapp.clipboard.buffer;
    }
    XConvertSelection(_sapp.x11.display, _sapp.x11.CLIPBOARD, _sapp.x11.UTF8_STRING, none, _sapp.x11.window, CurrentTime);
    XEvent event;
    if _sapp_x11_wait_for_event(SelectionNotify, 0.1, &event) == 0 {
        return _sapp.clipboard.buffer;
    }
    if event.xselection.property == None {
        return _sapp.clipboard.buffer;
    }
    u8* data = null;
    Atom actualType;
    i32 actualFormat;
    u64 itemCount;
    u64 bytesAfter;
    bool ret = XGetWindowProperty(_sapp.x11.display, event.xselection.requestor, event.xselection.property, 0, LONG_MAX, True, _sapp.x11.UTF8_STRING, &actualType, &actualFormat, &itemCount, &bytesAfter, cast(u8**, &data)) != 0;
    if ret != Success || data == null {
        if data != null {
            XFree(data);
        }
        return _sapp.clipboard.buffer;
    }
    if actualType == incremental || itemCount >= cast(u64, _sapp.clipboard.buf_size) {
        _sapp_log(SAPP_LOGITEM_CLIPBOARD_STRING_TOO_BIG, 1, null, 3247);
        XFree(data);
        return _sapp.clipboard.buffer;
    }
    _sapp_strcpy(data, _sapp.clipboard.buffer, cast(u64, _sapp.clipboard.buf_size));
    XFree(data);
    return _sapp.clipboard.buffer;
}

void _sapp_x11_update_window_title() {
    Xutf8SetWMProperties(_sapp.x11.display, _sapp.x11.window, _sapp.window_title, _sapp.window_title, null, 0, null, null, null);
    XChangeProperty(_sapp.x11.display, _sapp.x11.window, _sapp.x11.NET_WM_NAME, _sapp.x11.UTF8_STRING, 8, PropModeReplace, cast(u8*, _sapp.window_title), strlen(_sapp.window_title));
    XChangeProperty(_sapp.x11.display, _sapp.x11.window, _sapp.x11.NET_WM_ICON_NAME, _sapp.x11.UTF8_STRING, 8, PropModeReplace, cast(u8*, _sapp.window_title), strlen(_sapp.window_title));
    XFlush(_sapp.x11.display);
}

void _sapp_x11_set_icon(sapp_icon_desc* icon_desc, i32 num_images) {
    assert(num_images > 0 && num_images <= SAPP_MAX_ICONIMAGES);
    i32 long_count = 0;
    for i32 i = 0; i < num_images; i++ {
        sapp_image_desc* img_desc = &icon_desc.images[i];
        long_count += 2 + img_desc.width * img_desc.height;
    }
    var icon_data = cast(i64*, _sapp_malloc_clear(cast(u64, long_count) * cast(u64, sizeof(i64))));
    assert(cast(i64, icon_data));
    i64* dst = icon_data;
    for i32 img_index = 0; img_index < num_images; img_index++ {
        sapp_image_desc* img_desc = &icon_desc.images[img_index];
        var src = cast(u8*, img_desc.pixels.ptr);
        *dst++ = img_desc.width;
        *dst++ = img_desc.height;
        i32 num_pixels = img_desc.width * img_desc.height;
        for i32 pixel_index = 0; pixel_index < num_pixels; pixel_index++ {
            *dst++ = cast(i64, src[pixel_index * 4 + 0]) << 16 | cast(i64, src[pixel_index * 4 + 1]) << 8 | cast(i64, src[pixel_index * 4 + 2]) << 0 | cast(i64, src[pixel_index * 4 + 3]) << 24;
        }
    }
    XChangeProperty(_sapp.x11.display, _sapp.x11.window, _sapp.x11.NET_WM_ICON, XA_CARDINAL, 32, PropModeReplace, cast(u8*, icon_data), long_count);
    _sapp_free(icon_data);
    XFlush(_sapp.x11.display);
}

void _sapp_x11_create_window(Visual* visual_or_null, i32 depth) {
    Visual* visual = visual_or_null;
    if null == visual_or_null {
        visual = DefaultVisual(_sapp.x11.display, _sapp.x11.screen);
        depth = DefaultDepth(_sapp.x11.display, _sapp.x11.screen);
    }
    _sapp.x11.colormap = XCreateColormap(_sapp.x11.display, _sapp.x11.root, visual, AllocNone);
    XSetWindowAttributes wa;
    u32 wamask = CWBorderPixel | CWColormap | CWEventMask;
    wa.colormap = _sapp.x11.colormap;
    wa.border_pixel = 0;
    wa.event_mask = StructureNotifyMask | KeyPressMask | KeyReleaseMask | PointerMotionMask | ButtonPressMask | ButtonReleaseMask | ExposureMask | FocusChangeMask | VisibilityChangeMask | EnterWindowMask | LeaveWindowMask | PropertyChangeMask;
    i32 display_width = DisplayWidth(_sapp.x11.display, _sapp.x11.screen);
    i32 display_height = DisplayHeight(_sapp.x11.display, _sapp.x11.screen);
    f32 window_scale = _sapp.x11.dpi / 96.0f;
    i32 x11_window_width = _sapp_roundf_gzero(cast(f32, _sapp.window_width) * window_scale);
    i32 x11_window_height = _sapp_roundf_gzero(cast(f32, _sapp.window_height) * window_scale);
    if 0 == _sapp.window_width {
        x11_window_width = display_width * 4 / 5;
    }
    if 0 == _sapp.window_height {
        x11_window_height = display_height * 4 / 5;
    }
    _sapp_x11_grab_error_handler();
    _sapp.x11.window = XCreateWindow(_sapp.x11.display, _sapp.x11.root, 0, 0, cast(u32, x11_window_width), cast(u32, x11_window_height), 0, depth, InputOutput, visual, wamask, &wa);
    _sapp_x11_release_error_handler();
    if _sapp.x11.window == 0 {
        _sapp_log(SAPP_LOGITEM_LINUX_X11_CREATE_WINDOW_FAILED, 0, null, 3246);
    }
    Atom[1] protocols = {_sapp.x11.WM_DELETE_WINDOW};
    XSetWMProtocols(_sapp.x11.display, _sapp.x11.window, protocols, 1);
    XSizeHints* hints = XAllocSizeHints();
    hints.flags = PWinGravity;
    hints.win_gravity = CenterGravity;
    XSetWMNormalHints(_sapp.x11.display, _sapp.x11.window, hints);
    XFree(hints);
    if _sapp.drop.enabled != 0 {
        Atom version = 5;
        XChangeProperty(_sapp.x11.display, _sapp.x11.window, _sapp.x11.xdnd.XdndAware, XA_ATOM, 32, PropModeReplace, cast(u8*, &version), 1);
    }
    _sapp_x11_update_window_title();
    _sapp_x11_update_dimensions_from_window_size();
}

void _sapp_x11_destroy_window() {
    if _sapp.x11.window != 0 {
        XUnmapWindow(_sapp.x11.display, _sapp.x11.window);
        XDestroyWindow(_sapp.x11.display, _sapp.x11.window);
        _sapp.x11.window = 0;
    }
    if _sapp.x11.colormap != 0 {
        XFreeColormap(_sapp.x11.display, _sapp.x11.colormap);
        _sapp.x11.colormap = 0;
    }
    XFlush(_sapp.x11.display);
}

bool _sapp_x11_window_visible() {
    noinit XWindowAttributes wa;
    XGetWindowAttributes(_sapp.x11.display, _sapp.x11.window, &wa);
    return wa.map_state == IsViewable;
}

void _sapp_x11_show_window() {
    if _sapp_x11_window_visible() == 0 {
        XMapWindow(_sapp.x11.display, _sapp.x11.window);
        XEvent dummy;
        _sapp_x11_wait_for_event(VisibilityNotify, 0.1, &dummy);
        XRaiseWindow(_sapp.x11.display, _sapp.x11.window);
        XFlush(_sapp.x11.display);
    }
}

void _sapp_x11_hide_window() {
    XUnmapWindow(_sapp.x11.display, _sapp.x11.window);
    XFlush(_sapp.x11.display);
}

u64 _sapp_x11_get_window_property(Window window, Atom property, Atom type, u8** value) {
    Atom actualType;
    i32 actualFormat;
    u64 itemCount;
    u64 bytesAfter;
    XGetWindowProperty(_sapp.x11.display, window, property, 0, LONG_MAX, False, type, &actualType, &actualFormat, &itemCount, &bytesAfter, value);
    return itemCount;
}

i32 _sapp_x11_get_window_state() {
    i32 result = WithdrawnState;
    state_t* state = null;
    if _sapp_x11_get_window_property(_sapp.x11.window, _sapp.x11.WM_STATE, _sapp.x11.WM_STATE, cast(u8**, &state)) >= 2 {
        result = cast(i32, state.state);
    }
    if state != null {
        XFree(state);
    }
    return result;
}

u32 _sapp_x11_key_modifier_bit(sapp_keycode key) {
    switch key {
        case SAPP_KEYCODE_LEFT_SHIFT, SAPP_KEYCODE_RIGHT_SHIFT: {
            return cast(u32, SAPP_MODIFIER_SHIFT);
        }
        case SAPP_KEYCODE_LEFT_CONTROL, SAPP_KEYCODE_RIGHT_CONTROL: {
            return cast(u32, SAPP_MODIFIER_CTRL);
        }
        case SAPP_KEYCODE_LEFT_ALT, SAPP_KEYCODE_RIGHT_ALT: {
            return cast(u32, SAPP_MODIFIER_ALT);
        }
        case SAPP_KEYCODE_LEFT_SUPER, SAPP_KEYCODE_RIGHT_SUPER: {
            return cast(u32, SAPP_MODIFIER_SUPER);
        }
        default: {
            return 0;
        }
    }
}

u32 _sapp_x11_button_modifier_bit(sapp_mousebutton btn) {
    switch btn {
        case SAPP_MOUSEBUTTON_LEFT: {
            return cast(u32, SAPP_MODIFIER_LMB);
        }
        case SAPP_MOUSEBUTTON_RIGHT: {
            return cast(u32, SAPP_MODIFIER_RMB);
        }
        case SAPP_MOUSEBUTTON_MIDDLE: {
            return cast(u32, SAPP_MODIFIER_MMB);
        }
        default: {
            return 0;
        }
    }
}

u32 _sapp_x11_mods(u32 x11_mods) {
    u32 mods = 0;
    if (x11_mods & ShiftMask) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_SHIFT);
    }
    if (x11_mods & ControlMask) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_CTRL);
    }
    if (x11_mods & Mod1Mask) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_ALT);
    }
    if (x11_mods & Mod4Mask) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_SUPER);
    }
    if (x11_mods & Button1Mask) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_LMB);
    }
    if (x11_mods & Button2Mask) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_MMB);
    }
    if (x11_mods & Button3Mask) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_RMB);
    }
    return mods;
}

sapp_mousebutton _sapp_x11_translate_button(XEvent* event) {
    switch event.xbutton.button {
        case Button1: {
            return SAPP_MOUSEBUTTON_LEFT;
        }
        case Button2: {
            return SAPP_MOUSEBUTTON_MIDDLE;
        }
        case Button3: {
            return SAPP_MOUSEBUTTON_RIGHT;
        }
        default: {
            return SAPP_MOUSEBUTTON_INVALID;
        }
    }
}

void _sapp_x11_mouse_update(i32 x, i32 y, bool clear_dxdy) {
    if _sapp.mouse.locked == 0 {
        var new_x = cast(f32, x);
        var new_y = cast(f32, y);
        if clear_dxdy != 0 {
            _sapp.mouse.dx = 0.0f;
            _sapp.mouse.dy = 0.0f;
        } else if _sapp.mouse.pos_valid != 0 {
            _sapp.mouse.dx = new_x - _sapp.mouse.x;
            _sapp.mouse.dy = new_y - _sapp.mouse.y;
        }
        _sapp.mouse.x = new_x;
        _sapp.mouse.y = new_y;
        _sapp.mouse.pos_valid = true;
    }
}

void _sapp_x11_mouse_event(sapp_event_type type, sapp_mousebutton btn, u32 mods) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        _sapp.event.mouse_button = btn;
        _sapp.event.modifiers = mods;
        _sapp_call_event(&_sapp.event);
    }
}

void _sapp_x11_scroll_event(f32 x, f32 y, u32 mods) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(SAPP_EVENTTYPE_MOUSE_SCROLL);
        _sapp.event.modifiers = mods;
        _sapp.event.scroll_x = x;
        _sapp.event.scroll_y = y;
        _sapp_call_event(&_sapp.event);
    }
}

void _sapp_x11_key_event(sapp_event_type type, sapp_keycode key, bool repeat, u32 mods) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        _sapp.event.key_code = key;
        _sapp.event.key_repeat = repeat;
        _sapp.event.modifiers = mods;
        _sapp_call_event(&_sapp.event);
        if _sapp.clipboard.enabled && type == SAPP_EVENTTYPE_KEY_DOWN && _sapp.event.modifiers == cast(u32, SAPP_MODIFIER_CTRL) && _sapp.event.key_code == SAPP_KEYCODE_V {
            _sapp_init_event(SAPP_EVENTTYPE_CLIPBOARD_PASTED);
            _sapp_call_event(&_sapp.event);
        }
    }
}

void _sapp_x11_char_event(u32 chr, bool repeat, u32 mods) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(SAPP_EVENTTYPE_CHAR);
        _sapp.event.char_code = chr;
        _sapp.event.key_repeat = repeat;
        _sapp.event.modifiers = mods;
        _sapp_call_event(&_sapp.event);
    }
}

sapp_keycode _sapp_x11_translate_key(i32 scancode) {
    if scancode >= 0 && scancode < 256 {
        return _sapp.keycodes[scancode];
    } else {
        return SAPP_KEYCODE_INVALID;
    }
}

i32 _sapp_x11_keysym_to_unicode(KeySym keysym) {
    i32 min = 0;
    var max = cast(i32, sizeof(_sapp_x11_keysymtab) / sizeof(_sapp_x11_codepair) - 1);
    i32 mid;
    if keysym >= 0x0020 && keysym <= 0x007e || keysym >= 0x00a0 && keysym <= 0x00ff {
        return cast(i32, keysym);
    }
    if (keysym & 0xff000000) == 0x01000000 {
        return cast(i32, keysym & 0x00ffffff);
    }
    while max >= min {
        mid = (min + max) / 2;
        if _sapp_x11_keysymtab[mid].keysym < keysym {
            min = mid + 1;
        } else if _sapp_x11_keysymtab[mid].keysym > keysym {
            max = mid - 1;
        } else {
            return cast(i32, _sapp_x11_keysymtab[mid].ucs);
        }
    }
    return -1;
}

bool _sapp_x11_keypress_repeat(i32 keycode) {
    bool repeat = false;
    if keycode >= 0 && keycode < 256 {
        repeat = _sapp.x11.key_repeat[keycode];
        _sapp.x11.key_repeat[keycode] = true;
    }
    return repeat;
}

void _sapp_x11_keyrelease_repeat(i32 keycode) {
    if keycode >= 0 && keycode < 256 {
        _sapp.x11.key_repeat[keycode] = false;
    }
}

bool _sapp_x11_parse_dropped_files_list(u8* src) {
    assert(cast(i64, src));
    assert(cast(i64, _sapp.drop.buffer));
    _sapp_clear_drop_buffer();
    _sapp.drop.num_files = 0;
    bool err = false;
    i32 src_count = 0;
    u8 src_chr = 0;
    u8* dst_ptr = _sapp.drop.buffer;
    u8* dst_end_ptr = dst_ptr + (_sapp.drop.max_path_length - 1);
    while true {
        src_chr = *src++;
        if 0 != src_chr == 0 {
            break;
        }
        src_count++;
        u8 dst_chr = 0;
        if src_count <= 7 {
            if src_count == 1 && src_chr != 102 || src_count == 2 && src_chr != 105 || src_count == 3 && src_chr != 108 || src_count == 4 && src_chr != 101 || src_count == 5 && src_chr != 58 || src_count == 6 && src_chr != 47 || src_count == 7 && src_chr != 47 {
                _sapp_log(SAPP_LOGITEM_LINUX_X11_DROPPED_FILE_URI_WRONG_SCHEME, 1, null, 3247);
                err = true;
                break;
            }
        } else if src_chr == 13 {
        } else if src_chr == 10 {
            src_count = 0;
            _sapp.drop.num_files++;
            if _sapp.drop.num_files >= _sapp.drop.max_files {
                break;
            }
            dst_ptr = _sapp.drop.buffer + _sapp.drop.num_files * _sapp.drop.max_path_length;
            dst_end_ptr = dst_ptr + (_sapp.drop.max_path_length - 1);
        } else if src_chr == 37 && src[0] && src[1] {
            u8[3] digits = {src[0], src[1], 0};
            src += 2;
            dst_chr = cast(u8, strtol(digits, null, 16));
        } else {
            dst_chr = src_chr;
        }
        if dst_chr != 0 {
            if dst_ptr < dst_end_ptr {
                *dst_ptr++ = dst_chr;
            } else {
                _sapp_log(SAPP_LOGITEM_DROPPED_FILE_PATH_TOO_LONG, 1, null, 3247);
                err = true;
                break;
            }
        }
    }
    if err != 0 {
        _sapp_clear_drop_buffer();
        _sapp.drop.num_files = 0;
        return false;
    } else {
        return true;
    }
}

void _sapp_x11_on_genericevent(XEvent* event) {
    if _sapp.mouse.locked && _sapp.x11.xi.available {
        if event.xcookie.extension == _sapp.x11.xi.major_opcode {
            if XGetEventData(_sapp.x11.display, &event.xcookie) != 0 {
                if event.xcookie.evtype == XI_RawMotion {
                    var re = cast(XIRawEvent*, event.xcookie.data);
                    if re.valuators.mask_len != 0 {
                        f64* values = re.raw_values;
                        if (re.valuators.mask[0 >> 3] & 1 << (0 & 7)) != 0 {
                            _sapp.mouse.dx = cast(f32, *values);
                            values++;
                        }
                        if (re.valuators.mask[1 >> 3] & 1 << (1 & 7)) != 0 {
                            _sapp.mouse.dy = cast(f32, *values);
                        }
                        _sapp_x11_mouse_event(SAPP_EVENTTYPE_MOUSE_MOVE, SAPP_MOUSEBUTTON_INVALID, _sapp_x11_mods(event.xmotion.state));
                    }
                }
                XFreeEventData(_sapp.x11.display, &event.xcookie);
            }
        }
    }
}

void _sapp_x11_on_focusin(XEvent* event) {
    if event.xfocus.mode != NotifyGrab && event.xfocus.mode != NotifyUngrab {
        _sapp_x11_app_event(SAPP_EVENTTYPE_FOCUSED);
    }
}

void _sapp_x11_on_focusout(XEvent* event) {
    if _sapp.mouse.locked != 0 {
        _sapp_x11_lock_mouse(false);
    }
    if event.xfocus.mode != NotifyGrab && event.xfocus.mode != NotifyUngrab {
        _sapp_x11_app_event(SAPP_EVENTTYPE_UNFOCUSED);
    }
}

void _sapp_x11_on_keypress(XEvent* event) {
    var keycode = cast(i32, event.xkey.keycode);
    sapp_keycode key = _sapp_x11_translate_key(keycode);
    bool repeat = _sapp_x11_keypress_repeat(keycode);
    u32 mods = _sapp_x11_mods(event.xkey.state);
    mods |= _sapp_x11_key_modifier_bit(key);
    if key != SAPP_KEYCODE_INVALID {
        _sapp_x11_key_event(SAPP_EVENTTYPE_KEY_DOWN, key, repeat, mods);
    }
    KeySym keysym;
    XLookupString(&event.xkey, null, 0, &keysym, null);
    i32 chr = _sapp_x11_keysym_to_unicode(keysym);
    if chr > 0 {
        _sapp_x11_char_event(cast(u32, chr), repeat, mods);
    }
}

void _sapp_x11_on_keyrelease(XEvent* event) {
    var keycode = cast(i32, event.xkey.keycode);
    sapp_keycode key = _sapp_x11_translate_key(keycode);
    _sapp_x11_keyrelease_repeat(keycode);
    if key != SAPP_KEYCODE_INVALID {
        u32 mods = _sapp_x11_mods(event.xkey.state);
        mods &= ~_sapp_x11_key_modifier_bit(key);
        _sapp_x11_key_event(SAPP_EVENTTYPE_KEY_UP, key, false, mods);
    }
}

void _sapp_x11_on_buttonpress(XEvent* event) {
    _sapp_x11_mouse_update(event.xbutton.x, event.xbutton.y, false);
    sapp_mousebutton btn = _sapp_x11_translate_button(event);
    u32 mods = _sapp_x11_mods(event.xbutton.state);
    mods |= _sapp_x11_button_modifier_bit(btn);
    if btn != SAPP_MOUSEBUTTON_INVALID {
        _sapp_x11_mouse_event(SAPP_EVENTTYPE_MOUSE_DOWN, btn, mods);
        _sapp.x11.mouse_buttons |= cast(u8, 1 << btn);
    } else {
        switch event.xbutton.button {
            case 4: {
                _sapp_x11_scroll_event(0.0f, 1.0f, mods);
            }
            case 5: {
                _sapp_x11_scroll_event(0.0f, -1.0f, mods);
            }
            case 6: {
                _sapp_x11_scroll_event(1.0f, 0.0f, mods);
            }
            case 7: {
                _sapp_x11_scroll_event(-1.0f, 0.0f, mods);
            }
        }
    }
}

void _sapp_x11_on_buttonrelease(XEvent* event) {
    _sapp_x11_mouse_update(event.xbutton.x, event.xbutton.y, false);
    sapp_mousebutton btn = _sapp_x11_translate_button(event);
    if btn != SAPP_MOUSEBUTTON_INVALID {
        u32 mods = _sapp_x11_mods(event.xbutton.state);
        mods &= ~_sapp_x11_button_modifier_bit(btn);
        _sapp_x11_mouse_event(SAPP_EVENTTYPE_MOUSE_UP, btn, mods);
        _sapp.x11.mouse_buttons &= cast(u8, ~(1 << btn));
    }
}

void _sapp_x11_on_enternotify(XEvent* event) {
    if 0 == _sapp.x11.mouse_buttons {
        _sapp_x11_mouse_update(event.xcrossing.x, event.xcrossing.y, true);
        _sapp_x11_mouse_event(SAPP_EVENTTYPE_MOUSE_ENTER, SAPP_MOUSEBUTTON_INVALID, _sapp_x11_mods(event.xcrossing.state));
    }
}

void _sapp_x11_on_leavenotify(XEvent* event) {
    if 0 == _sapp.x11.mouse_buttons {
        _sapp_x11_mouse_update(event.xcrossing.x, event.xcrossing.y, true);
        _sapp_x11_mouse_event(SAPP_EVENTTYPE_MOUSE_LEAVE, SAPP_MOUSEBUTTON_INVALID, _sapp_x11_mods(event.xcrossing.state));
    }
}

void _sapp_x11_on_motionnotify(XEvent* event) {
    if _sapp.mouse.locked == 0 {
        _sapp_x11_mouse_update(event.xmotion.x, event.xmotion.y, false);
        _sapp_x11_mouse_event(SAPP_EVENTTYPE_MOUSE_MOVE, SAPP_MOUSEBUTTON_INVALID, _sapp_x11_mods(event.xmotion.state));
    }
}

void _sapp_x11_on_propertynotify(XEvent* event) {
    if event.xproperty.state == PropertyNewValue {
        if event.xproperty.atom == _sapp.x11.WM_STATE {
            i32 state = _sapp_x11_get_window_state();
            if state != _sapp.x11.window_state {
                _sapp.x11.window_state = state;
                if state == IconicState {
                    _sapp_x11_app_event(SAPP_EVENTTYPE_ICONIFIED);
                } else if state == NormalState {
                    _sapp_x11_app_event(SAPP_EVENTTYPE_RESTORED);
                }
            }
        }
    }
}

void _sapp_x11_on_selectionnotify(XEvent* event) {
    if event.xselection.property == _sapp.x11.xdnd.XdndSelection {
        u8* data = null;
        var result = cast(u32, _sapp_x11_get_window_property(event.xselection.requestor, event.xselection.property, event.xselection.target, cast(u8**, &data)));
        if _sapp.drop.enabled && result {
            if _sapp_x11_parse_dropped_files_list(data) != 0 {
                _sapp.mouse.dx = 0.0f;
                _sapp.mouse.dy = 0.0f;
                if _sapp_events_enabled() != 0 {
                    _sapp_init_event(SAPP_EVENTTYPE_FILES_DROPPED);
                    _sapp_call_event(&_sapp.event);
                }
            }
        }
        if _sapp.x11.xdnd.version >= 2 {
            XEvent reply;
            reply.type = ClientMessage;
            reply.xclient.window = _sapp.x11.xdnd.source;
            reply.xclient.message_type = _sapp.x11.xdnd.XdndFinished;
            reply.xclient.format = 32;
            reply.xclient.data.l[0] = cast(i64, _sapp.x11.window);
            reply.xclient.data.l[1] = cast(i64, result);
            reply.xclient.data.l[2] = cast(i64, _sapp.x11.xdnd.XdndActionCopy);
            XSendEvent(_sapp.x11.display, _sapp.x11.xdnd.source, False, NoEventMask, &reply);
            XFlush(_sapp.x11.display);
        }
        if data != null {
            XFree(data);
        }
    }
}

void _sapp_x11_on_clientmessage(XEvent* event) {
    if XFilterEvent(event, None) != 0 {
        return;
    }
    if event.xclient.message_type == _sapp.x11.WM_PROTOCOLS {
        var protocol = cast(Atom, event.xclient.data.l[0]);
        if protocol == _sapp.x11.WM_DELETE_WINDOW {
            _sapp.quit_requested = true;
        }
    } else if event.xclient.message_type == _sapp.x11.xdnd.XdndEnter {
        bool is_list = 0 != (event.xclient.data.l[1] & 1);
        _sapp.x11.xdnd.source = cast(Window, event.xclient.data.l[0]);
        _sapp.x11.xdnd.version = cast(i32, event.xclient.data.l[1] >> 24);
        _sapp.x11.xdnd.format = None;
        if _sapp.x11.xdnd.version > 5 {
            return;
        }
        u32 count = 0;
        Atom* formats = null;
        if is_list != 0 {
            count = cast(u32, _sapp_x11_get_window_property(_sapp.x11.xdnd.source, _sapp.x11.xdnd.XdndTypeList, XA_ATOM, cast(u8**, &formats)));
        } else {
            count = 3;
            formats = cast(Atom*, event.xclient.data.l) + 2;
        }
        for u32 i = 0; i < count; i++ {
            if formats[i] == _sapp.x11.xdnd.text_uri_list {
                _sapp.x11.xdnd.format = _sapp.x11.xdnd.text_uri_list;
                break;
            }
        }
        if is_list && formats {
            XFree(formats);
        }
    } else if event.xclient.message_type == _sapp.x11.xdnd.XdndDrop {
        if _sapp.x11.xdnd.version > 5 {
            return;
        }
        Time time = CurrentTime;
        if _sapp.x11.xdnd.format != 0 {
            if _sapp.x11.xdnd.version >= 1 {
                time = cast(Time, event.xclient.data.l[2]);
            }
            XConvertSelection(_sapp.x11.display, _sapp.x11.xdnd.XdndSelection, _sapp.x11.xdnd.format, _sapp.x11.xdnd.XdndSelection, _sapp.x11.window, time);
        } else if _sapp.x11.xdnd.version >= 2 {
            XEvent reply;
            reply.type = ClientMessage;
            reply.xclient.window = _sapp.x11.xdnd.source;
            reply.xclient.message_type = _sapp.x11.xdnd.XdndFinished;
            reply.xclient.format = 32;
            reply.xclient.data.l[0] = cast(i64, _sapp.x11.window);
            reply.xclient.data.l[1] = 0;
            reply.xclient.data.l[2] = None;
            XSendEvent(_sapp.x11.display, _sapp.x11.xdnd.source, False, NoEventMask, &reply);
            XFlush(_sapp.x11.display);
        }
    } else if event.xclient.message_type == _sapp.x11.xdnd.XdndPosition {
        if _sapp.x11.xdnd.version > 5 {
            return;
        }
        XEvent reply;
        reply.type = ClientMessage;
        reply.xclient.window = _sapp.x11.xdnd.source;
        reply.xclient.message_type = _sapp.x11.xdnd.XdndStatus;
        reply.xclient.format = 32;
        reply.xclient.data.l[0] = cast(i64, _sapp.x11.window);
        if _sapp.x11.xdnd.format != 0 {
            reply.xclient.data.l[1] = 1;
            if _sapp.x11.xdnd.version >= 2 {
                reply.xclient.data.l[4] = cast(i64, _sapp.x11.xdnd.XdndActionCopy);
            }
        }
        XSendEvent(_sapp.x11.display, _sapp.x11.xdnd.source, False, NoEventMask, &reply);
        XFlush(_sapp.x11.display);
    }
}

void _sapp_x11_on_selectionrequest(XEvent* event) {
    XSelectionRequestEvent* req = &event.xselectionrequest;
    if req.selection != _sapp.x11.CLIPBOARD {
        return;
    }
    if _sapp.clipboard.enabled == 0 {
        return;
    }
    assert(cast(i64, _sapp.clipboard.buffer));
    XSelectionEvent reply;
    reply.type = SelectionNotify;
    reply.display = req.display;
    reply.requestor = req.requestor;
    reply.selection = req.selection;
    reply.target = req.target;
    reply.property = req.property;
    reply.time = req.time;
    if req.target == _sapp.x11.UTF8_STRING {
        XChangeProperty(_sapp.x11.display, req.requestor, req.property, _sapp.x11.UTF8_STRING, 8, PropModeReplace, cast(u8*, _sapp.clipboard.buffer), strlen(_sapp.clipboard.buffer));
    } else if req.target == _sapp.x11.TARGETS {
        XChangeProperty(_sapp.x11.display, req.requestor, req.property, XA_ATOM, 32, PropModeReplace, cast(u8*, &_sapp.x11.UTF8_STRING), 1);
    } else {
        reply.property = None;
    }
    XSendEvent(_sapp.x11.display, req.requestor, False, 0, cast(XEvent*, &reply));
}

void _sapp_x11_process_event(XEvent* event) {
    switch event.type {
        case GenericEvent: {
            _sapp_x11_on_genericevent(event);
        }
        case FocusIn: {
            _sapp_x11_on_focusin(event);
        }
        case FocusOut: {
            _sapp_x11_on_focusout(event);
        }
        case KeyPress: {
            _sapp_x11_on_keypress(event);
        }
        case KeyRelease: {
            _sapp_x11_on_keyrelease(event);
        }
        case ButtonPress: {
            _sapp_x11_on_buttonpress(event);
        }
        case ButtonRelease: {
            _sapp_x11_on_buttonrelease(event);
        }
        case EnterNotify: {
            _sapp_x11_on_enternotify(event);
        }
        case LeaveNotify: {
            _sapp_x11_on_leavenotify(event);
        }
        case MotionNotify: {
            _sapp_x11_on_motionnotify(event);
        }
        case PropertyNotify: {
            _sapp_x11_on_propertynotify(event);
        }
        case SelectionNotify: {
            _sapp_x11_on_selectionnotify(event);
        }
        case SelectionRequest: {
            _sapp_x11_on_selectionrequest(event);
        }
        case DestroyNotify: {
        }
        case ClientMessage: {
            _sapp_x11_on_clientmessage(event);
        }
    }
}

void _sapp_linux_frame() {
    _sapp_x11_update_dimensions_from_window_size();
    _sapp_frame();
    _sapp_glx_swap_buffers();
}

void _sapp_linux_run(sapp_desc* desc) {
    noinit pthread_attr_t pthread_attr;
    pthread_attr_init(&pthread_attr);
    pthread_attr_destroy(&pthread_attr);
    _sapp_init_state(desc);
    _sapp.x11.window_state = NormalState;
    XInitThreads();
    XrmInitialize();
    _sapp.x11.display = XOpenDisplay(null);
    if _sapp.x11.display == null {
        _sapp_log(SAPP_LOGITEM_LINUX_X11_OPEN_DISPLAY_FAILED, 0, null, 3246);
    }
    _sapp.x11.screen = DefaultScreen(_sapp.x11.display);
    _sapp.x11.root = DefaultRootWindow(_sapp.x11.display);
    _sapp_x11_query_system_dpi();
    _sapp.dpi_scale = _sapp.x11.dpi / 96.0f;
    _sapp_x11_init_extensions();
    _sapp_x11_create_standard_cursors();
    XkbSetDetectableAutoRepeat(_sapp.x11.display, true, null);
    _sapp_x11_init_keytable();
    _sapp_glx_init();
    Visual* visual = null;
    i32 depth = 0;
    _sapp_glx_choose_visual(&visual, &depth);
    _sapp_x11_create_window(visual, depth);
    _sapp_glx_create_context();
    if _sapp.desc.disable_vsync != 0 {
        _sapp_glx_swapinterval(0);
    } else {
        _sapp_glx_swapinterval(_sapp.desc.swap_interval);
    }
    sapp_set_icon(&desc.icon);
    _sapp.valid = true;
    _sapp_x11_show_window();
    if _sapp.fullscreen != 0 {
        _sapp_x11_set_fullscreen(true);
    }
    XFlush(_sapp.x11.display);
    while _sapp.quit_ordered == 0 {
        _sapp_timing_update(&_sapp.timing, 0.0);
        i32 count = XPending(_sapp.x11.display);
        while count-- != 0 {
            XEvent event;
            XNextEvent(_sapp.x11.display, &event);
            _sapp_x11_process_event(&event);
        }
        _sapp_linux_frame();
        XFlush(_sapp.x11.display);
        if _sapp.quit_requested && !_sapp.quit_ordered {
            _sapp_x11_app_event(SAPP_EVENTTYPE_QUIT_REQUESTED);
            if _sapp.quit_requested != 0 {
                _sapp.quit_ordered = true;
            }
        }
    }
    _sapp_call_cleanup();
    _sapp_glx_destroy_context();
    _sapp_x11_destroy_window();
    _sapp_x11_destroy_standard_cursors();
    XCloseDisplay(_sapp.x11.display);
    _sapp_discard_state();
}
}

// ██████  ██    ██ ██████  ██      ██  ██████
// ██   ██ ██    ██ ██   ██ ██      ██ ██
// ██████  ██    ██ ██████  ██      ██ ██
// ██      ██    ██ ██   ██ ██      ██ ██
// ██       ██████  ██████  ███████ ██  ██████
//
// >>public
void sapp_run(sapp_desc* desc) {
    assert(cast(i64, desc));
    _sapp_linux_run(desc);
}






















void sapp_toggle_fullscreen() {
    _sapp_x11_toggle_fullscreen();
}

private {
void _sapp_update_cursor(sapp_mouse_cursor cursor, bool shown) {
    _sapp_x11_update_cursor(cursor, shown);
    _sapp.mouse.current_cursor = cursor;
    _sapp.mouse.shown = shown;
}
}



void sapp_lock_mouse(bool lock) {
    _sapp_x11_lock_mouse(lock);
}




sapp_mouse_cursor sapp_bind_mouse_cursor_image(sapp_mouse_cursor cursor, sapp_image_desc* desc) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    assert(desc.cursor_hotspot_x < desc.width - 1 && desc.cursor_hotspot_y < desc.height - 1);
    assert(desc.width * desc.height * 4 == cast(i32, desc.pixels.size));
    sapp_unbind_mouse_cursor_image(cursor);
    bool res = false;
    res = _sapp_x11_make_custom_mouse_cursor(cursor, desc);
    _sapp.custom_cursor_bound[cast(i32, cursor)] = res;
    if _sapp.mouse.current_cursor == cursor {
        _sapp_update_cursor(cursor, _sapp.mouse.shown);
    }
    return cursor;
}

void sapp_unbind_mouse_cursor_image(sapp_mouse_cursor cursor) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    if _sapp.custom_cursor_bound[cast(i32, cursor)] != 0 {
        _sapp.custom_cursor_bound[cast(i32, cursor)] = false;
        if _sapp.mouse.current_cursor == cursor {
            _sapp_update_cursor(cursor, _sapp.mouse.shown);
        }
        _sapp_x11_destroy_custom_mouse_cursor(cursor);
    }
}





/* NOTE: on HTML5, sapp_set_clipboard_string() must be called from within event handler! */
void sapp_set_clipboard_string(u8* str_var) {
    if _sapp.clipboard.enabled == 0 {
        return;
    }
    assert(cast(i64, str_var));
    _sapp_x11_set_clipboard_string(str_var);
    _sapp_strcpy(str_var, _sapp.clipboard.buffer, cast(u64, _sapp.clipboard.buf_size));
}

u8* sapp_get_clipboard_string() {
    if _sapp.clipboard.enabled == 0 {
        return "";
    }
    return _sapp_x11_get_clipboard_string();
}

void sapp_set_window_title(u8* title) {
    assert(cast(i64, title));
    _sapp_strcpy(title, _sapp.window_title, cast(u64, sizeof(_sapp.window_title)));
    _sapp_x11_update_window_title();
}

void sapp_set_icon(sapp_icon_desc* desc) {
    assert(cast(i64, desc));
    if desc.sokol_default != 0 {
        if null == _sapp.default_icon_pixels {
            _sapp_setup_default_icon();
        }
        assert(null != _sapp.default_icon_pixels);
        desc = &_sapp.default_icon_desc;
    }
    i32 num_images = _sapp_icon_num_images(desc);
    if num_images == 0 {
        return;
    }
    assert(num_images > 0 && num_images <= SAPP_MAX_ICONIMAGES);
    if _sapp_validate_icon_desc(desc, num_images) == 0 {
        return;
    }
    _sapp_x11_set_icon(desc, num_images);
}














void* sapp_x11_get_window() {
    return cast(void*, _sapp.x11.window);
}

void* sapp_x11_get_display() {
    return cast(void*, _sapp.x11.display);
}




