// sokol_app backend for WebGPU on the web.

@wasm_host "sokol_wgpu_host.js"
@wasm_html "sokol_wgpu_harness.html"

extern "sapp" i32  sapp_host_width();

// The host creates the device and picks the render format before main;
// the swapchain view is fetched per frame from the canvas context.
extern "wgpu" WGPUDevice      wgpu_get_device();
extern "wgpu" i32             wgpu_get_render_format();   // WGPUTextureFormat value
extern "wgpu" WGPUTextureView wgpu_get_current_view();
// The host owns and sizes the depth-stencil target and hands in its
// view, so the swapchain pass has a depth attachment.
extern "wgpu" WGPUTextureView wgpu_get_depth_view();
// The host keys its depth and MSAA color targets on the sample count.
extern "wgpu" void            wgpu_set_sample_count(i32 n);
extern "wgpu" WGPUTextureView wgpu_get_msaa_view();

// Entry point sapp_run dispatches into. Stores the host's device and
// render format in _sapp.wgpu, which sapp_environment() and
// sapp_swapchain() read.
void _sapp_emsc_run(sapp_desc* desc) {
    _sapp_init_state(desc);
    // The host's depth target is depth32float-stencil8
    if _sapp.desc.depth_format == SAPP_PIXELFORMAT_DEPTH {
        _sapp.desc.depth_format = SAPP_PIXELFORMAT_DEPTH_STENCIL;
    }
    _sapp.fullscreen = false;
    // The host reports the canvas drawing-buffer size in native pixels:
    // that is the framebuffer. window_* is logical (native / dpr).
    f64 dpr = cast(f64, sapp_host_dpi()) / 1000.0;
    if dpr <= 0.0 { dpr = 1.0; }
    f64 w = cast(f64, sapp_host_width());
    f64 h = cast(f64, sapp_host_height());
    _sapp.dpi_scale = cast(f32, dpr);
    _sapp.framebuffer_width = cast(i32, w);
    _sapp.framebuffer_height = cast(i32, h);
    _sapp.window_width = cast(i32, w / dpr);
    _sapp.window_height = cast(i32, h / dpr);
    _sapp.wgpu.device = wgpu_get_device();
    var fmt = cast(WGPUTextureFormat, wgpu_get_render_format());
    _sapp.wgpu.surface_format = fmt;
    _sapp.wgpu.swapchain_view_format = fmt;
    // Set before the first view fetch.
    wgpu_set_sample_count(_sapp.desc.sample_count);
    if _sapp.desc.sample_count > 1 {
        _sapp.wgpu.msaa_view = wgpu_get_msaa_view();
    }
    // Only when the app asked for depth. Attaching one regardless leaves the
    // pass with a depth-stencil attachment the pipelines were not built for.
    if _sapp.desc.depth_format != SAPP_PIXELFORMAT_NONE {
        _sapp.wgpu.depth_stencil_view = wgpu_get_depth_view();
    }
    _sapp.wgpu.init_done = true;
    _sapp.valid = true;
    return;
}

// Per-frame swapchain acquire. Stores the current canvas texture view in
// _sapp.wgpu.swapchain_view; returns false if the host has none.
bool _sapp_wgpu_swapchain_next() {
    _sapp.wgpu.swapchain_view = wgpu_get_current_view();
    return _sapp.wgpu.swapchain_view != null;
}

// --- No-ops: fullscreen, cursors, clipboard, file drops ---
void _sapp_emsc_toggle_fullscreen() { return; }

// --- Frame loop and DOM events, driven from JS ---
export void _sapp_wasm_frame(f64 time_ms) {
    if !_sapp.valid { return; }
    // Refresh host-owned views; the host recreates them on canvas resize.
    // swapchain_view stays null until sapp_acquire_swapchain().
    if _sapp.desc.depth_format != SAPP_PIXELFORMAT_NONE {
        _sapp.wgpu.depth_stencil_view = wgpu_get_depth_view();
    }
    if _sapp.desc.sample_count > 1 {
        _sapp.wgpu.msaa_view = wgpu_get_msaa_view();
    }
    _sapp_timing_update(&_sapp.timing, time_ms / 1000.0);
    _sapp_frame();
    _sapp.wgpu.swapchain_view = null;   // released; reacquired next frame
    if _sapp.quit_requested != 0 {
        _sapp_init_event(SAPP_EVENTTYPE_QUIT_REQUESTED);
        _sapp_call_event(&_sapp.event);
        if _sapp.quit_requested != 0 { _sapp.quit_ordered = true; }
    }
    if _sapp.quit_ordered != 0 {
        _sapp_call_cleanup();
        _sapp.valid = false;
        sapp_host_request_quit();
    }
}







export void _sapp_wasm_event_resized(i32 w, i32 h) {
    // w,h are native pixels; window_* is logical.
    f64 dpr = cast(f64, sapp_host_dpi()) / 1000.0;
    if dpr <= 0.0 { dpr = 1.0; }
    _sapp.dpi_scale = cast(f32, dpr);
    _sapp.framebuffer_width = w;
    _sapp.framebuffer_height = h;
    _sapp.window_width = cast(i32, cast(f64, w) / dpr);
    _sapp.window_height = cast(i32, cast(f64, h) / dpr);
    if !_sapp_events_enabled() { return; }
    _sapp_init_event(SAPP_EVENTTYPE_RESIZED);
    _sapp_call_event(&_sapp.event);
}


} else {









































enum _sg_gl_gpudirty_t {
    _SG_GL_GPUDIRTY_VERTEXBUFFER = 1,
    _SG_GL_GPUDIRTY_INDEXBUFFER = 2,
    _SG_GL_GPUDIRTY_STORAGEBUFFER = 4,
    _SG_GL_GPUDIRTY_TEXTURE = 8,
    _SG_GL_GPUDIRTY_STORAGEIMAGE = 16,
    _SG_GL_GPUDIRTY_ATTACHMENT = 32,
    _SG_GL_GPUDIRTY_BUFFER_ALL = 7,
