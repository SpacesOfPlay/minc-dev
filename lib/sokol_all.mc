        objc.msg_id_ii(pasteboard, objc_selref("declareTypes:owner:"), objc.msg_id_i(objc_classref("NSArray", "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation"), objc_selref("arrayWithObject:"), NSPasteboardTypeString), null);
