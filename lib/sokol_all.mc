D3D11_FILTER _sg_d3d11_filter(sg_filter min_f, sg_filter mag_f, sg_filter mipmap_f, bool comparison, u32 max_anisotropy) {
    u32 d3d11_filter = 0;
    if max_anisotropy > 1 {
        d3d11_filter |= 0x55;
    } else {
        if mipmap_f == SG_FILTER_LINEAR {
            d3d11_filter |= 0x01;
        }
        if mag_f == SG_FILTER_LINEAR {
            d3d11_filter |= 0x04;
        }
        if min_f == SG_FILTER_LINEAR {
            d3d11_filter |= 0x10;
        }
    }
    if comparison != 0 {
        d3d11_filter |= 0x80;
    }
    return cast(D3D11_FILTER, d3d11_filter);
}

