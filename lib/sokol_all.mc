ObjcId _sapp_mtl_create_texture(i32 width, i32 height, MTLPixelFormat fmt, i32 sample_count, u8* label) {
    MTLTextureDescriptor* mtl_desc = objc.msg_id_v(objc.msg_id_v(objc_classref("MTLTextureDescriptor", "/System/Library/Frameworks/Metal.framework/Metal"), objc_selref("alloc")), objc_selref("init"));
    if sample_count > 1 {
        cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setTextureType:"), cast(u64, MTLTextureType2DMultisample));
    } else {
        cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setTextureType:"), cast(u64, MTLTextureType2D));
    }
    cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setPixelFormat:"), fmt);
    cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setWidth:"), cast(u64, cast(NSUInteger, width)));
    cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setHeight:"), cast(u64, cast(NSUInteger, height)));
    cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setDepth:"), cast(u64, 1));
    cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setMipmapLevelCount:"), cast(u64, 1));
    cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setArrayLength:"), cast(u64, 1));
    cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setSampleCount:"), cast(u64, cast(NSUInteger, sample_count)));
    cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setUsage:"), cast(u64, MTLTextureUsageRenderTarget));
    cast(fn(void*, void*, u64): void, objc.raw)(mtl_desc, objc_selref("setResourceOptions:"), cast(u64, MTLResourceStorageModePrivate));
    ObjcId mtl_tex = cast(fn(void*, void*, void*): void*, objc.raw)(_sapp.mtl.device, objc_selref("newTextureWithDescriptor:"), mtl_desc);
    {
        mtl_desc = null;
    }
    when defined(SOKOL_DEBUG) {
        if mtl_tex != null {
            cast(fn(void*, void*, void*): void, objc.raw)(mtl_tex, objc_selref("setLabel:"), cast(fn(void*, void*, u8*): void*, objc.raw)(objc_classref("NSString", "/System/Library/Frameworks/Foundation.framework/Foundation"), objc_selref("stringWithUTF8String:"), label));
        }
    } else {
        ignore label;
    }
    return mtl_tex;
}
MTLPixelFormat _sapp_mtl_depth_format() {
    switch _sapp.desc.depth_format {
        case SAPP_PIXELFORMAT_DEPTH: {
            return MTLPixelFormatDepth32Float;
        }
        case SAPP_PIXELFORMAT_DEPTH_STENCIL: {
            return MTLPixelFormatDepth32Float_Stencil8;
        }
        default: {
            assert(cast(i64, false));
            return MTLPixelFormatInvalid;
        }
    }
}
MTLPixelFormat _sapp_mtl_color_format() {
    if _sapp.desc.hdr != 0 {
        return MTLPixelFormatRGBA16Float;
    } else {
        if _sapp.desc.srgb != 0 {
            return MTLPixelFormatBGRA8Unorm_sRGB;
        } else {
            return MTLPixelFormatBGRA8Unorm;
        }
    }
}
CFStringRef _sapp_mtl_color_space() {
    if _sapp.desc.hdr != 0 {
        return kCGColorSpaceExtendedLinearDisplayP3;
    } else {
        return kCGColorSpaceSRGB;
    }
}
void _sapp_mtl_swapchain_create(i32 width, i32 height) {
    i32 sample_count = _sapp.desc.sample_count;
    if _sapp.desc.depth_format != SAPP_PIXELFORMAT_NONE {
        MTLPixelFormat format_var = _sapp_mtl_depth_format();  // renamed from: format
        _sapp.mtl.depth_tex = _sapp_mtl_create_texture(width, height, format_var, sample_count, "swapchain_depth_tex");
        if null == _sapp.mtl.depth_tex {
            _sapp_log(SAPP_LOGITEM_METAL_CREATE_SWAPCHAIN_DEPTH_TEXTURE_FAILED, 0, null, 3246);
        }
    }
    if _sapp.desc.sample_count > 1 {
        MTLPixelFormat format_var = _sapp_mtl_color_format();  // renamed from: format
        _sapp.mtl.msaa_tex = _sapp_mtl_create_texture(width, height, format_var, sample_count, "swapchain_msaa_tex");
        if null == _sapp.mtl.msaa_tex {
            _sapp_log(SAPP_LOGITEM_METAL_CREATE_SWAPCHAIN_MSAA_TEXTURE_FAILED, 0, null, 3246);
        }
    }
}
void _sapp_mtl_swapchain_destroy() {
    if _sapp.mtl.depth_tex != null {
        {
            _sapp.mtl.depth_tex = null;
        }
    }
    if _sapp.mtl.msaa_tex != null {
        {
            _sapp.mtl.msaa_tex = null;
        }
    }
}
void _sapp_mtl_swapchain_resize(i32 width, i32 height) {
    _sapp_mtl_swapchain_destroy();
    _sapp_mtl_swapchain_create(width, height);
}
ObjcId _sapp_mtl_swapchain_next() {
    ObjcId drawable = objc.msg_id_v(_sapp.mtl.layer, objc_selref("nextDrawable"));
    assert(drawable != null);
    return drawable;
}
MTLLoadAction _sg_mtl_load_action(sg_load_action a) {
    switch a {
        case SG_LOADACTION_CLEAR: {
            return MTLLoadActionClear;
        }
        case SG_LOADACTION_LOAD: {
            return MTLLoadActionLoad;
        }
        case SG_LOADACTION_DONTCARE: {
            return MTLLoadActionDontCare;
        }
        default: {
            assert(cast(i64, false));
            return cast(MTLLoadAction, 0);
        }
    }
}
MTLStoreAction _sg_mtl_store_action(sg_store_action a, bool resolve) {
    switch a {
        case SG_STOREACTION_STORE: {
            if resolve != 0 {
                return MTLStoreActionStoreAndMultisampleResolve;
            } else {
                return MTLStoreActionStore;
            }
        }
        case SG_STOREACTION_DONTCARE: {
            if resolve != 0 {
                return MTLStoreActionMultisampleResolve;
            } else {
                return MTLStoreActionDontCare;
            }
        }
        default: {
            assert(cast(i64, false));
            return cast(MTLStoreAction, 0);
        }
    }
}
MTLResourceOptions _sg_mtl_buffer_resource_options(sg_buffer_usage* usage) {
    if usage.immutable != 0 {
        return _sg_mtl_resource_options_storage_mode_managed_or_shared();
    } else {
        return MTLResourceCPUCacheModeWriteCombined | _sg_mtl_resource_options_storage_mode_managed_or_shared();
    }
}
