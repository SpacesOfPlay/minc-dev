bool _sg_d3d11_load_d3dcompiler_dll() {
    if null == _sg.d3d11.d3dcompiler_dll && !_sg.d3d11.d3dcompiler_dll_load_failed {
        _sg.d3d11.d3dcompiler_dll = LoadLibraryA("d3dcompiler_47.dll");
        if null == _sg.d3d11.d3dcompiler_dll {
            _sg_log(SG_LOGITEM_D3D11_LOAD_D3DCOMPILER_47_DLL_FAILED, 1, null, 7222);
            _sg.d3d11.d3dcompiler_dll_load_failed = true;
            return false;
        }
        _sg.d3d11.D3DCompile_func = cast(pD3DCompile, cast(void*, GetProcAddress(_sg.d3d11.d3dcompiler_dll, "D3DCompile")));
        assert(cast(i64, _sg.d3d11.D3DCompile_func));
    }
    return null != _sg.d3d11.d3dcompiler_dll;
}

ID3DBlob* _sg_d3d11_compile_shader(sg_shader_function* shd_func) {
    if _sg_d3d11_load_d3dcompiler_dll() == 0 {
        return null;
    }
    assert(cast(i64, shd_func.d3d11_target));
    var flags1 = cast(UINT, D3DCOMPILE_PACK_MATRIX_COLUMN_MAJOR);
    if _sg.desc.d3d11.shader_debugging != 0 {
        flags1 |= cast(u32, D3DCOMPILE_DEBUG | D3DCOMPILE_SKIP_OPTIMIZATION);
    } else {
        flags1 |= cast(u32, D3DCOMPILE_OPTIMIZATION_LEVEL3);
