            break;
        }
        assert(a_state.buffer_index < SG_MAX_VERTEXBUFFER_BINDSLOTS);
        assert(cast(i64, pip.cmn.vertex_buffer_layout_active[a_state.buffer_index]));
        sg_vertex_buffer_layout_state* l_state = &desc.layout.buffers[a_state.buffer_index];
        sg_vertex_step step_func = l_state.step_func;
        i32 step_rate = l_state.step_rate;
        D3D11_INPUT_ELEMENT_DESC* d3d11_comp = &d3d11_comps[attr_index];
        d3d11_comp.SemanticName = _sg_strptr(&shd.d3d11.attrs[attr_index].sem_name);
        d3d11_comp.SemanticIndex = cast(UINT, shd.d3d11.attrs[attr_index].sem_index);
        d3d11_comp.Format = _sg_d3d11_vertex_format(a_state.format);
        d3d11_comp.InputSlot = cast(UINT, a_state.buffer_index);
        d3d11_comp.AlignedByteOffset = cast(UINT, a_state.offset);
        d3d11_comp.InputSlotClass = _sg_d3d11_input_classification(step_func);
        if SG_VERTEXSTEP_PER_INSTANCE == step_func {
            d3d11_comp.InstanceDataStepRate = cast(UINT, step_rate);
        }
    }
    for u64 layout_index = 0; layout_index < cast(u64, SG_MAX_VERTEXBUFFER_BINDSLOTS); layout_index++ {
        if pip.cmn.vertex_buffer_layout_active[layout_index] != 0 {
            sg_vertex_buffer_layout_state* l_state = &desc.layout.buffers[layout_index];
            assert(l_state.stride > 0);
            pip.d3d11.vb_strides[layout_index] = cast(UINT, l_state.stride);
        } else {
            pip.d3d11.vb_strides[layout_index] = 0;
        }
    }
    if attr_index > 0 {
        hr = _sg_d3d11_CreateInputLayout(_sg.d3d11.dev, d3d11_comps, cast(UINT, attr_index), shd.d3d11.vs_blob, shd.d3d11.vs_blob_length, &pip.d3d11.il);
        if (hr >= 0 && pip.d3d11.il) == 0 {
            _sg_log(SG_LOGITEM_D3D11_CREATE_INPUT_LAYOUT_FAILED, 1, null, 7222);
            return SG_RESOURCESTATE_FAILED;
        }
    }
    D3D11_RASTERIZER_DESC rs_desc;
    rs_desc.FillMode = D3D11_FILL_SOLID;
    rs_desc.CullMode = _sg_d3d11_cull_mode(desc.cull_mode);
    rs_desc.FrontCounterClockwise = desc.face_winding == SG_FACEWINDING_CCW;
    rs_desc.DepthBias = cast(INT, pip.cmn.depth.bias);
    rs_desc.DepthBiasClamp = pip.cmn.depth.bias_clamp;
    rs_desc.SlopeScaledDepthBias = pip.cmn.depth.bias_slope_scale;
    rs_desc.DepthClipEnable = TRUE;
    rs_desc.ScissorEnable = TRUE;
    rs_desc.MultisampleEnable = desc.sample_count > 1;
    rs_desc.AntialiasedLineEnable = FALSE;
    hr = _sg_d3d11_CreateRasterizerState(_sg.d3d11.dev, &rs_desc, &pip.d3d11.rs);
    if (hr >= 0 && pip.d3d11.rs) == 0 {
        _sg_log(SG_LOGITEM_D3D11_CREATE_RASTERIZER_STATE_FAILED, 1, null, 7222);
        return SG_RESOURCESTATE_FAILED;
    }
    D3D11_DEPTH_STENCIL_DESC dss_desc;
    dss_desc.DepthEnable = TRUE;
    dss_desc.DepthWriteMask = desc.depth.write_enabled != 0 ? D3D11_DEPTH_WRITE_MASK_ALL : D3D11_DEPTH_WRITE_MASK_ZERO;
    dss_desc.DepthFunc = _sg_d3d11_compare_func(desc.depth.compare);
    dss_desc.StencilEnable = desc.stencil.enabled;
    dss_desc.StencilReadMask = desc.stencil.read_mask;
    dss_desc.StencilWriteMask = desc.stencil.write_mask;
    sg_stencil_face_state* sf = &desc.stencil.front;
    dss_desc.FrontFace.StencilFailOp = _sg_d3d11_stencil_op(sf.fail_op);
    dss_desc.FrontFace.StencilDepthFailOp = _sg_d3d11_stencil_op(sf.depth_fail_op);
    dss_desc.FrontFace.StencilPassOp = _sg_d3d11_stencil_op(sf.pass_op);
    dss_desc.FrontFace.StencilFunc = _sg_d3d11_compare_func(sf.compare);
    sg_stencil_face_state* sb = &desc.stencil.back;
    dss_desc.BackFace.StencilFailOp = _sg_d3d11_stencil_op(sb.fail_op);
    dss_desc.BackFace.StencilDepthFailOp = _sg_d3d11_stencil_op(sb.depth_fail_op);
    dss_desc.BackFace.StencilPassOp = _sg_d3d11_stencil_op(sb.pass_op);
    dss_desc.BackFace.StencilFunc = _sg_d3d11_compare_func(sb.compare);
    hr = _sg_d3d11_CreateDepthStencilState(_sg.d3d11.dev, &dss_desc, &pip.d3d11.dss);
    if (hr >= 0 && pip.d3d11.dss) == 0 {
        _sg_log(SG_LOGITEM_D3D11_CREATE_DEPTH_STENCIL_STATE_FAILED, 1, null, 7222);
        return SG_RESOURCESTATE_FAILED;
    }
    D3D11_BLEND_DESC bs_desc;
    bs_desc.AlphaToCoverageEnable = desc.alpha_to_coverage_enabled;
    bs_desc.IndependentBlendEnable = TRUE;
    {
        u64 i = 0;
        for i = 0; i < cast(u64, desc.color_count); i++ {
            sg_blend_state* src = &desc.colors[i].blend;
            D3D11_RENDER_TARGET_BLEND_DESC* dst = &bs_desc.RenderTarget[i];
            dst.BlendEnable = src.enabled;
            dst.SrcBlend = _sg_d3d11_blend_factor(src.src_factor_rgb);
            dst.DestBlend = _sg_d3d11_blend_factor(src.dst_factor_rgb);
            dst.BlendOp = _sg_d3d11_blend_op(src.op_rgb);
            dst.SrcBlendAlpha = _sg_d3d11_blend_factor(src.src_factor_alpha);
            dst.DestBlendAlpha = _sg_d3d11_blend_factor(src.dst_factor_alpha);
            dst.BlendOpAlpha = _sg_d3d11_blend_op(src.op_alpha);
            dst.RenderTargetWriteMask = _sg_d3d11_color_write_mask(desc.colors[i].write_mask);
        }
        for ; i < 8; i++ {
            D3D11_RENDER_TARGET_BLEND_DESC* dst = &bs_desc.RenderTarget[i];
            dst.BlendEnable = FALSE;
            dst.SrcBlendAlpha = D3D11_BLEND_ONE;
            dst.SrcBlend = dst.SrcBlendAlpha;
            dst.DestBlendAlpha = D3D11_BLEND_ZERO;
            dst.DestBlend = dst.DestBlendAlpha;
            dst.BlendOpAlpha = D3D11_BLEND_OP_ADD;
            dst.BlendOp = dst.BlendOpAlpha;
            dst.RenderTargetWriteMask = cast(u8, D3D11_COLOR_WRITE_ENABLE_ALL);
        }
    }
    hr = _sg_d3d11_CreateBlendState(_sg.d3d11.dev, &bs_desc, &pip.d3d11.bs);
    if (hr >= 0 && pip.d3d11.bs) == 0 {
        _sg_log(SG_LOGITEM_D3D11_CREATE_BLEND_STATE_FAILED, 1, null, 7222);
        return SG_RESOURCESTATE_FAILED;
    }
    return SG_RESOURCESTATE_VALID;
}

void _sg_d3d11_discard_pipeline(_sg_pipeline_t* pip) {
    assert(cast(i64, pip));
    if pip.d3d11.il != null {
        pip.d3d11.il.lpVtbl.Release(pip.d3d11.il);
    }
    if pip.d3d11.rs != null {
        pip.d3d11.rs.lpVtbl.Release(pip.d3d11.rs);
    }
    if pip.d3d11.dss != null {
        pip.d3d11.dss.lpVtbl.Release(pip.d3d11.dss);
    }
    if pip.d3d11.bs != null {
        pip.d3d11.bs.lpVtbl.Release(pip.d3d11.bs);
    }
}

sg_resource_state _sg_d3d11_create_view(_sg_view_t* view, sg_view_desc* desc) {
    assert(view && desc);
    ignore desc;
    HRESULT hr;
    if view.cmn.type == SG_VIEWTYPE_STORAGEBUFFER {
        _sg_buffer_t* buf = _sg_buffer_ref_ptr(&view.cmn.buf.ref);
        assert(cast(i64, buf.d3d11.buf));
        var size = cast(UINT, buf.cmn.size);
        assert(cast(i64, _sg_multiple_u64(size, 4)));
        var offset = cast(UINT, view.cmn.buf.offset);
        assert(cast(i64, _sg_multiple_u64(offset, 4)));
        assert(offset < size);
        UINT first_element = offset / 4;
        UINT num_elements = (size - offset) / 4;
        D3D11_SHADER_RESOURCE_VIEW_DESC d3d11_srv_desc;
        d3d11_srv_desc.Format = DXGI_FORMAT_R32_TYPELESS;
        d3d11_srv_desc.ViewDimension = D3D11_SRV_DIMENSION_BUFFEREX;
        d3d11_srv_desc.BufferEx.FirstElement = first_element;
        d3d11_srv_desc.BufferEx.NumElements = num_elements;
        d3d11_srv_desc.BufferEx.Flags = cast(u32, D3D11_BUFFEREX_SRV_FLAG_RAW);
        assert(cast(i64, !view.d3d11.srv));
        hr = _sg_d3d11_CreateShaderResourceView(_sg.d3d11.dev, cast(ID3D11Resource*, buf.d3d11.buf), &d3d11_srv_desc, &view.d3d11.srv);
        if (hr >= 0 && view.d3d11.srv) == 0 {
            _sg_log(SG_LOGITEM_D3D11_CREATE_BUFFER_SRV_FAILED, 1, null, 7222);
            return SG_RESOURCESTATE_FAILED;
        }
        if buf.cmn.usage.immutable != 0 {
            D3D11_UNORDERED_ACCESS_VIEW_DESC d3d11_uav_desc;
            d3d11_uav_desc.Format = DXGI_FORMAT_R32_TYPELESS;
            d3d11_uav_desc.ViewDimension = D3D11_UAV_DIMENSION_BUFFER;
            d3d11_uav_desc.Buffer.FirstElement = first_element;
            d3d11_uav_desc.Buffer.NumElements = num_elements;
            d3d11_uav_desc.Buffer.Flags = cast(u32, D3D11_BUFFER_UAV_FLAG_RAW);
            assert(cast(i64, !view.d3d11.uav));
            hr = _sg_d3d11_CreateUnorderedAccessView(_sg.d3d11.dev, cast(ID3D11Resource*, buf.d3d11.buf), &d3d11_uav_desc, &view.d3d11.uav);
            if (hr >= 0 && view.d3d11.uav) == 0 {
                _sg_log(SG_LOGITEM_D3D11_CREATE_BUFFER_UAV_FAILED, 1, null, 7222);
                return SG_RESOURCESTATE_FAILED;
            }
        }
    } else {
        _sg_image_t* img = _sg_image_ref_ptr(&view.cmn.img.ref);
        assert(cast(i64, img.d3d11.res));
        bool msaa = img.cmn.sample_count > 1;
        assert(view.cmn.img.mip_level_count >= 1);
        assert(view.cmn.img.slice_count >= 1);
        var mip_level = cast(UINT, view.cmn.img.mip_level);
        var mip_count = cast(UINT, view.cmn.img.mip_level_count);
        var slice = cast(UINT, view.cmn.img.slice);
        var slice_count = cast(UINT, view.cmn.img.slice_count);
        if view.cmn.type == SG_VIEWTYPE_STORAGEIMAGE {
            assert(cast(i64, !msaa));
            D3D11_UNORDERED_ACCESS_VIEW_DESC d3d11_uav_desc;
            d3d11_uav_desc.Format = _sg_d3d11_rtv_uav_pixel_format(img.cmn.pixel_format);
            switch img.cmn.type {
                case SG_IMAGETYPE_2D: {
                    d3d11_uav_desc.ViewDimension = D3D11_UAV_DIMENSION_TEXTURE2D;
                    d3d11_uav_desc.Texture2D.MipSlice = mip_level;
                }
                case SG_IMAGETYPE_CUBE, SG_IMAGETYPE_ARRAY: {
                    d3d11_uav_desc.ViewDimension = D3D11_UAV_DIMENSION_TEXTURE2DARRAY;
                    d3d11_uav_desc.Texture2DArray.MipSlice = mip_level;
                    d3d11_uav_desc.Texture2DArray.FirstArraySlice = slice;
                    d3d11_uav_desc.Texture2DArray.ArraySize = 1;
                }
                case SG_IMAGETYPE_3D: {
                    d3d11_uav_desc.ViewDimension = D3D11_UAV_DIMENSION_TEXTURE3D;
                    d3d11_uav_desc.Texture3D.MipSlice = mip_level;
                    d3d11_uav_desc.Texture3D.FirstWSlice = slice;
                    d3d11_uav_desc.Texture3D.WSize = 1;
                }
                default: {
                    assert(cast(i64, false));
                }
            }
            hr = _sg_d3d11_CreateUnorderedAccessView(_sg.d3d11.dev, img.d3d11.res, &d3d11_uav_desc, &view.d3d11.uav);
            if (hr >= 0 && view.d3d11.uav) == 0 {
                _sg_log(SG_LOGITEM_D3D11_CREATE_UAV_FAILED, 1, null, 7222);
                return SG_RESOURCESTATE_FAILED;
            }
        } else if view.cmn.type == SG_VIEWTYPE_TEXTURE {
            D3D11_SHADER_RESOURCE_VIEW_DESC d3d11_srv_desc;
            d3d11_srv_desc.Format = _sg_d3d11_srv_pixel_format(img.cmn.pixel_format);
            switch img.cmn.type {
                case SG_IMAGETYPE_2D: {
                    if msaa != 0 {
                        d3d11_srv_desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2DMS;
                    } else {
                        d3d11_srv_desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
                        d3d11_srv_desc.Texture2D.MostDetailedMip = mip_level;
                        d3d11_srv_desc.Texture2D.MipLevels = mip_count;
                    }
                }
                case SG_IMAGETYPE_CUBE: {
                    assert(cast(i64, !msaa));
                    d3d11_srv_desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURECUBE;
                    d3d11_srv_desc.TextureCube.MostDetailedMip = mip_level;
                    d3d11_srv_desc.TextureCube.MipLevels = mip_count;
                }
                case SG_IMAGETYPE_ARRAY: {
                    if msaa != 0 {
                        d3d11_srv_desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2DMSARRAY;
                        d3d11_srv_desc.Texture2DMSArray.FirstArraySlice = slice;
                        d3d11_srv_desc.Texture2DMSArray.ArraySize = slice_count;
                    } else {
                        d3d11_srv_desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2DARRAY;
                        d3d11_srv_desc.Texture2DArray.MostDetailedMip = mip_level;
                        d3d11_srv_desc.Texture2DArray.MipLevels = mip_count;
                        d3d11_srv_desc.Texture2DArray.FirstArraySlice = slice;
                        d3d11_srv_desc.Texture2DArray.ArraySize = slice_count;
                    }
                }
                case SG_IMAGETYPE_3D: {
                    assert(cast(i64, !msaa));
                    d3d11_srv_desc.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE3D;
                    d3d11_srv_desc.Texture3D.MostDetailedMip = mip_level;
                    d3d11_srv_desc.Texture3D.MipLevels = mip_count;
                }
                default: {
                    assert(cast(i64, false));
                }
            }
            hr = _sg_d3d11_CreateShaderResourceView(_sg.d3d11.dev, img.d3d11.res, &d3d11_srv_desc, &view.d3d11.srv);
            if (hr >= 0 && view.d3d11.srv) == 0 {
                _sg_log(SG_LOGITEM_D3D11_CREATE_2D_SRV_FAILED, 1, null, 7222);
                return SG_RESOURCESTATE_FAILED;
            }
        } else if view.cmn.type == SG_VIEWTYPE_COLORATTACHMENT {
            D3D11_RENDER_TARGET_VIEW_DESC d3d11_rtv_desc;
            d3d11_rtv_desc.Format = _sg_d3d11_rtv_uav_pixel_format(img.cmn.pixel_format);
            switch img.cmn.type {
                case SG_IMAGETYPE_2D: {
                    if msaa != 0 {
                        d3d11_rtv_desc.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2DMS;
                    } else {
                        d3d11_rtv_desc.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2D;
                        d3d11_rtv_desc.Texture2D.MipSlice = mip_level;
                    }
                }
                case SG_IMAGETYPE_CUBE, SG_IMAGETYPE_ARRAY: {
                    if msaa != 0 {
                        d3d11_rtv_desc.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2DMSARRAY;
                        d3d11_rtv_desc.Texture2DMSArray.FirstArraySlice = slice;
                        d3d11_rtv_desc.Texture2DMSArray.ArraySize = 1;
                    } else {
                        d3d11_rtv_desc.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2DARRAY;
                        d3d11_rtv_desc.Texture2DArray.MipSlice = mip_level;
                        d3d11_rtv_desc.Texture2DArray.FirstArraySlice = slice;
                        d3d11_rtv_desc.Texture2DArray.ArraySize = 1;
                    }
                }
                case SG_IMAGETYPE_3D: {
                    assert(cast(i64, !msaa));
                    d3d11_rtv_desc.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE3D;
                    d3d11_rtv_desc.Texture3D.MipSlice = mip_level;
                    d3d11_rtv_desc.Texture3D.FirstWSlice = slice;
                    d3d11_rtv_desc.Texture3D.WSize = 1;
                }
                default: {
                    assert(cast(i64, false));
                }
            }
            hr = _sg_d3d11_CreateRenderTargetView(_sg.d3d11.dev, img.d3d11.res, &d3d11_rtv_desc, &view.d3d11.rtv);
            if (hr >= 0 && view.d3d11.rtv) == 0 {
                _sg_log(SG_LOGITEM_D3D11_CREATE_RTV_FAILED, 1, null, 7222);
                return SG_RESOURCESTATE_FAILED;
            }
        } else if view.cmn.type == SG_VIEWTYPE_DEPTHSTENCILATTACHMENT {
            assert(img.cmn.type != SG_IMAGETYPE_3D);
            D3D11_DEPTH_STENCIL_VIEW_DESC d3d11_dsv_desc;
            d3d11_dsv_desc.Format = _sg_d3d11_dsv_pixel_format(img.cmn.pixel_format);
            switch img.cmn.type {
                case SG_IMAGETYPE_2D: {
                    if msaa != 0 {
                        d3d11_dsv_desc.ViewDimension = D3D11_DSV_DIMENSION_TEXTURE2DMS;
                    } else {
                        d3d11_dsv_desc.ViewDimension = D3D11_DSV_DIMENSION_TEXTURE2D;
                        d3d11_dsv_desc.Texture2D.MipSlice = mip_level;
                    }
                }
                case SG_IMAGETYPE_CUBE, SG_IMAGETYPE_ARRAY: {
                    if msaa != 0 {
                        d3d11_dsv_desc.ViewDimension = D3D11_DSV_DIMENSION_TEXTURE2DMSARRAY;
                        d3d11_dsv_desc.Texture2DMSArray.FirstArraySlice = slice;
                        d3d11_dsv_desc.Texture2DMSArray.ArraySize = 1;
                    } else {
                        d3d11_dsv_desc.ViewDimension = D3D11_DSV_DIMENSION_TEXTURE2DARRAY;
                        d3d11_dsv_desc.Texture2DArray.MipSlice = mip_level;
                        d3d11_dsv_desc.Texture2DArray.FirstArraySlice = slice;
                        d3d11_dsv_desc.Texture2DArray.ArraySize = 1;
                    }
                }
                default: {
                    assert(cast(i64, false));
                }
            }
            hr = _sg_d3d11_CreateDepthStencilView(_sg.d3d11.dev, img.d3d11.res, &d3d11_dsv_desc, &view.d3d11.dsv);
            if (hr >= 0 && view.d3d11.dsv) == 0 {
                _sg_log(SG_LOGITEM_D3D11_CREATE_DSV_FAILED, 1, null, 7222);
                return SG_RESOURCESTATE_FAILED;
            }
        }
    }
    return SG_RESOURCESTATE_VALID;
}

void _sg_d3d11_discard_view(_sg_view_t* view) {
    assert(cast(i64, view));
    if view.d3d11.srv != null {
        view.d3d11.srv.lpVtbl.Release(view.d3d11.srv);
    }
    if view.d3d11.uav != null {
        view.d3d11.uav.lpVtbl.Release(view.d3d11.uav);
    }
    if view.d3d11.rtv != null {
        view.d3d11.rtv.lpVtbl.Release(view.d3d11.rtv);
    }
    if view.d3d11.dsv != null {
        view.d3d11.dsv.lpVtbl.Release(view.d3d11.dsv);
    }
}

void _sg_d3d11_begin_pass(sg_pass* pass, _sg_attachments_ptrs_t* atts) {
    assert(_sg.d3d11.ctx && pass && atts);
    if _sg.cur_pass.is_compute != 0 {
        return;
    }
    i32 num_rtvs = 0;
    ID3D11RenderTargetView*[8] rtvs;
    ID3D11DepthStencilView* dsv = null;
    _sg.d3d11.cur_swapchain.render_view = null;
    _sg.d3d11.cur_swapchain.resolve_view = null;
    if atts.empty == 0 {
        assert(atts.num_color_views <= SG_MAX_COLOR_ATTACHMENTS);
        num_rtvs = atts.num_color_views;
        for i32 i = 0; i < num_rtvs; i++ {
            assert(cast(i64, atts.color_views[i]));
            assert(cast(i64, atts.color_views[i].d3d11.rtv));
            rtvs[i] = atts.color_views[i].d3d11.rtv;
        }
        if atts.ds_view != null {
            assert(cast(i64, atts.ds_view.d3d11.dsv));
            dsv = atts.ds_view.d3d11.dsv;
        }
    } else {
        sg_swapchain* swapchain = &pass.swapchain;
        assert(cast(i64, swapchain.d3d11.render_view));
        num_rtvs = 1;
        rtvs[0] = cast(ID3D11RenderTargetView*, swapchain.d3d11.render_view);
        dsv = cast(ID3D11DepthStencilView*, swapchain.d3d11.depth_stencil_view);
        _sg.d3d11.cur_swapchain.render_view = cast(ID3D11RenderTargetView*, swapchain.d3d11.render_view);
        _sg.d3d11.cur_swapchain.resolve_view = cast(ID3D11RenderTargetView*, swapchain.d3d11.resolve_view);
    }
    _sg_d3d11_OMSetRenderTargets(_sg.d3d11.ctx, cast(UINT, SG_MAX_COLOR_ATTACHMENTS), rtvs, dsv);
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.d3d11.pass.num_om_set_render_targets++;
        }
    }
    D3D11_VIEWPORT vp;
    vp.Width = cast(FLOAT, _sg.cur_pass.dim.width);
    vp.Height = cast(FLOAT, _sg.cur_pass.dim.height);
    vp.MaxDepth = 1.0f;
    _sg_d3d11_RSSetViewports(_sg.d3d11.ctx, 1, &vp);
    noinit D3D11_RECT rect;
    rect.left = 0;
    rect.top = 0;
    rect.right = _sg.cur_pass.dim.width;
    rect.bottom = _sg.cur_pass.dim.height;
    _sg_d3d11_RSSetScissorRects(_sg.d3d11.ctx, 1, &rect);
    sg_pass_action* action = &pass.action;
    for u64 i = 0; i < cast(u64, num_rtvs); i++ {
        if action.colors[i].load_action == SG_LOADACTION_CLEAR {
            _sg_d3d11_ClearRenderTargetView(_sg.d3d11.ctx, rtvs[i], cast(f32*, &action.colors[i].clear_value));
            {
                if _sg.stats_enabled != 0 {
                    _sg.stats.cur_frame.d3d11.pass.num_clear_render_target_view++;
                }
            }
        }
    }
    UINT ds_flags = 0;
    if action.depth.load_action == SG_LOADACTION_CLEAR {
        ds_flags |= cast(u32, D3D11_CLEAR_DEPTH);
    }
    if action.stencil.load_action == SG_LOADACTION_CLEAR {
        ds_flags |= cast(u32, D3D11_CLEAR_STENCIL);
    }
    if 0 != ds_flags && dsv {
        _sg_d3d11_ClearDepthStencilView(_sg.d3d11.ctx, dsv, ds_flags, action.depth.clear_value, action.stencil.clear_value);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pass.num_clear_depth_stencil_view++;
            }
        }
    }
}

UINT _sg_d3d11_calcsubresource(UINT mip_slice, UINT array_slice, UINT mip_levels) {
    return mip_slice + array_slice * mip_levels;
}

void _sg_d3d11_end_pass(_sg_attachments_ptrs_t* atts) {
    assert(_sg.d3d11.ctx && atts);
    if _sg.cur_pass.is_compute == 0 {
        if atts.empty == 0 {
            for i32 i = 0; i < atts.num_color_views; i++ {
                _sg_view_t* resolve_view = atts.resolve_views[i];
                if resolve_view != null {
                    _sg_image_t* resolve_img = _sg_image_ref_ptr(&resolve_view.cmn.img.ref);
                    _sg_view_t* color_view = atts.color_views[i];
                    assert(cast(i64, color_view));
                    _sg_image_t* color_img = _sg_image_ref_ptr(&color_view.cmn.img.ref);
                    assert(color_img.cmn.sample_count > 1);
                    assert(resolve_img.cmn.sample_count == 1);
                    UINT src_subres = _sg_d3d11_calcsubresource(cast(UINT, color_view.cmn.img.mip_level), cast(UINT, color_view.cmn.img.slice), cast(UINT, color_img.cmn.num_mipmaps));
                    UINT dst_subres = _sg_d3d11_calcsubresource(cast(UINT, resolve_view.cmn.img.mip_level), cast(UINT, resolve_view.cmn.img.slice), cast(UINT, resolve_img.cmn.num_mipmaps));
                    _sg_d3d11_ResolveSubresource(_sg.d3d11.ctx, resolve_img.d3d11.res, dst_subres, color_img.d3d11.res, src_subres, _sg_d3d11_rtv_uav_pixel_format(color_img.cmn.pixel_format));
                    {
                        if _sg.stats_enabled != 0 {
                            _sg.stats.cur_frame.d3d11.pass.num_resolve_subresource++;
                        }
                    }
                }
            }
        } else {
            if _sg.d3d11.cur_swapchain.resolve_view != null {
                assert(cast(i64, _sg.d3d11.cur_swapchain.render_view));
                assert(_sg.cur_pass.swapchain.sample_count > 1);
                assert(_sg.cur_pass.swapchain.color_fmt > SG_PIXELFORMAT_NONE);
                ID3D11Resource* d3d11_render_res = null;
                ID3D11Resource* d3d11_resolve_res = null;
                _sg_d3d11_GetResource(cast(ID3D11View*, _sg.d3d11.cur_swapchain.render_view), &d3d11_render_res);
                _sg_d3d11_GetResource(cast(ID3D11View*, _sg.d3d11.cur_swapchain.resolve_view), &d3d11_resolve_res);
                assert(cast(i64, d3d11_render_res));
                assert(cast(i64, d3d11_resolve_res));
                sg_pixel_format color_fmt = _sg.cur_pass.swapchain.color_fmt;
                _sg_d3d11_ResolveSubresource(_sg.d3d11.ctx, d3d11_resolve_res, 0, d3d11_render_res, 0, _sg_d3d11_rtv_uav_pixel_format(color_fmt));
                d3d11_render_res.lpVtbl.Release(d3d11_render_res);
                d3d11_resolve_res.lpVtbl.Release(d3d11_resolve_res);
                {
                    if _sg.stats_enabled != 0 {
                        _sg.stats.cur_frame.d3d11.pass.num_resolve_subresource++;
                    }
                }
            }
        }
    }
    _sg.d3d11.cur_swapchain.render_view = null;
    _sg.d3d11.cur_swapchain.resolve_view = null;
    _sg_d3d11_clear_state();
}

void _sg_d3d11_apply_viewport(i32 x, i32 y, i32 w, i32 h, bool origin_top_left) {
    assert(cast(i64, _sg.d3d11.ctx));
    noinit D3D11_VIEWPORT vp;
    vp.TopLeftX = cast(FLOAT, x);
    vp.TopLeftY = cast(FLOAT, origin_top_left != 0 ? y : _sg.cur_pass.dim.height - (y + h));
    vp.Width = cast(FLOAT, w);
    vp.Height = cast(FLOAT, h);
    vp.MinDepth = 0.0f;
    vp.MaxDepth = 1.0f;
    _sg_d3d11_RSSetViewports(_sg.d3d11.ctx, 1, &vp);
}

void _sg_d3d11_apply_scissor_rect(i32 x, i32 y, i32 w, i32 h, bool origin_top_left) {
    assert(cast(i64, _sg.d3d11.ctx));
    noinit D3D11_RECT rect;
    rect.left = x;
    rect.top = origin_top_left != 0 ? y : _sg.cur_pass.dim.height - (y + h);
    rect.right = x + w;
    rect.bottom = origin_top_left != 0 ? y + h : _sg.cur_pass.dim.height - y;
    _sg_d3d11_RSSetScissorRects(_sg.d3d11.ctx, 1, &rect);
}

void _sg_d3d11_apply_pipeline(_sg_pipeline_t* pip) {
    assert(cast(i64, pip));
    assert(cast(i64, _sg.d3d11.ctx));
    _sg_shader_t* shd = _sg_shader_ref_ptr(&pip.cmn.shader);
    if pip.cmn.is_compute != 0 {
        assert(cast(i64, shd.d3d11.cs));
        _sg_d3d11_CSSetShader(_sg.d3d11.ctx, shd.d3d11.cs, null, 0);
        _sg_d3d11_CSSetConstantBuffers(_sg.d3d11.ctx, 0, cast(UINT, _SG_MAX_UNIFORMBLOCK_BINDINGS_PER_STAGE), shd.d3d11.cs_cbufs);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_cs_set_shader++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_cs_set_constant_buffers++;
            }
        }
    } else {
        assert(pip.d3d11.rs && pip.d3d11.bs && pip.d3d11.dss);
        assert(cast(i64, shd.d3d11.vs));
        assert(cast(i64, shd.d3d11.fs));
        _sg_d3d11_RSSetState(_sg.d3d11.ctx, pip.d3d11.rs);
        _sg_d3d11_OMSetDepthStencilState(_sg.d3d11.ctx, pip.d3d11.dss, pip.d3d11.stencil_ref);
        _sg_d3d11_OMSetBlendState(_sg.d3d11.ctx, pip.d3d11.bs, cast(f32*, &pip.cmn.blend_color), 0xFFFFFFFF);
        _sg_d3d11_IASetPrimitiveTopology(_sg.d3d11.ctx, pip.d3d11.topology);
        _sg_d3d11_IASetInputLayout(_sg.d3d11.ctx, pip.d3d11.il);
        _sg_d3d11_VSSetShader(_sg.d3d11.ctx, shd.d3d11.vs, null, 0);
        _sg_d3d11_VSSetConstantBuffers(_sg.d3d11.ctx, 0, cast(UINT, _SG_MAX_UNIFORMBLOCK_BINDINGS_PER_STAGE), shd.d3d11.vs_cbufs);
        _sg_d3d11_PSSetShader(_sg.d3d11.ctx, shd.d3d11.fs, null, 0);
        _sg_d3d11_PSSetConstantBuffers(_sg.d3d11.ctx, 0, cast(UINT, _SG_MAX_UNIFORMBLOCK_BINDINGS_PER_STAGE), shd.d3d11.fs_cbufs);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_rs_set_state++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_om_set_depth_stencil_state++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_om_set_blend_state++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_ia_set_primitive_topology++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_ia_set_input_layout++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_vs_set_shader++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_vs_set_constant_buffers++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_ps_set_shader++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.pipeline.num_ps_set_constant_buffers++;
            }
        }
    }
}

bool _sg_d3d11_apply_bindings(_sg_bindings_ptrs_t* bnd) {
    assert(cast(i64, bnd));
    assert(cast(i64, bnd.pip));
    assert(cast(i64, _sg.d3d11.ctx));
    _sg_shader_t* shd = _sg_shader_ref_ptr(&bnd.pip.cmn.shader);
    bool is_compute = bnd.pip.cmn.is_compute;
    if is_compute != 0 {
        _sg_clear(&_sg.d3d11.bnd.cs_srvs, cast(u64, sizeof(_sg.d3d11.bnd.cs_srvs)));
        _sg_clear(&_sg.d3d11.bnd.cs_uavs, cast(u64, sizeof(_sg.d3d11.bnd.cs_uavs)));
        _sg_clear(&_sg.d3d11.bnd.cs_smps, cast(u64, sizeof(_sg.d3d11.bnd.cs_smps)));
    } else {
        _sg_clear(&_sg.d3d11.bnd.vbs, cast(u64, sizeof(_sg.d3d11.bnd.vbs)));
        _sg_clear(&_sg.d3d11.bnd.vb_offsets, cast(u64, sizeof(_sg.d3d11.bnd.vb_offsets)));
        _sg_clear(&_sg.d3d11.bnd.vs_srvs, cast(u64, sizeof(_sg.d3d11.bnd.vs_srvs)));
        _sg_clear(&_sg.d3d11.bnd.fs_srvs, cast(u64, sizeof(_sg.d3d11.bnd.fs_srvs)));
        _sg_clear(&_sg.d3d11.bnd.vs_smps, cast(u64, sizeof(_sg.d3d11.bnd.vs_smps)));
        _sg_clear(&_sg.d3d11.bnd.fs_smps, cast(u64, sizeof(_sg.d3d11.bnd.fs_smps)));
    }
    ID3D11Buffer* d3d11_ib = bnd.ib != null ? bnd.ib.d3d11.buf : null;
    if is_compute != 0 {
        _sg_d3d11_CSSetShaderResources(_sg.d3d11.ctx, 0, cast(UINT, SG_MAX_VIEW_BINDSLOTS), _sg.d3d11.bnd.cs_srvs);
    } else {
        for u64 i = 0; i < cast(u64, SG_MAX_VERTEXBUFFER_BINDSLOTS); i++ {
            _sg_buffer_t* vb = bnd.vbs[i];
            if vb == null {
                continue;
            }
            assert(cast(i64, vb.d3d11.buf));
            _sg.d3d11.bnd.vbs[i] = vb.d3d11.buf;
            _sg.d3d11.bnd.vb_offsets[i] = cast(UINT, bnd.vb_offsets[i]);
        }
    }
    for u64 i = 0; i < cast(u64, SG_MAX_VIEW_BINDSLOTS); i++ {
        _sg_view_t* view = bnd.views[i];
        if null == view {
            continue;
        }
        _sg_shader_view_t* shd_view = &shd.cmn.views[i];
        sg_shader_stage stage = shd_view.stage;
        assert(stage == SG_SHADERSTAGE_VERTEX || stage == SG_SHADERSTAGE_FRAGMENT || stage == SG_SHADERSTAGE_COMPUTE);
        assert(shd_view.view_type == SG_VIEWTYPE_TEXTURE || shd_view.view_type == SG_VIEWTYPE_STORAGEBUFFER || shd_view.view_type == SG_VIEWTYPE_STORAGEIMAGE);
        if shd_view.view_type == SG_VIEWTYPE_TEXTURE {
            u8 d3d11_slot = shd.d3d11.view_register_t_n[i];
            assert(cast(i32, d3d11_slot) < SG_MAX_VIEW_BINDSLOTS);
            ID3D11ShaderResourceView* d3d11_srv = view.d3d11.srv;
            assert(cast(i64, d3d11_srv));
            switch stage {
                case SG_SHADERSTAGE_VERTEX: {
                    _sg.d3d11.bnd.vs_srvs[d3d11_slot] = d3d11_srv;
                }
                case SG_SHADERSTAGE_FRAGMENT: {
                    _sg.d3d11.bnd.fs_srvs[d3d11_slot] = d3d11_srv;
                }
                case SG_SHADERSTAGE_COMPUTE: {
                    _sg.d3d11.bnd.cs_srvs[d3d11_slot] = d3d11_srv;
                }
                default: {
                    assert(cast(i64, false));
                }
            }
        } else if shd_view.view_type == SG_VIEWTYPE_STORAGEBUFFER {
            if shd.cmn.views[i].sbuf_readonly != 0 {
                u8 d3d11_slot = shd.d3d11.view_register_t_n[i];
                assert(cast(i32, d3d11_slot) < SG_MAX_VIEW_BINDSLOTS);
                ID3D11ShaderResourceView* d3d11_srv = view.d3d11.srv;
                assert(cast(i64, d3d11_srv));
                switch stage {
                    case SG_SHADERSTAGE_VERTEX: {
                        _sg.d3d11.bnd.vs_srvs[d3d11_slot] = d3d11_srv;
                    }
                    case SG_SHADERSTAGE_FRAGMENT: {
                        _sg.d3d11.bnd.fs_srvs[d3d11_slot] = d3d11_srv;
                    }
                    case SG_SHADERSTAGE_COMPUTE: {
                        _sg.d3d11.bnd.cs_srvs[d3d11_slot] = d3d11_srv;
                    }
                    default: {
                        assert(cast(i64, false));
                    }
                }
            } else {
                assert(stage == SG_SHADERSTAGE_COMPUTE);
                u8 d3d11_slot = shd.d3d11.view_register_u_n[i];
                assert(cast(i32, d3d11_slot) < _sg.limits.d3d11_max_unordered_access_views);
                ID3D11UnorderedAccessView* d3d11_uav = view.d3d11.uav;
                assert(cast(i64, d3d11_uav));
                _sg.d3d11.bnd.cs_uavs[d3d11_slot] = d3d11_uav;
            }
        } else if shd_view.view_type == SG_VIEWTYPE_STORAGEIMAGE {
            assert(stage == SG_SHADERSTAGE_COMPUTE);
            u8 d3d11_slot = shd.d3d11.view_register_u_n[i];
            assert(cast(i32, d3d11_slot) < _sg.limits.d3d11_max_unordered_access_views);
            ID3D11UnorderedAccessView* d3d11_uav = view.d3d11.uav;
            assert(cast(i64, d3d11_uav));
            _sg.d3d11.bnd.cs_uavs[d3d11_slot] = d3d11_uav;
        } else {
            assert(cast(i64, false));
        }
    }
    for u64 i = 0; i < cast(u64, SG_MAX_SAMPLER_BINDSLOTS); i++ {
        _sg_sampler_t* smp = bnd.smps[i];
        if smp == null {
            continue;
        }
        sg_shader_stage stage = shd.cmn.samplers[i].stage;
        assert(stage != SG_SHADERSTAGE_NONE);
        u8 d3d11_slot = shd.d3d11.smp_register_s_n[i];
        assert(cast(i32, d3d11_slot) < SG_MAX_SAMPLER_BINDSLOTS);
        assert(cast(i64, smp.d3d11.smp));
        ID3D11SamplerState* d3d11_smp = smp.d3d11.smp;
        switch stage {
            case SG_SHADERSTAGE_VERTEX: {
                _sg.d3d11.bnd.vs_smps[d3d11_slot] = d3d11_smp;
            }
            case SG_SHADERSTAGE_FRAGMENT: {
                _sg.d3d11.bnd.fs_smps[d3d11_slot] = d3d11_smp;
            }
            case SG_SHADERSTAGE_COMPUTE: {
                _sg.d3d11.bnd.cs_smps[d3d11_slot] = d3d11_smp;
            }
            default: {
                assert(cast(i64, false));
            }
        }
    }
    if is_compute != 0 {
        assert(_sg.limits.d3d11_max_unordered_access_views <= SG_MAX_VIEW_BINDSLOTS);
        _sg_d3d11_CSSetUnorderedAccessViews(_sg.d3d11.ctx, 0, cast(UINT, _sg.limits.d3d11_max_unordered_access_views), _sg.d3d11.bnd.cs_uavs, null);
        _sg_d3d11_CSSetShaderResources(_sg.d3d11.ctx, 0, cast(UINT, SG_MAX_VIEW_BINDSLOTS), _sg.d3d11.bnd.cs_srvs);
        _sg_d3d11_CSSetSamplers(_sg.d3d11.ctx, 0, cast(UINT, SG_MAX_SAMPLER_BINDSLOTS), _sg.d3d11.bnd.cs_smps);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.bindings.num_cs_set_shader_resources++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.bindings.num_cs_set_samplers++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.bindings.num_cs_set_unordered_access_views++;
            }
        }
    } else {
        _sg_d3d11_IASetVertexBuffers(_sg.d3d11.ctx, 0, cast(UINT, SG_MAX_VERTEXBUFFER_BINDSLOTS), _sg.d3d11.bnd.vbs, bnd.pip.d3d11.vb_strides, _sg.d3d11.bnd.vb_offsets);
        _sg_d3d11_IASetIndexBuffer(_sg.d3d11.ctx, d3d11_ib, bnd.pip.d3d11.index_format, cast(UINT, bnd.ib_offset));
        _sg_d3d11_VSSetShaderResources(_sg.d3d11.ctx, 0, cast(UINT, SG_MAX_VIEW_BINDSLOTS), _sg.d3d11.bnd.vs_srvs);
        _sg_d3d11_PSSetShaderResources(_sg.d3d11.ctx, 0, cast(UINT, SG_MAX_VIEW_BINDSLOTS), _sg.d3d11.bnd.fs_srvs);
        _sg_d3d11_VSSetSamplers(_sg.d3d11.ctx, 0, cast(UINT, SG_MAX_SAMPLER_BINDSLOTS), _sg.d3d11.bnd.vs_smps);
        _sg_d3d11_PSSetSamplers(_sg.d3d11.ctx, 0, cast(UINT, SG_MAX_SAMPLER_BINDSLOTS), _sg.d3d11.bnd.fs_smps);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.bindings.num_ia_set_vertex_buffers++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.bindings.num_ia_set_index_buffer++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.bindings.num_vs_set_shader_resources++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.bindings.num_ps_set_shader_resources++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.bindings.num_vs_set_samplers++;
            }
        }
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.bindings.num_ps_set_samplers++;
            }
        }
    }
    return true;
}

void _sg_d3d11_apply_uniforms(i32 ub_slot, sg_range* data) {
    assert(cast(i64, _sg.d3d11.ctx));
    assert(ub_slot >= 0 && ub_slot < SG_MAX_UNIFORMBLOCK_BINDSLOTS);
    _sg_pipeline_t* pip = _sg_pipeline_ref_ptr(&_sg.cur_pip);
    _sg_shader_t* shd = _sg_shader_ref_ptr(&pip.cmn.shader);
    assert(data.size == shd.cmn.uniform_blocks[ub_slot].size);
    ID3D11Buffer* cbuf = shd.d3d11.all_cbufs[ub_slot];
    assert(cast(i64, cbuf));
    _sg_d3d11_UpdateSubresource(_sg.d3d11.ctx, cast(ID3D11Resource*, cbuf), 0, null, data.ptr, 0, 0);
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.d3d11.uniforms.num_update_subresource++;
        }
    }
}

void _sg_d3d11_draw(i32 base_element, i32 num_elements, i32 num_instances, i32 base_vertex, i32 base_instance) {
    bool use_instanced_draw = num_instances > 1 || _sg.use_instanced_draw;
    if _sg.use_indexed_draw != 0 {
        if use_instanced_draw != 0 {
            _sg_d3d11_DrawIndexedInstanced(_sg.d3d11.ctx, cast(UINT, num_elements), cast(UINT, num_instances), cast(UINT, base_element), base_vertex, cast(UINT, base_instance));
            {
                if _sg.stats_enabled != 0 {
                    _sg.stats.cur_frame.d3d11.draw.num_draw_indexed_instanced++;
                }
            }
        } else {
            _sg_d3d11_DrawIndexed(_sg.d3d11.ctx, cast(UINT, num_elements), cast(UINT, base_element), base_vertex);
            {
                if _sg.stats_enabled != 0 {
                    _sg.stats.cur_frame.d3d11.draw.num_draw_indexed++;
                }
            }
        }
    } else {
        if use_instanced_draw != 0 {
            _sg_d3d11_DrawInstanced(_sg.d3d11.ctx, cast(UINT, num_elements), cast(UINT, num_instances), cast(UINT, base_element), cast(UINT, base_instance));
            {
                if _sg.stats_enabled != 0 {
                    _sg.stats.cur_frame.d3d11.draw.num_draw_instanced++;
                }
            }
        } else {
            _sg_d3d11_Draw(_sg.d3d11.ctx, cast(UINT, num_elements), cast(UINT, base_element));
            {
                if _sg.stats_enabled != 0 {
                    _sg.stats.cur_frame.d3d11.draw.num_draw++;
                }
            }
        }
    }
}

void _sg_d3d11_dispatch(i32 num_groups_x, i32 num_groups_y, i32 num_groups_z) {
    _sg_d3d11_Dispatch(_sg.d3d11.ctx, cast(UINT, num_groups_x), cast(UINT, num_groups_y), cast(UINT, num_groups_z));
}

void _sg_d3d11_commit() {
}

void _sg_d3d11_update_buffer(_sg_buffer_t* buf, sg_range* data) {
    assert(buf && data && data.ptr && data.size > 0);
    assert(cast(i64, _sg.d3d11.ctx));
    assert(cast(i64, buf.d3d11.buf));
    noinit D3D11_MAPPED_SUBRESOURCE d3d11_msr;
    HRESULT hr = _sg_d3d11_Map(_sg.d3d11.ctx, cast(ID3D11Resource*, buf.d3d11.buf), 0, D3D11_MAP_WRITE_DISCARD, 0, &d3d11_msr);
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.d3d11.num_map++;
        }
    }
    if hr >= 0 {
        memcpy(d3d11_msr.pData, data.ptr, data.size);
        _sg_d3d11_Unmap(_sg.d3d11.ctx, cast(ID3D11Resource*, buf.d3d11.buf), 0);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.num_unmap++;
            }
        }
    } else {
        _sg_log(SG_LOGITEM_D3D11_MAP_FOR_UPDATE_BUFFER_FAILED, 1, null, 7222);
    }
}

void _sg_d3d11_append_buffer(_sg_buffer_t* buf, sg_range* data, bool new_frame) {
    assert(buf && data && data.ptr && data.size > 0);
    assert(cast(i64, _sg.d3d11.ctx));
    assert(cast(i64, buf.d3d11.buf));
    D3D11_MAP map_type = new_frame != 0 ? D3D11_MAP_WRITE_DISCARD : D3D11_MAP_WRITE_NO_OVERWRITE;
    noinit D3D11_MAPPED_SUBRESOURCE d3d11_msr;
    HRESULT hr = _sg_d3d11_Map(_sg.d3d11.ctx, cast(ID3D11Resource*, buf.d3d11.buf), 0, map_type, 0, &d3d11_msr);
    {
        if _sg.stats_enabled != 0 {
            _sg.stats.cur_frame.d3d11.num_map++;
        }
    }
    if hr >= 0 {
        u8* dst_ptr = cast(u8*, d3d11_msr.pData) + buf.cmn.append_pos;
        memcpy(dst_ptr, data.ptr, data.size);
        _sg_d3d11_Unmap(_sg.d3d11.ctx, cast(ID3D11Resource*, buf.d3d11.buf), 0);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.d3d11.num_unmap++;
            }
        }
    } else {
        _sg_log(SG_LOGITEM_D3D11_MAP_FOR_APPEND_BUFFER_FAILED, 1, null, 7222);
    }
}

void _sg_d3d11_update_image(_sg_image_t* img, sg_image_data* data) {
    assert(img && data);
    assert(cast(i64, _sg.d3d11.ctx));
    assert(cast(i64, img.d3d11.res));
    i32 num_slices = img.cmn.type == SG_IMAGETYPE_3D ? 1 : img.cmn.num_slices;
    i32 num_depth_slices = img.cmn.type == SG_IMAGETYPE_3D ? img.cmn.num_slices : 1;
    UINT subres_index = 0;
    HRESULT hr;
    noinit D3D11_MAPPED_SUBRESOURCE d3d11_msr;
    for i32 slice_index = 0; slice_index < num_slices; slice_index++ {
        for i32 mip_index = 0; mip_index < img.cmn.num_mipmaps; mip_index++ {
            assert(subres_index < cast(u32, SG_MAX_MIPMAPS * 2048));
            i32 mip_width = _sg_miplevel_dim(img.cmn.width, mip_index);
            i32 mip_height = _sg_miplevel_dim(img.cmn.height, mip_index);
            i32 src_row_pitch = _sg_row_pitch(img.cmn.pixel_format, mip_width, 1);
            i32 src_depth_pitch = _sg_surface_pitch(img.cmn.pixel_format, mip_width, mip_height, 1);
            sg_range* miplevel_data = &data.mip_levels[mip_index];
            u64 slice_size = miplevel_data.size / cast(u64, num_slices);
            assert(slice_size == cast(u64, src_depth_pitch * num_depth_slices));
            u64 slice_offset = slice_size * cast(u64, slice_index);
            u8* slice_ptr = cast(u8*, miplevel_data.ptr) + slice_offset;
            hr = _sg_d3d11_Map(_sg.d3d11.ctx, img.d3d11.res, subres_index, D3D11_MAP_WRITE_DISCARD, 0, &d3d11_msr);
            {
                if _sg.stats_enabled != 0 {
                    _sg.stats.cur_frame.d3d11.num_map++;
                }
            }
            if hr >= 0 {
                u8* src_ptr = slice_ptr;
                var dst_ptr = cast(u8*, d3d11_msr.pData);
                for i32 depth_index = 0; depth_index < num_depth_slices; depth_index++ {
                    if src_row_pitch == cast(i32, d3d11_msr.RowPitch) {
                        u64 copy_size = slice_size / cast(u64, num_depth_slices);
                        assert(copy_size * cast(u64, num_depth_slices) == slice_size);
                        memcpy(dst_ptr, src_ptr, copy_size);
                    } else {
                        assert(src_row_pitch < cast(i32, d3d11_msr.RowPitch));
                        u8* src_row_ptr = src_ptr;
                        u8* dst_row_ptr = dst_ptr;
                        for i32 row_index = 0; row_index < mip_height; row_index++ {
                            memcpy(dst_row_ptr, src_row_ptr, cast(u64, src_row_pitch));
                            src_row_ptr += src_row_pitch;
                            dst_row_ptr += d3d11_msr.RowPitch;
                        }
                    }
                    src_ptr += src_depth_pitch;
                    dst_ptr += d3d11_msr.DepthPitch;
                }
                _sg_d3d11_Unmap(_sg.d3d11.ctx, img.d3d11.res, subres_index);
                {
                    if _sg.stats_enabled != 0 {
                        _sg.stats.cur_frame.d3d11.num_unmap++;
                    }
                }
            } else {
                _sg_log(SG_LOGITEM_D3D11_MAP_FOR_UPDATE_IMAGE_FAILED, 1, null, 7222);
            }
            subres_index++;
        }
    }
}

void _sg_d3d11_write_miplevel_data(_sg_image_t* img, ID3D11Resource* d3d11_res, u8* src_ptr, u64 src_size, u64 src_offset, i32 src_bytes_per_row, i32 src_bytes_per_slice, i32 mip_level, i32 x, i32 y, i32 slice, i32 width, i32 height, i32 num_slices) {
    assert(cast(i64, img));
    assert(cast(i64, d3d11_res));
    assert(cast(i64, src_ptr));
    assert(src_size > 0);
    assert(src_bytes_per_row > 0);
    assert(src_bytes_per_slice > 0);
    assert(mip_level >= 0 && mip_level < img.cmn.num_mipmaps);
    assert(x >= 0 && x < _sg_miplevel_dim(img.cmn.width, mip_level));
    assert(y >= 0 && y < _sg_miplevel_dim(img.cmn.height, mip_level));
    assert(slice >= 0 && slice < img.cmn.num_slices);
    assert(width > 0 && x + width <= _sg_miplevel_dim(img.cmn.width, mip_level));
    assert(height > 0 && y + height <= _sg_miplevel_dim(img.cmn.height, mip_level));
    assert(num_slices > 0 && slice + num_slices <= img.cmn.num_slices);
    assert(src_offset + cast(u64, src_bytes_per_slice) * cast(u64, num_slices) <= src_size);
    assert(cast(i64, _sg_multiple(src_bytes_per_row, _sg_block_bytesize(img.cmn.pixel_format))));
    assert(cast(i64, _sg_multiple(src_bytes_per_slice, src_bytes_per_row)));
    ignore src_size;
    var d3d11_src_row_pitch = cast(UINT, src_bytes_per_row);
    UINT d3d11_src_depth_pitch = 0;
    i32 d3d11_slice = 0;
    i32 d3d11_num_slices = 0;
    D3D11_BOX d3d11_dst_box;
    d3d11_dst_box.left = cast(UINT, x);
    d3d11_dst_box.right = cast(UINT, x + width);
    d3d11_dst_box.top = cast(UINT, y);
    d3d11_dst_box.bottom = cast(UINT, y + height);
    if img.cmn.type == SG_IMAGETYPE_3D {
        d3d11_slice = 0;
        d3d11_num_slices = 1;
        d3d11_dst_box.front = cast(UINT, slice);
        d3d11_dst_box.back = cast(UINT, slice + num_slices);
        d3d11_src_depth_pitch = cast(UINT, src_bytes_per_slice);
    } else {
        d3d11_slice = slice;
        d3d11_num_slices = num_slices;
        d3d11_dst_box.front = 0;
        d3d11_dst_box.back = 1;
        d3d11_src_depth_pitch = 0;
    }
    for i32 i = 0; i < d3d11_num_slices; i++ {
        var d3d11_src_ptr = cast(void*, src_ptr + src_offset + i * src_bytes_per_slice);
        UINT d3d11_subres = _sg_d3d11_calcsubresource(cast(UINT, mip_level), cast(UINT, d3d11_slice + i), cast(UINT, img.cmn.num_mipmaps));
        _sg_d3d11_UpdateSubresource(_sg.d3d11.ctx, d3d11_res, d3d11_subres, &d3d11_dst_box, d3d11_src_ptr, d3d11_src_row_pitch, d3d11_src_depth_pitch);
    }
}

void _sg_d3d11_write_buffer_unsealed(_sg_buffer_t* buf, sg_write_buffer_desc* desc) {
    assert(cast(i64, _sg.d3d11.ctx));
    assert(buf && desc);
    assert(SG_RESOURCESTATE_UNSEALED == buf.slot.state);
    assert(desc.src.data.ptr && desc.src.data.size > 0);
    assert(desc.dst.offset + desc.size <= cast(u64, buf.cmn.size));
    assert(desc.src.offset + desc.size <= desc.src.data.size);
    var d3d11_buf = cast(ID3D11Resource*, buf.d3d11.buf);
    assert(cast(i64, d3d11_buf));
    D3D11_BOX d3d11_dst_box;
    d3d11_dst_box.left = cast(UINT, desc.dst.offset);
    d3d11_dst_box.right = d3d11_dst_box.left + cast(UINT, desc.size);
    d3d11_dst_box.back = 1;
    d3d11_dst_box.bottom = 1;
    var d3d11_src_ptr = cast(void*, cast(u8*, desc.src.data.ptr) + desc.src.offset);
    _sg_d3d11_UpdateSubresource(_sg.d3d11.ctx, d3d11_buf, 0, &d3d11_dst_box, d3d11_src_ptr, 0, 0);
}

void _sg_d3d11_write_image_unsealed(_sg_image_t* img, sg_write_image_desc* desc) {
    assert(img && desc);
    assert(SG_RESOURCESTATE_UNSEALED == img.slot.state);
    ID3D11Resource* d3d11_res = img.d3d11.res;
    _sg_d3d11_write_miplevel_data(img, d3d11_res, cast(u8*, desc.src.data.ptr), desc.src.data.size, desc.src.offset, desc.src.bytes_per_row, desc.src.bytes_per_slice, desc.dst.mip_level, desc.dst.x, desc.dst.y, desc.dst.slice, desc.size.width, desc.size.height, desc.size.num_slices);
}

