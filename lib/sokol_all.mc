/* iOS entry function */
void _sapp_ios_app_event(sapp_event_type type) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        _sapp_call_event(&_sapp.event);
    }
}

void _sapp_tvos_press_event(sapp_event_type type, NSSet* presses) {
    if _sapp_events_enabled() != 0 {
        {
            ObjcId __fe_enum_27 = objc.msg_id_v(presses, objc_selref("objectEnumerator"));
            ObjcId press = objc.msg_id_v(__fe_enum_27, objc_selref("nextObject"));
            while press != null {
                {
                    sapp_keycode key = SAPP_KEYCODE_INVALID;
                    switch cast(fn(void*, void*): i64, objc.raw)(press, objc_selref("type")) {
                        case UIPressTypeUpArrow: {
                            key = SAPP_KEYCODE_UP;
                        }
                        case UIPressTypeDownArrow: {
                            key = SAPP_KEYCODE_DOWN;
                        }
                        case UIPressTypeLeftArrow: {
                            key = SAPP_KEYCODE_LEFT;
                        }
                        case UIPressTypeRightArrow: {
                            key = SAPP_KEYCODE_RIGHT;
                        }
                        case UIPressTypeSelect: {
                            key = SAPP_KEYCODE_ENTER;
                        }
                        case UIPressTypeMenu: {
                            key = SAPP_KEYCODE_MENU;
                        }
                        case UIPressTypePlayPause: {
                            key = SAPP_KEYCODE_PAUSE;
                        }
                        default: {
                        }
                    }
                    if key != SAPP_KEYCODE_INVALID {
                        _sapp_init_event(type);
                        _sapp.event.key_code = key;
                        _sapp.event.key_repeat = false;
                        _sapp.event.modifiers = 0;
                        _sapp_call_event(&_sapp.event);
                    }
                }
                press = objc.msg_id_v(__fe_enum_27, objc_selref("nextObject"));
            }
        }
    }
}

void _sapp_ios_touch_event(sapp_event_type type, NSSet* touches, UIEvent* event) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        NSEnumerator* enumerator = objc.msg_id_v(objc.msg_id_v(event, objc_selref("allTouches")), objc_selref("objectEnumerator"));
        UITouch* ios_touch;
        while true {
            ios_touch = objc.msg_id_v(enumerator, objc_selref("nextObject"));
            if ios_touch == null {
                break;
            }
            if _sapp.event.num_touches + 1 < SAPP_MAX_TOUCHPOINTS {
                CGPoint ios_pos = cast(fn(void*, void*, void*): NSPoint, objc.raw)(ios_touch, objc_selref("locationInView:"), _sapp.ios.view);
                sapp_touchpoint* cur_point = &_sapp.event.touches[_sapp.event.num_touches++];
                cur_point.identifier = cast(u64, ios_touch);
                cur_point.pos_x = cast(f32, cast(f32, ios_pos.x) * _sapp.dpi_scale);
                cur_point.pos_y = cast(f32, cast(f32, ios_pos.y) * _sapp.dpi_scale);
                cur_point.changed = cast(fn(void*, void*, void*): bool, objc.raw)(touches, objc_selref("containsObject:"), ios_touch);
            }
        }
        if _sapp.event.num_touches > 0 {
            _sapp_call_event(&_sapp.event);
        }
    }
}

void _sapp_ios_update_dimensions() {
    CGRect screen_rect = cast(fn(void*, void*): NSRect, objc.raw)(objc.msg_id_v(objc.msg_id_v(_sapp.ios.window, objc_selref("windowScene")), objc_selref("screen")), objc_selref("bounds"));
