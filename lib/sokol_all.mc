void _sg_mtl_write_miplevel_data(_sg_image_t* img, ObjcId mtl_tex, u8* src_ptr, u64 src_size, u64 src_offset, i32 src_bytes_per_row, i32 src_bytes_per_slice, i32 mip_level, i32 x, i32 y, i32 slice, i32 width, i32 height, i32 num_slices) {
    assert(cast(i64, img));
    assert(cast(i64, mtl_tex));
    assert(cast(i64, src_ptr));
    assert(src_size > 0);
    assert(src_bytes_per_row > 0);
    assert(src_bytes_per_slice > 0);
    assert(mip_level >= 0 && mip_level < img.cmn.num_mipmaps);
    assert(x >= 0 && x < _sg_miplevel_dim(img.cmn.width, mip_level));
    assert(y >= 0 && y < _sg_miplevel_dim(img.cmn.height, mip_level));
    assert(slice >= 0 && slice < img.cmn.num_slices);
    assert(width > 0 && x + width <= _sg_miplevel_dim(img.cmn.width, mip_level));
    assert(height > 0 && y + height <= _sg_miplevel_dim(img.cmn.height, mip_level));
    assert(num_slices > 0 && slice + num_slices <= img.cmn.num_slices);
    assert(src_offset + cast(u64, src_bytes_per_slice) * cast(u64, num_slices) <= src_size);
    assert(cast(i64, _sg_multiple(src_bytes_per_row, _sg_block_bytesize(img.cmn.pixel_format))));
    assert(cast(i64, _sg_multiple(src_bytes_per_slice, src_bytes_per_row)));
    ignore src_size;
    noinit MTLRegion mtl_region;
    i32 mtl_bytes_per_image;
    if img.cmn.type == SG_IMAGETYPE_3D {
        mtl_region = MTLRegionMake3D(cast(NSUInteger, x), cast(NSUInteger, y), cast(NSUInteger, slice), cast(NSUInteger, width), cast(NSUInteger, height), cast(NSUInteger, num_slices));
        mtl_bytes_per_image = src_bytes_per_slice;
    } else {
        mtl_region = MTLRegionMake2D(cast(NSUInteger, x), cast(NSUInteger, y), cast(NSUInteger, width), cast(NSUInteger, height));
        mtl_bytes_per_image = 0;
    }
    i32 mtl_slice_index = img.cmn.type == SG_IMAGETYPE_3D ? 0 : slice;
    i32 mtl_num_slices = img.cmn.type == SG_IMAGETYPE_3D ? 1 : num_slices;
    for i32 i = 0; i < mtl_num_slices; i++ {
        u64 offset = src_offset + cast(u64, i * src_bytes_per_slice);
        assert(offset + cast(u64, src_bytes_per_slice) <= src_size);
        cast(fn(void*, void*, MTLRegion, u64, u64, void*, u64, u64): void, objc.raw)(mtl_tex, objc_selref("replaceRegion:mipmapLevel:slice:withBytes:bytesPerRow:bytesPerImage:"), mtl_region, cast(u64, cast(NSUInteger, mip_level)), cast(u64, cast(NSUInteger, mtl_slice_index + i)), src_ptr + offset, cast(u64, cast(NSUInteger, src_bytes_per_row)), cast(u64, cast(NSUInteger, mtl_bytes_per_image)));
    }
