when os(windows) && defined(SOKOL_D3D11) {












































type DXGI_SWAP_EFFECT = i32;
type UINT8 = u8;
type DXGI_FORMAT = i32;
type D3D11_USAGE = i32;
type D3D11_BLEND = i32;
type D3D11_BLEND_OP = i32;
type D3D11_COMPARISON_FUNC = i32;
type D3D11_CULL_MODE = i32;
type D3D11_FILTER = i32;
type D3D11_MAP = i32;
type D3D11_STENCIL_OP = i32;
type D3D11_PRIMITIVE_TOPOLOGY = i32;
type D3D_PRIMITIVE_TOPOLOGY = i32;
type D3D11_TEXTURE_ADDRESS_MODE = i32;
type D3D11_INPUT_CLASSIFICATION = i32;
type D3D_FEATURE_LEVEL = i32;
type pD3DCompile = fn(void*, i64, u8*, void*, void*, u8*, u8*, u32, u32, void*, void*): i32;
type IID = GUID;
type REFIID = GUID*;
type ID3DBlob = ID3D10Blob;
type _sg_d3d11_buffer_t = _sg_buffer_s;
type _sg_buffer_t = _sg_d3d11_buffer_t;
type _sg_d3d11_image_t = _sg_image_s;
type _sg_image_t = _sg_d3d11_image_t;
type _sg_d3d11_sampler_t = _sg_sampler_s;
type _sg_sampler_t = _sg_d3d11_sampler_t;
type _sg_d3d11_shader_t = _sg_shader_s;
