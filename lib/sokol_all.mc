// Run once before sapp_run on iOS. Registers the ObjC scene-delegate / view
// classes so UIApplicationMain (reached via sapp_run) can instantiate them.
// No NSApp / menu (that's AppKit/macOS); iOS uses UIApplication. Returns 0.
i32 sokol_ios_boot() {
    objc_runtime_init();
    objc_register_classes();
    return 0;
}
