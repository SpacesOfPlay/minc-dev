}

DXGI_FORMAT _sapp_d3d11_swapchain_color_format() {
    if _sapp.desc.hdr != 0 {
        return DXGI_FORMAT_R16G16B16A16_FLOAT;
    } else {
        return DXGI_FORMAT_B8G8R8A8_UNORM;
    }
}

DXGI_FORMAT _sapp_d3d11_msaatex_color_format() {
    if _sapp.desc.hdr != 0 {
        return DXGI_FORMAT_R16G16B16A16_TYPELESS;
    } else {
        return DXGI_FORMAT_B8G8R8A8_TYPELESS;
    }
}

DXGI_FORMAT _sapp_d3d11_view_color_format() {
    if _sapp.desc.hdr != 0 {
        return DXGI_FORMAT_R16G16B16A16_FLOAT;
    } else {
        if _sapp.desc.srgb != 0 {
            return DXGI_FORMAT_B8G8R8A8_UNORM_SRGB;
        } else {
            return DXGI_FORMAT_B8G8R8A8_UNORM;
        }
    }
}

DXGI_FORMAT _sapp_d3d11_depth_format() {
    switch _sapp.desc.depth_format {
        case SAPP_PIXELFORMAT_DEPTH: {
            return DXGI_FORMAT_D32_FLOAT;
        }
        case SAPP_PIXELFORMAT_DEPTH_STENCIL: {
            return DXGI_FORMAT_D32_FLOAT_S8X24_UINT;
        }
        default: {
            assert(cast(i64, false));
            return DXGI_FORMAT_UNKNOWN;
        }
    }
}

void _sapp_d3d11_create_device_and_swapchain() {
    DXGI_SWAP_CHAIN_DESC* sc_desc = &_sapp.d3d11.swap_chain_desc;
    sc_desc.BufferDesc.Width = cast(UINT, _sapp.framebuffer_width);
    sc_desc.BufferDesc.Height = cast(UINT, _sapp.framebuffer_height);
    sc_desc.BufferDesc.Format = _sapp_d3d11_swapchain_color_format();
    sc_desc.BufferDesc.RefreshRate.Numerator = 60;
    sc_desc.BufferDesc.RefreshRate.Denominator = 1;
    sc_desc.OutputWindow = _sapp.win32.hwnd;
    sc_desc.Windowed = true;
    if _sapp.win32.is_win10_or_greater != 0 {
        sc_desc.BufferCount = 2;
        sc_desc.SwapEffect = cast(DXGI_SWAP_EFFECT, 4);
    } else {
        sc_desc.BufferCount = 1;
        sc_desc.SwapEffect = DXGI_SWAP_EFFECT_DISCARD;
    }
    sc_desc.SampleDesc.Count = 1;
    sc_desc.SampleDesc.Quality = 0;
    sc_desc.BufferUsage = cast(i32, DXGI_USAGE_RENDER_TARGET_OUTPUT);
    UINT create_flags = D3D11_CREATE_DEVICE_SINGLETHREADED | D3D11_CREATE_DEVICE_BGRA_SUPPORT;
    when defined(SOKOL_DEBUG) {
        create_flags |= cast(u32, D3D11_CREATE_DEVICE_DEBUG);
    }
    D3D_FEATURE_LEVEL[2] requested_feature_levels = {D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0};
    D3D_FEATURE_LEVEL result_feature_level;
    HRESULT hr = D3D11CreateDeviceAndSwapChain(null, D3D_DRIVER_TYPE_HARDWARE, null, create_flags, requested_feature_levels, 2, D3D11_SDK_VERSION, sc_desc, cast(void**, &_sapp.d3d11.swap_chain), cast(void**, &_sapp.d3d11.device), &result_feature_level, cast(void**, &_sapp.d3d11.device_context));
    ignore hr;
    when defined(SOKOL_DEBUG) {
        if hr >= 0 == 0 {
            _sapp_log(SAPP_LOGITEM_WIN32_D3D11_CREATE_DEVICE_AND_SWAPCHAIN_WITH_DEBUG_FAILED, 1, null, 3247);
            create_flags &= ~cast(UINT, D3D11_CREATE_DEVICE_DEBUG);
            hr = D3D11CreateDeviceAndSwapChain(null, D3D_DRIVER_TYPE_HARDWARE, null, create_flags, requested_feature_levels, 2, D3D11_SDK_VERSION, sc_desc, cast(void**, &_sapp.d3d11.swap_chain), cast(void**, &_sapp.d3d11.device), &result_feature_level, cast(void**, &_sapp.d3d11.device_context));
        }
    }
    assert(hr >= 0 && _sapp.d3d11.swap_chain && _sapp.d3d11.device && _sapp.d3d11.device_context);
    hr = _sapp_d3d11_QueryInterface(_sapp.d3d11.device, &_sapp_IID_IDXGIDevice1, cast(void**, &_sapp.d3d11.dxgi_device));
    if hr >= 0 && _sapp.d3d11.dxgi_device {
        _sapp_dxgi_SetMaximumFrameLatency(_sapp.d3d11.dxgi_device, 1);
        IDXGIAdapter* dxgi_adapter = null;
        hr = _sapp_dxgi_GetAdapter(_sapp.d3d11.dxgi_device, &dxgi_adapter);
        if hr >= 0 && dxgi_adapter {
            IDXGIFactory* dxgi_factory = null;
            hr = _sapp_dxgi_GetParent(cast(IDXGIObject*, dxgi_adapter), &_sapp_IID_IDXGIFactory, cast(void**, &dxgi_factory));
            if hr >= 0 {
                _sapp_dxgi_MakeWindowAssociation(dxgi_factory, _sapp.win32.hwnd, DXGI_MWA_NO_ALT_ENTER | DXGI_MWA_NO_PRINT_SCREEN);
                if dxgi_factory != null {
                    dxgi_factory.lpVtbl.Release(dxgi_factory);
                    dxgi_factory = null;
                }
            } else {
                _sapp_log(SAPP_LOGITEM_WIN32_D3D11_GET_IDXGIFACTORY_FAILED, 1, null, 3247);
            }
            if dxgi_adapter != null {
                dxgi_adapter.lpVtbl.Release(dxgi_adapter);
                dxgi_adapter = null;
            }
        } else {
            _sapp_log(SAPP_LOGITEM_WIN32_D3D11_GET_IDXGIADAPTER_FAILED, 1, null, 3247);
        }
    } else {
        _sapp_log(SAPP_LOGITEM_WIN32_D3D11_QUERY_INTERFACE_IDXGIDEVICE1_FAILED, 0, null, 3246);
    }
}

void _sapp_d3d11_destroy_device_and_swapchain() {
    if _sapp.d3d11.swap_chain != null {
        _sapp.d3d11.swap_chain.lpVtbl.Release(_sapp.d3d11.swap_chain);
        _sapp.d3d11.swap_chain = null;
    }
    if _sapp.d3d11.dxgi_device != null {
        _sapp.d3d11.dxgi_device.lpVtbl.Release(_sapp.d3d11.dxgi_device);
        _sapp.d3d11.dxgi_device = null;
    }
    if _sapp.d3d11.device_context != null {
        _sapp.d3d11.device_context.lpVtbl.Release(_sapp.d3d11.device_context);
        _sapp.d3d11.device_context = null;
    }
    if _sapp.d3d11.device != null {
        _sapp.d3d11.device.lpVtbl.Release(_sapp.d3d11.device);
        _sapp.d3d11.device = null;
    }
}

void _sapp_d3d11_create_default_render_target() {
    assert(null == _sapp.d3d11.rt);
    assert(null == _sapp.d3d11.rtv);
    assert(null == _sapp.d3d11.msaa_rt);
    assert(null == _sapp.d3d11.msaa_rtv);
    assert(null == _sapp.d3d11.ds);
    assert(null == _sapp.d3d11.dsv);
    HRESULT hr;
    ignore hr;
    bool wants_msaa = _sapp.desc.sample_count > 1;
    bool wants_depth = _sapp.desc.depth_format != SAPP_PIXELFORMAT_NONE;
    hr = _sapp_dxgi_GetBuffer(_sapp.d3d11.swap_chain, 0, &_sapp_IID_ID3D11Texture2D, cast(void**, &_sapp.d3d11.rt));
    assert(hr >= 0 && _sapp.d3d11.rt);
    D3D11_RENDER_TARGET_VIEW_DESC d3d11_rtv_desc;
    d3d11_rtv_desc.Format = _sapp_d3d11_view_color_format();
    if wants_msaa != 0 {
        d3d11_rtv_desc.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2DMS;
    } else {
        d3d11_rtv_desc.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2D;
    }
    hr = _sapp_d3d11_CreateRenderTargetView(_sapp.d3d11.device, cast(ID3D11Resource*, _sapp.d3d11.rt), &d3d11_rtv_desc, &_sapp.d3d11.rtv);
    assert(hr >= 0 && _sapp.d3d11.rtv);
    if wants_depth || wants_msaa {
        D3D11_TEXTURE2D_DESC tex_desc;
        tex_desc.Width = cast(UINT, _sapp.framebuffer_width);
        tex_desc.Height = cast(UINT, _sapp.framebuffer_height);
        tex_desc.MipLevels = 1;
        tex_desc.ArraySize = 1;
        tex_desc.Usage = D3D11_USAGE_DEFAULT;
        tex_desc.BindFlags = D3D11_BIND_RENDER_TARGET;
        tex_desc.SampleDesc.Count = cast(UINT, _sapp.desc.sample_count);
        tex_desc.SampleDesc.Quality = cast(u32, cast(UINT, wants_msaa) != 0 ? D3D11_STANDARD_MULTISAMPLE_PATTERN : 0);
        if wants_msaa != 0 {
            tex_desc.Format = _sapp_d3d11_msaatex_color_format();
            hr = _sapp_d3d11_CreateTexture2D(_sapp.d3d11.device, &tex_desc, null, &_sapp.d3d11.msaa_rt);
            assert(hr >= 0 && _sapp.d3d11.msaa_rt);
            hr = _sapp_d3d11_CreateRenderTargetView(_sapp.d3d11.device, cast(ID3D11Resource*, _sapp.d3d11.msaa_rt), &d3d11_rtv_desc, &_sapp.d3d11.msaa_rtv);
            assert(hr >= 0 && _sapp.d3d11.msaa_rtv);
        }
        if wants_depth != 0 {
            tex_desc.Format = _sapp_d3d11_depth_format();
            tex_desc.BindFlags = D3D11_BIND_DEPTH_STENCIL;
            hr = _sapp_d3d11_CreateTexture2D(_sapp.d3d11.device, &tex_desc, null, &_sapp.d3d11.ds);
            assert(hr >= 0 && _sapp.d3d11.ds);
            hr = _sapp_d3d11_CreateDepthStencilView(_sapp.d3d11.device, cast(ID3D11Resource*, _sapp.d3d11.ds), null, &_sapp.d3d11.dsv);
            assert(hr >= 0 && _sapp.d3d11.dsv);
        }
    }
}

void _sapp_d3d11_destroy_default_render_target() {
    if _sapp.d3d11.rt != null {
        _sapp.d3d11.rt.lpVtbl.Release(_sapp.d3d11.rt);
        _sapp.d3d11.rt = null;
    }
    if _sapp.d3d11.rtv != null {
        _sapp.d3d11.rtv.lpVtbl.Release(_sapp.d3d11.rtv);
        _sapp.d3d11.rtv = null;
    }
    if _sapp.d3d11.msaa_rt != null {
        _sapp.d3d11.msaa_rt.lpVtbl.Release(_sapp.d3d11.msaa_rt);
        _sapp.d3d11.msaa_rt = null;
    }
    if _sapp.d3d11.msaa_rtv != null {
        _sapp.d3d11.msaa_rtv.lpVtbl.Release(_sapp.d3d11.msaa_rtv);
        _sapp.d3d11.msaa_rtv = null;
    }
    if _sapp.d3d11.ds != null {
        _sapp.d3d11.ds.lpVtbl.Release(_sapp.d3d11.ds);
        _sapp.d3d11.ds = null;
    }
    if _sapp.d3d11.dsv != null {
        _sapp.d3d11.dsv.lpVtbl.Release(_sapp.d3d11.dsv);
        _sapp.d3d11.dsv = null;
    }
}

void _sapp_d3d11_resize_default_render_target() {
    if _sapp.d3d11.swap_chain != null {
        _sapp_d3d11_destroy_default_render_target();
        _sapp_dxgi_ResizeBuffers(_sapp.d3d11.swap_chain, _sapp.d3d11.swap_chain_desc.BufferCount, cast(UINT, _sapp.framebuffer_width), cast(UINT, _sapp.framebuffer_height), DXGI_FORMAT_B8G8R8A8_UNORM, 0);
        _sapp_d3d11_create_default_render_target();
    }
}

void _sapp_d3d11_present(bool from_winproc) {
    UINT flags = 0;
    var swap_interval = cast(UINT, _sapp.desc.swap_interval);
    if _sapp.win32.is_win10_or_greater != 0 {
        if _sapp.desc.disable_vsync || from_winproc {
            flags |= DXGI_PRESENT_DO_NOT_WAIT;
            swap_interval = 0;
        }
    }
    _sapp_dxgi_Present(_sapp.d3d11.swap_chain, swap_interval, flags);
}




























void _sapp_win32_frame(bool from_winproc) {
    _sapp_frame();
    _sapp_d3d11_present(from_winproc);
    if from_winproc == 0 {
        if IsIconic(_sapp.win32.hwnd) != 0 {
            Sleep(cast(DWORD, 16 * _sapp.desc.swap_interval));
        }
    }
}







void _sapp_win32_init_dpi() {
    SETPROCESSDPIAWARE_T fn_setprocessdpiaware = null;
    SETPROCESSDPIAWARENESS_T fn_setprocessdpiawareness = null;
    GETDPIFORMONITOR_T fn_getdpiformonitor = null;
    SETPROCESSDPIAWARENESSCONTEXT_T fn_setprocessdpiawarenesscontext = null;
    HINSTANCE user32 = LoadLibraryA("user32.dll");
    if user32 != null {
        fn_setprocessdpiaware = cast(SETPROCESSDPIAWARE_T, cast(void*, GetProcAddress(user32, "SetProcessDPIAware")));
        fn_setprocessdpiawarenesscontext = cast(SETPROCESSDPIAWARENESSCONTEXT_T, cast(void*, GetProcAddress(user32, "SetProcessDpiAwarenessContext")));
    }
    HINSTANCE shcore = LoadLibraryA("shcore.dll");
    if shcore != null {
        fn_setprocessdpiawareness = cast(SETPROCESSDPIAWARENESS_T, cast(void*, GetProcAddress(shcore, "SetProcessDpiAwareness")));
        fn_getdpiformonitor = cast(GETDPIFORMONITOR_T, cast(void*, GetProcAddress(shcore, "GetDpiForMonitor")));
    }
    bool init_dpi_awareness = true;
    if init_dpi_awareness != 0 {
        if fn_setprocessdpiawareness != null {
            _sapp.win32.dpi.aware = true;
            var per_monitor_aware_v2 = cast(DPI_AWARENESS_CONTEXT_T, -4);
            if (fn_setprocessdpiawarenesscontext && fn_setprocessdpiawarenesscontext(per_monitor_aware_v2)) == 0 {
                fn_setprocessdpiawareness(PROCESS_SYSTEM_DPI_AWARE);
            }
        } else if fn_setprocessdpiaware != null {
            _sapp.win32.dpi.aware = true;
            fn_setprocessdpiaware();
        }
    }
    if fn_getdpiformonitor && _sapp.win32.dpi.aware {
        var pt = POINT{1, 1};
        HMONITOR hm = MonitorFromPoint(pt, MONITOR_DEFAULTTONEAREST);
        UINT dpix;
        UINT dpiy;
        HRESULT hr = fn_getdpiformonitor(hm, MDT_EFFECTIVE_DPI, &dpix, &dpiy);
        ignore hr;
        assert(hr >= 0);
        _sapp.win32.dpi.window_scale = cast(f32, dpix) / 96.0f;
    } else {
        _sapp.win32.dpi.window_scale = 1.0f;
    }
    if _sapp.desc.high_dpi != 0 {
        _sapp.win32.dpi.content_scale = _sapp.win32.dpi.window_scale;
        _sapp.win32.dpi.mouse_scale = 1.0f;
    } else {
        _sapp.win32.dpi.content_scale = 1.0f;
        _sapp.win32.dpi.mouse_scale = 1.0f / _sapp.win32.dpi.window_scale;
    }
    _sapp.dpi_scale = _sapp.win32.dpi.content_scale;
    if user32 != null {
        FreeLibrary(user32);
    }
    if shcore != null {
        FreeLibrary(shcore);
    }
}







void _sapp_win32_run(sapp_desc* desc) {
    _sapp_init_state(desc);
    _sapp_win32_init_console();
    _sapp.win32.is_win10_or_greater = _sapp_win32_is_win10_or_greater();
    _sapp_win32_init_keytable();
    _sapp_win32_utf8_to_wide(_sapp.window_title, _sapp.window_title_wide, cast(i32, sizeof(_sapp.window_title_wide)));
    _sapp_win32_init_dpi();
    _sapp_win32_init_cursors();
    _sapp_win32_create_window();
    sapp_set_icon(&desc.icon);
    _sapp_d3d11_create_device_and_swapchain();
    _sapp_d3d11_create_default_render_target();
    _sapp.valid = true;
    bool window_shown = false;
    bool done = false;
    while (done || _sapp.quit_ordered) == 0 {
        _sapp_timing_update(&_sapp.timing, 0.0);
        noinit MSG msg;
        while PeekMessageW(&msg, null, 0, 0, PM_REMOVE) != 0 {
            if WM_QUIT == msg.message {
                done = true;
                continue;
            } else {
                TranslateMessage(&msg);
                DispatchMessageW(&msg);
            }
        }
        _sapp_win32_frame(false);
        if window_shown == 0 {
            window_shown = true;
            ShowWindow(_sapp.win32.hwnd, SW_SHOW);
        }
        if _sapp_win32_update_dimensions() != 0 {
            _sapp_d3d11_resize_default_render_target();
            _sapp_win32_app_event(SAPP_EVENTTYPE_RESIZED);
        }
        if _sapp.quit_requested != 0 {
            PostMessage(_sapp.win32.hwnd, WM_CLOSE, 0, 0);
        }
        _sapp_win32_update_mouse_lock();
    }
    _sapp_call_cleanup();
    _sapp_d3d11_destroy_default_render_target();
    _sapp_d3d11_destroy_device_and_swapchain();
    _sapp_win32_destroy_window();
    _sapp_win32_destroy_icons();
    _sapp_win32_restore_console();
    _sapp_win32_free_raw_input_data();
    _sapp_discard_state();
}



}













sapp_pixel_format sapp_color_format() {
    switch _sapp_d3d11_view_color_format() {
        case DXGI_FORMAT_B8G8R8A8_UNORM: {
            return SAPP_PIXELFORMAT_BGRA8;
        }
        case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB: {
            return SAPP_PIXELFORMAT_SBGR8A8;
        }
        case DXGI_FORMAT_R16G16B16A16_FLOAT: {
            return SAPP_PIXELFORMAT_RGBA16F;
        }
        default: {
            assert(cast(i64, false));
            return SAPP_PIXELFORMAT_NONE;
        }
    }
}











private {
}





















sapp_environment sapp_get_environment() {
    assert(cast(i64, _sapp.valid));
    sapp_environment res;
    res.defaults.color_format = sapp_color_format();
    res.defaults.depth_format = sapp_depth_format();
    res.defaults.sample_count = sapp_sample_count();
    res.d3d11.device = cast(void*, _sapp.d3d11.device);
    res.d3d11.device_context = cast(void*, _sapp.d3d11.device_context);
    when defined(SOKOL_WGPU) {
        res.wgpu.device = cast(void*, _sapp.wgpu.device);
    }
    when defined(SOKOL_VULKAN) {
        res.vulkan.instance = cast(void*, _sapp.vk.instance);
        res.vulkan.physical_device = cast(void*, _sapp.vk.physical_device);
        res.vulkan.device = cast(void*, _sapp.vk.device);
        res.vulkan.queue = cast(void*, _sapp.vk.queue);
        res.vulkan.queue_family_index = _sapp.vk.queue_family_index;
    }
    return res;
}

sapp_swapchain sapp_acquire_swapchain() {
    assert(cast(i64, _sapp.valid));
    sapp_swapchain res;
    assert(cast(i64, _sapp.d3d11.rtv));
    if _sapp.desc.sample_count > 1 {
        assert(cast(i64, _sapp.d3d11.msaa_rtv));
        res.d3d11.render_view = cast(void*, _sapp.d3d11.msaa_rtv);
        res.d3d11.resolve_view = cast(void*, _sapp.d3d11.rtv);
    } else {
        res.d3d11.render_view = cast(void*, _sapp.d3d11.rtv);
    }
    res.d3d11.depth_stencil_view = cast(void*, _sapp.d3d11.dsv);
    res.width = sapp_width();
    res.height = sapp_height();
    res.color_format = sapp_color_format();
    res.depth_format = sapp_depth_format();
    res.sample_count = sapp_sample_count();
    return res;
}



void* sapp_d3d11_get_swap_chain() {
    assert(cast(i64, _sapp.valid));
    return _sapp.d3d11.swap_chain;
}









