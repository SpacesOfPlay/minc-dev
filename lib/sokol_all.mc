    sg_d3d11_image_info res;
    when defined(SOKOL_D3D11) {
        _sg_image_t* img = _sg_lookup_image(img_id.id);
        if img != null {
            res.tex2d = cast(void*, img.d3d11.tex2d);
            res.tex3d = cast(void*, img.d3d11.tex3d);
            res.res = cast(void*, img.d3d11.res);
        }
    } else {
        ignore img_id;
    }
    return res;
}
sg_d3d11_sampler_info sg_d3d11_query_sampler_info(sg_sampler smp_id) {
    assert(cast(i64, _sg.valid));
    sg_d3d11_sampler_info res;
    when defined(SOKOL_D3D11) {
        _sg_sampler_t* smp = _sg_lookup_sampler(smp_id.id);
        if smp != null {
            res.smp = cast(void*, smp.d3d11.smp);
        }
    } else {
        ignore smp_id;
    }
    return res;
}
sg_d3d11_shader_info sg_d3d11_query_shader_info(sg_shader shd_id) {
    assert(cast(i64, _sg.valid));
    sg_d3d11_shader_info res;
    when defined(SOKOL_D3D11) {
        _sg_shader_t* shd = _sg_lookup_shader(shd_id.id);
        if shd != null {
            for u64 i = 0; i < cast(u64, SG_MAX_UNIFORMBLOCK_BINDSLOTS); i++ {
                res.cbufs[i] = cast(void*, shd.d3d11.all_cbufs[i]);
            }
            res.vs = cast(void*, shd.d3d11.vs);
            res.fs = cast(void*, shd.d3d11.fs);
        }
    } else {
        ignore shd_id;
    }
    return res;
}
sg_d3d11_pipeline_info sg_d3d11_query_pipeline_info(sg_pipeline pip_id) {
    assert(cast(i64, _sg.valid));
    sg_d3d11_pipeline_info res;
    when defined(SOKOL_D3D11) {
        _sg_pipeline_t* pip = _sg_lookup_pipeline(pip_id.id);
        if pip != null {
            res.il = cast(void*, pip.d3d11.il);
            res.rs = cast(void*, pip.d3d11.rs);
            res.dss = cast(void*, pip.d3d11.dss);
            res.bs = cast(void*, pip.d3d11.bs);
        }
    } else {
        ignore pip_id;
    }
    return res;
}
sg_d3d11_view_info sg_d3d11_query_view_info(sg_view view_id) {
    assert(cast(i64, _sg.valid));
    sg_d3d11_view_info res;
    when defined(SOKOL_D3D11) {
        _sg_view_t* view = _sg_lookup_view(view_id.id);
        res.srv = cast(void*, view.d3d11.srv);
        res.uav = cast(void*, view.d3d11.uav);
        res.rtv = cast(void*, view.d3d11.rtv);
        res.dsv = cast(void*, view.d3d11.dsv);
    } else {
        ignore view_id;
    }
    return res;
}
