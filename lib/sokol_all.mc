bool _sapp_win32_wide_to_utf8(u16* src, u8* dst, i32 dst_num_bytes) {
    assert(src && dst && dst_num_bytes > 1);
    _sapp_clear(dst, cast(u64, dst_num_bytes));
    i32 bytes_needed = WideCharToMultiByte(CP_UTF8, 0, src, -1, null, 0, null, null);
    if bytes_needed <= dst_num_bytes {
        WideCharToMultiByte(CP_UTF8, 0, src, -1, dst, dst_num_bytes, null, null);
        return true;
    } else {
        return false;
    }
}
/* updates current window and framebuffer size from the window's client rect, returns true if size has changed */
bool _sapp_win32_update_dimensions() {
    noinit RECT rect;
    if GetClientRect(_sapp.win32.hwnd, &rect) != 0 {
        f32 window_width = cast(f32, rect.right - rect.left) / _sapp.win32.dpi.window_scale;
        f32 window_height = cast(f32, rect.bottom - rect.top) / _sapp.win32.dpi.window_scale;
        if window_width == 0.0f && window_height == 0.0f {
            return false;
        }
        _sapp.window_width = _sapp_roundf_gzero(window_width);
        _sapp.window_height = _sapp_roundf_gzero(window_height);
        i32 fb_width = _sapp_roundf_gzero(window_width * _sapp.win32.dpi.content_scale);
        i32 fb_height = _sapp_roundf_gzero(window_height * _sapp.win32.dpi.content_scale);
        if fb_width != _sapp.framebuffer_width || fb_height != _sapp.framebuffer_height {
            _sapp.framebuffer_width = fb_width;
            _sapp.framebuffer_height = fb_height;
            return true;
        }
    } else {
        _sapp.window_height = 1;
        _sapp.window_width = _sapp.window_height;
        _sapp.framebuffer_height = 1;
        _sapp.framebuffer_width = _sapp.framebuffer_height;
    }
    return false;
}
void _sapp_win32_set_fullscreen(bool fullscreen, UINT swp_flags) {
    HMONITOR monitor = MonitorFromWindow(_sapp.win32.hwnd, MONITOR_DEFAULTTONEAREST);
    MONITORINFO minfo;
    minfo.cbSize = cast(DWORD, sizeof(MONITORINFO));
    GetMonitorInfo(monitor, &minfo);
    RECT mr = minfo.rcMonitor;
    i32 monitor_w = mr.right - mr.left;
    i32 monitor_h = mr.bottom - mr.top;
    DWORD win_ex_style = WS_EX_APPWINDOW | WS_EX_WINDOWEDGE;
    DWORD win_style;
    RECT rect;
    _sapp.fullscreen = fullscreen;
    if _sapp.fullscreen == 0 {
        win_style = WS_CLIPSIBLINGS | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_SIZEBOX;
        rect = _sapp.win32.stored_window_rect;
    } else {
        GetWindowRect(_sapp.win32.hwnd, &_sapp.win32.stored_window_rect);
        win_style = WS_POPUP | WS_SYSMENU | WS_VISIBLE;
        rect.left = mr.left;
        rect.top = mr.top;
        rect.right = rect.left + monitor_w;
        rect.bottom = rect.top + monitor_h;
        AdjustWindowRectEx(&rect, win_style, FALSE, win_ex_style);
    }
    i32 win_w = rect.right - rect.left;
    i32 win_h = rect.bottom - rect.top;
    i32 win_x = rect.left;
    i32 win_y = rect.top;
    SetWindowLongPtr(_sapp.win32.hwnd, GWL_STYLE, win_style);
    SetWindowPos(_sapp.win32.hwnd, HWND_TOP, win_x, win_y, win_w, win_h, swp_flags | SWP_FRAMECHANGED);
}
void _sapp_win32_toggle_fullscreen() {
    _sapp_win32_set_fullscreen(!_sapp.fullscreen, SWP_SHOWWINDOW);
}
void _sapp_win32_init_cursor(sapp_mouse_cursor cursor) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    i32 id = 0;
    switch cursor {
        case SAPP_MOUSECURSOR_ARROW: {
            id = 32512;
        }
        case SAPP_MOUSECURSOR_IBEAM: {
            id = 32513;
        }
        case SAPP_MOUSECURSOR_CROSSHAIR: {
            id = 32515;
        }
        case SAPP_MOUSECURSOR_POINTING_HAND: {
            id = 32649;
        }
        case SAPP_MOUSECURSOR_RESIZE_EW: {
            id = 32644;
        }
        case SAPP_MOUSECURSOR_RESIZE_NS: {
            id = 32645;
        }
        case SAPP_MOUSECURSOR_RESIZE_NWSE: {
            id = 32642;
        }
        case SAPP_MOUSECURSOR_RESIZE_NESW: {
            id = 32643;
        }
        case SAPP_MOUSECURSOR_RESIZE_ALL: {
            id = 32646;
        }
        case SAPP_MOUSECURSOR_NOT_ALLOWED: {
            id = 32648;
        }
        default: {
        }
    }
    if id != 0 {
        _sapp.win32.standard_cursors[cursor] = cast(HCURSOR, LoadImageW(null, MAKEINTRESOURCEW(id), IMAGE_CURSOR, 0, 0, LR_DEFAULTSIZE | LR_SHARED));
    }
    if null == _sapp.win32.standard_cursors[cursor] {
        _sapp.win32.standard_cursors[cursor] = LoadCursorW(null, MAKEINTRESOURCEW(32512));
    }
    assert(null != _sapp.win32.standard_cursors[cursor]);
}
void _sapp_win32_init_cursors() {
    for i32 i = 0; i < _SAPP_MOUSECURSOR_NUM; i++ {
        _sapp_win32_init_cursor(cast(sapp_mouse_cursor, i));
    }
}
bool _sapp_win32_cursor_in_content_area() {
    noinit POINT pos;
    if GetCursorPos(&pos) == 0 {
        return false;
    }
    if WindowFromPoint(pos) != _sapp.win32.hwnd {
        return false;
    }
    noinit RECT area;
    GetClientRect(_sapp.win32.hwnd, &area);
    ClientToScreen(_sapp.win32.hwnd, cast(POINT*, &area.left));
    ClientToScreen(_sapp.win32.hwnd, cast(POINT*, &area.right));
    return PtInRect(&area, pos) == TRUE;
}
void _sapp_win32_update_cursor(sapp_mouse_cursor cursor, bool shown, bool skip_area_test) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    if skip_area_test == 0 {
        if _sapp_win32_cursor_in_content_area() == 0 {
            return;
        }
    }
    HCURSOR cursor_handle = null;
    if shown != 0 {
        if _sapp.custom_cursor_bound[cursor] != 0 {
            assert(cast(i64, _sapp.win32.custom_cursors[cursor]));
            cursor_handle = _sapp.win32.custom_cursors[cursor];
            assert(null != cursor_handle);
        } else {
            cursor_handle = _sapp.win32.standard_cursors[cursor];
            assert(null != cursor_handle);
        }
    }
    SetCursor(cursor_handle);
}
void _sapp_win32_capture_mouse(u8 btn_mask) {
    if 0 == _sapp.win32.mouse.capture_mask {
        SetCapture(_sapp.win32.hwnd);
    }
    _sapp.win32.mouse.capture_mask |= btn_mask;
}
void _sapp_win32_release_mouse(u8 btn_mask) {
    if 0 != _sapp.win32.mouse.capture_mask {
        _sapp.win32.mouse.capture_mask &= ~btn_mask;
        if 0 == _sapp.win32.mouse.capture_mask {
            ReleaseCapture();
        }
    }
}
bool _sapp_win32_is_foreground_window() {
    return _sapp.win32.hwnd == GetForegroundWindow();
}
void _sapp_win32_lock_mouse(bool lock) {
    _sapp.win32.mouse.requested_lock = lock;
}
void _sapp_win32_free_raw_input_data() {
    if _sapp.win32.raw_input_data.ptr != null {
        _sapp_free(_sapp.win32.raw_input_data.ptr);
        _sapp.win32.raw_input_data.ptr = null;
        _sapp.win32.raw_input_data.size = 0;
    }
}
void _sapp_win32_alloc_raw_input_data(u64 size) {
    assert(cast(i64, !_sapp.win32.raw_input_data.ptr));
    assert(size > 0);
    _sapp.win32.raw_input_data.ptr = _sapp_malloc(size);
    _sapp.win32.raw_input_data.size = size;
    assert(cast(i64, _sapp.win32.raw_input_data.ptr));
}
void* _sapp_win32_ensure_raw_input_data(u64 required_size) {
    if required_size > _sapp.win32.raw_input_data.size {
        _sapp_win32_free_raw_input_data();
        _sapp_win32_alloc_raw_input_data(required_size);
    }
    assert((cast(u64, _sapp.win32.raw_input_data.ptr) & 7) == 0);
    return _sapp.win32.raw_input_data.ptr;
}
void _sapp_win32_do_lock_mouse() {
    _sapp.mouse.locked = true;
    ShowCursor(FALSE);
    _sapp.mouse.dx = 0.0f;
    _sapp.mouse.dy = 0.0f;
    _sapp_win32_release_mouse(0xFF);
    noinit POINT pos;
    if GetCursorPos(&pos) != 0 {
        _sapp.win32.mouse.lock.pos_valid = true;
        _sapp.win32.mouse.lock.pos_x = pos.x;
        _sapp.win32.mouse.lock.pos_y = pos.y;
    } else {
        _sapp.win32.mouse.lock.pos_valid = false;
    }
    noinit RECT client_rect;
    GetClientRect(_sapp.win32.hwnd, &client_rect);
    noinit POINT mid_point;
    mid_point.x = (client_rect.right - client_rect.left) / 2;
    mid_point.y = (client_rect.bottom - client_rect.top) / 2;
    ClientToScreen(_sapp.win32.hwnd, &mid_point);
    noinit RECT clip_rect;
    clip_rect.right = mid_point.x;
    clip_rect.left = clip_rect.right;
    clip_rect.bottom = mid_point.y;
    clip_rect.top = clip_rect.bottom;
    ClipCursor(&clip_rect);
    var rid = RAWINPUTDEVICE{0x01, 0x02, 0, _sapp.win32.hwnd};
    if RegisterRawInputDevices(&rid, 1, sizeof(rid)) == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_REGISTER_RAW_INPUT_DEVICES_FAILED_MOUSE_LOCK, 1, null, 3247);
    }
    _sapp.win32.mouse.raw_input.pos_valid = false;
}
void _sapp_win32_do_unlock_mouse() {
    _sapp.mouse.locked = false;
    ShowCursor(TRUE);
    _sapp.mouse.dx = 0.0f;
    _sapp.mouse.dy = 0.0f;
    _sapp_win32_release_mouse(0xFF);
    var rid = RAWINPUTDEVICE{0x01, 0x02, RIDEV_REMOVE, null};
    if RegisterRawInputDevices(&rid, 1, sizeof(rid)) == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_REGISTER_RAW_INPUT_DEVICES_FAILED_MOUSE_UNLOCK, 1, null, 3247);
    }
    ClipCursor(null);
    if _sapp.win32.mouse.lock.pos_valid != 0 {
        SetCursorPos(_sapp.win32.mouse.lock.pos_x, _sapp.win32.mouse.lock.pos_y);
        _sapp.win32.mouse.lock.pos_valid = false;
    }
}
void _sapp_win32_update_mouse_lock() {
    if _sapp_win32_is_foreground_window() == 0 {
        if _sapp.mouse.locked != 0 {
            _sapp_win32_do_unlock_mouse();
        }
        return;
    }
    bool lock = _sapp.win32.mouse.requested_lock;
    if lock == _sapp.mouse.locked {
        return;
    }
    if lock != 0 {
        _sapp_win32_do_lock_mouse();
    } else {
        _sapp_win32_do_unlock_mouse();
    }
}
bool _sapp_win32_update_monitor() {
    HMONITOR cur_monitor = MonitorFromWindow(_sapp.win32.hwnd, MONITOR_DEFAULTTONULL);
    if cur_monitor != _sapp.win32.hmonitor {
        _sapp.win32.hmonitor = cur_monitor;
        return true;
    } else {
        return false;
    }
}
u32 _sapp_win32_mods() {
    u32 mods = 0;
    if (GetKeyState(VK_SHIFT) & 1 << 15) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_SHIFT);
    }
    if (GetKeyState(VK_CONTROL) & 1 << 15) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_CTRL);
    }
    if (GetKeyState(VK_MENU) & 1 << 15) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_ALT);
    }
    if ((GetKeyState(VK_LWIN) | GetKeyState(VK_RWIN)) & 1 << 15) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_SUPER);
    }
    bool swapped = TRUE == GetSystemMetrics(SM_SWAPBUTTON);
    if GetAsyncKeyState(VK_LBUTTON) != 0 {
        mods |= cast(u32, swapped != 0 ? SAPP_MODIFIER_RMB : SAPP_MODIFIER_LMB);
    }
    if GetAsyncKeyState(VK_RBUTTON) != 0 {
        mods |= cast(u32, swapped != 0 ? SAPP_MODIFIER_LMB : SAPP_MODIFIER_RMB);
    }
    if GetAsyncKeyState(VK_MBUTTON) != 0 {
        mods |= cast(u32, SAPP_MODIFIER_MMB);
    }
    return mods;
}
void _sapp_win32_mouse_update(LPARAM lParam) {
    if _sapp.mouse.locked == 0 {
        f32 new_x = cast(f32, GET_X_LPARAM(lParam)) * _sapp.win32.dpi.mouse_scale;
        f32 new_y = cast(f32, GET_Y_LPARAM(lParam)) * _sapp.win32.dpi.mouse_scale;
        if _sapp.mouse.pos_valid != 0 {
            _sapp.mouse.dx = new_x - _sapp.mouse.x;
            _sapp.mouse.dy = new_y - _sapp.mouse.y;
        }
        _sapp.mouse.x = new_x;
        _sapp.mouse.y = new_y;
        _sapp.mouse.pos_valid = true;
    }
}
void _sapp_win32_mouse_event(sapp_event_type type, sapp_mousebutton btn) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        _sapp.event.modifiers = _sapp_win32_mods();
        _sapp.event.mouse_button = btn;
        _sapp_call_event(&_sapp.event);
    }
}
void _sapp_win32_scroll_event(f32 x, f32 y) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(SAPP_EVENTTYPE_MOUSE_SCROLL);
        _sapp.event.modifiers = _sapp_win32_mods();
        _sapp.event.scroll_x = x;
        _sapp.event.scroll_y = y;
        _sapp_call_event(&_sapp.event);
    }
}
void _sapp_win32_key_event(sapp_event_type type, i32 vk, bool repeat) {
    if _sapp_events_enabled() && vk < SAPP_MAX_KEYCODES {
        _sapp_init_event(type);
        _sapp.event.modifiers = _sapp_win32_mods();
        _sapp.event.key_code = _sapp.keycodes[vk];
        _sapp.event.key_repeat = repeat;
        _sapp_call_event(&_sapp.event);
        if _sapp.clipboard.enabled && type == SAPP_EVENTTYPE_KEY_DOWN && _sapp.event.modifiers == cast(u32, SAPP_MODIFIER_CTRL) && _sapp.event.key_code == SAPP_KEYCODE_V {
            _sapp_init_event(SAPP_EVENTTYPE_CLIPBOARD_PASTED);
            _sapp_call_event(&_sapp.event);
        }
    }
}
void _sapp_win32_char_event(u32 c, bool repeat) {
    if _sapp_events_enabled() && c >= 32 {
        if c >= 0xD800 && c <= 0xDBFF {
            _sapp.win32.surrogate = cast(WCHAR, cast(WCHAR, c) - 0xD800);
        } else {
            if c > 0xDC00 && c <= 0xDFFF {
                c = cast(u32, _sapp.win32.surrogate) << 10 | c - 0xDC00;
                c += 0x10000;
                _sapp.win32.surrogate = 0;
            }
            _sapp_init_event(SAPP_EVENTTYPE_CHAR);
            _sapp.event.modifiers = _sapp_win32_mods();
            _sapp.event.char_code = c;
            _sapp.event.key_repeat = repeat;
            _sapp_call_event(&_sapp.event);
        }
    }
}
void _sapp_win32_dpi_changed(HWND hWnd, LPRECT proposed_win_rect) {
    if _sapp.win32.dpi.aware == 0 {
        return;
    }
    HINSTANCE user32 = LoadLibraryA("user32.dll");
    if user32 == null {
        return;
    }
    var fn_getdpiforwindow = cast(GETDPIFORWINDOW_T, cast(void*, GetProcAddress(user32, "GetDpiForWindow")));
    if fn_getdpiforwindow != null {
        UINT dpix = fn_getdpiforwindow(_sapp.win32.hwnd);
        _sapp.win32.dpi.window_scale = cast(f32, dpix) / 96.0f;
        if _sapp.desc.high_dpi != 0 {
            _sapp.win32.dpi.content_scale = _sapp.win32.dpi.window_scale;
            _sapp.win32.dpi.mouse_scale = 1.0f;
        } else {
            _sapp.win32.dpi.content_scale = 1.0f;
            _sapp.win32.dpi.mouse_scale = 1.0f / _sapp.win32.dpi.window_scale;
        }
        _sapp.dpi_scale = _sapp.win32.dpi.content_scale;
        SetWindowPos(hWnd, null, proposed_win_rect.left, proposed_win_rect.top, proposed_win_rect.right - proposed_win_rect.left, proposed_win_rect.bottom - proposed_win_rect.top, SWP_NOZORDER | SWP_NOACTIVATE);
    }
    FreeLibrary(user32);
}
void _sapp_win32_files_dropped(HDROP hdrop) {
    if _sapp.drop.enabled == 0 {
        return;
    }
    _sapp_clear_drop_buffer();
    bool drop_failed = false;
    var count = cast(i32, DragQueryFileW(hdrop, 0xffffffff, null, 0));
    _sapp.drop.num_files = count > _sapp.drop.max_files ? _sapp.drop.max_files : count;
    for UINT i = 0; i < cast(UINT, _sapp.drop.num_files); i++ {
        var num_chars = cast(UINT, DragQueryFileW(hdrop, i, null, 0) + 1);
        var buffer = cast(WCHAR*, _sapp_malloc_clear(cast(u64, num_chars * sizeof(WCHAR))));
        DragQueryFileW(hdrop, i, buffer, num_chars);
        if _sapp_win32_wide_to_utf8(buffer, _sapp_dropped_file_path_ptr(cast(i32, i)), _sapp.drop.max_path_length) == 0 {
            _sapp_log(SAPP_LOGITEM_DROPPED_FILE_PATH_TOO_LONG, 1, null, 3247);
            drop_failed = true;
        }
        _sapp_free(buffer);
    }
    DragFinish(hdrop);
    if drop_failed == 0 {
        if _sapp_events_enabled() != 0 {
            _sapp_init_event(SAPP_EVENTTYPE_FILES_DROPPED);
            _sapp.event.modifiers = _sapp_win32_mods();
            _sapp_call_event(&_sapp.event);
        }
    } else {
        _sapp_clear_drop_buffer();
        _sapp.drop.num_files = 0;
    }
}
LRESULT _sapp_win32_wndproc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam) {
    if _sapp.win32.in_create_window == 0 {
        switch uMsg {
            case WM_CLOSE: {
                if _sapp.quit_ordered == 0 {
                    _sapp.quit_requested = true;
                    _sapp_win32_app_event(SAPP_EVENTTYPE_QUIT_REQUESTED);
                    if _sapp.quit_requested != 0 {
                        _sapp.quit_ordered = true;
                    }
                }
                if _sapp.quit_ordered != 0 {
                    PostQuitMessage(0);
                }
                return 0;
            }
            case WM_SYSCOMMAND: {
                switch wParam & 0xFFF0 {
                    case SC_SCREENSAVE, SC_MONITORPOWER: {
                        if _sapp.fullscreen != 0 {
                            return 0;
                        }
                    }
                    case SC_KEYMENU: {
                        return 0;
                    }
                }
            }
            case WM_ERASEBKGND: {
                return 1;
            }
            case WM_SIZE: {
                {
                    bool iconified = wParam == SIZE_MINIMIZED;
                    if iconified != _sapp.win32.iconified {
                        _sapp.win32.iconified = iconified;
                        if iconified != 0 {
                            _sapp_win32_app_event(SAPP_EVENTTYPE_ICONIFIED);
                        } else {
                            _sapp_win32_app_event(SAPP_EVENTTYPE_RESTORED);
                        }
                    }
                }
            }
            case WM_SETFOCUS: {
                _sapp_win32_app_event(SAPP_EVENTTYPE_FOCUSED);
            }
            case WM_KILLFOCUS: {
                _sapp_win32_app_event(SAPP_EVENTTYPE_UNFOCUSED);
            }
            case WM_SETCURSOR: {
                if LOWORD(lParam) == HTCLIENT {
                    _sapp_win32_update_cursor(_sapp.mouse.current_cursor, _sapp.mouse.shown, true);
                    return TRUE;
                }
            }
            case 0x02E0: {
                {
                    _sapp_win32_dpi_changed(hWnd, cast(LPRECT, lParam));
                    break case;
                }
            }
            case WM_LBUTTONDOWN: {
                _sapp_win32_mouse_update(lParam);
                _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_DOWN, SAPP_MOUSEBUTTON_LEFT);
                _sapp_win32_capture_mouse(cast(u8, 1 << SAPP_MOUSEBUTTON_LEFT));
            }
            case WM_RBUTTONDOWN: {
                _sapp_win32_mouse_update(lParam);
                _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_DOWN, SAPP_MOUSEBUTTON_RIGHT);
                _sapp_win32_capture_mouse(cast(u8, 1 << SAPP_MOUSEBUTTON_RIGHT));
            }
            case WM_MBUTTONDOWN: {
                _sapp_win32_mouse_update(lParam);
                _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_DOWN, SAPP_MOUSEBUTTON_MIDDLE);
                _sapp_win32_capture_mouse(cast(u8, 1 << SAPP_MOUSEBUTTON_MIDDLE));
            }
            case WM_LBUTTONUP: {
                _sapp_win32_mouse_update(lParam);
                _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_UP, SAPP_MOUSEBUTTON_LEFT);
                _sapp_win32_release_mouse(cast(u8, 1 << SAPP_MOUSEBUTTON_LEFT));
            }
            case WM_RBUTTONUP: {
                _sapp_win32_mouse_update(lParam);
                _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_UP, SAPP_MOUSEBUTTON_RIGHT);
                _sapp_win32_release_mouse(cast(u8, 1 << SAPP_MOUSEBUTTON_RIGHT));
            }
            case WM_MBUTTONUP: {
                _sapp_win32_mouse_update(lParam);
                _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_UP, SAPP_MOUSEBUTTON_MIDDLE);
                _sapp_win32_release_mouse(cast(u8, 1 << SAPP_MOUSEBUTTON_MIDDLE));
            }
            case WM_MOUSEMOVE: {
                if _sapp.mouse.locked == 0 {
                    _sapp_win32_mouse_update(lParam);
                    if _sapp.win32.mouse.tracked == 0 {
                        _sapp.win32.mouse.tracked = true;
                        TRACKMOUSEEVENT tme;
                        tme.cbSize = cast(DWORD, sizeof(tme));
                        tme.dwFlags = TME_LEAVE;
                        tme.hwndTrack = _sapp.win32.hwnd;
                        TrackMouseEvent(&tme);
                        _sapp.mouse.dx = 0.0f;
                        _sapp.mouse.dy = 0.0f;
                        _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_ENTER, SAPP_MOUSEBUTTON_INVALID);
                    }
                    _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_MOVE, SAPP_MOUSEBUTTON_INVALID);
                }
            }
            case WM_INPUT: {
                if _sapp.mouse.locked != 0 {
                    var ri = cast(HRAWINPUT, lParam);
                    UINT size = 0;
                    GetRawInputData(ri, RID_INPUT, null, &size, sizeof(RAWINPUTHEADER));
                    void* raw_input_data_ptr = _sapp_win32_ensure_raw_input_data(size);
                    if cast(UINT, -1) == GetRawInputData(ri, RID_INPUT, raw_input_data_ptr, &size, sizeof(RAWINPUTHEADER)) {
                        _sapp_log(SAPP_LOGITEM_WIN32_GET_RAW_INPUT_DATA_FAILED, 1, null, 3247);
                        break case;
                    }
                    var raw_mouse_data = cast(RAWINPUT*, raw_input_data_ptr);
                    if (raw_mouse_data.data.mouse.usFlags & MOUSE_MOVE_ABSOLUTE) != 0 {
                        LONG new_x = raw_mouse_data.data.mouse.lLastX;
                        LONG new_y = raw_mouse_data.data.mouse.lLastY;
                        if _sapp.win32.mouse.raw_input.pos_valid != 0 {
                            _sapp.mouse.dx = cast(f32, new_x - _sapp.win32.mouse.raw_input.pos_x);
                            _sapp.mouse.dy = cast(f32, new_y - _sapp.win32.mouse.raw_input.pos_y);
                        }
                        _sapp.win32.mouse.raw_input.pos_x = new_x;
                        _sapp.win32.mouse.raw_input.pos_y = new_y;
                        _sapp.win32.mouse.raw_input.pos_valid = true;
                    } else {
                        _sapp.mouse.dx = cast(f32, raw_mouse_data.data.mouse.lLastX);
                        _sapp.mouse.dy = cast(f32, raw_mouse_data.data.mouse.lLastY);
                    }
                    _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_MOVE, SAPP_MOUSEBUTTON_INVALID);
                }
            }
            case WM_MOUSELEAVE: {
                if _sapp.mouse.locked == 0 {
                    _sapp.mouse.dx = 0.0f;
                    _sapp.mouse.dy = 0.0f;
                    _sapp.win32.mouse.tracked = false;
                    _sapp_win32_mouse_event(SAPP_EVENTTYPE_MOUSE_LEAVE, SAPP_MOUSEBUTTON_INVALID);
                }
            }
            case WM_MOUSEWHEEL: {
                _sapp_win32_scroll_event(0.0f, cast(f32, GET_WHEEL_DELTA_WPARAM(wParam)) / cast(f32, WHEEL_DELTA));
            }
            case 0x020E: {
                _sapp_win32_scroll_event(-cast(f32, GET_WHEEL_DELTA_WPARAM(wParam)) / cast(f32, WHEEL_DELTA), 0.0f);
            }
            case WM_CHAR: {
                _sapp_win32_char_event(cast(u32, wParam), !!(lParam & 0x40000000));
            }
            case WM_KEYDOWN, WM_SYSKEYDOWN: {
                _sapp_win32_key_event(SAPP_EVENTTYPE_KEY_DOWN, HIWORD(lParam) & 0x1FF, !!(lParam & 0x40000000));
            }
            case WM_KEYUP, WM_SYSKEYUP: {
                _sapp_win32_key_event(SAPP_EVENTTYPE_KEY_UP, HIWORD(lParam) & 0x1FF, false);
            }
            case WM_ENTERSIZEMOVE: {
                SetTimer(_sapp.win32.hwnd, 1, USER_TIMER_MINIMUM, null);
            }
            case WM_EXITSIZEMOVE: {
                KillTimer(_sapp.win32.hwnd, 1);
            }
            case WM_TIMER: {
                _sapp_timing_update(&_sapp.timing, 0.0);
                _sapp_win32_frame(true);
            }
            case WM_NCLBUTTONDOWN: {
                if SendMessage(_sapp.win32.hwnd, WM_NCHITTEST, wParam, lParam) == HTCAPTION {
                    POINT point;
                    if GetCursorPos(&point) != 0 {
                        ScreenToClient(_sapp.win32.hwnd, &point);
                        PostMessage(_sapp.win32.hwnd, WM_MOUSEMOVE, 0, cast(u32, point.x) | cast(u32, point.y) << 16);
                    }
                }
            }
            case WM_DROPFILES: {
                _sapp_win32_files_dropped(cast(HDROP, wParam));
            }
            default: {
            }
        }
    }
    return DefWindowProcW(hWnd, uMsg, wParam, lParam);
}
void _sapp_win32_create_window() {
    WNDCLASSW wndclassw;
    wndclassw.style = CS_HREDRAW | CS_VREDRAW | CS_OWNDC;
    wndclassw.lpfnWndProc = cast(WNDPROC, _sapp_win32_wndproc);
    wndclassw.hInstance = GetModuleHandleW(null);
    wndclassw.hCursor = LoadCursor(null, IDC_ARROW);
    wndclassw.hIcon = LoadIcon(null, IDI_WINLOGO);
    wndclassw.lpszClassName = cast(u16*, __wide_literal("SOKOLAPP"));
    wndclassw.hbrBackground = cast(HBRUSH, GetStockObject(BLACK_BRUSH));
    RegisterClassW(&wndclassw);
    DWORD win_ex_style = WS_EX_APPWINDOW | WS_EX_WINDOWEDGE;
    RECT rect;
    DWORD win_style = WS_CLIPSIBLINGS | WS_CLIPCHILDREN | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_SIZEBOX;
    rect.right = cast(i32, cast(f32, _sapp.window_width) * _sapp.win32.dpi.window_scale);
    rect.bottom = cast(i32, cast(f32, _sapp.window_height) * _sapp.win32.dpi.window_scale);
    bool use_default_width = 0 == _sapp.window_width;
    bool use_default_height = 0 == _sapp.window_height;
    AdjustWindowRectEx(&rect, win_style, FALSE, win_ex_style);
    i32 win_width = rect.right - rect.left;
    i32 win_height = rect.bottom - rect.top;
    _sapp.win32.in_create_window = true;
    _sapp.win32.surrogate = 0;
    _sapp.win32.hwnd = CreateWindowExW(win_ex_style, cast(u16*, __wide_literal("SOKOLAPP")), _sapp.window_title_wide, win_style, CW_USEDEFAULT, SW_HIDE, use_default_width != 0 ? CW_USEDEFAULT : win_width, use_default_height != 0 ? CW_USEDEFAULT : win_height, null, null, GetModuleHandle(null), null);
    _sapp.win32.in_create_window = false;
    _sapp.win32.dc = GetDC(_sapp.win32.hwnd);
    _sapp.win32.hmonitor = MonitorFromWindow(_sapp.win32.hwnd, MONITOR_DEFAULTTONULL);
    assert(cast(i64, _sapp.win32.dc));
    _sapp_win32_update_dimensions();
    if _sapp.fullscreen != 0 {
        _sapp_win32_set_fullscreen(_sapp.fullscreen, SWP_HIDEWINDOW);
        _sapp_win32_update_dimensions();
    }
    DragAcceptFiles(_sapp.win32.hwnd, 1);
}
void _sapp_win32_destroy_window() {
    DestroyWindow(_sapp.win32.hwnd);
    _sapp.win32.hwnd = null;
    UnregisterClassW(cast(u16*, __wide_literal("SOKOLAPP")), GetModuleHandleW(null));
}
void _sapp_win32_destroy_icons() {
    if _sapp.win32.big_icon != null {
        DestroyIcon(_sapp.win32.big_icon);
        _sapp.win32.big_icon = null;
    }
    if _sapp.win32.small_icon != null {
        DestroyIcon(_sapp.win32.small_icon);
        _sapp.win32.small_icon = null;
    }
}
void _sapp_win32_init_console() {
    if _sapp.desc.win32.console_create || _sapp.desc.win32.console_attach {
        BOOL con_valid = FALSE;
        if _sapp.desc.win32.console_attach != 0 {
            con_valid = AttachConsole(ATTACH_PARENT_PROCESS);
        }
        if !con_valid && _sapp.desc.win32.console_create {
            con_valid = AllocConsole();
        }
        if con_valid != 0 {
            void* res_fp = null; ignore res_fp;
            errno_t err;
            err = 0;
            ignore err;
            err = 0;
            ignore err;
        }
    }
    if _sapp.desc.win32.console_utf8 != 0 {
        _sapp.win32.orig_codepage = GetConsoleOutputCP();
        SetConsoleOutputCP(CP_UTF8);
    }
}
void _sapp_win32_restore_console() {
    if _sapp.desc.win32.console_utf8 != 0 {
        SetConsoleOutputCP(_sapp.win32.orig_codepage);
    }
}
bool _sapp_win32_set_clipboard_string(u8* str_var) {
    assert(cast(i64, str_var));
    assert(cast(i64, _sapp.win32.hwnd));
    assert(_sapp.clipboard.enabled && _sapp.clipboard.buf_size > 0);
    if OpenClipboard(_sapp.win32.hwnd) == 0 {
        return false;
    }
    HANDLE object = null;
    u16* wchar_buf = null;
    SIZE_T wchar_buf_size = cast(SIZE_T, _sapp.clipboard.buf_size) * cast(u64, sizeof(u16));
    object = GlobalAlloc(GMEM_MOVEABLE, wchar_buf_size);
    if null == object {
        {
            if wchar_buf != null {
                GlobalUnlock(object);
            }
            if object != null {
                GlobalFree(object);
            }
            CloseClipboard();
            return false;
        }
    }
    wchar_buf = cast(u16*, GlobalLock(object));
    if null == wchar_buf {
        {
            if wchar_buf != null {
                GlobalUnlock(object);
            }
            if object != null {
                GlobalFree(object);
            }
            CloseClipboard();
            return false;
        }
    }
    if _sapp_win32_utf8_to_wide(str_var, wchar_buf, cast(i32, wchar_buf_size)) == 0 {
        {
            if wchar_buf != null {
                GlobalUnlock(object);
            }
            if object != null {
                GlobalFree(object);
            }
            CloseClipboard();
            return false;
        }
    }
    GlobalUnlock(object);
    wchar_buf = null;
    EmptyClipboard();
    if null == SetClipboardData(CF_UNICODETEXT, object) {
        {
            if wchar_buf != null {
                GlobalUnlock(object);
            }
            if object != null {
                GlobalFree(object);
            }
            CloseClipboard();
            return false;
        }
    }
    CloseClipboard();
    return true;
}
u8* _sapp_win32_get_clipboard_string() {
    assert(_sapp.clipboard.enabled && _sapp.clipboard.buffer);
    assert(cast(i64, _sapp.win32.hwnd));
    if OpenClipboard(_sapp.win32.hwnd) == 0 {
        return _sapp.clipboard.buffer;
    }
    HANDLE object = GetClipboardData(CF_UNICODETEXT);
    if object == null {
        CloseClipboard();
        return _sapp.clipboard.buffer;
    }
    var wchar_buf = cast(u16*, GlobalLock(object));
    if wchar_buf == null {
        CloseClipboard();
        return _sapp.clipboard.buffer;
    }
    if _sapp_win32_wide_to_utf8(wchar_buf, _sapp.clipboard.buffer, _sapp.clipboard.buf_size) == 0 {
        _sapp_log(SAPP_LOGITEM_CLIPBOARD_STRING_TOO_BIG, 1, null, 3247);
    }
    GlobalUnlock(object);
    CloseClipboard();
    return _sapp.clipboard.buffer;
}
void _sapp_win32_update_window_title() {
    _sapp_win32_utf8_to_wide(_sapp.window_title, _sapp.window_title_wide, cast(i32, sizeof(_sapp.window_title_wide)));
    SetWindowTextW(_sapp.win32.hwnd, _sapp.window_title_wide);
}
HICON _sapp_win32_create_icon_from_image(sapp_image_desc* desc, bool is_cursor) {
    BITMAPV5HEADER bi;
    bi.bV5Size = cast(DWORD, sizeof(bi));
    bi.bV5Width = desc.width;
    bi.bV5Height = -desc.height;
    bi.bV5Planes = 1;
    bi.bV5BitCount = 32;
    bi.bV5Compression = BI_BITFIELDS;
    bi.bV5RedMask = 0x00FF0000;
    bi.bV5GreenMask = 0x0000FF00;
    bi.bV5BlueMask = 0x000000FF;
    bi.bV5AlphaMask = 0xFF000000;
    u8* target = null;
    var source = cast(u8*, desc.pixels.ptr);
    HDC dc = GetDC(null);
    HBITMAP color = CreateDIBSection(dc, cast(BITMAPINFO*, &bi), DIB_RGB_COLORS, cast(void**, &target), null, cast(DWORD, 0));
    ReleaseDC(null, dc);
    if null == color {
        return null;
    }
    assert(cast(i64, target));
    HBITMAP mask = CreateBitmap(desc.width, desc.height, 1, 1, null);
    if null == mask {
        DeleteObject(color);
        return null;
    }
    for i32 i = 0; i < desc.width * desc.height; i++ {
        target[0] = source[2];
        target[1] = source[1];
        target[2] = source[0];
        target[3] = source[3];
        target += 4;
        source += 4;
    }
    ICONINFO icon_info;
    icon_info.fIcon = !is_cursor;
    icon_info.xHotspot = cast(DWORD, is_cursor != 0 ? desc.cursor_hotspot_x : 0);
    icon_info.yHotspot = cast(DWORD, is_cursor != 0 ? desc.cursor_hotspot_y : 0);
    icon_info.hbmMask = mask;
    icon_info.hbmColor = color;
    HICON icon_handle = CreateIconIndirect(&icon_info);
    DeleteObject(color);
    DeleteObject(mask);
    return icon_handle;
}
void _sapp_win32_set_icon(sapp_icon_desc* icon_desc, i32 num_images) {
    assert(num_images > 0 && num_images <= SAPP_MAX_ICONIMAGES);
    i32 big_img_index = _sapp_image_bestmatch(icon_desc.images, num_images, GetSystemMetrics(SM_CXICON), GetSystemMetrics(SM_CYICON));
    i32 sml_img_index = _sapp_image_bestmatch(icon_desc.images, num_images, GetSystemMetrics(SM_CXSMICON), GetSystemMetrics(SM_CYSMICON));
    HICON big_icon = _sapp_win32_create_icon_from_image(&icon_desc.images[big_img_index], false);
    HICON sml_icon = _sapp_win32_create_icon_from_image(&icon_desc.images[sml_img_index], false);
    if null != big_icon {
        SendMessage(_sapp.win32.hwnd, WM_SETICON, ICON_BIG, cast(LPARAM, big_icon));
        if null != _sapp.win32.big_icon {
            DestroyIcon(_sapp.win32.big_icon);
        }
        _sapp.win32.big_icon = big_icon;
    }
    if null != sml_icon {
        SendMessage(_sapp.win32.hwnd, WM_SETICON, ICON_SMALL, cast(LPARAM, sml_icon));
        if null != _sapp.win32.small_icon {
            DestroyIcon(_sapp.win32.small_icon);
        }
        _sapp.win32.small_icon = sml_icon;
    }
}
/* don't laugh, but this seems to be the easiest and most robust
   way to check if we're running on Win10

   From: https://github.com/videolan/vlc/blob/232fb13b0d6110c4d1b683cde24cf9a7f2c5c2ea/modules/video_output/win32/d3d11_swapchain.c#L263
*/
bool _sapp_win32_is_win10_or_greater() {
    HMODULE h = GetModuleHandleW(cast(u16*, __wide_literal("kernel32.dll")));
    if null != h {
        return null != GetProcAddress(h, "GetSystemCpuSetInformation");
    } else {
        return false;
    }
}
u8** _sapp_win32_command_line_to_utf8_argv(LPWSTR w_command_line, i32* o_argc) {
    i32 argc = 0;
    u8** argv = null;
    u8* args;
    LPWSTR* w_argv = CommandLineToArgvW(w_command_line, &argc);
    if w_argv == null {
    } else {
        u64 size = wcslen(w_command_line) * 4;
        argv = cast(u8**, _sapp_malloc_clear((cast(u64, argc) + 1) * cast(u64, sizeof(u8*)) + size));
        assert(cast(i64, argv));
        args = cast(u8*, &argv[argc + 1]);
        i32 n;
        for i32 i = 0; i < argc; ++i {
            n = WideCharToMultiByte(CP_UTF8, 0, w_argv[i], -1, args, cast(i32, size), null, null);
            if n == 0 {
                break;
            }
            argv[i] = args;
            size -= cast(u64, n);
            args += n;
        }
        LocalFree(w_argv);
    }
    *o_argc = argc;
    return argv;
}
bool _sapp_win32_make_custom_mouse_cursor(sapp_mouse_cursor cursor, sapp_image_desc* desc) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    assert(null == _sapp.win32.custom_cursors[cursor]);
    HCURSOR win32_cursor = _sapp_win32_create_icon_from_image(desc, true);
    _sapp.win32.custom_cursors[cursor] = win32_cursor;
    return win32_cursor != null;
}
void _sapp_win32_destroy_custom_mouse_cursor(sapp_mouse_cursor cursor) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    HCURSOR win32_cursor = _sapp.win32.custom_cursors[cursor];
    assert(cast(i64, win32_cursor));
    _sapp.win32.custom_cursors[cursor] = null;
    BOOL res = DestroyIcon(win32_cursor);
    if res == 0 {
        _sapp_log(SAPP_LOGITEM_WIN32_DESTROYICON_FOR_CURSOR_FAILED, 2, null, 3248);
    }
}
void _sapp_update_cursor(sapp_mouse_cursor cursor, bool shown) {
    _sapp_win32_update_cursor(cursor, shown, false);
    _sapp.mouse.current_cursor = cursor;
    _sapp.mouse.shown = shown;
}
void _sg_strcpy(_sg_str_t* dst, u8* src) {
    assert(cast(i64, dst));
    if src != null {
        strncpy_s(dst.buf, _SG_STRING_SIZE, src, _SG_STRING_SIZE - 1);
        dst.buf[_SG_STRING_SIZE - 1] = 0;
    } else {
        _sg_clear(dst.buf, cast(u64, _SG_STRING_SIZE));
    }
}
}
}

