        case SG_VERTEXFORMAT_USHORT2, SG_VERTEXFORMAT_USHORT2N, SG_VERTEXFORMAT_USHORT4, SG_VERTEXFORMAT_USHORT4N: {
            return GL_UNSIGNED_SHORT;
        }
        case SG_VERTEXFORMAT_INT10_N2: {
            return GL_INT_2_10_10_10_REV;
