        res.id = _sg_slot_alloc(&_sg.pools.buffer_pool, &_sg.pools.buffers[slot_index].slot, slot_index);
        {
            if _sg.stats_enabled != 0 {
                _sg.stats.cur_frame.buffers.allocated++;
