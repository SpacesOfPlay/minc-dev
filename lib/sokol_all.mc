    _sapp.window_height = _sapp_roundf_gzero(cast(f32, screen_rect.size.height));
    bool dim_changed = _sapp_ios_mtl_update_framebuffer_dimensions(screen_rect);
    if dim_changed && !_sapp.first_frame {
