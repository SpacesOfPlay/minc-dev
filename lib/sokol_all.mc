void sapp_toggle_fullscreen() {
    _sapp_macos_toggle_fullscreen();
}
void sapp_lock_mouse(bool lock) {
    _sapp_macos_lock_mouse(lock);
}
sapp_mouse_cursor sapp_bind_mouse_cursor_image(sapp_mouse_cursor cursor, sapp_image_desc* desc) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    assert(desc.cursor_hotspot_x < desc.width - 1 && desc.cursor_hotspot_y < desc.height - 1);
    assert(desc.width * desc.height * 4 == cast(i32, desc.pixels.size));
    sapp_unbind_mouse_cursor_image(cursor);
    bool res = false;
    res = _sapp_macos_make_custom_mouse_cursor(cursor, desc);
    _sapp.custom_cursor_bound[cast(i32, cursor)] = res;
    if _sapp.mouse.current_cursor == cursor {
        _sapp_update_cursor(cursor, _sapp.mouse.shown);
    }
    return cursor;
}
void sapp_unbind_mouse_cursor_image(sapp_mouse_cursor cursor) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    if _sapp.custom_cursor_bound[cast(i32, cursor)] != 0 {
        _sapp.custom_cursor_bound[cast(i32, cursor)] = false;
        if _sapp.mouse.current_cursor == cursor {
            _sapp_update_cursor(cursor, _sapp.mouse.shown);
        }
        _sapp_macos_destroy_custom_mouse_cursor(cursor);
    }
}
/* NOTE: on HTML5, sapp_set_clipboard_string() must be called from within event handler! */
void sapp_set_clipboard_string(u8* str_var) {
    if _sapp.clipboard.enabled == 0 {
        return;
    }
    assert(cast(i64, str_var));
    _sapp_macos_set_clipboard_string(str_var);
    _sapp_strcpy(str_var, _sapp.clipboard.buffer, cast(u64, _sapp.clipboard.buf_size));
}
u8* sapp_get_clipboard_string() {
    if _sapp.clipboard.enabled == 0 {
        return "";
    }
    return _sapp_macos_get_clipboard_string();
}
void sapp_set_window_title(u8* title) {
    assert(cast(i64, title));
    _sapp_strcpy(title, _sapp.window_title, cast(u64, sizeof(_sapp.window_title)));
    _sapp_macos_update_window_title();
}
void sapp_set_icon(sapp_icon_desc* desc) {
    assert(cast(i64, desc));
    if desc.sokol_default != 0 {
        if null == _sapp.default_icon_pixels {
            _sapp_setup_default_icon();
        }
        assert(null != _sapp.default_icon_pixels);
        desc = &_sapp.default_icon_desc;
    }
    i32 num_images = _sapp_icon_num_images(desc);
    if num_images == 0 {
        return;
    }
    assert(num_images > 0 && num_images <= SAPP_MAX_ICONIMAGES);
    if _sapp_validate_icon_desc(desc, num_images) == 0 {
        return;
    }
    _sapp_macos_set_icon(desc, num_images);
}
void* sapp_macos_get_window() {
    var obj = cast(void*, _sapp.macos.window);
    assert(cast(i64, obj));
    return obj;
}
NSEvent* _objc_block_invoke_0(void* _self, NSEvent* event) {
    if (cast(fn(void*, void*): u64, objc.raw)(event, objc_selref("modifierFlags")) & NSEventModifierFlagCommand) != 0 {
        objc.msg_id_i(objc.msg_id_v(NSApp, objc_selref("keyWindow")), objc_selref("sendEvent:"), event);
    }
    return event;
}
void objc_register_classes() {
    _objc_register__sapp_macos_app_delegate();
    _objc_register__sapp_macos_window_delegate();
    _objc_register__sapp_macos_window();
    _objc_register__sapp_macos_view();
}
// Run once before sapp_run on macOS/iOS. Returns 0 on success.
i32 sokol_macos_boot() {
    objc_runtime_init();
    // Everything is linked at load now: the Cocoa/Metal frameworks via the
    // objc_classref binds in the body, objc_msgSend via objc_runtime, and the
    // run-loop-mode / filter data globals via the linked data externs in
    // cocoa_consts. No dlopen, no dlsym; boot just creates NSApp, registers
    // the delegate classes, and installs the menu.
    NSApp = objc.msg_id_v(objc_getClass("NSApplication"), sel_registerName("sharedApplication"));
    objc_register_classes();
    _sapp_macos_install_default_menu();
    return 0;
}
