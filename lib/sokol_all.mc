    class_addMethod(cls, objc_selref("isOpaque"), cast(void*, &_objc__sapp_macos_view_isOpaque), "c@:");
    class_addMethod(cls, objc_selref("canBecomeKeyView"), cast(void*, &_objc__sapp_macos_view_canBecomeKeyView), "c@:");
