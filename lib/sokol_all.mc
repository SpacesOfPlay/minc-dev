    _sapp.macos.keyup_monitor = cast(fn(void*, void*, u64, void*): void*, objc.raw)(objc_classref("NSEvent", "/System/Library/Frameworks/AppKit.framework/AppKit"), objc_selref("addLocalMonitorForEventsMatchingMask:handler:"), cast(u64, NSEventMaskKeyUp), keyup_monitor);
