void* _sg_gl_getprocaddr(u8* name, _sg_wglGetProcAddress wgl_getprocaddress) {
    var proc_addr = cast(void*, wgl_getprocaddress(name));
    if null == proc_addr {
        proc_addr = cast(void*, GetProcAddress(_sg.gl.opengl32_dll, name));
    }
    assert(cast(i64, proc_addr));
    return proc_addr;
}

void _sg_gl_load_opengl() {
    assert(null == _sg.gl.opengl32_dll);
    _sg.gl.opengl32_dll = LoadLibraryA("opengl32.dll");
    assert(cast(i64, _sg.gl.opengl32_dll));
    var wgl_getprocaddress = cast(_sg_wglGetProcAddress, GetProcAddress(_sg.gl.opengl32_dll, "wglGetProcAddress"));
    assert(cast(i64, wgl_getprocaddress));
    glBindVertexArray = cast(PFN_glBindVertexArray, _sg_gl_getprocaddr("glBindVertexArray", wgl_getprocaddress));
    glFramebufferTextureLayer = cast(PFN_glFramebufferTextureLayer, _sg_gl_getprocaddr("glFramebufferTextureLayer", wgl_getprocaddress));
    glGenFramebuffers = cast(PFN_glGenFramebuffers, _sg_gl_getprocaddr("glGenFramebuffers", wgl_getprocaddress));
    glBindFramebuffer = cast(PFN_glBindFramebuffer, _sg_gl_getprocaddr("glBindFramebuffer", wgl_getprocaddress));
    glBindRenderbuffer = cast(PFN_glBindRenderbuffer, _sg_gl_getprocaddr("glBindRenderbuffer", wgl_getprocaddress));
    glGetStringi = cast(PFN_glGetStringi, _sg_gl_getprocaddr("glGetStringi", wgl_getprocaddress));
    glClearBufferfi = cast(PFN_glClearBufferfi, _sg_gl_getprocaddr("glClearBufferfi", wgl_getprocaddress));
    glClearBufferfv = cast(PFN_glClearBufferfv, _sg_gl_getprocaddr("glClearBufferfv", wgl_getprocaddress));
    glClearBufferuiv = cast(PFN_glClearBufferuiv, _sg_gl_getprocaddr("glClearBufferuiv", wgl_getprocaddress));
    glClearBufferiv = cast(PFN_glClearBufferiv, _sg_gl_getprocaddr("glClearBufferiv", wgl_getprocaddress));
    glDeleteRenderbuffers = cast(PFN_glDeleteRenderbuffers, _sg_gl_getprocaddr("glDeleteRenderbuffers", wgl_getprocaddress));
    glUniform1fv = cast(PFN_glUniform1fv, _sg_gl_getprocaddr("glUniform1fv", wgl_getprocaddress));
    glUniform2fv = cast(PFN_glUniform2fv, _sg_gl_getprocaddr("glUniform2fv", wgl_getprocaddress));
    glUniform3fv = cast(PFN_glUniform3fv, _sg_gl_getprocaddr("glUniform3fv", wgl_getprocaddress));
    glUniform4fv = cast(PFN_glUniform4fv, _sg_gl_getprocaddr("glUniform4fv", wgl_getprocaddress));
    glUniform1iv = cast(PFN_glUniform1iv, _sg_gl_getprocaddr("glUniform1iv", wgl_getprocaddress));
    glUniform2iv = cast(PFN_glUniform2iv, _sg_gl_getprocaddr("glUniform2iv", wgl_getprocaddress));
    glUniform3iv = cast(PFN_glUniform3iv, _sg_gl_getprocaddr("glUniform3iv", wgl_getprocaddress));
    glUniform4iv = cast(PFN_glUniform4iv, _sg_gl_getprocaddr("glUniform4iv", wgl_getprocaddress));
    glUniformMatrix4fv = cast(PFN_glUniformMatrix4fv, _sg_gl_getprocaddr("glUniformMatrix4fv", wgl_getprocaddress));
    glUseProgram = cast(PFN_glUseProgram, _sg_gl_getprocaddr("glUseProgram", wgl_getprocaddress));
    glShaderSource = cast(PFN_glShaderSource, _sg_gl_getprocaddr("glShaderSource", wgl_getprocaddress));
    glLinkProgram = cast(PFN_glLinkProgram, _sg_gl_getprocaddr("glLinkProgram", wgl_getprocaddress));
