//  █████  ██████  ██████  ██      ███████
// ██   ██ ██   ██ ██   ██ ██      ██
// ███████ ██████  ██████  ██      █████
// ██   ██ ██      ██      ██      ██
// ██   ██ ██      ██      ███████ ███████
//
// >>apple
// ███████ ███    ███ ███████  ██████ ██████  ██ ██████  ████████ ███████ ███    ██
// ██      ████  ████ ██      ██      ██   ██ ██ ██   ██    ██    ██      ████   ██
// █████   ██ ████ ██ ███████ ██      ██████  ██ ██████     ██    █████   ██ ██  ██
// ██      ██  ██  ██      ██ ██      ██   ██ ██ ██         ██    ██      ██  ██ ██
// ███████ ██      ██ ███████  ██████ ██   ██ ██ ██         ██    ███████ ██   ████
//
// >>emscripten
//  ██████  ██          ██   ██ ███████ ██      ██████  ███████ ██████  ███████
// ██       ██          ██   ██ ██      ██      ██   ██ ██      ██   ██ ██
// ██   ███ ██          ███████ █████   ██      ██████  █████   ██████  ███████
// ██    ██ ██          ██   ██ ██      ██      ██      ██      ██   ██      ██
//  ██████  ███████     ██   ██ ███████ ███████ ██      ███████ ██   ██ ███████
//
// >>gl helpers
when defined(SOKOL_GLCORE) {

private {
void _sapp_gl_init_fbconfig(_sapp_gl_fbconfig* fbconfig) {
    _sapp_clear(fbconfig, cast(u64, sizeof(_sapp_gl_fbconfig)));
    fbconfig.red_bits = -1;
    fbconfig.green_bits = -1;
    fbconfig.blue_bits = -1;
    fbconfig.alpha_bits = -1;
    fbconfig.depth_bits = -1;
    fbconfig.stencil_bits = -1;
    fbconfig.samples = -1;
}

void _sapp_gl_init_fbselect(_sapp_gl_fbselect* fbselect) {
    _sapp_clear(fbselect, cast(u64, sizeof(_sapp_gl_fbselect)));
    fbselect.least_missing = 1000000;
    fbselect.least_color_diff = 10000000;
    fbselect.least_extra_diff = 10000000;
    fbselect.best_match = false;
}

// NOTE: this is used only in the WGL code path
bool _sapp_gl_select_fbconfig(_sapp_gl_fbselect* fbselect, _sapp_gl_fbconfig* desired, _sapp_gl_fbconfig* current) {
    i32 missing = 0;
    if desired.doublebuffer != current.doublebuffer {
        return false;
    }
    if desired.srgb_capable != current.srgb_capable {
        return false;
    }
    if desired.alpha_bits > 0 && current.alpha_bits == 0 {
        missing++;
    }
    if desired.depth_bits > 0 && current.depth_bits == 0 {
        missing++;
    }
    if desired.stencil_bits > 0 && current.stencil_bits == 0 {
        missing++;
    }
    if desired.samples > 0 && current.samples == 0 {
        missing++;
    }
    i32 color_diff = 0;
    if desired.red_bits != -1 {
        color_diff += (desired.red_bits - current.red_bits) * (desired.red_bits - current.red_bits);
    }
    if desired.green_bits != -1 {
        color_diff += (desired.green_bits - current.green_bits) * (desired.green_bits - current.green_bits);
    }
    if desired.blue_bits != -1 {
        color_diff += (desired.blue_bits - current.blue_bits) * (desired.blue_bits - current.blue_bits);
    }
    i32 extra_diff = 0;
    if desired.alpha_bits != -1 {
        extra_diff += (desired.alpha_bits - current.alpha_bits) * (desired.alpha_bits - current.alpha_bits);
    }
    if desired.depth_bits != -1 {
        extra_diff += (desired.depth_bits - current.depth_bits) * (desired.depth_bits - current.depth_bits);
    }
    if desired.stencil_bits != -1 {
        extra_diff += (desired.stencil_bits - current.stencil_bits) * (desired.stencil_bits - current.stencil_bits);
    }
    if desired.samples != -1 {
        extra_diff += (desired.samples - current.samples) * (desired.samples - current.samples);
    }
    bool new_closest = false;
    if missing < fbselect.least_missing {
        new_closest = true;
    } else if missing == fbselect.least_missing {
        if color_diff < fbselect.least_color_diff || color_diff == fbselect.least_color_diff && extra_diff < fbselect.least_extra_diff {
            new_closest = true;
        }
    }
    if new_closest != 0 {
        fbselect.least_missing = missing;
        fbselect.least_color_diff = color_diff;
        fbselect.least_extra_diff = extra_diff;
        fbselect.best_match = (missing | color_diff | extra_diff) == 0;
    }
    return new_closest;
}

// NOTE: this is used only in the GLX code path
_sapp_gl_fbconfig* _sapp_gl_choose_fbconfig(_sapp_gl_fbconfig* desired, _sapp_gl_fbconfig* alternatives, i32 count) {
    i32 missing;
    i32 least_missing = 1000000;
    i32 color_diff;
    i32 least_color_diff = 10000000;
    i32 extra_diff;
    i32 least_extra_diff = 10000000;
    _sapp_gl_fbconfig* current;
    _sapp_gl_fbconfig* closest = null;
    for i32 i = 0; i < count; i++ {
        current = alternatives + i;
        if desired.doublebuffer != current.doublebuffer {
            continue;
        }
        if desired.srgb_capable != current.srgb_capable {
            continue;
        }
        missing = 0;
        if desired.alpha_bits > 0 && current.alpha_bits == 0 {
            missing++;
        }
        if desired.depth_bits > 0 && current.depth_bits == 0 {
            missing++;
        }
        if desired.stencil_bits > 0 && current.stencil_bits == 0 {
            missing++;
        }
        if desired.samples > 0 && current.samples == 0 {
            missing++;
        }
        color_diff = 0;
        if desired.red_bits != -1 {
            color_diff += (desired.red_bits - current.red_bits) * (desired.red_bits - current.red_bits);
        }
        if desired.green_bits != -1 {
            color_diff += (desired.green_bits - current.green_bits) * (desired.green_bits - current.green_bits);
        }
        if desired.blue_bits != -1 {
            color_diff += (desired.blue_bits - current.blue_bits) * (desired.blue_bits - current.blue_bits);
        }
        extra_diff = 0;
        if desired.alpha_bits != -1 {
            extra_diff += (desired.alpha_bits - current.alpha_bits) * (desired.alpha_bits - current.alpha_bits);
        }
        if desired.depth_bits != -1 {
            extra_diff += (desired.depth_bits - current.depth_bits) * (desired.depth_bits - current.depth_bits);
        }
        if desired.stencil_bits != -1 {
            extra_diff += (desired.stencil_bits - current.stencil_bits) * (desired.stencil_bits - current.stencil_bits);
        }
        if desired.samples != -1 {
            extra_diff += (desired.samples - current.samples) * (desired.samples - current.samples);
        }
        if missing < least_missing {
            closest = current;
        } else if missing == least_missing {
            if color_diff < least_color_diff || color_diff == least_color_diff && extra_diff < least_extra_diff {
                closest = current;
            }
        }
        if current == closest {
            least_missing = missing;
            least_color_diff = color_diff;
            least_extra_diff = extra_diff;
        }
    }
    return closest;
}
}
}

// ██     ██ ██ ███    ██ ██████   ██████  ██     ██ ███████
// ██     ██ ██ ████   ██ ██   ██ ██    ██ ██     ██ ██
// ██  █  ██ ██ ██ ██  ██ ██   ██ ██    ██ ██  █  ██ ███████
// ██ ███ ██ ██ ██  ██ ██ ██   ██ ██    ██ ██ ███ ██      ██
//  ███ ███  ██ ██   ████ ██████   ██████   ███ ███  ███████
//
// >>windows
//  █████  ███    ██ ██████  ██████   ██████  ██ ██████
// ██   ██ ████   ██ ██   ██ ██   ██ ██    ██ ██ ██   ██
// ███████ ██ ██  ██ ██   ██ ██████  ██    ██ ██ ██   ██
// ██   ██ ██  ██ ██ ██   ██ ██   ██ ██    ██ ██ ██   ██
// ██   ██ ██   ████ ██████  ██   ██  ██████  ██ ██████
//
// >>android
/* android loop thread */
private {
bool _sapp_android_init_egl() {
    assert(_sapp.android.display == cast(EGLDisplay, 0));
    assert(_sapp.android.context == cast(EGLContext, 0));
    EGLDisplay display = eglGetDisplay(cast(EGLNativeDisplayType, 0));
    if display == cast(EGLDisplay, 0) {
        return false;
    }
    if eglInitialize(display, null, null) == EGL_FALSE {
        return false;
    }
    bool wants_alpha = _sapp.desc.composite_mode != SAPP_COMPOSITEMODE_OPAQUE;
    bool wants_msaa = _sapp.desc.sample_count > 1;
    bool wants_depth = _sapp.desc.depth_format != SAPP_PIXELFORMAT_NONE;
    bool wants_stencil = _sapp.desc.depth_format == SAPP_PIXELFORMAT_DEPTH_STENCIL;
    EGLint sample_buffers = wants_msaa != 0 ? 1 : 0;
    EGLint sample_count = wants_msaa != 0 ? _sapp.desc.sample_count : 0;
    EGLint alpha_size = wants_alpha != 0 ? 8 : 0;
    EGLint depth_size = wants_depth != 0 ? 24 : 0;
    EGLint stencil_size = wants_stencil != 0 ? 8 : 0;
    EGLint[21] cfg_attributes = {
        EGL_SURFACE_TYPE, EGL_WINDOW_BIT, EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT, EGL_RED_SIZE, 8,
        EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, alpha_size, EGL_DEPTH_SIZE, depth_size,
        EGL_STENCIL_SIZE, stencil_size, EGL_SAMPLE_BUFFERS, sample_buffers, EGL_SAMPLES,
        sample_count, EGL_NONE,
    };
    noinit EGLConfig[32] available_cfgs;
    EGLint cfg_count;
    eglChooseConfig(display, cfg_attributes, available_cfgs, 32, &cfg_count);
    assert(cfg_count > 0);
    assert(cfg_count <= 32);
    EGLConfig config = available_cfgs[0];
    for i32 i = 0; i < cfg_count; ++i {
        EGLConfig c = available_cfgs[i];
        EGLint r;
        EGLint g;
        EGLint b;
        EGLint a;
        EGLint d;
        EGLint s;
        EGLint n;
        if eglGetConfigAttrib(display, c, EGL_RED_SIZE, &r) == EGL_TRUE && eglGetConfigAttrib(display, c, EGL_GREEN_SIZE, &g) == EGL_TRUE && eglGetConfigAttrib(display, c, EGL_BLUE_SIZE, &b) == EGL_TRUE && eglGetConfigAttrib(display, c, EGL_ALPHA_SIZE, &a) == EGL_TRUE && eglGetConfigAttrib(display, c, EGL_DEPTH_SIZE, &d) == EGL_TRUE && eglGetConfigAttrib(display, c, EGL_STENCIL_SIZE, &s) == EGL_TRUE && eglGetConfigAttrib(display, c, EGL_SAMPLES, &n) == EGL_TRUE && r == 8 && g == 8 && b == 8 && a == alpha_size && d == depth_size && s == stencil_size && n == sample_count {
            config = c;
            break;
        }
    }
    EGLint[5] ctx_attributes = {
        EGL_CONTEXT_MAJOR_VERSION, _sapp.desc.gl.major_version, EGL_CONTEXT_MINOR_VERSION,
        _sapp.desc.gl.minor_version, EGL_NONE,
    };
    EGLContext context = eglCreateContext(display, config, cast(EGLContext, 0), ctx_attributes);
    if context == cast(EGLContext, 0) {
        // GLES 3.1 context may be rejected; retry at minor 0 (matches v1).
        EGLint[5] ctx_attributes_fb = {EGL_CONTEXT_MAJOR_VERSION, _sapp.desc.gl.major_version, EGL_CONTEXT_MINOR_VERSION, 0, EGL_NONE};
        context = eglCreateContext(display, config, cast(EGLContext, 0), ctx_attributes_fb);
    }
    if context == cast(EGLContext, 0) {
        return false;
    }
    _sapp.android.config = config;
    _sapp.android.display = display;
    _sapp.android.context = context;
    return true;
}

void _sapp_android_cleanup_egl() {
    if _sapp.android.display != cast(EGLDisplay, 0) {
        eglMakeCurrent(_sapp.android.display, cast(EGLSurface, 0), cast(EGLSurface, 0), cast(EGLContext, 0));
        if _sapp.android.surface != cast(EGLSurface, 0) {
            eglDestroySurface(_sapp.android.display, _sapp.android.surface);
            _sapp.android.surface = cast(EGLSurface, 0);
        }
        if _sapp.android.context != cast(EGLContext, 0) {
            eglDestroyContext(_sapp.android.display, _sapp.android.context);
            _sapp.android.context = cast(EGLContext, 0);
        }
        eglTerminate(_sapp.android.display);
        _sapp.android.display = cast(EGLDisplay, 0);
    }
}

bool _sapp_android_init_egl_surface(ANativeWindow* window) {
    assert(_sapp.android.display != cast(EGLDisplay, 0));
    assert(_sapp.android.context != cast(EGLContext, 0));
    assert(_sapp.android.surface == cast(EGLSurface, 0));
    assert(cast(i64, window));
    bool wants_srgb = _sapp.desc.srgb;
    EGLint[3] srgb_surface_attrs = {EGL_GL_COLORSPACE, EGL_GL_COLORSPACE_SRGB, EGL_NONE};
    EGLint* surf_attrs = wants_srgb != 0 ? srgb_surface_attrs : 0;
    EGLSurface surface = eglCreateWindowSurface(_sapp.android.display, _sapp.android.config, window, surf_attrs);
    if surface == cast(EGLSurface, 0) {
        return false;
    }
    if eglMakeCurrent(_sapp.android.display, surface, surface, _sapp.android.context) == EGL_FALSE {
        return false;
    }
    _sapp.android.surface = surface;
    glGetIntegerv(GL_FRAMEBUFFER_BINDING, cast(i32*, &_sapp.gl.framebuffer));
    return true;
}

void _sapp_android_cleanup_egl_surface() {
    if _sapp.android.display == cast(EGLDisplay, 0) {
        return;
    }
    eglMakeCurrent(_sapp.android.display, cast(EGLSurface, 0), cast(EGLSurface, 0), cast(EGLContext, 0));
    if _sapp.android.surface != cast(EGLSurface, 0) {
        eglDestroySurface(_sapp.android.display, _sapp.android.surface);
        _sapp.android.surface = cast(EGLSurface, 0);
    }
}

void _sapp_android_app_event(sapp_event_type type) {
    if _sapp_events_enabled() != 0 {
        _sapp_init_event(type);
        _sapp_call_event(&_sapp.event);
    }
}

void _sapp_android_update_dimensions(ANativeWindow* window, bool force_update) {
    assert(_sapp.android.display != cast(EGLDisplay, 0));
    assert(_sapp.android.context != cast(EGLContext, 0));
    assert(_sapp.android.surface != cast(EGLSurface, 0));
    assert(cast(i64, window));
    i32 win_w = ANativeWindow_getWidth(window);
    i32 win_h = ANativeWindow_getHeight(window);
    assert(win_w >= 0 && win_h >= 0);
    bool win_changed = win_w != _sapp.window_width || win_h != _sapp.window_height;
    _sapp.window_width = win_w;
    _sapp.window_height = win_h;
    if win_changed || force_update {
        if _sapp.desc.high_dpi == 0 {
            i32 buf_w = win_w / 2;
            i32 buf_h = win_h / 2;
            EGLint format_var;  // renamed from: format
            EGLBoolean egl_result = eglGetConfigAttrib(_sapp.android.display, _sapp.android.config, EGL_NATIVE_VISUAL_ID, &format_var);
            assert(egl_result == EGL_TRUE);
            ignore egl_result;
            i32 result = ANativeWindow_setBuffersGeometry(window, buf_w, buf_h, format_var);
            assert(result == 0);
            ignore result;
        }
    }
    EGLint fb_w;
    EGLint fb_h;
    EGLBoolean egl_result_w = eglQuerySurface(_sapp.android.display, _sapp.android.surface, EGL_WIDTH, &fb_w);
    EGLBoolean egl_result_h = eglQuerySurface(_sapp.android.display, _sapp.android.surface, EGL_HEIGHT, &fb_h);
    assert(egl_result_w == EGL_TRUE);
    ignore egl_result_w;
    assert(egl_result_h == EGL_TRUE);
    ignore egl_result_h;
    bool fb_changed = fb_w != _sapp.framebuffer_width || fb_h != _sapp.framebuffer_height;
    _sapp.framebuffer_width = fb_w;
    _sapp.framebuffer_height = fb_h;
    _sapp.dpi_scale = cast(f32, _sapp.framebuffer_width) / cast(f32, _sapp.window_width);
    if win_changed || fb_changed || force_update {
        if _sapp.first_frame == 0 {
            _sapp_android_app_event(SAPP_EVENTTYPE_RESIZED);
        }
    }
}

void _sapp_android_cleanup() {
    if _sapp.android.surface != cast(EGLSurface, 0) {
        if _sapp.init_called && !_sapp.cleanup_called {
            _sapp_call_cleanup();
        }
    }
    _sapp_android_cleanup_egl();
}

void _sapp_android_shutdown() {
    _sapp_android_cleanup();
    ANativeActivity_finish(_sapp.android.activity);
}

void _sapp_android_frame(f64 external_now) {
    assert(_sapp.android.display != cast(EGLDisplay, 0));
    assert(_sapp.android.context != cast(EGLContext, 0));
    assert(_sapp.android.surface != cast(EGLSurface, 0));
    _sapp_timing_update(&_sapp.timing, external_now);
    _sapp_android_update_dimensions(_sapp.android.current.window, false);
    _sapp_frame();
    eglSwapBuffers(_sapp.android.display, _sapp.android.surface);
}

bool _sapp_android_touch_event(AInputEvent* e) {
    if AInputEvent_getType(e) != AINPUT_EVENT_TYPE_MOTION {
        return false;
    }
    if _sapp_events_enabled() == 0 {
        return false;
    }
    i32 action_idx = AMotionEvent_getAction(e);
    i32 action = action_idx & AMOTION_EVENT_ACTION_MASK;
    sapp_event_type type = SAPP_EVENTTYPE_INVALID;
    switch action {
        case AMOTION_EVENT_ACTION_DOWN, AMOTION_EVENT_ACTION_POINTER_DOWN: {
            type = SAPP_EVENTTYPE_TOUCHES_BEGAN;
        }
        case AMOTION_EVENT_ACTION_MOVE: {
            type = SAPP_EVENTTYPE_TOUCHES_MOVED;
        }
        case AMOTION_EVENT_ACTION_UP, AMOTION_EVENT_ACTION_POINTER_UP: {
            type = SAPP_EVENTTYPE_TOUCHES_ENDED;
        }
        case AMOTION_EVENT_ACTION_CANCEL: {
            type = SAPP_EVENTTYPE_TOUCHES_CANCELLED;
        }
        default: {
        }
    }
    if type == SAPP_EVENTTYPE_INVALID {
        return false;
    }
    i32 idx = action_idx >> AMOTION_EVENT_ACTION_POINTER_INDEX_SHIFT;
    _sapp_init_event(type);
    _sapp.event.num_touches = cast(i32, AMotionEvent_getPointerCount(e));
    if _sapp.event.num_touches > SAPP_MAX_TOUCHPOINTS {
        _sapp.event.num_touches = SAPP_MAX_TOUCHPOINTS;
    }
    for i32 i = 0; i < _sapp.event.num_touches; i++ {
        sapp_touchpoint* dst = &_sapp.event.touches[i];
        dst.identifier = cast(u64, AMotionEvent_getPointerId(e, cast(u64, i)));
        dst.pos_x = AMotionEvent_getX(e, cast(u64, i)) / cast(f32, _sapp.window_width) * cast(f32, _sapp.framebuffer_width);
        dst.pos_y = AMotionEvent_getY(e, cast(u64, i)) / cast(f32, _sapp.window_height) * cast(f32, _sapp.framebuffer_height);
        dst.android_tooltype = cast(sapp_android_tooltype, AMotionEvent_getToolType(e, cast(u64, i)));
        if action == AMOTION_EVENT_ACTION_POINTER_DOWN || action == AMOTION_EVENT_ACTION_POINTER_UP {
            dst.changed = i == idx;
        } else {
            dst.changed = true;
        }
    }
    _sapp_call_event(&_sapp.event);
    return true;
}

bool _sapp_android_key_event(AInputEvent* e) {
    if AInputEvent_getType(e) != AINPUT_EVENT_TYPE_KEY {
        return false;
    }
    if AKeyEvent_getKeyCode(e) == AKEYCODE_BACK {
        _sapp_android_shutdown();
        return true;
    }
    return false;
}

i32 _sapp_android_input_cb(i32 fd, i32 events, void* data) {
    ignore fd;
    ignore data;
    if (events & ALOOPER_EVENT_INPUT) == 0 {
        _sapp_log(SAPP_LOGITEM_ANDROID_UNSUPPORTED_INPUT_EVENT_INPUT_CB, 1, null, 3247);
        return 1;
    }
    assert(cast(i64, _sapp.android.current.input));
    AInputEvent* event = null;
    while AInputQueue_getEvent(_sapp.android.current.input, &event) >= 0 {
        if AInputQueue_preDispatchEvent(_sapp.android.current.input, event) != 0 {
            continue;
        }
        i32 handled = 0;
        if _sapp.desc.android.native_event_cb && _sapp.desc.android.native_event_cb(event) {
            handled = 1;
        }
        if !handled && (_sapp_android_touch_event(event) || _sapp_android_key_event(event)) {
            handled = 1;
        }
        AInputQueue_finishEvent(_sapp.android.current.input, event, handled);
    }
    return 1;
}

i32 _sapp_android_main_cb(i32 fd, i32 events, void* data) {
    ignore data;
    if (events & ALOOPER_EVENT_INPUT) == 0 {
        _sapp_log(SAPP_LOGITEM_ANDROID_UNSUPPORTED_INPUT_EVENT_MAIN_CB, 1, null, 3247);
        return 1;
    }
    _sapp_android_msg_t msg;
    if read(fd, &msg, sizeof(msg)) != sizeof(msg) {
        _sapp_log(SAPP_LOGITEM_ANDROID_READ_MSG_FAILED, 1, null, 3247);
        return 1;
    }
    pthread_mutex_lock(&_sapp.android.pt.mutex);
    switch msg {
        case _SOKOL_ANDROID_MSG_CREATE: {
            {
                _sapp_log(SAPP_LOGITEM_ANDROID_MSG_CREATE, 3, null, 3249);
                assert(cast(i64, !_sapp.valid));
                bool result = _sapp_android_init_egl();
                assert(cast(i64, result));
                ignore result;
                _sapp.valid = true;
                _sapp.android.has_created = true;
            }
        }
        case _SOKOL_ANDROID_MSG_RESUME: {
            _sapp_log(SAPP_LOGITEM_ANDROID_MSG_RESUME, 3, null, 3249);
            _sapp.android.has_resumed = true;
            _sapp_android_app_event(SAPP_EVENTTYPE_RESUMED);
        }
        case _SOKOL_ANDROID_MSG_PAUSE: {
            _sapp_log(SAPP_LOGITEM_ANDROID_MSG_PAUSE, 3, null, 3249);
            _sapp.android.has_resumed = false;
            _sapp_android_app_event(SAPP_EVENTTYPE_SUSPENDED);
        }
        case _SOKOL_ANDROID_MSG_FOCUS: {
            _sapp_log(SAPP_LOGITEM_ANDROID_MSG_FOCUS, 3, null, 3249);
            _sapp.android.has_focus = true;
        }
        case _SOKOL_ANDROID_MSG_NO_FOCUS: {
            _sapp_log(SAPP_LOGITEM_ANDROID_MSG_NO_FOCUS, 3, null, 3249);
            _sapp.android.has_focus = false;
        }
        case _SOKOL_ANDROID_MSG_SET_NATIVE_WINDOW: {
            _sapp_log(SAPP_LOGITEM_ANDROID_MSG_SET_NATIVE_WINDOW, 3, null, 3249);
            if _sapp.android.current.window != _sapp.android.pending.window {
                if _sapp.android.current.window != null {
                    _sapp_android_cleanup_egl_surface();
                }
                if _sapp.android.pending.window != null {
                    if _sapp_android_init_egl_surface(_sapp.android.pending.window) != 0 {
                        _sapp_android_update_dimensions(_sapp.android.pending.window, true);
                    } else {
                        _sapp_android_shutdown();
                    }
                }
            }
            _sapp.android.current.window = _sapp.android.pending.window;
        }
        case _SOKOL_ANDROID_MSG_SET_INPUT_QUEUE: {
            _sapp_log(SAPP_LOGITEM_ANDROID_MSG_SET_INPUT_QUEUE, 3, null, 3249);
            if _sapp.android.current.input != _sapp.android.pending.input {
                if _sapp.android.current.input != null {
                    AInputQueue_detachLooper(_sapp.android.current.input);
                }
                if _sapp.android.pending.input != null {
                    AInputQueue_attachLooper(_sapp.android.pending.input, _sapp.android.looper, -2, _sapp_android_input_cb, null);
                }
            }
            _sapp.android.current.input = _sapp.android.pending.input;
        }
        case _SOKOL_ANDROID_MSG_DESTROY: {
            _sapp_log(SAPP_LOGITEM_ANDROID_MSG_DESTROY, 3, null, 3249);
            _sapp_android_cleanup();
            _sapp.valid = false;
            _sapp.android.is_thread_stopping = true;
        }
        default: {
            _sapp_log(SAPP_LOGITEM_ANDROID_UNKNOWN_MSG, 2, null, 3248);
        }
    }
    pthread_cond_broadcast(&_sapp.android.pt.cond);
    pthread_mutex_unlock(&_sapp.android.pt.mutex);
    return 1;
}

bool _sapp_android_should_update() {
    bool is_in_front = _sapp.android.has_resumed && _sapp.android.has_focus;
    bool has_surface = _sapp.android.surface != cast(EGLSurface, 0);
    return is_in_front && has_surface;
}

void _sapp_android_show_keyboard(bool shown) {
    assert(cast(i64, _sapp.valid));
    if shown != 0 {
        ANativeActivity_showSoftInput(_sapp.android.activity, ANATIVEACTIVITY_SHOW_SOFT_INPUT_FORCED);
    } else {
        ANativeActivity_hideSoftInput(_sapp.android.activity, ANATIVEACTIVITY_HIDE_SOFT_INPUT_NOT_ALWAYS);
    }
}

void* _sapp_android_loop(void* arg) {
    ignore arg;
    _sapp_log(SAPP_LOGITEM_ANDROID_LOOP_THREAD_STARTED, 3, null, 3249);
    _sapp.android.looper = ALooper_prepare(0);
    ALooper_addFd(_sapp.android.looper, _sapp.android.pt.read_from_main_fd, -2, ALOOPER_EVENT_INPUT, _sapp_android_main_cb, null);
    _sapp_log(SAPP_LOGITEM_ANDROID_CHOREOGRAPHER_UNAVAILABLE, 3, null, 3249);
    pthread_mutex_lock(&_sapp.android.pt.mutex);
    _sapp.android.is_thread_started = true;
    pthread_cond_broadcast(&_sapp.android.pt.cond);
    pthread_mutex_unlock(&_sapp.android.pt.mutex);
    while _sapp.android.is_thread_stopping == 0 {
        if _sapp_android_should_update() != 0 {
            _sapp_android_frame(0.0);
        }
        bool process_events = true;
        while process_events && !_sapp.android.is_thread_stopping {
            bool block_until_event = !_sapp.android.is_thread_stopping && !_sapp_android_should_update();
            process_events = ALooper_pollOnce(block_until_event != 0 ? -1 : 0, null, null, null) == -2;
        }
    }
    if _sapp.android.current.input != null {
        AInputQueue_detachLooper(_sapp.android.current.input);
    }
    pthread_mutex_lock(&_sapp.android.pt.mutex);
    _sapp.android.is_thread_stopped = true;
    pthread_cond_broadcast(&_sapp.android.pt.cond);
    pthread_mutex_unlock(&_sapp.android.pt.mutex);
    _sapp_log(SAPP_LOGITEM_ANDROID_LOOP_THREAD_DONE, 3, null, 3249);
    return null;
}

/* android main/ui thread */
void _sapp_android_msg(_sapp_android_msg_t msg) {
    if write(_sapp.android.pt.write_from_main_fd, &msg, sizeof(msg)) != sizeof(msg) {
        _sapp_log(SAPP_LOGITEM_ANDROID_WRITE_MSG_FAILED, 1, null, 3247);
    }
}

void _sapp_android_on_start(ANativeActivity* activity) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONSTART, 3, null, 3249);
}

void _sapp_android_on_resume(ANativeActivity* activity) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONRESUME, 3, null, 3249);
    _sapp_android_msg(_SOKOL_ANDROID_MSG_RESUME);
}

void* _sapp_android_on_save_instance_state(ANativeActivity* activity, u64* out_size) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONSAVEINSTANCESTATE, 3, null, 3249);
    *out_size = 0;
    return null;
}

void _sapp_android_on_window_focus_changed(ANativeActivity* activity, i32 has_focus) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONWINDOWFOCUSCHANGED, 3, null, 3249);
    if has_focus != 0 {
        _sapp_android_msg(_SOKOL_ANDROID_MSG_FOCUS);
    } else {
        _sapp_android_msg(_SOKOL_ANDROID_MSG_NO_FOCUS);
    }
}

void _sapp_android_on_pause(ANativeActivity* activity) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONPAUSE, 3, null, 3249);
    _sapp_android_msg(_SOKOL_ANDROID_MSG_PAUSE);
}

void _sapp_android_on_stop(ANativeActivity* activity) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONSTOP, 3, null, 3249);
}

void _sapp_android_msg_set_native_window(ANativeWindow* window) {
    pthread_mutex_lock(&_sapp.android.pt.mutex);
    _sapp.android.pending.window = window;
    _sapp_android_msg(_SOKOL_ANDROID_MSG_SET_NATIVE_WINDOW);
    while _sapp.android.current.window != window {
        pthread_cond_wait(&_sapp.android.pt.cond, &_sapp.android.pt.mutex);
    }
    pthread_mutex_unlock(&_sapp.android.pt.mutex);
}

void _sapp_android_on_native_window_created(ANativeActivity* activity, ANativeWindow* window) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONNATIVEWINDOWCREATED, 3, null, 3249);
    _sapp_android_msg_set_native_window(window);
}

void _sapp_android_on_native_window_destroyed(ANativeActivity* activity, ANativeWindow* window) {
    ignore activity;
    ignore window;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONNATIVEWINDOWDESTROYED, 3, null, 3249);
    _sapp_android_msg_set_native_window(null);
}

void _sapp_android_msg_set_input_queue(AInputQueue* input) {
    pthread_mutex_lock(&_sapp.android.pt.mutex);
    _sapp.android.pending.input = input;
    _sapp_android_msg(_SOKOL_ANDROID_MSG_SET_INPUT_QUEUE);
    while _sapp.android.current.input != input {
        pthread_cond_wait(&_sapp.android.pt.cond, &_sapp.android.pt.mutex);
    }
    pthread_mutex_unlock(&_sapp.android.pt.mutex);
}

void _sapp_android_on_input_queue_created(ANativeActivity* activity, AInputQueue* queue) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONINPUTQUEUECREATED, 3, null, 3249);
    _sapp_android_msg_set_input_queue(queue);
}

void _sapp_android_on_input_queue_destroyed(ANativeActivity* activity, AInputQueue* queue) {
    ignore activity;
    ignore queue;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONINPUTQUEUEDESTROYED, 3, null, 3249);
    _sapp_android_msg_set_input_queue(null);
}

void _sapp_android_on_config_changed(ANativeActivity* activity) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONCONFIGURATIONCHANGED, 3, null, 3249);
}

void _sapp_android_on_low_memory(ANativeActivity* activity) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONLOWMEMORY, 3, null, 3249);
}

void _sapp_android_on_destroy(ANativeActivity* activity) {
    ignore activity;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONDESTROY, 3, null, 3249);
    pthread_mutex_lock(&_sapp.android.pt.mutex);
    _sapp_android_msg(_SOKOL_ANDROID_MSG_DESTROY);
    while _sapp.android.is_thread_stopped == 0 {
        pthread_cond_wait(&_sapp.android.pt.cond, &_sapp.android.pt.mutex);
    }
    pthread_mutex_unlock(&_sapp.android.pt.mutex);
    pthread_cond_destroy(&_sapp.android.pt.cond);
    pthread_mutex_destroy(&_sapp.android.pt.mutex);
    close(_sapp.android.pt.read_from_main_fd);
    close(_sapp.android.pt.write_from_main_fd);
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_DONE, 3, null, 3249);
    exit(0);
}
}

void ANativeActivity_onCreate(ANativeActivity* activity, void* saved_state, u64 saved_state_size) {
    ignore saved_state;
    ignore saved_state_size;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_ONCREATE, 3, null, 3249);
    _sapp_clear(&_sapp, cast(u64, sizeof(_sapp)));
    _sapp.android.activity = activity;
    sapp_desc desc = sokol_main();
    _sapp_init_state(&desc);
    _sapp.android.activity = activity;
    noinit i32[2] pipe_fd;
    if pipe(pipe_fd) != 0 {
        _sapp_log(SAPP_LOGITEM_ANDROID_CREATE_THREAD_PIPE_FAILED, 1, null, 3247);
        return;
    }
    _sapp.android.pt.read_from_main_fd = pipe_fd[0];
    _sapp.android.pt.write_from_main_fd = pipe_fd[1];
    pthread_mutex_init(&_sapp.android.pt.mutex, null);
    pthread_cond_init(&_sapp.android.pt.cond, null);
    noinit pthread_attr_t attr;
    pthread_attr_init(&attr);
    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
    pthread_create(&_sapp.android.pt.thread, &attr, cast(fn(void*): void*, _sapp_android_loop), null);
    pthread_attr_destroy(&attr);
    pthread_mutex_lock(&_sapp.android.pt.mutex);
    while _sapp.android.is_thread_started == 0 {
        pthread_cond_wait(&_sapp.android.pt.cond, &_sapp.android.pt.mutex);
    }
    pthread_mutex_unlock(&_sapp.android.pt.mutex);
    pthread_mutex_lock(&_sapp.android.pt.mutex);
    _sapp_android_msg(_SOKOL_ANDROID_MSG_CREATE);
    while _sapp.android.has_created == 0 {
        pthread_cond_wait(&_sapp.android.pt.cond, &_sapp.android.pt.mutex);
    }
    pthread_mutex_unlock(&_sapp.android.pt.mutex);
    activity.callbacks.onStart = _sapp_android_on_start;
    activity.callbacks.onResume = _sapp_android_on_resume;
    activity.callbacks.onSaveInstanceState = _sapp_android_on_save_instance_state;
    activity.callbacks.onWindowFocusChanged = _sapp_android_on_window_focus_changed;
    activity.callbacks.onPause = _sapp_android_on_pause;
    activity.callbacks.onStop = _sapp_android_on_stop;
    activity.callbacks.onDestroy = _sapp_android_on_destroy;
    activity.callbacks.onNativeWindowCreated = _sapp_android_on_native_window_created;
    activity.callbacks.onNativeWindowDestroyed = _sapp_android_on_native_window_destroyed;
    activity.callbacks.onInputQueueCreated = _sapp_android_on_input_queue_created;
    activity.callbacks.onInputQueueDestroyed = _sapp_android_on_input_queue_destroyed;
    activity.callbacks.onLowMemory = _sapp_android_on_low_memory;
    _sapp_log(SAPP_LOGITEM_ANDROID_NATIVE_ACTIVITY_CREATE_SUCCESS, 3, null, 3249);
}
