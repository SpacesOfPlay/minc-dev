void _sg_mtl_setup_backend(sg_desc* desc) {
    assert(cast(i64, desc));
    assert(cast(i64, desc.environment.metal.device));
    assert(desc.uniform_buffer_size > 0);
    _sg_mtl_init_pool(desc);
    _sg_mtl_clear_state_cache();
    _sg.mtl.valid = true;
    _sg.mtl.ub_size = desc.uniform_buffer_size;
    _sg.mtl.sem = dispatch_semaphore_create(SG_NUM_INFLIGHT_FRAMES);
    _sg.mtl.device = cast(ObjcId, desc.environment.metal.device);
    _sg.mtl.cmd_queue = cast(fn(void*, void*): void*, objc.raw)(_sg.mtl.device, objc_selref("newCommandQueue"));
    for i32 i = 0; i < SG_NUM_INFLIGHT_FRAMES; i++ {
        _sg.mtl.uniform_buffers[i] = cast(fn(void*, void*, u64, u64): void*, objc.raw)(_sg.mtl.device, objc_selref("newBufferWithLength:options:"), cast(u64, cast(NSUInteger, _sg.mtl.ub_size)), cast(u64, MTLResourceCPUCacheModeWriteCombined | MTLResourceStorageModeShared));
        when defined(SOKOL_DEBUG) {
            cast(fn(void*, void*, void*): void, objc.raw)(_sg.mtl.uniform_buffers[i], objc_selref("setLabel:"), cast(fn(void*, void*, u8*, ...): void*, objc.raw)(objc_classref("NSString", "/System/Library/Frameworks/Foundation.framework/Foundation"), objc_selref("stringWithFormat:"), cast(fn(void*, void*, u8*): void*, objc.raw)(objc_classref("NSString", "/System/Library/Frameworks/Foundation.framework/Foundation"), objc_selref("stringWithUTF8String:"), "sg-uniform-buffer.%d"), i));
        }
    }
    if desc.metal.force_managed_storage_mode != 0 {
        _sg.mtl.use_shared_storage_mode = false;
    } else if true {
        bool is_apple_gpu = cast(fn(void*, void*, i64): bool, objc.raw)(_sg.mtl.device, objc_selref("supportsFamily:"), cast(i64, MTLGPUFamilyApple1));
        if is_apple_gpu == 0 {
            _sg.mtl.use_shared_storage_mode = false;
        } else {
            _sg.mtl.use_shared_storage_mode = true;
        }
    } else {
        _sg.mtl.use_shared_storage_mode = true;
    }
    _sg_mtl_init_caps();
}





void _sg_mtl_seal_buffer(_sg_buffer_t* buf) {
    assert(cast(i64, buf));
    ignore buf;
}























void _sg_mtl_begin_pass(sg_pass* pass, _sg_attachments_ptrs_t* atts) {
    assert(pass && atts);
    assert(cast(i64, _sg.mtl.cmd_queue));
    assert(null == _sg.mtl.compute_cmd_encoder);
    assert(null == _sg.mtl.render_cmd_encoder);
    assert(null == _sg.mtl.cur_drawable);
    _sg_mtl_clear_state_cache();
    if null == _sg.mtl.cmd_buffer {
        dispatch_semaphore_wait(_sg.mtl.sem, DISPATCH_TIME_FOREVER);
        if _sg.desc.metal.use_command_buffer_with_retained_references != 0 {
            _sg.mtl.cmd_buffer = cast(fn(void*, void*): void*, objc.raw)(_sg.mtl.cmd_queue, objc_selref("commandBuffer"));
        } else {
            _sg.mtl.cmd_buffer = objc.msg_id_v(_sg.mtl.cmd_queue, objc_selref("commandBufferWithUnretainedReferences"));
        }
        objc.msg_id_v(_sg.mtl.cmd_buffer, objc_selref("enqueue"));
