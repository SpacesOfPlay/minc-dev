    }
}

u32 _sg_gl_blend_op(sg_blend_op op) {
    switch op {
        case SG_BLENDOP_ADD: {
            return GL_FUNC_ADD;
        }
        case SG_BLENDOP_SUBTRACT: {
            return GL_FUNC_SUBTRACT;
        }
        case SG_BLENDOP_REVERSE_SUBTRACT: {
            return GL_FUNC_REVERSE_SUBTRACT;
        }
        case SG_BLENDOP_MIN: {
            return GL_MIN;
        }
        case SG_BLENDOP_MAX: {
