}
sg_mtl_buffer_info sg_mtl_query_buffer_info(sg_buffer buf_id) {
    assert(cast(i64, _sg.valid));
    sg_mtl_buffer_info res;
    _sg_buffer_t* buf = _sg_lookup_buffer(buf_id.id);
    if buf != null {
        for i32 i = 0; i < SG_NUM_INFLIGHT_FRAMES; i++ {
            if buf.mtl.buf[i] != 0 {
                res.buf[i] = cast(void*, _sg_mtl_id(buf.mtl.buf[i]));
            }
        }
        res.active_slot = buf.cmn.active_slot;
    }
    return res;
}
sg_mtl_image_info sg_mtl_query_image_info(sg_image img_id) {
    assert(cast(i64, _sg.valid));
    sg_mtl_image_info res;
    _sg_image_t* img = _sg_lookup_image(img_id.id);
    if img != null {
        for i32 i = 0; i < SG_NUM_INFLIGHT_FRAMES; i++ {
            if img.mtl.tex[i] != 0 {
                res.tex[i] = cast(void*, _sg_mtl_id(img.mtl.tex[i]));
            }
        }
        res.active_slot = img.cmn.active_slot;
    }
    return res;
}
sg_mtl_sampler_info sg_mtl_query_sampler_info(sg_sampler smp_id) {
    assert(cast(i64, _sg.valid));
    sg_mtl_sampler_info res;
    _sg_sampler_t* smp = _sg_lookup_sampler(smp_id.id);
    if smp != null {
        if smp.mtl.sampler_state != 0 {
            res.smp = cast(void*, _sg_mtl_id(smp.mtl.sampler_state));
        }
    }
    return res;
}
sg_mtl_shader_info sg_mtl_query_shader_info(sg_shader shd_id) {
    assert(cast(i64, _sg.valid));
    sg_mtl_shader_info res;
    _sg_shader_t* shd = _sg_lookup_shader(shd_id.id);
    if shd != null {
        i32 vertex_lib = shd.mtl.vertex_func.mtl_lib;
        i32 vertex_func = shd.mtl.vertex_func.mtl_func;
        i32 fragment_lib = shd.mtl.fragment_func.mtl_lib;
        i32 fragment_func = shd.mtl.fragment_func.mtl_func;
        if vertex_lib != 0 {
            res.vertex_lib = cast(void*, _sg_mtl_id(vertex_lib));
        }
        if fragment_lib != 0 {
            res.fragment_lib = cast(void*, _sg_mtl_id(fragment_lib));
        }
        if vertex_func != 0 {
            res.vertex_func = cast(void*, _sg_mtl_id(vertex_func));
        }
        if fragment_func != 0 {
            res.fragment_func = cast(void*, _sg_mtl_id(fragment_func));
        }
    }
    return res;
}
sg_mtl_pipeline_info sg_mtl_query_pipeline_info(sg_pipeline pip_id) {
    assert(cast(i64, _sg.valid));
    sg_mtl_pipeline_info res;
    _sg_pipeline_t* pip = _sg_lookup_pipeline(pip_id.id);
    if pip != null {
        if pip.mtl.rps != 0 {
            res.rps = cast(void*, _sg_mtl_id(pip.mtl.rps));
        }
        if pip.mtl.dss != 0 {
            res.dss = cast(void*, _sg_mtl_id(pip.mtl.dss));
        }
    }
    return res;
}
