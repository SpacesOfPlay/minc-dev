void _sapp_macos_destroy_custom_mouse_cursor(sapp_mouse_cursor cursor) {
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    assert(_sapp.macos.custom_cursors[cursor] != null);
    {
        _sapp.macos.custom_cursors[cursor] = null;
    }
}
void _sapp_macos_set_icon(sapp_icon_desc* icon_desc, i32 num_images) {
    NSDockTile* dock_tile = objc.msg_id_v(NSApp, objc_selref("dockTile"));
    var wanted_width = cast(i32, cast(fn(void*, void*): NSSize, objc.raw)(dock_tile, objc_selref("size")).width);
    var wanted_height = cast(i32, cast(fn(void*, void*): NSSize, objc.raw)(dock_tile, objc_selref("size")).height);
    i32 img_index = _sapp_image_bestmatch(icon_desc.images, num_images, wanted_width, wanted_height);
    sapp_image_desc* img_desc = &icon_desc.images[img_index];
    CGColorSpaceRef cg_color_space = CGColorSpaceCreateDeviceRGB();
    CFDataRef cf_data = CFDataCreate(kCFAllocatorDefault, cast(UInt8*, img_desc.pixels.ptr), cast(CFIndex, img_desc.pixels.size));
    CGDataProviderRef cg_data_provider = CGDataProviderCreateWithCFData(cf_data);
