    }
}
u8* _sapp_macos_get_clipboard_string() {
    assert(cast(i64, _sapp.clipboard.buffer));
    {
        _sapp.clipboard.buffer[0] = 0;
        NSPasteboard* pasteboard = objc.msg_id_v(objc_classref("NSPasteboard", "/System/Library/Frameworks/AppKit.framework/AppKit"), objc_selref("generalPasteboard"));
        if cast(fn(void*, void*, void*): bool, objc.raw)(objc.msg_id_v(pasteboard, objc_selref("types")), objc_selref("containsObject:"), NSPasteboardTypeString) == 0 {
            return _sapp.clipboard.buffer;
        }
        NSString* str_var = objc.msg_id_i(pasteboard, objc_selref("stringForType:"), NSPasteboardTypeString);  // renamed from: str
        if str_var == null {
            return _sapp.clipboard.buffer;
        }
        _sapp_strcpy(objc.msg_id_v(str_var, objc_selref("UTF8String")), _sapp.clipboard.buffer, cast(u64, _sapp.clipboard.buf_size));
    }
    return _sapp.clipboard.buffer;
}
void _sapp_macos_update_window_title() {
    objc.msg_id_i(_sapp.macos.window, objc_selref("setTitle:"), cast(fn(void*, void*, u8*): void*, objc.raw)(objc_classref("NSString", "/System/Library/Frameworks/Foundation.framework/Foundation"), objc_selref("stringWithUTF8String:"), _sapp.window_title));
}
void _sapp_macos_mouse_update_from_nspoint(NSPoint mouse_pos, bool clear_dxdy) {
    if _sapp.mouse.locked == 0 {
        var new_x = cast(f32, cast(f32, mouse_pos.x) * _sapp.dpi_scale);
        var new_y = cast(f32, cast(f64, _sapp.framebuffer_height) - cast(f32, mouse_pos.y) * _sapp.dpi_scale - 1.0);
        if clear_dxdy != 0 {
            _sapp.mouse.dx = 0.0f;
            _sapp.mouse.dy = 0.0f;
        } else if _sapp.mouse.pos_valid != 0 {
            _sapp.mouse.dx = new_x - _sapp.mouse.x;
            _sapp.mouse.dy = new_y - _sapp.mouse.y;
        }
        _sapp.mouse.x = new_x;
        _sapp.mouse.y = new_y;
        _sapp.mouse.pos_valid = true;
    }
}
void _sapp_macos_mouse_update_from_nsevent(NSEvent* event, bool clear_dxdy) {
    _sapp_macos_mouse_update_from_nspoint(cast(fn(void*, void*): NSPoint, objc.raw)(event, objc_selref("locationInWindow")), clear_dxdy);
}
void _sapp_macos_show_mouse(bool visible) {
    if visible != 0 {
        CGDisplayShowCursor(kCGDirectMainDisplay);
    } else {
        CGDisplayHideCursor(kCGDirectMainDisplay);
    }
}
void _sapp_macos_lock_mouse(bool lock) {
    if lock == _sapp.mouse.locked {
        return;
    }
    _sapp.mouse.dx = 0.0f;
    _sapp.mouse.dy = 0.0f;
    _sapp.mouse.locked = lock;
    if _sapp.mouse.locked != 0 {
        CGAssociateMouseAndMouseCursorPosition(false);
        objc.msg_id_v(objc_getClass("NSCursor"), objc_selref("hide"));
    } else {
        objc.msg_id_v(objc_getClass("NSCursor"), objc_selref("unhide"));
        CGAssociateMouseAndMouseCursorPosition(true);
    }
}
void _sapp_macos_update_cursor(sapp_mouse_cursor cursor, bool shown) {
    if shown != _sapp.mouse.shown {
        if shown != 0 {
            objc.msg_id_v(objc_getClass("NSCursor"), objc_selref("unhide"));
        } else {
            objc.msg_id_v(objc_getClass("NSCursor"), objc_selref("hide"));
        }
    }
    assert(cursor >= 0 && cursor < _SAPP_MOUSECURSOR_NUM);
    NSCursor* ns_cursor = null;
    if _sapp.custom_cursor_bound[cursor] != 0 {
        assert(cast(i64, _sapp.macos.custom_cursors[cursor]));
        ns_cursor = _sapp.macos.custom_cursors[cursor];
    } else if _sapp.macos.standard_cursors[cursor] != null {
        ns_cursor = _sapp.macos.standard_cursors[cursor];
    } else {
        ns_cursor = objc.msg_id_v(objc_getClass("NSCursor"), objc_selref("arrowCursor"));
    }
    objc.msg_id_v(ns_cursor, objc_selref("set"));
}
