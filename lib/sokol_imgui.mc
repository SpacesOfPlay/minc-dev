private {
bool _simgui_is_ctrl(u32 modifiers) {
    if _simgui.is_osx != 0 {
        return 0 != (modifiers & cast(u32, SAPP_MODIFIER_SUPER));
    } else {
        return 0 != (modifiers & cast(u32, SAPP_MODIFIER_CTRL));
    }
}

