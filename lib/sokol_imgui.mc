//<#shdgen
void _simgui_set_clipboard(ImGuiContext* ctx, u8* text) {
    ignore ctx;
    sapp_set_clipboard_string(text);
}

u8* _simgui_get_clipboard(ImGuiContext* ctx) {
    ignore ctx;
    return sapp_get_clipboard_string();
}
}

i32 simgui_js_is_osx() {
    return 0;
}
