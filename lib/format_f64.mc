// Shortest round-trip f64 formatter (Ryu).
//
//   import format_f64;
//   string s = format_f64(3.141592653589793);   // "3.141592653589793"
//   i32 n = f64_to_str(v, buf);                 // into a caller buffer (>= 32 bytes)
//
// Returns the shortest decimal that reads back as the same f64.
// Special values give "nan", "inf", "-inf"; zero gives "0.0".
// Magnitudes in [1e-4, 1e21) print as plain decimal, the rest in
// scientific notation.
//
// Reference: Adams 2018, "Ryu: Fast Float-to-String Conversion."

private {

// f64 5^q tables for Ryu. Each entry is 128 bits, stored as a
// (hi, lo) pair of 64-bit raw bit patterns. The Ryu paper calls
// these 'split' to mark the 128-bit value as a hi/lo pair.
//
// POW5: q in [0, 325], normalized to 125 bits.
// INV : q in [0, 291], 5^-q approximation.

const i32 RYU_POW5_BITCOUNT       = 125;
const i32 RYU_POW5_INV_BITCOUNT   = 125;
const i32 RYU_POW5_TABLE_SIZE     = 326;
const i32 RYU_POW5_INV_TABLE_SIZE = 292;

