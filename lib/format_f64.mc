// ------ low-level arithmetic helpers ----------------------------------

// 64x64 -> 128 unsigned multiply. Returns hi via out-pointer, lo via
// return. Splits both inputs into 32-bit halves and sums four partial
// products.
//
// `>>` is an arithmetic shift, so it copies the sign bit. A 32x32
// product can set bit 63, so each `>> 32` is masked with mask32 to
// keep the upper half unsigned.
i64 ryu_umul128(i64 a, i64 b, i64* hi_out) {
    i64 mask32 = 0xFFFFFFFF;
    i64 a_lo = a & mask32;
    i64 a_hi = (a >> 32) & mask32;
    i64 b_lo = b & mask32;
    i64 b_hi = (b >> 32) & mask32;
    i64 ll = a_lo * b_lo;
    i64 lh = a_lo * b_hi;
    i64 hl = a_hi * b_lo;
    i64 hh = a_hi * b_hi;
    i64 mid = ((ll >> 32) & mask32) + (lh & mask32) + (hl & mask32);
    i64 lo = (ll & mask32) | ((mid & mask32) << 32);
    i64 hi = hh + ((lh >> 32) & mask32) + ((hl >> 32) & mask32) + ((mid >> 32) & mask32);
    *hi_out = hi;
    return lo;
}

// Logical (unsigned) right shift by s in [1, 63]. Masks off the sign
// bits an arithmetic `>>` would copy into the top.
i64 ryu_lshr(i64 v, i32 s) {
    if s == 0 { return v; }
    if s >= 64 { return 0; }
    i64 mask = (cast(i64, 1) << (64 - s)) - 1;
    return (v >> s) & mask;
}

// (m * mul) >> shift, where mul is the 128-bit (mul_hi : mul_lo) and
// shift is in [0, 192). Used by Ryu's mulPow5*DivPow2 routines.
// Returns the low 64 bits of the shifted result.
i64 ryu_mul_shift(i64 m, i64 mul_hi, i64 mul_lo, i32 shift) {
    i64 mask32 = 0xFFFFFFFF;

    // Compute m * mul_lo and m * mul_hi as 128-bit (hi:lo) pairs.
    i64 r0_hi;
    i64 r0_lo = ryu_umul128(m, mul_lo, &r0_hi);
    i64 r1_hi;
    i64 r1_lo = ryu_umul128(m, mul_hi, &r1_hi);

    // The 192-bit value is (r1_hi : r1_lo : 0) + (0 : r0_hi : r0_lo).
    // Add the middle words r0_hi + r1_lo with explicit carry detection
    // via 32-bit half-splits (avoids signed-overflow ambiguity).
    i64 ml = (r0_hi & mask32) + (r1_lo & mask32);
    i64 mh = ((r0_hi >> 32) & mask32) + ((r1_lo >> 32) & mask32) + ((ml >> 32) & mask32);
    i64 mid = (ml & mask32) | ((mh & mask32) << 32);
    i64 carry = (mh >> 32) & mask32;
    i64 hi = r1_hi + carry;

    // Shift the 192-bit value (hi : mid : r0_lo) right by `shift`,
    // returning the low 64 bits.
    if shift < 64 {
        if shift == 0 { return r0_lo; }
        return ryu_lshr(r0_lo, shift) | (mid << (64 - shift));
    } else if shift < 128 {
        i32 s = shift - 64;
        if s == 0 { return mid; }
        return ryu_lshr(mid, s) | (hi << (64 - s));
    } else {
        i32 s = shift - 128;
        return ryu_lshr(hi, s);
    }
}

// Divide a 64-bit unsigned by 5^q, where q is small. Used in shortest-
// digit search. Implemented via repeated /5; the inner loop divides by
// 100 to halve iterations.
i32 ryu_pow5_factor(i64 value) {
    i32 count = 0;
    while value != 0 {
        // value % 5 == 0?
        i64 q = value / 5;
        if q * 5 != value { return count; }
        value = q;
        count = count + 1;
    }
    return count;
}

bool ryu_multiple_of_power_of_5(i64 value, i32 p) {
    return ryu_pow5_factor(value) >= p;
}

bool ryu_multiple_of_power_of_2(i64 value, i32 p) {
    if p >= 64 { return value == 0; }
    i64 mask = (cast(i64, 1) << p) - 1;
    return (value & mask) == 0;
}

// floor(e * log10(2)) for e in [-1500, 1500]. Fixed-point: log10(2) ≈
// 78913 / 2^18 (off by < 1 ulp over the range we use).
i32 ryu_log10_pow2(i32 e) {
    // Allow negative e — multiply preserves sign of operand.
    return (e * 78913) >> 18;
}

// floor(e * log10(5)) for e in [-1500, 1500].
i32 ryu_log10_pow5(i32 e) {
    return (e * 732923) >> 20;
}

// ceil(e * log2(5)) for e in [-1500, 1500].
i32 ryu_pow5_bits(i32 e) {
    return ((e * 1217359) >> 19) + 1;
}

// ------ table-backed mulShift wrappers -------------------------------

// Compute floor(m * 5^q / 2^j) for q >= 0, using ryu_pow5_split[q].
// j must equal pow5_bits(q) - 1 + RYU_POW5_BITCOUNT - 64 (in the
// mulShift frame; Ryu's caller picks j so the result fits in 64 bits).
i64 ryu_mul_pow5_div_pow2(i64 m, i32 q, i32 j) {
    return ryu_mul_shift(m, ryu_pow5_split_hi[q], ryu_pow5_split_lo[q], j);
}

// Compute floor(m / 5^q) approximated via m * pow5_inv[q] >> j.
i64 ryu_mul_pow5_inv_div_pow2(i64 m, i32 q, i32 j) {
    return ryu_mul_shift(m, ryu_pow5_inv_split_hi[q], ryu_pow5_inv_split_lo[q], j);
}

// ------ digit-emission helpers ---------------------------------------

// Write the decimal representation of `n` into `buf` (no sign).
// Returns the number of bytes written. `n` must be > 0; caller emits
// "0" specially.
i32 ryu_write_uint(i64 n, u8* buf) {
    u8[24] tmp;
    i32 len = 0;
    while n > 0 {
        i64 d = n % 10;
        tmp[len] = cast(u8, '0' + cast(i32, d));
        n = n / 10;
        len = len + 1;
    }
    for i32 i = 0; i < len; i = i + 1 {
        *(buf + i) = tmp[len - 1 - i];
    }
    return len;
}

// Number of decimal digits in `n` (n > 0).
i32 ryu_decimal_length(i64 n) {
    i32 d = 0;
    while n > 0 { n = n / 10; d = d + 1; }
    return d;
}

// ------ the Ryu64 core ------------------------------------------------

// Decomposed shortest-decimal result.
struct RyuDecimal64 {
    i64 mantissa;
    i32 exponent;
    bool sign;
}

// Decompose a non-special f64 into the shortest decimal. Caller has
// already filtered NaN / Inf / 0.
RyuDecimal64 ryu_d2d(i64 bits) {
    i32 ieee_exp = cast(i32, (bits >> 52) & 0x7FF);
    i64 ieee_mant = bits & 0xFFFFFFFFFFFFF;
    bool sign = (bits >> 63) != 0;

    i64 m2;
    i32 e2;
    if ieee_exp == 0 {
        m2 = ieee_mant;
        e2 = 1 - 1023 - 52 - 2;          // subnormal: e = 1 - bias - mantissa_bits - 2
    } else {
        m2 = ieee_mant | (cast(i64, 1) << 52);
        e2 = ieee_exp - 1023 - 52 - 2;
    }

    bool even = (m2 & 1) == 0;
    bool accept_bounds = even;

    // Boundaries: mv = 4*m2, mp = mv + 2. The lower boundary mm uses
    // mm = mv - 2 in the *normal* case and mm = mv - 1 only at the
    // boundary where ieee_mant == 0 AND ieee_exp > 1 — at such powers
    // of 2 the previous f64 is half the spacing closer than usual.
    // Hence mm_shift = 1 in the normal case and 0 at the boundary.
    i64 mv = 4 * m2;
    i64 mp = 4 * m2 + 2;
    i32 mm_shift = 1;
    if ieee_mant == 0 && ieee_exp > 1 {
        mm_shift = 0;
    }
    i64 mm = 4 * m2 - 1 - mm_shift;

    // Ryu step 1: convert (mv*2^e2, mm*2^e2, mp*2^e2) into the form
    // (vr, vm, vp) * 10^e10, with vp >= vm and digit count minimized.
    i64 vr; i64 vp; i64 vm;
    i32 e10;
    bool vm_is_trailing_zeros = false;
    bool vr_is_trailing_zeros = false;

    if e2 >= 0 {
        i32 q = ryu_log10_pow2(e2);
        if e2 > 3 {
            q = q - 1;
        }
        e10 = q;
        i32 k = RYU_POW5_INV_BITCOUNT + ryu_pow5_bits(q) - 1;
        i32 i = (0 - e2) + q + k;
        vr = ryu_mul_pow5_inv_div_pow2(mv, q, i);
        vp = ryu_mul_pow5_inv_div_pow2(mp, q, i);
        vm = ryu_mul_pow5_inv_div_pow2(mm, q, i);
        if q <= 21 {
            // mv divisible by 5? If so, trailing-zero check is exact.
            if mv % 5 == 0 {
                vr_is_trailing_zeros = ryu_multiple_of_power_of_5(mv, q);
            } else if accept_bounds {
                vm_is_trailing_zeros = ryu_multiple_of_power_of_5(mm, q);
            } else {
                if ryu_multiple_of_power_of_5(mp, q) { vp = vp - 1; }
            }
        }
    } else {
        i32 q = ryu_log10_pow5(0 - e2);
        if (0 - e2) > 1 {
            q = q - 1;
        }
        e10 = q + e2;
        i32 i = (0 - e2) - q;
        i32 k = ryu_pow5_bits(i) - RYU_POW5_BITCOUNT;
        i32 j = q - k;
        vr = ryu_mul_pow5_div_pow2(mv, i, j);
        vp = ryu_mul_pow5_div_pow2(mp, i, j);
        vm = ryu_mul_pow5_div_pow2(mm, i, j);
        if q <= 1 {
            vr_is_trailing_zeros = true;
            if accept_bounds {
                vm_is_trailing_zeros = mm_shift == 1;
            } else {
                vp = vp - 1;
            }
        } else if q < 63 {
            vr_is_trailing_zeros = ryu_multiple_of_power_of_2(mv, q);
        }
    }

    // Ryu step 2: shorten (vr, vm, vp) by removing trailing digits while
    // keeping vm < vp.
    i32 removed = 0;
    i32 last_removed = 0;
    i64 output;
    if vm_is_trailing_zeros || vr_is_trailing_zeros {
        // Slow path: track trailing-zero state.
        while true {
            i64 vp_next = vp / 10;
            i64 vm_next = vm / 10;
            if vp_next <= vm_next { break; }
            vm_is_trailing_zeros = vm_is_trailing_zeros && (vm % 10 == 0);
            vr_is_trailing_zeros = vr_is_trailing_zeros && (last_removed == 0);
            last_removed = cast(i32, vr % 10);
            vr = vr / 10;
            vp = vp_next;
            vm = vm_next;
            removed = removed + 1;
        }
        if vm_is_trailing_zeros {
            while true {
                i64 vm_next = vm / 10;
                if vm_next * 10 != vm { break; }
                i64 vp_next = vp / 10;
                vr_is_trailing_zeros = vr_is_trailing_zeros && (last_removed == 0);
                last_removed = cast(i32, vr % 10);
                vr = vr / 10;
                vp = vp_next;
                vm = vm_next;
                removed = removed + 1;
            }
        }
        bool round_up;
        if vr_is_trailing_zeros && last_removed == 5 && vr % 2 == 0 {
            round_up = false;
        } else {
            round_up = last_removed >= 5;
        }
        bool inc_vr = (vr == vm && (!accept_bounds || !vm_is_trailing_zeros)) || round_up;
        if inc_vr { output = vr + 1; } else { output = vr; }
    } else {
        // Fast path: most common.
        bool round_up = false;
        while true {
            i64 vp_next = vp / 10;
            i64 vm_next = vm / 10;
            if vp_next <= vm_next { break; }
            i64 vr_next = vr / 10;
            round_up = (vr - vr_next * 10) >= 5;
            vr = vr_next;
            vp = vp_next;
            vm = vm_next;
            removed = removed + 1;
        }
        bool inc_vr = vr == vm || round_up;
        if inc_vr { output = vr + 1; } else { output = vr; }
    }

    RyuDecimal64 r;
    r.mantissa = output;
    r.exponent = e10 + removed;
    r.sign = sign;
    return r;
}

// Format the (sign, mantissa, exponent) decimal triple into `buf`.
// Decides decimal vs scientific based on magnitude.
i32 ryu_format_d2d(RyuDecimal64 d, u8* buf) {
    i32 idx = 0;
    if d.sign && d.mantissa != 0 {
        *(buf + idx) = '-';
        idx = idx + 1;
    }
    i32 olen = ryu_decimal_length(d.mantissa);
    // The decimal value is d.mantissa * 10^d.exponent.
    // Equivalently, the displayed value has olen significant digits
    // and a leftmost-decimal exponent of (d.exponent + olen - 1).
    i32 sci_exp = d.exponent + olen - 1;

    // Auto-switch: decimal for 1e-4 <= |x| < 1e21, scientific outside.
    // sci_exp is the exponent for scientific notation (i.e. log10 of the
    // leading-digit value). |x| in [1e-4, 1e21) <=> sci_exp in [-4, 21).
    bool use_sci = sci_exp < (0 - 4) || sci_exp >= 21;

    if use_sci {
        // Output: <digit>.<rest>e<exp>   (rest may be empty if olen==1)
        u8[24] digits;
        i64 m = d.mantissa;
        i32 i = 0;
        while m > 0 {
            digits[i] = cast(u8, '0' + cast(i32, m % 10));
            m = m / 10;
            i = i + 1;
        }
        // Now digits[0..olen-1] holds least-significant-digit-first; reverse.
        // Emit digit[olen-1] '.' digit[olen-2] ... digit[0]
        *(buf + idx) = digits[olen - 1];
        idx = idx + 1;
        if olen > 1 {
            *(buf + idx) = '.';
            idx = idx + 1;
            for i32 k = olen - 2; k >= 0; k = k - 1 {
                *(buf + idx) = digits[k];
                idx = idx + 1;
            }
        } else {
            // Single digit: still emit ".0" so float-ness is visible.
            *(buf + idx) = '.';
            idx = idx + 1;
            *(buf + idx) = '0';
            idx = idx + 1;
        }
        *(buf + idx) = 'e';
        idx = idx + 1;
        i32 e = sci_exp;
        if e < 0 {
            *(buf + idx) = '-';
            idx = idx + 1;
            e = 0 - e;
        }
        // Write exponent (no padding, no '+').
        u8[6] etmp;
        i32 ei = 0;
        if e == 0 {
            etmp[0] = '0';
            ei = 1;
        } else {
            while e > 0 {
                etmp[ei] = cast(u8, '0' + (e % 10));
                e = e / 10;
                ei = ei + 1;
            }
        }
        for i32 k = ei - 1; k >= 0; k = k - 1 {
            *(buf + idx) = etmp[k];
            idx = idx + 1;
        }
        return idx;
    }

    // Decimal path.
    if d.exponent >= 0 {
        // Integer-and-zero-padding case: mantissa followed by `exponent`
        // zeros, then ".0" so float-ness is visible.
        idx = idx + ryu_write_uint(d.mantissa, buf + idx);
        for i32 k = 0; k < d.exponent; k = k + 1 {
            *(buf + idx) = '0';
            idx = idx + 1;
        }
        *(buf + idx) = '.';
        idx = idx + 1;
        *(buf + idx) = '0';
        idx = idx + 1;
        return idx;
    } else {
        // Fractional case: -d.exponent < olen means dot is inside the
        // digits; -d.exponent >= olen means leading "0.0...0" before
        // the digits.
        i32 dot_pos = olen + d.exponent;   // exponent is negative
        // Get digit string into a temp buffer.
        u8[24] digits;
        i64 m = d.mantissa;
        for i32 k = olen - 1; k >= 0; k = k - 1 {
            digits[k] = cast(u8, '0' + cast(i32, m % 10));
            m = m / 10;
        }
        if dot_pos > 0 {
            // Emit dot_pos digits, '.', then the rest.
            for i32 k = 0; k < dot_pos; k = k + 1 {
                *(buf + idx) = digits[k];
                idx = idx + 1;
            }
            *(buf + idx) = '.';
            idx = idx + 1;
            for i32 k = dot_pos; k < olen; k = k + 1 {
                *(buf + idx) = digits[k];
                idx = idx + 1;
            }
            return idx;
        } else {
            // Leading "0." then (-dot_pos) zeros, then all digits.
            *(buf + idx) = '0';
            idx = idx + 1;
            *(buf + idx) = '.';
            idx = idx + 1;
            for i32 k = 0; k < (0 - dot_pos); k = k + 1 {
                *(buf + idx) = '0';
                idx = idx + 1;
            }
            for i32 k = 0; k < olen; k = k + 1 {
                *(buf + idx) = digits[k];
                idx = idx + 1;
            }
            return idx;
        }
    }
}

}  // end private

// ------ public entry points ------------------------------------------

// Write the formatted value into buf (at least 32 bytes) and return its
// length. Specials are read from the bit pattern, so finite values near
// the f64 limit are never mistaken for infinity.
i32 f64_to_str(f64 v, u8* buf) {
    i64 bits = *cast(i64*, &v);
    i64 abs_bits = bits & 0x7FFFFFFFFFFFFFFF;
    i32 exp_field = cast(i32, (abs_bits >> 52) & 0x7FF);
    bool sign = bits < 0;
    if exp_field == 0x7FF {
        if (abs_bits & 0xFFFFFFFFFFFFF) != 0 {
            *(buf + 0) = 'n'; *(buf + 1) = 'a'; *(buf + 2) = 'n';
            return 3;
        }
        if sign {
            *(buf + 0) = '-'; *(buf + 1) = 'i'; *(buf + 2) = 'n'; *(buf + 3) = 'f';
            return 4;
        }
        *(buf + 0) = 'i'; *(buf + 1) = 'n'; *(buf + 2) = 'f';
        return 3;
    }
    // Zero (positive or negative): print "0.0" without sign.
    if abs_bits == 0 {
        *(buf + 0) = '0'; *(buf + 1) = '.'; *(buf + 2) = '0';
        return 3;
    }
    RyuDecimal64 d = ryu_d2d(bits);
    return ryu_format_d2d(d, buf);
}

// Format v as a newly allocated string. The caller owns it.
string format_f64(f64 v) {
    u8* buf = alloc<u8>(32);
    i32 n = f64_to_str(v, buf);
    string s;
    s.data = buf;
    s.len = n;
    return s;
}
