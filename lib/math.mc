// Exact powers of ten (1e0..1e22 are exactly representable).
u64[23] __math_p10_tab = {
    0x3FF0000000000000, 0x4024000000000000, 0x4059000000000000, 0x408F400000000000, 0x40C3880000000000, 0x40F86A0000000000,
    0x412E848000000000, 0x416312D000000000, 0x4197D78400000000, 0x41CDCD6500000000, 0x4202A05F20000000, 0x42374876E8000000,
    0x426D1A94A2000000, 0x42A2309CE5400000, 0x42D6BCC41E900000, 0x430C6BF526340000, 0x4341C37937E08000, 0x4376345785D8A000,
    0x43ABC16D674EC800, 0x43E158E460913D00, 0x4415AF1D78B58C40, 0x444B1AE4D6E2EF50, 0x4480F0CF064DD592,
};

// log: near-1 exact band + table path with hi/lo carries. Within
// 0.7 ulp.
@strict_float
f64 log(f64 x) {
    u64 ix = *cast(u64*, &x);
    if (ix >> 48) >= 0x7FF0 || x <= 0.0 {
        if x != x { return x + x; }
        if x == 0.0 { return -1.0e300 * 1.0e300; }        // log(+-0) = -inf
        if x < 0.0 { return (x - x) / (x - x); }          // NaN
        return x;                                         // +inf
    }
    if ix >= 0x3FEFC00000000000 && ix <= 0x3FF0200000000000 {
        f64 r = x - 1.0;                                  // exact in the band
        return r + r * r * (-0.5 + r * (0.3333333333333333 + r * (-0.25
               + r * (0.2 + r * (-0.16666666666666666 + r * (0.14285714285714285
               + r * (-0.125 + r * (0.1111111111111111 + r * -0.1))))))));
    }
    i32 k0 = 0;
    if ix < 0x0010000000000000 {                          // subnormal
        x = x * 4503599627370496.0;
        ix = *cast(u64*, &x);
        k0 = -52;
    }
    u64 tmp = ix - 0x3FE6000000000000;
    i32 i = cast(i32, (tmp >> 45) & 127);
    i32 k = cast(i32, cast(i64, tmp) >> 52) + k0;
    u64 iz = ix - (tmp & 0xFFF0000000000000);
    f64 z = *cast(f64*, &iz);
    f64* tp = cast(f64*, &__math_log_tab[0]);
    f64 c = *(tp + i * 8);
    f64 invc = *(tp + i * 8 + 1);
    f64 lgh = *(tp + i * 8 + 2);
    f64 lgl = *(tp + i * 8 + 3);
    f64 r = (z - c) * invc;                               // z - c exact
    f64 kd = k;
    f64 a = kd * 0.6931471803691238;                      // exact
    f64 w = a + lgh;
    f64 wr = (a - w) + lgh;
    f64 hi = w + r;
    f64 lo = ((w - hi) + r) + wr + (kd * 1.9082149292705877e-10 + lgl);
    f64 pp = r * r * (-0.5 + r * (0.3333333333333333 + r * (-0.25
             + r * (0.2 + r * (-0.16666666666666666 + r * (0.14285714285714285
             + r * -0.125))))));
    return (pp + lo) + hi;
}

// logf: f64 internal, same table. Within 0.5 ulp.
@strict_float
f32 log(f32 x) {
    u32 xfb = *cast(u32*, &x);
    if xfb >= 0x7F800000 || x <= 0.0f {
        u32 ax = xfb & 0x7FFFFFFF;
        if ax > 0x7F800000 { return x + x; }              // NaN
        if x == 0.0f { return -1.0e30f * 1.0e30f; }       // -inf
        if x < 0.0f || xfb == 0xFF800000 { return (x - x) / (x - x); }
        return x;                                         // +inf
    }
    f64 xd = x;
    u64 ix = *cast(u64*, &xd);
    u64 tmp = ix - 0x3FE6000000000000;
    i32 i = cast(i32, (tmp >> 45) & 127);
    i32 k = cast(i32, cast(i64, tmp) >> 52);
    u64 iz = ix - (tmp & 0xFFF0000000000000);
    f64 z = *cast(f64*, &iz);
    f64* tp = cast(f64*, &__math_log_tab[0]);
    f64 c = *(tp + i * 8);
    f64 invc = *(tp + i * 8 + 1);
    f64 lgh = *(tp + i * 8 + 2);
    f64 r = (z - c) * invc;
    f64 pp = r * r * (-0.5 + r * (0.3333333333333333 + r * (-0.25 + r * 0.2)));
    f64 kd = k;
    f64 y = kd * 0.6931471805599453 + lgh + (r + pp);
    return cast(f32, y);
}

// log2(x) as a normalized hi/lo pair (hi returned, lo stored),
// x > 0 finite (specials are the callers' job). Relative accuracy
// ~2^-70; backs log2, log10 and pow.
@strict_float
f64 __math_log2_dd(f64 x, f64* ol) {
    u64 ix = *cast(u64*, &x);
    if ix >= 0x3FEFC00000000000 && ix <= 0x3FF0200000000000 {
        f64 r = x - 1.0;
        f64 rr2 = r * r;
        f64 rr4 = rr2 * rr2;
        f64 rr8 = rr4 * rr4;
        f64 q = rr2 * ((((-0.5 + r * 0.3333333333333333) + rr2 * (-0.25 + r * 0.2))
                + rr4 * ((-0.16666666666666666 + r * 0.14285714285714285)
                + rr2 * (-0.125 + r * 0.1111111111111111))) + rr8 * -0.1);
        u64 rb = *cast(u64*, &r);
        rb = rb & 0xFFFFFFFFF8000000;
        f64 rh = *cast(f64*, &rb);
        f64 rl = r - rh;
        f64 th = rh * 1.4426950216293335;                 // exact
        f64 tl = (rl * 1.4426950216293335 + r * 1.9259629911266175e-08)
                 + q * 1.4426950408889634;
        f64 lh = th + tl;
        *ol = (th - lh) + tl;
        return lh;
    }
    i32 k0 = 0;
    if ix < 0x0010000000000000 {
        x = x * 4503599627370496.0;
        ix = *cast(u64*, &x);
        k0 = -52;
    }
    u64 tmp = ix - 0x3FE6000000000000;
    i32 i = cast(i32, (tmp >> 45) & 127);
    i32 k = cast(i32, cast(i64, tmp) >> 52) + k0;
    u64 iz = ix - (tmp & 0xFFF0000000000000);
    f64 z = *cast(f64*, &iz);
    f64* tp = cast(f64*, &__math_log_tab[0]);
    f64 l2h = *(tp + i * 8 + 4);
    f64 l2l = *(tp + i * 8 + 5);
    // r = z*invc - 1 exactly, as a pair (invc pre-split in the table)
    u64 izh = iz & 0xFFFFFFFFF8000000;
    f64 zh = *cast(f64*, &izh);
    f64 zl = z - zh;
    f64 ih = *(tp + i * 8 + 6);
    f64 il = *(tp + i * 8 + 7);
    f64 p1 = zh * ih;
    f64 p2 = zh * il + zl * ih;
    f64 p3 = zl * il;
    f64 rh = (p1 - 1.0) + p2;
    f64 rl = (((p1 - 1.0) - rh) + p2) + p3;
    f64 r = rh + rl;
    f64 rr2 = r * r;
    f64 rr4 = rr2 * rr2;
    f64 q = rr2 * (((-0.5 + r * 0.3333333333333333) + rr2 * (-0.25 + r * 0.2))
            + rr4 * ((-0.16666666666666666 + r * 0.14285714285714285)
            + rr2 * -0.125));
    f64 sl0 = rl + q;
    u64 rb = *cast(u64*, &rh);
    rb = rb & 0xFFFFFFFFF8000000;
    f64 rh26 = *cast(f64*, &rb);
    f64 rl26 = rh - rh26;
    f64 th = rh26 * 1.4426950216293335;
    f64 tl = (rl26 * 1.4426950216293335 + rh * 1.9259629911266175e-08)
             + sl0 * 1.4426950408889634;
    f64 kd = k;
    f64 e1 = kd + l2h;
    f64 r1 = (kd - e1) + l2h;
    f64 lh0 = e1 + th;
    f64 r2 = (e1 - lh0) + th;
    f64 ll0 = (((r1 + r2) + l2l) + tl);
    f64 lh = lh0 + ll0;
    *ol = (lh0 - lh) + ll0;
    return lh;
}

// log2: the dd path rounded once. Within 0.6 ulp; exact for powers
// of two by construction.
@strict_float
f64 log2(f64 x) {
    u64 ix = *cast(u64*, &x);
    if (ix >> 48) >= 0x7FF0 || x <= 0.0 {
        if x != x { return x + x; }
        if x == 0.0 { return -1.0e300 * 1.0e300; }
        if x < 0.0 { return (x - x) / (x - x); }
        return x;
    }
    f64 ll = 0.0;
    f64 lh = __math_log2_dd(x, &ll);
    return lh + ll;
}

// log10: dd path times log10(2) hi/lo. Within 1 ulp; exact for
// 10^0..10^22 via the table.
@strict_float
f64 log10(f64 x) {
    u64 ix = *cast(u64*, &x);
    if (ix >> 48) >= 0x7FF0 || x <= 0.0 {
        if x != x { return x + x; }
        if x == 0.0 { return -1.0e300 * 1.0e300; }
        if x < 0.0 { return (x - x) / (x - x); }
        return x;
    }
    if (ix >> 52) - 1023 <= 73 {                          // 1 <= x < 2^74
        f64 pk = __math_p10_match(ix);
        if pk >= 0.0 { return pk; }
    }
    f64 ll = 0.0;
    f64 lh = __math_log2_dd(x, &ll);
    return lh * 0.3010299956639812
           + (ll * 0.3010299956639812 + lh * -2.8037281277851704e-18);
}

// exact power of ten, or -1: 10^k's exponent field pins k to two
// candidates.
f64 __math_p10_match(u64 ix) {
    i32 kest = cast(i32, ((cast(i64, ix >> 52) - 1023) * 1233) >> 12);
    u64* pp = cast(u64*, &__math_p10_tab[0]);
    if ix == *(pp + kest) { return cast(f64, kest); }
    if ix == *(pp + kest + 1) { return cast(f64, kest + 1); }
    return -1.0;
}

// y classified for pow: 0 = not an integer, 1 = odd, 2 = even.
i32 __math_ykind(f64 y) {
    if y != y { return 0; }
    f64 ay = fabs(y);
    if ay >= 9007199254740992.0 { return 2; }             // >= 2^53: even
    if trunc(y) != y { return 0; }
    if (cast(i64, y) & 1) != 0 { return 1; }
    return 2;
}

// pow: y*log2(x) in double-double, exp2 via the exp table. Within
// 2 ulp; specials and negative x take the slow path, which re-enters
// the fast path after reduction. The C99 special-case matrix in full.
@strict_float
f64 pow(f64 x, f64 y) {
    u64 yb = *cast(u64*, &y);
    u64 xb = *cast(u64*, &x);
    if xb - 1 >= 0x7FEFFFFFFFFFFFFF || (yb & 0x7FFFFFFFFFFFFFFF) >= 0x7FF0000000000000 {
        return __math_pow_slow(x, y);
    }
    // x positive finite nonzero, y finite
    f64 ll = 0.0;
    f64 lh = __math_log2_dd(x, &ll);
    // gh + gl = y * (lh + ll) with exact split products
    u64 mb = yb & 0xFFFFFFFFF8000000;
    f64 yh = *cast(f64*, &mb);
    f64 yl = y - yh;
    u64 lb = *cast(u64*, &lh);
    lb = lb & 0xFFFFFFFFF8000000;
    f64 lh27 = *cast(f64*, &lb);
    f64 lhl = lh - lh27;
    f64 p1 = yh * lh27;
    f64 p2 = yh * lhl + yl * lh27;
    f64 p3 = yl * lhl + y * ll;
    f64 gh = p1 + p2;
    f64 gr = (p1 - gh) + p2;
    f64 gl = gr + p3;
    if gh > 1025.0 { return 1.0e300 * 1.0e300; }
    if gh < -1076.0 { return 1.0e-300 * 1.0e-300; }
    // exp2(gh + gl) on the exp table
    f64 kd = gh * 128.0 + 6755399441055744.0;
    u64 kb = *cast(u64*, &kd);
    i32 ki = cast(i32, kb & 0xFFFFFFFF);
    kd = kd - 6755399441055744.0;
    f64 u = (gh - kd * 0.0078125) + gl;
    f64 t = u * 0.6931471805599453;
    i32 j = ki & 127;
    i32 e = ki >> 7;
    f64* ep = cast(f64*, &__math_exp_tab[0]);
    f64 eh = *(ep + j * 2);
    f64 el = *(ep + j * 2 + 1);
    f64 t2 = t * t;
    f64 pq = t + t2 * ((0.5 + t * 0.16666666666666666)
             + t2 * (0.041666666666666664 + t * 0.008333333333333333));
    f64 yv = eh + (el + eh * pq);
    u64 yvb = *cast(u64*, &yv);
    if e >= -1021 {
        if e > 1023 { return 1.0e300 * 1.0e300; }
        yvb = yvb + (cast(u64, cast(i64, e)) << 52);
        return *cast(f64*, &yvb);
    }
    if e < -1075 { return 1.0e-300 * 1.0e-300; }
    yvb = yvb + (cast(u64, cast(i64, e + 1000)) << 52);
    f64 yvs = *cast(f64*, &yvb);
    return yvs * 9.332636185032189e-302;
}

// pow specials and negative-x parity. The reduced positive case
// re-enters pow, which then takes the fast path.
f64 __math_pow_slow(f64 x, f64 y) {
    u64 yb = *cast(u64*, &y);
    if (yb << 1) == 0 { return 1.0; }                     // y = +-0
    if x == 1.0 { return 1.0; }
    if x != x || y != y { return x + y; }                 // NaN
    u64 xb = *cast(u64*, &x);
    if (yb & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000 {  // y = +-inf
        f64 ax = fabs(x);
        if ax == 1.0 { return 1.0; }
        bool yneg = (yb >> 63) != 0;
        if (ax < 1.0) == yneg { return 1.0e300 * 1.0e300; }
        return 0.0;
    }
    bool neg = (xb >> 63) != 0;
    if (xb & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000 {  // x = +-inf
        if !neg {
            if y > 0.0 { return x; }
            return 0.0;
        }
        f64 m = 0.0;
        if y > 0.0 { m = 1.0e300 * 1.0e300; }
        if __math_ykind(y) == 1 { return -m; }
        return m;
    }
    if x == 0.0 {
        i32 kind = __math_ykind(y);
        if y > 0.0 {
            if neg && kind == 1 { return -0.0; }
            return 0.0;
        }
        f64 m = 1.0e300 * 1.0e300;
        if neg && kind == 1 { return -m; }
        return m;
    }
    f64 sign = 1.0;
    if neg {
        i32 kind = __math_ykind(y);
        if kind == 0 { return (x - x) / (x - x); }        // NaN
        if kind == 1 { sign = -1.0; }
        x = -x;
    }
    return sign * pow(x, y);
}

// powf: f64-internal with a single-word log2 — margin is ample at
// f32 precision. Specials and negative x take the slow path.
@strict_float
f32 pow(f32 xf, f32 yf) {
    f64 x = xf;
    f64 y = yf;
    u64 yb = *cast(u64*, &y);
    u64 xb = *cast(u64*, &x);
    if xb - 1 >= 0x7FEFFFFFFFFFFFFF || (yb & 0x7FFFFFFFFFFFFFFF) >= 0x7FF0000000000000 {
        return __math_powf_slow(xf, yf);
    }
    // x positive finite nonzero, y finite
    u64 tmp = xb - 0x3FE6000000000000;
    i32 i = cast(i32, (tmp >> 45) & 127);
    i32 k = cast(i32, cast(i64, tmp) >> 52);
    u64 iz = xb - (tmp & 0xFFF0000000000000);
    f64 z = *cast(f64*, &iz);
    f64* tp = cast(f64*, &__math_log_tab[0]);
    f64 c = *(tp + i * 8);
    f64 invc = *(tp + i * 8 + 1);
    f64 l2h = *(tp + i * 8 + 4);
    f64 r = (z - c) * invc;
    f64 sp = r + r * r * (-0.5 + r * (0.3333333333333333 + r * (-0.25 + r * 0.2)));
    f64 kd = k;
    f64 g = y * ((kd + l2h) + sp * 1.4426950408889634);
    if g > 128.5 { return cast(f32, 1.0e300 * 1.0e300); }
    if g < -151.0 { return 0.0f; }
    f64 kd2 = g * 128.0 + 6755399441055744.0;
    u64 kb = *cast(u64*, &kd2);
    i32 ki = cast(i32, kb & 0xFFFFFFFF);
    kd2 = kd2 - 6755399441055744.0;
    f64 t = (g - kd2 * 0.0078125) * 0.6931471805599453;
    i32 j = ki & 127;
    i32 e = ki >> 7;
    f64* ep = cast(f64*, &__math_exp_tab[0]);
    f64 eh = *(ep + j * 2);
    f64 pq = t + t * t * (0.5 + t * 0.16666666666666666);
    f64 yv = eh + eh * pq;
    u64 yvb = *cast(u64*, &yv);
    yvb = yvb + (cast(u64, cast(i64, e)) << 52);
    return cast(f32, *cast(f64*, &yvb));
}

// powf specials and negative-x parity; the reduced positive case
// re-enters powf's fast path.
f32 __math_powf_slow(f32 xf, f32 yf) {
    f64 x = xf;
    f64 y = yf;
    u64 yb = *cast(u64*, &y);
    if (yb << 1) == 0 { return 1.0f; }
    if x == 1.0 { return 1.0f; }
    if x != x || y != y { return cast(f32, x + y); }
    u64 xb = *cast(u64*, &x);
    if (yb & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000 {
        f64 ax = fabs(x);
        if ax == 1.0 { return 1.0f; }
        bool yneg = (yb >> 63) != 0;
        if (ax < 1.0) == yneg { return 1.0e30f * 1.0e30f; }
        return 0.0f;
    }
    bool neg = (xb >> 63) != 0;
    if (xb & 0x7FFFFFFFFFFFFFFF) == 0x7FF0000000000000 {
        if !neg {
            if y > 0.0 { return cast(f32, x); }
            return 0.0f;
        }
        f32 m = 0.0f;
        if y > 0.0 { m = 1.0e30f * 1.0e30f; }
        if __math_ykind(y) == 1 { return -m; }
        return m;
    }
    if x == 0.0 {
        i32 kind = __math_ykind(y);
        if y > 0.0 {
            if neg && kind == 1 { return -0.0f; }
            return 0.0f;
        }
        f32 m = 1.0e30f * 1.0e30f;
        if neg && kind == 1 { return -m; }
        return m;
    }
    i32 kind = __math_ykind(y);
    if kind == 0 { return cast(f32, (x - x) / (x - x)); }
    f32 rv = pow(-xf, yf);
    if kind == 1 { return -rv; }
    return rv;
}

// --- Canonical sin/cos/tan (musl/fdlibm shapes) ---
//
// Cody-Waite reduction for small and medium arguments, Payne-Hanek
// (__math_rem_pio2_large) for the rest, fdlibm kernel polynomials.
// The f32 functions are f64-internal with their own short kernels.

// 24-bit chunks of the binary fraction of 2/pi
u32[66] __math_ipio2 = {
    0xA2F983, 0x6E4E44, 0x1529FC, 0x2757D1, 0xF534DD, 0xC0DB62,
    0x95993C, 0x439041, 0xFE5163, 0xABDEBB, 0xC561B7, 0x246E3A,
    0x424DD2, 0xE00649, 0x2EEA09, 0xD1921C, 0xFE1DEB, 0x1CB129,
    0xA73EE8, 0x8235F5, 0x2EBB44, 0x84E99C, 0x7026B4, 0x5F7E41,
    0x3991D6, 0x398353, 0x39F49C, 0x845F8B, 0xBDF928, 0x3B1FF8,
    0x97FFDE, 0x05980F, 0xEF2F11, 0x8B5A0A, 0x6D1F6D, 0x367ECF,
    0x27CB09, 0xB74F46, 0x3F669E, 0x5FEA2D, 0x7527BA, 0xC7EBE5,
    0xF17B3D, 0x0739F7, 0x8A5292, 0xEA6BFB, 0x5FB11F, 0x8D5D08,
    0x560330, 0x46FC7B, 0x6BABF0, 0xCFBC20, 0x9AF436, 0x1DA9E3,
    0x91615E, 0xE61B08, 0x659985, 0x5F14A0, 0x68408D, 0xFFD880,
    0x4D7327, 0x310606, 0x1556CA, 0x73A8C9, 0x60E27B, 0xC08C6B,
};

// pi/2 in 24-bit double chunks
u64[8] __math_pio2t = {
    0x3FF921FB40000000, 0x3E74442D00000000, 0x3CF8469880000000, 0x3B78CC5160000000,
    0x39F01B8380000000, 0x387A252040000000, 0x36E3822280000000, 0x3569F31D00000000,
};

@strict_float
f64 __math_scalbn(f64 x, i32 n) {
    if n > 1023 {
        x = x * 8.98846567431158e307;
        n = n - 1023;
        if n > 1023 {
            x = x * 8.98846567431158e307;
            n = n - 1023;
            if n > 1023 { n = 1023; }
        }
    } else {
        if n < -1022 {
            x = x * (2.2250738585072014e-308 * 9007199254740992.0);
            n = n + 1022 - 53;
            if n < -1022 {
                x = x * (2.2250738585072014e-308 * 9007199254740992.0);
                n = n + 1022 - 53;
                if n < -1022 { n = -1022; }
            }
        }
    }
    u64 eb = cast(u64, cast(i64, 0x3FF + n)) << 52;
    return x * *cast(f64*, &eb);
}

// Payne-Hanek reduction of tx[0..nx-1] (24-bit chunks scaled to
// [2^23, 2^24)) times 2^e0, modulo pi/2. Returns octant n; the
// remainder as y0 (+ y1 when prec is 1).
@strict_float
i32 __math_rem_pio2_large(f64* tx, i32 e0, i32 nx, i32 prec, f64* oy0, f64* oy1) {
    f64[20] f;
    f64[20] q;
    f64[20] fq;
    i32[20] iq;
    f64* fp = &f[0];
    f64* qp = &q[0];
    f64* fqp = &fq[0];
    i32* iqp = &iq[0];
    u32* ip2 = cast(u32*, &__math_ipio2[0]);
    i32 jk = 3;
    if prec == 1 { jk = 4; }
    i32 jp = jk;
    i32 jx = nx - 1;
    i32 jv = (e0 - 3) / 24;
    if jv < 0 { jv = 0; }
    i32 q0 = e0 - 24 * (jv + 1);
    i32 j = jv - jx;
    i32 m = jx + jk;
    for i32 i = 0; i <= m; i++ {
        if j < 0 { *(fp + (i)) = 0.0; }
        else { *(fp + (i)) = cast(f64, *(ip2 + j)); }
        j = j + 1;
    }
    for i32 i = 0; i <= jk; i++ {
        f64 fw = 0.0;
        for i32 jj = 0; jj <= jx; jj++ {
            fw = fw + *(tx + jj) * *(fp + (jx + i - jj));
        }
        *(qp + (i)) = fw;
    }
    i32 jz = jk;
    f64 z = 0.0;
    i32 n = 0;
    i32 ih = 0;
    while true {
        // distill q[] into iq[] reversingly
        z = *(qp + (jz));
        i32 di = 0;
        for i32 dj = jz; dj > 0; dj-- {
            f64 fw = cast(f64, cast(i32, 5.9604644775390625e-8 * z));
            *(iqp + (di)) = cast(i32, z - 16777216.0 * fw);
            z = *(qp + (dj - 1)) + fw;
            di = di + 1;
        }
        // compute n
        z = __math_scalbn(z, q0);
        z = z - 8.0 * floor(z * 0.125);
        n = cast(i32, z);
        z = z - cast(f64, n);
        ih = 0;
        if q0 > 0 {
            i32 t2 = *(iqp + (jz - 1)) >> (24 - q0);
            n = n + t2;
            *(iqp + (jz - 1)) = *(iqp + (jz - 1)) - (t2 << (24 - q0));
            ih = *(iqp + (jz - 1)) >> (23 - q0);
        } else {
            if q0 == 0 { ih = *(iqp + (jz - 1)) >> 23; }
            else {
                if z >= 0.5 { ih = 2; }
            }
        }
        if ih > 0 {
            n = n + 1;
            i32 carry = 0;
            for i32 i = 0; i < jz; i++ {
                i32 jq = *(iqp + (i));
                if carry == 0 {
                    if jq != 0 {
                        carry = 1;
                        *(iqp + (i)) = 0x1000000 - jq;
                    }
                } else {
                    *(iqp + (i)) = 0xFFFFFF - jq;
                }
            }
            if q0 == 1 { *(iqp + (jz - 1)) = *(iqp + (jz - 1)) & 0x7FFFFF; }
            if q0 == 2 { *(iqp + (jz - 1)) = *(iqp + (jz - 1)) & 0x3FFFFF; }
            if ih == 2 {
                z = 1.0 - z;
                if carry != 0 { z = z - __math_scalbn(1.0, q0); }
            }
        }
        // recomputation needed?
        if z == 0.0 {
            i32 jt = 0;
            for i32 i = jz - 1; i >= jk; i-- { jt = jt | *(iqp + (i)); }
            if jt == 0 {
                i32 k = 1;
                while *(iqp + (jk - k)) == 0 { k = k + 1; }
                for i32 i = jz + 1; i <= jz + k; i++ {
                    *(fp + (jx + i)) = cast(f64, *(ip2 + jv + i));
                    f64 fw = 0.0;
                    for i32 jj = 0; jj <= jx; jj++ {
                        fw = fw + *(tx + jj) * *(fp + (jx + i - jj));
                    }
                    *(qp + (i)) = fw;
                }
                jz = jz + k;
                continue;
            }
        }
        break;
    }
    // chop off zero terms / normalize
    if z == 0.0 {
        jz = jz - 1;
        q0 = q0 - 24;
        while *(iqp + (jz)) == 0 {
            jz = jz - 1;
            q0 = q0 - 24;
        }
    } else {
        z = __math_scalbn(z, 0 - q0);
        if z >= 16777216.0 {
            f64 fw = cast(f64, cast(i32, 5.9604644775390625e-8 * z));
            *(iqp + (jz)) = cast(i32, z - 16777216.0 * fw);
            jz = jz + 1;
            q0 = q0 + 24;
            *(iqp + (jz)) = cast(i32, fw);
        } else {
            *(iqp + (jz)) = cast(i32, z);
        }
    }
    // convert integer chunks to floating-point values
    f64 fv = __math_scalbn(1.0, q0);
    for i32 i = jz; i >= 0; i-- {
        *(qp + (i)) = fv * cast(f64, *(iqp + (i)));
        fv = fv * 5.9604644775390625e-8;
    }
    // pi/2 chunk products
    f64* pp = cast(f64*, &__math_pio2t[0]);
    for i32 i = jz; i >= 0; i-- {
        f64 fw = 0.0;
        i32 k = 0;
        while k <= jp && k <= jz - i {
            fw = fw + *(pp + k) * *(qp + (i + k));
            k = k + 1;
        }
        *(fqp + (jz - i)) = fw;
    }
    // compress into y
    f64 fw = 0.0;
    for i32 i = jz; i >= 0; i-- { fw = fw + *(fqp + (i)); }
    if ih == 0 { *oy0 = fw; }
    else { *oy0 = -fw; }
    if prec == 1 {
        fw = *(fqp + (0)) - fw;
        for i32 i = 1; i <= jz; i++ { fw = fw + *(fqp + (i)); }
        if ih == 0 { *oy1 = fw; }
        else { *oy1 = -fw; }
    }
    return n & 7;
}

// medium-size branch of __math_rem_pio2
@strict_float
i32 __math_rem2_med(f64 x, f64* oy0, f64* oy1) {
    f64 fnv = x * 0.6366197723675814 + 6755399441055744.0 - 6755399441055744.0;
    i32 n = cast(i32, fnv);
    f64 r = x - fnv * 1.5707963267341256;
    f64 w = fnv * 6.077100506506192e-11;
    if r - w < -0.7853981633974483 {
        n = n - 1;
        fnv = fnv - 1.0;
        r = x - fnv * 1.5707963267341256;
        w = fnv * 6.077100506506192e-11;
    } else {
        if r - w > 0.7853981633974483 {
            n = n + 1;
            fnv = fnv + 1.0;
            r = x - fnv * 1.5707963267341256;
            w = fnv * 6.077100506506192e-11;
        }
    }
    f64 y0 = r - w;
    u64 yb = *cast(u64*, &y0);
    i32 ey = cast(i32, (yb >> 52) & 0x7FF);
    u64 xb = *cast(u64*, &x);
    i32 ex = cast(i32, (xb >> 32) & 0x7FFFFFFF) >> 20;
    if ex - ey > 16 {
        f64 tt = r;
        w = fnv * 6.077100506303966e-11;
        r = tt - w;
        w = fnv * 2.0222662487959506e-21 - ((tt - r) - w);
        y0 = r - w;
        yb = *cast(u64*, &y0);
        ey = cast(i32, (yb >> 52) & 0x7FF);
        if ex - ey > 49 {
            tt = r;
            w = fnv * 2.0222662487111665e-21;
            r = tt - w;
            w = fnv * 8.4784276603689e-32 - ((tt - r) - w);
            y0 = r - w;
        }
    }
    *oy0 = y0;
    *oy1 = (r - y0) - w;
    return n;
}

// argument reduction modulo pi/2 (musl __rem_pio2 shape)
@strict_float
i32 __math_rem_pio2(f64 x, f64* oy0, f64* oy1) {
    u64 ui = *cast(u64*, &x);
    bool sgn = (ui >> 63) != 0;
    u32 ix = cast(u32, ui >> 32) & 0x7FFFFFFF;
    if ix <= 0x400F6A7A {                    // |x| ~<= 5pi/4
        if (ix & 0xFFFFF) == 0x921FB {       // |x| ~= pi/2 or 2pi/2
            return __math_rem2_med(x, oy0, oy1);
        }
        f64 z = 0.0;
        f64 y0 = 0.0;
        if ix <= 0x4002D97C {                // |x| ~<= 3pi/4
            if !sgn {
                z = x - 1.5707963267341256;
                y0 = z - 6.077100506506192e-11;
                *oy0 = y0;
                *oy1 = (z - y0) - 6.077100506506192e-11;
                return 1;
            }
            z = x + 1.5707963267341256;
            y0 = z + 6.077100506506192e-11;
            *oy0 = y0;
            *oy1 = (z - y0) + 6.077100506506192e-11;
            return -1;
        }
        if !sgn {
            z = x - 2.0 * 1.5707963267341256;
            y0 = z - 2.0 * 6.077100506506192e-11;
            *oy0 = y0;
            *oy1 = (z - y0) - 2.0 * 6.077100506506192e-11;
            return 2;
        }
        z = x + 2.0 * 1.5707963267341256;
        y0 = z + 2.0 * 6.077100506506192e-11;
        *oy0 = y0;
        *oy1 = (z - y0) + 2.0 * 6.077100506506192e-11;
        return -2;
    }
    if ix <= 0x401C463B {                    // |x| ~<= 9pi/4
        f64 z = 0.0;
        f64 y0 = 0.0;
        if ix <= 0x4015FDBC {                // |x| ~<= 7pi/4
            if ix == 0x4012D97C {            // |x| ~= 3pi/2
                return __math_rem2_med(x, oy0, oy1);
            }
            if !sgn {
                z = x - 3.0 * 1.5707963267341256;
                y0 = z - 3.0 * 6.077100506506192e-11;
                *oy0 = y0;
                *oy1 = (z - y0) - 3.0 * 6.077100506506192e-11;
                return 3;
            }
            z = x + 3.0 * 1.5707963267341256;
            y0 = z + 3.0 * 6.077100506506192e-11;
            *oy0 = y0;
            *oy1 = (z - y0) + 3.0 * 6.077100506506192e-11;
            return -3;
        }
        if ix == 0x401921FB {                // |x| ~= 4pi/2
            return __math_rem2_med(x, oy0, oy1);
        }
        if !sgn {
            z = x - 4.0 * 1.5707963267341256;
            y0 = z - 4.0 * 6.077100506506192e-11;
            *oy0 = y0;
            *oy1 = (z - y0) - 4.0 * 6.077100506506192e-11;
            return 4;
        }
        z = x + 4.0 * 1.5707963267341256;
        y0 = z + 4.0 * 6.077100506506192e-11;
        *oy0 = y0;
        *oy1 = (z - y0) + 4.0 * 6.077100506506192e-11;
        return -4;
    }
    if ix < 0x413921FB {                     // |x| ~< 2^20*(pi/2)
        return __math_rem2_med(x, oy0, oy1);
    }
    if ix >= 0x7FF00000 {                    // inf or NaN
        *oy0 = x - x;
        *oy1 = *oy0;
        return 0;
    }
    // large: split |x| into 24-bit chunks scaled to [2^23, 2^24)
    u64 um = (ui & 0x000FFFFFFFFFFFFF) | (cast(u64, 0x3FF + 23) << 52);
    f64 z = *cast(f64*, &um);
    f64[3] tx;
    for i32 i = 0; i < 2; i++ {
        tx[i] = cast(f64, cast(i32, z));
        z = (z - tx[i]) * 16777216.0;
    }
    tx[2] = z;
    i32 nx = 3;
    while tx[nx - 1] == 0.0 { nx = nx - 1; }
    f64 ty0 = 0.0;
    f64 ty1 = 0.0;
    i32 n = __math_rem_pio2_large(&tx[0], cast(i32, ix >> 20) - (0x3FF + 23), nx, 1, &ty0, &ty1);
    if sgn {
        *oy0 = -ty0;
        *oy1 = -ty1;
        return 0 - n;
    }
    *oy0 = ty0;
    *oy1 = ty1;
    return n;
}

// kernel sin on [-pi/4, pi/4]; y = tail of x, iy = 0 iff y is zero
@strict_float
f64 __math_ksin(f64 x, f64 y, i32 iy) {
    f64 z = x * x;
    f64 w = z * z;
    f64 r = 0.00833333333332249 + z * (-0.0001984126982985795 + z * 2.7557313707070068e-06) + z * w * (-2.5050760253406863e-08 + z * 1.58969099521155e-10);
    f64 v = z * x;
    if iy == 0 {
        return x + v * (-0.16666666666666632 + z * r);
    }
    return x - ((z * (0.5 * y - v * r) - y) - v * -0.16666666666666632);
}

// kernel cos on [-pi/4, pi/4]
@strict_float
f64 __math_kcos(f64 x, f64 y) {
    f64 z = x * x;
    f64 w = z * z;
    f64 r = z * (0.0416666666666666 + z * (-0.001388888888887411 + z * 2.480158728947673e-05))
            + w * w * (-2.7557314351390663e-07 + z * (2.087572321298175e-09 + z * -1.1359647557788195e-11));
    f64 hz = 0.5 * z;
    f64 w2 = 1.0 - hz;
    return w2 + (((1.0 - w2) - hz) + (z * r - x * y));
}

// kernel tan on [-pi/4, pi/4]; returns tan (odd = 0) or -1/tan
@strict_float
f64 __math_ktan(f64 x, f64 y, i32 odd) {
    u64 xb = *cast(u64*, &x);
    u32 hx = cast(u32, xb >> 32);
    bool big = (hx & 0x7FFFFFFF) >= 0x3FE59428;    // |x| >= 0.6744
    bool sgn = false;
    if big {
        sgn = (hx >> 31) != 0;
        if sgn {
            x = -x;
            y = -y;
        }
        x = (0.7853981633974483 - x) + (3.061616997868383e-17 - y);
        y = 0.0;
    }
    f64 z = x * x;
    f64 w = z * z;
    f64 w2 = w * w;
    f64 r = ((0.13333333333320124 + w * 0.021869488294859542) + w2 * (0.0035920791075913124 + w * 0.0005880412408202641))
            + w2 * w2 * (7.817944429395571e-05 + w * -1.8558637485527546e-05);
    f64 v = z * (((0.05396825397622605 + w * 0.0088632398235993) + w2 * (0.0014562094543252903 + w * 0.0002464631348184699))
            + w2 * w2 * (7.140724913826082e-05 + w * 2.590730518636337e-05));
    f64 s = z * x;
    r = y + z * (s * (r + v) + y) + s * 0.3333333333333341;
    w = x + r;
    if big {
        f64 s2 = cast(f64, 1 - 2 * odd);
        v = s2 - 2.0 * (x + (r - w * w / (w + s2)));
        if sgn { return -v; }
        return v;
    }
    if odd == 0 {
        return w;
    }
    // -1.0/(x+r), computed accurately
    u64 wb = *cast(u64*, &w) & 0xFFFFFFFF00000000;
    f64 w0 = *cast(f64*, &wb);
    v = r - (w0 - x);
    f64 a = -1.0 / w;
    u64 ab = *cast(u64*, &a) & 0xFFFFFFFF00000000;
    f64 a0 = *cast(f64*, &ab);
    return a0 + a * (1.0 + a0 * w0 + a0 * v);
}

@strict_float
f64 sin(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 ix = cast(u32, ui >> 32) & 0x7FFFFFFF;
    if ix <= 0x3FE921FB {                    // |x| ~<= pi/4
        if ix < 0x3E500000 { return x; }    // |x| < 2^-26
        return __math_ksin(x, 0.0, 0);
    }
    if ix >= 0x7FF00000 { return x - x; }   // inf or NaN
    f64 y0 = 0.0;
    f64 y1 = 0.0;
    i32 n = __math_rem_pio2(x, &y0, &y1) & 3;
    if n == 0 { return __math_ksin(y0, y1, 1); }
    if n == 1 { return __math_kcos(y0, y1); }
    if n == 2 { return -__math_ksin(y0, y1, 1); }
    return -__math_kcos(y0, y1);
}

@strict_float
f64 cos(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 ix = cast(u32, ui >> 32) & 0x7FFFFFFF;
    if ix <= 0x3FE921FB {                    // |x| ~<= pi/4
        if ix < 0x3E46A09E { return 1.0; }  // |x| < 2^-27 * sqrt(2)
        return __math_kcos(x, 0.0);
    }
    if ix >= 0x7FF00000 { return x - x; }
    f64 y0 = 0.0;
    f64 y1 = 0.0;
    i32 n = __math_rem_pio2(x, &y0, &y1) & 3;
    if n == 0 { return __math_kcos(y0, y1); }
    if n == 1 { return -__math_ksin(y0, y1, 1); }
    if n == 2 { return -__math_kcos(y0, y1); }
    return __math_ksin(y0, y1, 1);
}

@strict_float
f64 tan(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 ix = cast(u32, ui >> 32) & 0x7FFFFFFF;
    if ix <= 0x3FE921FB {                    // |x| ~<= pi/4
        if ix < 0x3E400000 { return x; }    // |x| < 2^-27
        return __math_ktan(x, 0.0, 0);
    }
    if ix >= 0x7FF00000 { return x - x; }
    f64 y0 = 0.0;
    f64 y1 = 0.0;
    i32 n = __math_rem_pio2(x, &y0, &y1);
    return __math_ktan(y0, y1, n & 1);
}

// f32 side: f64-internal reduction and kernels (musl shapes)

@strict_float
i32 __math_rem_pio2f(f32 xf, f64* oy) {
    u32 ui = *cast(u32*, &xf);
    u32 ix = ui & 0x7FFFFFFF;
    if ix < 0x4DC90FDB {                     // |x| ~< 2^28*(pi/2)
        f64 x = xf;
        f64 fnv = x * 0.6366197723675814 + 6755399441055744.0 - 6755399441055744.0;
        i32 n = cast(i32, fnv);
        f64 y = x - fnv * 1.5707963109016418 - fnv * 1.5893254773528196e-08;
        if y < -0.7853981852531433 {
            n = n - 1;
            fnv = fnv - 1.0;
            y = x - fnv * 1.5707963109016418 - fnv * 1.5893254773528196e-08;
        } else {
            if y > 0.7853981852531433 {
                n = n + 1;
                fnv = fnv + 1.0;
                y = x - fnv * 1.5707963109016418 - fnv * 1.5893254773528196e-08;
            }
        }
        *oy = y;
        return n;
    }
    if ix >= 0x7F800000 {                    // inf or NaN
        *oy = cast(f64, xf - xf);
        return 0;
    }
    bool sgn = (ui >> 31) != 0;
    i32 e0 = cast(i32, ix >> 23) - (0x7F + 23);
    u32 sb = ix - (cast(u32, e0) << 23);
    f32 xs = *cast(f32*, &sb);
    f64 tx0 = xs;
    f64 ty0 = 0.0;
    f64 ty1 = 0.0;
    i32 n = __math_rem_pio2_large(&tx0, e0, 1, 0, &ty0, &ty1);
    if sgn {
        *oy = -ty0;
        return 0 - n;
    }
    *oy = ty0;
    return n;
}

@strict_float
f32 __math_ksindf(f64 x) {
    f64 z = x * x;
    f64 w = z * z;
    f64 r = -0.00019839334836096632 + z * 2.718311493989822e-06;
    f64 s = z * x;
    return cast(f32, (x + s * (-0.16666666641626524 + z * 0.008333329385889463)) + s * w * r);
}

@strict_float
f32 __math_kcosdf(f64 x) {
    f64 z = x * x;
    f64 w = z * z;
    f64 r = -0.001388676377460993 + z * 2.439044879627741e-05;
    return cast(f32, ((1.0 + z * -0.499999997251031) + w * 0.04166662332373906) + (w * z) * r);
}

@strict_float
f32 __math_ktandf(f64 x, i32 odd) {
    f64 z = x * x;
    f64 r = 0.002974357433599673 + z * 0.009465647849436732;
    f64 tt = 0.05338123784456704 + z * 0.024528318116654728;
    f64 w = z * z;
    f64 s = z * x;
    f64 u = 0.3333313950307914 + z * 0.13339200271297674;
    r = (x + s * u) + (s * w) * (tt + w * r);
    if odd != 0 { return cast(f32, -1.0 / r); }
    return cast(f32, r);
}

@strict_float
f32 sin(f32 xf) {
    u32 ui = *cast(u32*, &xf);
    bool sgn = (ui >> 31) != 0;
    u32 ix = ui & 0x7FFFFFFF;
    f64 x = xf;
    if ix <= 0x3F490FDA {                    // |x| ~<= pi/4
        if ix < 0x39800000 { return xf; }   // |x| < 2^-12
        return __math_ksindf(x);
    }
    if ix <= 0x407B53D1 {                    // |x| ~<= 5pi/4
        if ix <= 0x4016CBE3 {                // |x| ~<= 3pi/4
            if sgn { return -__math_kcosdf(x + 1.5707963267948966); }
            return __math_kcosdf(x - 1.5707963267948966);
        }
        if sgn { return __math_ksindf(-(x + 3.141592653589793)); }
        return __math_ksindf(-(x - 3.141592653589793));
    }
    if ix <= 0x40E231D5 {                    // |x| ~<= 9pi/4
        if ix <= 0x40AFEDDF {                // |x| ~<= 7pi/4
            if sgn { return __math_kcosdf(x + 4.71238898038469); }
            return -__math_kcosdf(x - 4.71238898038469);
        }
        if sgn { return __math_ksindf(x + 6.283185307179586); }
        return __math_ksindf(x - 6.283185307179586);
    }
    if ix >= 0x7F800000 { return xf - xf; }
    f64 y = 0.0;
    i32 n = __math_rem_pio2f(xf, &y) & 3;
    if n == 0 { return __math_ksindf(y); }
    if n == 1 { return __math_kcosdf(y); }
    if n == 2 { return __math_ksindf(-y); }
    return -__math_kcosdf(y);
}

@strict_float
f32 cos(f32 xf) {
    u32 ui = *cast(u32*, &xf);
    bool sgn = (ui >> 31) != 0;
    u32 ix = ui & 0x7FFFFFFF;
    f64 x = xf;
    if ix <= 0x3F490FDA {                    // |x| ~<= pi/4
        if ix < 0x39800000 { return 1.0f; } // |x| < 2^-12
        return __math_kcosdf(x);
    }
    if ix <= 0x407B53D1 {                    // |x| ~<= 5pi/4
        if ix > 0x4016CBE3 {                 // |x| ~> 3pi/4
            if sgn { return -__math_kcosdf(x + 3.141592653589793); }
            return -__math_kcosdf(x - 3.141592653589793);
        }
        if sgn { return __math_ksindf(x + 1.5707963267948966); }
        return __math_ksindf(1.5707963267948966 - x);
    }
    if ix <= 0x40E231D5 {                    // |x| ~<= 9pi/4
        if ix > 0x40AFEDDF {                 // |x| ~> 7pi/4
            if sgn { return __math_kcosdf(x + 6.283185307179586); }
            return __math_kcosdf(x - 6.283185307179586);
        }
        if sgn { return __math_ksindf(-x - 4.71238898038469); }
        return __math_ksindf(x - 4.71238898038469);
    }
    if ix >= 0x7F800000 { return xf - xf; }
    f64 y = 0.0;
    i32 n = __math_rem_pio2f(xf, &y) & 3;
    if n == 0 { return __math_kcosdf(y); }
    if n == 1 { return __math_ksindf(-y); }
    if n == 2 { return -__math_kcosdf(y); }
    return __math_ksindf(y);
}

@strict_float
f32 tan(f32 xf) {
    u32 ui = *cast(u32*, &xf);
    bool sgn = (ui >> 31) != 0;
    u32 ix = ui & 0x7FFFFFFF;
    f64 x = xf;
    if ix <= 0x3F490FDA {                    // |x| ~<= pi/4
        if ix < 0x39800000 { return xf; }   // |x| < 2^-12
        return __math_ktandf(x, 0);
    }
    if ix <= 0x407B53D1 {                    // |x| ~<= 5pi/4
        if ix <= 0x4016CBE3 {                // |x| ~<= 3pi/4
            if sgn { return __math_ktandf(x + 1.5707963267948966, 1); }
            return __math_ktandf(x - 1.5707963267948966, 1);
        }
        if sgn { return __math_ktandf(x + 3.141592653589793, 0); }
        return __math_ktandf(x - 3.141592653589793, 0);
    }
    if ix <= 0x40E231D5 {                    // |x| ~<= 9pi/4
        if ix <= 0x40AFEDDF {                // |x| ~<= 7pi/4
            if sgn { return __math_ktandf(x + 4.71238898038469, 1); }
            return __math_ktandf(x - 4.71238898038469, 1);
        }
        if sgn { return __math_ktandf(x + 6.283185307179586, 0); }
        return __math_ktandf(x - 6.283185307179586, 0);
    }
    if ix >= 0x7F800000 { return xf - xf; }
    f64 y = 0.0;
    i32 n = __math_rem_pio2f(xf, &y);
    return __math_ktandf(y, n & 1);
}

// --- Canonical asin/acos/atan/atan2 (musl/fdlibm shapes) ---

// shared rational kernel for asin/acos
@strict_float
f64 __math_asinR(f64 z) {
    f64 p = z * (0.16666666666666666 + z * (-0.3255658186224009 + z * (0.20121253213486293
            + z * (-0.04005553450067941 + z * (0.0007915349942898145 + z * 3.479331075960212e-05)))));
    f64 q = 1.0 + z * (-2.403394911734414 + z * (2.0209457602335057
            + z * (-0.6882839716054533 + z * 0.07703815055590194)));
    return p / q;
}

@strict_float
f64 asin(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 hx = cast(u32, ui >> 32);
    u32 ix = hx & 0x7FFFFFFF;
    if ix >= 0x3FF00000 {                    // |x| >= 1 or nan
        u32 lx = cast(u32, ui & 0xFFFFFFFF);
        if ((ix - 0x3FF00000) | lx) == 0 {   // |x| == 1: +-pi/2
            return x * 1.5707963267948966 + 7.52316384526264e-37;
        }
        return 0.0 / (x - x);                 // NaN
    }
    if ix < 0x3FE00000 {                     // |x| < 0.5
        if ix < 0x3E500000 && ix >= 0x00100000 { return x; }
        return x + x * __math_asinR(x * x);
    }
    f64 z = (1.0 - fabs(x)) * 0.5;
    f64 s = sqrt(z);
    f64 r = __math_asinR(z);
    f64 xo = 0.0;
    if ix >= 0x3FEF3333 {                    // |x| > 0.975
        xo = 1.5707963267948966 - (2.0 * (s + s * r) - 6.123233995736766e-17);
    } else {
        u64 sb = *cast(u64*, &s) & 0xFFFFFFFF00000000;
        f64 f = *cast(f64*, &sb);
        f64 c = (z - f * f) / (s + f);
        xo = 0.5 * 1.5707963267948966 - (2.0 * s * r - (6.123233995736766e-17 - 2.0 * c)
             - (0.5 * 1.5707963267948966 - 2.0 * f));
    }
    if (hx >> 31) != 0 { return -xo; }
    return xo;
}

@strict_float
f64 acos(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 hx = cast(u32, ui >> 32);
    u32 ix = hx & 0x7FFFFFFF;
    if ix >= 0x3FF00000 {                    // |x| >= 1 or nan
        u32 lx = cast(u32, ui & 0xFFFFFFFF);
        if ((ix - 0x3FF00000) | lx) == 0 {   // acos(1) = 0, acos(-1) = pi
            if (hx >> 31) != 0 { return 2.0 * 1.5707963267948966 + 7.52316384526264e-37; }
            return 0.0;
        }
        return 0.0 / (x - x);                 // NaN
    }
    if ix < 0x3FE00000 {                     // |x| < 0.5
        if ix <= 0x3C600000 { return 1.5707963267948966 + 7.52316384526264e-37; }
        return 1.5707963267948966 - (x - (6.123233995736766e-17 - x * __math_asinR(x * x)));
    }
    if (hx >> 31) != 0 {                     // x < -0.5
        f64 z = (1.0 + x) * 0.5;
        f64 s = sqrt(z);
        f64 w = __math_asinR(z) * s - 6.123233995736766e-17;
        return 2.0 * (1.5707963267948966 - (s + w));
    }
    f64 z = (1.0 - x) * 0.5;                  // x > 0.5
    f64 s = sqrt(z);
    u64 sb = *cast(u64*, &s) & 0xFFFFFFFF00000000;
    f64 df = *cast(f64*, &sb);
    f64 c = (z - df * df) / (s + df);
    f64 w = __math_asinR(z) * s + c;
    return 2.0 * (df + w);
}

// atan(0.5/1/1.5/inf) as hi/lo pairs
u64[4] __math_atanhi = {
    0x3FDDAC670561BB4F, 0x3FE921FB54442D18, 0x3FEF730BD281F69B, 0x3FF921FB54442D18,
};
u64[4] __math_atanlo = {
    0x3C7A2B7F222F65E2, 0x3C81A62633145C07, 0x3C7007887AF0CBBD, 0x3C91A62633145C07,
};

@strict_float
f64 atan(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 ix = cast(u32, ui >> 32);
    u32 sgn = ix >> 31;
    ix = ix & 0x7FFFFFFF;
    f64* ah = cast(f64*, &__math_atanhi[0]);
    f64* al = cast(f64*, &__math_atanlo[0]);
    if ix >= 0x44100000 {                    // |x| >= 2^66
        if x != x { return x; }
        f64 zi = *(ah + 3) + 7.52316384526264e-37;
        if sgn != 0 { return -zi; }
        return zi;
    }
    i32 id = -1;
    if ix < 0x3FDC0000 {                     // |x| < 0.4375
        if ix < 0x3E400000 { return x; }    // |x| < 2^-27
    } else {
        x = fabs(x);
        if ix < 0x3FF30000 {                 // |x| < 1.1875
            if ix < 0x3FE60000 {
                id = 0;
                x = (2.0 * x - 1.0) / (2.0 + x);
            } else {
                id = 1;
                x = (x - 1.0) / (x + 1.0);
            }
        } else {
            if ix < 0x40038000 {             // |x| < 2.4375
                id = 2;
                x = (x - 1.5) / (1.0 + 1.5 * x);
            } else {
                id = 3;
                x = -1.0 / x;
            }
        }
    }
    f64 z = x * x;
    f64 w = z * z;
    f64 s1 = z * (0.3333333333333293 + w * (0.14285714272503466 + w * (0.09090887133436507
             + w * (0.06661073137387531 + w * (0.049768779946159324 + w * 0.016285820115365782)))));
    f64 s2 = w * (-0.19999999999876483 + w * (-0.11111110405462356 + w * (-0.0769187620504483
             + w * (-0.058335701337905735 + w * -0.036531572744216916))));
    if id < 0 { return x - x * (s1 + s2); }
    f64 zo = *(ah + id) - (x * (s1 + s2) - *(al + id) - x);
    if sgn != 0 { return -zo; }
    return zo;
}

@strict_float
f64 atan2(f64 y, f64 x) {
    if x != x || y != y { return x + y; }
    u64 ub = *cast(u64*, &x);
    u32 ix = cast(u32, ub >> 32);
    u32 lx = cast(u32, ub & 0xFFFFFFFF);
    ub = *cast(u64*, &y);
    u32 iy = cast(u32, ub >> 32);
    u32 ly = cast(u32, ub & 0xFFFFFFFF);
    if ((ix - 0x3FF00000) | lx) == 0 { return atan(y); }  // x = 1.0
    u32 m = ((iy >> 31) & 1) | ((ix >> 30) & 2);
    ix = ix & 0x7FFFFFFF;
    iy = iy & 0x7FFFFFFF;
    if (iy | ly) == 0 {                      // y = +-0
        if m == 0 || m == 1 { return y; }
        if m == 2 { return 3.141592653589793; }
        return -3.141592653589793;
    }
    if (ix | lx) == 0 {                      // x = +-0
        if (m & 1) != 0 { return -1.5707963267948966; }
        return 1.5707963267948966;
    }
    if ix == 0x7FF00000 {                    // x = +-inf
        if iy == 0x7FF00000 {
            if m == 0 { return 0.7853981633974483; }
            if m == 1 { return -0.7853981633974483; }
            if m == 2 { return 2.356194490192345; }
            return -2.356194490192345;
        }
        if m == 0 { return 0.0; }
        if m == 1 { return -0.0; }
        if m == 2 { return 3.141592653589793; }
        return -3.141592653589793;
    }
    if ix + 0x04000000 < iy || iy == 0x7FF00000 {  // |y/x| > 2^64
        if (m & 1) != 0 { return -1.5707963267948966; }
        return 1.5707963267948966;
    }
    f64 z = 0.0;
    if (m & 2) != 0 && iy + 0x04000000 < ix {      // |y/x| < 2^-64, x < 0
        z = 0.0;
    } else {
        z = atan(fabs(y / x));
    }
    if m == 0 { return z; }
    if m == 1 { return -z; }
    if m == 2 { return 3.141592653589793 - (z - 1.2246467991473532e-16); }
    return (z - 1.2246467991473532e-16) - 3.141592653589793;
}

// f32 side (musl shapes; asinf's sqrt runs in f64)

@strict_float
f32 __math_asinRf(f32 z) {
    f32 p = z * (0.16666586697101593f + z * (-0.04274342209100723f + z * -0.008656363002955914f));
    f32 q = 1.0f + z * -0.7066296339035034f;
    return p / q;
}

@strict_float
f32 asin(f32 xf) {
    u32 hx = *cast(u32*, &xf);
    u32 ix = hx & 0x7FFFFFFF;
    if ix >= 0x3F800000 {                    // |x| >= 1
        if ix == 0x3F800000 {
            return cast(f32, cast(f64, xf) * 1.5707963267948966 + 7.52316384526264e-37);
        }
        return 0.0f / (xf - xf);              // NaN
    }
    if ix < 0x3F000000 {                     // |x| < 0.5
        if ix < 0x39800000 && ix >= 0x00800000 { return xf; }
        return xf + xf * __math_asinRf(xf * xf);
    }
    f32 z = (1.0f - fabsf(xf)) * 0.5f;
    f64 s = sqrt(cast(f64, z));
    f32 xo = cast(f32, 1.5707963267948966 - 2.0 * (s + s * cast(f64, __math_asinRf(z))));
    if (hx >> 31) != 0 { return -xo; }
    return xo;
}

@strict_float
f32 acos(f32 xf) {
    u32 hx = *cast(u32*, &xf);
    u32 ix = hx & 0x7FFFFFFF;
    if ix >= 0x3F800000 {                    // |x| >= 1 or nan
        if ix == 0x3F800000 {
            if (hx >> 31) != 0 { return 2.0f * 1.570796251296997f + 7.52316384526264e-37f; }
            return 0.0f;
        }
        return 0.0f / (xf - xf);              // NaN
    }
    if ix < 0x3F000000 {                     // |x| < 0.5
        if ix <= 0x32800000 { return 1.570796251296997f + 7.52316384526264e-37f; }
        return 1.570796251296997f - (xf - (7.549789415861596e-08f - xf * __math_asinRf(xf * xf)));
    }
    if (hx >> 31) != 0 {                     // x < -0.5
        f32 z = (1.0f + xf) * 0.5f;
        f32 s = sqrtf(z);
        f32 w = __math_asinRf(z) * s - 7.549789415861596e-08f;
        return 2.0f * (1.570796251296997f - (s + w));
    }
    f32 z = (1.0f - xf) * 0.5f;               // x > 0.5
    f32 s = sqrtf(z);
    u32 sb = *cast(u32*, &s) & 0xFFFFF000;
    f32 df = *cast(f32*, &sb);
    f32 c = (z - df * df) / (s + df);
    f32 w = __math_asinRf(z) * s + c;
    return 2.0f * (df + w);
}

// atanf(0.5/1/1.5/inf) as hi/lo pairs
u32[4] __math_atanhif = {
    0x3EED6338, 0x3F490FDA, 0x3F7B985E, 0x3FC90FDA,
};
u32[4] __math_atanlof = {
    0x31AC3769, 0x33222168, 0x33140FB4, 0x33A22168,
};

@strict_float
f32 atan(f32 x) {
    u32 ix = *cast(u32*, &x);
    u32 sgn = ix >> 31;
    ix = ix & 0x7FFFFFFF;
    f32* ah = cast(f32*, &__math_atanhif[0]);
    f32* al = cast(f32*, &__math_atanlof[0]);
    if ix >= 0x4C800000 {                    // |x| >= 2^26
        if x != x { return x; }
        f32 zi = *(ah + 3) + 7.52316384526264e-37f;
        if sgn != 0 { return -zi; }
        return zi;
    }
    i32 id = -1;
    if ix < 0x3EE00000 {                     // |x| < 0.4375
        if ix < 0x39800000 { return x; }    // |x| < 2^-12
    } else {
        x = fabsf(x);
        if ix < 0x3F980000 {                 // |x| < 1.1875
            if ix < 0x3F300000 {
                id = 0;
                x = (2.0f * x - 1.0f) / (2.0f + x);
            } else {
                id = 1;
                x = (x - 1.0f) / (x + 1.0f);
            }
        } else {
            if ix < 0x401C0000 {             // |x| < 2.4375
                id = 2;
                x = (x - 1.5f) / (1.0f + 1.5f * x);
            } else {
                id = 3;
                x = -1.0f / x;
            }
        }
    }
    f32 z = x * x;
    f32 w = z * z;
    f32 s1 = z * (0.333333283662796f + w * (0.14253635704517365f + w * 0.06168760731816292f));
    f32 s2 = w * (-0.19999158382415771f + w * -0.106480173766613f);
    if id < 0 { return x - x * (s1 + s2); }
    f32 zo = *(ah + id) - ((x * (s1 + s2) - *(al + id)) - x);
    if sgn != 0 { return -zo; }
    return zo;
}

// Routed through the f64 routine: one rounding of a ~2^-52-accurate
// result is correctly rounded at f32. A single-precision path cannot
// be — the f32 quotient y/x rounds before the reduction starts.
f32 atan2(f32 y, f32 x) { return cast(f32, atan2(cast(f64, y), cast(f64, x))); }

// --- Canonical log1p/expm1 and f64 hyperbolics (musl/fdlibm) ---

@strict_float
f64 expm1(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 hx = cast(u32, ui >> 32) & 0x7FFFFFFF;
    bool sgn = (ui >> 63) != 0;
    if hx >= 0x4043687A {                    // |x| >= 56*ln2
        if x != x { return x; }
        if sgn { return -1.0; }
        if x > 709.782712893384 {
            return x * 8.98846567431158e307;  // overflow to inf
        }
    }
    f64 c = 0.0;
    i32 k = 0;
    if hx > 0x3FD62E42 {                     // |x| > 0.5 ln2
        f64 hi = 0.0;
        f64 lo = 0.0;
        if hx < 0x3FF0A2B2 {                 // and |x| < 1.5 ln2
            if !sgn {
                hi = x - 0.6931471803691238;
                lo = 1.9082149292705877e-10;
                k = 1;
            } else {
                hi = x + 0.6931471803691238;
                lo = -1.9082149292705877e-10;
                k = -1;
            }
        } else {
            f64 half = 0.5;
            if sgn { half = -0.5; }
            k = cast(i32, 1.4426950408889634 * x + half);
            f64 tk = k;
            hi = x - tk * 0.6931471803691238;      // exact
            lo = tk * 1.9082149292705877e-10;
        }
        x = hi - lo;
        c = (hi - x) - lo;
    } else {
        if hx < 0x3C900000 { return x; }    // |x| < 2^-54
    }
    f64 hfx = 0.5 * x;
    f64 hxs = x * hfx;
    f64 r1 = 1.0 + hxs * (-0.03333333333333313 + hxs * (0.0015873015872548146
             + hxs * (-7.93650757867488e-05 + hxs * (4.008217827329362e-06 + hxs * -2.0109921818362437e-07))));
    f64 tt = 3.0 - r1 * hfx;
    f64 e = hxs * ((r1 - tt) / (6.0 - x * tt));
    if k == 0 {
        return x - (x * e - hxs);
    }
    e = x * (e - c) - c;
    e = e - hxs;
    if k == -1 {
        return 0.5 * (x - e) - 0.5;
    }
    if k == 1 {
        if x < -0.25 { return -2.0 * (e - (x + 0.5)); }
        return 1.0 + 2.0 * (x - e);
    }
    u64 tb = cast(u64, cast(i64, 0x3FF + k)) << 52;
    f64 twopk = *cast(f64*, &tb);
    if k < 0 || k > 56 {
        f64 y = x - e + 1.0;
        if k == 1024 { y = y * 2.0 * 8.98846567431158e307; }
        else { y = y * twopk; }
        return y - 1.0;
    }
    u64 ub = cast(u64, cast(i64, 0x3FF - k)) << 52;
    f64 uf = *cast(f64*, &ub);
    if k < 20 {
        return (x - e + (1.0 - uf)) * twopk;
    }
    return (x - (e + uf) + 1.0) * twopk;
}

@strict_float
f64 log1p(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 hx = cast(u32, ui >> 32);
    i32 k = 1;
    f64 c = 0.0;
    f64 f = 0.0;
    if hx < 0x3FDA827A || (hx >> 31) != 0 {  // 1+x < sqrt(2)+
        if hx >= 0xBFF00000 {                // x <= -1.0
            if x == -1.0 { return x / 0.0; }   // -inf
            return (x - x) / 0.0;             // NaN
        }
        if (hx << 1) < 0x79400000 {          // |x| < 2^-53
            return x;
        }
        if hx <= 0xBFD2BEC4 {                // sqrt(2)/2- <= 1+x < sqrt(2)+
            k = 0;
            f = x;
        }
    } else {
        if hx >= 0x7FF00000 { return x; }   // +inf or NaN
    }
    if k != 0 {
        f64 uf = 1.0 + x;
        u64 ub = *cast(u64*, &uf);
        u32 hu = cast(u32, ub >> 32);
        hu = hu + (0x3FF00000 - 0x3FE6A09E);
        k = cast(i32, hu >> 20) - 0x3FF;
        // correction term ~ log(1+x) - log(u)
        if k < 54 {
            if k >= 2 { c = 1.0 - (uf - x); }
            else { c = x - (uf - 1.0); }
            c = c / uf;
        } else {
            c = 0.0;
        }
        hu = (hu & 0x000FFFFF) + 0x3FE6A09E;
        ub = (cast(u64, hu) << 32) | (ub & 0xFFFFFFFF);
        uf = *cast(f64*, &ub);
        f = uf - 1.0;
    }
    f64 hfsq = 0.5 * f * f;
    f64 s = f / (2.0 + f);
    f64 z = s * s;
    f64 w = z * z;
    f64 t1 = w * (0.3999999999940942 + w * (0.22222198432149784 + w * 0.15313837699209373));
    f64 t2 = z * (0.6666666666666735 + w * (0.2857142874366239 + w * (0.1818357216161805 + w * 0.14798198605116586)));
    f64 r = t2 + t1;
    f64 dk = k;
    return s * (hfsq + r) + (dk * 1.9082149292705877e-10 + c) - hfsq + f + dk * 0.6931471803691238;
}

// exp(x)/2 for x >= log(DBL_MAX), overflow-safe via 2^1021 scaling
@strict_float
f64 __math_expo2(f64 x, f64 sign) {
    u64 sb = 0x7FC0000000000000;              // 2^1021
    f64 scale = *cast(f64*, &sb);
    return exp(x - 1416.0996898839683) * (sign * scale) * scale;
}

@strict_float
f64 sinh(f64 x) {
    u64 ui = *cast(u64*, &x);
    f64 h = 0.5;
    if (ui >> 63) != 0 { h = -0.5; }
    u64 ab = ui & 0x7FFFFFFFFFFFFFFF;
    f64 ax = *cast(f64*, &ab);
    u32 w = cast(u32, ab >> 32);
    if w < 0x40862E42 {                      // |x| < log(DBL_MAX)
        f64 tv = expm1(ax);
        if w < 0x3FF00000 {
            if w < 0x3E500000 { return x; }
            return h * (2.0 * tv - tv * tv / (tv + 1.0));
        }
        return h * (tv + tv / (tv + 1.0));
    }
    return __math_expo2(ax, 2.0 * h);
}

@strict_float
f64 cosh(f64 x) {
    u64 ui = *cast(u64*, &x);
    u64 ab = ui & 0x7FFFFFFFFFFFFFFF;
    f64 ax = *cast(f64*, &ab);
    u32 w = cast(u32, ab >> 32);
    if w < 0x3FE62E42 {                      // |x| < log(2)
        if w < 0x3E500000 { return 1.0; }
        f64 tv = expm1(ax);
        return 1.0 + tv * tv / (2.0 * (1.0 + tv));
    }
    if w < 0x40862E42 {                      // |x| < log(DBL_MAX)
        f64 tv = exp(ax);
        return 0.5 * (tv + 1.0 / tv);
    }
    return __math_expo2(ax, 1.0);
}

@strict_float
f64 tanh(f64 x) {
    u64 ui = *cast(u64*, &x);
    bool sgn = (ui >> 63) != 0;
    u64 ab = ui & 0x7FFFFFFFFFFFFFFF;
    f64 ax = *cast(f64*, &ab);
    u32 w = cast(u32, ab >> 32);
    f64 tv = 0.0;
    if w > 0x3FE193EA {                      // |x| > log(3)/2 or nan
        if w > 0x40340000 {                  // |x| > 20 or nan
            if ax != ax { return ax; }
            tv = 1.0;
        } else {
            tv = expm1(2.0 * ax);
            tv = 1.0 - 2.0 / (tv + 2.0);
        }
    } else {
        if w > 0x3FD058AE {                  // |x| > log(5/3)/2
            tv = expm1(2.0 * ax);
            tv = tv / (tv + 2.0);
        } else {
            if w >= 0x00100000 {
                tv = expm1(-2.0 * ax);
                tv = -tv / (tv + 2.0);
            } else {
                tv = ax;                      // subnormal
            }
        }
    }
    if sgn { return -tv; }
    return tv;
}

@strict_float
f64 asinh(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 e = cast(u32, ui >> 52) & 0x7FF;
    bool sgn = (ui >> 63) != 0;
    u64 ab = ui & 0x7FFFFFFFFFFFFFFF;
    f64 ax = *cast(f64*, &ab);
    if e >= 0x3FF + 26 {                     // |x| >= 2^26, inf, nan
        ax = log(ax) + 0.6931471805599453;
    } else {
        if e >= 0x3FF + 1 {                  // |x| >= 2
            ax = log(2.0 * ax + 1.0 / (sqrt(ax * ax + 1.0) + ax));
        } else {
            if e >= 0x3FF - 26 {             // |x| >= 2^-26
                ax = log1p(ax + ax * ax / (sqrt(ax * ax + 1.0) + 1.0));
            }
        }
    }
    if sgn { return -ax; }
    return ax;
}

@strict_float
f64 acosh(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 e = cast(u32, ui >> 52) & 0x7FF;
    if e < 0x3FF + 1 {                       // |x| < 2
        return log1p(x - 1.0 + sqrt((x - 1.0) * (x - 1.0) + 2.0 * (x - 1.0)));
    }
    if e < 0x3FF + 26 {                      // |x| < 2^26
        return log(2.0 * x - 1.0 / (x + sqrt(x * x - 1.0)));
    }
    return log(x) + 0.6931471805599453;
}

@strict_float
f64 atanh(f64 x) {
    u64 ui = *cast(u64*, &x);
    u32 e = cast(u32, ui >> 52) & 0x7FF;
    bool sgn = (ui >> 63) != 0;
    u64 ab = ui & 0x7FFFFFFFFFFFFFFF;
    f64 y = *cast(f64*, &ab);
    if e < 0x3FF - 1 {
        if e >= 0x3FF - 32 {                 // |x| < 0.5
            y = 0.5 * log1p(2.0 * y + 2.0 * y * y / (1.0 - y));
        }
    } else {
        y = 0.5 * log1p(2.0 * (y / (1.0 - y)));
    }
    if sgn { return -y; }
    return y;
}

// --- fmin/fmax (C99 semantics, exact) ---
//
// A NaN operand yields the other operand; signed zeros order
// (-0 < +0, C99 Annex F.9.9.2). Overloaded for f64 and f32; C's
// fminf/fmaxf map onto the f32 overloads. Compares and selects only,
// so any correct implementation is bit-identical.

f64 fmin(f64 x, f64 y) {
    if x != x { return y; }
    if y != y { return x; }
    u64 sx = *cast(u64*, &x) >> 63;
    u64 sy = *cast(u64*, &y) >> 63;
    if sx != sy {
        if sx != 0 { return x; }
        return y;
    }
    if x < y { return x; }
    return y;
}

f64 fmax(f64 x, f64 y) {
    if x != x { return y; }
    if y != y { return x; }
    u64 sx = *cast(u64*, &x) >> 63;
    u64 sy = *cast(u64*, &y) >> 63;
    if sx != sy {
        if sx != 0 { return y; }
        return x;
    }
    if x < y { return y; }
    return x;
}

f32 fmin(f32 x, f32 y) {
    if x != x { return y; }
    if y != y { return x; }
    u32 sx = *cast(u32*, &x) >> 31;
    u32 sy = *cast(u32*, &y) >> 31;
    if sx != sy {
        if sx != 0 { return x; }
        return y;
    }
    if x < y { return x; }
    return y;
}

f32 fmax(f32 x, f32 y) {
    if x != x { return y; }
    if y != y { return x; }
    u32 sx = *cast(u32*, &x) >> 31;
    u32 sy = *cast(u32*, &y) >> 31;
    if sx != sy {
        if sx != 0 { return y; }
        return x;
    }
    if x < y { return y; }
    return x;
}

// --- Float classification ---

bool isnan(f64 x) { return x != x; }
bool isnan(f32 x) { return x != x; }
bool isinf(f64 x) { return x == x && x - x != 0.0; }
bool isinf(f32 x) { return x == x && x - x != 0.0f; }
// x - x is 0 only for finite x: inf - inf and nan - nan are both nan.
bool isfinite(f64 x) { return x - x == 0.0; }
bool isfinite(f32 x) { return x - x == 0.0f; }


// --- copysign / ldexp / frexp / hypot ---
//
// Exact operations. copysign, ldexp and frexp move bits and rounding
// never enters; hypot rounds once, at the final sqrt.

f64 copysign(f64 x, f64 y) {
    u64 ux = *cast(u64*, &x);
    u64 uy = *cast(u64*, &y);
    u64 r = (ux & 0x7FFFFFFFFFFFFFFF) | (uy & 0x8000000000000000);
    return *cast(f64*, &r);
}

f32 copysign(f32 x, f32 y) {
    u32 ux = *cast(u32*, &x);
    u32 uy = *cast(u32*, &y);
    u32 r = (ux & 0x7FFFFFFF) | (uy & 0x80000000);
    return *cast(f32*, &r);
}

// x * 2^n. Staged so an n that leaves f64's exponent range on its own
// still lands on the correct finite result when the product does not.
f64 ldexp(f64 x, i32 n) { return __math_scalbn(x, n); }

// Every f32 scaled by any power of two is exact in f64, so the wide
// route rounds once, at the cast back.
f32 ldexp(f32 x, i32 n) { return cast(f32, __math_scalbn(cast(f64, x), n)); }

// Split x into a mantissa in [0.5, 1) and an exponent, x = m * 2^e.
// inf and nan return unchanged with e untouched, as C leaves it.
f64 frexp(f64 x, i32* e) {
    u64 y = *cast(u64*, &x);
    i32 ee = cast(i32, (y >> 52) & 0x7FF);
    if ee == 0 {
        if x == 0.0 { *e = 0; return x; }
        // Subnormal: scale into the normal range and take the 2^64 back.
        f64 xs = x * 18446744073709551616.0;
        u64 ys = *cast(u64*, &xs);
        *e = cast(i32, (ys >> 52) & 0x7FF) - 0x3FE - 64;
        u64 rs = (ys & 0x800FFFFFFFFFFFFF) | 0x3FE0000000000000;
        return *cast(f64*, &rs);
    }
    if ee == 0x7FF { return x; }
    *e = ee - 0x3FE;
    u64 r = (y & 0x800FFFFFFFFFFFFF) | 0x3FE0000000000000;
    return *cast(f64*, &r);
}

f32 frexp(f32 x, i32* e) { return cast(f32, frexp(cast(f64, x), e)); }

// Exact square as a hi/lo pair (Dekker split). The low word carries the
// bits x*x drops, so the four-term sum in hypot is exact well past f64.
@strict_float
void __math_sq(f64* hi, f64* lo, f64 x) {
    f64 xc = x * 134217729.0;          // 2^27 + 1
    f64 xh = x - xc + xc;
    f64 xl = x - xh;
    *hi = x * x;
    *lo = xh * xh - *hi + 2.0 * xh * xl + xl * xl;
    return;
}

// sqrt(x*x + y*y) without the overflow the naive form has: hypot of two
// values near f64's maximum is finite, and the squares would not be.
@strict_float
f64 hypot(f64 x, f64 y) {
    u64 ux = *cast(u64*, &x) & 0x7FFFFFFFFFFFFFFF;
    u64 uy = *cast(u64*, &y) & 0x7FFFFFFFFFFFFFFF;
    if ux < uy { u64 t = ux; ux = uy; uy = t; }

    i32 ex = cast(i32, ux >> 52);
    i32 ey = cast(i32, uy >> 52);
    f64 ax = *cast(f64*, &ux);
    f64 ay = *cast(f64*, &uy);

    // hypot(inf, nan) is inf. nan sorts above inf by bit pattern, so
    // testing the smaller operand first returns the inf.
    if ey == 0x7FF { return ay; }
    if ex == 0x7FF || uy == 0 { return ax; }
    // Beyond this gap y cannot reach the result's last bit.
    if ex - ey > 64 { return ax + ay; }

    // Keep the squares away from both ends of the range, then undo it.
    f64 z = 1.0;
    if ex > 0x3FF + 510 {
        z = __math_scalbn(1.0, 700);
        ax = ax * __math_scalbn(1.0, 0 - 700);
        ay = ay * __math_scalbn(1.0, 0 - 700);
    } else if ey < 0x3FF - 450 {
        z = __math_scalbn(1.0, 0 - 700);
        ax = ax * __math_scalbn(1.0, 700);
        ay = ay * __math_scalbn(1.0, 700);
    }

    f64 hx = 0.0;
    f64 lx = 0.0;
    f64 hy = 0.0;
    f64 ly = 0.0;
    __math_sq(&hx, &lx, ax);
    __math_sq(&hy, &ly, ay);
    return z * sqrt(ly + lx + hy + hx);
}

// f32 needs no scaling: every f32 squared is an ordinary f64.
@strict_float
f32 hypot(f32 x, f32 y) {
    if isinf(x) { return fabsf(x); }
    if isinf(y) { return fabsf(y); }
    f64 dx = cast(f64, x);
    f64 dy = cast(f64, y);
    return cast(f32, sqrt(dx * dx + dy * dy));
}

// --- strtod / atof / strtol / atoi (C shapes) ---
//
// Decimal parsing runs the same Eisel-Lemire + bigint engine as the
// compiler's float literals, so strtod(s) is bit-identical to the
// literal s on every target.

// 10^E for E in [-342, 308] as normalized 128-bit (hi, lo) pairs.
u64[651] __math_p10hi = {
    0xEEF453D6923BD65A, 0x9558B4661B6565F8, 0xBAAEE17FA23EBF76, 0xE95A99DF8ACE6F53, 0x91D8A02BB6C10594, 0xB64EC836A47146F9,
    0xE3E27A444D8D98B7, 0x8E6D8C6AB0787F72, 0xB208EF855C969F4F, 0xDE8B2B66B3BC4723, 0x8B16FB203055AC76, 0xADDCB9E83C6B1793,
    0xD953E8624B85DD78, 0x87D4713D6F33AA6B, 0xA9C98D8CCB009506, 0xD43BF0EFFDC0BA48, 0x84A57695FE98746D, 0xA5CED43B7E3E9188,
    0xCF42894A5DCE35EA, 0x818995CE7AA0E1B2, 0xA1EBFB4219491A1F, 0xCA66FA129F9B60A6, 0xFD00B897478238D0, 0x9E20735E8CB16382,
    0xC5A890362FDDBC62, 0xF712B443BBD52B7B, 0x9A6BB0AA55653B2D, 0xC1069CD4EABE89F8, 0xF148440A256E2C76, 0x96CD2A865764DBCA,
    0xBC807527ED3E12BC, 0xEBA09271E88D976B, 0x93445B8731587EA3, 0xB8157268FDAE9E4C, 0xE61ACF033D1A45DF, 0x8FD0C16206306BAB,
    0xB3C4F1BA87BC8696, 0xE0B62E2929ABA83C, 0x8C71DCD9BA0B4925, 0xAF8E5410288E1B6F, 0xDB71E91432B1A24A, 0x892731AC9FAF056E,
    0xAB70FE17C79AC6CA, 0xD64D3D9DB981787D, 0x85F0468293F0EB4E, 0xA76C582338ED2621, 0xD1476E2C07286FAA, 0x82CCA4DB847945CA,
    0xA37FCE126597973C, 0xCC5FC196FEFD7D0C, 0xFF77B1FCBEBCDC4F, 0x9FAACF3DF73609B1, 0xC795830D75038C1D, 0xF97AE3D0D2446F25,
    0x9BECCE62836AC577, 0xC2E801FB244576D5, 0xF3A20279ED56D48A, 0x9845418C345644D6, 0xBE5691EF416BD60C, 0xEDEC366B11C6CB8F,
    0x94B3A202EB1C3F39, 0xB9E08A83A5E34F07, 0xE858AD248F5C22C9, 0x91376C36D99995BE, 0xB58547448FFFFB2D, 0xE2E69915B3FFF9F9,
    0x8DD01FAD907FFC3B, 0xB1442798F49FFB4A, 0xDD95317F31C7FA1D, 0x8A7D3EEF7F1CFC52, 0xAD1C8EAB5EE43B66, 0xD863B256369D4A40,
