// exp: k = round(x * 128/ln2), tabled 2^(j/128), degree-5 polynomial
// on the reduced range, exponent reassembly on the bit pattern. No
// division. Within 0.75 ulp of correctly rounded.
@strict_float
f64 exp(f64 x) {
    u64 xb = *cast(u64*, &x);
    u32 ahx = cast(u32, xb >> 32) & 0x7FFFFFFF;
    if ahx >= 0x40862E42 {                       // |x| >= 709.78...
        if ahx >= 0x7FF00000 {
            if (xb << 12) != 0 { return x + x; } // NaN
            if (xb >> 63) == 0 { return x; }     // exp(+inf) = +inf
            return 0.0;                          // exp(-inf) = 0
        }
        if x > 709.782712893384 { return 1.0e300 * 1.0e300; }        // +inf
        if x < -745.1332191019411 { return 1.0e-300 * 1.0e-300; }    // +0
    }
    // round-to-nearest via the shift trick: the low 32 bits of
    // (x*128/ln2 + 1.5*2^52) are k in two's complement.
    f64 kd = x * 184.6649652337873 + 6755399441055744.0;
    u64 kb = *cast(u64*, &kd);
    i32 ki = cast(i32, kb & 0xFFFFFFFF);
    kd = kd - 6755399441055744.0;
    f64 r = (x - kd * 0.00541521234663378) - kd * 1.4907929134926466e-12;
    i32 j = ki & 127;
    i32 e = ki >> 7;
    f64* tp = cast(f64*, &__math_exp_tab[0]);
    f64 th = *(tp + j * 2);
    f64 tl = *(tp + j * 2 + 1);
    f64 p = r + r * r * (0.5 + r * (0.16666666666666666
            + r * (0.041666666666666664 + r * 0.008333333333333333)));
    f64 y = th + (tl + th * p);
    u64 yb = *cast(u64*, &y);
    if e >= -1021 {
        yb = yb + (cast(u64, cast(i64, e)) << 52);
        return *cast(f64*, &yb);
    }
    yb = yb + (cast(u64, cast(i64, e + 1000)) << 52);
    f64 ys = *cast(f64*, &yb);
    return ys * 9.332636185032189e-302;          // 2^-1000
}

// expf: shares the exp table, degree-3 polynomial, one rounding to
// f32. Within 0.5 ulp.
@strict_float
f32 exp(f32 x) {
    u32 xfb = *cast(u32*, &x);
    u32 axb = xfb & 0x7FFFFFFF;
    if axb >= 0x7F800000 {
        if axb > 0x7F800000 { return x + x; }    // NaN
        if (xfb >> 31) == 0 { return x; }        // expf(+inf) = +inf
        return 0.0f;                             // expf(-inf) = 0
    }
    f64 xd = x;
    if xd > 88.72284 { return 1.0e30f * 1.0e30f; }   // +inf
    if xd < -103.972084 { return 0.0f; }             // +0
    f64 kd = xd * 184.6649652337873 + 6755399441055744.0;
    u64 kb = *cast(u64*, &kd);
    i32 ki = cast(i32, kb & 0xFFFFFFFF);
    kd = kd - 6755399441055744.0;
    f64 r = (xd - kd * 0.00541521234663378) - kd * 1.4907929134926466e-12;
    i32 j = ki & 127;
    i32 e = ki >> 7;
    f64* tp = cast(f64*, &__math_exp_tab[0]);
    f64 th = *(tp + j * 2);
    f64 p = r + r * r * (0.5 + r * 0.16666666666666666);
    f64 y = th + th * p;
    u64 yb = *cast(u64*, &y);
    yb = yb + (cast(u64, cast(i64, e)) << 52);
    f64 ys = *cast(f64*, &yb);
    return cast(f32, ys);
}

// --- Canonical log family and pow ---
//
// One shared 128-entry table: [c, 1/c, ln(c) hi, ln(c) lo,
// -log2(invc) hi, -log2(invc) lo, mask27(1/c), 1/c - mask27(1/c)]
// per entry. log uses the natural columns; log2/log10/pow use the
// base-2 columns, which are defined for the ROUNDED 1/c so its
// rounding is not an error term; the last two are 1/c's exact 27-bit
// split, precomputed so the dd path skips the bit-mask round trip.
