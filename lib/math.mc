void __math_mul128(u64 a, u64 b, u64* hi, u64* lo) {
    u64 al = a & 0xFFFFFFFF;
    u64 ah = a >> 32;
    u64 bl = b & 0xFFFFFFFF;
    u64 bh = b >> 32;
    u64 ll = al * bl;
    u64 lh = al * bh;
    u64 hl = ah * bl;
    u64 mid = (ll >> 32) + (lh & 0xFFFFFFFF) + (hl & 0xFFFFFFFF);
    *lo = (mid << 32) | (ll & 0xFFFFFFFF);
    *hi = ah * bh + (lh >> 32) + (hl >> 32) + (mid >> 32);
}

i32 __math_clz64(u64 x) {
    if x == 0 { return 64; }
    i32 n = 0;
    if (x >> 32) == 0 { n += 32; x = x << 32; }
    if (x >> 48) == 0 { n += 16; x = x << 16; }
    if (x >> 56) == 0 { n += 8; x = x << 8; }
    if (x >> 60) == 0 { n += 4; x = x << 4; }
    if (x >> 62) == 0 { n += 2; x = x << 2; }
    if (x >> 63) == 0 { n += 1; }
    return n;
}

// Eisel-Lemire fast path; false means the rounding is too close to
// call and the bigint path decides.
bool __math_lemire(u64 m, i32 e10, bool sticky, u64* out) {
    i32 lz = __math_clz64(m);
    u64 w = m << cast(u64, lz);
    i32 idx = e10 + 342;
    u64 upper = 0;
    u64 lower = 0;
    __math_mul128(w, __math_p10hi[idx], &upper, &lower);
    if (upper & 0x1FF) == 0x1FF {
        u64 p2hi = 0;
        u64 p2lo = 0;
        __math_mul128(w, __math_p10lo[idx], &p2hi, &p2lo);
        u64 merged = lower + p2hi;
        if merged < lower {
            upper = upper + 1;
            if (upper & 0x1FF) == 0x1FF { return false; }
        }
        lower = merged;
    }
    u64 upperbit = upper >> 63;
    u64 m54 = upper >> (upperbit + 9);
    u64 round_mask = 0x1FF;
    if upperbit != 0 { round_mask = 0x3FF; }
    // truncated-product carry hazard: all-ones lower with a full round
    // window can bump m54; only an even m54 changes the rounding, and
    // only the bigint path can decide it
    if lower == 0xFFFFFFFFFFFFFFFF && (upper & round_mask) == round_mask && (m54 & 1) == 0 {
        return false;
    }
    if lower == 0 && (upper & round_mask) == 0 && (m54 & 3) == 1 && !sticky {
        return false;
    }
    u64 m53 = (m54 + (m54 & 1)) >> 1;
    i32 z_total = lz + (1 ^ cast(i32, upperbit));
    if m53 >= 0x20000000000000 {
        m53 = 0x10000000000000;
        z_total -= 1;
    }
    i32 be = ((e10 * 217706) >> 16) + 1023 + 64 - z_total;
    if be <= 0 { return false; }                  // subnormal: slow path
    if be >= 2047 {
        *out = 0x7FF0000000000000;
        return true;
    }
    *out = (cast(u64, cast(i64, be)) << 52) | (m53 & 0xFFFFFFFFFFFFF);
    return true;
}

// base-2^32 bigint for the exact halfway comparisons
struct __MathBig {
    u32[40] w;
    i32 n;
}

void __math_big_set(__MathBig* b, u64 v) {
    b.w[0] = cast(u32, v);
    b.w[1] = cast(u32, v >> 32);
    b.n = 0;
    if b.w[1] != 0 { b.n = 2; }
    else if b.w[0] != 0 { b.n = 1; }
}

void __math_big_mul(__MathBig* b, u32 m) {
    u64 carry = 0;
    for i32 i = 0; i < b.n; i++ {
        u64 p = cast(u64, b.w[i]) * m + carry;
        b.w[i] = cast(u32, p);
        carry = p >> 32;
    }
    if carry != 0 {
        b.w[b.n] = cast(u32, carry);
        b.n += 1;
    }
}

void __math_big_pow5(__MathBig* b, i32 n) {
    for i32 i = 0; i < n / 13; i++ { __math_big_mul(b, 1220703125); }  // 5^13
    for i32 i = 0; i < n % 13; i++ { __math_big_mul(b, 5); }
}

void __math_big_shl(__MathBig* b, i32 bits) {
    if bits == 0 || b.n == 0 { return; }
    i32 ws = bits / 32;
    i32 bs = bits % 32;
    if ws > 0 {
        for i32 i = b.n - 1; i >= 0; i-- { b.w[i + ws] = b.w[i]; }
        for i32 i = 0; i < ws; i++ { b.w[i] = 0; }
        b.n += ws;
    }
    if bs > 0 {
        u32 carry = 0;
        for i32 i = 0; i < b.n; i++ {
            u32 v = b.w[i];
            b.w[i] = (v << cast(u32, bs)) | carry;
            carry = v >> cast(u32, 32 - bs);
        }
        if carry != 0 {
            b.w[b.n] = carry;
            b.n += 1;
        }
    }
}

i32 __math_big_cmp(__MathBig* a, __MathBig* b) {
    if a.n > b.n { return 1; }
    if a.n < b.n { return -1; }
    for i32 i = a.n - 1; i >= 0; i-- {
        if a.w[i] > b.w[i] { return 1; }
        if a.w[i] < b.w[i] { return -1; }
    }
    return 0;
}

// compare m * 10^e10 against (2*cm + off) * 2^(ce - 1)
i32 __math_cmp_bound(u64 m, i32 e10, bool sticky, u64 cm, i32 ce, i32 off) {
    __MathBig lhs;
    __MathBig rhs;
    u64 bm = (cm << 1) + cast(u64, cast(i64, off));
    if e10 >= 0 {
        __math_big_set(&lhs, m);
        __math_big_pow5(&lhs, e10);
        __math_big_set(&rhs, bm);
        i32 d = e10 - (ce - 1);
        if d >= 0 { __math_big_shl(&lhs, d); }
        else { __math_big_shl(&rhs, -d); }
    } else {
        __math_big_set(&lhs, m);
        __math_big_set(&rhs, bm);
        __math_big_pow5(&rhs, -e10);
        i32 e = (ce - 1) + (-e10);
        if e >= 0 { __math_big_shl(&rhs, e); }
        else { __math_big_shl(&lhs, -e); }
    }
    i32 c = __math_big_cmp(&lhs, &rhs);
    if c != 0 { return c; }
    if sticky { return 1; }
    return 0;
}

// exact rounding: FPU seed, then walk +-1 ulp by bigint comparison
u64 __math_slow_parse(u64 m, i32 e10, bool sticky) {
    f64 v = 0.0;
    if (m >> 63) != 0 {
        v = cast(f64, cast(i64, m & 0x7FFFFFFFFFFFFFFF)) + 9.223372036854776e18;
    } else {
        v = cast(f64, cast(i64, m));
    }
    if e10 > 0 {
        for i32 i = 0; i < e10; i++ { v = v * 10.0; }
    } else {
        for i32 i = 0; i < -e10; i++ { v = v / 10.0; }
    }
    u64 c = *cast(u64*, &v);
    for i32 iter = 0; iter < 64; iter++ {
        i32 eb = cast(i32, (c >> 52) & 0x7FF);
        if eb >= 2047 { return c; }               // overflow: +inf stands
        u64 cm = c & 0xFFFFFFFFFFFFF;
        i32 ce = -1074;
        if eb != 0 {
            cm = cm | 0x10000000000000;
            ce = eb - 1023 - 52;
        }
        i32 up = __math_cmp_bound(m, e10, sticky, cm, ce, 1);
        if up > 0 {
            c = c + 1;
            continue;
        }
        if up == 0 {
            if (cm & 1) != 0 { c = c + 1; }
            return c;
        }
        if cm == 0 { return c; }
        i32 lo = __math_cmp_bound(m, e10, sticky, cm, ce, -1);
        if lo < 0 {
            c = c - 1;
            continue;
        }
        if lo == 0 {
            if (cm & 1) != 0 { c = c - 1; }
            return c;
        }
        return c;
    }
    return c;
}

// mantissa (up to 19 significant digits) * 10^e10 -> f64 bits
u64 __math_parse_f64(u64 m, i32 e10, bool sticky) {
    if m == 0 { return 0; }
    if e10 < -342 { return 0; }
    if e10 > 308 { return 0x7FF0000000000000; }
    // exact fast case: m and 10^|e10| both exactly representable,
    // one multiply or divide rounds once
    if !sticky && m <= 0x20000000000000 && e10 >= -22 && e10 <= 22 {
        f64 fm = cast(f64, cast(i64, m));
        f64 p10 = 1.0;
        i32 ae = e10;
        if ae < 0 { ae = -ae; }
        for i32 i = 0; i < ae; i++ { p10 = p10 * 10.0; }
        f64 fv = fm / p10;
        if e10 >= 0 { fv = fm * p10; }
        return *cast(u64*, &fv);
    }
    u64 bits = 0;
    if __math_lemire(m, e10, sticky, &bits) { return bits; }
    return __math_slow_parse(m, e10, sticky);
}

// round a hex-float mantissa m * 2^e2 (sticky = dropped bits) to f64
u64 __math_hex_to_f64(u64 m, i32 e2, bool sticky) {
    if m == 0 { return 0; }
    i32 lz = __math_clz64(m);
    u64 w = m << cast(u64, lz);
    i32 be = e2 + (63 - lz) + 1023;               // biased exponent of the MSB
    if be >= 2047 { return 0x7FF0000000000000; }
    i32 drop = 11;                                // keep 53 of 64 bits
    if be <= 0 {
        drop = 11 + (1 - be);                     // subnormal: fewer bits
        be = 0;
        if drop > 64 { return 0; }                // below half of min subnormal
    }
    u64 m53 = 0;
    u64 rest = 0;
    bool rbit = false;
    if drop == 64 {
        rbit = true;                              // w is normalized: bit 63 set
        rest = w << 1;
    } else {
        m53 = w >> cast(u64, drop);
        rbit = ((w >> cast(u64, drop - 1)) & 1) != 0;
        rest = w << cast(u64, 64 - (drop - 1));
    }
    if rbit && (rest != 0 || sticky || (m53 & 1) != 0) { m53 += 1; }
    if be == 0 {
        if m53 >= 0x10000000000000 { return 0x0010000000000000; }
        return m53;                               // subnormal
    }
    if m53 >= 0x20000000000000 {
        m53 = m53 >> 1;
        be += 1;
        if be >= 2047 { return 0x7FF0000000000000; }
    }
    return (cast(u64, cast(i64, be)) << 52) | (m53 & 0xFFFFFFFFFFFFF);
}

bool __math_is_space(u8 c) {
    return c == ' ' || (c >= '\t' && c <= '\r');
}

i32 __math_hex_digit(u8 c) {
    if c >= '0' && c <= '9' { return cast(i32, c) - '0'; }
    if c >= 'a' && c <= 'f' { return cast(i32, c) - 'a' + 10; }
    if c >= 'A' && c <= 'F' { return cast(i32, c) - 'A' + 10; }
    return -1;
}

bool __math_match_ci(u8* p, u8* word) {
    while *word != 0 {
        u8 c = *p;
        if c >= 'A' && c <= 'Z' { c = cast(u8, cast(i32, c) + 32); }
        if c != *word { return false; }
        p++;
        word++;
    }
    return true;
}

f64 strtod(u8* s, u8** endptr) {
    u8* p = s;
    while __math_is_space(*p) { p++; }
    u64 sign = 0;
    if *p == '-' { sign = 0x8000000000000000; p++; }
    else if *p == '+' { p++; }

    if __math_match_ci(p, "inf") {
        p = p + 3;
        if __math_match_ci(p, "inity") { p = p + 5; }
        if endptr != null { *endptr = p; }
        u64 b = 0x7FF0000000000000 | sign;
        return *cast(f64*, &b);
    }
    if __math_match_ci(p, "nan") {
        p = p + 3;
        if endptr != null { *endptr = p; }
        u64 b = 0x7FF8000000000000 | sign;
        return *cast(f64*, &b);
    }

    // hex form: 0x h-digits [. h-digits] [p exp]
    if *p == '0' && (*(p + 1) == 'x' || *(p + 1) == 'X')
       && (__math_hex_digit(*(p + 2)) >= 0
           || (*(p + 2) == '.' && __math_hex_digit(*(p + 3)) >= 0)) {
        p = p + 2;
        u64 m = 0;
        i32 ndig = 0;
        i32 e2 = 0;
        bool sticky = false;
        while __math_hex_digit(*p) >= 0 {
            i32 d = __math_hex_digit(*p);
            if ndig < 16 {
                if m != 0 || d != 0 { m = (m << 4) | cast(u64, cast(i64, d)); }
                if m != 0 { ndig += 1; }
            } else {
                if d != 0 { sticky = true; }
                e2 += 4;
            }
            p++;
        }
        if *p == '.' {
            p++;
            while __math_hex_digit(*p) >= 0 {
                i32 d = __math_hex_digit(*p);
                if ndig < 16 {
                    if m != 0 || d != 0 { m = (m << 4) | cast(u64, cast(i64, d)); }
                    if m != 0 { ndig += 1; }
                    e2 -= 4;
                } else {
                    if d != 0 { sticky = true; }
                }
                p++;
            }
        }
        if *p == 'p' || *p == 'P' {
            u8* q = p + 1;
            bool eneg = false;
            if *q == '-' { eneg = true; q++; }
            else if *q == '+' { q++; }
            if *q >= '0' && *q <= '9' {
                i32 ev = 0;
                while *q >= '0' && *q <= '9' {
                    if ev < 100000 { ev = ev * 10 + (cast(i32, *q) - '0'); }
                    q++;
                }
                if eneg { ev = -ev; }
                e2 += ev;
                p = q;
            }
        }
        if endptr != null { *endptr = p; }
        u64 b = __math_hex_to_f64(m, e2, sticky) | sign;
        return *cast(f64*, &b);
    }

    // decimal form
    u64 m = 0;
    i32 ndig = 0;
    i32 eadj = 0;
    bool sticky = false;
    bool any = false;
    while *p >= '0' && *p <= '9' {
        any = true;
        i32 d = cast(i32, *p) - '0';
        if ndig < 19 {
            if m != 0 || d != 0 { m = m * 10 + cast(u64, cast(i64, d)); }
            if m != 0 { ndig += 1; }
        } else {
            if d != 0 { sticky = true; }
            eadj += 1;
        }
        p++;
    }
    if *p == '.' {
        u8* q = p + 1;
        if any || (*q >= '0' && *q <= '9') {
            p = q;
            while *p >= '0' && *p <= '9' {
                any = true;
                i32 d = cast(i32, *p) - '0';
                if ndig < 19 {
                    if m != 0 || d != 0 { m = m * 10 + cast(u64, cast(i64, d)); }
                    if m != 0 { ndig += 1; }
                    eadj -= 1;
                } else {
                    if d != 0 { sticky = true; }
                }
                p++;
            }
        }
    }
    if !any {
        if endptr != null { *endptr = s; }              // no conversion
        return 0.0;
    }
    if *p == 'e' || *p == 'E' {
        u8* q = p + 1;
        bool eneg = false;
        if *q == '-' { eneg = true; q++; }
        else if *q == '+' { q++; }
        if *q >= '0' && *q <= '9' {
            i32 ev = 0;
            while *q >= '0' && *q <= '9' {
                if ev < 100000 { ev = ev * 10 + (cast(i32, *q) - '0'); }
                q++;
            }
            if eneg { ev = -ev; }
            eadj += ev;
            p = q;
        }
    }
    if endptr != null { *endptr = p; }
    u64 b = __math_parse_f64(m, eadj, sticky) | sign;
    return *cast(f64*, &b);
}

f64 atof(u8* s) {
    return strtod(s, null);
}

i64 strtol(u8* s, u8** endptr, i32 base) {
    u8* p = s;
    while __math_is_space(*p) { p++; }
    bool neg = false;
    if *p == '-' { neg = true; p++; }
    else if *p == '+' { p++; }
    if (base == 0 || base == 16) && *p == '0' && (*(p + 1) == 'x' || *(p + 1) == 'X')
       && __math_hex_digit(*(p + 2)) >= 0 && __math_hex_digit(*(p + 2)) < 16 {
        p = p + 2;
        base = 16;
    } else if base == 0 {
        if *p == '0' { base = 8; }
        else { base = 10; }
    }
    u64 acc = 0;
    bool any = false;
    bool over = false;
    u64 limit = 9223372036854775807;
    if neg { limit = limit + 1; }
    while true {
        i32 d = __math_hex_digit(*p);
        if d < 0 || d >= base {
            if *p >= 'G' && *p <= 'Z' { d = cast(i32, *p) - 'A' + 10; }
            else if *p >= 'g' && *p <= 'z' { d = cast(i32, *p) - 'a' + 10; }
            else { break; }
            if d >= base { break; }
        }
        any = true;
        u64 nd = cast(u64, cast(i64, d));
        if acc > (limit - nd) / cast(u64, cast(i64, base)) { over = true; }
        else { acc = acc * cast(u64, cast(i64, base)) + nd; }
        p++;
    }
    if !any {
        if endptr != null { *endptr = s; }
        return 0;
    }
    if endptr != null { *endptr = p; }
    if over { acc = limit; }
    if neg { return 0 - cast(i64, acc); }
    return cast(i64, acc);
}

i32 atoi(u8* s) {
    return cast(i32, strtol(s, null, 10));
}

// --- C string / memory / stdlib (canonical) ---
//
// Exact operations with pinned behavior: same results on every
// target. qsort is heapsort, so the order of equal keys is
// deterministic (C leaves it unspecified; minc pins it). rand is
// musl's 64-bit LCG — a pinned reproducible sequence, not a quality
// claim; use a dedicated generator for statistical work.

void* memmove(void* dst, void* src, u64 n) {
    u8* d = cast(u8*, dst);
    u8* s = cast(u8*, src);
    if cast(i64, d) == cast(i64, s) || n == 0 { return dst; }
    if cast(u64, cast(i64, d)) < cast(u64, cast(i64, s)) {
        while n >= 8 {
            *cast(u64*, d) = *cast(u64*, s);
            d = d + 8;
            s = s + 8;
            n -= 8;
        }
        while n > 0 {
            *d = *s;
            d++;
            s++;
            n -= 1;
        }
    } else {
        while n >= 8 {
            n -= 8;
            *cast(u64*, d + n) = *cast(u64*, s + n);
        }
        while n > 0 {
            n -= 1;
            *(d + n) = *(s + n);
        }
    }
    return dst;
}

i32 memcmp(void* a, void* b, u64 n) {
    u8* pa = cast(u8*, a);
    u8* pb = cast(u8*, b);
    for u64 i = 0; i < n; i++ {
        i32 d = cast(i32, *(pa + i)) - cast(i32, *(pb + i));
        if d != 0 { return d; }
    }
    return 0;
}

void* memchr(void* s, i32 c, u64 n) {
    u8* p = cast(u8*, s);
    u8 ch = cast(u8, c);
    for u64 i = 0; i < n; i++ {
        if *(p + i) == ch { return cast(void*, p + i); }
    }
    return null;
}

u64 strlen(u8* s) {
    u8* p = s;
    while (cast(u64, cast(i64, p)) & 7) != 0 {
        if *p == 0 { return cast(u64, cast(i64, p) - cast(i64, s)); }
        p++;
    }
    // aligned words: (v - 0x0101..) & ~v & 0x8080.. flags a zero byte
    u64* w = cast(u64*, p);
    while ((*w - 0x0101010101010101) & ~*w & 0x8080808080808080) == 0 { w = w + 1; }
    p = cast(u8*, w);
    while *p != 0 { p++; }
    return cast(u64, cast(i64, p) - cast(i64, s));
}

i32 strcmp(u8* a, u8* b) {
    while *a != 0 && *a == *b {
        a++;
        b++;
    }
    return cast(i32, *a) - cast(i32, *b);
}

i32 strncmp(u8* a, u8* b, u64 n) {
    while n > 0 && *a != 0 && *a == *b {
        a++;
        b++;
        n -= 1;
    }
    if n == 0 { return 0; }
    return cast(i32, *a) - cast(i32, *b);
}

i32 strcasecmp(u8* a, u8* b) {
    while true {
        i32 ca = tolower(cast(i32, *a));
        i32 cb = tolower(cast(i32, *b));
        if ca != cb || ca == 0 { return ca - cb; }
        a++;
        b++;
    }
}

u8* strcpy(u8* dst, u8* src) {
    u8* d = dst;
    while *src != 0 {
        *d = *src;
        d++;
        src++;
    }
    *d = 0;
    return dst;
}

u8* strncpy(u8* dst, u8* src, u64 n) {
    u64 i = 0;
    while i < n && *(src + i) != 0 {
        *(dst + i) = *(src + i);
        i += 1;
    }
    while i < n {
        *(dst + i) = 0;
        i += 1;
    }
    return dst;
}

u8* strcat(u8* dst, u8* src) {
    u8* d = dst + strlen(dst);
    while *src != 0 {
        *d = *src;
        d++;
        src++;
    }
    *d = 0;
    return dst;
}

u8* strncat(u8* dst, u8* src, u64 n) {
    u8* d = dst + strlen(dst);
    while n > 0 && *src != 0 {
        *d = *src;
        d++;
        src++;
        n -= 1;
    }
    *d = 0;
    return dst;
}

u8* strchr(u8* s, i32 c) {
    u8 ch = cast(u8, c);
    while *s != ch {
        if *s == 0 { return null; }
        s++;
    }
    return s;
}

u8* strrchr(u8* s, i32 c) {
    u8 ch = cast(u8, c);
    u8* found = null;
    while true {
        if *s == ch { found = s; }
        if *s == 0 { return found; }
        s++;
    }
}

u8* strstr(u8* haystack, u8* needle) {
    if *needle == 0 { return haystack; }
    while *haystack != 0 {
        u8* h = haystack;
        u8* n = needle;
        while *n != 0 && *h == *n {
            h++;
            n++;
        }
        if *n == 0 { return haystack; }
        haystack++;
    }
    return null;
}

u8* strpbrk(u8* s, u8* accept) {
    while *s != 0 {
        u8* a = accept;
        while *a != 0 {
            if *s == *a { return s; }
            a++;
        }
        s++;
    }
    return null;
}

// ctype: C locale, ASCII
i32 isdigit(i32 c) { if c >= '0' && c <= '9' { return 1; } return 0; }
i32 isupper(i32 c) { if c >= 'A' && c <= 'Z' { return 1; } return 0; }
i32 islower(i32 c) { if c >= 'a' && c <= 'z' { return 1; } return 0; }
i32 isalpha(i32 c) { return isupper(c) | islower(c); }
i32 isalnum(i32 c) { return isalpha(c) | isdigit(c); }
i32 isspace(i32 c) { if c == ' ' || (c >= '\t' && c <= '\r') { return 1; } return 0; }
i32 isprint(i32 c) { if c >= ' ' && c <= '~' { return 1; } return 0; }
i32 isgraph(i32 c) { if c >= '!' && c <= '~' { return 1; } return 0; }
i32 iscntrl(i32 c) { if (c >= 0 && c <= 31) || c == 127 { return 1; } return 0; }
i32 ispunct(i32 c) { return isgraph(c) & (1 - isalnum(c)); }
i32 isxdigit(i32 c) {
    if isdigit(c) != 0 { return 1; }
    if (c >= 'A' && c <= 'F') || (c >= 'a' && c <= 'f') { return 1; }
    return 0;
}
i32 toupper(i32 c) { if islower(c) != 0 { return c - 32; } return c; }
i32 tolower(i32 c) { if isupper(c) != 0 { return c + 32; } return c; }

// rand: musl's LCG (seed*6364136223846793005 + 1, top 31 bits).
// srand's s-1 wraps in u32 first, as in C.
u64 __math_rand_seed;

void srand(u32 s) {
    __math_rand_seed = cast(u64, s - 1);
}

i32 rand() {
    __math_rand_seed = __math_rand_seed * 6364136223846793005 + 1;
    return cast(i32, __math_rand_seed >> 33);
}

// qsort: heapsort — in-place, no recursion, deterministic order for
// equal keys
void __math_qswap(u8* a, u8* b, u64 size) {
    for u64 k = 0; k < size; k++ {
        u8 t = *(a + k);
        *(a + k) = *(b + k);
        *(b + k) = t;
    }
}

void __math_sift(u8* base, u64 size, fn(void*, void*): i32 cmp, u64 root, u64 end) {
    while root * 2 + 1 < end {
        u64 child = root * 2 + 1;
        if child + 1 < end
           && cmp(cast(void*, base + child * size), cast(void*, base + (child + 1) * size)) < 0 {
            child += 1;
        }
        if cmp(cast(void*, base + root * size), cast(void*, base + child * size)) >= 0 {
            return;
        }
        __math_qswap(base + root * size, base + child * size, size);
        root = child;
    }
}

void qsort(void* basep, u64 n, u64 size, fn(void*, void*): i32 cmp) {
    if n < 2 || size == 0 { return; }
    u8* base = cast(u8*, basep);
    u64 start = n / 2;
    while start > 0 {
        start -= 1;
        __math_sift(base, size, cmp, start, n);
    }
    u64 end = n;
    while end > 1 {
        end -= 1;
        __math_qswap(base, base + end * size, size);
        __math_sift(base, size, cmp, 0, end);
    }
}

// --- Derived f32 overloads (portable) ---

f32 log10(f32 x) { return log(x) * 0.43429448f; }  // 1/ln(10)

f32 log2(f32 x) { return log(x) * 1.44269504f; }   // 1/ln(2)

f32 cosh(f32 x) {
    f32 e = exp(x);
    return (e + 1.0f / e) * 0.5f;
}

f32 sinh(f32 x) {
    f32 e = exp(x);
    return (e - 1.0f / e) * 0.5f;
}

f32 tanh(f32 x) {
    if x > 20.0f { return 1.0f; }    // expf(2x) overflows; tanh saturates
    if x < -20.0f { return -1.0f; }
    f32 e2 = exp(2.0f * x);
    return (e2 - 1.0f) / (e2 + 1.0f);
}


// --- f32 overloads over the f64 paths ---

f32 asinh(f32 x) { return cast(f32, asinh(cast(f64, x))); }
f32 acosh(f32 x) { return cast(f32, acosh(cast(f64, x))); }
f32 atanh(f32 x) { return cast(f32, atanh(cast(f64, x))); }
f32 expm1(f32 x) { return cast(f32, expm1(cast(f64, x))); }
f32 log1p(f32 x) { return cast(f32, log1p(cast(f64, x))); }

// --- C-compat f-suffix aliases ---
//
// The unsuffixed overloads are the canonical surface; these keep
// C-shaped code working. extern declarations of these names are
// rejected — bind a library's symbol under another name with `from`.

f32 sinf(f32 x) { return sin(x); }
f32 cosf(f32 x) { return cos(x); }
f32 tanf(f32 x) { return tan(x); }
f32 asinf(f32 x) { return asin(x); }
f32 acosf(f32 x) { return acos(x); }
f32 atanf(f32 x) { return atan(x); }
f32 atan2f(f32 y, f32 x) { return atan2(y, x); }
f32 expf(f32 x) { return exp(x); }
f32 logf(f32 x) { return log(x); }
f32 log2f(f32 x) { return log2(x); }
f32 log10f(f32 x) { return log10(x); }
f32 powf(f32 x, f32 y) { return pow(x, y); }
f32 fmodf(f32 x, f32 y) { return fmod(x, y); }
f32 roundf(f32 x) { return round(x); }
f32 fminf(f32 x, f32 y) { return fmin(x, y); }
f32 fmaxf(f32 x, f32 y) { return fmax(x, y); }
f32 coshf(f32 x) { return cosh(x); }
f32 sinhf(f32 x) { return sinh(x); }
f32 tanhf(f32 x) { return tanh(x); }
f32 asinhf(f32 x) { return asinh(x); }
f32 acoshf(f32 x) { return acosh(x); }
f32 atanhf(f32 x) { return atanh(x); }
f32 expm1f(f32 x) { return expm1(x); }
f32 log1pf(f32 x) { return log1p(x); }
f32 ldexpf(f32 x, i32 n) { return ldexp(x, n); }
f32 copysignf(f32 x, f32 y) { return copysign(x, y); }
f32 frexpf(f32 x, i32* e) { return frexp(x, e); }
f32 hypotf(f32 x, f32 y) { return hypot(x, y); }

// --- Constants ---

const f64 PI = 3.141592653589793;
const f64 E = 2.718281828459045;
const f64 TAU = 6.283185307179586;
const f32 PI_F = 3.14159265f;
const f32 E_F = 2.71828182f;
const f32 TAU_F = 6.28318530f;

// --- Generic helpers ---

T abs<T: Signed>(T x) {
    if x < 0 { return 0 - x; }
    return x;
}

T min<T: Numeric>(T a, T b) {
    if a < b { return a; }
    return b;
}

T max<T: Numeric>(T a, T b) {
    if a > b { return a; }
    return b;
}

T clamp<T: Numeric>(T x, T lo, T hi) {
    if x < lo { return lo; }
    if x > hi { return hi; }
    return x;
}

f64 lerp(f64 a, f64 b, f64 t) {
    return a + (b - a) * t;
}
