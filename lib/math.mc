// math.mc — math functions for minc
//
// Builtins (no import needed): sqrt, fabs, floor, ceil, trunc and
// their f32 overloads. Bit-identical on every target.
//
// Everything else is defined here in minc. Results are bit-identical 
// on every target.
//
// Pure minc helpers: abs, min, max, clamp, lerp.
//
// The implementations are ports of musl libc / fdlibm routines. 
// See THIRD_PARTY_LICENSE.md.
//
//

// --- Exact fmod (portable) ---
//
// Shift-subtract remainder on the raw bits (musl shape). fmod is
// exact, so the result matches any conforming libm bit-for-bit.

f64 fmod(f64 x, f64 y) {
    u64 ux = *cast(u64*, &x);
    u64 uy = *cast(u64*, &y);
    i32 ex = cast(i32, (ux >> 52) & 0x7FF);
    i32 ey = cast(i32, (uy >> 52) & 0x7FF);
    u64 sx = ux & 0x8000000000000000;

    // y = 0, x = inf/nan, y = nan -> nan. (y = inf falls through: the
    // |x| < |y| test below returns x, which is fmod(x, inf).)
    if (uy << 1) == 0 || ex == 0x7FF || y != y {
        return (x * y) / (x * y);
    }
    if (ux << 1) <= (uy << 1) {
        if (ux << 1) == (uy << 1) { return 0.0 * x; }  // signed zero
        return x;
    }

    // Normalize both mantissas to bit 52 (subnormals scan to a
    // negative exponent).
    if ex == 0 {
        u64 nx = ux << 12;
        while (nx >> 63) == 0 { ex = ex - 1; nx = nx << 1; }
        ux = ux << cast(u64, 1 - ex);
    } else {
        ux = (ux & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    }
    if ey == 0 {
        u64 ny = uy << 12;
        while (ny >> 63) == 0 { ey = ey - 1; ny = ny << 1; }
        uy = uy << cast(u64, 1 - ey);
    } else {
        uy = (uy & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    }

    // Reduce up to 11 bits of exponent gap per step: ux < 2^53, so
    // ux << 11 fits u64 and one hardware modulo replaces 11
    // shift-subtract iterations.
    while ex > ey {
        i32 kk = ex - ey;
        if kk > 11 { kk = 11; }
        ux = (ux << cast(u64, kk)) % uy;
        if ux == 0 { return 0.0 * x; }
        ex = ex - kk;
    }
    if ux >= uy {
        ux = ux - uy;
        if ux == 0 { return 0.0 * x; }
    }
    while (ux >> 52) == 0 { ux = ux << 1; ex = ex - 1; }

    // Scale the result back (ex <= 0 produces a subnormal).
    if ex > 0 {
        ux = (ux - 0x0010000000000000) | (cast(u64, ex) << 52);
    } else {
        ux = ux >> cast(u64, 1 - ex);
    }
    ux = ux | sx;
    return *cast(f64*, &ux);
}

f32 fmod(f32 x, f32 y) {
    u32 ux = *cast(u32*, &x);
    u32 uy = *cast(u32*, &y);
    i32 ex = cast(i32, (ux >> 23) & 0xFF);
    i32 ey = cast(i32, (uy >> 23) & 0xFF);
    u32 sx = ux & 0x80000000;

    if (uy << 1) == 0 || ex == 0xFF || y != y {
        return (x * y) / (x * y);
    }
    if (ux << 1) <= (uy << 1) {
        if (ux << 1) == (uy << 1) { return 0.0f * x; }
        return x;
    }

    if ex == 0 {
        u32 nx = ux << 9;
        while (nx >> 31) == 0 { ex = ex - 1; nx = nx << 1; }
        ux = ux << cast(u32, 1 - ex);
    } else {
        ux = (ux & 0x007FFFFF) | 0x00800000;
    }
    if ey == 0 {
        u32 ny = uy << 9;
        while (ny >> 31) == 0 { ey = ey - 1; ny = ny << 1; }
        uy = uy << cast(u32, 1 - ey);
    } else {
        uy = (uy & 0x007FFFFF) | 0x00800000;
    }

    while ex > ey {
        i32 kk = ex - ey;
        if kk > 7 { kk = 7; }
        ux = (ux << cast(u32, kk)) % uy;
        if ux == 0 { return 0.0f * x; }
        ex = ex - kk;
    }
    if ux >= uy {
        ux = ux - uy;
        if ux == 0 { return 0.0f * x; }
    }
    while (ux >> 23) == 0 { ux = ux << 1; ex = ex - 1; }

    if ex > 0 {
        ux = (ux - 0x00800000) | (cast(u32, ex) << 23);
    } else {
        ux = ux >> cast(u32, 1 - ex);
    }
    ux = ux | sx;
    return *cast(f32*, &ux);
}


// round: halves away from zero. x - trunc(x) is exact, so the half
// test cannot double-round. NaN and Inf fall through the compares.
f64 round(f64 x) {
    f64 t = trunc(x);
    f64 d = x - t;
    if d >= 0.5 { return t + 1.0; }
    if d <= -0.5 { return t - 1.0; }
    return t;
}

f32 round(f32 x) {
    f32 t = truncf(x);
    f32 d = x - t;
    if d >= 0.5f { return t + 1.0f; }
    if d <= -0.5f { return t - 1.0f; }
    return t;
}

