// GL 4.2 desktop-only entry points; not present in GLES3.x.
// sokol's _sg_gl_draw gates these behind _sg.features.draw_base_vertex
// / draw_base_instance, both of which are false on GLES3, so the
// stubs below are never reached at runtime. They exist only to
// satisfy the dynamic linker.
void glDrawElementsBaseVertex(u32 mode, i32 count, u32 type, void* indices, i32 basevertex) { }
void glDrawElementsInstancedBaseVertex(u32 mode, i32 count, u32 type, void* indices, i32 instancecount, i32 basevertex) { }
void glDrawArraysInstancedBaseInstance(u32 mode, i32 first, i32 count, i32 instancecount, u32 baseinstance) { }
void glDrawElementsInstancedBaseVertexBaseInstance(u32 mode, i32 count, u32 type, void* indices, i32 instancecount, i32 basevertex, u32 baseinstance) { }
