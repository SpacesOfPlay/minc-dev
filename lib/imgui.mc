bool ImGuiDockNode_IsRootNode(ImGuiDockNode* self) {
    return self.ParentNode == null;
}

bool ImGuiDockNode_IsDockSpace(ImGuiDockNode* self) {
    return (self.MergedFlags & ImGuiDockNodeFlags_DockSpace) != 0;
}

bool ImGuiDockNode_IsFloatingNode(ImGuiDockNode* self) {
    return self.ParentNode == null && (self.MergedFlags & ImGuiDockNodeFlags_DockSpace) == 0;
}

bool ImGuiDockNode_IsCentralNode(ImGuiDockNode* self) {
    return (self.MergedFlags & ImGuiDockNodeFlags_CentralNode) != 0;
}

bool ImGuiDockNode_IsHiddenTabBar(ImGuiDockNode* self) {
    return (self.MergedFlags & ImGuiDockNodeFlags_HiddenTabBar) != 0;
}

// Hidden tab bar can be shown back by clicking the small triangle
bool ImGuiDockNode_IsNoTabBar(ImGuiDockNode* self) {
    return (self.MergedFlags & ImGuiDockNodeFlags_NoTabBar) != 0;
}

// Never show a tab bar
bool ImGuiDockNode_IsSplitNode(ImGuiDockNode* self) {
    return self.ChildNodes[0] != null;
}

bool ImGuiDockNode_IsLeafNode(ImGuiDockNode* self) {
    return self.ChildNodes[0] == null;
}

bool ImGuiDockNode_IsEmpty(ImGuiDockNode* self) {
    return self.ChildNodes[0] == null && self.Windows.Size == 0;
}

ImRect ImGuiDockNode_Rect(ImGuiDockNode* self) {
    return ImRect{
        ImVec2{self.Pos.x, self.Pos.y},
        ImVec2{self.Pos.x + self.Size.x, self.Pos.y + self.Size.y},
    };
}

void ImGuiDockNode_SetLocalFlags(ImGuiDockNode* self, ImGuiDockNodeFlags flags) {
    self.LocalFlags = flags;
    ImGuiDockNode_UpdateMergedFlags(self);
}

void ImGuiDockNode_UpdateMergedFlags(ImGuiDockNode* self) {
    self.MergedFlags = self.SharedFlags | self.LocalFlags | self.LocalFlagsInWindows;
}

void ImGuiDockContext_init(ImGuiDockContext* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    memset(&self.Nodes, 0, cast(u64, sizeof(ImGuiStorage)));
    ImVector_ImGuiDockRequest_init(&self.Requests);
    ImVector_ImGuiDockNodeSettings_init(&self.NodesSettings);
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
}

