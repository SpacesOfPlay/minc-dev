void ImStableVector_ImFontBaked_32_dtor(ImStableVector_ImFontBaked_32* self) {
    {
        ImFontBaked** zz_rf_it_1 = ImVector_ImFontBaked_ptr_begin(&self.Blocks);
        ImFontBaked** zz_rf_end_1 = ImVector_ImFontBaked_ptr_end(&self.Blocks);
        for ; zz_rf_it_1 != zz_rf_end_1; zz_rf_it_1++ {
            ImFontBaked* block = *zz_rf_it_1;
            ImGui_MemFree(block);
        }
    }
}

void ImStableVector_ImFontBaked_32_clear(ImStableVector_ImFontBaked_32* self) {
    self.Capacity = 0;
    self.Size = self.Capacity;
    ImVector_ImFontBaked_ptr_clear_delete(&self.Blocks);
}

void ImStableVector_ImFontBaked_32_resize(ImStableVector_ImFontBaked_32* self, i32 new_size) {
    if new_size > self.Capacity {
        ImStableVector_ImFontBaked_32_reserve(self, new_size);
    }
    self.Size = new_size;
}

void ImStableVector_ImFontBaked_32_reserve(ImStableVector_ImFontBaked_32* self, i32 new_cap) {
    new_cap = new_cap + (32 - 1) & ~(32 - 1);
    i32 old_count = self.Capacity / 32;
    i32 new_count = new_cap / 32;
    if new_count <= old_count {
        return;
    }
    ImVector_ImFontBaked_ptr_resize(&self.Blocks, new_count);
    for i32 n = old_count; n < new_count; n++ {
        self.Blocks.Data[n] = cast(ImFontBaked*, ImGui_MemAlloc(cast(u64, sizeof(ImFontBaked) * 32)));
    }
    self.Capacity = new_cap;
}

ImFontBaked* ImStableVector_ImFontBaked_32_index(ImStableVector_ImFontBaked_32* self, i32 i) {
    assert(i >= 0 && i < self.Size);
    return &self.Blocks.Data[i / 32][i % 32];
}

ImFontBaked* ImStableVector_ImFontBaked_32_push_back(ImStableVector_ImFontBaked_32* self, ImFontBaked v) {
    i32 i = self.Size;
    assert(i >= 0);
    if self.Size == self.Capacity {
        ImStableVector_ImFontBaked_32_reserve(self, self.Capacity + 32);
    }
    void* ptr = &self.Blocks.Data[i / 32][i % 32];
    memcpy(ptr, &v, cast(u64, sizeof(v)));
    self.Size++;
    return cast(ImFontBaked*, ptr);
}

