private {
ImDrawList* GetViewportBgFgDrawList(ImGuiViewportP* viewport, u64 drawlist_no, u8* drawlist_name) {
    ImGuiContext* g = GImGui;
    assert(drawlist_no < cast(u64, cast(i32, sizeof(viewport.BgFgDrawLists) / sizeof(*viewport.BgFgDrawLists))));
    ImDrawList* draw_list = viewport.BgFgDrawLists[drawlist_no];
    if draw_list == null {
        draw_list = cast(ImDrawList*, ImGui_MemAlloc(cast(u64, sizeof(ImDrawList))));
        ImDrawList_init(draw_list, &g.DrawListSharedData);
        draw_list._OwnerName = drawlist_name;
        viewport.BgFgDrawLists[drawlist_no] = draw_list;
    }
    if viewport.BgFgDrawListsLastTimeActive[drawlist_no] != cast(f32, g.Time) {
        ImDrawList__ResetForNewFrame(draw_list);
        ImDrawList_PushTexture(draw_list, g.IO.Fonts.TexRef);
        ImDrawList_PushClipRect(draw_list, viewport.Pos, op_add_ImVec2_ImVec2(viewport.Pos, viewport.Size), false);
        viewport.BgFgDrawListsLastTimeActive[drawlist_no] = cast(f32, g.Time);
    }
    return draw_list;
}
}

ImDrawList* ImGui_GetBackgroundDrawList(ImGuiViewport* viewport) {
    if viewport == null {
        viewport = cast(ImGuiViewport*, GImGui.CurrentWindow.Viewport);
    }
    return GetViewportBgFgDrawList(cast(ImGuiViewportP*, viewport), 0, "##Background");
}

ImDrawList* ImGui_GetForegroundDrawList(ImGuiViewport* viewport) {
    if viewport == null {
        viewport = cast(ImGuiViewport*, GImGui.CurrentWindow.Viewport);
    }
    return GetViewportBgFgDrawList(cast(ImGuiViewportP*, viewport), 1, "##Foreground");
}

