    ImVector_ImTextureRect_init(&self.Updates);
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
    self.Status = ImTextureStatus_Destroyed;
    self.TexID = cast(ImTextureID, 0);
}

