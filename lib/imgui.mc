    return zz_t;
}

void ImFontGlyphRangesBuilder_Clear(ImFontGlyphRangesBuilder* self) {
    i32 size_in_bytes = (0xFFFF + 1) / 8;
    ImVector_ImU32_resize(&self.UsedChars, size_in_bytes / cast(i32, sizeof(ImU32)));
    memset(self.UsedChars.Data, 0, cast(u64, size_in_bytes));
}

bool ImFontGlyphRangesBuilder_GetBit(ImFontGlyphRangesBuilder* self, u64 n) {
    var off = cast(i32, n >> 5);
    var mask = cast(ImU32, 1 << (n & 31));
    return (self.UsedChars.Data[off] & mask) != 0;
}

void ImFontGlyphRangesBuilder_SetBit(ImFontGlyphRangesBuilder* self, u64 n) {
    var off = cast(i32, n >> 5);
    var mask = cast(ImU32, 1 << (n & 31));
    self.UsedChars.Data[off] |= mask;
}

void ImFontGlyphRangesBuilder_AddChar(ImFontGlyphRangesBuilder* self, ImWchar c) {
    ImFontGlyphRangesBuilder_SetBit(self, c);
}

