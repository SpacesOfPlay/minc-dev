//-----------------------------------------------------------------------------
// [SECTION] Helpers: Debug log, memory allocations macros, ImVector<>
//-----------------------------------------------------------------------------
//-----------------------------------------------------------------------------
// Debug Logging into ShowDebugLogWindow(), tty and more.
//-----------------------------------------------------------------------------

void ImVector_ImWchar_init(ImVector_ImWchar* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.Capacity = 0;
    self.Size = self.Capacity;
    self.Data = null;
}

ImVector_ImWchar* __cxx_new_ImVector_ImWchar(void* p) {
    ImVector_ImWchar_init(cast(ImVector_ImWchar*, p));
    return cast(ImVector_ImWchar*, p);
}

ImVector_ImWchar __cxx_make_ImVector_ImWchar() {
    ImVector_ImWchar zz_t;
    ImVector_ImWchar_init(&zz_t);
    return zz_t;
}

void ImVector_ImWchar_init(ImVector_ImWchar* self, ImVector_ImWchar src) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.Capacity = 0;
    self.Size = self.Capacity;
    self.Data = null;
    ImVector_ImWchar_assign(self, src);
}

ImVector_ImWchar __cxx_make_ImVector_ImWchar(ImVector_ImWchar src) {
    ImVector_ImWchar zz_mk;
    zz_mk = src;
    return zz_mk;
}

ImVector_ImWchar* ImVector_ImWchar_assign(ImVector_ImWchar* self, ImVector_ImWchar src) {
    ImVector_ImWchar_clear(self);
    ImVector_ImWchar_resize(self, src.Size);
    if self.Data && src.Data {
        memcpy(self.Data, src.Data, cast(u64, self.Size) * cast(u64, sizeof(ImWchar)));
    }
    return &*self;
}

void ImVector_ImWchar_dtor(ImVector_ImWchar* self) {
    if self.Data != null {
        ImGui_MemFree(self.Data);
    }
}

void ImVector_ImWchar_clear(ImVector_ImWchar* self) {
    if self.Data != null {
        self.Capacity = 0;
        self.Size = self.Capacity;
        ImGui_MemFree(self.Data);
        self.Data = null;
    }
}

void ImVector_ImWchar_clear_delete(ImVector_ImWchar* self) {
    for i32 n = 0; n < self.Size; n++ {
        0;
    }
    ImVector_ImWchar_clear(self);
}

void ImVector_ImWchar_clear_destruct(ImVector_ImWchar* self) {
    for i32 n = 0; n < self.Size; n++ {
        self.Data[n];
    }
    ImVector_ImWchar_clear(self);
}

bool ImVector_ImWchar_empty(ImVector_ImWchar* self) {
    return self.Size == 0;
}

i32 ImVector_ImWchar_size(ImVector_ImWchar* self) {
    return self.Size;
}

i32 ImVector_ImWchar_size_in_bytes(ImVector_ImWchar* self) {
    return self.Size * cast(i32, sizeof(ImWchar));
}

i32 ImVector_ImWchar_max_size(ImVector_ImWchar* self) {
    return 0x7FFFFFFF / cast(i32, sizeof(ImWchar));
}

i32 ImVector_ImWchar_capacity(ImVector_ImWchar* self) {
    return self.Capacity;
}

ImWchar* ImVector_ImWchar_index(ImVector_ImWchar* self, i32 i) {
    assert(i >= 0 && i < self.Size);
    return &self.Data[i];
}

ImWchar* ImVector_ImWchar_begin(ImVector_ImWchar* self) {
    return self.Data;
}

ImWchar* ImVector_ImWchar_end(ImVector_ImWchar* self) {
    return self.Data + self.Size;
}

ImWchar* ImVector_ImWchar_front(ImVector_ImWchar* self) {
    assert(self.Size > 0);
    return &self.Data[0];
}

ImWchar* ImVector_ImWchar_back(ImVector_ImWchar* self) {
    assert(self.Size > 0);
    return &self.Data[self.Size - 1];
}

void ImVector_ImWchar_swap(ImVector_ImWchar* self, ImVector_ImWchar* rhs) {
    i32 rhs_size = rhs.Size;
    rhs.Size = self.Size;
    self.Size = rhs_size;
    i32 rhs_cap = rhs.Capacity;
    rhs.Capacity = self.Capacity;
    self.Capacity = rhs_cap;
    ImWchar* rhs_data = rhs.Data;
    rhs.Data = self.Data;
    self.Data = rhs_data;
}

i32 ImVector_ImWchar__grow_capacity(ImVector_ImWchar* self, i32 sz) {
