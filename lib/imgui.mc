// Check that version and structures layouts are matching between compiled imgui code and caller. Read comments above DebugCheckVersionAndDataLayout() for details.
// Helper Macros - IM_FMTARGS, IM_FMTLIST: Apply printf-style warnings to our formatting functions.
// (MSVC provides an equivalent mechanism via SAL Annotations but it requires the macros in a different
//  location. e.g. #include <sal.h> + void myprintf(_Printf_format_string_ const char* format, ...),
//  and only works when using Code Analysis, rather than just normal compiling).
// (see https://github.com/ocornut/imgui/issues/8871 for a patch to enable this for MSVC's Code Analysis)
// Disable some of MSVC most aggressive Debug runtime checks in function header/footer (used in some simple/low-level functions)

void ImVec2_init(ImVec2* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.x = 0.0f;
    self.y = 0.0f;
}

ImVec2* __cxx_new_ImVec2(void* p) {
    ImVec2_init(cast(ImVec2*, p));
    return cast(ImVec2*, p);
}

ImVec2 __cxx_make_ImVec2() {
    ImVec2 zz_t;
    ImVec2_init(&zz_t);
    return zz_t;
}

void ImVec2_init(ImVec2* self, f32 _x, f32 _y) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.x = _x;
    self.y = _y;
}

ImVec2 __cxx_make_ImVec2(f32 _x, f32 _y) {
    ImVec2 zz_mk;
    ImVec2_init(&zz_mk, _x, _y);
    return zz_mk;
}

f32* ImVec2_index(ImVec2* self, u64 idx) {
    assert(idx == 0 || idx == 1);
    return &cast(f32*, cast(void*, cast(u8*, self)))[idx];
}

void ImVec4_init(ImVec4* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.x = 0.0f;
    self.y = 0.0f;
    self.z = 0.0f;
    self.w = 0.0f;
}

ImVec4* __cxx_new_ImVec4(void* p) {
    ImVec4_init(cast(ImVec4*, p));
    return cast(ImVec4*, p);
}

ImVec4 __cxx_make_ImVec4() {
    ImVec4 zz_t;
    ImVec4_init(&zz_t);
    return zz_t;
}

void ImVec4_init(ImVec4* self, f32 _x, f32 _y, f32 _z, f32 _w) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.x = _x;
    self.y = _y;
    self.z = _z;
    self.w = _w;
}

ImVec4 __cxx_make_ImVec4(f32 _x, f32 _y, f32 _z, f32 _w) {
    ImVec4 zz_mk;
    ImVec4_init(&zz_mk, _x, _y, _z, _w);
    return zz_mk;
}

void ImTextureRef_init(ImTextureRef* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self._TexData = null;
    self._TexID = cast(ImTextureID, 0);
}

ImTextureRef* __cxx_new_ImTextureRef(void* p) {
    ImTextureRef_init(cast(ImTextureRef*, p));
    return cast(ImTextureRef*, p);
}

ImTextureRef __cxx_make_ImTextureRef() {
    ImTextureRef zz_t;
    ImTextureRef_init(&zz_t);
    return zz_t;
}

void ImTextureRef_init(ImTextureRef* self, ImTextureID tex_id) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self._TexData = null;
    self._TexID = tex_id;
}

ImTextureRef __cxx_make_ImTextureRef(ImTextureID tex_id) {
    ImTextureRef zz_mk;
    ImTextureRef_init(&zz_mk, tex_id);
    return zz_mk;
}

void ImTextureRef_init(ImTextureRef* self, void* tex_id) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self._TexData = null;
    self._TexID = cast(ImTextureID, cast(u64, tex_id));
}

ImTextureRef __cxx_make_ImTextureRef(void* tex_id) {
    ImTextureRef zz_mk;
    ImTextureRef_init(&zz_mk, tex_id);
    return zz_mk;
}

void ImGuiTableSortSpecs_init(ImGuiTableSortSpecs* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
}

ImGuiTableSortSpecs* __cxx_new_ImGuiTableSortSpecs(void* p) {
    ImGuiTableSortSpecs_init(cast(ImGuiTableSortSpecs*, p));
    return cast(ImGuiTableSortSpecs*, p);
}

ImGuiTableSortSpecs __cxx_make_ImGuiTableSortSpecs() {
    ImGuiTableSortSpecs zz_t;
    ImGuiTableSortSpecs_init(&zz_t);
    return zz_t;
}

void ImGuiTableColumnSortSpecs_init(ImGuiTableColumnSortSpecs* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
}

ImGuiTableColumnSortSpecs* __cxx_new_ImGuiTableColumnSortSpecs(void* p) {
    ImGuiTableColumnSortSpecs_init(cast(ImGuiTableColumnSortSpecs*, p));
    return cast(ImGuiTableColumnSortSpecs*, p);
