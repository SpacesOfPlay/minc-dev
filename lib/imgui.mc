        if g2 && g2.DebugLogFlags & ImGuiDebugLogFlags_EventFont {
        }
        if !(0 != 0) { break; }
    }
    {
        ImFontGlyph* zz_rf_it_31 = ImVector_ImFontGlyph_begin(&baked.Glyphs);
        ImFontGlyph* zz_rf_end_31 = ImVector_ImFontGlyph_end(&baked.Glyphs);
        for ; zz_rf_it_31 != zz_rf_end_31; zz_rf_it_31++ {
            ImFontGlyph* glyph = zz_rf_it_31;
            if glyph.PackId != -1 {
                ImFontAtlasPackDiscardRect(atlas, glyph.PackId);
            }
        }
    }
    var loader_data_p = cast(u8*, baked.FontLoaderDatas);
    {
        ImFontConfig** zz_rf_it_32 = ImVector_ImFontConfig_ptr_begin(&font.Sources);
        ImFontConfig** zz_rf_end_32 = ImVector_ImFontConfig_ptr_end(&font.Sources);
        for ; zz_rf_it_32 != zz_rf_end_32; zz_rf_it_32++ {
            ImFontConfig* src = *zz_rf_it_32;
            ImFontLoader* loader = src.FontLoader != null ? src.FontLoader : atlas.FontLoader;
            if loader.FontBakedDestroy != null {
                loader.FontBakedDestroy(atlas, src, baked, loader_data_p);
            }
            loader_data_p += loader.FontBakedSrcLoaderDataSize;
        }
    }
    if baked.FontLoaderDatas != null {
        ImGui_MemFree(baked.FontLoaderDatas);
        baked.FontLoaderDatas = null;
    }
    ImGuiStorage_SetVoidPtr(&builder.BakedMap, baked.BakedId, null);
    builder.BakedDiscardedCount++;
