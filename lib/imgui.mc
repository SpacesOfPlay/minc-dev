// [DEBUG] ID Stack tool: hooks called by GetID() family functions
void ImGui_DebugHookIdInfo(ImGuiID id, ImGuiDataType data_type, void* data_id, void* data_id_end) {
}

private {
i32 DebugItemPathQuery_FormatLevelInfo(ImGuiDebugItemPathQuery* query, i32 n, bool format_for_ui, u8* buf, u64 buf_size) {
    return 0;
}

u8* DebugItemPathQuery_GetResultAsPath(ImGuiDebugItemPathQuery* query, bool hex_encode_non_ascii_chars) {
    ImGuiTextBuffer* buf = &query.ResultPathBuf;
    ImGuiTextBuffer_resize(buf, 0);
    for i32 stack_n = 0; stack_n < query.Results.Size; stack_n++ {
        u8[256] level_desc;
        DebugItemPathQuery_FormatLevelInfo(query, stack_n, false, level_desc, cast(u64, cast(i32, sizeof(level_desc) / sizeof(*level_desc))));
        ImGuiTextBuffer_append(buf, stack_n == 0 ? "//" : "/", null);
        u8* p = level_desc;
        while *p != 0 {
            u32 c;
            u8* p_next = p + ImTextCharFromUtf8(&c, p, null);
            if c == 47 {
                ImGuiTextBuffer_append(buf, "\\", null);
            }
            if c < 256 || !hex_encode_non_ascii_chars {
                ImGuiTextBuffer_append(buf, p, p_next);
            } else {
                for ; p < p_next; p++ {
                    ImGuiTextBuffer_appendf(buf, "\\x%02x", cast(u8, *p));
                }
            }
            p = p_next;
        }
    }
    return ImGuiTextBuffer_c_str(buf);
}
}

// ID Stack Tool: Display UI
void ImGui_ShowIDStackToolWindow(bool* p_open) {
}

// Demo helper function to select among loaded fonts.
// Here we use the regular BeginCombo()/EndCombo() api which is the more flexible one.
void ImGui_ShowFontSelector(u8* label) {
    ImGuiIO* io = ImGui_GetIO();
    ImFont* font_current = ImGui_GetFont();
    if ImGui_BeginCombo(label, ImFont_GetDebugName(font_current), 0) != 0 {
        {
            ImFont** zz_rf_it_89 = ImVector_ImFont_ptr_begin(&io.Fonts.Fonts);
            ImFont** zz_rf_end_89 = ImVector_ImFont_ptr_end(&io.Fonts.Fonts);
            for ; zz_rf_it_89 != zz_rf_end_89; zz_rf_it_89++ {
                ImFont* font = *zz_rf_it_89;
                ImGui_PushID(cast(void*, font));
                if ImGui_Selectable(ImFont_GetDebugName(font), font == font_current, ImGuiSelectableFlags_SelectOnNav, ImVec2{0.0f, 0.0f}) != 0 {
                    io.FontDefault = font;
                }
                if font == font_current {
                    ImGui_SetItemDefaultFocus();
                }
                ImGui_PopID();
            }
        }
        ImGui_EndCombo();
    }
    ImGui_SameLine();
    if (io.BackendFlags & ImGuiBackendFlags_RendererHasTextures) != 0 {
        MetricsHelpMarker("- Load additional fonts with io.Fonts->AddFontXXX() functions.\n- Read FAQ and docs/FONTS.md for more details.");
    } else {
        MetricsHelpMarker("- Load additional fonts with io.Fonts->AddFontXXX() functions.\n- The font atlas is built when calling io.Fonts->GetTexDataAsXXXX() or io.Fonts->Build().\n- Read FAQ and docs/FONTS.md for more details.\n- Legacy backend: if you need to add/remove fonts at runtime (e.g. for DPI change), do it before calling NewFrame().");
    }
}

