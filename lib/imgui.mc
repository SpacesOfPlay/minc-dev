            f32 zero_point_snap_R = zero_point_center + zero_deadzone_halfsize;
            if cast(f32, v) == 0.0f {
                result = zero_point_center;
            } else if cast(f32, v) < 0.0f {
                result = (1.0f - cast(f32, ImLog(-cast(f64, v_clamped) / logarithmic_zero_epsilon) / ImLog(-v_min_fudged / logarithmic_zero_epsilon))) * zero_point_snap_L;
            } else {
                result = zero_point_snap_R + cast(f32, ImLog(cast(f64, v_clamped) / logarithmic_zero_epsilon) / ImLog(v_max_fudged / logarithmic_zero_epsilon)) * (1.0f - zero_point_snap_R);
            }
        } else if cast(f32, v_min) < 0.0f || cast(f32, v_max) < 0.0f {
            result = 1.0f - cast(f32, ImLog(-cast(f64, v_clamped) / -v_max_fudged) / ImLog(-v_min_fudged / -v_max_fudged));
        } else {
            result = cast(f32, ImLog(cast(f64, v_clamped) / v_min_fudged) / ImLog(v_max_fudged / v_min_fudged));
        }
        return flipped != 0 ? 1.0f - result : result;
    } else {
        return cast(f32, cast(f64, cast(ImS64, v_clamped - v_min)) / cast(f64, cast(ImS64, v_max - v_min)));
    }
}

ImU64 ImGui_ScaleValueFromRatioT_ImU64_ImS64_double(ImGuiDataType data_type, f32 t, ImU64 v_min, ImU64 v_max, f32 logarithmic_zero_epsilon, f32 zero_deadzone_halfsize) {
    if t <= 0.0f || v_min == v_max {
        return v_min;
    }
    if t >= 1.0f {
        return v_max;
    }
    var result = cast(ImU64, 0);
    if logarithmic_zero_epsilon > 0.0f {
        f64 v_min_fudged = ImAbs(cast(f64, v_min)) < logarithmic_zero_epsilon ? cast(f64, cast(f32, v_min) < 0.0f ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : cast(f64, v_min);
        f64 v_max_fudged = ImAbs(cast(f64, v_max)) < logarithmic_zero_epsilon ? cast(f64, cast(f32, v_max) < 0.0f ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon) : cast(f64, v_max);
        bool flipped = v_max < v_min;
        if flipped != 0 {
            { var zz_sw = v_min_fudged; v_min_fudged = v_max_fudged; v_max_fudged = zz_sw; }
        }
        if cast(f32, v_max) == 0.0f && cast(f32, v_min) < 0.0f {
            v_max_fudged = -logarithmic_zero_epsilon;
        }
        f32 t_with_flip = flipped != 0 ? 1.0f - t : t;
        if cast(f32, v_min * v_max) < 0.0f {
            f32 zero_point_center = -cast(f32, ImMin(cast(i32, v_min), cast(i32, v_max))) / ImAbs(cast(f32, v_max) - cast(f32, v_min));
            f32 zero_point_snap_L = zero_point_center - zero_deadzone_halfsize;
            f32 zero_point_snap_R = zero_point_center + zero_deadzone_halfsize;
            if t_with_flip >= zero_point_snap_L && t_with_flip <= zero_point_snap_R {
                result = cast(ImU64, 0.0f);
            } else if t_with_flip < zero_point_center {
                result = cast(ImU64, -(logarithmic_zero_epsilon * ImPow(-v_min_fudged / logarithmic_zero_epsilon, cast(f64, 1.0f - t_with_flip / zero_point_snap_L))));
            } else {
                result = cast(ImU64, logarithmic_zero_epsilon * ImPow(v_max_fudged / logarithmic_zero_epsilon, cast(f64, (t_with_flip - zero_point_snap_R) / (1.0f - zero_point_snap_R))));
            }
        } else if cast(f32, v_min) < 0.0f || cast(f32, v_max) < 0.0f {
            result = cast(ImU64, -(-v_max_fudged * ImPow(-v_min_fudged / -v_max_fudged, cast(f64, 1.0f - t_with_flip))));
        } else {
            result = cast(ImU64, v_min_fudged * ImPow(v_max_fudged / v_min_fudged, cast(f64, t_with_flip)));
        }
    } else {
        bool is_floating_point = data_type == ImGuiDataType_Float || data_type == ImGuiDataType_Double;
        if is_floating_point != 0 {
            result = cast(u64, ImLerp(cast(i32, v_min), cast(i32, v_max), t));
        } else if t < 1.0 {
            f64 v_new_off_f = cast(f32, cast(ImS64, v_max - v_min)) * t;
            result = cast(ImU64, cast(ImS64, v_min) + cast(ImS64, v_new_off_f + (v_min > v_max ? -0.5 : 0.5)));
        }
    }
    return result;
}

