ImVec2 op_mul_ImVec2_float(ImVec2 lhs, f32 rhs) {
    return ImVec2{lhs.x * rhs, lhs.y * rhs};
}

ImVec2 op_mul_float_ImVec2(f32 lhs, ImVec2 rhs) {
    return ImVec2{lhs * rhs.x, lhs * rhs.y};
}

ImVec2 op_div_ImVec2_float(ImVec2 lhs, f32 rhs) {
    return ImVec2{lhs.x / rhs, lhs.y / rhs};
}

ImVec2 op_add_ImVec2_ImVec2(ImVec2 lhs, ImVec2 rhs) {
    return ImVec2{lhs.x + rhs.x, lhs.y + rhs.y};
}

ImVec2 op_sub_ImVec2_ImVec2(ImVec2 lhs, ImVec2 rhs) {
    return ImVec2{lhs.x - rhs.x, lhs.y - rhs.y};
}

ImVec2 op_mul_ImVec2_ImVec2(ImVec2 lhs, ImVec2 rhs) {
    return ImVec2{lhs.x * rhs.x, lhs.y * rhs.y};
}

ImVec2 op_div_ImVec2_ImVec2(ImVec2 lhs, ImVec2 rhs) {
    return ImVec2{lhs.x / rhs.x, lhs.y / rhs.y};
}

ImVec2 op_add_ImVec2(ImVec2 lhs) {
    return lhs;
}

ImVec2 op_sub_ImVec2(ImVec2 lhs) {
    return ImVec2{-lhs.x, -lhs.y};
}

bool op_eq_ImVec2_ImVec2(ImVec2 lhs, ImVec2 rhs) {
    return lhs.x == rhs.x && lhs.y == rhs.y;
}

bool op_ne_ImVec2_ImVec2(ImVec2 lhs, ImVec2 rhs) {
    return lhs.x != rhs.x || lhs.y != rhs.y;
}

ImVec4 op_mul_ImVec4_float(ImVec4 lhs, f32 rhs) {
    return ImVec4{lhs.x * rhs, lhs.y * rhs, lhs.z * rhs, lhs.w * rhs};
}

ImVec4 op_mul_float_ImVec4(f32 lhs, ImVec4 rhs) {
    return ImVec4{lhs * rhs.x, lhs * rhs.y, lhs * rhs.z, lhs * rhs.w};
}

ImVec4 op_div_ImVec4_float(ImVec4 lhs, f32 rhs) {
    return ImVec4{lhs.x / rhs, lhs.y / rhs, lhs.z / rhs, lhs.w / rhs};
}

ImVec4 op_add_ImVec4_ImVec4(ImVec4 lhs, ImVec4 rhs) {
    return ImVec4{lhs.x + rhs.x, lhs.y + rhs.y, lhs.z + rhs.z, lhs.w + rhs.w};
}

ImVec4 op_sub_ImVec4_ImVec4(ImVec4 lhs, ImVec4 rhs) {
    return ImVec4{lhs.x - rhs.x, lhs.y - rhs.y, lhs.z - rhs.z, lhs.w - rhs.w};
}

ImVec4 op_mul_ImVec4_ImVec4(ImVec4 lhs, ImVec4 rhs) {
    return ImVec4{lhs.x * rhs.x, lhs.y * rhs.y, lhs.z * rhs.z, lhs.w * rhs.w};
}

ImVec4 op_div_ImVec4_ImVec4(ImVec4 lhs, ImVec4 rhs) {
    return ImVec4{lhs.x / rhs.x, lhs.y / rhs.y, lhs.z / rhs.z, lhs.w / rhs.w};
}

ImVec4 op_add_ImVec4(ImVec4 lhs) {
    return lhs;
}

ImVec4 op_sub_ImVec4(ImVec4 lhs) {
    return ImVec4{-lhs.x, -lhs.y, -lhs.z, -lhs.w};
}

bool op_eq_ImVec4_ImVec4(ImVec4 lhs, ImVec4 rhs) {
    return lhs.x == rhs.x && lhs.y == rhs.y && lhs.z == rhs.z && lhs.w == rhs.w;
}

bool op_ne_ImVec4_ImVec4(ImVec4 lhs, ImVec4 rhs) {
    return lhs.x != rhs.x || lhs.y != rhs.y || lhs.z != rhs.z || lhs.w != rhs.w;
}
