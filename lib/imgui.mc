// [SECTION] USER FACING STRUCTURES (ImGuiStyle, ImGuiIO, ImGuiPlatformIO)
//-----------------------------------------------------------------------------
void ImGuiStyle_init(ImGuiStyle* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    ImVec2_init(&self.WindowPadding);
    ImVec2_init(&self.WindowMinSize);
    ImVec2_init(&self.WindowTitleAlign);
    ImVec2_init(&self.FramePadding);
    ImVec2_init(&self.ItemSpacing);
    ImVec2_init(&self.ItemInnerSpacing);
    ImVec2_init(&self.CellPadding);
    ImVec2_init(&self.TouchExtraPadding);
    ImVec2_init(&self.TableAngledHeadersTextAlign);
    ImVec2_init(&self.ButtonTextAlign);
    ImVec2_init(&self.SelectableTextAlign);
    ImVec2_init(&self.SeparatorTextAlign);
    ImVec2_init(&self.SeparatorTextPadding);
    ImVec2_init(&self.DisplayWindowPadding);
    ImVec2_init(&self.DisplaySafeAreaPadding);
    self.FontSizeBase = 0.0f;
    self.FontScaleMain = 1.0f;
    self.FontScaleDpi = 1.0f;
    self.Alpha = 1.0f;
    self.DisabledAlpha = 0.6f;
    self.WindowPadding = ImVec2{8.0f, 8.0f};
    self.WindowRounding = 0.0f;
    self.WindowBorderSize = 1.0f;
    self.WindowBorderHoverPadding = 4.0f;
    self.WindowMinSize = ImVec2{32.0f, 32.0f};
    self.WindowTitleAlign = ImVec2{0.0f, 0.5f};
    self.WindowMenuButtonPosition = ImGuiDir_Left;
    self.ChildRounding = 0.0f;
    self.ChildBorderSize = 1.0f;
    self.PopupRounding = 0.0f;
    self.PopupBorderSize = 1.0f;
    self.FramePadding = ImVec2{4.0f, 3.0f};
    self.FrameRounding = 0.0f;
    self.FrameBorderSize = 0.0f;
    self.ItemSpacing = ImVec2{8.0f, 4.0f};
    self.ItemInnerSpacing = ImVec2{4.0f, 4.0f};
    self.CellPadding = ImVec2{4.0f, 2.0f};
    self.TouchExtraPadding = ImVec2{0.0f, 0.0f};
    self.IndentSpacing = 21.0f;
    self.ColumnsMinSpacing = 6.0f;
    self.ScrollbarSize = 14.0f;
    self.ScrollbarRounding = 9.0f;
    self.ScrollbarPadding = 2.0f;
    self.GrabMinSize = 12.0f;
    self.GrabRounding = 0.0f;
    self.LogSliderDeadzone = 4.0f;
    self.ImageRounding = 0.0f;
    self.ImageBorderSize = 0.0f;
    self.TabRounding = 5.0f;
    self.TabBorderSize = 0.0f;
    self.TabMinWidthBase = 1.0f;
    self.TabMinWidthShrink = 80.0f;
    self.TabCloseButtonMinWidthSelected = -1.0f;
    self.TabCloseButtonMinWidthUnselected = 0.0f;
    self.TabBarBorderSize = 1.0f;
    self.TabBarOverlineSize = 1.0f;
    self.TableAngledHeadersAngle = 35.0f * (3.141592653589793f / 180.0f);
    self.TableAngledHeadersTextAlign = ImVec2{0.5f, 0.0f};
    self.TreeLinesFlags = ImGuiTreeNodeFlags_DrawLinesNone;
    self.TreeLinesSize = 1.0f;
    self.TreeLinesRounding = 0.0f;
    self.MenuItemRounding = 0.0f;
    self.SelectableRounding = 0.0f;
    self.DragDropTargetRounding = 0.0f;
    self.DragDropTargetBorderSize = 2.0f;
    self.DragDropTargetPadding = 3.0f;
    self.ColorMarkerSize = 3.0f;
    self.ColorButtonPosition = ImGuiDir_Right;
    self.ButtonTextAlign = ImVec2{0.5f, 0.5f};
    self.SelectableTextAlign = ImVec2{0.0f, 0.0f};
    self.InputTextCursorSize = 1.0f;
    self.SeparatorSize = 1.0f;
    self.SeparatorTextBorderSize = 3.0f;
    self.SeparatorTextAlign = ImVec2{0.0f, 0.5f};
    self.SeparatorTextPadding = ImVec2{20.0f, 3.0f};
    self.DisplayWindowPadding = ImVec2{19.0f, 19.0f};
    self.DisplaySafeAreaPadding = ImVec2{3.0f, 3.0f};
    self.DockingNodeHasCloseButton = true;
    self.DockingSeparatorSize = 2.0f;
    self.MouseCursorScale = 1.0f;
    self.AntiAliasedLines = true;
    self.AntiAliasedLinesUseTex = true;
    self.AntiAliasedFill = true;
    self.CurveTessellationTol = 1.25f;
    self.CircleTessellationMaxError = 0.3f;
    self.HoverStationaryDelay = 0.15f;
    self.HoverDelayShort = 0.15f;
    self.HoverDelayNormal = 0.4f;
    self.HoverFlagsForTooltipMouse = ImGuiHoveredFlags_Stationary | ImGuiHoveredFlags_DelayShort | ImGuiHoveredFlags_AllowWhenDisabled;
    self.HoverFlagsForTooltipNav = ImGuiHoveredFlags_NoSharedDelay | ImGuiHoveredFlags_DelayNormal | ImGuiHoveredFlags_AllowWhenDisabled;
    self._MainScale = 1.0f;
    self._NextFrameFontSizeBase = 0.0f;
    ImGui_StyleColorsDark(self);
}

// Scale all spacing/padding/thickness values. Do not scale fonts.
// Consider not calling this if your initial scale factor if <1.0.
// Important: This operation is lossy because we round all sizes to integer. If you need to change your scale multiples, call this over a freshly initialized ImGuiStyle structure rather than scaling multiple times.
void ImGuiStyle_ScaleAllSizes(ImGuiStyle* self, f32 scale_factor) {
    self._MainScale *= scale_factor;
    self.WindowPadding = ImTrunc(op_mul_ImVec2_float(self.WindowPadding, scale_factor));
    self.WindowRounding = ImTrunc(self.WindowRounding * scale_factor);
    self.WindowBorderSize = ImTrunc(self.WindowBorderSize * scale_factor);
    self.WindowMinSize = ImTrunc(op_mul_ImVec2_float(self.WindowMinSize, scale_factor));
    self.WindowBorderHoverPadding = ImTrunc(self.WindowBorderHoverPadding * scale_factor);
    self.ChildRounding = ImTrunc(self.ChildRounding * scale_factor);
    self.ChildBorderSize = ImTrunc(self.ChildBorderSize * scale_factor);
    self.PopupRounding = ImTrunc(self.PopupRounding * scale_factor);
    self.PopupBorderSize = ImTrunc(self.PopupBorderSize * scale_factor);
    self.FramePadding = ImTrunc(op_mul_ImVec2_float(self.FramePadding, scale_factor));
    self.FrameBorderSize = ImTrunc(self.FrameBorderSize * scale_factor);
    self.FrameRounding = ImTrunc(self.FrameRounding * scale_factor);
    self.ItemSpacing = ImTrunc(op_mul_ImVec2_float(self.ItemSpacing, scale_factor));
    self.ItemInnerSpacing = ImTrunc(op_mul_ImVec2_float(self.ItemInnerSpacing, scale_factor));
    self.CellPadding = ImTrunc(op_mul_ImVec2_float(self.CellPadding, scale_factor));
    self.TouchExtraPadding = ImTrunc(op_mul_ImVec2_float(self.TouchExtraPadding, scale_factor));
    self.IndentSpacing = ImTrunc(self.IndentSpacing * scale_factor);
    self.ColumnsMinSpacing = ImTrunc(self.ColumnsMinSpacing * scale_factor);
    self.ScrollbarSize = ImTrunc(self.ScrollbarSize * scale_factor);
    self.ScrollbarRounding = ImTrunc(self.ScrollbarRounding * scale_factor);
    self.ScrollbarPadding = ImTrunc(self.ScrollbarPadding * scale_factor);
    self.GrabMinSize = ImTrunc(self.GrabMinSize * scale_factor);
    self.GrabRounding = ImTrunc(self.GrabRounding * scale_factor);
    self.LogSliderDeadzone = ImTrunc(self.LogSliderDeadzone * scale_factor);
    self.ImageRounding = ImTrunc(self.ImageRounding * scale_factor);
    self.ImageBorderSize = ImTrunc(self.ImageBorderSize * scale_factor);
    self.TabRounding = ImTrunc(self.TabRounding * scale_factor);
    self.TabBorderSize = ImTrunc(self.TabBorderSize * scale_factor);
    self.TabMinWidthBase = ImTrunc(self.TabMinWidthBase * scale_factor);
    self.TabMinWidthShrink = ImTrunc(self.TabMinWidthShrink * scale_factor);
    self.TabCloseButtonMinWidthSelected = self.TabCloseButtonMinWidthSelected > 0.0f && self.TabCloseButtonMinWidthSelected != FLT_MAX ? ImTrunc(self.TabCloseButtonMinWidthSelected * scale_factor) : self.TabCloseButtonMinWidthSelected;
    self.TabCloseButtonMinWidthUnselected = self.TabCloseButtonMinWidthUnselected > 0.0f && self.TabCloseButtonMinWidthUnselected != FLT_MAX ? ImTrunc(self.TabCloseButtonMinWidthUnselected * scale_factor) : self.TabCloseButtonMinWidthUnselected;
    self.TabBarBorderSize = ImTrunc(self.TabBarBorderSize * scale_factor);
    self.TabBarOverlineSize = ImTrunc(self.TabBarOverlineSize * scale_factor);
    self.TreeLinesSize = ImTrunc(self.TreeLinesSize * scale_factor);
    self.TreeLinesRounding = ImTrunc(self.TreeLinesRounding * scale_factor);
    self.MenuItemRounding = ImTrunc(self.MenuItemRounding * scale_factor);
    self.SelectableRounding = ImTrunc(self.SelectableRounding * scale_factor);
    self.DragDropTargetRounding = ImTrunc(self.DragDropTargetRounding * scale_factor);
    self.DragDropTargetBorderSize = ImTrunc(self.DragDropTargetBorderSize * scale_factor);
    self.DragDropTargetPadding = ImTrunc(self.DragDropTargetPadding * scale_factor);
    self.ColorMarkerSize = ImTrunc(self.ColorMarkerSize * scale_factor);
    self.InputTextCursorSize = ImTrunc(self.InputTextCursorSize * scale_factor);
    self.SeparatorSize = ImTrunc(self.SeparatorSize * scale_factor);
    self.SeparatorTextBorderSize = ImTrunc(self.SeparatorTextBorderSize * scale_factor);
    self.SeparatorTextPadding = ImTrunc(op_mul_ImVec2_float(self.SeparatorTextPadding, scale_factor));
    self.DockingSeparatorSize = ImTrunc(self.DockingSeparatorSize * scale_factor);
    self.DisplayWindowPadding = ImTrunc(op_mul_ImVec2_float(self.DisplayWindowPadding, scale_factor));
    self.DisplaySafeAreaPadding = ImTrunc(op_mul_ImVec2_float(self.DisplaySafeAreaPadding, scale_factor));
    self.MouseCursorScale = ImTrunc(self.MouseCursorScale * scale_factor);
}

void ImGuiIO_init(ImGuiIO* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    ImVec2_init(&self.DisplaySize);
    ImVec2_init(&self.DisplayFramebufferScale);
    ImVec2_init(&self.MouseDelta);
    ImVec2_init(&self.MousePos);
    ImVec2_init(&self.MousePosPrev);
    ImVector_ImWchar_init(&self.InputQueueCharacters);
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
    self.ConfigFlags = ImGuiConfigFlags_None;
    self.BackendFlags = ImGuiBackendFlags_None;
    self.DisplaySize = ImVec2{-1.0f, -1.0f};
    self.DeltaTime = 1.0f / 60.0f;
    self.IniSavingRate = 5.0f;
    self.IniFilename = "imgui.ini";
    self.LogFilename = "imgui_log.txt";
    self.UserData = null;
    self.Fonts = null;
    self.FontDefault = null;
    self.FontAllowUserScaling = false;
    self.DisplayFramebufferScale = ImVec2{1.0f, 1.0f};
    self.ConfigNavSwapGamepadButtons = false;
    self.ConfigNavMoveSetMousePos = false;
    self.ConfigNavCaptureKeyboard = true;
    self.ConfigNavEscapeClearFocusItem = true;
    self.ConfigNavEscapeClearFocusWindow = false;
    self.ConfigNavCursorVisibleAuto = true;
    self.ConfigNavCursorVisibleAlways = false;
    self.ConfigDockingNoSplit = false;
    self.ConfigDockingNoDockingOver = false;
    self.ConfigDockingWithShift = false;
    self.ConfigDockingAlwaysTabBar = false;
    self.ConfigDockingTransparentPayload = false;
    self.ConfigViewportsNoAutoMerge = false;
    self.ConfigViewportsNoTaskBarIcon = false;
    self.ConfigViewportsNoDecoration = true;
    self.ConfigViewportsNoDefaultParent = true;
    self.ConfigViewportsPlatformFocusSetsImGuiFocus = true;
    self.ConfigMacOSXBehaviors = false;
    self.ConfigInputTrickleEventQueue = true;
    self.ConfigInputTextCursorBlink = true;
    self.ConfigInputTextEnterKeepActive = false;
    self.ConfigDragClickToInputText = false;
    self.ConfigColorEditFlags = ImGuiColorEditFlags_DefaultOptions_;
    self.ConfigWindowsResizeFromEdges = true;
    self.ConfigWindowsMoveFromTitleBarOnly = false;
    self.ConfigWindowsCopyContentsWithCtrlC = false;
    self.ConfigScrollbarScrollByPage = true;
    self.ConfigIniSettingsSaveLastUsedDate = true;
    self.ConfigIniSettingsAutoDiscardMonths = 0;
    self.ConfigDebugIniSettings = false;
    self.MouseDrawCursor = false;
    self.ConfigMemoryCompactTimer = 60.0f;
    self.ConfigDebugIsDebuggerPresent = false;
    self.ConfigDebugHighlightIdConflicts = true;
    self.ConfigDebugHighlightIdConflictsShowItemPicker = true;
    self.ConfigDebugBeginReturnValueOnce = false;
    self.ConfigDebugBeginReturnValueLoop = false;
    self.ConfigErrorRecovery = true;
    self.ConfigErrorRecoveryEnableAssert = true;
    self.ConfigErrorRecoveryEnableDebugLog = true;
    self.ConfigErrorRecoveryEnableTooltip = true;
    self.MouseDoubleClickTime = 0.3f;
    self.MouseDoubleClickMaxDist = 6.0f;
    self.MouseSingleClickDelay = 0.5f;
    self.MouseDragThreshold = 6.0f;
    self.KeyRepeatDelay = 0.275f;
    self.KeyRepeatRate = 0.05f;
    self.BackendRendererName = null;
    self.BackendPlatformName = self.BackendRendererName;
    self.BackendLanguageUserData = null;
    self.BackendRendererUserData = self.BackendLanguageUserData;
    self.BackendPlatformUserData = self.BackendRendererUserData;
    self.MousePos = ImVec2{-FLT_MAX, -FLT_MAX};
    self.MousePosPrev = ImVec2{-FLT_MAX, -FLT_MAX};
    self.MouseSource = ImGuiMouseSource_Mouse;
    for i32 i = 0; i < cast(i32, sizeof(self.MouseDownDuration) / sizeof(*self.MouseDownDuration)); i++ {
        self.MouseDownDurationPrev[i] = -1.0f;
        self.MouseDownDuration[i] = self.MouseDownDurationPrev[i];
    }
    for i32 i = 0; i < cast(i32, sizeof(self.KeysData) / sizeof(*self.KeysData)); i++ {
        self.KeysData[i].DownDurationPrev = -1.0f;
        self.KeysData[i].DownDuration = self.KeysData[i].DownDurationPrev;
    }
    self.AppAcceptingEvents = true;
}

// Pass in translated ASCII characters for text input.
// - with glfw you can get those from the callback set in glfwSetCharCallback()
// - on Windows you can get those using ToAscii+keyboard state, or via the WM_CHAR message
// FIXME: Should in theory be called "AddCharacterEvent()" to be consistent with new API
void ImGuiIO_AddInputCharacter(ImGuiIO* self, u32 c) {
    assert(self.Ctx != null);
    ImGuiContext* g = self.Ctx;
    if c == 0 || !self.AppAcceptingEvents {
        return;
    }
    ImGuiInputEvent e;
    e.Type = ImGuiInputEventType_Text;
    e.Source = ImGuiInputSource_Keyboard;
    e.EventId = g.InputEventsNextEventId++;
    e.Text.Char = c;
    ImVector_ImGuiInputEvent_push_back(&g.InputEventsQueue, e);
}

// UTF16 strings use surrogate pairs to encode codepoints >= 0x10000, so
// we should save the high surrogate.
void ImGuiIO_AddInputCharacterUTF16(ImGuiIO* self, ImWchar16 c) {
    if c == 0 && self.InputQueueSurrogate == 0 || !self.AppAcceptingEvents {
        return;
    }
    if (c & 0xFC00) == 0xD800 {
        if self.InputQueueSurrogate != 0 {
            ImGuiIO_AddInputCharacter(self, 0xFFFD);
        }
        self.InputQueueSurrogate = c;
        return;
    }
    ImWchar cp = c;
    if self.InputQueueSurrogate != 0 {
        if (c & 0xFC00) != 0xDC00 {
            ImGuiIO_AddInputCharacter(self, 0xFFFD);
        } else {
            cp = 0xFFFD;
        }
        self.InputQueueSurrogate = 0;
    }
    ImGuiIO_AddInputCharacter(self, cast(u32, cp));
}

void ImGuiIO_AddInputCharactersUTF8(ImGuiIO* self, u8* str_var) {
    if self.AppAcceptingEvents == 0 {
        return;
    }
    u8* str_end = str_var + strlen(str_var);
    while *str_var != 0 {
        u32 c = 0;
        str_var += ImTextCharFromUtf8(&c, str_var, str_end);
        ImGuiIO_AddInputCharacter(self, c);
    }
}

// Clear all incoming events.
void ImGuiIO_ClearEventsQueue(ImGuiIO* self) {
    assert(self.Ctx != null);
    ImGuiContext* g = self.Ctx;
    ImVector_ImGuiInputEvent_clear(&g.InputEventsQueue);
}

// Clear current keyboard/gamepad state + current frame text input buffer. Equivalent to releasing all keys/buttons.
void ImGuiIO_ClearInputKeys(ImGuiIO* self) {
    ImGuiContext* g = self.Ctx;
    for i32 key = ImGuiKey_NamedKey_BEGIN; key < ImGuiKey_NamedKey_END; key++ {
        if ImGui_IsMouseKey(cast(ImGuiKey, key)) != 0 {
            continue;
        }
        ImGuiKeyData* key_data = &g.IO.KeysData[key - ImGuiKey_NamedKey_BEGIN];
        key_data.Down = false;
        key_data.DownDuration = -1.0f;
        key_data.DownDurationPrev = -1.0f;
    }
    self.KeySuper = false;
    self.KeyAlt = self.KeySuper;
    self.KeyShift = self.KeyAlt;
    self.KeyCtrl = self.KeyShift;
    self.KeyMods = ImGuiMod_None;
    ImVector_ImWchar_resize(&self.InputQueueCharacters, 0);
}

void ImGuiIO_ClearInputMouse(ImGuiIO* self) {
    for ImGuiKey key = ImGuiKey_MouseLeft; key < ImGuiKey_MouseWheelY + 1; key = cast(ImGuiKey, key + 1) {
        ImGuiKeyData* key_data = &self.KeysData[key - ImGuiKey_NamedKey_BEGIN];
        key_data.Down = false;
        key_data.DownDuration = -1.0f;
        key_data.DownDurationPrev = -1.0f;
    }
    self.MousePos = ImVec2{-FLT_MAX, -FLT_MAX};
    for i32 n = 0; n < cast(i32, sizeof(self.MouseDown) / sizeof(*self.MouseDown)); n++ {
        self.MouseDown[n] = false;
        self.MouseDownDurationPrev[n] = -1.0f;
        self.MouseDownDuration[n] = self.MouseDownDurationPrev[n];
    }
    self.MouseWheelH = 0.0f;
    self.MouseWheel = self.MouseWheelH;
}

private {
ImGuiInputEvent* FindLatestInputEvent(ImGuiContext* ctx, ImGuiInputEventType type, i32 arg) {
    ImGuiContext* g = ctx;
    for i32 n = g.InputEventsQueue.Size - 1; n >= 0; n-- {
        ImGuiInputEvent* e = &g.InputEventsQueue.Data[n];
        if e.Type != type {
            continue;
        }
        if type == ImGuiInputEventType_Key && e.Key.Key != arg {
            continue;
        }
        if type == ImGuiInputEventType_MouseButton && e.MouseButton.Button != arg {
            continue;
        }
        return e;
    }
    return null;
}
}

// Queue a new key down/up event.
// - ImGuiKey key:       Translated key (as in, generally ImGuiKey_A matches the key end-user would use to emit an 'A' character)
// - bool down:          Is the key down? use false to signify a key release.
// - float analog_value: 0.0f..1.0f
// IMPORTANT: THIS FUNCTION AND OTHER "ADD" GRABS THE CONTEXT FROM OUR INSTANCE.
// WE NEED TO ENSURE THAT ALL FUNCTION CALLS ARE FULFILLING THIS, WHICH IS WHY GetKeyData() HAS AN EXPLICIT CONTEXT.
void ImGuiIO_AddKeyAnalogEvent(ImGuiIO* self, ImGuiKey key, bool down, f32 analog_value) {
    assert(self.Ctx != null);
    if key == ImGuiKey_None || !self.AppAcceptingEvents {
        return;
    }
    ImGuiContext* g = self.Ctx;
    assert(cast(i64, ImGui_IsNamedKeyOrMod(key)));
    assert(ImGui_IsAliasKey(key) == false);
    if g.IO.ConfigMacOSXBehaviors != 0 {
        if key == ImGuiMod_Super {
            key = ImGuiMod_Ctrl;
        } else if key == ImGuiMod_Ctrl {
            key = ImGuiMod_Super;
        } else if key == ImGuiKey_LeftSuper {
            key = ImGuiKey_LeftCtrl;
        } else if key == ImGuiKey_RightSuper {
            key = ImGuiKey_RightCtrl;
        } else if key == ImGuiKey_LeftCtrl {
            key = ImGuiKey_LeftSuper;
        } else if key == ImGuiKey_RightCtrl {
            key = ImGuiKey_RightSuper;
        }
    }
    ImGuiInputEvent* latest_event = FindLatestInputEvent(g, ImGuiInputEventType_Key, key);
    ImGuiKeyData* key_data = ImGui_GetKeyData(g, key);
    bool latest_key_down = latest_event != null ? latest_event.Key.Down : key_data.Down;
    f32 latest_key_analog = latest_event != null ? latest_event.Key.AnalogValue : key_data.AnalogValue;
    if latest_key_down == down && latest_key_analog == analog_value {
        return;
    }
    ImGuiInputEvent e;
    e.Type = ImGuiInputEventType_Key;
    e.Source = ImGui_IsGamepadKey(key) != 0 ? ImGuiInputSource_Gamepad : ImGuiInputSource_Keyboard;
    e.EventId = g.InputEventsNextEventId++;
    e.Key.Key = key;
    e.Key.Down = down;
    e.Key.AnalogValue = analog_value;
    ImVector_ImGuiInputEvent_push_back(&g.InputEventsQueue, e);
}

void ImGuiIO_AddKeyEvent(ImGuiIO* self, ImGuiKey key, bool down) {
    if self.AppAcceptingEvents == 0 {
        return;
    }
    ImGuiIO_AddKeyAnalogEvent(self, key, down, down != 0 ? 1.0f : 0.0f);
}

// [Optional] Call after AddKeyEvent().
// Specify native keycode, scancode + Specify index for legacy <1.87 IsKeyXXX() functions with native indices.
// If you are writing a backend in 2022 or don't use IsKeyXXX() with native values that are not ImGuiKey values, you can avoid calling this.
void ImGuiIO_SetKeyEventNativeData(ImGuiIO* self, ImGuiKey key, i32 native_keycode, i32 native_scancode, i32 native_legacy_index) {
    if key == ImGuiKey_None {
        return;
    }
    assert(cast(i64, ImGui_IsNamedKey(key)));
    assert(native_legacy_index == -1 || ImGui_IsLegacyKey(cast(ImGuiKey, native_legacy_index)));
    ignore key;
    ignore native_keycode;
    ignore native_scancode;
    ignore native_legacy_index;
}

// Set master flag for accepting key/mouse/text events (default to true). Useful if you have native dialog boxes that are interrupting your application loop/refresh, and you want to disable events being queued while your app is frozen.
void ImGuiIO_SetAppAcceptingEvents(ImGuiIO* self, bool accepting_events) {
    self.AppAcceptingEvents = accepting_events;
}

// Queue a mouse move event
void ImGuiIO_AddMousePosEvent(ImGuiIO* self, f32 x, f32 y) {
    assert(self.Ctx != null);
    ImGuiContext* g = self.Ctx;
    if self.AppAcceptingEvents == 0 {
        return;
    }
    ImVec2 pos;
    ImVec2_init(&pos, x > cast(f32, -FLT_MAX) ? ImFloor(x) : x, y > cast(f32, -FLT_MAX) ? ImFloor(y) : y);
    ImGuiInputEvent* latest_event = FindLatestInputEvent(g, ImGuiInputEventType_MousePos);
    ImVec2 latest_pos = latest_event != null ? ImVec2{latest_event.MousePos.PosX, latest_event.MousePos.PosY} : g.IO.MousePos;
    if latest_pos.x == pos.x && latest_pos.y == pos.y {
        return;
    }
    ImGuiInputEvent e;
    e.Type = ImGuiInputEventType_MousePos;
    e.Source = ImGuiInputSource_Mouse;
    e.EventId = g.InputEventsNextEventId++;
    e.MousePos.PosX = pos.x;
    e.MousePos.PosY = pos.y;
    e.MousePos.MouseSource = g.InputEventsNextMouseSource;
    ImVector_ImGuiInputEvent_push_back(&g.InputEventsQueue, e);
}

void ImGuiIO_AddMouseButtonEvent(ImGuiIO* self, i32 mouse_button, bool down) {
    assert(self.Ctx != null);
    ImGuiContext* g = self.Ctx;
    assert(mouse_button >= 0 && mouse_button < ImGuiMouseButton_COUNT);
    if self.AppAcceptingEvents == 0 {
        return;
    }
    if self.ConfigMacOSXBehaviors && mouse_button == 0 && self.MouseCtrlLeftAsRightClick {
        mouse_button = 1;
        if down == 0 {
            self.MouseCtrlLeftAsRightClick = false;
        }
    }
    ImGuiInputEvent* latest_event = FindLatestInputEvent(g, ImGuiInputEventType_MouseButton, mouse_button);
    bool latest_button_down = latest_event != null ? latest_event.MouseButton.Down : g.IO.MouseDown[mouse_button];
    if latest_button_down == down {
        return;
    }
    if self.ConfigMacOSXBehaviors && mouse_button == 0 && down {
        ImGuiInputEvent* latest_super_event = FindLatestInputEvent(g, ImGuiInputEventType_Key, ImGuiMod_Super);
        if (latest_super_event != null ? latest_super_event.Key.Down : g.IO.KeySuper) != 0 {
            while true {
                if (g.DebugLogFlags & ImGuiDebugLogFlags_EventIO) != 0 {
                }
                if !(0 != 0) { break; }
            }
            self.MouseCtrlLeftAsRightClick = true;
            ImGuiIO_AddMouseButtonEvent(self, 1, true);
            return;
        }
    }
    ImGuiInputEvent e;
    e.Type = ImGuiInputEventType_MouseButton;
    e.Source = ImGuiInputSource_Mouse;
    e.EventId = g.InputEventsNextEventId++;
    e.MouseButton.Button = mouse_button;
    e.MouseButton.Down = down;
    e.MouseButton.MouseSource = g.InputEventsNextMouseSource;
    ImVector_ImGuiInputEvent_push_back(&g.InputEventsQueue, e);
}

// Queue a mouse wheel event (some mouse/API may only have a Y component)
void ImGuiIO_AddMouseWheelEvent(ImGuiIO* self, f32 wheel_x, f32 wheel_y) {
    assert(self.Ctx != null);
    ImGuiContext* g = self.Ctx;
    if !self.AppAcceptingEvents || wheel_x == 0.0f && wheel_y == 0.0f {
        return;
    }
    ImGuiInputEvent e;
    e.Type = ImGuiInputEventType_MouseWheel;
    e.Source = ImGuiInputSource_Mouse;
    e.EventId = g.InputEventsNextEventId++;
    e.MouseWheel.WheelX = wheel_x;
    e.MouseWheel.WheelY = wheel_y;
    e.MouseWheel.MouseSource = g.InputEventsNextMouseSource;
    ImVector_ImGuiInputEvent_push_back(&g.InputEventsQueue, e);
}

// This is not a real event, the data is latched in order to be stored in actual Mouse events.
// This is so that duplicate events (e.g. Windows sending extraneous WM_MOUSEMOVE) gets filtered and are not leading to actual source changes.
void ImGuiIO_AddMouseSourceEvent(ImGuiIO* self, ImGuiMouseSource source) {
    assert(self.Ctx != null);
    ImGuiContext* g = self.Ctx;
    g.InputEventsNextMouseSource = source;
}

void ImGuiIO_AddMouseViewportEvent(ImGuiIO* self, ImGuiID viewport_id) {
    assert(self.Ctx != null);
    ImGuiContext* g = self.Ctx;
    if self.AppAcceptingEvents == 0 {
        return;
    }
    ImGuiInputEvent* latest_event = FindLatestInputEvent(g, ImGuiInputEventType_MouseViewport);
    ImGuiID latest_viewport_id = latest_event != null ? latest_event.MouseViewport.HoveredViewportID : g.IO.MouseHoveredViewport;
    if latest_viewport_id == viewport_id {
        return;
    }
    ImGuiInputEvent e;
    e.Type = ImGuiInputEventType_MouseViewport;
    e.Source = ImGuiInputSource_Mouse;
    e.MouseViewport.HoveredViewportID = viewport_id;
    ImVector_ImGuiInputEvent_push_back(&g.InputEventsQueue, e);
}

void ImGuiIO_AddFocusEvent(ImGuiIO* self, bool focused) {
    assert(self.Ctx != null);
    ImGuiContext* g = self.Ctx;
    ImGuiInputEvent* latest_event = FindLatestInputEvent(g, ImGuiInputEventType_Focus);
    bool latest_focused = latest_event != null ? latest_event.AppFocused.Focused : !g.IO.AppFocusLost;
    if latest_focused == focused || self.ConfigDebugIgnoreFocusLoss && !focused {
        return;
    }
    ImGuiInputEvent e;
    e.Type = ImGuiInputEventType_Focus;
    e.EventId = g.InputEventsNextEventId++;
    e.AppFocused.Focused = focused;
    ImVector_ImGuiInputEvent_push_back(&g.InputEventsQueue, e);
}

void ImGuiPlatformIO_init(ImGuiPlatformIO* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    ImVector_ImGuiPlatformMonitor_init(&self.Monitors);
    ImVector_ImTextureData_ptr_init(&self.Textures);
    ImVector_ImGuiViewport_ptr_init(&self.Viewports);
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
    self.Platform_LocaleDecimalPoint = 46;
}

//-----------------------------------------------------------------------------
// [SECTION] MISC HELPERS/UTILITIES (Geometry functions)
//-----------------------------------------------------------------------------
ImVec2 ImBezierCubicClosestPoint(ImVec2 p1, ImVec2 p2, ImVec2 p3, ImVec2 p4, ImVec2 p, i32 num_segments) {
    assert(num_segments > 0);
    ImVec2 p_last = p1;
    ImVec2 p_closest;
    f32 p_closest_dist2 = FLT_MAX;
    f32 t_step = 1.0f / cast(f32, num_segments);
    for i32 i_step = 1; i_step <= num_segments; i_step++ {
        ImVec2 p_current = ImBezierCubicCalc(p1, p2, p3, p4, t_step * cast(f32, i_step));
        ImVec2 p_line = ImLineClosestPoint(p_last, p_current, p);
        f32 dist2 = ImLengthSqr(op_sub_ImVec2_ImVec2(p, p_line));
        if dist2 < p_closest_dist2 {
            p_closest = p_line;
            p_closest_dist2 = dist2;
        }
        p_last = p_current;
    }
    return p_closest;
}

// Closely mimics PathBezierToCasteljau() in imgui_draw.cpp
private {
void ImBezierCubicClosestPointCasteljauStep(ImVec2 p, ImVec2* p_closest, ImVec2* p_last, f32* p_closest_dist2, f32 x1, f32 y1, f32 x2, f32 y2, f32 x3, f32 y3, f32 x4, f32 y4, f32 tess_tol, i32 level) {
    f32 dx = x4 - x1;
    f32 dy = y4 - y1;
    f32 d2 = (x2 - x4) * dy - (y2 - y4) * dx;
    f32 d3 = (x3 - x4) * dy - (y3 - y4) * dx;
    d2 = d2 >= 0.0f ? d2 : -d2;
    d3 = d3 >= 0.0f ? d3 : -d3;
    if (d2 + d3) * (d2 + d3) < tess_tol * (dx * dx + dy * dy) {
        ImVec2 p_current;
        ImVec2_init(&p_current, x4, y4);
        ImVec2 p_line = ImLineClosestPoint(*p_last, p_current, p);
        f32 dist2 = ImLengthSqr(op_sub_ImVec2_ImVec2(p, p_line));
        if dist2 < *p_closest_dist2 {
            *p_closest = p_line;
            *p_closest_dist2 = dist2;
        }
        *p_last = p_current;
    } else if level < 10 {
        f32 x12 = (x1 + x2) * 0.5f;
        f32 y12 = (y1 + y2) * 0.5f;
        f32 x23 = (x2 + x3) * 0.5f;
        f32 y23 = (y2 + y3) * 0.5f;
        f32 x34 = (x3 + x4) * 0.5f;
        f32 y34 = (y3 + y4) * 0.5f;
        f32 x123 = (x12 + x23) * 0.5f;
        f32 y123 = (y12 + y23) * 0.5f;
        f32 x234 = (x23 + x34) * 0.5f;
        f32 y234 = (y23 + y34) * 0.5f;
        f32 x1234 = (x123 + x234) * 0.5f;
        f32 y1234 = (y123 + y234) * 0.5f;
        ImBezierCubicClosestPointCasteljauStep(p, p_closest, p_last, p_closest_dist2, x1, y1, x12, y12, x123, y123, x1234, y1234, tess_tol, level + 1);
        ImBezierCubicClosestPointCasteljauStep(p, p_closest, p_last, p_closest_dist2, x1234, y1234, x234, y234, x34, y34, x4, y4, tess_tol, level + 1);
    }
}
}

// tess_tol is generally the same value you would find in ImGui::GetStyle().CurveTessellationTol
// Because those ImXXX functions are lower-level than ImGui:: we cannot access this value automatically.
ImVec2 ImBezierCubicClosestPointCasteljau(ImVec2 p1, ImVec2 p2, ImVec2 p3, ImVec2 p4, ImVec2 p, f32 tess_tol) {
    assert(tess_tol > 0.0f);
    ImVec2 p_last = p1;
    ImVec2 p_closest;
    f32 p_closest_dist2 = FLT_MAX;
    ImBezierCubicClosestPointCasteljauStep(p, &p_closest, &p_last, &p_closest_dist2, p1.x, p1.y, p2.x, p2.y, p3.x, p3.y, p4.x, p4.y, tess_tol, 0);
    return p_closest;
}

ImVec2 ImLineClosestPoint(ImVec2 a, ImVec2 b, ImVec2 p) {
    ImVec2 ap = op_sub_ImVec2_ImVec2(p, a);
    ImVec2 ab_dir = op_sub_ImVec2_ImVec2(b, a);
    f32 dot = ap.x * ab_dir.x + ap.y * ab_dir.y;
    if dot < 0.0f {
        return a;
    }
    f32 ab_len_sqr = ab_dir.x * ab_dir.x + ab_dir.y * ab_dir.y;
    if dot > ab_len_sqr {
        return b;
    }
    return op_add_ImVec2_ImVec2(a, op_div_ImVec2_float(op_mul_ImVec2_float(ab_dir, dot), ab_len_sqr));
}

bool ImTriangleContainsPoint(ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 p) {
    bool b1 = (p.x - b.x) * (a.y - b.y) - (p.y - b.y) * (a.x - b.x) < 0.0f;
    bool b2 = (p.x - c.x) * (b.y - c.y) - (p.y - c.y) * (b.x - c.x) < 0.0f;
    bool b3 = (p.x - a.x) * (c.y - a.y) - (p.y - a.y) * (c.x - a.x) < 0.0f;
    return b1 == b2 && b2 == b3;
}

void ImTriangleBarycentricCoords(ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 p, f32* out_u, f32* out_v, f32* out_w) {
    ImVec2 v0 = op_sub_ImVec2_ImVec2(b, a);
    ImVec2 v1 = op_sub_ImVec2_ImVec2(c, a);
    ImVec2 v2 = op_sub_ImVec2_ImVec2(p, a);
    f32 denom = v0.x * v1.y - v1.x * v0.y;
    *out_v = (v2.x * v1.y - v1.x * v2.y) / denom;
    *out_w = (v0.x * v2.y - v2.x * v0.y) / denom;
    *out_u = 1.0f - *out_v - *out_w;
}

ImVec2 ImTriangleClosestPoint(ImVec2 a, ImVec2 b, ImVec2 c, ImVec2 p) {
    ImVec2 proj_ab = ImLineClosestPoint(a, b, p);
    ImVec2 proj_bc = ImLineClosestPoint(b, c, p);
    ImVec2 proj_ca = ImLineClosestPoint(c, a, p);
    f32 dist2_ab = ImLengthSqr(op_sub_ImVec2_ImVec2(p, proj_ab));
    f32 dist2_bc = ImLengthSqr(op_sub_ImVec2_ImVec2(p, proj_bc));
    f32 dist2_ca = ImLengthSqr(op_sub_ImVec2_ImVec2(p, proj_ca));
    f32 m = ImMin(dist2_ab, ImMin(dist2_bc, dist2_ca));
    if m == dist2_ab {
        return proj_ab;
    }
    if m == dist2_bc {
        return proj_bc;
    }
    return proj_ca;
}

//-----------------------------------------------------------------------------
// [SECTION] MISC HELPERS/UTILITIES (String, Format, Hash functions)
//-----------------------------------------------------------------------------
// Consider using _stricmp/_strnicmp under Windows or strcasecmp/strncasecmp. We don't actually use either ImStricmp/ImStrnicmp in the codebase any more.
i32 ImStricmp(u8* str1, u8* str2) {
    i32 d;
    while true {
        d = cast(i32, ImToUpper(*str2) - ImToUpper(*str1));
        if d == 0 == 0 {
            break;
        }
        if *str1 == 0 {
            break;
        }
        str1++;
        str2++;
    }
    return d;
}

i32 ImStrnicmp(u8* str1, u8* str2, u64 count) {
    i32 d = 0;
    while count > 0 {
        d = cast(i32, ImToUpper(*str2) - ImToUpper(*str1));
        if d == 0 == 0 {
            break;
        }
        if *str1 == 0 {
            break;
        }
        str1++;
        str2++;
        count--;
    }
    return d;
}

void ImStrncpy(u8* dst, u8* src, u64 count) {
    if count < 1 {
        return;
    }
    if count > 1 {
        strncpy(dst, src, count - 1);
    }
    dst[count - 1] = 0;
}

u8* ImStrdup(u8* str_var) {
    u64 len = strlen(str_var);
    void* buf = ImGui_MemAlloc(len + 1);
    memcpy(buf, cast(void*, str_var), len + 1);
    return cast(u8*, buf);
}

void* ImMemdup(void* src, u64 size) {
    void* dst = ImGui_MemAlloc(size);
    memcpy(dst, src, size);
    return dst;
}

u8* ImStrdupcpy(u8* dst, u64* p_dst_size, u8* src) {
    u64 dst_buf_size = p_dst_size != null ? *p_dst_size : strlen(dst) + 1;
    u64 src_size = strlen(src) + 1;
    if dst_buf_size < src_size {
        ImGui_MemFree(dst);
        dst = cast(u8*, ImGui_MemAlloc(src_size));
        if p_dst_size != null {
            *p_dst_size = src_size;
        }
    }
    memcpy(dst, cast(void*, src), src_size);
    return dst;
}

u8* ImStrchrRange(u8* str_var, u8* str_end, u8 c) {
    var p = cast(u8*, memchr(str_var, cast(i32, c), cast(i64, str_end - str_var)));
    return p;
}

i32 ImStrlenW(ImWchar* str_var) {
    i32 n = 0;
    while *str_var++ != 0 {
        n++;
    }
    return n;
}

// Find end-of-line. Return pointer will point to either first \n, either str_end.
u8* ImStreolRange(u8* str_var, u8* str_end) {
    var p = cast(u8*, memchr(str_var, 10, cast(i64, str_end - str_var)));
    return p != null ? p : str_end;
}

u8* ImStrbol(u8* buf_mid_line, u8* buf_begin) {
    while buf_mid_line > buf_begin && buf_mid_line[-1] != 10 {
        buf_mid_line--;
    }
    return buf_mid_line;
}

u8* ImStristr(u8* haystack, u8* haystack_end, u8* needle, u8* needle_end) {
    if needle_end == null {
        needle_end = needle + strlen(needle);
    }
    var un0 = ImToUpper(*needle);
    while !haystack_end && *haystack || haystack_end && haystack < haystack_end {
        if ImToUpper(*haystack) == un0 {
            u8* b = needle + 1;
            for u8* a = haystack + 1; b < needle_end; a++ {
                if ImToUpper(*a) != ImToUpper(*b) {
                    break;
                }
                b++;
            }
            if b == needle_end {
                return haystack;
            }
        }
        haystack++;
    }
    return null;
}

// Trim str by offsetting contents when there's leading data + writing a \0 at the trailing position. We use this in situation where the cost is negligible.
void ImStrTrimBlanks(u8* buf) {
    u8* p = buf;
    while p[0] == 32 || p[0] == 9 {
        p++;
    }
    u8* p_start = p;
    while *p != 0 {
        p++;
    }
    while p > p_start && (p[-1] == 32 || p[-1] == 9) {
        p--;
    }
    if p_start != buf {
        memmove(buf, p_start, cast(u64, cast(i64, p - p_start)));
    }
    buf[cast(i64, p - p_start)] = 0;
}

u8* ImStrSkipBlank(u8* str_var) {
    while str_var[0] == 32 || str_var[0] == 9 {
        str_var++;
    }
    return str_var;
}
// A) MSVC version appears to return -1 on overflow, whereas glibc appears to return total count (which may be >= buf_size).
// Ideally we would test for only one of those limits at runtime depending on the behavior the vsnprintf(), but trying to deduct it at compile time sounds like a pandora can of worm.
// B) When buf==NULL vsnprintf() will return the output size.
when !(defined(IMGUI_DISABLE_DEFAULT_FORMAT_FUNCTIONS)) {

i32 ImFormatString(u8* buf, u64 buf_size, u8* fmt, ...) {
    i32 w = vsnprintf(buf, buf_size, fmt, &...);
    if buf == null {
        return w;
    }
    if w == -1 || w >= cast(i32, buf_size) {
        w = cast(i32, buf_size) - 1;
    }
    buf[w] = 0;
    return w;
}

i32 ImFormatStringV(u8* buf, u64 buf_size, u8* fmt, void* args) {
    i32 w = vsnprintf(buf, buf_size, fmt, cast(&..., args));
    if buf == null {
        return w;
    }
    if w == -1 || w >= cast(i32, buf_size) {
        w = cast(i32, buf_size) - 1;
    }
    buf[w] = 0;
    return w;
}
}

void ImFormatStringToTempBuffer(u8** out_buf, u8** out_buf_end, u8* fmt, ...) {
    ImFormatStringToTempBufferV(out_buf, out_buf_end, fmt, cast(void*, &...));
}

// FIXME: Should rework API toward allowing multiple in-flight temp buffers (easier and safer for caller)
// by making the caller acquire a temp buffer token, with either explicit or destructor release, e.g.
//  ImGuiTempBufferToken token;
//  ImFormatStringToTempBuffer(token, ...);
void ImFormatStringToTempBufferV(u8** out_buf, u8** out_buf_end, u8* fmt, void* args) {
    ImGuiContext* g = GImGui;
    i32 buf_len = ImFormatStringV(g.TempBuffer.Data, cast(u64, g.TempBuffer.Size), fmt, args);
    *out_buf = g.TempBuffer.Data;
    if out_buf_end != null { *out_buf_end = g.TempBuffer.Data + buf_len; }
}
