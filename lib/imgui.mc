ImGuiStyleVarInfo* ImGui_GetStyleVarInfo(ImGuiStyleVar idx) {
    assert(idx >= 0 && idx < ImGuiStyleVar_COUNT);
    return &GStyleVarsInfo[idx];
}

void ImGui_PushStyleVar(ImGuiStyleVar idx, f32 val) {
    ImGuiContext* g = GImGui;
    ImGuiStyleVarInfo* var_info = ImGui_GetStyleVarInfo(idx);
    while true {
        if (var_info.DataType == ImGuiDataType_Float && var_info.Count == 1) == 0 {
            if ImGui_ErrorLog("Calling PushStyleVar() variant with wrong type!") != 0 {
                assert(var_info.DataType == ImGuiDataType_Float && var_info.Count == 1 && "Calling PushStyleVar() variant with wrong type!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    var pvar = cast(f32*, ImGuiStyleVarInfo_GetVarPtr(var_info, &g.Style));
    ImVector_ImGuiStyleMod_push_back(&g.StyleVarStack, __cxx_make_ImGuiStyleMod(idx, *pvar));
    *pvar = val;
}

void ImGui_PushStyleVarX(ImGuiStyleVar idx, f32 val_x) {
    ImGuiContext* g = GImGui;
    ImGuiStyleVarInfo* var_info = ImGui_GetStyleVarInfo(idx);
    while true {
        if (var_info.DataType == ImGuiDataType_Float && var_info.Count == 2) == 0 {
            if ImGui_ErrorLog("Calling PushStyleVar() variant with wrong type!") != 0 {
                assert(var_info.DataType == ImGuiDataType_Float && var_info.Count == 2 && "Calling PushStyleVar() variant with wrong type!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    var pvar = cast(ImVec2*, ImGuiStyleVarInfo_GetVarPtr(var_info, &g.Style));
    ImVector_ImGuiStyleMod_push_back(&g.StyleVarStack, __cxx_make_ImGuiStyleMod(idx, *pvar));
    pvar.x = val_x;
}

void ImGui_PushStyleVarY(ImGuiStyleVar idx, f32 val_y) {
    ImGuiContext* g = GImGui;
    ImGuiStyleVarInfo* var_info = ImGui_GetStyleVarInfo(idx);
    while true {
        if (var_info.DataType == ImGuiDataType_Float && var_info.Count == 2) == 0 {
            if ImGui_ErrorLog("Calling PushStyleVar() variant with wrong type!") != 0 {
                assert(var_info.DataType == ImGuiDataType_Float && var_info.Count == 2 && "Calling PushStyleVar() variant with wrong type!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    var pvar = cast(ImVec2*, ImGuiStyleVarInfo_GetVarPtr(var_info, &g.Style));
    ImVector_ImGuiStyleMod_push_back(&g.StyleVarStack, __cxx_make_ImGuiStyleMod(idx, *pvar));
    pvar.y = val_y;
}

void ImGui_PushStyleVar(ImGuiStyleVar idx, ImVec2 val) {
    ImGuiContext* g = GImGui;
    ImGuiStyleVarInfo* var_info = ImGui_GetStyleVarInfo(idx);
    while true {
        if (var_info.DataType == ImGuiDataType_Float && var_info.Count == 2) == 0 {
            if ImGui_ErrorLog("Calling PushStyleVar() variant with wrong type!") != 0 {
                assert(var_info.DataType == ImGuiDataType_Float && var_info.Count == 2 && "Calling PushStyleVar() variant with wrong type!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    var pvar = cast(ImVec2*, ImGuiStyleVarInfo_GetVarPtr(var_info, &g.Style));
    ImVector_ImGuiStyleMod_push_back(&g.StyleVarStack, __cxx_make_ImGuiStyleMod(idx, *pvar));
    *pvar = val;
}

void ImGui_PopStyleVar(i32 count) {
    ImGuiContext* g = GImGui;
    if g.StyleVarStack.Size < count {
        while true {
            if 0 == 0 {
                if ImGui_ErrorLog("Calling PopStyleVar() too many times!") != 0 {
                    assert(0 && "Calling PopStyleVar() too many times!");
                }
            }
            if !(0 != 0) { break; }
        }
        count = g.StyleVarStack.Size;
    }
    while count > 0 {
        ImGuiStyleMod* backup = ImVector_ImGuiStyleMod_back(&g.StyleVarStack);
        ImGuiStyleVarInfo* var_info = ImGui_GetStyleVarInfo(backup.VarIdx);
        void* data = ImGuiStyleVarInfo_GetVarPtr(var_info, &g.Style);
        if var_info.DataType == ImGuiDataType_Float && var_info.Count == 1 {
            cast(f32*, data)[0] = backup.BackupFloat[0];
        } else if var_info.DataType == ImGuiDataType_Float && var_info.Count == 2 {
            cast(f32*, data)[0] = backup.BackupFloat[0];
            cast(f32*, data)[1] = backup.BackupFloat[1];
        }
        ImVector_ImGuiStyleMod_pop_back(&g.StyleVarStack);
        count--;
    }
}

