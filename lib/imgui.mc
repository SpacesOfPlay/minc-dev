void ImGuiTextIndex_clear(ImGuiTextIndex* self) {
    ImVector_int_clear(&self.Offsets);
    self.EndOffset = 0;
}

i32 ImGuiTextIndex_size(ImGuiTextIndex* self) {
    return self.Offsets.Size;
}

u8* ImGuiTextIndex_get_line_begin(ImGuiTextIndex* self, u8* base, i32 n) {
    return base + (self.Offsets.Size != 0 ? self.Offsets.Data[n] : 0);
}

u8* ImGuiTextIndex_get_line_end(ImGuiTextIndex* self, u8* base, i32 n) {
    return base + (n + 1 < self.Offsets.Size ? self.Offsets.Data[n + 1] - 1 : self.EndOffset);
}

