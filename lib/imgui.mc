    ImVec2_init(&self.WorkInsetMax);
    ImVec2_init(&self.BuildWorkInsetMin);
    ImVec2_init(&self.BuildWorkInsetMax);
    self.Window = null;
    self.Idx = -1;
    self.LastFocusedStampCount = -1;
    self.LastFrameActive = self.LastFocusedStampCount;
    self.BgFgDrawListsLastTimeActive[1] = -1.0f;
    self.BgFgDrawListsLastTimeActive[0] = self.BgFgDrawListsLastTimeActive[1];
    self.LastNameHash = 0;
    self.LastAlpha = 1.0f;
    self.Alpha = self.LastAlpha;
    self.LastFocusedHadNavWindow = false;
    self.PlatformMonitor = -1;
    self.BgFgDrawLists[1] = null;
    self.BgFgDrawLists[0] = self.BgFgDrawLists[1];
    self.LastRendererSize = ImVec2{FLT_MAX, FLT_MAX};
    self.LastPlatformSize = self.LastRendererSize;
    self.LastPlatformPos = self.LastPlatformSize;
