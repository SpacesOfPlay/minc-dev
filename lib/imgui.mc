private {
f32 GetColumnWidthEx(ImGuiOldColumns* columns, i32 column_index) {
    return GetColumnWidthEx(columns, column_index, false);
}
}

f32 ImGui_GetColumnWidth() {
    return ImGui_GetColumnWidth(-1);
}

void ImGui_BeginColumns(u8* str_id, i32 columns_count) {
    ImGui_BeginColumns(str_id, columns_count, 0);
}

void ImGui_Columns() {
    ImGui_Columns(1, null, true);
}

