void ImDrawList_PathClear(ImDrawList* self) {
    self._Path.Size = 0;
}

void ImDrawList_PathLineTo(ImDrawList* self, ImVec2 pos) {
    ImVector_ImVec2_push_back(&self._Path, pos);
}

void ImDrawList_PathLineToMergeDuplicate(ImDrawList* self, ImVec2 pos) {
    if self._Path.Size == 0 || memcmp(&self._Path.Data[self._Path.Size - 1], &pos, cast(u64, 8)) != 0 {
        ImVector_ImVec2_push_back(&self._Path, pos);
    }
}

void ImDrawList_PathFillConvex(ImDrawList* self, ImU32 col) {
    ImDrawList_AddConvexPolyFilled(self, self._Path.Data, self._Path.Size, col);
    self._Path.Size = 0;
}

void ImDrawList_PathFillConcave(ImDrawList* self, ImU32 col) {
    ImDrawList_AddConcavePolyFilled(self, self._Path.Data, self._Path.Size, col);
    self._Path.Size = 0;
}

void ImDrawList_PathStroke(ImDrawList* self, ImU32 col, f32 thickness, ImDrawFlags flags) {
    ImDrawList_AddPolyline(self, self._Path.Data, self._Path.Size, col, thickness, flags);
    self._Path.Size = 0;
}

void ImDrawList_ChannelsSplit(ImDrawList* self, i32 count) {
    ImDrawListSplitter_Split(&self._Splitter, self, count);
}

void ImDrawList_ChannelsMerge(ImDrawList* self) {
    ImDrawListSplitter_Merge(&self._Splitter, self);
}

void ImDrawList_ChannelsSetCurrent(ImDrawList* self, i32 n) {
    ImDrawListSplitter_SetCurrentChannel(&self._Splitter, self, n);
}

void ImDrawList_PrimWriteVtx(ImDrawList* self, ImVec2 pos, ImVec2 uv, ImU32 col) {
    self._VtxWritePtr.pos = pos;
    self._VtxWritePtr.uv = uv;
    self._VtxWritePtr.col = col;
    self._VtxWritePtr++;
    self._VtxCurrentIdx++;
}

void ImDrawList_PrimWriteIdx(ImDrawList* self, ImDrawIdx idx) {
    *self._IdxWritePtr = idx;
    self._IdxWritePtr++;
}

void ImDrawList_PrimVtx(ImDrawList* self, ImVec2 pos, ImVec2 uv, ImU32 col) {
    ImDrawList_PrimWriteIdx(self, cast(ImDrawIdx, self._VtxCurrentIdx));
    ImDrawList_PrimWriteVtx(self, pos, uv, col);
}

