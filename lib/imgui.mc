f32 ImGui_ScaleRatioFromValueT_float_float_float(ImGuiDataType data_type, f32 v, f32 v_min, f32 v_max, f32 logarithmic_zero_epsilon, f32 zero_deadzone_halfsize) {
    if v_min == v_max {
        return 0.0f;
    }
    ignore data_type;
    f32 v_clamped = v_min < v_max ? ImClamp(v, v_min, v_max) : ImClamp(v, v_max, v_min);
    if logarithmic_zero_epsilon > 0.0f {
        bool flipped = v_max < v_min;
        if flipped != 0 {
            { var zz_sw = v_min; v_min = v_max; v_max = zz_sw; }
        }
        f32 v_min_fudged = ImAbs(v_min) < logarithmic_zero_epsilon ? v_min < 0.0f ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon : v_min;
        f32 v_max_fudged = ImAbs(v_max) < logarithmic_zero_epsilon ? v_max < 0.0f ? -logarithmic_zero_epsilon : logarithmic_zero_epsilon : v_max;
        if v_min == 0.0f && v_max < 0.0f {
            v_min_fudged = -logarithmic_zero_epsilon;
        } else if v_max == 0.0f && v_min < 0.0f {
            v_max_fudged = -logarithmic_zero_epsilon;
        }
        f32 result;
        if v_clamped <= v_min_fudged {
            result = 0.0f;
        } else if v_clamped >= v_max_fudged {
            result = 1.0f;
        } else if v_min * v_max < 0.0f {
            f32 zero_point_center = -v_min / (v_max - v_min);
            f32 zero_point_snap_L = zero_point_center - zero_deadzone_halfsize;
            f32 zero_point_snap_R = zero_point_center + zero_deadzone_halfsize;
            if v == 0.0f {
                result = zero_point_center;
            } else if v < 0.0f {
                result = (1.0f - ImLog(-v_clamped / logarithmic_zero_epsilon) / ImLog(-v_min_fudged / logarithmic_zero_epsilon)) * zero_point_snap_L;
            } else {
                result = zero_point_snap_R + ImLog(v_clamped / logarithmic_zero_epsilon) / ImLog(v_max_fudged / logarithmic_zero_epsilon) * (1.0f - zero_point_snap_R);
            }
        } else if v_min < 0.0f || v_max < 0.0f {
            result = 1.0f - ImLog(-v_clamped / -v_max_fudged) / ImLog(-v_min_fudged / -v_max_fudged);
        } else {
            result = ImLog(v_clamped / v_min_fudged) / ImLog(v_max_fudged / v_min_fudged);
        }
        return flipped != 0 ? 1.0f - result : result;
    } else {
        return (v_clamped - v_min) / (v_max - v_min);
    }
}

