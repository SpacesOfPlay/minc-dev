private {
i32 TABLE_DRAW_CHANNEL_BG0 = 0;
i32 TABLE_DRAW_CHANNEL_BG2_FROZEN = 1;
i32 TABLE_DRAW_CHANNEL_NOCLIP = 2;
// When using ImGuiTableFlags_NoClip (this becomes the last visible channel)
f32 TABLE_BORDER_SIZE = 1.0f;
// FIXME-TABLE: Currently hard-coded because of clipping assumptions with outer borders rendering.
f32 TABLE_RESIZE_SEPARATOR_HALF_THICKNESS = 4.0f;
// Extend outside inner borders.
f32 TABLE_RESIZE_SEPARATOR_FEEDBACK_TIMER = 0.06f;
}

ImGuiTableFlags TableFixFlags(ImGuiTableFlags flags, ImGuiWindow* outer_window) {
    if (flags & ImGuiTableFlags_SizingMask_) == 0 {
        flags |= flags & ImGuiTableFlags_ScrollX || outer_window.Flags & ImGuiWindowFlags_AlwaysAutoResize ? ImGuiTableFlags_SizingFixedFit : ImGuiTableFlags_SizingStretchSame;
    }
    if (flags & ImGuiTableFlags_SizingMask_) == ImGuiTableFlags_SizingFixedSame {
        flags |= ImGuiTableFlags_NoKeepColumnsVisible;
    }
    if (flags & ImGuiTableFlags_Resizable) != 0 {
        flags |= ImGuiTableFlags_BordersInnerV;
    }
    if (flags & (ImGuiTableFlags_ScrollX | ImGuiTableFlags_ScrollY)) != 0 {
        flags &= ~(ImGuiTableFlags_NoHostExtendX | ImGuiTableFlags_NoHostExtendY);
    }
    if (flags & ImGuiTableFlags_NoBordersInBodyUntilResize) != 0 {
        flags &= ~ImGuiTableFlags_NoBordersInBody;
    }
    if (flags & (ImGuiTableFlags_Resizable | ImGuiTableFlags_Hideable | ImGuiTableFlags_Reorderable | ImGuiTableFlags_Sortable)) == 0 {
        flags |= ImGuiTableFlags_NoSavedSettings;
    }
    if (outer_window.RootWindow.Flags & ImGuiWindowFlags_NoSavedSettings) != 0 {
        flags |= ImGuiTableFlags_NoSavedSettings;
    }
    return flags;
}

ImGuiTable* ImGui_TableFindByID(ImGuiID id) {
    ImGuiContext* g = GImGui;
    return ImPool_ImGuiTable_GetByKey(&g.Tables, id);
}

// Read about "TABLE SIZING" at the top of this file.
bool ImGui_BeginTable(u8* str_id, i32 columns_count, ImGuiTableFlags flags, ImVec2 outer_size, f32 inner_width) {
    ImGuiID id = ImGui_GetID(str_id);
    return ImGui_BeginTableEx(str_id, id, columns_count, flags, outer_size, inner_width);
}

bool ImGui_BeginTableEx(u8* name, ImGuiID id, i32 columns_count, ImGuiTableFlags flags, ImVec2 outer_size, f32 inner_width) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* outer_window = ImGui_GetCurrentWindow();
    if outer_window.SkipItems != 0 {
        return false;
    }
    assert(columns_count > 0 && columns_count < 512);
    if (flags & ImGuiTableFlags_ScrollX) != 0 {
        assert(inner_width >= 0.0f);
    }
    bool use_child_window = (flags & (ImGuiTableFlags_ScrollX | ImGuiTableFlags_ScrollY)) != 0;
    ImVec2 avail_size = ImGui_GetContentRegionAvail();
    ImVec2 actual_outer_size = ImTrunc(ImGui_CalcItemSize(outer_size, ImMax(avail_size.x, 4.0f), use_child_window != 0 ? ImMax(avail_size.y, 4.0f) : 0.0f));
    ImRect outer_rect;
    ImRect_init(&outer_rect, outer_window.DC.CursorPos, op_add_ImVec2_ImVec2(outer_window.DC.CursorPos, actual_outer_size));
    bool outer_window_is_measuring_size = outer_window.AutoFitFramesX > 0 || outer_window.AutoFitFramesY > 0;
    if use_child_window && ImGui_IsClippedEx(outer_rect, 0) && !outer_window_is_measuring_size {
        ImGui_ItemSize(outer_rect);
        ImGui_ItemAdd(outer_rect, id, null, 0);
        ImGuiNextWindowData_ClearFlags(&g.NextWindowData);
        return false;
    }
    if g.DebugBreakInTable == id {
        assert(0);
    }
    ImGuiTable* table = ImPool_ImGuiTable_GetOrAddByKey(&g.Tables, id);
    i32 table_idx = ImPool_ImGuiTable_GetIndex(&g.Tables, table);
    if ++g.TablesTempDataStacked > g.TablesTempData.Size {
        ImVector_ImGuiTableTempData_resize(&g.TablesTempData, g.TablesTempDataStacked, __cxx_make_ImGuiTableTempData());
    }
    table.TempData = &g.TablesTempData.Data[g.TablesTempDataStacked - 1];
    ImGuiTableTempData* temp_data = table.TempData;
    temp_data.TableIndex = table_idx;
    ImVector_ImGuiTableReconcileColumnData_resize(&temp_data.ReconcileColumnsRequests, 0);
    table.DrawSplitter = &table.TempData.DrawSplitter;
    ImDrawListSplitter_Clear(table.DrawSplitter);
    table.IsDefaultSizingPolicy = (flags & ImGuiTableFlags_SizingMask_) == 0;
    flags = TableFixFlags(flags, outer_window);
    i32 previous_frame_active = table.LastFrameActive;
    i32 instance_no = previous_frame_active != g.FrameCount ? 0 : table.InstanceCurrent + 1;
    ImGuiTableFlags previous_flags = table.Flags;
    bool is_new_table = previous_frame_active == -1;
    table.ID = id;
    table.Flags = flags;
    table.LastFrameActive = g.FrameCount;
    table.InnerWindow = outer_window;
    table.OuterWindow = table.InnerWindow;
    table.ColumnsCount = columns_count;
    table.IsLayoutLocked = false;
    table.InnerWidth = inner_width;
    table.NavLayer = cast(ImS8, outer_window.DC.NavLayerCurrent);
    temp_data.UserOuterSize = outer_size;
    ImGuiID instance_id;
    table.InstanceCurrent = cast(ImS16, instance_no);
    if instance_no > 0 {
        assert(table.ColumnsCount == columns_count && "BeginTable(): Cannot change columns count mid-frame while preserving same ID");
        if table.InstanceDataExtra.Size < instance_no {
            ImVector_ImGuiTableInstanceData_push_back(&table.InstanceDataExtra, __cxx_make_ImGuiTableInstanceData());
        }
        instance_id = ImGui_GetIDWithSeed(instance_no, ImGui_GetIDWithSeed("##Instances", null, id));
    } else {
        instance_id = id;
    }
    ImGuiTableInstanceData* table_instance = ImGui_TableGetInstanceData(table, table.InstanceCurrent);
    table_instance.TableInstanceID = instance_id;
    if use_child_window != 0 {
        ImVec2 override_content_size;
        ImVec2_init(&override_content_size, FLT_MAX, FLT_MAX);
        if flags & ImGuiTableFlags_ScrollX && !(flags & ImGuiTableFlags_ScrollY) {
            override_content_size.y = FLT_MIN;
        }
        if flags & ImGuiTableFlags_ScrollX && inner_width > 0.0f {
            override_content_size.x = inner_width;
        }
        if override_content_size.x != FLT_MAX || override_content_size.y != FLT_MAX {
            ImGui_SetNextWindowContentSize(ImVec2{
                override_content_size.x != FLT_MAX ? override_content_size.x : 0.0f,
                override_content_size.y != FLT_MAX ? override_content_size.y : 0.0f,
            });
        }
        if (previous_flags & (ImGuiTableFlags_ScrollX | ImGuiTableFlags_ScrollY)) == 0 {
            if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasScroll) == 0 {
                ImGui_SetNextWindowScroll(ImVec2{0.0f, 0.0f});
            }
        }
        ImGuiChildFlags child_child_flags = (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasChildFlags) != 0 ? g.NextWindowData.ChildFlags : ImGuiChildFlags_None;
        ImGuiWindowFlags child_window_flags = (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasWindowFlags) != 0 ? g.NextWindowData.WindowFlags : ImGuiWindowFlags_None;
        if (flags & ImGuiTableFlags_ScrollX) != 0 {
            child_window_flags |= ImGuiWindowFlags_HorizontalScrollbar;
        }
        ImGui_BeginChildEx(name, instance_id, ImRect_GetSize(&outer_rect), child_child_flags, child_window_flags);
        table.InnerWindow = g.CurrentWindow;
        table.WorkRect = table.InnerWindow.WorkRect;
        table.OuterRect = ImGuiWindow_Rect(table.InnerWindow);
        table.InnerRect = table.InnerWindow.InnerRect;
        assert(table.InnerWindow.WindowPadding.x == 0.0f && table.InnerWindow.WindowPadding.y == 0.0f && table.InnerWindow.WindowBorderSize == 0.0f);
        if table.InnerWindow.SkipItems && outer_window_is_measuring_size {
            table.InnerWindow.SkipItems = false;
        }
        if instance_no == 0 {
            table.HasScrollbarYPrev = table.HasScrollbarYCurr;
            table.HasScrollbarYCurr = false;
        }
        table.HasScrollbarYCurr |= table.InnerWindow.ScrollbarY;
    } else {
        table.InnerRect = outer_rect;
        table.OuterRect = table.InnerRect;
        table.WorkRect = table.OuterRect;
        table.HasScrollbarYCurr = false;
        table.HasScrollbarYPrev = table.HasScrollbarYCurr;
        table.InnerWindow.DC.TreeDepth++;
    }
    ImGui_PushOverrideID(id);
    if instance_no > 0 {
        ImGui_PushOverrideID(instance_id);
    }
    ImGuiWindow* inner_window = table.InnerWindow;
    table.HostIndentX = inner_window.DC.Indent.x;
    table.HostClipRect = inner_window.ClipRect;
    table.HostSkipItems = inner_window.SkipItems;
    temp_data.WindowID = inner_window.ID;
    temp_data.HostBackupWorkRect = inner_window.WorkRect;
    temp_data.HostBackupParentWorkRect = inner_window.ParentWorkRect;
    temp_data.HostBackupColumnsOffset = outer_window.DC.ColumnsOffset;
    temp_data.HostBackupPrevLineSize = inner_window.DC.PrevLineSize;
    temp_data.HostBackupCurrLineSize = inner_window.DC.CurrLineSize;
    temp_data.HostBackupCursorMaxPos = inner_window.DC.CursorMaxPos;
    temp_data.HostBackupItemWidth = outer_window.DC.ItemWidth;
    temp_data.HostBackupItemWidthStackSize = outer_window.DC.ItemWidthStack.Size;
    inner_window.DC.CurrLineSize = ImVec2{0.0f, 0.0f};
    inner_window.DC.PrevLineSize = inner_window.DC.CurrLineSize;
    if inner_window != outer_window {
        f32 border_size = TABLE_BORDER_SIZE;
        if (flags & ImGuiTableFlags_BordersOuterV) != 0 {
            table.HostClipRect.Min.x = ImMin(table.HostClipRect.Min.x + border_size, table.HostClipRect.Max.x);
            if inner_window.DecoOuterSizeX2 == 0.0f {
                table.HostClipRect.Max.x = ImMax(table.HostClipRect.Max.x - border_size, table.HostClipRect.Min.x);
            }
        }
        if (flags & ImGuiTableFlags_BordersOuterH) != 0 {
            table.HostClipRect.Min.y = ImMin(table.HostClipRect.Min.y + border_size, table.HostClipRect.Max.y);
            if inner_window.DecoOuterSizeY2 == 0.0f {
                table.HostClipRect.Max.y = ImMax(table.HostClipRect.Max.y - border_size, table.HostClipRect.Min.y);
            }
        }
    }
    bool pad_outer_x = (flags & ImGuiTableFlags_NoPadOuterX) != 0 ? false : (flags & ImGuiTableFlags_PadOuterX) != 0 ? true : (flags & ImGuiTableFlags_BordersOuterV) != 0;
    bool pad_inner_x = ((flags & ImGuiTableFlags_NoPadInnerX) != 0 ? false : true) != 0;
    f32 inner_spacing_for_border = (flags & ImGuiTableFlags_BordersInnerV) != 0 ? TABLE_BORDER_SIZE : 0.0f;
    f32 inner_spacing_explicit = pad_inner_x && (flags & ImGuiTableFlags_BordersInnerV) == 0 ? g.Style.CellPadding.x : 0.0f;
    f32 inner_padding_explicit = pad_inner_x && (flags & ImGuiTableFlags_BordersInnerV) != 0 ? g.Style.CellPadding.x : 0.0f;
    table.CellSpacingX1 = inner_spacing_explicit + inner_spacing_for_border;
    table.CellSpacingX2 = inner_spacing_explicit;
    table.CellPaddingX = inner_padding_explicit;
    f32 outer_padding_for_border = (flags & ImGuiTableFlags_BordersOuterV) != 0 ? TABLE_BORDER_SIZE : 0.0f;
    f32 outer_padding_explicit = pad_outer_x != 0 ? g.Style.CellPadding.x : 0.0f;
    table.OuterPaddingX = outer_padding_for_border + outer_padding_explicit - table.CellPaddingX;
    table.CurrentColumn = -1;
    table.CurrentRow = -1;
    table.RowBgColorCounter = 0;
    table.LastRowFlags = ImGuiTableRowFlags_None;
    table.InnerClipRect = inner_window == outer_window ? table.WorkRect : inner_window.ClipRect;
    ImRect_ClipWith(&table.InnerClipRect, table.WorkRect);
    ImRect_ClipWithFull(&table.InnerClipRect, table.HostClipRect);
    table.InnerClipRect.Max.y = (flags & ImGuiTableFlags_NoHostExtendY) != 0 ? ImMin(table.InnerClipRect.Max.y, inner_window.WorkRect.Max.y) : table.HostClipRect.Max.y;
    table.RowPosY2 = table.WorkRect.Min.y;
    table.RowPosY1 = table.RowPosY2;
    table.RowTextBaseline = 0.0f;
    table.RowCellPaddingY = 0.0f;
    table.FreezeRowsCount = 0;
    table.FreezeRowsRequest = table.FreezeRowsCount;
    table.FreezeColumnsCount = 0;
    table.FreezeColumnsRequest = table.FreezeColumnsCount;
    table.IsUnfrozenRows = true;
    table.AngledHeadersCount = 0;
    table.DeclColumnsCount = table.AngledHeadersCount;
    if previous_frame_active + 1 < g.FrameCount {
        table.IsActiveIdInTable = false;
    }
    table.AngledHeadersHeight = 0.0f;
    temp_data.AngledHeadersExtraWidth = 0.0f;
    table.BorderColorStrong = ImGui_GetColorU32(ImGuiCol_TableBorderStrong);
    table.BorderColorLight = ImGui_GetColorU32(ImGuiCol_TableBorderLight);
    g.CurrentTable = table;
    inner_window.DC.NavIsScrollPushableX = false;
    outer_window.DC.CurrentTableIdx = table_idx;
    if inner_window != outer_window {
        inner_window.DC.CurrentTableIdx = table_idx;
    }
    if previous_flags & ImGuiTableFlags_Reorderable && (flags & ImGuiTableFlags_Reorderable) == 0 {
        table.IsResetDisplayOrderRequest = true;
    }
    if table_idx >= g.TablesLastTimeActive.Size {
        ImVector_float_resize(&g.TablesLastTimeActive, table_idx + 1, -1.0f);
    }
    g.TablesLastTimeActive.Data[table_idx] = cast(f32, g.Time);
    temp_data.LastTimeActive = cast(f32, g.Time);
    table.MemoryCompacted = false;
    i32 old_columns_count = ImSpan_ImGuiTableColumn_size(&table.Columns);
    if old_columns_count != 0 && old_columns_count != columns_count {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventTable) != 0 {
            }
            if !(0 != 0) { break; }
        }
        assert(temp_data.OldColumnsRawData == null);
        temp_data.OldColumnsRawData = table.RawData;
        temp_data.OldColumnsData = table.Columns;
        {
            ImGuiTableColumn* zz_rf_it_2 = ImSpan_ImGuiTableColumn_begin(&table.TempData.OldColumnsData);
            ImGuiTableColumn* zz_rf_end_2 = ImSpan_ImGuiTableColumn_end(&table.TempData.OldColumnsData);
            for ; zz_rf_it_2 != zz_rf_end_2; zz_rf_it_2++ {
                ImGuiTableColumn* src_column = zz_rf_it_2;
                src_column.IsNeedReconcileSrc = true;
            }
        }
        table.RawData = null;
    }
    if table.RawData == null {
        ImGui_TableBeginInitMemory(table, columns_count);
        table.IsInitializing = true;
    }
    if table.IsResetAllRequest != 0 {
        ImGui_TableResetSettings(table);
    }
    if table.IsInitializing != 0 {
        if is_new_table != 0 {
            table.SettingsOffset = -1;
            table.IsSettingsRequestLoad = true;
        }
        table.IsSortSpecsDirty = true;
        table.IsSettingsDirty = true;
        table.IsReconcileMode = false;
        table.InstanceInteracted = cast(ImS16, -1);
        table.ContextPopupColumn = cast(ImGuiTableColumnIdx, -1);
        table.LastResizedColumn = cast(ImGuiTableColumnIdx, -1);
        table.ResizedColumn = table.LastResizedColumn;
        table.ReorderColumnDstOrder = table.ResizedColumn;
        table.ReorderColumn = table.ReorderColumnDstOrder;
        table.AutoFitSingleColumn = cast(ImGuiTableColumnIdx, -1);
        table.HoveredColumnBorder = cast(ImGuiTableColumnIdx, -1);
        table.HoveredColumnBody = table.HoveredColumnBorder;
        for i32 n = 0; n < columns_count; n++ {
            ImGuiTableColumn* column = &table.Columns.Data[n];
            if temp_data.OldColumnsData.Data && n < ImSpan_ImGuiTableColumn_size(&temp_data.OldColumnsData) {
                *column = temp_data.OldColumnsData.Data[n];
            } else {
                f32 width_auto = column.WidthAuto;
                *column = __cxx_make_ImGuiTableColumn();
                column.WidthAuto = width_auto;
                column.IsPreserveWidthAuto = true;
                column.IsUserEnabledNextFrame = true;
                column.IsUserEnabled = column.IsUserEnabledNextFrame;
                column.IsEnabled = column.IsUserEnabled;
                column.DisplayOrder = cast(ImGuiTableColumnIdx, n);
            }
            table.DisplayOrderToIndex.Data[n] = column.DisplayOrder;
        }
    }
    if table.IsSettingsRequestLoad != 0 {
        ImGui_TableLoadSettings(table);
    }
    inner_window.SkipItems = true;
    if table.ColumnsNames.Buf.Size > 0 {
        ImVector_char_resize(&table.ColumnsNames.Buf, 0);
    }
    return true;
}

// For reference, the average total _allocation count_ for a table is:
// + 0 (for ImGuiTable instance, we are pooling allocations in g.Tables[])
// + 1 (for table->RawData allocated below)
// + 1 (for table->ColumnsNames, if names are used)
// Shared allocations for the maximum number of simultaneously nested tables (generally a very small number)
// + 1 (for table->Splitter._Channels)
// + 2 * active_channels_count (for ImDrawCmd and ImDrawIdx buffers inside channels)
// Where active_channels_count is variable but often == columns_count or == columns_count + 1, see TableSetupDrawChannels() for details.
// Unused channels don't perform their +2 allocations.
void ImGui_TableBeginInitMemory(ImGuiTable* table, i32 columns_count) {
    var columns_bit_array_size = cast(i32, ImBitArrayGetStorageSizeInBytes(columns_count));
    ImSpanAllocator_6 span_allocator;
    ImSpanAllocator_6_Reserve(&span_allocator, 0, cast(u64, columns_count * sizeof(ImGuiTableColumn)), 4);
    ImSpanAllocator_6_Reserve(&span_allocator, 1, cast(u64, columns_count * sizeof(ImGuiTableColumnIdx)), 4);
    ImSpanAllocator_6_Reserve(&span_allocator, 2, cast(u64, columns_count * sizeof(ImGuiTableCellData)), 4);
    for i32 n = 3; n < 6; n++ {
        ImSpanAllocator_6_Reserve(&span_allocator, n, cast(u64, columns_bit_array_size), 4);
    }
    table.RawData = ImGui_MemAlloc(cast(u64, ImSpanAllocator_6_GetArenaSizeInBytes(&span_allocator)));
    memset(table.RawData, 0, cast(u64, ImSpanAllocator_6_GetArenaSizeInBytes(&span_allocator)));
    ImSpanAllocator_6_SetArenaBasePtr(&span_allocator, table.RawData);
    table.Columns.Data = cast(ImGuiTableColumn*, ImSpanAllocator_6_GetSpanPtrBegin(&span_allocator, 0)); table.Columns.DataEnd = cast(ImGuiTableColumn*, ImSpanAllocator_6_GetSpanPtrEnd(&span_allocator, 0));
    table.DisplayOrderToIndex.Data = cast(ImGuiTableColumnIdx*, ImSpanAllocator_6_GetSpanPtrBegin(&span_allocator, 1)); table.DisplayOrderToIndex.DataEnd = cast(ImGuiTableColumnIdx*, ImSpanAllocator_6_GetSpanPtrEnd(&span_allocator, 1));
    table.RowCellData.Data = cast(ImGuiTableCellData*, ImSpanAllocator_6_GetSpanPtrBegin(&span_allocator, 2)); table.RowCellData.DataEnd = cast(ImGuiTableCellData*, ImSpanAllocator_6_GetSpanPtrEnd(&span_allocator, 2));
    table.EnabledMaskByDisplayOrder = cast(ImU32*, ImSpanAllocator_6_GetSpanPtrBegin(&span_allocator, 3));
    table.EnabledMaskByIndex = cast(ImU32*, ImSpanAllocator_6_GetSpanPtrBegin(&span_allocator, 4));
    table.VisibleMaskByIndex = cast(ImU32*, ImSpanAllocator_6_GetSpanPtrBegin(&span_allocator, 5));
}

// Apply queued resizing/reordering/hiding requests
void ImGui_TableApplyQueuedRequests(ImGuiTable* table) {
    if table.InstanceCurrent == 0 {
        if table.ResizedColumn != -1 && table.ResizedColumnNextWidth != FLT_MAX {
            ImGui_TableSetColumnWidth(cast(i32, table.ResizedColumn), table.ResizedColumnNextWidth);
        }
        table.LastResizedColumn = table.ResizedColumn;
        table.ResizedColumnNextWidth = FLT_MAX;
        table.ResizedColumn = cast(ImGuiTableColumnIdx, -1);
        if table.AutoFitSingleColumn != -1 {
            ImGui_TableSetColumnWidth(cast(i32, table.AutoFitSingleColumn), table.Columns.Data[table.AutoFitSingleColumn].WidthAuto);
            table.AutoFitSingleColumn = cast(ImGuiTableColumnIdx, -1);
        }
    }
    if table.InstanceCurrent == 0 {
        table.LastHeldHeaderColumn = table.HeldHeaderColumn;
        table.HeldHeaderColumn = cast(ImGuiTableColumnIdx, -1);
        if table.ReorderColumn != -1 && table.ReorderColumnDstOrder != -1 {
            ImGui_TableSetColumnDisplayOrder(table, cast(i32, table.ReorderColumn), cast(i32, table.ReorderColumnDstOrder));
            table.ReorderColumnDstOrder = cast(ImGuiTableColumnIdx, -1);
        }
        ImGuiContext* g = GImGui;
        if g.ActiveId == 0 {
            table.ReorderColumn = cast(ImGuiTableColumnIdx, -1);
        }
    }
    if table.IsResetDisplayOrderRequest != 0 {
        for i32 n = 0; n < table.ColumnsCount; n++ {
            table.Columns.Data[n].DisplayOrder = cast(ImGuiTableColumnIdx, n);
            table.DisplayOrderToIndex.Data[n] = table.Columns.Data[n].DisplayOrder;
        }
        table.IsResetDisplayOrderRequest = false;
        table.IsSettingsDirty = true;
    }
    if table.IsResetVisibilityRequest != 0 {
        {
            ImGuiTableColumn* zz_rf_it_3 = ImSpan_ImGuiTableColumn_begin(&table.Columns);
            ImGuiTableColumn* zz_rf_end_3 = ImSpan_ImGuiTableColumn_end(&table.Columns);
            for ; zz_rf_it_3 != zz_rf_end_3; zz_rf_it_3++ {
                ImGuiTableColumn* column = zz_rf_it_3;
                column.IsUserEnabledNextFrame = ((column.Flags & ImGuiTableColumnFlags_DefaultHide) != 0 ? 0 : 1) != 0;
                column.IsUserEnabled = column.IsUserEnabledNextFrame;
            }
        }
        table.IsResetVisibilityRequest = false;
        table.IsSettingsDirty = true;
    }
}

// Apply immediately. See TableQueueSetColumnDisplayOrder() for additional checks/constraints.
void ImGui_TableSetColumnDisplayOrder(ImGuiTable* table, i32 column_n, i32 dst_order) {
    assert(column_n >= 0 && column_n < table.ColumnsCount);
    assert(dst_order >= 0 && dst_order < table.ColumnsCount);
    ImGuiTableColumn* src_column = &table.Columns.Data[column_n];
    i32 src_order = src_column.DisplayOrder;
    if src_order == dst_order {
        return;
    }
    i32 reorder_dir = dst_order < src_order ? -1 : 1;
    src_column.DisplayOrder = cast(ImGuiTableColumnIdx, dst_order);
    for i32 order_n = src_order + reorder_dir; order_n != dst_order + reorder_dir; order_n += reorder_dir {
        table.Columns.Data[table.DisplayOrderToIndex.Data[order_n]].DisplayOrder -= cast(ImGuiTableColumnIdx, reorder_dir);
    }
    for i32 n = 0; n < table.ColumnsCount; n++ {
        table.DisplayOrderToIndex.Data[table.Columns.Data[n].DisplayOrder] = cast(ImGuiTableColumnIdx, n);
    }
    table.IsSettingsDirty = true;
}

private {
i32 TableGetMaxDisplayOrderAllowed(ImGuiTable* table, i32 src_order, i32 dst_order) {
    dst_order = ImClamp(dst_order, 0, table.ColumnsCount - 1);
    if src_order == dst_order {
        return dst_order;
    }
    if table.FreezeColumnsRequest > 0 {
        dst_order = src_order < table.FreezeColumnsRequest ? ImMin(dst_order, cast(i32, table.FreezeColumnsRequest) - 1) : ImMax(dst_order, cast(i32, table.FreezeColumnsRequest));
    }
    i32 reorder_dir = src_order < dst_order ? 1 : -1;
    for i32 order_n = src_order; src_order < dst_order && order_n <= dst_order || dst_order < src_order && order_n >= dst_order; order_n += reorder_dir {
        if (table.Columns.Data[table.DisplayOrderToIndex.Data[order_n]].Flags & ImGuiTableColumnFlags_NoReorder) != 0 {
            dst_order = order_n == src_order ? src_order : order_n - reorder_dir;
            break;
        }
    }
    return dst_order;
}
}

// Reorder requested by user interaction.
void ImGui_TableQueueSetColumnDisplayOrder(ImGuiTable* table, i32 column_n, i32 dst_order) {
    i32 src_order = table.Columns.Data[column_n].DisplayOrder;
    table.ReorderColumn = cast(ImGuiTableColumnIdx, column_n);
    table.ReorderColumnDstOrder = cast(ImGuiTableColumnIdx, -1);
    dst_order = TableGetMaxDisplayOrderAllowed(table, src_order, dst_order);
    if table.IsLayoutLocked && dst_order == src_order {
        return;
    }
    table.ReorderColumnDstOrder = cast(ImGuiTableColumnIdx, dst_order);
}

// Adjust flags: default width mode + stretch columns are not allowed when auto extending
private {
void TableSetupColumnFlags(ImGuiTable* table, ImGuiTableColumn* column, ImGuiTableColumnFlags flags_in) {
    ImGuiTableColumnFlags flags = flags_in;
    if (flags & ImGuiTableColumnFlags_WidthMask_) == 0 {
        ImGuiTableFlags table_sizing_policy = table.Flags & ImGuiTableFlags_SizingMask_;
        if table_sizing_policy == ImGuiTableFlags_SizingFixedFit || table_sizing_policy == ImGuiTableFlags_SizingFixedSame {
            flags |= ImGuiTableColumnFlags_WidthFixed;
        } else {
            flags |= ImGuiTableColumnFlags_WidthStretch;
        }
    } else {
        assert(cast(i64, ImIsPowerOfTwo(flags & ImGuiTableColumnFlags_WidthMask_)));
    }
    if (table.Flags & ImGuiTableFlags_Resizable) == 0 {
        flags |= ImGuiTableColumnFlags_NoResize;
    }
    if flags & ImGuiTableColumnFlags_NoSortAscending && flags & ImGuiTableColumnFlags_NoSortDescending {
        flags |= ImGuiTableColumnFlags_NoSort;
    }
    if (flags & ImGuiTableColumnFlags_IndentMask_) == 0 {
        flags |= ImSpan_ImGuiTableColumn_index_from_ptr(&table.Columns, column) == 0 ? ImGuiTableColumnFlags_IndentEnable : ImGuiTableColumnFlags_IndentDisable;
    }
    column.Flags = flags | column.Flags & ImGuiTableColumnFlags_StatusMask_;
    column.SortDirectionsAvailList = 0;
    column.SortDirectionsAvailMask = column.SortDirectionsAvailList;
    column.SortDirectionsAvailCount = column.SortDirectionsAvailMask;
    if (table.Flags & ImGuiTableFlags_Sortable) != 0 {
        i32 count = 0;
        i32 mask = 0;
        i32 list = 0;
        if (flags & ImGuiTableColumnFlags_PreferSortAscending) != 0 && (flags & ImGuiTableColumnFlags_NoSortAscending) == 0 {
            mask |= 1 << ImGuiSortDirection_Ascending;
            list |= ImGuiSortDirection_Ascending << (count << 1);
            count++;
        }
        if (flags & ImGuiTableColumnFlags_PreferSortDescending) != 0 && (flags & ImGuiTableColumnFlags_NoSortDescending) == 0 {
            mask |= 1 << ImGuiSortDirection_Descending;
            list |= ImGuiSortDirection_Descending << (count << 1);
            count++;
        }
        if (flags & ImGuiTableColumnFlags_PreferSortAscending) == 0 && (flags & ImGuiTableColumnFlags_NoSortAscending) == 0 {
            mask |= 1 << ImGuiSortDirection_Ascending;
            list |= ImGuiSortDirection_Ascending << (count << 1);
            count++;
        }
        if (flags & ImGuiTableColumnFlags_PreferSortDescending) == 0 && (flags & ImGuiTableColumnFlags_NoSortDescending) == 0 {
            mask |= 1 << ImGuiSortDirection_Descending;
            list |= ImGuiSortDirection_Descending << (count << 1);
            count++;
        }
        if table.Flags & ImGuiTableFlags_SortTristate || count == 0 {
            mask |= 1 << ImGuiSortDirection_None;
            count++;
        }
        column.SortDirectionsAvailList = cast(ImU8, list);
        column.SortDirectionsAvailMask = cast(ImU8, mask);
        column.SortDirectionsAvailCount = cast(ImU8, count);
        ImGui_TableFixColumnSortDirection(table, column);
    }
}
}

// Layout columns for the frame. This is in essence the followup to BeginTable() and this is our largest function.
// Runs on the first call to TableNextRow(), to give a chance for TableSetupColumn() and other TableSetupXXXXX() functions to be called first.
// FIXME-TABLE: Our width (and therefore our WorkRect) will be minimal in the first frame for _WidthAuto columns.
// Increase feedback side-effect with widgets relying on WorkRect.Max.x... Maybe provide a default distribution for _WidthAuto columns?
void ImGui_TableUpdateLayout(ImGuiTable* table) {
    ImGuiContext* g = GImGui;
    ImGuiTableTempData* temp_data = table.TempData;
    assert(table.IsLayoutLocked == false);
    i32 columns_count = table.ColumnsCount;
    if temp_data.ReconcileColumnsRequests.Size > 0 {
        ImGui_TableReconcileColumns(table);
    }
    if temp_data.OldColumnsRawData != null {
        ImGui_MemFree(temp_data.OldColumnsRawData);
        temp_data.OldColumnsRawData = null;
        ImSpan_ImGuiTableColumn_clear(&temp_data.OldColumnsData);
    }
    if table.IsSettingsRequestLoad != 0 {
        ImGui_TableLoadSettingsForColumns(table);
    }
    if table.IsInitializing || table.IsSettingsRequestLoad {
        {
            ImGuiTableColumn* zz_rf_it_4 = ImSpan_ImGuiTableColumn_begin(&table.Columns);
            ImGuiTableColumn* zz_rf_end_4 = ImSpan_ImGuiTableColumn_end(&table.Columns);
            for ; zz_rf_it_4 != zz_rf_end_4; zz_rf_it_4++ {
                ImGuiTableColumn* column = zz_rf_it_4;
                ImGuiTableFlags init_flags;
                if table.IsSettingsRequestLoad != 0 {
                    init_flags = column.IsLoadedSettings != 0 ? ~table.SettingsLoadedFlags : ~0;
                } else {
                    init_flags = column.IsJustCreated != 0 ? ~0 : 0;
                }
                ImGui_TableInitColumnDefaults(table, column, init_flags);
            }
        }
        ImGui_TableFixDisplayOrder(table);
        table.IsSettingsRequestLoad = false;
    }
    ImGui_TableApplyQueuedRequests(table);
    f32 new_ref_scale_unit = g.FontSize;
    if table.RefScale != 0.0f && table.RefScale != new_ref_scale_unit {
        f32 scale_factor = new_ref_scale_unit / table.RefScale;
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventTable) != 0 {
            }
            if !(0 != 0) { break; }
        }
        for i32 n = 0; n < columns_count; n++ {
            table.Columns.Data[n].WidthRequest = table.Columns.Data[n].WidthRequest * scale_factor;
        }
    }
    table.RefScale = new_ref_scale_unit;
    ImGuiTableFlags table_sizing_policy = table.Flags & ImGuiTableFlags_SizingMask_;
    table.IsDefaultVisibility = true;
    table.IsDefaultDisplayOrder = table.IsDefaultVisibility;
    table.ColumnsEnabledCount = 0;
    ImBitArrayClearAllBits(table.EnabledMaskByIndex, columns_count);
    ImBitArrayClearAllBits(table.EnabledMaskByDisplayOrder, columns_count);
    table.LeftMostEnabledColumn = cast(ImGuiTableColumnIdx, -1);
    table.MinColumnWidth = ImMax(1.0f, g.Style.FramePadding.x * 1.0f);
    i32 count_fixed = 0;
    i32 count_stretch = 0;
    i32 prev_visible_column_idx = -1;
    bool has_auto_fit_request = false;
    bool has_resizable = false;
    f32 stretch_sum_width_auto = 0.0f;
    f32 fixed_max_width_auto = 0.0f;
    for i32 order_n = 0; order_n < columns_count; order_n++ {
        i32 column_n = table.DisplayOrderToIndex.Data[order_n];
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        if table.DeclColumnsCount <= column_n {
            TableSetupColumnFlags(table, column, ImGuiTableColumnFlags_None);
            column.NameOffset = cast(ImS16, -1);
            column.UserData = 0;
            column.ID = column.UserData;
            column.InitStretchWeightOrWidth = -1.0f;
        }
        if !(table.Flags & ImGuiTableFlags_Hideable) || column.Flags & ImGuiTableColumnFlags_NoHide {
            column.IsUserEnabledNextFrame = true;
        }
        if column.IsUserEnabled != column.IsUserEnabledNextFrame {
            column.IsUserEnabled = column.IsUserEnabledNextFrame;
            table.IsSettingsDirty = true;
        }
        column.IsEnabled = column.IsUserEnabled && (column.Flags & ImGuiTableColumnFlags_Disabled) == 0;
        column.IsJustCreated = false;
        if column.IsEnabled != ((column.Flags & ImGuiTableColumnFlags_DefaultHide) != 0 ? 0 : 1) {
            table.IsDefaultVisibility = false;
        }
        if column_n != order_n {
            table.IsDefaultDisplayOrder = false;
        }
        if column.SortOrder != -1 && !column.IsEnabled {
            table.IsSortSpecsDirty = true;
        }
        if column.SortOrder > 0 && !(table.Flags & ImGuiTableFlags_SortMulti) {
            table.IsSortSpecsDirty = true;
        }
        bool start_auto_fit = (column.Flags & ImGuiTableColumnFlags_WidthFixed) != 0 ? column.WidthRequest < 0.0f : column.StretchWeight < 0.0f;
        if start_auto_fit != 0 {
            column.CannotSkipItemsQueue = cast(ImU8, (1 << 3) - 1);
            column.AutoFitQueue = column.CannotSkipItemsQueue;
        }
        if column.IsEnabled == 0 {
            column.IndexWithinEnabledSet = cast(ImGuiTableColumnIdx, -1);
            continue;
        }
        column.PrevEnabledColumn = cast(ImGuiTableColumnIdx, prev_visible_column_idx);
        column.NextEnabledColumn = cast(ImGuiTableColumnIdx, -1);
        if prev_visible_column_idx != -1 {
            table.Columns.Data[prev_visible_column_idx].NextEnabledColumn = cast(ImGuiTableColumnIdx, column_n);
        } else {
            table.LeftMostEnabledColumn = cast(ImGuiTableColumnIdx, column_n);
        }
        column.IndexWithinEnabledSet = table.ColumnsEnabledCount++;
        ImBitArraySetBit(table.EnabledMaskByIndex, column_n);
        ImBitArraySetBit(table.EnabledMaskByDisplayOrder, column.DisplayOrder);
        prev_visible_column_idx = column_n;
        assert(column.IndexWithinEnabledSet <= column.DisplayOrder);
        if !column.IsPreserveWidthAuto && table.InstanceCurrent == 0 {
            column.WidthAuto = ImGui_TableGetColumnWidthAuto(table, column);
        }
        bool column_is_resizable = (column.Flags & ImGuiTableColumnFlags_NoResize) == 0;
        if column_is_resizable != 0 {
            has_resizable = true;
        }
        if column.Flags & ImGuiTableColumnFlags_WidthFixed && column.InitStretchWeightOrWidth > 0.0f && !column_is_resizable {
            column.WidthAuto = column.InitStretchWeightOrWidth;
        }
        if column.AutoFitQueue != 0x00 {
            has_auto_fit_request = true;
        }
        if (column.Flags & ImGuiTableColumnFlags_WidthStretch) != 0 {
            stretch_sum_width_auto += column.WidthAuto;
            count_stretch++;
        } else {
            fixed_max_width_auto = ImMax(fixed_max_width_auto, column.WidthAuto);
            count_fixed++;
        }
    }
    if table.Flags & ImGuiTableFlags_Sortable && table.SortSpecsCount == 0 && !(table.Flags & ImGuiTableFlags_SortTristate) {
        table.IsSortSpecsDirty = true;
    }
    table.RightMostEnabledColumn = cast(ImGuiTableColumnIdx, prev_visible_column_idx);
    assert(table.LeftMostEnabledColumn >= 0 && table.RightMostEnabledColumn >= 0);
    if has_auto_fit_request && table.OuterWindow != table.InnerWindow {
        table.InnerWindow.SkipItems = false;
    }
    if has_auto_fit_request != 0 {
        table.IsSettingsDirty = true;
    }
    f32 sum_width_requests = 0.0f;
    f32 stretch_sum_weights = 0.0f;
    table.RightMostStretchedColumn = cast(ImGuiTableColumnIdx, -1);
    table.LeftMostStretchedColumn = table.RightMostStretchedColumn;
    for i32 column_n = 0; column_n < columns_count; column_n++ {
        if (table.EnabledMaskByIndex[column_n >> 5] & cast(ImU32, 1) << cast(u32, column_n & 31)) != 0 == 0 {
            continue;
        }
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        bool column_is_resizable = (column.Flags & ImGuiTableColumnFlags_NoResize) == 0;
        if (column.Flags & ImGuiTableColumnFlags_WidthFixed) != 0 {
            f32 width_auto = column.WidthAuto;
            if table_sizing_policy == ImGuiTableFlags_SizingFixedSame && (column.AutoFitQueue != 0x00 || !column_is_resizable) {
                width_auto = fixed_max_width_auto;
            }
            if column.AutoFitQueue != 0x00 {
                column.WidthRequest = width_auto;
            } else if column.Flags & ImGuiTableColumnFlags_WidthFixed && !column_is_resizable && column.IsRequestOutput {
                column.WidthRequest = width_auto;
            }
            if column.AutoFitQueue > 0x01 && table.IsInitializing && !column.IsPreserveWidthAuto {
                column.WidthRequest = ImMax(column.WidthRequest, table.MinColumnWidth * 4.0f);
            }
            sum_width_requests += column.WidthRequest;
        } else {
            if column.AutoFitQueue != 0x00 || column.StretchWeight < 0.0f || !column_is_resizable {
                if column.InitStretchWeightOrWidth > 0.0f {
                    column.StretchWeight = column.InitStretchWeightOrWidth;
                } else if table_sizing_policy == ImGuiTableFlags_SizingStretchProp {
                    column.StretchWeight = column.WidthAuto / stretch_sum_width_auto * cast(f32, count_stretch);
                } else {
                    column.StretchWeight = 1.0f;
                }
            }
            stretch_sum_weights += column.StretchWeight;
            if table.LeftMostStretchedColumn == -1 || table.Columns.Data[table.LeftMostStretchedColumn].DisplayOrder > column.DisplayOrder {
                table.LeftMostStretchedColumn = cast(ImGuiTableColumnIdx, column_n);
            }
            if table.RightMostStretchedColumn == -1 || table.Columns.Data[table.RightMostStretchedColumn].DisplayOrder < column.DisplayOrder {
                table.RightMostStretchedColumn = cast(ImGuiTableColumnIdx, column_n);
            }
        }
        column.IsPreserveWidthAuto = false;
        sum_width_requests += table.CellPaddingX * 2.0f;
    }
    table.ColumnsEnabledFixedCount = cast(ImGuiTableColumnIdx, count_fixed);
    table.ColumnsStretchSumWeights = stretch_sum_weights;
    ImRect work_rect = table.WorkRect;
    f32 width_spacings = table.OuterPaddingX * 2.0f + (table.CellSpacingX1 + table.CellSpacingX2) * cast(f32, table.ColumnsEnabledCount - 1);
    f32 width_removed = table.HasScrollbarYPrev && !table.InnerWindow.ScrollbarY ? g.Style.ScrollbarSize : 0.0f;
    f32 width_avail = ImMax(1.0f, (table.Flags & ImGuiTableFlags_ScrollX && table.InnerWidth == 0.0f ? ImRect_GetWidth(&table.InnerClipRect) : ImRect_GetWidth(&work_rect)) - width_removed);
    f32 width_avail_for_stretched_columns = width_avail - width_spacings - sum_width_requests;
    f32 width_remaining_for_stretched_columns = width_avail_for_stretched_columns;
    table.ColumnsGivenWidth = width_spacings + table.CellPaddingX * 2.0f * cast(f32, table.ColumnsEnabledCount);
    for i32 column_n = 0; column_n < columns_count; column_n++ {
        if (table.EnabledMaskByIndex[column_n >> 5] & cast(ImU32, 1) << cast(u32, column_n & 31)) != 0 == 0 {
            continue;
        }
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        if (column.Flags & ImGuiTableColumnFlags_WidthStretch) != 0 {
            f32 weight_ratio = column.StretchWeight / stretch_sum_weights;
            column.WidthRequest = cast(f32, cast(i32, ImMax(width_avail_for_stretched_columns * weight_ratio, table.MinColumnWidth) + 0.01f));
            width_remaining_for_stretched_columns -= column.WidthRequest;
        }
        if column.NextEnabledColumn == -1 && table.LeftMostStretchedColumn != -1 {
            column.Flags |= ImGuiTableColumnFlags_NoDirectResize_;
        }
        column.WidthGiven = ImTrunc(ImMax(column.WidthRequest, table.MinColumnWidth));
        table.ColumnsGivenWidth += column.WidthGiven;
    }
    if width_remaining_for_stretched_columns >= 1.0f && !(table.Flags & ImGuiTableFlags_PreciseWidths) {
        for i32 order_n = columns_count - 1; stretch_sum_weights > 0.0f && width_remaining_for_stretched_columns >= 1.0f && order_n >= 0; order_n-- {
            if (table.EnabledMaskByDisplayOrder[order_n >> 5] & cast(ImU32, 1) << cast(u32, order_n & 31)) != 0 == 0 {
                continue;
            }
            ImGuiTableColumn* column = &table.Columns.Data[table.DisplayOrderToIndex.Data[order_n]];
            if (column.Flags & ImGuiTableColumnFlags_WidthStretch) == 0 {
                continue;
            }
            column.WidthRequest += 1.0f;
            column.WidthGiven += 1.0f;
            width_remaining_for_stretched_columns -= 1.0f;
        }
    }
    ImGuiTableInstanceData* table_instance = ImGui_TableGetInstanceData(table, table.InstanceCurrent);
    table_instance.HoveredRowLast = table_instance.HoveredRowNext;
    table_instance.HoveredRowNext = -1;
    table.HoveredColumnBorder = cast(ImGuiTableColumnIdx, -1);
    table.HoveredColumnBody = table.HoveredColumnBorder;
    ImRect mouse_hit_rect;
    ImRect_init(&mouse_hit_rect, table.OuterRect.Min.x, table.OuterRect.Min.y, table.OuterRect.Max.x, ImMax(table.OuterRect.Max.y, table.OuterRect.Min.y + table_instance.LastOuterHeight));
    ImGuiID backup_active_id = g.ActiveId;
    g.ActiveId = 0;
    bool is_hovering_table = ImGui_ItemHoverable(mouse_hit_rect, 0, ImGuiItemFlags_None);
    g.ActiveId = backup_active_id;
    f32 mouse_skewed_x = g.IO.MousePos.x;
    if table.AngledHeadersHeight > 0.0f {
        if g.IO.MousePos.y >= table.OuterRect.Min.y && g.IO.MousePos.y <= table.OuterRect.Min.y + table.AngledHeadersHeight {
            mouse_skewed_x += ImTrunc((table.OuterRect.Min.y + table.AngledHeadersHeight - g.IO.MousePos.y) * table.AngledHeadersSlope);
        }
    }
    bool has_at_least_one_column_requesting_output = false;
    bool offset_x_frozen = table.FreezeColumnsCount > 0;
    f32 offset_x = (table.FreezeColumnsCount > 0 ? table.OuterRect.Min.x : work_rect.Min.x) + table.OuterPaddingX - table.CellSpacingX1;
    ImRect host_clip_rect = table.InnerClipRect;
    ImBitArrayClearAllBits(table.VisibleMaskByIndex, columns_count);
    for i32 order_n = 0; order_n < columns_count; order_n++ {
        i32 column_n = table.DisplayOrderToIndex.Data[order_n];
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        column.NavLayerCurrent = cast(ImS8, table.FreezeRowsCount > 0 ? ImGuiNavLayer_Menu : cast(ImGuiNavLayer, table.NavLayer));
        if offset_x_frozen && table.FreezeColumnsCount == order_n {
            offset_x += work_rect.Min.x - table.OuterRect.Min.x;
            offset_x_frozen = false;
        }
        column.Flags &= ~ImGuiTableColumnFlags_StatusMask_;
        if (table.EnabledMaskByDisplayOrder[order_n >> 5] & cast(ImU32, 1) << cast(u32, order_n & 31)) != 0 == 0 {
            column.ClipRect.Max.x = offset_x;
            column.ClipRect.Min.x = column.ClipRect.Max.x;
            column.WorkMinX = column.ClipRect.Min.x;
            column.MaxX = column.WorkMinX;
            column.MinX = column.MaxX;
            column.WidthGiven = 0.0f;
            column.ClipRect.Min.y = work_rect.Min.y;
            column.ClipRect.Max.y = FLT_MAX;
            ImRect_ClipWithFull(&column.ClipRect, host_clip_rect);
            column.IsRequestOutput = false;
            column.IsVisibleY = column.IsRequestOutput;
            column.IsVisibleX = column.IsVisibleY;
            column.IsSkipItems = true;
            column.ItemWidth = 1.0f;
            continue;
        }
        column.MinX = offset_x;
        column.WidthMax = ImGui_TableCalcMaxColumnWidth(table, column_n);
        column.WidthGiven = ImMin(column.WidthGiven, column.WidthMax);
        column.WidthGiven = ImMax(column.WidthGiven, ImMin(column.WidthRequest, table.MinColumnWidth));
        column.MaxX = offset_x + column.WidthGiven + table.CellSpacingX1 + table.CellSpacingX2 + table.CellPaddingX * 2.0f;
        f32 previous_instance_work_min_x = column.WorkMinX;
        column.WorkMinX = column.MinX + table.CellPaddingX + table.CellSpacingX1;
        column.WorkMaxX = column.MaxX - table.CellPaddingX - table.CellSpacingX2;
        column.ItemWidth = ImTrunc(column.WidthGiven * 0.65f);
        column.ClipRect.Min.x = column.MinX;
        column.ClipRect.Min.y = work_rect.Min.y;
        column.ClipRect.Max.x = column.MaxX;
        column.ClipRect.Max.y = FLT_MAX;
        ImRect_ClipWithFull(&column.ClipRect, host_clip_rect);
        column.IsVisibleX = column.ClipRect.Max.x > column.ClipRect.Min.x;
        column.IsVisibleY = true;
        bool is_visible = column.IsVisibleX;
        if is_visible != 0 {
            ImBitArraySetBit(table.VisibleMaskByIndex, column_n);
        }
        column.IsRequestOutput = is_visible || column.AutoFitQueue != 0 || column.CannotSkipItemsQueue != 0;
        column.IsSkipItems = !column.IsEnabled || table.HostSkipItems;
        if column.IsSkipItems != 0 {
            assert(cast(i64, !is_visible));
        }
        if column.IsRequestOutput && !column.IsSkipItems {
            has_at_least_one_column_requesting_output = true;
        }
        column.Flags |= ImGuiTableColumnFlags_IsEnabled;
        if is_visible != 0 {
            column.Flags |= ImGuiTableColumnFlags_IsVisible;
        }
        if column.SortOrder != -1 {
            column.Flags |= ImGuiTableColumnFlags_IsSorted;
        }
        if is_hovering_table && mouse_skewed_x >= column.ClipRect.Min.x && mouse_skewed_x < column.ClipRect.Max.x {
            column.Flags |= ImGuiTableColumnFlags_IsHovered;
            table.HoveredColumnBody = cast(ImGuiTableColumnIdx, column_n);
        }
        if table.InstanceCurrent == 0 {
            column.ContentMaxXFrozen = column.WorkMinX;
            column.ContentMaxXUnfrozen = column.WorkMinX;
            column.ContentMaxXHeadersUsed = column.WorkMinX;
            column.ContentMaxXHeadersIdeal = column.WorkMinX;
        } else {
            f32 offset_from_previous_instance = column.WorkMinX - previous_instance_work_min_x;
            column.ContentMaxXFrozen += offset_from_previous_instance;
            column.ContentMaxXUnfrozen += offset_from_previous_instance;
            column.ContentMaxXHeadersUsed += offset_from_previous_instance;
            column.ContentMaxXHeadersIdeal += offset_from_previous_instance;
        }
        if table.HostSkipItems == false && table.InstanceCurrent == 0 {
            column.AutoFitQueue >>= 1;
            column.CannotSkipItemsQueue >>= 1;
        }
        if order_n < table.FreezeColumnsCount {
            host_clip_rect.Min.x = ImClamp(column.MaxX + TABLE_BORDER_SIZE, host_clip_rect.Min.x, host_clip_rect.Max.x);
        }
        offset_x += column.WidthGiven + table.CellSpacingX1 + table.CellSpacingX2 + table.CellPaddingX * 2.0f;
    }
    if has_at_least_one_column_requesting_output == false {
        table.Columns.Data[table.LeftMostEnabledColumn].IsRequestOutput = true;
        table.Columns.Data[table.LeftMostEnabledColumn].IsSkipItems = false;
    }
    f32 unused_x1 = ImMax(table.WorkRect.Min.x, table.Columns.Data[table.RightMostEnabledColumn].ClipRect.Max.x);
    if is_hovering_table && table.HoveredColumnBody == -1 {
        if mouse_skewed_x >= unused_x1 {
            table.HoveredColumnBody = cast(ImGuiTableColumnIdx, columns_count);
        }
    }
    if has_resizable == false && table.Flags & ImGuiTableFlags_Resizable {
        table.Flags &= ~ImGuiTableFlags_Resizable;
    }
    table.IsActiveIdAliveBeforeTable = g.ActiveIdIsAlive != 0;
    if table.RightMostStretchedColumn != -1 {
        table.Flags &= ~ImGuiTableFlags_NoHostExtendX;
    }
    if (table.Flags & ImGuiTableFlags_NoHostExtendX) != 0 {
        table.WorkRect.Max.x = unused_x1;
        table.OuterRect.Max.x = table.WorkRect.Max.x;
        table.InnerClipRect.Max.x = ImMin(table.InnerClipRect.Max.x, unused_x1);
    }
    table.InnerWindow.ParentWorkRect = table.WorkRect;
    table.BorderX1 = table.InnerClipRect.Min.x;
    table.BorderX2 = table.InnerClipRect.Max.x;
    f32 window_content_max_y;
    if (table.Flags & ImGuiTableFlags_NoHostExtendY) != 0 {
        window_content_max_y = table.OuterRect.Max.y;
    } else {
        window_content_max_y = ImMax(table.InnerWindow.ContentRegionRect.Max.y, (table.Flags & ImGuiTableFlags_ScrollY) != 0 ? 0.0f : table.OuterRect.Max.y);
    }
    table.InnerWindow.WorkRect.Max.y = ImClamp(window_content_max_y - g.Style.CellPadding.y, table.InnerWindow.WorkRect.Min.y, table.InnerWindow.WorkRect.Max.y);
    ImGui_TableSetupDrawChannels(table);
    if (table.Flags & ImGuiTableFlags_Resizable) != 0 {
        ImGui_TableUpdateBorders(table);
    }
    table_instance.LastTopHeadersRowHeight = 0.0f;
    table.IsLayoutLocked = true;
    table.IsUsingHeaders = false;
    table.HighlightColumnHeader = cast(ImGuiTableColumnIdx, -1);
    if table.IsContextPopupOpen && table.ContextPopupColumn != -1 && table.InstanceInteracted == table.InstanceCurrent {
        table.HighlightColumnHeader = table.ContextPopupColumn;
    } else if table.Flags & ImGuiTableFlags_HighlightHoveredColumn && table.HoveredColumnBody != -1 && table.HoveredColumnBody != columns_count && table.HoveredColumnBorder == -1 {
        if g.ActiveId == 0 || (table.IsActiveIdInTable || g.DragDropActive) {
            table.HighlightColumnHeader = table.HoveredColumnBody;
        }
    }
    if table.DisableDefaultContextMenu == false && ImGui_TableBeginContextMenuPopup(table) {
        ImGui_TableDrawDefaultContextMenu(table, table.Flags);
        ImGui_EndPopup();
    }
    if table.IsSortSpecsDirty && table.Flags & ImGuiTableFlags_Sortable {
        ImGui_TableSortSpecsBuild(table);
    }
    if table.FreezeColumnsRequest > 0 {
        table.InnerWindow.DecoInnerSizeX1 = table.Columns.Data[table.DisplayOrderToIndex.Data[table.FreezeColumnsRequest - 1]].MaxX - table.OuterRect.Min.x;
    }
    if table.FreezeRowsRequest > 0 {
        table.InnerWindow.DecoInnerSizeY1 = table_instance.LastFrozenHeight;
    }
    table_instance.LastFrozenHeight = 0.0f;
    ImGuiWindow* inner_window = table.InnerWindow;
    ImGuiBoxSelectState* bs = &g.BoxSelectState;
    if bs.Window == inner_window && bs.UnclipMode {
        ImGui_TableApplyExternalUnclipRect(table, &bs.UnclipRect);
    }
    if (table.Flags & ImGuiTableFlags_NoClip) != 0 {
        ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, inner_window.DrawList, TABLE_DRAW_CHANNEL_NOCLIP);
    } else {
        ImDrawList_PushClipRect(inner_window.DrawList, inner_window.InnerClipRect.Min, inner_window.InnerClipRect.Max, false);
    }
}

// When starting a BeginMultiSelect() after table has been layout we update IsRequestOutput fields.
void ImGui_TableApplyExternalUnclipRect(ImGuiTable* table, ImRect* rect) {
    if ImRect_IsInverted(rect) != 0 {
        return;
    }
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        if column.IsRequestOutput == 0 {
            if ImRect_Overlaps(rect, ImRect{
                ImVec2{column.MinX, table.WorkRect.Min.y},
                ImVec2{column.MaxX, FLT_MAX},
            }) != 0 {
                column.IsRequestOutput = true;
            }
        }
    }
}

// Process hit-testing on resizing borders. Actual size change will be applied in EndTable()
// - Set table->HoveredColumnBorder with a short delay/timer to reduce visual feedback noise.
void ImGui_TableUpdateBorders(ImGuiTable* table) {
    ImGuiContext* g = GImGui;
    assert(table.Flags & ImGuiTableFlags_Resizable);
    ImGuiTableInstanceData* table_instance = ImGui_TableGetInstanceData(table, table.InstanceCurrent);
    f32 hit_half_width = ImTrunc(TABLE_RESIZE_SEPARATOR_HALF_THICKNESS * g.CurrentDpiScale);
    f32 hit_y1 = (table.FreezeRowsCount >= 1 ? table.OuterRect.Min.y : table.WorkRect.Min.y) + table.AngledHeadersHeight;
    f32 hit_y2_body = ImMax(table.OuterRect.Max.y, hit_y1 + table_instance.LastOuterHeight - table.AngledHeadersHeight);
    f32 hit_y2_head = hit_y1 + table_instance.LastTopHeadersRowHeight;
    for i32 order_n = 0; order_n < table.ColumnsCount; order_n++ {
        if (table.EnabledMaskByDisplayOrder[order_n >> 5] & cast(ImU32, 1) << cast(u32, order_n & 31)) != 0 == 0 {
            continue;
        }
        i32 column_n = table.DisplayOrderToIndex.Data[order_n];
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        if (column.Flags & (ImGuiTableColumnFlags_NoResize | ImGuiTableColumnFlags_NoDirectResize_)) != 0 {
            continue;
        }
        f32 border_y2_hit = (table.Flags & ImGuiTableFlags_NoBordersInBody) != 0 ? hit_y2_head : hit_y2_body;
        if table.Flags & ImGuiTableFlags_NoBordersInBody && table.IsUsingHeaders == false {
            continue;
        }
        if !column.IsVisibleX && table.LastResizedColumn != column_n {
            continue;
        }
        ImGuiID column_id = ImGui_TableGetColumnResizeID(table, column_n, cast(i32, table.InstanceCurrent));
        ImRect hit_rect;
        ImRect_init(&hit_rect, column.MaxX - hit_half_width, hit_y1, column.MaxX + hit_half_width, border_y2_hit);
        ImGui_ItemAdd(hit_rect, column_id, null, ImGuiItemFlags_NoNav);
        bool hovered = false;
        bool held = false;
        bool pressed = ImGui_ButtonBehavior(hit_rect, column_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren | ImGuiButtonFlags_PressedOnClick | ImGuiButtonFlags_PressedOnDoubleClick | ImGuiButtonFlags_NoNavFocus);
        if pressed && ImGui_IsMouseDoubleClicked(0) {
            ImGui_TableSetColumnWidthAutoSingle(table, column_n);
            ImGui_ClearActiveID();
            held = false;
        }
        if held != 0 {
            if table.LastResizedColumn == -1 {
                table.ResizeLockMinContentsX2 = table.RightMostEnabledColumn != -1 ? table.Columns.Data[table.RightMostEnabledColumn].MaxX : cast(f32, -FLT_MAX);
            }
            table.ResizedColumn = cast(ImGuiTableColumnIdx, column_n);
            table.InstanceInteracted = table.InstanceCurrent;
        }
        if hovered && g.HoveredIdTimer > TABLE_RESIZE_SEPARATOR_FEEDBACK_TIMER || held {
            table.HoveredColumnBorder = cast(ImGuiTableColumnIdx, column_n);
            ImGui_SetMouseCursor(ImGuiMouseCursor_ResizeEW);
        }
    }
}

void ImGui_EndTable() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    while true {
        if table != null == 0 {
            if ImGui_ErrorLog("EndTable() call should only be done while in BeginTable() scope!") != 0 {
                assert(table != null && "EndTable() call should only be done while in BeginTable() scope!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    if table.IsLayoutLocked == 0 {
        ImGui_TableUpdateLayout(table);
    }
    ImGuiTableFlags flags = table.Flags;
    ImGuiWindow* inner_window = table.InnerWindow;
    ImGuiWindow* outer_window = table.OuterWindow;
    ImGuiTableTempData* temp_data = table.TempData;
    assert(inner_window == g.CurrentWindow && inner_window.ID == temp_data.WindowID);
    assert(outer_window == inner_window || outer_window == inner_window.ParentWindow);
    if table.IsInsideRow != 0 {
        ImGui_TableEndRow(table);
    }
    if (flags & ImGuiTableFlags_ContextMenuInBody) != 0 {
        if table.HoveredColumnBody != -1 && !ImGui_IsAnyItemHovered() && ImGui_IsMouseReleased(ImGuiMouseButton_Right) {
            ImGui_TableOpenContextMenu(cast(i32, table.HoveredColumnBody));
        }
    }
    ImGuiTableInstanceData* table_instance = ImGui_TableGetInstanceData(table, table.InstanceCurrent);
    inner_window.DC.PrevLineSize = temp_data.HostBackupPrevLineSize;
    inner_window.DC.CurrLineSize = temp_data.HostBackupCurrLineSize;
    inner_window.DC.CursorMaxPos = temp_data.HostBackupCursorMaxPos;
    f32 inner_content_max_y = ceil(table.RowPosY2);
    assert(table.RowPosY2 == inner_window.DC.CursorPos.y);
    if inner_window != outer_window {
        inner_window.DC.CursorMaxPos.y = inner_content_max_y;
    } else if (flags & ImGuiTableFlags_NoHostExtendY) == 0 {
        table.InnerRect.Max.y = ImMax(table.OuterRect.Max.y, inner_content_max_y);
        table.OuterRect.Max.y = table.InnerRect.Max.y;
    }
    table.WorkRect.Max.y = ImMax(table.WorkRect.Max.y, table.OuterRect.Max.y);
    table_instance.LastOuterHeight = ImRect_GetHeight(&table.OuterRect);
    if (table.Flags & ImGuiTableFlags_ScrollX) != 0 {
        f32 outer_padding_for_border = (table.Flags & ImGuiTableFlags_BordersOuterV) != 0 ? TABLE_BORDER_SIZE : 0.0f;
        f32 max_pos_x = inner_window.DC.CursorMaxPos.x;
        if table.RightMostEnabledColumn != -1 {
            max_pos_x = ImMax(max_pos_x, table.Columns.Data[table.RightMostEnabledColumn].WorkMaxX + table.CellPaddingX + table.OuterPaddingX - outer_padding_for_border);
        }
        if table.ResizedColumn != -1 {
            max_pos_x = ImMax(max_pos_x, table.ResizeLockMinContentsX2);
        }
        inner_window.DC.CursorMaxPos.x = max_pos_x + table.TempData.AngledHeadersExtraWidth;
    }
    if (flags & ImGuiTableFlags_NoClip) == 0 {
        ImDrawList_PopClipRect(inner_window.DrawList);
    }
    ImVec4 zz_cr = *ImVector_ImVec4_back(&inner_window.DrawList._ClipRectStack); inner_window.ClipRect = ImRect{ImVec2{zz_cr.x, zz_cr.y}, ImVec2{zz_cr.z, zz_cr.w}};
    if (flags & ImGuiTableFlags_Borders) != 0 {
        ImGui_TableDrawBorders(table);
    }
    ImDrawListSplitter* splitter = table.DrawSplitter;
    ImDrawListSplitter_SetCurrentChannel(splitter, inner_window.DrawList, 0);
    if (table.Flags & ImGuiTableFlags_NoClip) == 0 {
        ImGui_TableMergeDrawChannels(table);
    }
    ImDrawListSplitter_Merge(splitter, inner_window.DrawList);
    f32 auto_fit_width_for_fixed = 0.0f;
    f32 auto_fit_width_for_stretched = 0.0f;
    f32 auto_fit_width_for_stretched_min = 0.0f;
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        if (table.EnabledMaskByIndex[column_n >> 5] & cast(ImU32, 1) << cast(u32, column_n & 31)) != 0 {
            ImGuiTableColumn* column = &table.Columns.Data[column_n];
            f32 column_width_request = column.Flags & ImGuiTableColumnFlags_WidthFixed && !(column.Flags & ImGuiTableColumnFlags_NoResize) ? column.WidthRequest : ImGui_TableGetColumnWidthAuto(table, column);
            if (column.Flags & ImGuiTableColumnFlags_WidthFixed) != 0 {
                auto_fit_width_for_fixed += column_width_request;
            } else {
                auto_fit_width_for_stretched += column_width_request;
            }
            if column.Flags & ImGuiTableColumnFlags_WidthStretch && (column.Flags & ImGuiTableColumnFlags_NoResize) != 0 {
                auto_fit_width_for_stretched_min = ImMax(auto_fit_width_for_stretched_min, column_width_request / (column.StretchWeight / table.ColumnsStretchSumWeights));
            }
        }
    }
    f32 width_spacings = table.OuterPaddingX * 2.0f + (table.CellSpacingX1 + table.CellSpacingX2) * cast(f32, table.ColumnsEnabledCount - 1);
    table.ColumnsAutoFitWidth = width_spacings + table.CellPaddingX * 2.0f * cast(f32, table.ColumnsEnabledCount) + auto_fit_width_for_fixed + ImMax(auto_fit_width_for_stretched, auto_fit_width_for_stretched_min);
    if (table.Flags & ImGuiTableFlags_ScrollX) == 0 && inner_window != outer_window {
        inner_window.Scroll.x = 0.0f;
    } else if table.LastResizedColumn != -1 && table.ResizedColumn == -1 && inner_window.ScrollbarX && table.InstanceInteracted == table.InstanceCurrent {
        f32 neighbor_width_to_keep_visible = table.MinColumnWidth + table.CellPaddingX * 2.0f;
        ImGuiTableColumn* column = &table.Columns.Data[table.LastResizedColumn];
        if column.MaxX < table.InnerClipRect.Min.x {
            ImGui_SetScrollFromPosX(inner_window, column.MaxX - inner_window.Pos.x - neighbor_width_to_keep_visible, 1.0f);
        } else if column.MaxX > table.InnerClipRect.Max.x {
            ImGui_SetScrollFromPosX(inner_window, column.MaxX - inner_window.Pos.x + neighbor_width_to_keep_visible, 1.0f);
        }
    }
    if table.ResizedColumn != -1 && table.InstanceCurrent == table.InstanceInteracted {
        ImGuiTableColumn* column = &table.Columns.Data[table.ResizedColumn];
        f32 new_x2 = g.IO.MousePos.x - g.ActiveIdClickOffset.x + ImTrunc(TABLE_RESIZE_SEPARATOR_HALF_THICKNESS * g.CurrentDpiScale);
        f32 new_width = ImTrunc(new_x2 - column.MinX - table.CellSpacingX1 - table.CellPaddingX * 2.0f);
        table.ResizedColumnNextWidth = new_width;
    }
    table.IsActiveIdInTable = g.ActiveIdIsAlive != 0 && table.IsActiveIdAliveBeforeTable == false;
    while true {
        if *ImVector_ImGuiID_back(&inner_window.IDStack) == table_instance.TableInstanceID == 0 {
            if ImGui_ErrorLog("Mismatching PushID/PopID!") != 0 {
                assert(*ImVector_ImGuiID_back(&inner_window.IDStack) == table_instance.TableInstanceID && "Mismatching PushID/PopID!");
            }
        }
        if !(0 != 0) { break; }
    }
    while true {
        if outer_window.DC.ItemWidthStack.Size >= temp_data.HostBackupItemWidthStackSize == 0 {
            if ImGui_ErrorLog("Too many PopItemWidth!") != 0 {
                assert(outer_window.DC.ItemWidthStack.Size >= temp_data.HostBackupItemWidthStackSize && "Too many PopItemWidth!");
            }
        }
        if !(0 != 0) { break; }
    }
    if table.InstanceCurrent > 0 {
        ImGui_PopID();
    }
    ImGui_PopID();
    ImVec2 backup_outer_max_pos = outer_window.DC.CursorMaxPos;
    inner_window.WorkRect = temp_data.HostBackupWorkRect;
    inner_window.ParentWorkRect = temp_data.HostBackupParentWorkRect;
    inner_window.SkipItems = table.HostSkipItems;
    outer_window.DC.CursorPos = table.OuterRect.Min;
    outer_window.DC.ItemWidth = temp_data.HostBackupItemWidth;
    outer_window.DC.ItemWidthStack.Size = temp_data.HostBackupItemWidthStackSize;
    outer_window.DC.ColumnsOffset = temp_data.HostBackupColumnsOffset;
    if inner_window != outer_window {
        i16 backup_nav_layers_active_mask = inner_window.DC.NavLayersActiveMask;
        inner_window.DC.NavLayersActiveMask |= cast(i16, 1 << cast(i32, table.NavLayer));
        g.CurrentTable = null;
        ImGui_EndChild();
        g.CurrentTable = table;
        inner_window.DC.NavLayersActiveMask = backup_nav_layers_active_mask;
    } else {
        inner_window.DC.TreeDepth--;
        ImGui_ItemSize(ImRect_GetSize(&table.OuterRect));
        ImGui_ItemAdd(table.OuterRect, 0, null, 0);
    }
    if (table.Flags & ImGuiTableFlags_NoHostExtendX) != 0 {
        assert((table.Flags & ImGuiTableFlags_ScrollX) == 0);
        outer_window.DC.CursorMaxPos.x = ImMax(backup_outer_max_pos.x, table.OuterRect.Min.x + table.ColumnsAutoFitWidth);
    } else if temp_data.UserOuterSize.x <= 0.0f {
        f32 outer_content_max_x = table.OuterRect.Min.x + table.ColumnsAutoFitWidth;
        f32 decoration_size = table.TempData.AngledHeadersExtraWidth + (inner_window != outer_window ? inner_window.ScrollbarSizes.x : 0.0f);
        outer_window.DC.IdealMaxPos.x = ImMax(outer_window.DC.IdealMaxPos.x, outer_content_max_x + decoration_size - temp_data.UserOuterSize.x);
        outer_window.DC.CursorMaxPos.x = ImMax(backup_outer_max_pos.x, ImMin(table.OuterRect.Max.x, outer_content_max_x + decoration_size));
    } else {
        outer_window.DC.CursorMaxPos.x = ImMax(backup_outer_max_pos.x, table.OuterRect.Max.x);
    }
    if temp_data.UserOuterSize.y <= 0.0f {
        f32 outer_content_size_y = inner_window == outer_window ? inner_content_max_y - table.InnerRect.Min.y : inner_content_max_y - inner_window.DC.CursorStartPos.y;
        f32 outer_content_max_y = table.OuterRect.Min.y + outer_content_size_y;
        f32 decoration_size = inner_window != outer_window ? inner_window.ScrollbarSizes.y : 0.0f;
        outer_window.DC.IdealMaxPos.y = ImMax(outer_window.DC.IdealMaxPos.y, outer_content_max_y + decoration_size - temp_data.UserOuterSize.y);
        outer_window.DC.CursorMaxPos.y = ImMax(backup_outer_max_pos.y, ImMin(table.OuterRect.Max.y, outer_content_max_y + decoration_size));
    } else {
        outer_window.DC.CursorMaxPos.y = ImMax(backup_outer_max_pos.y, table.OuterRect.Max.y);
    }
    if table.IsSettingsDirty != 0 {
        ImGui_TableSaveSettings(table);
    }
    table.IsInitializing = false;
    assert(g.CurrentWindow == outer_window && g.CurrentTable == table);
    assert(g.TablesTempDataStacked > 0);
    temp_data = --g.TablesTempDataStacked > 0 ? &g.TablesTempData.Data[g.TablesTempDataStacked - 1] : null;
    g.CurrentTable = temp_data && temp_data.WindowID == outer_window.ID ? ImPool_ImGuiTable_GetByIndex(&g.Tables, temp_data.TableIndex) : null;
    if g.CurrentTable != null {
        g.CurrentTable.TempData = temp_data;
        g.CurrentTable.DrawSplitter = &temp_data.DrawSplitter;
    }
    outer_window.DC.CurrentTableIdx = g.CurrentTable != null ? ImPool_ImGuiTable_GetIndex(&g.Tables, g.CurrentTable) : -1;
    ImGui_NavUpdateCurrentWindowIsScrollPushableX();
}

// Called in TableUpdateLayout() when initializing/after loading settings.
// 'init_mask' specify which fields to initialize.
void ImGui_TableInitColumnDefaults(ImGuiTable* table, ImGuiTableColumn* column, ImGuiTableColumnFlags init_mask) {
    ImGuiTableColumnFlags flags = column.Flags;
    if (init_mask & ImGuiTableFlags_Resizable) != 0 {
        f32 init_width_or_weight = column.InitStretchWeightOrWidth;
        column.WidthRequest = flags & ImGuiTableColumnFlags_WidthFixed && init_width_or_weight > 0.0f ? init_width_or_weight : -1.0f;
        column.StretchWeight = init_width_or_weight > 0.0f && flags & ImGuiTableColumnFlags_WidthStretch ? init_width_or_weight : -1.0f;
        if init_width_or_weight > 0.0f {
            column.AutoFitQueue = 0x00;
        }
    }
    if (init_mask & ImGuiTableFlags_Reorderable) != 0 {
        column.DisplayOrder = cast(ImGuiTableColumnIdx, (table.Flags & ImGuiTableFlags_Reorderable) != 0 ? -1 : ImSpan_ImGuiTableColumn_index_from_ptr(&table.Columns, column));
    }
    if (init_mask & ImGuiTableFlags_Hideable) != 0 {
        column.IsUserEnabledNextFrame = ((flags & ImGuiTableColumnFlags_DefaultHide) != 0 ? 0 : 1) != 0;
        column.IsUserEnabled = column.IsUserEnabledNextFrame;
    }
    if (init_mask & ImGuiTableFlags_Sortable) != 0 {
        column.SortOrder = cast(ImGuiTableColumnIdx, (flags & ImGuiTableColumnFlags_DefaultSort) != 0 ? 0 : -1);
        column.SortDirection = cast(ImU8, (flags & ImGuiTableColumnFlags_DefaultSort) != 0 ? (flags & ImGuiTableColumnFlags_PreferSortDescending) != 0 ? cast(ImS8, ImGuiSortDirection_Descending) : cast(ImU8, ImGuiSortDirection_Ascending) : cast(ImS8, ImGuiSortDirection_None));
    }
}

// See "COLUMNS SIZING POLICIES" comments at the top of this file
// If (init_width_or_weight <= 0.0f) it is ignored
private {
void TableSetupColumnApply(ImGuiTable* table, i32 idx, ImGuiID id, ImS16 name_offset, ImGuiTableColumnFlags flags, f32 init_width_or_weight, ImGuiID user_data) {
    ImGuiTableColumn* column = &table.Columns.Data[idx];
    if table.IsDefaultSizingPolicy && (flags & ImGuiTableColumnFlags_WidthMask_) == 0 && (flags & ImGuiTableFlags_ScrollX) == 0 {
        while true {
            if init_width_or_weight <= 0.0f == 0 {
                if ImGui_ErrorLog("TableSetupColumn(): can only specify width/weight if sizing policy is set explicitly in either Table or Column.") != 0 {
                    assert(init_width_or_weight <= 0.0f && "TableSetupColumn(): can only specify width/weight if sizing policy is set explicitly in either Table or Column.");
                }
                return;
            }
            if !(0 != 0) { break; }
        }
    }
    if (flags & ImGuiTableColumnFlags_WidthMask_) == 0 && init_width_or_weight > 0.0f {
        if (table.Flags & ImGuiTableFlags_SizingMask_) == ImGuiTableFlags_SizingFixedFit || (table.Flags & ImGuiTableFlags_SizingMask_) == ImGuiTableFlags_SizingFixedSame {
            flags |= ImGuiTableColumnFlags_WidthFixed;
        }
    }
    if (flags & ImGuiTableColumnFlags_AngledHeader) != 0 {
        flags |= ImGuiTableColumnFlags_NoHeaderLabel;
        table.AngledHeadersCount++;
    }
    TableSetupColumnFlags(table, column, flags);
    column.ID = id;
    column.UserData = user_data;
    column.NameOffset = name_offset;
    column.InitStretchWeightOrWidth = init_width_or_weight;
}
}

void ImGui_TableSetupColumn(u8* label, ImGuiTableColumnFlags flags, f32 init_width_or_weight, ImGuiID user_data) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    while true {
        if table != null == 0 {
            if ImGui_ErrorLog("Call should only be done while in BeginTable() scope!") != 0 {
                assert(table != null && "Call should only be done while in BeginTable() scope!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if table.DeclColumnsCount < table.ColumnsCount == 0 {
            if ImGui_ErrorLog("TableSetupColumn(): called too many times!") != 0 {
                assert(table.DeclColumnsCount < table.ColumnsCount && "TableSetupColumn(): called too many times!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    while true {
        if table.IsLayoutLocked == false == 0 {
            if ImGui_ErrorLog("TableSetupColumn(): need to call before first row!") != 0 {
                assert(table.IsLayoutLocked == false && "TableSetupColumn(): need to call before first row!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    assert((flags & ImGuiTableColumnFlags_StatusMask_) == 0 && "Illegal to pass StatusMask values to TableSetupColumn()");
    var name_offset = cast(ImS16, -1);
    if label != null && label[0] != 0 {
        name_offset = cast(ImS16, ImGuiTextBuffer_size(&table.ColumnsNames));
        ImGuiTextBuffer_append(&table.ColumnsNames, label, label + strlen(label) + 1);
    }
    ImGuiID column_id = label != null && label[0] != 0 ? ImHashStr(label, 0, 0) : 0;
    i32 column_idx = table.DeclColumnsCount++;
    ImGuiTableColumn* column = &table.Columns.Data[column_idx];
    if table.IsReconcileMode == false && column.ID != column_id {
        table.IsReconcileMode = true;
        ImVector_ImGuiTableReconcileColumnData_reserve(&table.TempData.ReconcileColumnsRequests, table.ColumnsCount - column_idx);
    }
    if table.IsReconcileMode == false {
        TableSetupColumnApply(table, column_idx, column_id, name_offset, flags, init_width_or_weight, user_data);
        column.IsNeedReconcileDst = false;
        column.IsNeedReconcileSrc = column.IsNeedReconcileDst;
        if column_idx < ImSpan_ImGuiTableColumn_size(&table.TempData.OldColumnsData) {
            table.TempData.OldColumnsData.Data[column_idx].IsNeedReconcileSrc = false;
        }
        return;
    }
    ImVector_ImGuiTableReconcileColumnData_push_back(&table.TempData.ReconcileColumnsRequests, ImGuiTableReconcileColumnData{});
    ImGuiTableReconcileColumnData* reconcile_data = ImVector_ImGuiTableReconcileColumnData_back(&table.TempData.ReconcileColumnsRequests);
    reconcile_data.ID = column_id;
    reconcile_data.NameOffset = name_offset;
    reconcile_data.Flags = flags;
    reconcile_data.InitWidthOrWeight = init_width_or_weight;
    reconcile_data.UserData = user_data;
    reconcile_data.ColumnNewIdx = cast(ImGuiTableColumnIdx, column_idx);
    reconcile_data.ColumnOldIdx = cast(ImGuiTableColumnIdx, -1);
    column.NameOffset = name_offset;
    column.IsNeedReconcileDst = true;
    column.IsNeedReconcileSrc = column.IsNeedReconcileDst;
}

// NB: This was written to be similar to the logic in TableLoadSettingsForColumns().
void ImGui_TableReconcileColumns(ImGuiTable* table) {
    ImGuiContext* g = GImGui;
    ImGuiTableTempData* temp_data = table.TempData;
    ignore *g;
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventTable) != 0 {
        }
        if !(0 != 0) { break; }
    }
    ImSpan_ImGuiTableColumn* dst_columns = &table.Columns;
    ImSpan_ImGuiTableColumn* src_columns = ImSpan_ImGuiTableColumn_empty(&table.TempData.OldColumnsData) != 0 ? &table.Columns : &table.TempData.OldColumnsData;
    i32 matches = 0;
    ImVector_ImGuiTableReconcileColumnData* reconcile_requests = &temp_data.ReconcileColumnsRequests;
    {
        ImGuiTableReconcileColumnData* zz_rf_it_6 = ImVector_ImGuiTableReconcileColumnData_begin(reconcile_requests);
        ImGuiTableReconcileColumnData* zz_rf_end_6 = ImVector_ImGuiTableReconcileColumnData_end(reconcile_requests);
        for ; zz_rf_it_6 != zz_rf_end_6; zz_rf_it_6++ {
            ImGuiTableReconcileColumnData* reconcile_data = zz_rf_it_6;
            if reconcile_data.ID != 0 {
                ImGuiTableColumn* zz_rf_it_5 = ImSpan_ImGuiTableColumn_begin(src_columns);
                ImGuiTableColumn* zz_rf_end_5 = ImSpan_ImGuiTableColumn_end(src_columns);
                for ; zz_rf_it_5 != zz_rf_end_5; zz_rf_it_5++ {
                    ImGuiTableColumn* src_column = zz_rf_it_5;
                    if src_column.ID == reconcile_data.ID && src_column.IsNeedReconcileSrc {
                        ImGuiTableColumn* dst_column = &dst_columns.Data[reconcile_data.ColumnNewIdx];
                        assert(src_column.IsNeedReconcileSrc && dst_column.IsNeedReconcileDst);
                        dst_column.IsNeedReconcileDst = false;
                        src_column.IsNeedReconcileSrc = dst_column.IsNeedReconcileDst;
                        reconcile_data.ColumnOldIdx = cast(ImGuiTableColumnIdx, ImSpan_ImGuiTableColumn_index_from_ptr(src_columns, src_column));
                        reconcile_data.ColumnOldData = *src_column;
                        matches++;
                        break;
                    }
                }
            }
        }
    }
    i32 dst_idx = 0;
    if matches != reconcile_requests.Size {
        ImGuiTableColumn* zz_rf_it_7 = ImSpan_ImGuiTableColumn_begin(src_columns);
        ImGuiTableColumn* zz_rf_end_7 = ImSpan_ImGuiTableColumn_end(src_columns);
        for ; zz_rf_it_7 != zz_rf_end_7; zz_rf_it_7++ {
            ImGuiTableColumn* src_column = zz_rf_it_7;
            if src_column.IsNeedReconcileSrc == 0 {
                continue;
            }
            while dst_idx < reconcile_requests.Size && reconcile_requests.Data[dst_idx].ColumnOldIdx != cast(ImGuiTableColumnIdx, -1) {
                dst_idx++;
            }
            if dst_idx == reconcile_requests.Size {
                break;
            }
            ImGuiTableReconcileColumnData* reconcile_data = &reconcile_requests.Data[dst_idx];
            ImGuiTableColumn* dst_column = &dst_columns.Data[reconcile_data.ColumnNewIdx];
            assert(src_column.IsNeedReconcileSrc && dst_column.IsNeedReconcileDst);
            dst_column.IsNeedReconcileDst = false;
            src_column.IsNeedReconcileSrc = dst_column.IsNeedReconcileDst;
            reconcile_data.ColumnOldIdx = cast(ImGuiTableColumnIdx, ImSpan_ImGuiTableColumn_index_from_ptr(src_columns, src_column));
            reconcile_data.ColumnOldData = *src_column;
        }
    }
    {
        ImGuiTableReconcileColumnData* zz_rf_it_8 = ImVector_ImGuiTableReconcileColumnData_begin(reconcile_requests);
        ImGuiTableReconcileColumnData* zz_rf_end_8 = ImVector_ImGuiTableReconcileColumnData_end(reconcile_requests);
        for ; zz_rf_it_8 != zz_rf_end_8; zz_rf_it_8++ {
            ImGuiTableReconcileColumnData* reconcile_data = zz_rf_it_8;
            table.Columns.Data[reconcile_data.ColumnNewIdx] = reconcile_data.ColumnOldData;
            TableSetupColumnApply(table, reconcile_data.ColumnNewIdx, reconcile_data.ID, reconcile_data.NameOffset, reconcile_data.Flags, reconcile_data.InitWidthOrWeight, reconcile_data.UserData);
            while true {
                if (g.DebugLogFlags & ImGuiDebugLogFlags_EventTable) != 0 {
                }
                if !(0 != 0) { break; }
            }
        }
    }
    ImGui_TableFixDisplayOrder(table);
    table.IsSettingsDirty = true;
    table.IsReconcileMode = false;
    ImVector_ImGuiTableReconcileColumnData_resize(reconcile_requests, 0);
}

// [Public]
void ImGui_TableSetupScrollFreeze(i32 columns, i32 rows) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    while true {
        if table != null == 0 {
            if ImGui_ErrorLog("Call should only be done while in BeginTable() scope!") != 0 {
                assert(table != null && "Call should only be done while in BeginTable() scope!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    assert(table.IsLayoutLocked == false && "TableSetupColumn(): need to call before first row!");
    assert(columns >= 0 && columns < 512);
    assert(rows >= 0 && rows < 128);
    table.FreezeColumnsRequest = (table.Flags & ImGuiTableFlags_ScrollX) != 0 ? cast(ImGuiTableColumnIdx, ImMin(columns, table.ColumnsCount)) : 0;
    table.FreezeColumnsCount = table.InnerWindow.Scroll.x != 0.0f ? table.FreezeColumnsRequest : 0;
    table.FreezeRowsRequest = (table.Flags & ImGuiTableFlags_ScrollY) != 0 ? cast(ImGuiTableColumnIdx, rows) : 0;
    table.FreezeRowsCount = table.InnerWindow.Scroll.y != 0.0f ? table.FreezeRowsRequest : 0;
    table.IsUnfrozenRows = table.FreezeRowsCount == 0;
}

//-----------------------------------------------------------------------------
// [SECTION] Tables: Simple accessors
//-----------------------------------------------------------------------------
// - TableGetColumnCount()
// - TableGetColumnName()
// - TableGetColumnName() [Internal]
// - TableSetColumnEnabled()
// - TableGetColumnFlags()
// - TableGetCellBgRect() [Internal]
// - TableGetColumnResizeID() [Internal]
// - TableGetHoveredColumn() [Internal]
// - TableGetHoveredRow() [Internal]
// - TableSetBgColor()
//-----------------------------------------------------------------------------
i32 ImGui_TableGetColumnCount() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    return table != null ? table.ColumnsCount : 0;
}

u8* ImGui_TableGetColumnName(i32 column_n) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table == null {
        return null;
    }
    if column_n < 0 {
        column_n = table.CurrentColumn;
    }
    return ImGui_TableGetColumnName(table, column_n);
}

u8* ImGui_TableGetColumnName(ImGuiTable* table, i32 column_n) {
    if table.IsLayoutLocked == false && column_n >= table.DeclColumnsCount {
        return "";
    }
    ImGuiTableColumn* column = &table.Columns.Data[column_n];
    if column.NameOffset == -1 {
        return "";
    }
    return &table.ColumnsNames.Buf.Data[column.NameOffset];
}

// Change user accessible enabled/disabled state of a column (often perceived as "showing/hiding" from users point of view)
// Note that end-user can use the context menu to change this themselves (right-click in headers, or right-click in columns body with ImGuiTableFlags_ContextMenuInBody)
// - Require table to have the ImGuiTableFlags_Hideable flag because we are manipulating user accessible state.
// - Request will be applied during next layout, which happens on the first call to TableNextRow() after BeginTable().
// - For the getter you can test (TableGetColumnFlags() & ImGuiTableColumnFlags_IsEnabled) != 0.
// - Alternative: the ImGuiTableColumnFlags_Disabled is an overriding/master disable flag which will also hide the column from context menu.
void ImGui_TableSetColumnEnabled(i32 column_n, bool enabled) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    while true {
        if table != null == 0 {
            if ImGui_ErrorLog("Call should only be done while in BeginTable() scope!") != 0 {
                assert(table != null && "Call should only be done while in BeginTable() scope!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    assert(table.Flags & ImGuiTableFlags_Hideable);
    if column_n < 0 {
        column_n = table.CurrentColumn;
    }
    assert(column_n >= 0 && column_n < table.ColumnsCount);
    ImGuiTableColumn* column = &table.Columns.Data[column_n];
    column.IsUserEnabledNextFrame = enabled;
}

// We allow querying for an extra column in order to poll the IsHovered state of the right-most section
ImGuiTableColumnFlags ImGui_TableGetColumnFlags(i32 column_n) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table == null {
        return ImGuiTableColumnFlags_None;
    }
    if column_n < 0 {
        column_n = table.CurrentColumn;
    }
    if column_n == table.ColumnsCount {
        return table.HoveredColumnBody == column_n ? ImGuiTableColumnFlags_IsHovered : ImGuiTableColumnFlags_None;
    }
    return table.Columns.Data[column_n].Flags;
}

// Return the cell rectangle based on currently known height.
// - Important: we generally don't know our row height until the end of the row, so Max.y will be incorrect in many situations.
//   The only case where this is correct is if we provided a min_row_height to TableNextRow() and don't go below it, or in TableEndRow() when we locked that height.
// - Important: if ImGuiTableFlags_PadOuterX is set but ImGuiTableFlags_PadInnerX is not set, the outer-most left and right
//   columns report a small offset so their CellBgRect can extend up to the outer border.
//   FIXME: But the rendering code in TableEndRow() nullifies that with clamping required for scrolling.
ImRect ImGui_TableGetCellBgRect(ImGuiTable* table, i32 column_n) {
    ImGuiTableColumn* column = &table.Columns.Data[column_n];
    f32 x1 = column.MinX;
    f32 x2 = column.MaxX;
    x1 = ImMax(x1, table.WorkRect.Min.x);
    x2 = ImMin(x2, table.WorkRect.Max.x);
    return ImRect{ImVec2{x1, table.RowPosY1}, ImVec2{x2, table.RowPosY2}};
}

// Return the resizing ID for the right-side of the given column.
ImGuiID ImGui_TableGetColumnResizeID(ImGuiTable* table, i32 column_n, i32 instance_no) {
    assert(column_n >= 0 && column_n < table.ColumnsCount);
    ImGuiID instance_id = ImGui_TableGetInstanceID(table, instance_no);
    return instance_id + 1 + cast(u32, column_n);
}

// Return -1 when table is not hovered. return columns_count if hovering the unused space at the right of the right-most visible column.
i32 ImGui_TableGetHoveredColumn() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table == null {
        return -1;
    }
    return cast(i32, table.HoveredColumnBody);
}

// Return -1 when table is not hovered. Return maxrow+1 if in table but below last submitted row.
// *IMPORTANT* Unlike TableGetHoveredColumn(), this has a one frame latency in updating the value.
// This difference with is the reason why this is not public yet.
i32 ImGui_TableGetHoveredRow() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table == null {
        return -1;
    }
    ImGuiTableInstanceData* table_instance = ImGui_TableGetInstanceData(table, table.InstanceCurrent);
    return table_instance.HoveredRowLast;
}

void ImGui_TableSetBgColor(ImGuiTableBgTarget target, ImU32 color, i32 column_n) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    while true {
        if table != null == 0 {
            if ImGui_ErrorLog("Call should only be done while in BeginTable() scope!") != 0 {
                assert(table != null && "Call should only be done while in BeginTable() scope!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    assert(target != ImGuiTableBgTarget_None);
    if color == (cast(ImU32, 1) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 0) << 8 | cast(ImU32, 0) << 0) {
        color = 0;
    }
    switch target {
        case ImGuiTableBgTarget_CellBg: {
            {
                if table.RowPosY1 > table.InnerClipRect.Max.y {
                    return;
                }
                if column_n == -1 {
                    column_n = table.CurrentColumn;
                }
                if (table.VisibleMaskByIndex[column_n >> 5] & cast(ImU32, 1) << cast(u32, column_n & 31)) != 0 == 0 {
                    return;
                }
                if table.RowCellDataCurrent < 0 || table.RowCellData.Data[table.RowCellDataCurrent].Column != column_n {
                    table.RowCellDataCurrent++;
                }
                ImGuiTableCellData* cell_data = &table.RowCellData.Data[table.RowCellDataCurrent];
                cell_data.BgColor = color;
                cell_data.Column = cast(ImGuiTableColumnIdx, column_n);
                break case;
            }
        }
        case ImGuiTableBgTarget_RowBg0, ImGuiTableBgTarget_RowBg1: {
            {
                if table.RowPosY1 > table.InnerClipRect.Max.y {
                    return;
                }
                assert(column_n == -1);
                i32 bg_idx = target == ImGuiTableBgTarget_RowBg1 ? 1 : 0;
                table.RowBgColor[bg_idx] = color;
                break case;
            }
        }
        default: {
            assert(0);
        }
    }
}

//-------------------------------------------------------------------------
// [SECTION] Tables: Row changes
//-------------------------------------------------------------------------
// - TableGetRowIndex()
// - TableNextRow()
// - TableBeginRow() [Internal]
// - TableEndRow() [Internal]
//-------------------------------------------------------------------------
// [Public] Note: for row coloring we use ->RowBgColorCounter which is the same value without counting header rows
i32 ImGui_TableGetRowIndex() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table == null {
        return 0;
    }
    return table.CurrentRow;
}

// [Public] Starts into the first cell of a new row
void ImGui_TableNextRow(ImGuiTableRowFlags row_flags, f32 row_min_height) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table.IsLayoutLocked == 0 {
        ImGui_TableUpdateLayout(table);
    }
    if table.IsInsideRow != 0 {
        ImGui_TableEndRow(table);
    }
    table.LastRowFlags = table.RowFlags;
    table.RowFlags = row_flags;
    table.RowCellPaddingY = g.Style.CellPadding.y;
    table.RowMinHeight = row_min_height;
    ImGui_TableBeginRow(table);
    table.RowPosY2 += table.RowCellPaddingY * 2.0f;
    table.RowPosY2 = ImMax(table.RowPosY2, table.RowPosY1 + row_min_height);
    table.InnerWindow.SkipItems = true;
}

// [Internal] Only called by TableNextRow()
void ImGui_TableBeginRow(ImGuiTable* table) {
    ImGuiWindow* window = table.InnerWindow;
    assert(cast(i64, !table.IsInsideRow));
    table.CurrentRow++;
    table.CurrentColumn = -1;
    table.RowBgColor[1] = cast(ImU32, 1) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 0) << 8 | cast(ImU32, 0) << 0;
    table.RowBgColor[0] = table.RowBgColor[1];
    table.RowCellDataCurrent = cast(ImGuiTableColumnIdx, -1);
    table.IsInsideRow = true;
    f32 next_y1 = table.RowPosY2;
    if table.CurrentRow == 0 && table.FreezeRowsCount > 0 {
        window.DC.CursorPos.y = table.OuterRect.Min.y;
        next_y1 = window.DC.CursorPos.y;
    }
    table.RowPosY2 = next_y1;
    table.RowPosY1 = table.RowPosY2;
    table.RowTextBaseline = 0.0f;
    table.RowIndentOffsetX = window.DC.Indent.x - table.HostIndentX;
    window.DC.PrevLineTextBaseOffset = 0.0f;
    window.DC.CursorPosPrevLine = ImVec2{
        window.DC.CursorPos.x, window.DC.CursorPos.y + table.RowCellPaddingY,
    };
    window.DC.CurrLineSize = ImVec2{0.0f, 0.0f};
    window.DC.PrevLineSize = window.DC.CurrLineSize;
    window.DC.IsSetPos = false;
    window.DC.IsSameLine = window.DC.IsSetPos;
    window.DC.CursorMaxPos.y = next_y1;
    if (table.RowFlags & ImGuiTableRowFlags_Headers) != 0 {
        ImGui_TableSetBgColor(ImGuiTableBgTarget_RowBg0, ImGui_GetColorU32(ImGuiCol_TableHeaderBg));
        if table.CurrentRow == 0 {
            table.IsUsingHeaders = true;
        }
    }
}

// [Internal] Called by TableNextRow()
void ImGui_TableEndRow(ImGuiTable* table) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    assert(window == table.InnerWindow);
    assert(cast(i64, table.IsInsideRow));
    if table.CurrentColumn != -1 {
        ImGui_TableEndCell(table);
        table.CurrentColumn = -1;
    }
    if g.LogEnabled != 0 {
        ImGui_LogRenderedText(null, "|", null);
    }
    window.DC.CursorPos.y = table.RowPosY2;
    f32 bg_y1 = table.RowPosY1;
    f32 bg_y2 = table.RowPosY2;
    bool unfreeze_rows_actual = table.CurrentRow + 1 == table.FreezeRowsCount;
    bool unfreeze_rows_request = table.CurrentRow + 1 == table.FreezeRowsRequest;
    ImGuiTableInstanceData* table_instance = ImGui_TableGetInstanceData(table, table.InstanceCurrent);
    if table.RowFlags & ImGuiTableRowFlags_Headers && (table.CurrentRow == 0 || table.LastRowFlags & ImGuiTableRowFlags_Headers) {
        table_instance.LastTopHeadersRowHeight += bg_y2 - bg_y1;
    }
    bool is_visible = bg_y2 >= table.InnerClipRect.Min.y && bg_y1 <= table.InnerClipRect.Max.y;
    if is_visible != 0 {
        if table.HoveredColumnBody != -1 && g.IO.MousePos.y >= bg_y1 && g.IO.MousePos.y < bg_y2 && table_instance.HoveredRowNext < 0 {
            table_instance.HoveredRowNext = table.CurrentRow;
        }
        ImU32 bg_col0 = 0;
        ImU32 bg_col1 = 0;
        if table.RowBgColor[0] != (cast(ImU32, 1) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 0) << 8 | cast(ImU32, 0) << 0) {
            bg_col0 = table.RowBgColor[0];
        } else if (table.Flags & ImGuiTableFlags_RowBg) != 0 {
            bg_col0 = ImGui_GetColorU32((table.RowBgColorCounter & 1) != 0 ? ImGuiCol_TableRowBgAlt : ImGuiCol_TableRowBg);
        }
        if table.RowBgColor[1] != (cast(ImU32, 1) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 0) << 8 | cast(ImU32, 0) << 0) {
            bg_col1 = table.RowBgColor[1];
        }
        ImU32 top_border_col = 0;
        f32 border_size = TABLE_BORDER_SIZE;
        if table.CurrentRow > 0 && table.Flags & ImGuiTableFlags_BordersInnerH {
            top_border_col = (table.LastRowFlags & ImGuiTableRowFlags_Headers) != 0 ? table.BorderColorStrong : table.BorderColorLight;
        }
        bool draw_cell_bg_color = table.RowCellDataCurrent >= 0;
        bool draw_strong_bottom_border = unfreeze_rows_actual;
        if (bg_col0 | bg_col1 | top_border_col) != 0 || draw_strong_bottom_border || draw_cell_bg_color {
            if (table.Flags & ImGuiTableFlags_NoClip) == 0 {
                window.DrawList._CmdHeader.ClipRect = ImRect_ToVec4(&table.Bg0ClipRectForDrawCmd);
            }
            ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, window.DrawList, TABLE_DRAW_CHANNEL_BG0);
        }
        if bg_col0 || bg_col1 {
            ImRect row_rect;
            ImRect_init(&row_rect, table.WorkRect.Min.x, bg_y1, table.WorkRect.Max.x, bg_y2);
            ImRect_ClipWith(&row_rect, table.BgClipRect);
            if bg_col0 != 0 && row_rect.Min.y < row_rect.Max.y {
                ImDrawList_AddRectFilled(window.DrawList, row_rect.Min, row_rect.Max, bg_col0, 0.0f, 0);
            }
            if bg_col1 != 0 && row_rect.Min.y < row_rect.Max.y {
                ImDrawList_AddRectFilled(window.DrawList, row_rect.Min, row_rect.Max, bg_col1, 0.0f, 0);
            }
        }
        if draw_cell_bg_color != 0 {
            ImGuiTableCellData* cell_data_end = &table.RowCellData.Data[table.RowCellDataCurrent];
            for ImGuiTableCellData* cell_data = &table.RowCellData.Data[0]; cell_data <= cell_data_end; cell_data++ {
                ImGuiTableColumn* column = &table.Columns.Data[cell_data.Column];
                ImRect cell_bg_rect = ImGui_TableGetCellBgRect(table, cast(i32, cell_data.Column));
                ImRect_ClipWith(&cell_bg_rect, table.BgClipRect);
                cell_bg_rect.Min.x = ImMax(cell_bg_rect.Min.x, column.ClipRect.Min.x);
                cell_bg_rect.Max.x = ImMin(cell_bg_rect.Max.x, column.MaxX);
                if cell_bg_rect.Min.y < cell_bg_rect.Max.y {
                    ImDrawList_AddRectFilled(window.DrawList, cell_bg_rect.Min, cell_bg_rect.Max, cell_data.BgColor, 0.0f, 0);
                }
            }
        }
        if top_border_col && bg_y1 >= table.BgClipRect.Min.y && bg_y1 < table.BgClipRect.Max.y {
            ImDrawList_AddLineH(window.DrawList, table.BorderX1, table.BorderX2, bg_y1, top_border_col, border_size);
        }
        if draw_strong_bottom_border && bg_y2 >= table.BgClipRect.Min.y && bg_y2 < table.BgClipRect.Max.y {
            ImDrawList_AddLineH(window.DrawList, table.BorderX1, table.BorderX2, bg_y2, table.BorderColorStrong, border_size);
        }
    }
    if unfreeze_rows_request != 0 {
        assert(table.FreezeRowsRequest > 0);
        for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
            table.Columns.Data[column_n].NavLayerCurrent = table.NavLayer;
        }
        f32 y0 = ImMax(table.RowPosY2 + 1.0f, table.InnerClipRect.Min.y);
        table_instance.LastFrozenHeight = y0 - table.OuterRect.Min.y;
        if unfreeze_rows_actual != 0 {
            assert(table.IsUnfrozenRows == false);
            table.IsUnfrozenRows = true;
            table.Bg2ClipRectForDrawCmd.Min.y = ImMin(y0, table.InnerClipRect.Max.y);
            table.BgClipRect.Min.y = table.Bg2ClipRectForDrawCmd.Min.y;
            table.Bg2ClipRectForDrawCmd.Max.y = table.InnerClipRect.Max.y;
            table.BgClipRect.Max.y = table.Bg2ClipRectForDrawCmd.Max.y;
            table.Bg2DrawChannelCurrent = table.Bg2DrawChannelUnfrozen;
            assert(table.Bg2ClipRectForDrawCmd.Min.y <= table.Bg2ClipRectForDrawCmd.Max.y);
            f32 row_height = table.RowPosY2 - table.RowPosY1;
            window.DC.CursorPos.y = table.WorkRect.Min.y + table.RowPosY2 - table.OuterRect.Min.y;
            table.RowPosY2 = window.DC.CursorPos.y;
            table.RowPosY1 = table.RowPosY2 - row_height;
            for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
                ImGuiTableColumn* column = &table.Columns.Data[column_n];
                column.DrawChannelCurrent = column.DrawChannelUnfrozen;
                column.ClipRect.Min.y = table.Bg2ClipRectForDrawCmd.Min.y;
            }
            ImGui_SetWindowClipRectBeforeSetChannel(window, table.Columns.Data[0].ClipRect);
            ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, window.DrawList, cast(i32, table.Columns.Data[0].DrawChannelCurrent));
        }
    }
    if (table.RowFlags & ImGuiTableRowFlags_Headers) == 0 {
        table.RowBgColorCounter++;
    }
    table.IsInsideRow = false;
}

//-------------------------------------------------------------------------
// [SECTION] Tables: Columns changes
//-------------------------------------------------------------------------
// - TableGetColumnIndex()
// - TableSetColumnIndex()
// - TableNextColumn()
// - TableBeginCell() [Internal]
// - TableEndCell() [Internal]
//-------------------------------------------------------------------------
i32 ImGui_TableGetColumnIndex() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table == null {
        return 0;
    }
    return table.CurrentColumn;
}

// [Public] Append into a specific column
bool ImGui_TableSetColumnIndex(i32 column_n) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table == null {
        return false;
    }
    if table.CurrentColumn != column_n {
        if table.CurrentColumn != -1 {
            ImGui_TableEndCell(table);
        }
        while true {
            if (column_n >= 0 && column_n < table.ColumnsCount) == 0 {
                if ImGui_ErrorLog("TableSetColumnIndex() invalid column index!") != 0 {
                    assert(column_n >= 0 && column_n < table.ColumnsCount && "TableSetColumnIndex() invalid column index!");
                }
                return false;
            }
            if !(0 != 0) { break; }
        }
        ImGui_TableBeginCell(table, column_n);
    }
    return table.Columns.Data[column_n].IsRequestOutput;
}

// [Public] Append into the next column, wrap and create a new row when already on last column
bool ImGui_TableNextColumn() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table == null {
        return false;
    }
    if table.IsInsideRow && table.CurrentColumn + 1 < table.ColumnsCount {
        if table.CurrentColumn != -1 {
            ImGui_TableEndCell(table);
        }
        ImGui_TableBeginCell(table, table.CurrentColumn + 1);
    } else {
        ImGui_TableNextRow();
        ImGui_TableBeginCell(table, 0);
    }
    return table.Columns.Data[table.CurrentColumn].IsRequestOutput;
}

// [Internal] Called by TableSetColumnIndex()/TableNextColumn()
// This is called very frequently, so we need to be mindful of unnecessary overhead.
// FIXME-TABLE FIXME-OPT: Could probably shortcut some things for non-active or clipped columns.
void ImGui_TableBeginCell(ImGuiTable* table, i32 column_n) {
    ImGuiContext* g = GImGui;
    ImGuiTableColumn* column = &table.Columns.Data[column_n];
    ImGuiWindow* window = table.InnerWindow;
    table.CurrentColumn = column_n;
    f32 start_x = column.WorkMinX;
    if (column.Flags & ImGuiTableColumnFlags_IndentEnable) != 0 {
        start_x += table.RowIndentOffsetX;
    }
    window.DC.CursorPos.x = start_x;
    window.DC.CursorPos.y = table.RowPosY1 + table.RowCellPaddingY;
    window.DC.CursorMaxPos.x = window.DC.CursorPos.x;
    window.DC.ColumnsOffset.x = start_x - window.Pos.x - window.DC.Indent.x;
    window.DC.CursorPosPrevLine.x = window.DC.CursorPos.x;
    window.DC.CurrLineTextBaseOffset = table.RowTextBaseline;
    window.DC.NavLayerCurrent = cast(ImGuiNavLayer, column.NavLayerCurrent);
    window.WorkRect.Min.y = window.DC.CursorPos.y;
    window.WorkRect.Min.x = column.WorkMinX;
    window.WorkRect.Max.x = column.WorkMaxX;
    window.DC.ItemWidth = column.ItemWidth;
    window.SkipItems = column.IsSkipItems;
    if column.IsSkipItems != 0 {
        g.LastItemData.ID = 0;
        g.LastItemData.StatusFlags = 0;
    }
    if (table.Flags & ImGuiTableFlags_NoClip) != 0 {
        ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, window.DrawList, TABLE_DRAW_CHANNEL_NOCLIP);
    } else {
        ImGui_SetWindowClipRectBeforeSetChannel(window, column.ClipRect);
        ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, window.DrawList, cast(i32, column.DrawChannelCurrent));
    }
    if g.LogEnabled && !column.IsSkipItems {
        ImGui_LogRenderedText(&window.DC.CursorPos, "|", null);
        g.LogLinePosY = FLT_MAX;
    }
}

// [Internal] Called by TableNextRow()/TableSetColumnIndex()/TableNextColumn()
void ImGui_TableEndCell(ImGuiTable* table) {
    ImGuiTableColumn* column = &table.Columns.Data[table.CurrentColumn];
    ImGuiWindow* window = table.InnerWindow;
    if window.DC.IsSetPos != 0 {
        ImGui_ErrorCheckUsingSetCursorPosToExtendParentBoundaries();
    }
    f32* p_max_pos_x;
    if (table.RowFlags & ImGuiTableRowFlags_Headers) != 0 {
        p_max_pos_x = &column.ContentMaxXHeadersUsed;
    } else {
        p_max_pos_x = table.IsUnfrozenRows != 0 ? &column.ContentMaxXUnfrozen : &column.ContentMaxXFrozen;
    }
    *p_max_pos_x = ImMax(*p_max_pos_x, window.DC.CursorMaxPos.x);
    if column.IsEnabled != 0 {
        table.RowPosY2 = ImMax(table.RowPosY2, window.DC.CursorMaxPos.y + table.RowCellPaddingY);
    }
    column.ItemWidth = window.DC.ItemWidth;
    table.RowTextBaseline = ImMax(table.RowTextBaseline, window.DC.PrevLineTextBaseOffset);
}

//-------------------------------------------------------------------------
// [SECTION] Tables: Columns width management
//-------------------------------------------------------------------------
// - TableGetMaxColumnWidth() [Internal]
// - TableGetColumnWidthAuto() [Internal]
// - TableSetColumnWidth()
// - TableSetColumnWidthAutoSingle() [Internal]
// - TableSetColumnWidthAutoAll() [Internal]
// - TableUpdateColumnsWeightFromWidth() [Internal]
//-------------------------------------------------------------------------
// Note that actual columns widths are computed in TableUpdateLayout().
//-------------------------------------------------------------------------
// Maximum column content width given current layout. Use column->MinX so this value differs on a per-column basis.
f32 ImGui_TableCalcMaxColumnWidth(ImGuiTable* table, i32 column_n) {
    ImGuiTableColumn* column = &table.Columns.Data[column_n];
    f32 max_width = FLT_MAX;
    f32 min_column_distance = table.MinColumnWidth + table.CellPaddingX * 2.0f + table.CellSpacingX1 + table.CellSpacingX2;
    if (table.Flags & ImGuiTableFlags_ScrollX) != 0 {
        if column.DisplayOrder < table.FreezeColumnsRequest {
            max_width = table.InnerClipRect.Max.x - cast(f32, table.FreezeColumnsRequest - column.DisplayOrder) * min_column_distance - column.MinX;
            max_width = max_width - table.OuterPaddingX - table.CellPaddingX - table.CellSpacingX2;
        }
    } else if (table.Flags & ImGuiTableFlags_NoKeepColumnsVisible) == 0 {
        max_width = table.WorkRect.Max.x - cast(f32, table.ColumnsEnabledCount - column.IndexWithinEnabledSet - 1) * min_column_distance - column.MinX;
        max_width -= table.CellSpacingX2;
        max_width -= table.CellPaddingX * 2.0f;
        max_width -= table.OuterPaddingX;
    }
    return max_width;
}

// Note this is meant to be stored in column->WidthAuto, please generally use the WidthAuto field
f32 ImGui_TableGetColumnWidthAuto(ImGuiTable* table, ImGuiTableColumn* column) {
    f32 content_width_body = ImMax(column.ContentMaxXFrozen, column.ContentMaxXUnfrozen) - column.WorkMinX;
    f32 content_width_headers = column.ContentMaxXHeadersIdeal - column.WorkMinX;
    f32 width_auto = content_width_body;
    if (column.Flags & ImGuiTableColumnFlags_NoHeaderWidth) == 0 {
        width_auto = ImMax(width_auto, content_width_headers);
    }
    if column.Flags & ImGuiTableColumnFlags_WidthFixed && column.InitStretchWeightOrWidth > 0.0f {
        if !(table.Flags & ImGuiTableFlags_Resizable) || column.Flags & ImGuiTableColumnFlags_NoResize {
            width_auto = column.InitStretchWeightOrWidth;
        }
    }
    return ImMax(width_auto, table.MinColumnWidth);
}

// 'width' = inner column width, without padding
void ImGui_TableSetColumnWidth(i32 column_n, f32 width) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    assert(table != null && table.IsLayoutLocked == false);
    assert(column_n >= 0 && column_n < table.ColumnsCount);
    ImGuiTableColumn* column_0 = &table.Columns.Data[column_n];
    f32 column_0_width = width;
    assert(table.MinColumnWidth > 0.0f);
    f32 min_width = table.MinColumnWidth;
    f32 max_width = ImMax(min_width, column_0.WidthMax);
    column_0_width = ImClamp(column_0_width, min_width, max_width);
    if column_0.WidthGiven == column_0_width || column_0.WidthRequest == column_0_width {
        return;
    }
    ImGuiTableColumn* column_1 = column_0.NextEnabledColumn != -1 ? &table.Columns.Data[column_0.NextEnabledColumn] : null;
    if (column_0.Flags & ImGuiTableColumnFlags_WidthFixed) != 0 {
        if !column_1 || table.LeftMostStretchedColumn == -1 || table.Columns.Data[table.LeftMostStretchedColumn].DisplayOrder >= column_0.DisplayOrder {
            column_0.WidthRequest = column_0_width;
            table.IsSettingsDirty = true;
            return;
        }
    }
    if column_1 == null {
        column_1 = column_0.PrevEnabledColumn != -1 ? &table.Columns.Data[column_0.PrevEnabledColumn] : null;
    }
    if column_1 == null {
        return;
    }
    f32 column_1_width = ImMax(column_1.WidthRequest - (column_0_width - column_0.WidthRequest), min_width);
    column_0_width = column_0.WidthRequest + column_1.WidthRequest - column_1_width;
    assert(column_0_width > 0.0f && column_1_width > 0.0f);
    column_0.WidthRequest = column_0_width;
    column_1.WidthRequest = column_1_width;
    if ((column_0.Flags | column_1.Flags) & ImGuiTableColumnFlags_WidthStretch) != 0 {
        ImGui_TableUpdateColumnsWeightFromWidth(table);
    }
    table.IsSettingsDirty = true;
}

// Disable clipping then auto-fit, will take 2 frames
// (we don't take a shortcut for unclipped columns to reduce inconsistencies when e.g. resizing multiple columns)
void ImGui_TableSetColumnWidthAutoSingle(ImGuiTable* table, i32 column_n) {
    ImGuiTableColumn* column = &table.Columns.Data[column_n];
    if column.IsEnabled == 0 {
        return;
    }
    column.CannotSkipItemsQueue = cast(ImU8, 1 << 0);
    table.AutoFitSingleColumn = cast(ImGuiTableColumnIdx, column_n);
}

void ImGui_TableSetColumnWidthAutoAll(ImGuiTable* table) {
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        if !column.IsEnabled && !(column.Flags & ImGuiTableColumnFlags_WidthStretch) {
            continue;
        }
        column.CannotSkipItemsQueue = cast(ImU8, 1 << 0);
        column.AutoFitQueue = cast(ImU8, 1 << 1);
    }
}

void ImGui_TableUpdateColumnsWeightFromWidth(ImGuiTable* table) {
    assert(table.LeftMostStretchedColumn != -1 && table.RightMostStretchedColumn != -1);
    f32 visible_weight = 0.0f;
    f32 visible_width = 0.0f;
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        if !column.IsEnabled || !(column.Flags & ImGuiTableColumnFlags_WidthStretch) {
            continue;
        }
        assert(column.StretchWeight > 0.0f);
        visible_weight += column.StretchWeight;
        visible_width += column.WidthRequest;
    }
    assert(visible_weight > 0.0f && visible_width > 0.0f);
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        if !column.IsEnabled || !(column.Flags & ImGuiTableColumnFlags_WidthStretch) {
            continue;
        }
        column.StretchWeight = column.WidthRequest / visible_width * visible_weight;
        assert(column.StretchWeight > 0.0f);
    }
}

//-------------------------------------------------------------------------
// [SECTION] Tables: Drawing
//-------------------------------------------------------------------------
// - TablePushBackgroundChannel() [Internal]
// - TablePopBackgroundChannel() [Internal]
// - TableSetupDrawChannels() [Internal]
// - TableMergeDrawChannels() [Internal]
// - TableGetColumnBorderCol() [Internal]
// - TableDrawBorders() [Internal]
//-------------------------------------------------------------------------
// FIXME: This could be abstracted and merged with PushColumnsBackground(), by creating a generic struct
// with storage for backup cliprect + backup channel + storage for splitter pointer, new clip rect.
// This would slightly simplify caller code.
// Bg2 is used by Selectable (and possibly other widgets) to render to the background.
// Unlike our Bg0/1 channel which we uses for RowBg/CellBg/Borders and where we guarantee all shapes to be CPU-clipped, the Bg2 channel being widgets-facing will rely on regular ClipRect.
void ImGui_TablePushBackgroundChannel() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiTable* table = g.CurrentTable;
    table.HostBackupInnerClipRect = window.ClipRect;
    ImGui_SetWindowClipRectBeforeSetChannel(window, table.Bg2ClipRectForDrawCmd);
    ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, window.DrawList, cast(i32, table.Bg2DrawChannelCurrent));
}

void ImGui_TablePopBackgroundChannel() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiTable* table = g.CurrentTable;
    ImGui_SetWindowClipRectBeforeSetChannel(window, table.HostBackupInnerClipRect);
    ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, window.DrawList, cast(i32, table.Columns.Data[table.CurrentColumn].DrawChannelCurrent));
}

// Also see TableBeginCell()
void ImGui_TablePushColumnChannel(i32 column_n) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if (table.Flags & ImGuiTableFlags_NoClip) != 0 {
        return;
    }
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiTableColumn* column = &table.Columns.Data[column_n];
    ImGui_SetWindowClipRectBeforeSetChannel(window, column.ClipRect);
    ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, window.DrawList, cast(i32, column.DrawChannelCurrent));
}

void ImGui_TablePopColumnChannel() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table.Flags & ImGuiTableFlags_NoClip || table.CurrentColumn == -1 {
        return;
    }
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiTableColumn* column = &table.Columns.Data[table.CurrentColumn];
    ImGui_SetWindowClipRectBeforeSetChannel(window, column.ClipRect);
    ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, window.DrawList, cast(i32, column.DrawChannelCurrent));
}

// Allocate draw channels. Called by TableUpdateLayout()
// - We allocate them following storage order instead of display order so reordering columns won't needlessly
//   increase overall dormant memory cost.
// - We isolate headers draw commands in their own channels instead of just altering clip rects.
//   This is in order to facilitate merging of draw commands.
// - After crossing FreezeRowsCount, all columns see their current draw channel changed to a second set of channels.
// - We only use the dummy draw channel so we can push a null clipping rectangle into it without affecting other
//   channels, while simplifying per-row/per-cell overhead. It will be empty and discarded when merged.
// - We allocate 1 or 2 background draw channels. This is because we know TablePushBackgroundChannel() is only used for
//   horizontal spanning. If we allowed vertical spanning we'd need one background draw channel per merge group (1-4).
// Draw channel allocation (before merging):
// - NoClip                       --> 2+D+1 channels: bg0/1 + bg2 + foreground (same clip rect == always 1 draw call)
// - Clip                         --> 2+D+N channels
// - FreezeRows                   --> 2+D+N*2 (unless scrolling value is zero)
// - FreezeRows || FreezeColumns  --> 3+D+N*2 (unless scrolling value is zero)
// Where D is 1 if any column is clipped or hidden (dummy channel) otherwise 0.
void ImGui_TableSetupDrawChannels(ImGuiTable* table) {
    i32 freeze_row_multiplier = table.FreezeRowsCount > 0 ? 2 : 1;
    i32 channels_for_row = (table.Flags & ImGuiTableFlags_NoClip) != 0 ? 1 : table.ColumnsEnabledCount;
    i32 channels_for_bg = 1 + 1 * freeze_row_multiplier;
    i32 channels_for_dummy = table.ColumnsEnabledCount < table.ColumnsCount || memcmp(table.VisibleMaskByIndex, table.EnabledMaskByIndex, ImBitArrayGetStorageSizeInBytes(table.ColumnsCount)) != 0 ? 1 : 0;
    i32 channels_total = channels_for_bg + channels_for_row * freeze_row_multiplier + channels_for_dummy;
    ImDrawListSplitter_Split(table.DrawSplitter, table.InnerWindow.DrawList, channels_total);
    table.DummyDrawChannel = cast(ImGuiTableDrawChannelIdx, channels_for_dummy > 0 ? channels_total - 1 : -1);
    table.Bg2DrawChannelCurrent = cast(ImGuiTableDrawChannelIdx, TABLE_DRAW_CHANNEL_BG2_FROZEN);
    table.Bg2DrawChannelUnfrozen = cast(ImGuiTableDrawChannelIdx, table.FreezeRowsCount > 0 ? 2 + channels_for_row : TABLE_DRAW_CHANNEL_BG2_FROZEN);
    i32 draw_channel_current = 2;
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        if column.IsVisibleX && column.IsVisibleY {
            column.DrawChannelFrozen = cast(ImGuiTableDrawChannelIdx, draw_channel_current);
            column.DrawChannelUnfrozen = cast(ImGuiTableDrawChannelIdx, draw_channel_current + (table.FreezeRowsCount > 0 ? channels_for_row + 1 : 0));
            if (table.Flags & ImGuiTableFlags_NoClip) == 0 {
                draw_channel_current++;
            }
        } else {
            column.DrawChannelUnfrozen = table.DummyDrawChannel;
            column.DrawChannelFrozen = column.DrawChannelUnfrozen;
        }
        column.DrawChannelCurrent = column.DrawChannelFrozen;
    }
    table.BgClipRect = table.InnerClipRect;
    table.Bg0ClipRectForDrawCmd = table.OuterWindow.ClipRect;
    table.Bg2ClipRectForDrawCmd = table.HostClipRect;
    assert(table.BgClipRect.Min.y <= table.BgClipRect.Max.y);
}

// This function reorder draw channels based on matching clip rectangle, to facilitate merging them. Called by EndTable().
// For simplicity we call it TableMergeDrawChannels() but in fact it only reorder channels + overwrite ClipRect,
// actual merging is done by table->DrawSplitter.Merge() which is called right after TableMergeDrawChannels().
//
// Columns where the contents didn't stray off their local clip rectangle can be merged. To achieve
// this we merge their clip rect and make them contiguous in the channel list, so they can be merged
// by the call to DrawSplitter.Merge() following to the call to this function.
// We reorder draw commands by arranging them into a maximum of 4 distinct groups:
//
//   1 group:               2 groups:              2 groups:              4 groups:
//   [ 0. ] no freeze       [ 0. ] row freeze      [ 01 ] col freeze      [ 01 ] row+col freeze
//   [ .. ]  or no scroll   [ 2. ]  and v-scroll   [ .. ]  and h-scroll   [ 23 ]  and v+h-scroll
//
// Each column itself can use 1 channel (row freeze disabled) or 2 channels (row freeze enabled).
// When the contents of a column didn't stray off its limit, we move its channels into the corresponding group
// based on its position (within frozen rows/columns groups or not).
// At the end of the operation our 1-4 groups will each have a ImDrawCmd using the same ClipRect.
// This function assume that each column are pointing to a distinct draw channel,
// otherwise merge_group->ChannelsCount will not match set bit count of merge_group->ChannelsMask.
//
// Column channels will not be merged into one of the 1-4 groups in the following cases:
// - The contents stray off its clipping rectangle (we only compare the MaxX value, not the MinX value).
//   Direct ImDrawList calls won't be taken into account by default, if you use them make sure the ImGui:: bounds
//   matches, by e.g. calling SetCursorScreenPos().
// - The channel uses more than one draw command itself. We drop all our attempt at merging stuff here..
//   we could do better but it's going to be rare and probably not worth the hassle.
// Columns for which the draw channel(s) haven't been merged with other will use their own ImDrawCmd.
//
// This function is particularly tricky to understand.. take a breath.
void ImGui_TableMergeDrawChannels(ImGuiTable* table) {
    ImGuiContext* g = GImGui;
    ImDrawListSplitter* splitter = table.DrawSplitter;
    bool has_freeze_v = table.FreezeRowsCount > 0;
    bool has_freeze_h = table.FreezeColumnsCount > 0;
    assert(splitter._Current == 0);
    i32 merge_group_mask = 0x00;
    MergeGroup[4] merge_groups;
    i32 max_draw_channels = 4 + table.ColumnsCount * 2;
    var size_for_masks_bitarrays_one = cast(i32, ImBitArrayGetStorageSizeInBytes(max_draw_channels));
    ImVector_char_reserve(&g.TempBuffer, size_for_masks_bitarrays_one * 5);
    memset(g.TempBuffer.Data, 0, cast(u64, size_for_masks_bitarrays_one * 5));
    for i32 n = 0; n < cast(i32, sizeof(merge_groups) / sizeof(*merge_groups)); n++ {
        merge_groups[n].ChannelsMask = cast(ImBitArrayPtr, cast(void*, g.TempBuffer.Data + size_for_masks_bitarrays_one * n));
    }
    var remaining_mask = cast(ImBitArrayPtr, cast(void*, g.TempBuffer.Data + size_for_masks_bitarrays_one * 4));
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        if (table.VisibleMaskByIndex[column_n >> 5] & cast(ImU32, 1) << cast(u32, column_n & 31)) != 0 == 0 {
            continue;
        }
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        i32 merge_group_sub_count = has_freeze_v != 0 ? 2 : 1;
        for i32 merge_group_sub_n = 0; merge_group_sub_n < merge_group_sub_count; merge_group_sub_n++ {
            var channel_no = cast(i32, merge_group_sub_n == 0 ? column.DrawChannelFrozen : column.DrawChannelUnfrozen);
            ImDrawChannel* src_channel = &splitter._Channels.Data[channel_no];
            if src_channel._CmdBuffer.Size > 0 && ImVector_ImDrawCmd_back(&src_channel._CmdBuffer).ElemCount == 0 && ImVector_ImDrawCmd_back(&src_channel._CmdBuffer).UserCallback == null {
                ImVector_ImDrawCmd_pop_back(&src_channel._CmdBuffer);
            }
            if src_channel._CmdBuffer.Size != 1 {
                continue;
            }
            if (column.Flags & ImGuiTableColumnFlags_NoClip) == 0 {
                f32 content_max_x;
                if has_freeze_v == 0 {
                    content_max_x = ImMax(column.ContentMaxXUnfrozen, column.ContentMaxXHeadersUsed);
                } else if merge_group_sub_n == 0 {
                    content_max_x = ImMax(column.ContentMaxXFrozen, column.ContentMaxXHeadersUsed);
                } else {
                    content_max_x = column.ContentMaxXUnfrozen;
                }
                if content_max_x > column.ClipRect.Max.x {
                    continue;
                }
            }
            i32 merge_group_n = (has_freeze_h && column_n < table.FreezeColumnsCount ? 0 : 1) + (has_freeze_v && merge_group_sub_n == 0 ? 0 : 2);
            assert(channel_no < max_draw_channels);
            MergeGroup* merge_group = &merge_groups[merge_group_n];
            if merge_group.ChannelsCount == 0 {
                merge_group.ClipRect = ImRect{ImVec2{FLT_MAX, FLT_MAX}, ImVec2{-FLT_MAX, -FLT_MAX}};
            }
            ImBitArraySetBit(merge_group.ChannelsMask, channel_no);
            merge_group.ChannelsCount++;
            { ImVec4 zz_c4 = src_channel._CmdBuffer.Data[0].ClipRect; ImRect_Add(&merge_group.ClipRect, ImRect{ImVec2{zz_c4.x, zz_c4.y}, ImVec2{zz_c4.z, zz_c4.w}}); }
            merge_group_mask |= 1 << merge_group_n;
        }
        column.DrawChannelCurrent = cast(ImGuiTableDrawChannelIdx, -1);
    }
    if merge_group_mask != 0 {
        i32 LEADING_DRAW_CHANNELS = 2;
        ImVector_ImDrawChannel_resize(&g.DrawChannelsTempMergeBuffer, splitter._Count - LEADING_DRAW_CHANNELS);
        ImDrawChannel* dst_tmp = g.DrawChannelsTempMergeBuffer.Data;
        ImBitArraySetBitRange(remaining_mask, LEADING_DRAW_CHANNELS, splitter._Count);
        ImBitArrayClearBit(remaining_mask, cast(i32, table.Bg2DrawChannelUnfrozen));
        assert(has_freeze_v == false || cast(i32, table.Bg2DrawChannelUnfrozen) != TABLE_DRAW_CHANNEL_BG2_FROZEN);
        i32 remaining_count = splitter._Count - (has_freeze_v != 0 ? LEADING_DRAW_CHANNELS + 1 : LEADING_DRAW_CHANNELS);
        ImRect host_rect = table.HostClipRect;
        for i32 merge_group_n = 0; merge_group_n < cast(i32, sizeof(merge_groups) / sizeof(*merge_groups)); merge_group_n++ {
            {
                i32 merge_channels_count = merge_groups[merge_group_n].ChannelsCount;
                if merge_channels_count != 0 {
                    MergeGroup* merge_group = &merge_groups[merge_group_n];
                    ImRect merge_clip_rect = merge_group.ClipRect;
                    if (merge_group_n & 1) == 0 || !has_freeze_h {
                        merge_clip_rect.Min.x = ImMin(merge_clip_rect.Min.x, host_rect.Min.x);
                    }
                    if (merge_group_n & 2) == 0 || !has_freeze_v {
                        merge_clip_rect.Min.y = ImMin(merge_clip_rect.Min.y, host_rect.Min.y);
                    }
                    if (merge_group_n & 1) != 0 {
                        merge_clip_rect.Max.x = ImMax(merge_clip_rect.Max.x, host_rect.Max.x);
                    }
                    if (merge_group_n & 2) != 0 && (table.Flags & ImGuiTableFlags_NoHostExtendY) == 0 {
                        merge_clip_rect.Max.y = ImMax(merge_clip_rect.Max.y, host_rect.Max.y);
                    }
                    remaining_count -= merge_group.ChannelsCount;
                    for i32 n = 0; n < size_for_masks_bitarrays_one >> 2; n++ {
                        remaining_mask[n] &= ~merge_group.ChannelsMask[n];
                    }
                    for i32 n = 0; n < splitter._Count && merge_channels_count != 0; n++ {
                        if (merge_group.ChannelsMask[n >> 5] & cast(ImU32, 1) << cast(u32, n & 31)) != 0 == 0 {
                            continue;
                        }
                        merge_group.ChannelsMask[n >> 5] &= ~(cast(ImU32, 1) << cast(u32, n & 31));
                        merge_channels_count--;
                        ImDrawChannel* channel = &splitter._Channels.Data[n];
                        assert(channel._CmdBuffer.Size == 1 && ImRect_Contains(&merge_clip_rect, __cxx_make_ImRect(channel._CmdBuffer.Data[0].ClipRect)));
                        channel._CmdBuffer.Data[0].ClipRect = ImRect_ToVec4(&merge_clip_rect);
                        memcpy(dst_tmp++, channel, cast(u64, sizeof(ImDrawChannel)));
                    }
                }
            }
            if merge_group_n == 1 && has_freeze_v {
                memcpy(dst_tmp++, &splitter._Channels.Data[table.Bg2DrawChannelUnfrozen], cast(u64, sizeof(ImDrawChannel)));
            }
        }
        for i32 n = 0; n < splitter._Count && remaining_count != 0; n++ {
            if (remaining_mask[n >> 5] & cast(ImU32, 1) << cast(u32, n & 31)) != 0 == 0 {
                continue;
            }
            ImDrawChannel* channel = &splitter._Channels.Data[n];
            memcpy(dst_tmp++, channel, cast(u64, sizeof(ImDrawChannel)));
            remaining_count--;
        }
        assert(dst_tmp == g.DrawChannelsTempMergeBuffer.Data + g.DrawChannelsTempMergeBuffer.Size);
        memcpy(splitter._Channels.Data + LEADING_DRAW_CHANNELS, g.DrawChannelsTempMergeBuffer.Data, cast(u64, (splitter._Count - LEADING_DRAW_CHANNELS) * sizeof(ImDrawChannel)));
    }
}

private {
ImU32 TableGetColumnBorderCol(ImGuiTable* table, i32 order_n, i32 column_n) {
    bool is_hovered = table.HoveredColumnBorder == column_n;
    bool is_resized = table.ResizedColumn == column_n && table.InstanceInteracted == table.InstanceCurrent;
    bool is_frozen_separator = table.FreezeColumnsCount == order_n + 1;
    if is_resized || is_hovered {
        return ImGui_GetColorU32(is_resized != 0 ? ImGuiCol_SeparatorActive : ImGuiCol_SeparatorHovered);
    }
    if is_frozen_separator || table.Flags & (ImGuiTableFlags_NoBordersInBody | ImGuiTableFlags_NoBordersInBodyUntilResize) {
        return table.BorderColorStrong;
    }
    return table.BorderColorLight;
}
}

// FIXME-TABLE: This is a mess, need to redesign how we render borders (as some are also done in TableEndRow)
void ImGui_TableDrawBorders(ImGuiTable* table) {
    ImGuiWindow* inner_window = table.InnerWindow;
    if ImRect_Overlaps(&table.OuterWindow.ClipRect, table.OuterRect) == 0 {
        return;
    }
    ImDrawList* inner_drawlist = inner_window.DrawList;
    ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, inner_drawlist, TABLE_DRAW_CHANNEL_BG0);
    ImDrawList_PushClipRect(inner_drawlist, table.Bg0ClipRectForDrawCmd.Min, table.Bg0ClipRectForDrawCmd.Max, false);
    ImGuiTableInstanceData* table_instance = ImGui_TableGetInstanceData(table, table.InstanceCurrent);
    f32 border_size = TABLE_BORDER_SIZE;
    f32 draw_y1 = ImMax(table.InnerRect.Min.y, (table.FreezeRowsCount >= 1 ? table.InnerRect.Min.y : table.WorkRect.Min.y) + table.AngledHeadersHeight) + ((table.Flags & ImGuiTableFlags_BordersOuterH) != 0 ? 1.0f : 0.0f);
    f32 draw_y2_body = table.InnerRect.Max.y;
    f32 draw_y2_head = table.IsUsingHeaders != 0 ? ImMin(table.InnerRect.Max.y, (table.FreezeRowsCount >= 1 ? table.InnerRect.Min.y : table.WorkRect.Min.y) + table_instance.LastTopHeadersRowHeight) : draw_y1;
    if (table.Flags & ImGuiTableFlags_BordersInnerV) != 0 {
        for i32 order_n = 0; order_n < table.ColumnsCount; order_n++ {
            if (table.EnabledMaskByDisplayOrder[order_n >> 5] & cast(ImU32, 1) << cast(u32, order_n & 31)) != 0 == 0 {
                continue;
            }
            i32 column_n = table.DisplayOrderToIndex.Data[order_n];
            ImGuiTableColumn* column = &table.Columns.Data[column_n];
            bool is_hovered = table.HoveredColumnBorder == column_n;
            bool is_resized = table.ResizedColumn == column_n && table.InstanceInteracted == table.InstanceCurrent;
            bool is_resizable = (column.Flags & (ImGuiTableColumnFlags_NoResize | ImGuiTableColumnFlags_NoDirectResize_)) == 0;
            bool is_frozen_separator = table.FreezeColumnsCount == order_n + 1;
            if column.MaxX > table.InnerClipRect.Max.x && !is_resized {
                continue;
            }
            if column.NextEnabledColumn == -1 && !is_resizable {
                if (table.Flags & ImGuiTableFlags_SizingMask_) != ImGuiTableFlags_SizingFixedSame || table.Flags & ImGuiTableFlags_NoHostExtendX {
                    continue;
                }
            }
            if column.MaxX <= column.ClipRect.Min.x {
                continue;
            }
            f32 draw_y2 = draw_y2_head;
            if is_frozen_separator != 0 {
                draw_y2 = draw_y2_body;
            } else if (table.Flags & ImGuiTableFlags_NoBordersInBodyUntilResize) != 0 && (is_hovered || is_resized) {
                draw_y2 = draw_y2_body;
            } else if (table.Flags & (ImGuiTableFlags_NoBordersInBodyUntilResize | ImGuiTableFlags_NoBordersInBody)) == 0 {
                draw_y2 = draw_y2_body;
            }
            if draw_y2 > draw_y1 {
                ImDrawList_AddLineV(inner_drawlist, column.MaxX, draw_y1, draw_y2, TableGetColumnBorderCol(table, order_n, column_n), border_size);
            }
        }
    }
    if (table.Flags & ImGuiTableFlags_BordersOuter) != 0 {
        ImRect outer_border = table.OuterRect;
        ImU32 outer_col = table.BorderColorStrong;
        if (table.Flags & ImGuiTableFlags_BordersOuter) == ImGuiTableFlags_BordersOuter {
            ImDrawList_AddRect(inner_drawlist, outer_border.Min, outer_border.Max, outer_col, 0.0f, border_size, 0);
        } else if (table.Flags & ImGuiTableFlags_BordersOuterV) != 0 {
            ImDrawList_AddLineV(inner_drawlist, outer_border.Min.x, outer_border.Min.y, outer_border.Max.y, outer_col, border_size);
            ImDrawList_AddLineV(inner_drawlist, outer_border.Max.x, outer_border.Min.y, outer_border.Max.y, outer_col, border_size);
        } else if (table.Flags & ImGuiTableFlags_BordersOuterH) != 0 {
            ImDrawList_AddLineH(inner_drawlist, outer_border.Min.x, outer_border.Max.x, outer_border.Min.y, outer_col, border_size);
            ImDrawList_AddLineH(inner_drawlist, outer_border.Min.x, outer_border.Max.x, outer_border.Max.y - border_size, outer_col, border_size);
        }
    }
    if table.Flags & ImGuiTableFlags_BordersInnerH && table.RowPosY2 < table.OuterRect.Max.y {
        f32 border_y = table.RowPosY2;
        if border_y >= table.BgClipRect.Min.y && border_y < table.BgClipRect.Max.y {
            ImDrawList_AddLineH(inner_drawlist, table.BorderX1, table.BorderX2, border_y, table.BorderColorLight, border_size);
        }
    }
    ImDrawList_PopClipRect(inner_drawlist);
}

//-------------------------------------------------------------------------
// [SECTION] Tables: Sorting
//-------------------------------------------------------------------------
// - TableGetSortSpecs()
// - TableFixColumnSortDirection() [Internal]
// - TableGetColumnNextSortDirection() [Internal]
// - TableSetColumnSortDirection() [Internal]
// - TableSortSpecsSanitize() [Internal]
// - TableSortSpecsBuild() [Internal]
//-------------------------------------------------------------------------
// Return NULL if no sort specs (most often when ImGuiTableFlags_Sortable is not set)
// When 'sort_specs->SpecsDirty == true' you should sort your data. It will be true when sorting specs have
// changed since last call, or the first time. Make sure to set 'SpecsDirty = false' after sorting,
// else you may wastefully sort your data every frame!
// Lifetime: don't hold on this pointer over multiple frames or past any subsequent call to BeginTable()!
ImGuiTableSortSpecs* ImGui_TableGetSortSpecs() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if table == null || !(table.Flags & ImGuiTableFlags_Sortable) {
        return null;
    }
    if table.IsLayoutLocked == 0 {
        ImGui_TableUpdateLayout(table);
    }
    ImGui_TableSortSpecsBuild(table);
    return &table.SortSpecs;
}

private {
ImGuiSortDirection TableGetColumnAvailSortDirection(ImGuiTableColumn* column, i32 n) {
    assert(n < cast(i32, column.SortDirectionsAvailCount));
    return cast(ImGuiSortDirection, cast(i32, column.SortDirectionsAvailList) >> (n << 1) & 0x03);
}
}

// Fix sort direction if currently set on a value which is unavailable (e.g. activating NoSortAscending/NoSortDescending)
void ImGui_TableFixColumnSortDirection(ImGuiTable* table, ImGuiTableColumn* column) {
    if column.SortOrder == -1 || (column.SortDirectionsAvailMask & 1 << cast(i32, column.SortDirection)) != 0 {
        return;
    }
    column.SortDirection = cast(ImU8, TableGetColumnAvailSortDirection(column, 0));
    table.IsSortSpecsDirty = true;
}

ImGuiSortDirection ImGui_TableGetColumnNextSortDirection(ImGuiTableColumn* column) {
    assert(column.SortDirectionsAvailCount > 0);
    if column.SortOrder == -1 {
        return TableGetColumnAvailSortDirection(column, 0);
    }
    for i32 n = 0; n < 3; n++ {
        if column.SortDirection == TableGetColumnAvailSortDirection(column, n) {
            return TableGetColumnAvailSortDirection(column, (n + 1) % column.SortDirectionsAvailCount);
        }
    }
    assert(0);
    return cast(ImGuiSortDirection, ImGuiSortDirection_None);
}

// Note that the NoSortAscending/NoSortDescending flags are processed in TableSortSpecsSanitize(), and they may change/revert
// the value of SortDirection. We could technically also do it here but it would be unnecessary and duplicate code.
void ImGui_TableSetColumnSortDirection(i32 column_n, ImGuiSortDirection sort_direction, bool append_to_sort_specs) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if (table.Flags & ImGuiTableFlags_SortMulti) == 0 {
        append_to_sort_specs = false;
    }
    if (table.Flags & ImGuiTableFlags_SortTristate) == 0 {
        assert(cast(i32, sort_direction) != ImGuiSortDirection_None);
    }
    ImGuiTableColumnIdx sort_order_max = 0;
    if append_to_sort_specs != 0 {
        for i32 other_column_n = 0; other_column_n < table.ColumnsCount; other_column_n++ {
            sort_order_max = cast(i16, ImMax(cast(i32, sort_order_max), cast(i32, table.Columns.Data[other_column_n].SortOrder)));
        }
    }
    ImGuiTableColumn* column = &table.Columns.Data[column_n];
    column.SortDirection = cast(ImU8, sort_direction);
    if cast(i32, column.SortDirection) == ImGuiSortDirection_None {
        column.SortOrder = cast(ImGuiTableColumnIdx, -1);
    } else if column.SortOrder == -1 || !append_to_sort_specs {
        column.SortOrder = cast(ImGuiTableColumnIdx, append_to_sort_specs != 0 ? sort_order_max + 1 : 0);
    }
    for i32 other_column_n = 0; other_column_n < table.ColumnsCount; other_column_n++ {
        ImGuiTableColumn* other_column = &table.Columns.Data[other_column_n];
        if other_column != column && !append_to_sort_specs {
            other_column.SortOrder = cast(ImGuiTableColumnIdx, -1);
        }
        ImGui_TableFixColumnSortDirection(table, other_column);
    }
    table.IsSettingsDirty = true;
    table.IsSortSpecsDirty = true;
}

void ImGui_TableSortSpecsSanitize(ImGuiTable* table) {
    assert(table.Flags & ImGuiTableFlags_Sortable);
    i32 sort_order_count = 0;
    ImU64 sort_order_mask = 0x00;
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        ImGuiTableColumn* column = &table.Columns.Data[column_n];
        if column.SortOrder != -1 && !column.IsEnabled {
            column.SortOrder = cast(ImGuiTableColumnIdx, -1);
        }
        if column.SortOrder == -1 {
            continue;
        }
        sort_order_count++;
        sort_order_mask |= cast(ImU64, 1) << cast(u64, column.SortOrder);
        assert(sort_order_count < cast(i32, sizeof(sort_order_mask)) * 8);
    }
    bool need_fix_linearize = cast(ImU64, 1) << cast(u64, sort_order_count) != sort_order_mask + 1;
    bool need_fix_single_sort_order = sort_order_count > 1 && !(table.Flags & ImGuiTableFlags_SortMulti);
    if need_fix_linearize || need_fix_single_sort_order {
        ImU64 fixed_mask = 0x00;
        for i32 sort_n = 0; sort_n < sort_order_count; sort_n++ {
            i32 column_with_smallest_sort_order = -1;
            for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
                if (fixed_mask & cast(ImU64, 1) << cast(ImU64, column_n)) == 0 && table.Columns.Data[column_n].SortOrder != -1 {
                    if column_with_smallest_sort_order == -1 || table.Columns.Data[column_n].SortOrder < table.Columns.Data[column_with_smallest_sort_order].SortOrder {
                        column_with_smallest_sort_order = column_n;
                    }
                }
            }
            assert(column_with_smallest_sort_order != -1);
            fixed_mask |= cast(ImU64, 1) << cast(u64, column_with_smallest_sort_order);
            table.Columns.Data[column_with_smallest_sort_order].SortOrder = cast(ImGuiTableColumnIdx, sort_n);
            if need_fix_single_sort_order != 0 {
                sort_order_count = 1;
                for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
                    if column_n != column_with_smallest_sort_order {
                        table.Columns.Data[column_n].SortOrder = cast(ImGuiTableColumnIdx, -1);
                    }
                }
                break;
            }
        }
    }
    if sort_order_count == 0 && !(table.Flags & ImGuiTableFlags_SortTristate) {
        for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
            ImGuiTableColumn* column = &table.Columns.Data[column_n];
            if column.IsEnabled && !(column.Flags & ImGuiTableColumnFlags_NoSort) {
                sort_order_count = 1;
                column.SortOrder = 0;
                column.SortDirection = cast(ImU8, TableGetColumnAvailSortDirection(column, 0));
                break;
            }
        }
    }
    table.SortSpecsCount = cast(ImGuiTableColumnIdx, sort_order_count);
}

void ImGui_TableSortSpecsBuild(ImGuiTable* table) {
    bool dirty = table.IsSortSpecsDirty;
    if dirty != 0 {
        ImGui_TableSortSpecsSanitize(table);
        ImVector_ImGuiTableColumnSortSpecs_resize(&table.SortSpecsMulti, table.SortSpecsCount <= 1 ? 0 : table.SortSpecsCount);
        table.SortSpecs.SpecsDirty = true;
        table.IsSortSpecsDirty = false;
    }
    ImGuiTableColumnSortSpecs* sort_specs = table.SortSpecsCount == 0 ? null : table.SortSpecsCount == 1 ? &table.SortSpecsSingle : table.SortSpecsMulti.Data;
    if dirty && sort_specs != null {
        for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
            ImGuiTableColumn* column = &table.Columns.Data[column_n];
            if column.SortOrder == -1 {
                continue;
            }
            assert(column.SortOrder < table.SortSpecsCount);
            ImGuiTableColumnSortSpecs* sort_spec = &sort_specs[column.SortOrder];
            sort_spec.ColumnUserID = column.UserData;
            sort_spec.ColumnIndex = cast(ImGuiTableColumnIdx, column_n);
            sort_spec.SortOrder = column.SortOrder;
            sort_spec.SortDirection = cast(ImGuiSortDirection, column.SortDirection);
        }
    }
    table.SortSpecs.Specs = sort_specs;
    table.SortSpecs.SpecsCount = table.SortSpecsCount;
}

//-------------------------------------------------------------------------
// [SECTION] Tables: Headers
//-------------------------------------------------------------------------
// - TableGetHeaderRowHeight() [Internal]
// - TableGetHeaderAngledMaxLabelWidth() [Internal]
// - TableHeadersRow()
// - TableHeader()
// - TableAngledHeadersRow()
// - TableAngledHeadersRowEx() [Internal]
//-------------------------------------------------------------------------
f32 ImGui_TableGetHeaderRowHeight() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    f32 row_height = g.FontSize;
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        if (table.EnabledMaskByIndex[column_n >> 5] & cast(ImU32, 1) << cast(u32, column_n & 31)) != 0 {
            if (table.Columns.Data[column_n].Flags & ImGuiTableColumnFlags_NoHeaderLabel) == 0 {
                row_height = ImMax(row_height, ImGui_CalcTextSize(ImGui_TableGetColumnName(table, column_n), null, false, -1.0f).y);
            }
        }
    }
    return row_height + g.Style.CellPadding.y * 2.0f;
}

f32 ImGui_TableGetHeaderAngledMaxLabelWidth() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    f32 width = 0.0f;
    for i32 column_n = 0; column_n < table.ColumnsCount; column_n++ {
        if (table.EnabledMaskByIndex[column_n >> 5] & cast(ImU32, 1) << cast(u32, column_n & 31)) != 0 {
            if (table.Columns.Data[column_n].Flags & ImGuiTableColumnFlags_AngledHeader) != 0 {
                width = ImMax(width, ImGui_CalcTextSize(ImGui_TableGetColumnName(table, column_n), null, true, -1.0f).x);
            }
        }
    }
    return width + g.Style.CellPadding.y * 2.0f;
}

// [Public] This is a helper to output TableHeader() calls based on the column names declared in TableSetupColumn().
// The intent is that advanced users willing to create customized headers would not need to use this helper
// and can create their own! For example: TableHeader() may be preceded by Checkbox() or other custom widgets.
// See 'Demo->Tables->Custom headers' for a demonstration of implementing a custom version of this.
// This code is intentionally written to not make much use of internal functions, to give you better direction
// if you need to write your own.
// FIXME-TABLE: TableOpenContextMenu() and TableGetHeaderRowHeight() are not public.
void ImGui_TableHeadersRow() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    while true {
        if table != null == 0 {
            if ImGui_ErrorLog("Call should only be done while in BeginTable() scope!") != 0 {
                assert(table != null && "Call should only be done while in BeginTable() scope!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    if table.IsLayoutLocked == 0 {
        ImGui_TableUpdateLayout(table);
    }
    f32 row_height = ImGui_TableGetHeaderRowHeight();
    ImGui_TableNextRow(ImGuiTableRowFlags_Headers, row_height);
    f32 row_y1 = ImGui_GetCursorScreenPos().y;
    if table.HostSkipItems != 0 {
        return;
    }
    i32 columns_count = ImGui_TableGetColumnCount();
    for i32 column_n = 0; column_n < columns_count; column_n++ {
        if !ImGui_TableSetColumnIndex(column_n) && table.LastHeldHeaderColumn != column_n {
            continue;
        }
        u8* name = (ImGui_TableGetColumnFlags(column_n) & ImGuiTableColumnFlags_NoHeaderLabel) != 0 ? "" : ImGui_TableGetColumnName(column_n);
        ImGui_PushID(column_n);
        ImGui_TableHeader(name);
        ImGui_PopID();
    }
    ImVec2 mouse_pos = ImGui_GetMousePos();
    if ImGui_IsMouseReleased(1) && ImGui_TableGetHoveredColumn() == columns_count {
        if mouse_pos.y >= row_y1 && mouse_pos.y < row_y1 + row_height {
            ImGui_TableOpenContextMenu(columns_count);
        }
    }
}

// Emit a column header (text + optional sort order)
// We cpu-clip text here so that all columns headers can be merged into a same draw call.
// Note that because of how we cpu-clip and display sorting indicators, you _cannot_ use SameLine() after a TableHeader()
void ImGui_TableHeader(u8* label) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    if window.SkipItems != 0 {
        return;
    }
    ImGuiTable* table = g.CurrentTable;
    while true {
        if table != null == 0 {
            if ImGui_ErrorLog("Call should only be done while in BeginTable() scope!") != 0 {
                assert(table != null && "Call should only be done while in BeginTable() scope!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    assert(table.CurrentColumn != -1);
    i32 column_n = table.CurrentColumn;
    ImGuiTableColumn* column = &table.Columns.Data[column_n];
    if label == null {
        label = "";
    }
    u8* label_end = ImGui_FindRenderedTextEnd(label, null);
    ImVec2 label_size = ImGui_CalcTextSize(label, label_end, false, -1.0f);
    ImVec2 label_pos = window.DC.CursorPos;
    ImRect cell_r = ImGui_TableGetCellBgRect(table, column_n);
    f32 label_height = ImMax(label_size.y, table.RowMinHeight - table.RowCellPaddingY * 2.0f);
    f32 w_arrow = 0.0f;
    f32 w_sort_text = 0.0f;
    bool sort_arrow = false;
    u8[4] sort_order_suf;
    f32 ARROW_SCALE = 0.65f;
    if table.Flags & ImGuiTableFlags_Sortable && !(column.Flags & ImGuiTableColumnFlags_NoSort) {
        w_arrow = ImTrunc(g.FontSize * ARROW_SCALE + g.Style.FramePadding.x);
        if column.SortOrder != -1 {
            sort_arrow = true;
        }
        if column.SortOrder > 0 {
            ImFormatString(sort_order_suf, cast(u64, cast(i32, sizeof(sort_order_suf) / sizeof(*sort_order_suf))), "%d", column.SortOrder + 1);
            w_sort_text = g.Style.ItemInnerSpacing.x + ImGui_CalcTextSize(sort_order_suf, null, false, -1.0f).x;
        }
    }
    f32 max_pos_x = label_pos.x + label_size.x + w_sort_text + w_arrow;
    column.ContentMaxXHeadersUsed = ImMax(column.ContentMaxXHeadersUsed, sort_arrow != 0 ? cell_r.Max.x : ImMin(max_pos_x, cell_r.Max.x));
    column.ContentMaxXHeadersIdeal = ImMax(column.ContentMaxXHeadersIdeal, max_pos_x);
    ImGuiID id = ImGuiWindow_GetID(window, label, null);
    ImRect bb;
    ImRect_init(&bb, cell_r.Min.x, cell_r.Min.y, cell_r.Max.x, ImMax(cell_r.Max.y, cell_r.Min.y + label_height + g.Style.CellPadding.y * 2.0f));
    ImGui_ItemSize(ImVec2{0.0f, label_height});
    if ImGui_ItemAdd(bb, id, null, 0) == 0 {
        return;
    }
    bool highlight = table.HighlightColumnHeader == column_n;
    bool hovered;
    bool held;
    bool pressed = ImGui_ButtonBehavior(bb, id, &hovered, &held, ImGuiButtonFlags_AllowOverlap);
    if held || hovered || highlight {
        ImU32 col = ImGui_GetColorU32(held != 0 ? ImGuiCol_HeaderActive : hovered != 0 ? ImGuiCol_HeaderHovered : ImGuiCol_Header);
        ImGui_TableSetBgColor(ImGuiTableBgTarget_CellBg, col, table.CurrentColumn);
    } else {
        if (table.RowFlags & ImGuiTableRowFlags_Headers) == 0 {
            ImGui_TableSetBgColor(ImGuiTableBgTarget_CellBg, ImGui_GetColorU32(ImGuiCol_TableHeaderBg), table.CurrentColumn);
        }
    }
    ImGui_RenderNavCursor(bb, id, ImGuiNavRenderCursorFlags_Compact, 0.0f);
    if held != 0 {
        table.HeldHeaderColumn = cast(ImGuiTableColumnIdx, column_n);
    }
    window.DC.CursorPos.y -= g.Style.ItemSpacing.y * 0.5f;
    if held && table.Flags & ImGuiTableFlags_Reorderable && ImGui_IsMouseDragging(0, -1.0f) && !g.DragDropActive {
        table.InstanceInteracted = table.InstanceCurrent;
        if g.IO.MouseDelta.x < 0.0f && g.IO.MousePos.x < cell_r.Min.x {
            ImGuiTableColumn* prev_column = column.PrevEnabledColumn != -1 ? &table.Columns.Data[column.PrevEnabledColumn] : null;
            if prev_column != null {
                ImGui_TableQueueSetColumnDisplayOrder(table, column_n, cast(i32, prev_column.DisplayOrder));
            }
        }
        if g.IO.MouseDelta.x > 0.0f && g.IO.MousePos.x > cell_r.Max.x {
            ImGuiTableColumn* next_column = column.NextEnabledColumn != -1 ? &table.Columns.Data[column.NextEnabledColumn] : null;
            if next_column != null {
                ImGui_TableQueueSetColumnDisplayOrder(table, column_n, cast(i32, next_column.DisplayOrder));
            }
        }
    }
    f32 ellipsis_max = ImMax(cell_r.Max.x - (sort_arrow != 0 ? w_arrow + w_sort_text : 0.0f), label_pos.x);
    if table.Flags & ImGuiTableFlags_Sortable && !(column.Flags & ImGuiTableColumnFlags_NoSort) {
        if column.SortOrder != -1 {
            f32 x = ImMax(cell_r.Min.x, cell_r.Max.x - w_arrow - w_sort_text);
            f32 y = label_pos.y;
            if column.SortOrder > 0 {
                ImGui_PushStyleColor(ImGuiCol_Text, ImGui_GetColorU32(ImGuiCol_Text, 0.7f));
                ImGui_RenderText(ImVec2{x + g.Style.ItemInnerSpacing.x, y}, sort_order_suf, null, true);
                ImGui_PopStyleColor(1);
                x += w_sort_text;
            }
            ImGui_RenderArrow(window.DrawList, ImVec2{x, y}, ImGui_GetColorU32(ImGuiCol_Text), cast(i32, column.SortDirection) == ImGuiSortDirection_Ascending ? ImGuiDir_Up : ImGuiDir_Down, ARROW_SCALE);
        }
        if pressed && table.ReorderColumn != column_n {
            ImGuiSortDirection sort_direction = ImGui_TableGetColumnNextSortDirection(column);
            ImGui_TableSetColumnSortDirection(column_n, sort_direction, g.IO.KeyShift);
        }
    }
    ImGui_RenderTextEllipsis(window.DrawList, label_pos, ImVec2{ellipsis_max, bb.Max.y}, ellipsis_max, label, label_end, &label_size);
    bool text_clipped = label_size.x > ellipsis_max - label_pos.x;
    if text_clipped && hovered && g.ActiveId == 0 {
        ImGui_SetItemTooltip("%.*s", cast(i32, cast(i64, label_end - label)), label);
    }
    if ImGui_IsPopupOpenRequestForItem(ImGuiPopupFlags_None, id) != 0 {
        ImGui_TableOpenContextMenu(column_n);
    }
    ignore *g;
}

// Unlike TableHeadersRow() it is not expected that you can reimplement or customize this with custom widgets.
// FIXME: No hit-testing/button on the angled header.
void ImGui_TableAngledHeadersRow() {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    ImGuiTableTempData* temp_data = table.TempData;
    ImVector_ImGuiTableHeaderData_resize(&temp_data.AngledHeadersRequests, 0);
    ImVector_ImGuiTableHeaderData_reserve(&temp_data.AngledHeadersRequests, table.ColumnsEnabledCount);
    ImGuiID row_id = ImGui_GetID("##AngledHeaders");
    ImGuiTableInstanceData* table_instance = ImGui_TableGetInstanceData(table, table.InstanceCurrent);
    i32 highlight_column_n = table.LastHeldHeaderColumn != -1 ? table.LastHeldHeaderColumn : table.HighlightColumnHeader;
    if highlight_column_n == -1 && table.HoveredColumnBody != -1 {
        if table_instance.HoveredRowLast == 0 && table.HoveredColumnBorder == -1 && (g.ActiveId == 0 || g.ActiveId == row_id || (table.IsActiveIdInTable || g.DragDropActive)) {
            highlight_column_n = table.HoveredColumnBody;
        }
    }
    ImU32 col_header_bg = ImGui_GetColorU32(ImGuiCol_TableHeaderBg);
    ImU32 col_text = ImGui_GetColorU32(ImGuiCol_Text);
    for i32 order_n = 0; order_n < table.ColumnsCount; order_n++ {
        if (table.EnabledMaskByDisplayOrder[order_n >> 5] & cast(ImU32, 1) << cast(u32, order_n & 31)) != 0 {
            i32 column_n = table.DisplayOrderToIndex.Data[order_n];
            ImGuiTableColumn* column = &table.Columns.Data[column_n];
            if (column.Flags & ImGuiTableColumnFlags_AngledHeader) == 0 {
                continue;
            }
            var request = ImGuiTableHeaderData{
                cast(ImGuiTableColumnIdx, column_n), col_text, col_header_bg,
                column_n == highlight_column_n ? ImGui_GetColorU32(ImGuiCol_Header) : 0,
            };
            ImVector_ImGuiTableHeaderData_push_back(&temp_data.AngledHeadersRequests, request);
        }
    }
    ImGui_TableAngledHeadersRowEx(row_id, g.Style.TableAngledHeadersAngle, 0.0f, temp_data.AngledHeadersRequests.Data, temp_data.AngledHeadersRequests.Size);
}

// Important: data must be fed left to right
void ImGui_TableAngledHeadersRowEx(ImGuiID row_id, f32 angle, f32 max_label_width, ImGuiTableHeaderData* data, i32 data_count) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    ImGuiWindow* window = g.CurrentWindow;
    ImDrawList* draw_list = window.DrawList;
    while true {
        if table != null == 0 {
            if ImGui_ErrorLog("Call should only be done while in BeginTable() scope!") != 0 {
                assert(table != null && "Call should only be done while in BeginTable() scope!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    assert(table.CurrentRow == -1 && "Must be first row");
    if max_label_width == 0.0f {
        max_label_width = ImGui_TableGetHeaderAngledMaxLabelWidth();
    }
    bool flip_label = angle < 0.0f;
    angle -= 3.141592653589793f * 0.5f;
    f32 cos_a = cos(angle);
    f32 sin_a = sin(angle);
    f32 label_cos_a = flip_label != 0 ? cos(angle + 3.141592653589793f) : cos_a;
    f32 label_sin_a = flip_label != 0 ? sin(angle + 3.141592653589793f) : sin_a;
    var unit_right = ImVec2{cos_a, sin_a};
    f32 header_height = g.FontSize + g.Style.CellPadding.x * 2.0f;
    f32 row_height = ImTrunc(fabs(ImRotate(ImVec2{
        max_label_width, flip_label != 0 ? header_height : -header_height,
    }, cos_a, sin_a).y));
    table.AngledHeadersHeight = row_height;
    table.AngledHeadersSlope = sin_a != 0.0f ? cos_a / sin_a : 0.0f;
    ImVec2 header_angled_vector = op_mul_ImVec2_float(unit_right, row_height / -sin_a);
    ImGui_TableNextRow(ImGuiTableRowFlags_Headers, row_height);
    ImGui_TableNextColumn();
    ImRect row_r;
    ImRect_init(&row_r, table.WorkRect.Min.x, table.BgClipRect.Min.y, table.WorkRect.Max.x, table.RowPosY2);
    ImDrawListSplitter_SetCurrentChannel(table.DrawSplitter, draw_list, TABLE_DRAW_CHANNEL_BG0);
    f32 clip_rect_min_x = table.BgClipRect.Min.x;
    if table.FreezeColumnsCount > 0 {
        clip_rect_min_x = ImMax(clip_rect_min_x, table.Columns.Data[table.DisplayOrderToIndex.Data[table.FreezeColumnsCount - 1]].MaxX);
    }
    ImGui_TableSetBgColor(ImGuiTableBgTarget_RowBg0, 0);
    ImGui_PushClipRect(table.BgClipRect.Min, table.BgClipRect.Max, false);
    ImDrawList_AddRectFilled(draw_list, ImVec2{table.BgClipRect.Min.x, row_r.Min.y}, ImVec2{table.BgClipRect.Max.x, row_r.Max.y}, ImGui_GetColorU32(ImGuiCol_TableHeaderBg, 0.25f), 0.0f, 0);
    ImGui_PushClipRect(ImVec2{clip_rect_min_x, table.BgClipRect.Min.y}, table.BgClipRect.Max, true);
    ImGui_ButtonBehavior(row_r, row_id, null, null, 0);
    ImGui_KeepAliveID(row_id);
    f32 ascent_scaled = g.FontBaked.Ascent * g.FontBakedScale;
    f32 line_off_for_ascent_x = ImMax((g.FontSize - ascent_scaled) * 0.5f, 0.0f) / -sin_a * (flip_label != 0 ? -1.0f : 1.0f);
    ImVec2 padding = g.Style.CellPadding;
    ImVec2 align = g.Style.TableAngledHeadersTextAlign;
    f32 max_x = -FLT_MAX;
    for i32 pass = 0; pass < 2; pass++ {
        for i32 order_n = 0; order_n < data_count; order_n++ {
            ImGuiTableHeaderData* request = &data[order_n];
            i32 column_n = request.Index;
            ImGuiTableColumn* column = &table.Columns.Data[column_n];
            ImVec2[4] bg_shape;
            bg_shape[0] = ImVec2{column.MaxX, row_r.Max.y};
            bg_shape[1] = ImVec2{column.MinX, row_r.Max.y};
            bg_shape[2] = op_add_ImVec2_ImVec2(bg_shape[1], header_angled_vector);
            bg_shape[3] = op_add_ImVec2_ImVec2(bg_shape[0], header_angled_vector);
            if pass == 0 {
                ImDrawList_AddQuadFilled(draw_list, bg_shape[0], bg_shape[1], bg_shape[2], bg_shape[3], request.BgColor0);
                ImDrawList_AddQuadFilled(draw_list, bg_shape[0], bg_shape[1], bg_shape[2], bg_shape[3], request.BgColor1);
                max_x = ImMax(max_x, bg_shape[3].x);
                u8* label_name = ImGui_TableGetColumnName(table, column_n);
                u8* label_name_end = ImGui_FindRenderedTextEnd(label_name, null);
                f32 line_off_step_x = g.FontSize / -sin_a;
                i32 label_lines = ImTextCountLines(label_name, label_name_end);
                f32 line_off_curr_x = flip_label != 0 ? cast(f32, label_lines - 1) * line_off_step_x : 0.0f;
                f32 line_off_for_align_x = ImFloor(ImMax(column.MaxX - column.MinX - padding.x * 2.0f - cast(f32, label_lines) * line_off_step_x, 0.0f) * align.x);
                line_off_curr_x += line_off_for_align_x - line_off_for_ascent_x;
                column.ContentMaxXHeadersIdeal = column.WorkMinX + ceil(cast(f32, label_lines) * line_off_step_x - line_off_for_align_x);
                column.ContentMaxXHeadersUsed = column.ContentMaxXHeadersIdeal;
                while label_name < label_name_end {
                    u8* label_name_eol = strchr(label_name, 10);
                    if label_name_eol == null {
                        label_name_eol = label_name_end;
                    }
                    ImVec2 label_size = ImGui_CalcTextSize(label_name, label_name_eol, false, -1.0f);
                    f32 clip_width = max_label_width - padding.y;
                    f32 clip_height = ImMin(label_size.y, column.ClipRect.Max.x - column.WorkMinX - line_off_curr_x);
                    ImRect clip_r;
                    ImRect_init(&clip_r, window.ClipRect.Min, op_add_ImVec2_ImVec2(window.ClipRect.Min, ImVec2{clip_width, clip_height}));
                    var vtx_idx_begin = cast(i32, draw_list._VtxCurrentIdx);
                    ImGui_PushStyleColor(ImGuiCol_Text, request.TextColor);
                    ImGui_RenderTextEllipsis(draw_list, clip_r.Min, clip_r.Max, clip_r.Max.x, label_name, label_name_eol, &label_size);
                    ImGui_PopStyleColor(1);
                    var vtx_idx_end = cast(i32, draw_list._VtxCurrentIdx);
                    f32 available_space = ImMax(clip_width - label_size.x + ImAbs(padding.x * cos_a) * 2.0f - ImAbs(padding.y * sin_a) * 2.0f, 0.0f);
                    f32 vertical_offset = available_space * align.y * (flip_label != 0 ? -1.0f : 1.0f);
                    var pivot_in = ImVec2{
                        window.ClipRect.Min.x - vertical_offset,
                        window.ClipRect.Min.y + label_size.y,
                    };
                    var pivot_out = ImVec2{column.WorkMinX, row_r.Max.y};
                    line_off_curr_x += flip_label != 0 ? -line_off_step_x : line_off_step_x;
                    pivot_out = op_add_ImVec2_ImVec2(pivot_out, op_mul_ImVec2_float(unit_right, padding.y));
                    if flip_label != 0 {
                        pivot_out = op_add_ImVec2_ImVec2(pivot_out, op_mul_ImVec2_float(unit_right, clip_width - ImMax(0.0f, clip_width - label_size.x)));
                    }
                    pivot_out.x += flip_label != 0 ? line_off_curr_x + line_off_step_x : line_off_curr_x;
                    ImGui_ShadeVertsTransformPos(draw_list, vtx_idx_begin, vtx_idx_end, pivot_in, label_cos_a, label_sin_a, pivot_out);
                    label_name = label_name_eol + 1;
                }
            }
            if pass == 1 {
                ImDrawList_AddLine(draw_list, op_sub_ImVec2_ImVec2(bg_shape[0], ImVec2{TABLE_BORDER_SIZE * 0.5f, 0.0f}), op_sub_ImVec2_ImVec2(bg_shape[3], ImVec2{TABLE_BORDER_SIZE * 0.5f, 0.0f}), TableGetColumnBorderCol(table, order_n, column_n), TABLE_BORDER_SIZE);
            }
        }
    }
    ImGui_PopClipRect();
    ImGui_PopClipRect();
    table.TempData.AngledHeadersExtraWidth = ImMax(0.0f, max_x - table.Columns.Data[table.RightMostEnabledColumn].MaxX);
}

//-------------------------------------------------------------------------
// [SECTION] Tables: Context Menu
//-------------------------------------------------------------------------
// - TableOpenContextMenu() [Internal]
// - TableBeginContextMenuPopup() [Internal]
// - TableDrawDefaultContextMenu() [Internal]
//-------------------------------------------------------------------------
// Use -1 to open menu not specific to a given column.
void ImGui_TableOpenContextMenu(i32 column_n) {
    ImGuiContext* g = GImGui;
    ImGuiTable* table = g.CurrentTable;
    if column_n == -1 && table.CurrentColumn != -1 {
        column_n = table.CurrentColumn;
    }
    if column_n == table.ColumnsCount {
        column_n = -1;
    }
    assert(column_n >= -1 && column_n < table.ColumnsCount);
    if (table.Flags & (ImGuiTableFlags_Resizable | ImGuiTableFlags_Reorderable | ImGuiTableFlags_Hideable)) != 0 {
        table.IsContextPopupOpen = true;
        table.ContextPopupColumn = cast(ImGuiTableColumnIdx, column_n);
        table.InstanceInteracted = table.InstanceCurrent;
        ImGuiID context_menu_id = ImHashStr("##ContextMenu", 0, table.ID);
        ImGui_OpenPopupEx(context_menu_id, ImGuiPopupFlags_None);
    }
}

bool ImGui_TableBeginContextMenuPopup(ImGuiTable* table) {
    if !table.IsContextPopupOpen || table.InstanceCurrent != table.InstanceInteracted {
        return false;
    }
    ImGuiID context_menu_id = ImHashStr("##ContextMenu", 0, table.ID);
    if ImGui_BeginPopupEx(context_menu_id, ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoSavedSettings) != 0 {
        return true;
    }
    table.IsContextPopupOpen = false;
    return false;
}

// FIXME: Copied from MenuItem() for the purpose of being able to pass _SelectOnRelease (#9312)
private {
bool MenuItemForColumnReorder(u8* label, bool selected, bool enabled) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImVec2 label_size = ImGui_CalcTextSize(label, null, true, -1.0f);
    ImGuiMenuColumns* offsets = &window.DC.MenuColumns;
    var checkmark_w = cast(f32, cast(i32, g.FontSize * 1.2f));
    f32 min_w = ImGuiMenuColumns_DeclColumns(offsets, 0.0f, label_size.x, 0.0f, checkmark_w);
    f32 stretch_w = ImMax(0.0f, ImGui_GetContentRegionAvail().x - min_w);
    ImVec2 text_pos;
    ImVec2_init(&text_pos, window.DC.CursorPos.x, window.DC.CursorPos.y + window.DC.CurrLineTextBaseOffset);
    ImGuiID id = ImGui_GetID(label);
    ImGuiSelectableFlags selectable_flags = ImGuiSelectableFlags_SelectOnRelease | ImGuiSelectableFlags_SpanAvailWidth;
    if g.ActiveId == id {
        selectable_flags |= ImGuiSelectableFlags_Highlight;
    }
    bool has_been_moved = g.ActiveId == id && g.ActiveIdHasBeenEditedBefore;
    ImGui_BeginDisabled(!enabled);
    bool ret = ImGui_Selectable(label, false, selectable_flags, ImVec2{min_w, label_size.y}) && !has_been_moved;
    if g.LastItemData.StatusFlags & ImGuiItemStatusFlags_Visible && selected {
        ImGui_RenderCheckMark(window.DrawList, op_add_ImVec2_ImVec2(text_pos, ImVec2{
            cast(f32, offsets.OffsetMark) + stretch_w + g.FontSize * 0.4f,
            g.FontSize * 0.134f * 0.5f,
        }), ImGui_GetColorU32(ImGuiCol_Text), g.FontSize * 0.866f);
    }
    ImGui_EndDisabled();
    ignore *g;
    return ret;
}
}

// Output context menu into current window (generally a popup)
// FIXME-TABLE: Ideally this should be writable by the user. Full programmatic access to that data?
// Sections to display are pulled from 'flags_for_section_to_display', which is typically == table->Flags.
// - ImGuiTableFlags_Resizable   -> display Sizing menu items
// - ImGuiTableFlags_Reorderable -> display "Reset Order"
////- ImGuiTableFlags_Sortable   -> display sorting options (disabled)
// - ImGuiTableFlags_Hideable    -> display columns visibility menu items
// It means if you have a custom context menus you can call this section and omit some sections, and add your own.
void ImGui_TableDrawDefaultContextMenu(ImGuiTable* table, ImGuiTableFlags flags_for_section_to_display) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    if window.SkipItems != 0 {
        return;
    }
    bool want_separator = false;
    i32 context_column_n = table.ContextPopupColumn >= 0 && table.ContextPopupColumn < table.ColumnsCount ? table.ContextPopupColumn : -1;
    ImGuiTableColumn* context_column = context_column_n != -1 ? &table.Columns.Data[context_column_n] : null;
    if (flags_for_section_to_display & ImGuiTableFlags_Resizable) != 0 {
        if context_column != null {
            bool can_resize = !(context_column.Flags & ImGuiTableColumnFlags_NoResize) && context_column.IsEnabled;
            if ImGui_MenuItem(ImGui_LocalizeGetMsg(ImGuiLocKey_TableSizeOne), null, false, can_resize) != 0 {
                ImGui_TableSetColumnWidthAutoSingle(table, context_column_n);
            }
        }
        u8* size_all_desc;
        if table.ColumnsEnabledFixedCount == table.ColumnsEnabledCount && (table.Flags & ImGuiTableFlags_SizingMask_) != ImGuiTableFlags_SizingFixedSame {
            size_all_desc = ImGui_LocalizeGetMsg(ImGuiLocKey_TableSizeAllFit);
        } else {
            size_all_desc = ImGui_LocalizeGetMsg(ImGuiLocKey_TableSizeAllDefault);
        }
        if ImGui_MenuItem(size_all_desc, null, false, true) != 0 {
            ImGui_TableSetColumnWidthAutoAll(table);
        }
        want_separator = true;
    }
    if (flags_for_section_to_display & (ImGuiTableFlags_Reorderable | ImGuiTableFlags_Hideable)) != 0 {
        if ImGui_BeginMenu(ImGui_LocalizeGetMsg(ImGuiLocKey_TableReset), true) != 0 {
            if (flags_for_section_to_display & ImGuiTableFlags_Reorderable) != 0 {
                if ImGui_MenuItem(ImGui_LocalizeGetMsg(ImGuiLocKey_TableResetOrder), null, false, !table.IsDefaultDisplayOrder) != 0 {
                    table.IsResetDisplayOrderRequest = true;
                }
            }
            if (flags_for_section_to_display & ImGuiTableFlags_Hideable) != 0 {
                if ImGui_MenuItem(ImGui_LocalizeGetMsg(ImGuiLocKey_TableResetVisibility), null, false, !table.IsDefaultVisibility) != 0 {
                    table.IsResetVisibilityRequest = true;
                }
            }
            ImGui_EndMenu();
        }
    }
    if (flags_for_section_to_display & ImGuiTableFlags_Hideable) != 0 {
        if want_separator != 0 {
            ImGui_Separator();
        }
        want_separator = true;
        bool is_reordering = g.ActiveId != 0 && g.ActiveIdWindow == g.CurrentWindow && table.ReorderColumn != -1 && g.ActiveIdHasBeenEditedBefore;
        i32 reorder_src_order = is_reordering != 0 ? table.Columns.Data[table.ReorderColumn].DisplayOrder : -1;
        i32 reorder_min_order = is_reordering != 0 ? TableGetMaxDisplayOrderAllowed(table, reorder_src_order, 0) : 0;
        i32 reorder_max_order = is_reordering != 0 ? TableGetMaxDisplayOrderAllowed(table, reorder_src_order, table.ColumnsCount - 1) : table.ColumnsCount - 1;
        ImGui_PushItemFlag(ImGuiItemFlags_AutoClosePopups, false);
        for i32 order_n = 0; order_n < table.ColumnsCount; order_n++ {
            i32 column_n = table.DisplayOrderToIndex.Data[order_n];
            ImGuiTableColumn* column = &table.Columns.Data[column_n];
            if (column.Flags & ImGuiTableColumnFlags_Disabled) != 0 {
                continue;
            }
            u8* name = ImGui_TableGetColumnName(table, column_n);
            if name == null || name[0] == 0 {
                name = "<Unknown>";
            }
            bool menu_item_enabled = ((column.Flags & ImGuiTableColumnFlags_NoHide) != 0 ? false : true) != 0;
            if column.IsUserEnabled && table.ColumnsEnabledCount <= 1 {
                menu_item_enabled = false;
            }
            if is_reordering && (column.DisplayOrder < reorder_min_order || column.DisplayOrder > reorder_max_order) {
                menu_item_enabled = false;
            }
            if MenuItemForColumnReorder(name, column.IsUserEnabled, menu_item_enabled) != 0 {
                column.IsUserEnabledNextFrame = !column.IsUserEnabled;
            }
            if ImGui_IsItemActive() && ImGui_IsMouseDragging(0, -1.0f) && g.ActiveIdSource == ImGuiInputSource_Mouse && table.Flags & ImGuiTableFlags_Reorderable {
                g.ActiveIdHasBeenEditedBefore = true;
                table.ReorderColumn = cast(ImGuiTableColumnIdx, column_n);
                if ImGui_IsItemHovered(0) == 0 {
                    i32 reorder_dir = g.IO.MousePos.y < (g.LastItemData.Rect.Min.y + g.LastItemData.Rect.Max.y) * 0.5f ? -1 : 1;
                    f32 reorder_amount = (reorder_dir < 0 ? g.LastItemData.Rect.Min.y - g.IO.MousePos.y : g.IO.MousePos.y - g.LastItemData.Rect.Max.y) / ImRect_GetHeight(&g.LastItemData.Rect);
                    i32 dst_order = column.DisplayOrder + cast(i32, ceil(reorder_amount)) * reorder_dir;
                    ImGui_TableQueueSetColumnDisplayOrder(table, column_n, dst_order);
                }
            }
        }
        ImGui_PopItemFlag();
    }
}

//-------------------------------------------------------------------------
// [SECTION] Tables: Settings (.ini data)
//-------------------------------------------------------------------------
// FIXME: The binding/finding/creating flow are too confusing.
//-------------------------------------------------------------------------
// - TableSettingsInit() [Internal]
// - TableSettingsCalcChunkSize() [Internal]
// - TableSettingsCreate() [Internal]
// - TableSettingsFindByID() [Internal]
// - TableGetBoundSettings() [Internal]
// - TableResetSettings()
// - TableSaveSettings() [Internal]
// - TableLoadSettings() [Internal]
// - TableLoadSettingsForColumns() [Internal]
// - TableSettingsHandler_ClearAll() [Internal]
// - TableSettingsHandler_ApplyAll() [Internal]
// - TableSettingsHandler_ReadOpen() [Internal]
// - TableSettingsHandler_ReadLine() [Internal]
// - TableSettingsHandler_WriteAll() [Internal]
// - TableSettingsInstallHandler() [Internal]
//-------------------------------------------------------------------------
// [Init] 1: TableSettingsHandler_ReadXXXX()   Load and parse .ini file into TableSettings.
// [Main] 2: TableLoadSettings()               When table is created, bind Table to TableSettings, serialize TableSettings data into Table.
// [Main] 3: TableSaveSettings()               When table properties are modified, serialize Table data into bound or new TableSettings, mark .ini as dirty.
// [Main] 4: TableSettingsHandler_WriteAll()   When .ini file is dirty (which can come from other source), save TableSettings into .ini file.
//-------------------------------------------------------------------------
// Clear and initialize empty settings instance
private {
void TableSettingsInit(ImGuiTableSettings* settings, ImGuiID id, i32 columns_count, i32 columns_count_max) {
    ImGuiTableSettings_init(settings);
    ImGuiTableColumnSettings* settings_column = ImGuiTableSettings_GetColumnSettings(settings);
    for i32 n = 0; n < columns_count_max; n++ {
        ImGuiTableColumnSettings_init(settings_column);
        settings_column++;
    }
    settings.ID = id;
    settings.ColumnsCount = cast(ImGuiTableColumnIdx, columns_count);
    settings.ColumnsCountMax = cast(ImGuiTableColumnIdx, columns_count_max);
    settings.WantApply = true;
}

u64 TableSettingsCalcChunkSize(i32 columns_count) {
    return cast(u64, sizeof(ImGuiTableSettings)) + cast(u64, columns_count) * cast(u64, sizeof(ImGuiTableColumnSettings));
}
}

ImGuiTableSettings* ImGui_TableSettingsCreate(ImGuiID id, i32 columns_count) {
    ImGuiContext* g = GImGui;
    {
        ImGuiTableSettings* settings = ImGui_TableSettingsFindByID(id);
        if settings != null {
            if settings.ColumnsCountMax >= columns_count {
                TableSettingsInit(settings, id, columns_count, settings.ColumnsCountMax);
                return settings;
            }
            settings.ID = 0;
        }
    }
    ImGuiTableSettings* settings = ImChunkStream_ImGuiTableSettings_alloc_chunk(&g.SettingsTables, TableSettingsCalcChunkSize(columns_count));
    TableSettingsInit(settings, id, columns_count, columns_count);
    return settings;
}

// Find existing settings
ImGuiTableSettings* ImGui_TableSettingsFindByID(ImGuiID id) {
    ImGuiContext* g = GImGui;
    for ImGuiTableSettings* settings = ImChunkStream_ImGuiTableSettings_begin(&g.SettingsTables); settings != null; settings = ImChunkStream_ImGuiTableSettings_next_chunk(&g.SettingsTables, settings) {
        if settings.ID == id {
            return settings;
        }
    }
    return null;
}

// Get settings for a given table, NULL if none
ImGuiTableSettings* ImGui_TableGetBoundSettings(ImGuiTable* table) {
    if table.SettingsOffset == -1 {
        return null;
    }
    ImGuiContext* g = GImGui;
    ImGuiTableSettings* settings = ImChunkStream_ImGuiTableSettings_ptr_from_offset(&g.SettingsTables, table.SettingsOffset);
    assert(settings.ID == table.ID);
    return settings;
}

// Restore initial state of table (with or without saved settings)
void ImGui_TableResetSettings(ImGuiTable* table) {
    table.IsSettingsDirty = true;
    table.IsInitializing = table.IsSettingsDirty;
    table.IsResetAllRequest = false;
    table.IsSettingsRequestLoad = false;
    table.SettingsLoadedFlags = ImGuiTableFlags_None;
}

void ImGui_TableSaveSettings(ImGuiTable* table) {
    table.IsSettingsDirty = false;
    if (table.Flags & ImGuiTableFlags_NoSavedSettings) != 0 {
        return;
    }
    ImGuiContext* g = GImGui;
    ImGuiTableSettings* settings = ImGui_TableGetBoundSettings(table);
    if settings != null && table.ColumnsCount > settings.ColumnsCountMax {
        settings.ID = 0;
        settings = null;
    }
    if settings == null {
        settings = ImGui_TableSettingsCreate(table.ID, table.ColumnsCount);
        table.SettingsOffset = ImChunkStream_ImGuiTableSettings_offset_from_ptr(&g.SettingsTables, settings);
    }
    settings.ColumnsCount = cast(ImGuiTableColumnIdx, table.ColumnsCount);
    settings.LastUsedDate = g.SessionDate;
    assert(settings.ID == table.ID);
    assert(settings.ColumnsCount == table.ColumnsCount && settings.ColumnsCountMax >= settings.ColumnsCount);
    ImGuiTableColumn* column = table.Columns.Data;
    ImGuiTableColumnSettings* column_settings = ImGuiTableSettings_GetColumnSettings(settings);
    bool save_ref_scale = false;
    settings.SaveFlags = ImGuiTableFlags_None;
    for i32 n = 0; n < table.ColumnsCount; n++ {
        f32 width_or_weight = (column.Flags & ImGuiTableColumnFlags_WidthStretch) != 0 ? column.StretchWeight : column.WidthRequest;
        column_settings.ID = column.ID;
        column_settings.WidthOrWeight = width_or_weight;
        column_settings.Index = cast(ImGuiTableColumnIdx, n);
        column_settings.DisplayOrder = column.DisplayOrder;
        column_settings.SortOrder = column.SortOrder;
        column_settings.SortDirection = column.SortDirection;
        column_settings.IsEnabled = column.IsUserEnabled;
        column_settings.IsStretch = cast(ImU8, (column.Flags & ImGuiTableColumnFlags_WidthStretch) != 0 ? 1 : 0);
        if (column.Flags & ImGuiTableColumnFlags_WidthStretch) == 0 {
            save_ref_scale = true;
        }
        if width_or_weight != column.InitStretchWeightOrWidth {
            settings.SaveFlags |= ImGuiTableFlags_Resizable;
        }
        if column.DisplayOrder != n {
            settings.SaveFlags |= ImGuiTableFlags_Reorderable;
        }
        if column.SortOrder != -1 {
            settings.SaveFlags |= ImGuiTableFlags_Sortable;
        }
        if column.IsUserEnabled != ((column.Flags & ImGuiTableColumnFlags_DefaultHide) == 0) {
            settings.SaveFlags |= ImGuiTableFlags_Hideable;
        }
        column++;
        column_settings++;
    }
    settings.SaveFlags &= table.Flags;
    settings.RefScale = save_ref_scale != 0 ? table.RefScale : 0.0f;
    ImGui_MarkIniSettingsDirty();
}

void ImGui_TableLoadSettings(ImGuiTable* table) {
    ImGuiContext* g = GImGui;
    if (table.Flags & ImGuiTableFlags_NoSavedSettings) != 0 {
        table.IsSettingsRequestLoad = false;
        return;
    }
    ImGuiTableSettings* settings;
    if table.SettingsOffset == -1 {
        settings = ImGui_TableSettingsFindByID(table.ID);
        if settings == null {
            return;
        }
        if settings.ColumnsCount != table.ColumnsCount {
            table.IsSettingsDirty = true;
        }
        table.SettingsOffset = ImChunkStream_ImGuiTableSettings_offset_from_ptr(&g.SettingsTables, settings);
    } else {
        settings = ImGui_TableGetBoundSettings(table);
    }
    table.SettingsLoadedFlags = settings.SaveFlags;
    table.RefScale = settings.RefScale;
    settings.LastUsedDate = g.SessionDate;
}

// NB: This was written to be similar to the logic in TableReconcileColumns().
void ImGui_TableLoadSettingsForColumns(ImGuiTable* table) {
    {
        ImGuiTableColumn* zz_rf_it_9 = ImSpan_ImGuiTableColumn_begin(&table.Columns);
        ImGuiTableColumn* zz_rf_end_9 = ImSpan_ImGuiTableColumn_end(&table.Columns);
        for ; zz_rf_it_9 != zz_rf_end_9; zz_rf_it_9++ {
            ImGuiTableColumn* column = zz_rf_it_9;
            column.IsLoadedSettings = false;
        }
    }
    ImGuiTableSettings* settings = ImGui_TableGetBoundSettings(table);
    if settings == null {
        return;
    }
    table.SettingsLoadedFlags |= ImGuiTableFlags_Reorderable;
    ImGuiTableColumnSettings* column_settings = ImGuiTableSettings_GetColumnSettings(settings);
    i32 matches = 0;
    for i32 n = 0; n < table.ColumnsCount; n++ {
        if n >= settings.ColumnsCount || column_settings[n].ID != table.Columns.Data[n].ID {
            break;
        }
        ImGui_TableLoadSettingsForColumn(&table.Columns.Data[n], &column_settings[n], settings.SaveFlags);
        matches++;
    }
    if matches == settings.ColumnsCount {
        return;
    }
    i32 settings_start_n = matches;
    for i32 n = settings_start_n; n < settings.ColumnsCount; n++ {
        column_settings[n].IsLoaded = false;
    }
    {
        ImGuiTableColumn* zz_rf_it_10 = ImSpan_ImGuiTableColumn_begin(&table.Columns);
        ImGuiTableColumn* zz_rf_end_10 = ImSpan_ImGuiTableColumn_end(&table.Columns);
        for ; zz_rf_it_10 != zz_rf_end_10; zz_rf_it_10++ {
            ImGuiTableColumn* column = zz_rf_it_10;
            if column.ID != 0 && !column.IsLoadedSettings {
                for i32 n = settings_start_n; n < settings.ColumnsCount; n++ {
                    if column_settings[n].ID == column.ID && !column_settings[n].IsLoaded {
                        ImGui_TableLoadSettingsForColumn(column, &column_settings[n], settings.SaveFlags);
                        matches++;
                        break;
                    }
                }
            }
        }
    }
    i32 dst_idx = 0;
    for i32 n = settings_start_n; n < settings.ColumnsCount; n++ {
        if column_settings[n].IsLoaded == 0 {
            while dst_idx < table.ColumnsCount && table.Columns.Data[dst_idx].IsLoadedSettings {
                dst_idx++;
            }
            if dst_idx >= table.ColumnsCount {
                break;
            }
            ImGui_TableLoadSettingsForColumn(&table.Columns.Data[dst_idx], &column_settings[n], settings.SaveFlags);
            dst_idx++;
        }
    }
}

void ImGui_TableLoadSettingsForColumn(ImGuiTableColumn* column, ImGuiTableColumnSettings* column_settings, ImGuiTableFlags load_flags) {
    column.IsLoadedSettings = true;
    column_settings.IsLoaded = true;
    if (load_flags & ImGuiTableFlags_Resizable) != 0 {
        if column_settings.IsStretch != 0 {
            column.StretchWeight = column_settings.WidthOrWeight;
        } else {
            column.WidthRequest = column_settings.WidthOrWeight;
        }
        column.AutoFitQueue = 0x00;
    }
    if (load_flags & ImGuiTableFlags_Reorderable) != 0 {
        column.DisplayOrder = column_settings.DisplayOrder;
    } else {
        column.DisplayOrder = column_settings.Index;
    }
    if load_flags & ImGuiTableFlags_Hideable && column_settings.IsEnabled != -1 {
        column.IsUserEnabledNextFrame = column_settings.IsEnabled == 1;
        column.IsUserEnabled = column.IsUserEnabledNextFrame;
    }
    column.SortOrder = column_settings.SortOrder;
    column.SortDirection = column_settings.SortDirection;
}

// Sort by DisplayOrder and then Index
private {
i32 TableFixDisplayOrderComparer(void* lhs, void* rhs) {
    ImGuiTable* table = cast(ImGuiTableFixDisplayOrderColumnData*, lhs).Table;
    ImGuiTableColumnIdx lhs_idx = cast(ImGuiTableFixDisplayOrderColumnData*, lhs).Idx;
    ImGuiTableColumnIdx rhs_idx = cast(ImGuiTableFixDisplayOrderColumnData*, rhs).Idx;
    var order_delta = cast(i32, cast(u16, table.Columns.Data[lhs_idx].DisplayOrder) - cast(u16, table.Columns.Data[rhs_idx].DisplayOrder));
    return order_delta > 0 ? 1 : order_delta < 0 ? -1 : lhs_idx > rhs_idx ? 1 : -1;
}
}

// Fix invalid display order data: compact values (0,1,3 -> 0,1,2); preserve relative order (0,3,1 -> 0,2,1); deduplicate (0,4,1,1 -> 0,3,1,2)
void ImGui_TableFixDisplayOrder(ImGuiTable* table) {
    ImGuiContext* g = GImGui;
    ImVector_char_reserve(&g.TempBuffer, cast(i32, sizeof(ImGuiTableFixDisplayOrderColumnData) * table.ColumnsCount));
    var fdo_columns = cast(ImGuiTableFixDisplayOrderColumnData*, cast(void*, g.TempBuffer.Data));
    for i32 n = 0; n < table.ColumnsCount; n++ {
        fdo_columns[n].Idx = cast(ImGuiTableColumnIdx, n);
        fdo_columns[n].Table = table;
    }
    ImQsort(fdo_columns, cast(u64, table.ColumnsCount), cast(u64, sizeof(ImGuiTableFixDisplayOrderColumnData)), cast(fn(void*, void*): i32, TableFixDisplayOrderComparer));
    for i32 n = 0; n < table.ColumnsCount; n++ {
        table.Columns.Data[fdo_columns[n].Idx].DisplayOrder = cast(ImGuiTableColumnIdx, n);
    }
    for i32 n = 0; n < table.ColumnsCount; n++ {
        table.DisplayOrderToIndex.Data[table.Columns.Data[n].DisplayOrder] = cast(ImGuiTableColumnIdx, n);
    }
}

private {
void TableSettingsHandler_ClearAll(ImGuiContext* ctx, ImGuiSettingsHandler* _1) {
    ImGuiContext* g = ctx;
    for i32 i = 0; i != ImPool_ImGuiTable_GetMapSize(&g.Tables); i++ {
        ImGuiTable* table = ImPool_ImGuiTable_TryGetMapData(&g.Tables, i);
        if table != null {
            table.SettingsOffset = -1;
        }
    }
    ImChunkStream_ImGuiTableSettings_clear(&g.SettingsTables);
}

void TableSettingsHandler_Cleanup(ImGuiContext* ctx, ImGuiSettingsHandler* _1, ImGuiSettingsCleanupArgs* args) {
    ImGuiContext* g = ctx;
    for i32 i = 0; i != ImPool_ImGuiTable_GetMapSize(&g.Tables); i++ {
        ImGuiTable* table = ImPool_ImGuiTable_TryGetMapData(&g.Tables, i);
        if table != null {
            table.SettingsOffset = -1;
        }
    }
    for ImGuiTableSettings* settings = ImChunkStream_ImGuiTableSettings_begin(&g.SettingsTables); settings != null; settings = ImChunkStream_ImGuiTableSettings_next_chunk(&g.SettingsTables, settings) {
        bool is_valid = ImGuiPackedDate_IsValid(&settings.LastUsedDate);
        if args._DiscardOlderThanDate != 0 && ImGuiPackedDate_Unpack(&settings.LastUsedDate) < args._DiscardOlderThanDate {
            settings.ID = 0;
        } else if args.DiscardWhenMissingDate && !is_valid {
            settings.ID = 0;
        } else if args.SetCurrentSessionDateToAll || args.SetCurrentSessionDateWhenMissingDate && !is_valid {
            settings.LastUsedDate = g.SessionDate;
        }
    }
}

// Apply to existing windows (if any)
void TableSettingsHandler_ApplyAll(ImGuiContext* ctx, ImGuiSettingsHandler* _1) {
    ImGuiContext* g = ctx;
    for i32 i = 0; i != ImPool_ImGuiTable_GetMapSize(&g.Tables); i++ {
        ImGuiTable* table = ImPool_ImGuiTable_TryGetMapData(&g.Tables, i);
        if table != null {
            table.IsSettingsRequestLoad = true;
            table.SettingsOffset = -1;
        }
    }
}

void* TableSettingsHandler_ReadOpen(ImGuiContext* _0, ImGuiSettingsHandler* _1, u8* name) {
    ImGuiID id = 0;
    i32 columns_count = 0;
    if sscanf(name, "0x%08X,%d", &id, &columns_count) < 2 || columns_count <= 0 || columns_count >= 512 {
        return null;
    }
    return ImGui_TableSettingsCreate(id, columns_count);
}

void TableSettingsHandler_ReadLine(ImGuiContext* _0, ImGuiSettingsHandler* _1, void* entry, u8* line) {
    var settings = cast(ImGuiTableSettings*, entry);
    f32 f = 0.0f;
    i32 column_n = 0;
    i32 r = 0;
    i32 n = 0;
    if sscanf(line, "RefScale=%f", &f) == 1 {
        settings.RefScale = f;
        return;
    }
    if sscanf(line, "LastUsed=%d", &n) == 1 {
        ImGuiPackedDate_init(&settings.LastUsedDate, n);
        return;
    }
    if sscanf(line, "Column %d%n", &column_n, &r) == 1 {
        if column_n < 0 || column_n >= settings.ColumnsCount {
            return;
        }
        line = ImStrSkipBlank(line + r);
        u8 c = 0;
        ImGuiTableColumnSettings* column = ImGuiTableSettings_GetColumnSettings(settings) + column_n;
        column.Index = cast(ImGuiTableColumnIdx, column_n);
        if sscanf(line, "UserID=0x%08X%n", cast(ImU32*, &n), &r) == 1 {
            line = ImStrSkipBlank(line + r);
        }
        if sscanf(line, "Width=%d%n", &n, &r) == 1 {
            line = ImStrSkipBlank(line + r);
            column.WidthOrWeight = cast(f32, n);
            column.IsStretch = 0;
            settings.SaveFlags |= ImGuiTableFlags_Resizable;
        }
        if sscanf(line, "Weight=%f%n", &f, &r) == 1 {
            line = ImStrSkipBlank(line + r);
            column.WidthOrWeight = f;
            column.IsStretch = 1;
            settings.SaveFlags |= ImGuiTableFlags_Resizable;
        }
        if sscanf(line, "Visible=%d%n", &n, &r) == 1 {
            line = ImStrSkipBlank(line + r);
            column.IsEnabled = cast(ImS8, cast(ImU8, n));
            settings.SaveFlags |= ImGuiTableFlags_Hideable;
        }
        if sscanf(line, "Order=%d%n", &n, &r) == 1 {
            line = ImStrSkipBlank(line + r);
            column.DisplayOrder = cast(ImGuiTableColumnIdx, n);
            settings.SaveFlags |= ImGuiTableFlags_Reorderable;
        }
        if sscanf(line, "Sort=%d%c%n", &n, &c, &r) == 2 {
            line = ImStrSkipBlank(line + r);
            column.SortOrder = cast(ImGuiTableColumnIdx, n);
            column.SortDirection = cast(ImU8, c == 94 ? ImGuiSortDirection_Descending : ImGuiSortDirection_Ascending);
            settings.SaveFlags |= ImGuiTableFlags_Sortable;
        }
        if sscanf(line, "ID=0x%08X%n", cast(ImU32*, &n), &r) == 1 {
            line = ImStrSkipBlank(line + r);
            column.ID = cast(ImGuiID, n);
        }
    }
}

void TableSettingsHandler_WriteAll(ImGuiContext* ctx, ImGuiSettingsHandler* handler, ImGuiTextBuffer* buf) {
    ImGuiContext* g = ctx;
    for ImGuiTableSettings* settings = ImChunkStream_ImGuiTableSettings_begin(&g.SettingsTables); settings != null; settings = ImChunkStream_ImGuiTableSettings_next_chunk(&g.SettingsTables, settings) {
        if settings.ID == 0 {
            continue;
        }
        bool save_size = (settings.SaveFlags & ImGuiTableFlags_Resizable) != 0;
        bool save_visible = (settings.SaveFlags & ImGuiTableFlags_Hideable) != 0;
        bool save_order = (settings.SaveFlags & ImGuiTableFlags_Reorderable) != 0;
        bool save_sort = (settings.SaveFlags & ImGuiTableFlags_Sortable) != 0;
        ImGuiTextBuffer_reserve(buf, ImGuiTextBuffer_size(buf) + 30 + settings.ColumnsCount * 50);
        ImGuiTextBuffer_appendf(buf, "[%s][0x%08X,%d]\n", handler.TypeName, settings.ID, settings.ColumnsCount);
        if settings.RefScale != 0.0f {
            ImGuiTextBuffer_appendf(buf, "RefScale=%g\n", settings.RefScale);
        }
        ImGuiTableColumnSettings* column = ImGuiTableSettings_GetColumnSettings(settings);
        for i32 column_n = 0; column_n < settings.ColumnsCount; column_n++ {
            bool save_column = save_size || save_visible || save_order || save_sort && column.SortOrder != -1;
            if save_column == 0 {
                column++;
                continue;
            }
            ImGuiTextBuffer_appendf(buf, "Column %-2d", column_n);
            if save_size && column.IsStretch {
                ImGuiTextBuffer_appendf(buf, " Weight=%.4f", column.WidthOrWeight);
            }
            if save_size && !column.IsStretch {
                ImGuiTextBuffer_appendf(buf, " Width=%d", cast(i32, column.WidthOrWeight));
            }
            if save_visible != 0 {
                ImGuiTextBuffer_appendf(buf, " Visible=%d", column.IsEnabled);
            }
            if save_order != 0 {
                ImGuiTextBuffer_appendf(buf, " Order=%d", column.DisplayOrder);
            }
            if save_sort && column.SortOrder != -1 {
                ImGuiTextBuffer_appendf(buf, " Sort=%d%c", column.SortOrder, cast(i32, column.SortDirection) == ImGuiSortDirection_Ascending ? 118 : 94);
            }
            if column.ID != 0 {
                ImGuiTextBuffer_appendf(buf, " ID=0x%08X", column.ID);
            }
            ImGuiTextBuffer_append(buf, "\n", null);
            column++;
        }
        if g.IO.ConfigIniSettingsSaveLastUsedDate != 0 {
            i32 last_used_date = ImGuiPackedDate_Unpack(&settings.LastUsedDate);
            if last_used_date != 0 {
                ImGuiTextBuffer_appendf(buf, "LastUsed=%08d\n", last_used_date);
            }
        }
        ImGuiTextBuffer_append(buf, "\n", null);
    }
}
}

void ImGui_TableSettingsAddSettingsHandler() {
    ImGuiSettingsHandler ini_handler;
    ini_handler.TypeName = "Table";
    ini_handler.TypeHash = ImHashStr("Table", 0, 0);
    ini_handler.ClearAllFn = TableSettingsHandler_ClearAll;
    ini_handler.CleanupFn = TableSettingsHandler_Cleanup;
    ini_handler.ReadOpenFn = TableSettingsHandler_ReadOpen;
    ini_handler.ReadLineFn = TableSettingsHandler_ReadLine;
    ini_handler.ApplyAllFn = TableSettingsHandler_ApplyAll;
    ini_handler.WriteAllFn = TableSettingsHandler_WriteAll;
    ImGui_AddSettingsHandler(&ini_handler);
}

//-------------------------------------------------------------------------
// [SECTION] Tables: Garbage Collection
//-------------------------------------------------------------------------
// - TableRemove() [Internal]
// - TableGcCompactTransientBuffers() [Internal]
// - TableGcCompactSettings() [Internal]
//-------------------------------------------------------------------------
// Remove Table data (currently only used by TestEngine)
void ImGui_TableRemove(ImGuiTable* table) {
    ImGuiContext* g = GImGui;
    i32 table_idx = ImPool_ImGuiTable_GetIndex(&g.Tables, table);
    ImPool_ImGuiTable_Remove(&g.Tables, table.ID, table);
    g.TablesLastTimeActive.Data[table_idx] = -1.0f;
}

// Free up/compact internal Table buffers for when it gets unused
void ImGui_TableGcCompactTransientBuffers(ImGuiTable* table) {
    ImGuiContext* g = GImGui;
    assert(table.MemoryCompacted == false);
    table.SortSpecs.Specs = null;
    ImVector_ImGuiTableColumnSortSpecs_clear(&table.SortSpecsMulti);
    table.IsSortSpecsDirty = true;
    ImGuiTextBuffer_clear(&table.ColumnsNames);
    table.MemoryCompacted = true;
    for i32 n = 0; n < table.ColumnsCount; n++ {
        table.Columns.Data[n].NameOffset = cast(ImS16, -1);
    }
    g.TablesLastTimeActive.Data[ImPool_ImGuiTable_GetIndex(&g.Tables, table)] = -1.0f;
}

void ImGui_TableGcCompactTransientBuffers(ImGuiTableTempData* temp_data) {
    ImVector_ImGuiTableHeaderData_clear(&temp_data.AngledHeadersRequests);
    ImDrawListSplitter_ClearFreeMemory(&temp_data.DrawSplitter);
    temp_data.LastTimeActive = -1.0f;
}

// Compact and remove unused or resize settings data (only TestEngine mark unused, but resizing table down can lead to compaction)
void ImGui_TableGcCompactSettings() {
    ImGuiContext* g = GImGui;
    i32 required_memory = 0;
    for ImGuiTableSettings* settings = ImChunkStream_ImGuiTableSettings_begin(&g.SettingsTables); settings != null; settings = ImChunkStream_ImGuiTableSettings_next_chunk(&g.SettingsTables, settings) {
        if settings.ID != 0 {
            required_memory += cast(i32, TableSettingsCalcChunkSize(settings.ColumnsCount));
        }
    }
    if required_memory == g.SettingsTables.Buf.Size {
        return;
    }
    ImChunkStream_ImGuiTableSettings new_chunk_stream;
    ImVector_char_reserve(&new_chunk_stream.Buf, required_memory);
    for ImGuiTableSettings* settings = ImChunkStream_ImGuiTableSettings_begin(&g.SettingsTables); settings != null; settings = ImChunkStream_ImGuiTableSettings_next_chunk(&g.SettingsTables, settings) {
        if settings.ID != 0 {
            memcpy(ImChunkStream_ImGuiTableSettings_alloc_chunk(&new_chunk_stream, TableSettingsCalcChunkSize(settings.ColumnsCount)), settings, TableSettingsCalcChunkSize(settings.ColumnsCount));
        }
    }
    ImChunkStream_ImGuiTableSettings_swap(&g.SettingsTables, &new_chunk_stream);
    for i32 table_n = 0; table_n < ImPool_ImGuiTable_GetMapSize(&g.Tables); table_n++ {
        ImGuiTable* table = ImPool_ImGuiTable_TryGetMapData(&g.Tables, table_n);
        if table != null {
            table.SettingsOffset = -1;
        }
    }
}
//-------------------------------------------------------------------------
// [SECTION] Tables: Debugging
//-------------------------------------------------------------------------
// - DebugNodeTable() [Internal]
// - DebugNodeTableSettings() [Internal]
//-------------------------------------------------------------------------
when !(defined(IMGUI_DISABLE_DEBUG_TOOLS)) {

private {
u8* DebugNodeTableGetSizingPolicyDesc(ImGuiTableFlags sizing_policy) {
    sizing_policy &= ImGuiTableFlags_SizingMask_;
    if sizing_policy == ImGuiTableFlags_SizingFixedFit {
        return "FixedFit";
    }
    if sizing_policy == ImGuiTableFlags_SizingFixedSame {
        return "FixedSame";
    }
    if sizing_policy == ImGuiTableFlags_SizingStretchProp {
        return "StretchProp";
    }
    if sizing_policy == ImGuiTableFlags_SizingStretchSame {
        return "StretchSame";
    }
    return "N/A";
}
}

void ImGui_DebugNodeTable(ImGuiTable* table) {
}

void ImGui_DebugNodeTableSettings(ImGuiTableSettings* settings, ImGuiTable* table) {
}
} else {

void ImGui_DebugNodeTable(ImGuiTable* _0) {
}

void ImGui_DebugNodeTableSettings(ImGuiTableSettings* _0, ImGuiTable* _1) {
}
}

//-------------------------------------------------------------------------
// [SECTION] Columns, BeginColumns, EndColumns, etc.
// (This is a legacy API, prefer using BeginTable/EndTable!)
//-------------------------------------------------------------------------
// FIXME: sizing is lossy when columns width is very small (default width may turn negative etc.)
//-------------------------------------------------------------------------
// - SetWindowClipRectBeforeSetChannel() [Internal]
// - GetColumnIndex()
// - GetColumnsCount()
// - GetColumnOffset()
// - GetColumnWidth()
// - SetColumnOffset()
// - SetColumnWidth()
// - PushColumnClipRect() [Internal]
// - PushColumnsBackground() [Internal]
// - PopColumnsBackground() [Internal]
// - FindOrCreateColumns() [Internal]
// - GetColumnsID() [Internal]
// - BeginColumns()
// - NextColumn()
// - EndColumns()
// - Columns()
//-------------------------------------------------------------------------
// [Internal] Small optimization to avoid calls to PopClipRect/SetCurrentChannel/PushClipRect in sequences,
// they would meddle many times with the underlying ImDrawCmd.
// Instead, we do a preemptive overwrite of clipping rectangle _without_ altering the command-buffer and let
// the subsequent single call to SetCurrentChannel() does it things once.
void ImGui_SetWindowClipRectBeforeSetChannel(ImGuiWindow* window, ImRect clip_rect) {
    ImVec4 clip_rect_vec4 = ImRect_ToVec4(&clip_rect);
    window.ClipRect = clip_rect;
    window.DrawList._CmdHeader.ClipRect = clip_rect_vec4;
    window.DrawList._ClipRectStack.Data[window.DrawList._ClipRectStack.Size - 1] = clip_rect_vec4;
}

i32 ImGui_GetColumnIndex() {
    ImGuiWindow* window = ImGui_GetCurrentWindowRead();
    return window.DC.CurrentColumns != null ? window.DC.CurrentColumns.Current : 0;
}

i32 ImGui_GetColumnsCount() {
    ImGuiWindow* window = ImGui_GetCurrentWindowRead();
    return window.DC.CurrentColumns != null ? window.DC.CurrentColumns.Count : 1;
}

f32 ImGui_GetColumnOffsetFromNorm(ImGuiOldColumns* columns, f32 offset_norm) {
    return offset_norm * (columns.OffMaxX - columns.OffMinX);
}

f32 ImGui_GetColumnNormFromOffset(ImGuiOldColumns* columns, f32 offset) {
    return offset / (columns.OffMaxX - columns.OffMinX);
}
private {
f32 COLUMNS_HIT_RECT_HALF_THICKNESS = 4.0f;

f32 GetDraggedColumnOffset(ImGuiOldColumns* columns, i32 column_index) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    assert(column_index > 0);
    assert(g.ActiveId == columns.ID + cast(ImGuiID, column_index));
    f32 x = g.IO.MousePos.x - g.ActiveIdClickOffset.x + ImTrunc(COLUMNS_HIT_RECT_HALF_THICKNESS * g.CurrentDpiScale) - window.Pos.x;
    x = ImMax(x, ImGui_GetColumnOffset(column_index - 1) + g.Style.ColumnsMinSpacing);
    if (columns.Flags & ImGuiOldColumnFlags_NoPreserveWidths) != 0 {
        x = ImMin(x, ImGui_GetColumnOffset(column_index + 1) - g.Style.ColumnsMinSpacing);
    }
    return x;
}
}

f32 ImGui_GetColumnOffset(i32 column_index) {
    ImGuiWindow* window = ImGui_GetCurrentWindowRead();
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    if columns == null {
        return 0.0f;
    }
    if column_index < 0 {
        column_index = columns.Current;
    }
    assert(column_index < columns.Columns.Size);
    f32 t = columns.Columns.Data[column_index].OffsetNorm;
    f32 x_offset = ImLerp(columns.OffMinX, columns.OffMaxX, t);
    return x_offset;
}

private {
f32 GetColumnWidthEx(ImGuiOldColumns* columns, i32 column_index, bool before_resize) {
    if column_index < 0 {
        column_index = columns.Current;
    }
    f32 offset_norm;
    if before_resize != 0 {
        offset_norm = columns.Columns.Data[column_index + 1].OffsetNormBeforeResize - columns.Columns.Data[column_index].OffsetNormBeforeResize;
    } else {
        offset_norm = columns.Columns.Data[column_index + 1].OffsetNorm - columns.Columns.Data[column_index].OffsetNorm;
    }
    return ImGui_GetColumnOffsetFromNorm(columns, offset_norm);
}
}

f32 ImGui_GetColumnWidth(i32 column_index) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    if columns == null {
        return ImGui_GetContentRegionAvail().x;
    }
    if column_index < 0 {
        column_index = columns.Current;
    }
    return ImGui_GetColumnOffsetFromNorm(columns, columns.Columns.Data[column_index + 1].OffsetNorm - columns.Columns.Data[column_index].OffsetNorm);
}

void ImGui_SetColumnOffset(i32 column_index, f32 offset) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    assert(columns != null);
    if column_index < 0 {
        column_index = columns.Current;
    }
    assert(column_index < columns.Columns.Size);
    bool preserve_width = !(columns.Flags & ImGuiOldColumnFlags_NoPreserveWidths) && column_index < columns.Count - 1;
    f32 width = preserve_width != 0 ? GetColumnWidthEx(columns, column_index, columns.IsBeingResized) : 0.0f;
    if (columns.Flags & ImGuiOldColumnFlags_NoForceWithinWindow) == 0 {
        offset = ImMin(offset, columns.OffMaxX - g.Style.ColumnsMinSpacing * cast(f32, columns.Count - column_index));
    }
    columns.Columns.Data[column_index].OffsetNorm = ImGui_GetColumnNormFromOffset(columns, offset - columns.OffMinX);
    if preserve_width != 0 {
        ImGui_SetColumnOffset(column_index + 1, offset + ImMax(g.Style.ColumnsMinSpacing, width));
    }
}

void ImGui_SetColumnWidth(i32 column_index, f32 width) {
    ImGuiWindow* window = ImGui_GetCurrentWindowRead();
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    assert(columns != null);
    if column_index < 0 {
        column_index = columns.Current;
    }
    ImGui_SetColumnOffset(column_index + 1, ImGui_GetColumnOffset(column_index) + width);
}

void ImGui_PushColumnClipRect(i32 column_index) {
    ImGuiWindow* window = ImGui_GetCurrentWindowRead();
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    if column_index < 0 {
        column_index = columns.Current;
    }
    ImGuiOldColumnData* column = &columns.Columns.Data[column_index];
    ImGui_PushClipRect(column.ClipRect.Min, column.ClipRect.Max, false);
}

// Get into the columns background draw command (which is generally the same draw command as before we called BeginColumns)
void ImGui_PushColumnsBackground() {
    ImGuiWindow* window = ImGui_GetCurrentWindowRead();
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    if columns.Count == 1 {
        return;
    }
    columns.HostBackupClipRect = window.ClipRect;
    ImGui_SetWindowClipRectBeforeSetChannel(window, columns.HostInitialClipRect);
    ImDrawListSplitter_SetCurrentChannel(&columns.Splitter, window.DrawList, 0);
}

void ImGui_PopColumnsBackground() {
    ImGuiWindow* window = ImGui_GetCurrentWindowRead();
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    if columns.Count == 1 {
        return;
    }
    ImGui_SetWindowClipRectBeforeSetChannel(window, columns.HostBackupClipRect);
    ImDrawListSplitter_SetCurrentChannel(&columns.Splitter, window.DrawList, columns.Current + 1);
}

ImGuiOldColumns* ImGui_FindOrCreateColumns(ImGuiWindow* window, ImGuiID id) {
    for i32 n = 0; n < window.ColumnsStorage.Size; n++ {
        if window.ColumnsStorage.Data[n].ID == id {
            return &window.ColumnsStorage.Data[n];
        }
    }
    ImVector_ImGuiOldColumns_push_back(&window.ColumnsStorage, __cxx_make_ImGuiOldColumns());
    ImGuiOldColumns* columns = ImVector_ImGuiOldColumns_back(&window.ColumnsStorage);
    columns.ID = id;
    return columns;
}

ImGuiID ImGui_GetColumnsID(u8* str_id, i32 columns_count) {
    ImGuiWindow* window = ImGui_GetCurrentWindow();
    ImGui_PushID(0x11223347 + (str_id != null ? 0 : columns_count));
    ImGuiID id = ImGuiWindow_GetID(window, str_id != null ? str_id : "columns", null);
    ImGui_PopID();
    return id;
}

void ImGui_BeginColumns(u8* str_id, i32 columns_count, ImGuiOldColumnFlags flags) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = ImGui_GetCurrentWindow();
    assert(columns_count >= 1);
    assert(window.DC.CurrentColumns == null);
    ImGuiID id = ImGui_GetColumnsID(str_id, columns_count);
    ImGuiOldColumns* columns = ImGui_FindOrCreateColumns(window, id);
    assert(columns.ID == id);
    columns.Current = 0;
    columns.Count = columns_count;
    columns.Flags = flags;
    window.DC.CurrentColumns = columns;
    window.DC.NavIsScrollPushableX = false;
    columns.HostCursorPosY = window.DC.CursorPos.y;
    columns.HostCursorMaxPosX = window.DC.CursorMaxPos.x;
    columns.HostInitialClipRect = window.ClipRect;
    columns.HostBackupParentWorkRect = window.ParentWorkRect;
    window.ParentWorkRect = window.WorkRect;
    f32 column_padding = g.Style.ItemSpacing.x;
    f32 half_clip_extend_x = ImTrunc(ImMax(window.WindowPadding.x * 0.5f, window.WindowBorderSize));
    f32 max_1 = window.WorkRect.Max.x + column_padding - ImMax(column_padding - window.WindowPadding.x, 0.0f);
    f32 max_2 = window.WorkRect.Max.x + half_clip_extend_x;
    columns.OffMinX = window.DC.Indent.x - column_padding + ImMax(column_padding - window.WindowPadding.x, 0.0f);
    columns.OffMaxX = ImMax(ImMin(max_1, max_2) - window.Pos.x, columns.OffMinX + 1.0f);
    columns.LineMaxY = window.DC.CursorPos.y;
    columns.LineMinY = columns.LineMaxY;
    if columns.Columns.Size != 0 && columns.Columns.Size != columns_count + 1 {
        ImVector_ImGuiOldColumnData_resize(&columns.Columns, 0);
    }
    columns.IsFirstFrame = columns.Columns.Size == 0;
    if columns.Columns.Size == 0 {
        ImVector_ImGuiOldColumnData_reserve(&columns.Columns, columns_count + 1);
        for i32 n = 0; n < columns_count + 1; n++ {
            ImGuiOldColumnData column;
            column.OffsetNorm = cast(f32, n) / cast(f32, columns_count);
            ImVector_ImGuiOldColumnData_push_back(&columns.Columns, column);
        }
    }
    for i32 n = 0; n < columns_count; n++ {
        ImGuiOldColumnData* column = &columns.Columns.Data[n];
        var clip_x1 = cast(f32, cast(i32, window.Pos.x + ImGui_GetColumnOffset(n) + 0.5f));
        var clip_x2 = cast(f32, cast(i32, window.Pos.x + ImGui_GetColumnOffset(n + 1) - 1.0f + 0.5f));
        column.ClipRect = ImRect{ImVec2{clip_x1, -FLT_MAX}, ImVec2{clip_x2, FLT_MAX}};
        ImRect_ClipWithFull(&column.ClipRect, window.ClipRect);
    }
    if columns.Count > 1 {
        ImDrawListSplitter_Split(&columns.Splitter, window.DrawList, 1 + columns.Count);
        ImDrawListSplitter_SetCurrentChannel(&columns.Splitter, window.DrawList, 1);
        ImGui_PushColumnClipRect(0);
    }
    f32 offset_0 = ImGui_GetColumnOffset(columns.Current);
    f32 offset_1 = ImGui_GetColumnOffset(columns.Current + 1);
    f32 width = offset_1 - offset_0;
    ImGui_PushItemWidth(width * 0.65f);
    window.DC.ColumnsOffset.x = ImMax(column_padding - window.WindowPadding.x, 0.0f);
    window.DC.CursorPos.x = cast(f32, cast(i32, window.Pos.x + window.DC.Indent.x + window.DC.ColumnsOffset.x));
    window.WorkRect.Max.x = window.Pos.x + offset_1 - column_padding;
    window.WorkRect.Max.y = window.ContentRegionRect.Max.y;
}

void ImGui_NextColumn() {
    ImGuiWindow* window = ImGui_GetCurrentWindow();
    if window.SkipItems || window.DC.CurrentColumns == null {
        return;
    }
    ImGuiContext* g = GImGui;
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    if columns.Count == 1 {
        window.DC.CursorPos.x = cast(f32, cast(i32, window.Pos.x + window.DC.Indent.x + window.DC.ColumnsOffset.x));
        assert(columns.Current == 0);
        return;
    }
    if ++columns.Current == columns.Count {
        columns.Current = 0;
    }
    ImGui_PopItemWidth();
    ImGuiOldColumnData* column = &columns.Columns.Data[columns.Current];
    ImGui_SetWindowClipRectBeforeSetChannel(window, column.ClipRect);
    ImDrawListSplitter_SetCurrentChannel(&columns.Splitter, window.DrawList, columns.Current + 1);
    f32 column_padding = g.Style.ItemSpacing.x;
    columns.LineMaxY = ImMax(columns.LineMaxY, window.DC.CursorPos.y);
    if columns.Current > 0 {
        window.DC.ColumnsOffset.x = ImGui_GetColumnOffset(columns.Current) - window.DC.Indent.x + column_padding;
    } else {
        window.DC.ColumnsOffset.x = ImMax(column_padding - window.WindowPadding.x, 0.0f);
        window.DC.IsSameLine = false;
        columns.LineMinY = columns.LineMaxY;
    }
    window.DC.CursorPos.x = cast(f32, cast(i32, window.Pos.x + window.DC.Indent.x + window.DC.ColumnsOffset.x));
    window.DC.CursorPos.y = columns.LineMinY;
    window.DC.CurrLineSize = ImVec2{0.0f, 0.0f};
    window.DC.CurrLineTextBaseOffset = 0.0f;
    f32 offset_0 = ImGui_GetColumnOffset(columns.Current);
    f32 offset_1 = ImGui_GetColumnOffset(columns.Current + 1);
    f32 width = offset_1 - offset_0;
    ImGui_PushItemWidth(width * 0.65f);
    window.WorkRect.Max.x = window.Pos.x + offset_1 - column_padding;
}

void ImGui_EndColumns() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = ImGui_GetCurrentWindow();
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    assert(columns != null);
    ImGui_PopItemWidth();
    if columns.Count > 1 {
        ImGui_PopClipRect();
        ImDrawListSplitter_Merge(&columns.Splitter, window.DrawList);
    }
    ImGuiOldColumnFlags flags = columns.Flags;
    columns.LineMaxY = ImMax(columns.LineMaxY, window.DC.CursorPos.y);
    window.DC.CursorPos.y = columns.LineMaxY;
    if (flags & ImGuiOldColumnFlags_GrowParentContentsSize) == 0 {
        window.DC.CursorMaxPos.x = columns.HostCursorMaxPosX;
    }
    bool is_being_resized = false;
    if !(flags & ImGuiOldColumnFlags_NoBorder) && !window.SkipItems {
        f32 y1 = ImMax(columns.HostCursorPosY, window.ClipRect.Min.y);
        f32 y2 = ImMin(window.DC.CursorPos.y, window.ClipRect.Max.y);
        i32 dragging_column = -1;
        for i32 n = 1; n < columns.Count; n++ {
            ImGuiOldColumnData* column = &columns.Columns.Data[n];
            f32 x = window.Pos.x + ImGui_GetColumnOffset(n);
            ImGuiID column_id = columns.ID + cast(ImGuiID, n);
            f32 column_hit_hw = ImTrunc(COLUMNS_HIT_RECT_HALF_THICKNESS * g.CurrentDpiScale);
            ImRect column_hit_rect;
            ImRect_init(&column_hit_rect, ImVec2{x - column_hit_hw, y1}, ImVec2{x + column_hit_hw, y2});
            if ImGui_ItemAdd(column_hit_rect, column_id, null, ImGuiItemFlags_NoNav) == 0 {
                continue;
            }
            bool hovered = false;
            bool held = false;
            if (flags & ImGuiOldColumnFlags_NoResize) == 0 {
                ImGui_ButtonBehavior(column_hit_rect, column_id, &hovered, &held, 0);
                if hovered || held {
                    ImGui_SetMouseCursor(ImGuiMouseCursor_ResizeEW);
                }
                if held && !(column.Flags & ImGuiOldColumnFlags_NoResize) {
                    dragging_column = n;
                }
            }
            ImU32 col = ImGui_GetColorU32(held != 0 ? ImGuiCol_SeparatorActive : hovered != 0 ? ImGuiCol_SeparatorHovered : ImGuiCol_Separator);
            var xi = cast(f32, cast(i32, x));
            ImDrawList_AddLineV(window.DrawList, xi, y1 + 1.0f, y2, col, 1.0f);
        }
        if dragging_column != -1 {
            if columns.IsBeingResized == 0 {
                for i32 n = 0; n < columns.Count + 1; n++ {
                    columns.Columns.Data[n].OffsetNormBeforeResize = columns.Columns.Data[n].OffsetNorm;
                }
            }
            is_being_resized = true;
            columns.IsBeingResized = is_being_resized;
            f32 x = GetDraggedColumnOffset(columns, dragging_column);
            ImGui_SetColumnOffset(dragging_column, x);
        }
    }
    columns.IsBeingResized = is_being_resized;
    window.WorkRect = window.ParentWorkRect;
    window.ParentWorkRect = columns.HostBackupParentWorkRect;
    window.DC.CurrentColumns = null;
    window.DC.ColumnsOffset.x = 0.0f;
    window.DC.CursorPos.x = cast(f32, cast(i32, window.Pos.x + window.DC.Indent.x + window.DC.ColumnsOffset.x));
    ImGui_NavUpdateCurrentWindowIsScrollPushableX();
}

void ImGui_Columns(i32 columns_count, u8* id, bool borders) {
    ImGuiWindow* window = ImGui_GetCurrentWindow();
    assert(columns_count >= 1);
    ImGuiOldColumnFlags flags = borders != 0 ? 0 : ImGuiOldColumnFlags_NoBorder;
    ImGuiOldColumns* columns = window.DC.CurrentColumns;
    if columns != null && columns.Count == columns_count && columns.Flags == flags {
        return;
    }
    if columns != null {
        ImGui_EndColumns();
    }
    if columns_count != 1 {
        ImGui_BeginColumns(id, columns_count, flags);
    }
}

bool ImGui_BeginTable(u8* str_id, i32 columns_count) {
    return ImGui_BeginTable(str_id, columns_count, 0, ImVec2{0.0f, 0.0f}, 0.0f);
}

