    ImColor zz_mk;
    ImColor_init(&zz_mk, r, g, b, a);
    return zz_mk;
}

void ImColor_init(ImColor* self, ImU32 rgba) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.Value = ImVec4{
        cast(f32, rgba >> 0 & 0xFF) * (1.0f / 255.0f),
        cast(f32, rgba >> 8 & 0xFF) * (1.0f / 255.0f),
        cast(f32, rgba >> 16 & 0xFF) * (1.0f / 255.0f),
        cast(f32, rgba >> 24 & 0xFF) * (1.0f / 255.0f),
    };
}

