void ImGui_PushFocusScope(ImGuiID id) {
    ImGuiContext* g = GImGui;
    ImGuiFocusScopeData data;
    data.ID = id;
    data.WindowID = g.CurrentWindow.ID;
    ImVector_ImGuiFocusScopeData_push_back(&g.FocusScopeStack, data);
    g.CurrentFocusScopeId = id;
}

void ImGui_PopFocusScope() {
    ImGuiContext* g = GImGui;
    while true {
        if g.FocusScopeStack.Size > g.StackSizesInBeginForCurrentWindow.SizeOfFocusScopeStack == 0 {
            if ImGui_ErrorLog("Calling PopFocusScope() too many times!") != 0 {
                assert(g.FocusScopeStack.Size > g.StackSizesInBeginForCurrentWindow.SizeOfFocusScopeStack && "Calling PopFocusScope() too many times!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    ImVector_ImGuiFocusScopeData_pop_back(&g.FocusScopeStack);
    g.CurrentFocusScopeId = g.FocusScopeStack.Size != 0 ? ImVector_ImGuiFocusScopeData_back(&g.FocusScopeStack).ID : 0;
}

bool ImGui_IsInNavFocusRoute(ImGuiID focus_scope_id) {
    ImGuiContext* g = GImGui;
    if g.NavFocusScopeId == focus_scope_id {
        return true;
    }
    {
        ImGuiFocusScopeData* zz_rf_it_25 = ImVector_ImGuiFocusScopeData_begin(&g.NavFocusRoute);
        ImGuiFocusScopeData* zz_rf_end_25 = ImVector_ImGuiFocusScopeData_end(&g.NavFocusRoute);
        for ; zz_rf_it_25 != zz_rf_end_25; zz_rf_it_25++ {
            ImGuiFocusScopeData focus_scope = *zz_rf_it_25;
            if focus_scope.ID == focus_scope_id {
                return true;
            }
        }
    }
    return false;
}

void ImGui_SetNavFocusScope(ImGuiID focus_scope_id) {
    ImGuiContext* g = GImGui;
    g.NavFocusScopeId = focus_scope_id;
    ImVector_ImGuiFocusScopeData_resize(&g.NavFocusRoute, 0);
    if focus_scope_id == 0 {
        return;
    }
    assert(g.NavWindow != null);
    if focus_scope_id == g.CurrentFocusScopeId {
        for i32 n = g.FocusScopeStack.Size - 1; n >= 0 && g.FocusScopeStack.Data[n].WindowID == g.CurrentWindow.ID; n-- {
            ImVector_ImGuiFocusScopeData_push_back(&g.NavFocusRoute, g.FocusScopeStack.Data[n]);
        }
    } else if focus_scope_id == g.NavWindow.NavRootFocusScopeId {
        ImVector_ImGuiFocusScopeData_push_back(&g.NavFocusRoute, ImGuiFocusScopeData{focus_scope_id, g.NavWindow.ID});
    } else {
        return;
    }
    for ImGuiWindow* window = g.NavWindow.ParentWindowForFocusRoute; window != null; window = window.ParentWindowForFocusRoute {
        ImVector_ImGuiFocusScopeData_push_back(&g.NavFocusRoute, ImGuiFocusScopeData{window.NavRootFocusScopeId, window.ID});
    }
    assert(g.NavFocusRoute.Size < 100);
}

// Focus = move navigation cursor, set scrolling, set focus window.
void ImGui_FocusItem() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventFocus) != 0 {
        }
        if !(0 != 0) { break; }
    }
    if g.DragDropActive || g.MovingWindow != null {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventFocus) != 0 {
            }
            if !(0 != 0) { break; }
        }
        return;
    }
    ImGuiNavMoveFlags move_flags = ImGuiNavMoveFlags_IsTabbing | ImGuiNavMoveFlags_FocusApi | ImGuiNavMoveFlags_NoSetNavCursorVisible | ImGuiNavMoveFlags_NoSelect;
    ImGuiScrollFlags scroll_flags = window.Appearing != 0 ? ImGuiScrollFlags_KeepVisibleEdgeX | ImGuiScrollFlags_AlwaysCenterY : ImGuiScrollFlags_KeepVisibleEdgeX | ImGuiScrollFlags_KeepVisibleEdgeY;
    ImGui_SetNavWindow(window);
    ImGui_NavMoveRequestSubmit(ImGuiDir_None, ImGuiDir_Up, move_flags, scroll_flags);
    ImGui_NavMoveRequestResolveWithLastItem(&g.NavMoveResultLocal);
}

