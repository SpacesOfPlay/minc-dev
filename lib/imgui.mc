u8* ImGui_GetDefaultCompressedFontDataProggyForever(i32* out_size) {
    *out_size = cast(i32, proggy_forever_minimal_ttf_compressed_size);
    return proggy_forever_minimal_ttf_compressed_data;
}

void ImGui_StyleColorsDark() {
    ImGui_StyleColorsDark(null);
}

void ImGui_StyleColorsClassic() {
    ImGui_StyleColorsClassic(null);
}

void ImGui_StyleColorsLight() {
    ImGui_StyleColorsLight(null);
}

void ImFontAtlasTextureGrow(ImFontAtlas* atlas) {
    ImFontAtlasTextureGrow(atlas, -1, -1);
}

void ImFontAtlasTextureGrow(ImFontAtlas* atlas, i32 old_tex_w) {
    ImFontAtlasTextureGrow(atlas, old_tex_w, -1);
}

ImFontAtlasRectId ImFontAtlasPackAddRect(ImFontAtlas* atlas, i32 w, i32 h) {
    return ImFontAtlasPackAddRect(atlas, w, h, null);
}

u8* ImTextCalcWordWrapNextLineStart(u8* text, u8* text_end) {
    return ImTextCalcWordWrapNextLineStart(text, text_end, 0);
}

u8* ImFontCalcWordWrapPositionEx(ImFont* font, f32 size, u8* text, u8* text_end, f32 wrap_width) {
    return ImFontCalcWordWrapPositionEx(font, size, text, text_end, wrap_width, 0);
}

void ImGui_RenderArrow(ImDrawList* draw_list, ImVec2 pos, ImU32 col, ImGuiDir dir) {
    ImGui_RenderArrow(draw_list, pos, col, dir, 1.0f);
}

void ImGui_RenderColorRectWithAlphaCheckerboard(ImDrawList* draw_list, ImVec2 p_min, ImVec2 p_max, ImU32 col, f32 grid_step, ImVec2 grid_off) {
    ImGui_RenderColorRectWithAlphaCheckerboard(draw_list, p_min, p_max, col, grid_step, grid_off, 0.0f, 0);
}

void ImGui_RenderColorRectWithAlphaCheckerboard(ImDrawList* draw_list, ImVec2 p_min, ImVec2 p_max, ImU32 col, f32 grid_step, ImVec2 grid_off, f32 rounding) {
    ImGui_RenderColorRectWithAlphaCheckerboard(draw_list, p_min, p_max, col, grid_step, grid_off, rounding, 0);
}
