// Avoid naming collision with imgui_demo.cpp's HelpMarker() for unity builds.
void MetricsHelpMarker(u8* desc) {
    ImGui_TextDisabled("(?)");
    if ImGui_BeginItemTooltip() != 0 {
        ImGui_PushTextWrapPos(ImGui_GetFontSize() * 35.0f);
        ImGui_TextUnformatted(desc, null);
        ImGui_PopTextWrapPos();
        ImGui_EndTooltip();
    }
}
}

void ImGui_DebugRenderViewportThumbnail(ImDrawList* draw_list, ImGuiViewportP* viewport, ImRect bb) {
}

private {
void RenderViewportsThumbnails() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    f32 SCALE = 1.0f / 8.0f;
    ImRect bb_full;
    ImRect_init(&bb_full, FLT_MAX, FLT_MAX, -FLT_MAX, -FLT_MAX);
    {
        ImGuiPlatformMonitor* zz_rf_it_70 = ImVector_ImGuiPlatformMonitor_begin(&g.PlatformIO.Monitors);
        ImGuiPlatformMonitor* zz_rf_end_70 = ImVector_ImGuiPlatformMonitor_end(&g.PlatformIO.Monitors);
        for ; zz_rf_it_70 != zz_rf_end_70; zz_rf_it_70++ {
            ImGuiPlatformMonitor* monitor = zz_rf_it_70;
            ImRect_Add(&bb_full, ImRect{
                monitor.MainPos, op_add_ImVec2_ImVec2(monitor.MainPos, monitor.MainSize),
            });
        }
    }
    ImVec2 p = window.DC.CursorPos;
    ImVec2 off = op_sub_ImVec2_ImVec2(p, op_mul_ImVec2_float(bb_full.Min, SCALE));
    {
        ImGuiPlatformMonitor* zz_rf_it_71 = ImVector_ImGuiPlatformMonitor_begin(&g.PlatformIO.Monitors);
        ImGuiPlatformMonitor* zz_rf_end_71 = ImVector_ImGuiPlatformMonitor_end(&g.PlatformIO.Monitors);
        for ; zz_rf_it_71 != zz_rf_end_71; zz_rf_it_71++ {
            ImGuiPlatformMonitor* monitor = zz_rf_it_71;
            ImRect monitor_draw_bb;
            ImRect_init(&monitor_draw_bb, op_add_ImVec2_ImVec2(off, op_mul_ImVec2_float(monitor.MainPos, SCALE)), op_add_ImVec2_ImVec2(off, op_mul_ImVec2_float(op_add_ImVec2_ImVec2(monitor.MainPos, monitor.MainSize), SCALE)));
            ImDrawList_AddRect(window.DrawList, monitor_draw_bb.Min, monitor_draw_bb.Max, g.DebugMetricsConfig.HighlightMonitorIdx == ImVector_ImGuiPlatformMonitor_index_from_ptr(&g.PlatformIO.Monitors, monitor) ? cast(ImU32, 255) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 255) << 8 | cast(ImU32, 255) << 0 : ImGui_GetColorU32(ImGuiCol_Border), 4.0f, 1.0f, 0);
            ImDrawList_AddRectFilled(window.DrawList, monitor_draw_bb.Min, monitor_draw_bb.Max, ImGui_GetColorU32(ImGuiCol_Border, 0.1f), 4.0f, 0);
        }
    }
    {
        ImGuiViewportP** zz_rf_it_72 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_72 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_72 != zz_rf_end_72; zz_rf_it_72++ {
            ImGuiViewportP* viewport = *zz_rf_it_72;
            ImRect viewport_draw_bb;
            ImRect_init(&viewport_draw_bb, op_add_ImVec2_ImVec2(off, op_mul_ImVec2_float(viewport.Pos, SCALE)), op_add_ImVec2_ImVec2(off, op_mul_ImVec2_float(op_add_ImVec2_ImVec2(viewport.Pos, viewport.Size), SCALE)));
            ImGui_DebugRenderViewportThumbnail(window.DrawList, viewport, viewport_draw_bb);
        }
    }
    ImGui_Dummy(op_mul_ImVec2_float(ImRect_GetSize(&bb_full), SCALE));
}

i32 ViewportComparerByLastFocusedStampCount(void* lhs, void* rhs) {
    ImGuiViewportP* a = *cast(ImGuiViewportP**, lhs);
    ImGuiViewportP* b = *cast(ImGuiViewportP**, rhs);
    return b.LastFocusedStampCount - a.LastFocusedStampCount;
}
