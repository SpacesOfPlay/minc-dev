    return &GImGui.DrawListSharedData;
}

void ImGui_StartMouseMovingWindow(ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    ImGui_FocusWindow(window);
    ImGui_SetActiveID(window.MoveId, window);
    if g.IO.ConfigNavCursorVisibleAuto != 0 {
        g.NavCursorVisible = false;
    }
    g.ActiveIdClickOffset = op_sub_ImVec2_ImVec2(g.IO.MouseClickedPos[0], window.RootWindowDockTree.Pos);
    g.ActiveIdNoClearOnFocusLoss = true;
    ImGui_SetActiveIdUsingAllKeyboardKeys();
    bool can_move_window = true;
    if window.Flags & ImGuiWindowFlags_NoMove || window.RootWindowDockTree.Flags & ImGuiWindowFlags_NoMove {
        can_move_window = false;
    }
    {
        ImGuiDockNode* node = window.DockNodeAsHost;
        if node != null {
            if node.VisibleWindow && node.VisibleWindow.Flags & ImGuiWindowFlags_NoMove {
                can_move_window = false;
            }
        }
    }
    if can_move_window != 0 {
        g.MovingWindow = window;
    }
}

// We use 'undock == false' when dragging from title bar to allow moving groups of floating nodes without undocking them.
void ImGui_StartMouseMovingWindowOrNode(ImGuiWindow* window, ImGuiDockNode* node, bool undock) {
    ImGuiContext* g = GImGui;
    bool can_undock_node = false;
    if undock && node != null && node.VisibleWindow && (node.VisibleWindow.Flags & ImGuiWindowFlags_NoMove) == 0 && (node.MergedFlags & ImGuiDockNodeFlags_NoUndocking) == 0 {
        ImGuiDockNode* root_node = ImGui_DockNodeGetRootNode(node);
        if root_node.OnlyNodeWithWindows != node || root_node.CentralNode != null {
            can_undock_node = true;
        }
    }
    bool clicked = ImGui_IsMouseClicked(0);
    bool dragging = ImGui_IsMouseDragging(0);
    if can_undock_node && dragging {
        ImGui_DockContextQueueUndockNode(g, node);
    } else if !can_undock_node && (clicked || dragging) && g.MovingWindow != window {
        ImGui_StartMouseMovingWindow(window);
    }
}

// This is not 100% symmetric with StartMouseMovingWindow().
// We do NOT clear ActiveID, because:
// - It would lead to rather confusing recursive code paths. Caller can call ClearActiveID() if desired.
// - Some code intentionally cancel moving but keep the ActiveID to lock inputs (e.g. code path taken when clicking a disabled item).
void ImGui_StopMouseMovingWindow() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.MovingWindow;
    if window && window.Viewport {
        if (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable) != 0 {
            ImGui_UpdateTryMergeWindowIntoHostViewport(window.RootWindowDockTree, g.MouseViewport);
        }
        if ImGui_IsDragDropPayloadBeingAccepted() == 0 {
            g.MouseViewport = window.Viewport;
        }
        bool window_can_use_inputs = (window.Flags & ImGuiWindowFlags_NoMouseInputs && window.Flags & ImGuiWindowFlags_NoNavInputs) == false;
        if window_can_use_inputs != 0 {
            window.Viewport.Flags &= ~ImGuiViewportFlags_NoInputs;
        }
    }
    g.MovingWindow = null;
}

// Handle mouse moving window
// Note: moving window with the navigation keys (Square + d-pad / Ctrl+Tab + Arrows) are processed in NavUpdateWindowing()
// FIXME: We don't have strong guarantee that g.MovingWindow stay synced with g.ActiveId == g.MovingWindow->MoveId.
// This is currently enforced by the fact that BeginDragDropSource() is setting all g.ActiveIdUsingXXXX flags to inhibit navigation inputs,
// but if we should more thoroughly test cases where g.ActiveId or g.MovingWindow gets changed and not the other.
void ImGui_UpdateMouseMovingWindowNewFrame() {
    ImGuiContext* g = GImGui;
    if g.MovingWindow != null {
        ImGui_KeepAliveID(g.ActiveId);
        assert(g.MovingWindow && g.MovingWindow.RootWindowDockTree);
        ImGuiWindow* moving_window = g.MovingWindow.RootWindowDockTree;
        bool window_disappeared = !moving_window.WasActive && !moving_window.Active;
        if g.IO.MouseDown[0] && ImGui_IsMousePosValid(&g.IO.MousePos) && !window_disappeared {
            ImVec2 pos = op_sub_ImVec2_ImVec2(g.IO.MousePos, g.ActiveIdClickOffset);
            if moving_window.Pos.x != pos.x || moving_window.Pos.y != pos.y {
                ImGui_SetWindowPos(moving_window, pos, ImGuiCond_Always);
                if moving_window.Viewport && moving_window.ViewportOwned {
                    moving_window.Viewport.Pos = pos;
                    ImGuiViewportP_UpdateWorkRect(moving_window.Viewport);
                }
            }
            ImGui_FocusWindow(g.MovingWindow);
        } else {
            ImGui_StopMouseMovingWindow();
            ImGui_ClearActiveID();
        }
    } else {
        if g.ActiveIdWindow && g.ActiveIdWindow.MoveId == g.ActiveId {
            ImGui_KeepAliveID(g.ActiveId);
            if g.IO.MouseDown[0] == 0 {
                ImGui_ClearActiveID();
            }
        }
    }
}

// Initiate focusing and moving window when clicking on empty space or title bar.
// Initiate focusing window when clicking on a disabled item.
// Handle left-click and right-click focus.
void ImGui_UpdateMouseMovingWindowEndFrame() {
    ImGuiContext* g = GImGui;
    if g.ActiveId != 0 || g.HoveredId != 0 && !g.HoveredIdIsDisabled {
        return;
    }
    if g.NavWindow && g.NavWindow.Appearing {
        return;
    }
    ImGuiWindow* hovered_window = g.HoveredWindow;
    if ImGui_IsMouseClicked(0, ImGuiInputFlags_None, cast(ImGuiID, -1)) != 0 {
        ImGuiWindow* hovered_root = hovered_window != null ? hovered_window.RootWindow : null;
        bool is_closed_popup = hovered_root && hovered_root.Flags & ImGuiWindowFlags_Popup && !ImGui_IsPopupOpen(hovered_root.PopupId, ImGuiPopupFlags_AnyPopupLevel);
        bool is_queued_focus_request = g.NavMoveSubmitted && g.NavMoveFlags & ImGuiNavMoveFlags_FocusApi;
        if hovered_window != null && !is_closed_popup && !is_queued_focus_request {
            ImGui_StartMouseMovingWindow(hovered_window);
            if (hovered_window.BgClickFlags & ImGuiWindowBgClickFlags_Move) == 0 {
                if !(hovered_root.Flags & ImGuiWindowFlags_NoTitleBar) || hovered_root.DockIsActive {
                    if ImRect_Contains(&ImGuiWindow_TitleBarRect(hovered_root), g.IO.MouseClickedPos[0]) == 0 {
                        g.MovingWindow = null;
                    }
                }
            }
            if g.HoveredIdIsDisabled != 0 {
                g.MovingWindow = null;
                g.ActiveIdDisabledId = g.HoveredId;
            }
        } else if hovered_window == null && g.NavWindow != null {
            ImGui_FocusWindow(null, ImGuiFocusRequestFlags_UnlessBelowModal);
        }
    }
    if g.HoveredId == 0 && ImGui_IsMouseClicked(1, ImGuiInputFlags_None, cast(ImGuiID, -1)) {
        ImGuiWindow* modal = ImGui_GetTopMostPopupModal();
        bool hovered_window_above_modal = hovered_window && (modal == null || ImGui_IsWindowAbove(hovered_window, modal));
        ImGui_ClosePopupsOverWindow(hovered_window_above_modal != 0 ? hovered_window : modal, true);
    }
}

// This is called during NewFrame()->UpdateViewportsNewFrame() only.
// Need to keep in sync with SetWindowPos()
private {
void TranslateWindow(ImGuiWindow* window, ImVec2 delta) {
    window.Pos = op_add_ImVec2_ImVec2(window.Pos, delta);
    ImRect_Translate(&window.ClipRect, delta);
    ImRect_Translate(&window.OuterRectClipped, delta);
    ImRect_Translate(&window.InnerRect, delta);
    window.DC.CursorPos = op_add_ImVec2_ImVec2(window.DC.CursorPos, delta);
    window.DC.CursorStartPos = op_add_ImVec2_ImVec2(window.DC.CursorStartPos, delta);
    window.DC.CursorMaxPos = op_add_ImVec2_ImVec2(window.DC.CursorMaxPos, delta);
    window.DC.IdealMaxPos = op_add_ImVec2_ImVec2(window.DC.IdealMaxPos, delta);
}

void ScaleWindow(ImGuiWindow* window, f32 scale) {
    ImVec2 origin = window.Viewport.Pos;
    window.Pos = ImFloor(op_add_ImVec2_ImVec2(op_mul_ImVec2_float(op_sub_ImVec2_ImVec2(window.Pos, origin), scale), origin));
    window.Size = ImTrunc(op_mul_ImVec2_float(window.Size, scale));
    window.SizeFull = ImTrunc(op_mul_ImVec2_float(window.SizeFull, scale));
    window.ContentSize = ImTrunc(op_mul_ImVec2_float(window.ContentSize, scale));
}

bool IsWindowActiveAndVisible(ImGuiWindow* window) {
    return window.Active && !window.Hidden;
}
}

// The reason this is exposed in imgui_internal.h is: on touch-based system that don't have hovering, we want to dispatch inputs to the right target (imgui vs imgui+app)
void ImGui_UpdateHoveredWindowAndCaptureFlags(ImVec2 mouse_pos) {
    ImGuiContext* g = GImGui;
    ImGuiIO* io = &g.IO;
    g.WindowsBorderHoverPadding = ImMax(ImMax(g.Style.TouchExtraPadding.x, g.Style.TouchExtraPadding.y), g.Style.WindowBorderHoverPadding);
    bool clear_hovered_windows = false;
    ImGui_FindHoveredWindowEx(mouse_pos, false, &g.HoveredWindow, &g.HoveredWindowUnderMovingWindow);
    assert(g.HoveredWindow == null || g.HoveredWindow == g.MovingWindow || g.HoveredWindow.Viewport == g.MouseViewport);
    g.HoveredWindowBeforeClear = g.HoveredWindow;
    ImGuiWindow* modal_window = ImGui_GetTopMostPopupModal();
    if modal_window && g.HoveredWindow && !ImGui_IsWindowWithinBeginStackOf(g.HoveredWindow.RootWindow, modal_window) {
        clear_hovered_windows = true;
    }
    if (io.ConfigFlags & ImGuiConfigFlags_NoMouse) != 0 {
        clear_hovered_windows = true;
    }
    bool has_open_popup = g.OpenPopupStack.Size > 0;
    bool has_open_modal = modal_window != null;
    i32 mouse_earliest_down = -1;
    bool mouse_any_down = false;
    for i32 i = 0; i < cast(i32, sizeof(io.MouseDown) / sizeof(*io.MouseDown)); i++ {
        if io.MouseClicked[i] != 0 {
            io.MouseDownOwned[i] = g.HoveredWindow != null || has_open_popup;
            io.MouseDownOwnedUnlessPopupClose[i] = g.HoveredWindow != null || has_open_modal;
        }
        mouse_any_down |= io.MouseDown[i];
        if io.MouseDown[i] || io.MouseReleased[i] {
            if mouse_earliest_down == -1 || io.MouseClickedTime[i] < io.MouseClickedTime[mouse_earliest_down] {
                mouse_earliest_down = i;
            }
        }
    }
    bool mouse_avail = mouse_earliest_down == -1 || io.MouseDownOwned[mouse_earliest_down];
    bool mouse_avail_unless_popup_close = mouse_earliest_down == -1 || io.MouseDownOwnedUnlessPopupClose[mouse_earliest_down];
    bool mouse_dragging_extern_payload = g.DragDropActive && (g.DragDropSourceFlags & ImGuiDragDropFlags_SourceExtern) != 0;
    if !mouse_avail && !mouse_dragging_extern_payload {
        clear_hovered_windows = true;
    }
    if clear_hovered_windows != 0 {
        g.HoveredWindowUnderMovingWindow = null;
        g.HoveredWindow = g.HoveredWindowUnderMovingWindow;
    }
    if g.WantCaptureMouseNextFrame != -1 {
        io.WantCaptureMouseUnlessPopupClose = g.WantCaptureMouseNextFrame != 0;
        io.WantCaptureMouse = io.WantCaptureMouseUnlessPopupClose;
    } else {
        io.WantCaptureMouse = mouse_avail && (g.HoveredWindow != null || mouse_any_down) || has_open_popup;
        io.WantCaptureMouseUnlessPopupClose = mouse_avail_unless_popup_close && (g.HoveredWindow != null || mouse_any_down) || has_open_modal;
    }
    io.WantCaptureKeyboard = false;
    if (io.ConfigFlags & ImGuiConfigFlags_NoKeyboard) == 0 {
        if g.ActiveId != 0 || modal_window != null {
            io.WantCaptureKeyboard = true;
        } else if io.NavActive && io.ConfigFlags & ImGuiConfigFlags_NavEnableKeyboard && io.ConfigNavCaptureKeyboard {
            io.WantCaptureKeyboard = true;
        }
    }
    if g.WantCaptureKeyboardNextFrame != -1 {
        io.WantCaptureKeyboard = g.WantCaptureKeyboardNextFrame != 0;
    }
    io.WantTextInput = g.WantTextInputNextFrame != -1 ? g.WantTextInputNextFrame != 0 : false;
}

// Called once a frame. Followed by SetCurrentFont() which sets up the remaining data.
// FIXME-VIEWPORT: the concept of a single ClipRectFullscreen is not ideal!
private {
void SetupDrawListSharedData() {
    ImGuiContext* g = GImGui;
    ImRect virtual_space;
    ImRect_init(&virtual_space, FLT_MAX, FLT_MAX, -FLT_MAX, -FLT_MAX);
    {
        ImGuiViewportP** zz_rf_it_11 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_11 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_11 != zz_rf_end_11; zz_rf_it_11++ {
            ImGuiViewportP* viewport = *zz_rf_it_11;
            ImRect_Add(&virtual_space, ImGuiViewportP_GetMainRect(viewport));
        }
    }
    g.DrawListSharedData.ClipRectFullscreen = ImRect_ToVec4(&virtual_space);
    g.DrawListSharedData.CurveTessellationTol = g.Style.CurveTessellationTol;
    ImDrawListSharedData_SetCircleTessellationMaxError(&g.DrawListSharedData, g.Style.CircleTessellationMaxError);
    g.DrawListSharedData.InitialFlags = ImDrawListFlags_None;
    if g.Style.AntiAliasedLines != 0 {
        g.DrawListSharedData.InitialFlags |= ImDrawListFlags_AntiAliasedLines;
    }
    if g.Style.AntiAliasedLinesUseTex && !(g.IO.Fonts.Flags & ImFontAtlasFlags_NoBakedLines) {
        g.DrawListSharedData.InitialFlags |= ImDrawListFlags_AntiAliasedLinesUseTex;
    }
    if g.Style.AntiAliasedFill != 0 {
        g.DrawListSharedData.InitialFlags |= ImDrawListFlags_AntiAliasedFill;
    }
    if (g.IO.BackendFlags & ImGuiBackendFlags_RendererHasVtxOffset) != 0 {
        g.DrawListSharedData.InitialFlags |= ImDrawListFlags_AllowVtxOffset;
    }
    g.DrawListSharedData.InitialFringeScale = 1.0f;
}
}

void ImGui_NewFrame() {
    assert(GImGui != null && "No current context. Did you call ImGui::CreateContext() and ImGui::SetCurrentContext() ?");
    ImGuiContext* g = GImGui;
    for i32 n = g.Hooks.Size - 1; n >= 0; n-- {
        if g.Hooks.Data[n].Type == ImGuiContextHookType_PendingRemoval_ {
            ImVector_ImGuiContextHook_erase(&g.Hooks, &g.Hooks.Data[n]);
        }
    }
    ImGui_CallContextHooks(g, ImGuiContextHookType_NewFramePre);
    g.ConfigFlagsLastFrame = g.ConfigFlagsCurrFrame;
    ImGui_ErrorCheckNewFrameSanityChecks();
    g.ConfigFlagsCurrFrame = g.IO.ConfigFlags;
    ImGui_UpdateSettings();
    g.Time += g.IO.DeltaTime;
    g.FrameCount += 1;
    g.SessionDate = __cxx_make_ImGuiPackedDate(g.PlatformIO.Platform_SessionDate);
    g.TooltipOverrideCount = 0;
    g.WindowsActiveCount = 0;
    ImVector_ImGuiID_resize(&g.MenusIdSubmittedThisFrame, 0);
    g.FramerateSecPerFrameAccum += g.IO.DeltaTime - g.FramerateSecPerFrame[g.FramerateSecPerFrameIdx];
    g.FramerateSecPerFrame[g.FramerateSecPerFrameIdx] = g.IO.DeltaTime;
    g.FramerateSecPerFrameIdx = (g.FramerateSecPerFrameIdx + 1) % cast(i32, sizeof(g.FramerateSecPerFrame) / sizeof(*g.FramerateSecPerFrame));
    g.FramerateSecPerFrameCount = ImMin(g.FramerateSecPerFrameCount + 1, cast(i32, sizeof(g.FramerateSecPerFrame) / sizeof(*g.FramerateSecPerFrame)));
    g.IO.Framerate = g.FramerateSecPerFrameAccum > 0.0f ? 1.0f / (g.FramerateSecPerFrameAccum / cast(f32, g.FramerateSecPerFrameCount)) : FLT_MAX;
    ImVector_ImGuiInputEvent_resize(&g.InputEventsTrail, 0);
    ImGui_UpdateInputEvents(g.IO.ConfigInputTrickleEventQueue);
    ImGui_UpdateViewportsNewFrame();
    ImGui_UpdateTexturesNewFrame();
    SetupDrawListSharedData();
    ImGui_UpdateFontsNewFrame();
    g.WithinFrameScope = true;
    {
        ImGuiViewportP** zz_rf_it_12 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_12 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_12 != zz_rf_end_12; zz_rf_it_12++ {
            ImGuiViewportP* viewport = *zz_rf_it_12;
            viewport.DrawData = null;
            viewport.DrawDataP.Valid = false;
        }
    }
    if g.DragDropActive && g.DragDropPayload.SourceId == g.ActiveId {
        ImGui_KeepAliveID(g.DragDropPayload.SourceId);
    }
    if !g.IO.ConfigDebugHighlightIdConflicts || !g.IO.KeyCtrl {
        g.DebugDrawIdConflictsId = 0;
    }
    if g.IO.ConfigDebugHighlightIdConflicts && g.HoveredIdPreviousFrameItemCount > 1 {
        g.DebugDrawIdConflictsId = g.HoveredIdPreviousFrame;
    }
    if g.HoveredIdPreviousFrame == 0 {
        g.HoveredIdTimer = 0.0f;
    }
    if !g.HoveredIdPreviousFrame || g.HoveredId && g.ActiveId == g.HoveredId {
        g.HoveredIdNotActiveTimer = 0.0f;
    }
    if g.HoveredId != 0 {
        g.HoveredIdTimer += g.IO.DeltaTime;
    }
    if g.HoveredId && g.ActiveId != g.HoveredId {
        g.HoveredIdNotActiveTimer += g.IO.DeltaTime;
    }
    g.HoveredIdPreviousFrame = g.HoveredId;
    g.HoveredIdPreviousFrameItemCount = 0;
    g.HoveredId = 0;
    g.HoveredIdAllowOverlap = false;
    g.HoveredIdIsDisabled = false;
    if g.ActiveId != 0 && g.ActiveIdIsAlive != g.ActiveId && g.ActiveIdPreviousFrame == g.ActiveId {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventActiveId) != 0 {
            }
            if !(0 != 0) { break; }
        }
        ImGui_ClearActiveID();
    }
    if g.ActiveId != 0 {
        g.ActiveIdTimer += g.IO.DeltaTime;
    }
    if g.ActiveId && g.ActiveId == g.LastActiveId {
        g.LastActiveIdWasSelected = g.ActiveIdWasSelected;
        g.LastActiveIdWasSoleSelected = g.ActiveIdWasSoleSelected;
    }
    g.LastActiveIdTimer += g.IO.DeltaTime;
    g.ActiveIdPreviousFrame = g.ActiveId;
    g.ActiveIdIsAlive = 0;
    g.AnyIdHasBeenEditedThisFrame = false;
    g.ActiveIdHasBeenEditedThisFrame = false;
    g.ActiveIdIsJustActivated = false;
    if g.TempInputId != 0 && g.ActiveId != g.TempInputId {
        g.TempInputId = 0;
    }
    if g.InputTextReactivateId != 0 && g.InputTextReactivateId != g.DeactivatedItemData.ID {
        g.InputTextReactivateId = 0;
    }
    if g.ActiveId == 0 {
        g.ActiveIdUsingNavDirMask = 0x00;
        g.ActiveIdUsingAllKeyboardKeys = false;
    }
    if g.DeactivatedItemData.ElapseFrame < g.FrameCount {
        g.DeactivatedItemData.ID = 0;
    }
    g.DeactivatedItemData.IsAlive = false;
    if g.InputTextDeactivatedState.ElapseFrame < g.FrameCount {
        g.InputTextDeactivatedState.ID = 0;
    }
    if g.HoverItemDelayId != 0 && g.MouseStationaryTimer >= g.Style.HoverStationaryDelay {
        g.HoverItemUnlockedStationaryId = g.HoverItemDelayId;
    } else if g.HoverItemDelayId == 0 {
        g.HoverItemUnlockedStationaryId = 0;
    }
    if g.HoveredWindow != null && g.MouseStationaryTimer >= g.Style.HoverStationaryDelay {
        g.HoverWindowUnlockedStationaryId = g.HoveredWindow.ID;
    } else if g.HoveredWindow == null {
        g.HoverWindowUnlockedStationaryId = 0;
    }
    g.HoverItemDelayIdPreviousFrame = g.HoverItemDelayId;
    if g.HoverItemDelayId != 0 {
        g.HoverItemDelayTimer += g.IO.DeltaTime;
        g.HoverItemDelayClearTimer = 0.0f;
        g.HoverItemDelayId = 0;
    } else if g.HoverItemDelayTimer > 0.0f {
        g.HoverItemDelayClearTimer += g.IO.DeltaTime;
        if g.HoverItemDelayClearTimer >= ImMax(0.25f, g.IO.DeltaTime * 2.0f) {
            g.HoverItemDelayClearTimer = 0.0f;
            g.HoverItemDelayTimer = g.HoverItemDelayClearTimer;
        }
    }
    ImGui_UpdateKeyboardInputs();
    g.DragDropAcceptIdPrev = g.DragDropAcceptIdCurr;
    g.DragDropAcceptIdCurr = 0;
    g.DragDropAcceptFlagsPrev = g.DragDropAcceptFlagsCurr;
    g.DragDropAcceptFlagsCurr = ImGuiDragDropFlags_None;
    g.DragDropAcceptIdCurrRectSurface = FLT_MAX;
    g.DragDropWithinSource = false;
    g.DragDropWithinTarget = false;
    g.DragDropHoldJustPressedId = 0;
    if g.DragDropActive != 0 {
        ImGuiID owner_id = g.ActiveId != 0 ? g.ActiveId : ImHashStr("##DragDropCancelHandler");
        if ImGui_Shortcut(ImGuiKey_Escape, ImGuiInputFlags_RouteGlobal, owner_id) != 0 {
            ImGui_ClearActiveID();
            ImGui_ClearDragDrop();
        }
    }
    g.TooltipPreviousWindow = null;
    ImGui_NavUpdate();
    ImGui_UpdateMouseInputs();
    ImGui_DockContextNewFrameUpdateUndocking(g);
    assert(g.WindowsFocusOrder.Size <= g.Windows.Size);
    bool gc_all = g.GcCompactAll || g.IO.ConfigMemoryCompactTimer < 0.0f;
    f32 memory_compact_start_time = gc_all != 0 ? FLT_MAX : cast(f32, g.Time) - g.IO.ConfigMemoryCompactTimer;
    {
        ImGuiWindow** zz_rf_it_13 = ImVector_ImGuiWindow_ptr_begin(&g.Windows);
        ImGuiWindow** zz_rf_end_13 = ImVector_ImGuiWindow_ptr_end(&g.Windows);
        for ; zz_rf_it_13 != zz_rf_end_13; zz_rf_it_13++ {
            ImGuiWindow* window = *zz_rf_it_13;
            window.WasActive = window.Active;
            window.Active = false;
            window.WriteAccessed = false;
            window.BeginCountPreviousFrame = window.BeginCount;
            window.BeginCount = 0;
            if (!window.WasActive || gc_all) && !window.MemoryCompacted && window.LastTimeActive < memory_compact_start_time {
                ImGui_GcCompactTransientWindowBuffers(window);
            }
        }
    }
    ImGui_UpdateHoveredWindowAndCaptureFlags(g.IO.MousePos);
    ImGui_UpdateMouseMovingWindowNewFrame();
    if ImGui_GetTopMostPopupModal() != null || g.NavWindowingTarget != null && g.NavWindowingHighlightAlpha > 0.0f {
        g.DimBgRatio = ImMin(g.DimBgRatio + g.IO.DeltaTime * 6.0f, 1.0f);
    } else {
        g.DimBgRatio = ImMax(g.DimBgRatio - g.IO.DeltaTime * 10.0f, 0.0f);
    }
    g.MouseCursor = ImGuiMouseCursor_Arrow;
    g.WantTextInputNextFrame = -1;
    g.WantCaptureKeyboardNextFrame = g.WantTextInputNextFrame;
    g.WantCaptureMouseNextFrame = g.WantCaptureKeyboardNextFrame;
    g.PlatformImeDataPrev = g.PlatformImeData;
    g.PlatformImeData.WantTextInput = false;
    g.PlatformImeData.WantVisible = g.PlatformImeData.WantTextInput;
    ImGui_UpdateMouseWheel();
    for i32 i = 0; i < g.TablesLastTimeActive.Size; i++ {
        if g.TablesLastTimeActive.Data[i] >= 0.0f && g.TablesLastTimeActive.Data[i] < memory_compact_start_time {
            ImGui_TableGcCompactTransientBuffers(ImPool_ImGuiTable_GetByIndex(&g.Tables, i));
        }
    }
    {
        ImGuiTableTempData* zz_rf_it_14 = ImVector_ImGuiTableTempData_begin(&g.TablesTempData);
        ImGuiTableTempData* zz_rf_end_14 = ImVector_ImGuiTableTempData_end(&g.TablesTempData);
        for ; zz_rf_it_14 != zz_rf_end_14; zz_rf_it_14++ {
            ImGuiTableTempData* table_temp_data = zz_rf_it_14;
            ImVector_ImGuiTableReconcileColumnData_clear(&table_temp_data.ReconcileColumnsRequests);
            if table_temp_data.LastTimeActive >= 0.0f && table_temp_data.LastTimeActive < memory_compact_start_time {
                ImGui_TableGcCompactTransientBuffers(table_temp_data);
            }
        }
    }
    if g.GcCompactAll != 0 {
        ImGui_GcCompactTransientMiscBuffers();
    }
    g.GcCompactAll = false;
    if g.NavWindow && !g.NavWindow.WasActive {
        ImGui_FocusTopMostWindowUnderOne(null, null, null, ImGuiFocusRequestFlags_RestoreFocusedChild);
    }
    ImVector_ImGuiWindowStackData_resize(&g.CurrentWindowStack, 0);
    ImVector_ImGuiPopupData_resize(&g.BeginPopupStack, 0);
    ImVector_ImGuiItemFlags_resize(&g.ItemFlagsStack, 0);
    ImVector_ImGuiItemFlags_push_back(&g.ItemFlagsStack, ImGuiItemFlags_Default_);
    g.CurrentItemFlags = *ImVector_ImGuiItemFlags_back(&g.ItemFlagsStack);
    ImVector_ImGuiGroupData_resize(&g.GroupStack, 0);
    ImGui_DockContextNewFrameUpdateDocking(g);
    ImGui_UpdateDebugToolItemPicker();
    ImGui_UpdateDebugToolItemPathQuery();
    ImGui_UpdateDebugToolFlashStyleColor();
    if g.DebugLocateFrames > 0 && --g.DebugLocateFrames == 0 {
        g.DebugLocateId = 0;
        g.DebugBreakInLocateId = false;
    }
    if g.DebugLogAutoDisableFrames > 0 && --g.DebugLogAutoDisableFrames == 0 {
        ImGui_DebugLog("(Debug Log: Auto-disabled some ImGuiDebugLogFlags after 2 frames)\n");
        g.DebugLogFlags &= ~g.DebugLogAutoDisableFlags;
        g.DebugLogAutoDisableFlags = ImGuiDebugLogFlags_None;
    }
    g.WithinFrameScopeWithImplicitWindow = true;
    ImGui_SetNextWindowSize(ImVec2{400.0f, 400.0f}, ImGuiCond_FirstUseEver);
    ImGui_Begin("Debug##Default");
    assert(g.CurrentWindow.IsFallbackWindow == true);
    g.ErrorCountCurrentFrame = 0;
    ImGui_ErrorRecoveryStoreState(&g.StackSizesInNewFrame);
    if g.IO.ConfigDebugBeginReturnValueLoop != 0 {
        g.DebugBeginReturnValueCullDepth = cast(ImS8, g.DebugBeginReturnValueCullDepth == -1 ? 0 : (g.DebugBeginReturnValueCullDepth + (g.FrameCount % 4 == 0 ? 1 : 0)) % 10);
    } else {
        g.DebugBeginReturnValueCullDepth = cast(ImS8, -1);
    }
    ImGui_CallContextHooks(g, ImGuiContextHookType_NewFramePost);
}

// FIXME: Add a more explicit sort order in the window structure.
private {
i32 ChildWindowComparer(void* lhs, void* rhs) {
    ImGuiWindow* a = *cast(ImGuiWindow**, lhs);
    ImGuiWindow* b = *cast(ImGuiWindow**, rhs);
    {
        i32 d = (a.Flags & ImGuiWindowFlags_Popup) - (b.Flags & ImGuiWindowFlags_Popup);
        if d != 0 {
            return d;
        }
    }
    {
        i32 d = (a.Flags & ImGuiWindowFlags_Tooltip) - (b.Flags & ImGuiWindowFlags_Tooltip);
        if d != 0 {
            return d;
        }
    }
    return a.BeginOrderWithinParent - b.BeginOrderWithinParent;
}

void AddWindowToSortBuffer(ImVector_ImGuiWindow_ptr* out_sorted_windows, ImGuiWindow* window) {
    ImVector_ImGuiWindow_ptr_push_back(out_sorted_windows, window);
    if window.Active != 0 {
        i32 count = window.DC.ChildWindows.Size;
        ImQsort(window.DC.ChildWindows.Data, cast(u64, count), cast(u64, sizeof(ImGuiWindow*)), cast(fn(void*, void*): i32, ChildWindowComparer));
        for i32 i = 0; i < count; i++ {
            ImGuiWindow* child = window.DC.ChildWindows.Data[i];
            if child.Active != 0 {
                AddWindowToSortBuffer(out_sorted_windows, child);
            }
        }
    }
}

void AddWindowToDrawData(ImGuiWindow* window, i32 layer) {
    ImGuiContext* g = GImGui;
    ImGuiViewportP* viewport = window.Viewport;
    assert(viewport != null);
    g.IO.MetricsRenderWindows++;
    if window.DrawList._Splitter._Count > 1 {
        ImDrawList_ChannelsMerge(window.DrawList);
    }
    ImGui_AddDrawListToDrawDataEx(&viewport.DrawDataP, viewport.DrawDataBuilder.Layers[layer], window.DrawList);
    {
        ImGuiWindow** zz_rf_it_15 = ImVector_ImGuiWindow_ptr_begin(&window.DC.ChildWindows);
        ImGuiWindow** zz_rf_end_15 = ImVector_ImGuiWindow_ptr_end(&window.DC.ChildWindows);
        for ; zz_rf_it_15 != zz_rf_end_15; zz_rf_it_15++ {
            ImGuiWindow* child = *zz_rf_it_15;
            if IsWindowActiveAndVisible(child) != 0 {
                AddWindowToDrawData(child, layer);
            }
        }
    }
}

i32 GetWindowDisplayLayer(ImGuiWindow* window) {
    return (window.Flags & ImGuiWindowFlags_Tooltip) != 0 ? 1 : 0;
}

// Layer is locked for the root window, however child windows may use a different viewport (e.g. extruding menu)
void AddRootWindowToDrawData(ImGuiWindow* window) {
    AddWindowToDrawData(window, GetWindowDisplayLayer(window));
}

void FlattenDrawDataIntoSingleLayer(ImDrawDataBuilder* builder) {
    i32 n = builder.Layers[0].Size;
    i32 full_size = n;
    for i32 i = 1; i < cast(i32, sizeof(builder.Layers) / sizeof(*builder.Layers)); i++ {
        full_size += builder.Layers[i].Size;
    }
    ImVector_ImDrawList_ptr_resize(builder.Layers[0], full_size);
    for i32 layer_n = 1; layer_n < cast(i32, sizeof(builder.Layers) / sizeof(*builder.Layers)); layer_n++ {
        ImVector_ImDrawList_ptr* layer = builder.Layers[layer_n];
        if ImVector_ImDrawList_ptr_empty(layer) != 0 {
            continue;
        }
        memcpy(builder.Layers[0].Data + n, layer.Data, cast(u64, layer.Size * sizeof(ImDrawList*)));
        n += layer.Size;
        ImVector_ImDrawList_ptr_resize(layer, 0);
    }
}

void InitViewportDrawData(ImGuiViewportP* viewport) {
    ImGuiContext* g = GImGui;
    ImDrawData* draw_data = &viewport.DrawDataP;
    viewport.DrawData = draw_data;
    viewport.DrawDataBuilder.Layers[0] = &draw_data.CmdLists;
    viewport.DrawDataBuilder.Layers[1] = &viewport.DrawDataBuilder.LayerData1;
    ImVector_ImDrawList_ptr_resize(viewport.DrawDataBuilder.Layers[0], 0);
    ImVector_ImDrawList_ptr_resize(viewport.DrawDataBuilder.Layers[1], 0);
    bool is_minimized = (viewport.Flags & ImGuiViewportFlags_IsMinimized) != 0;
    draw_data.Valid = true;
    draw_data.FrameCount = g.FrameCount;
    draw_data.TotalIdxCount = 0;
    draw_data.TotalVtxCount = draw_data.TotalIdxCount;
    draw_data.DisplayPos = viewport.Pos;
    draw_data.DisplaySize = is_minimized != 0 ? ImVec2{0.0f, 0.0f} : viewport.Size;
    draw_data.FramebufferScale = viewport.FramebufferScale.x != 0.0f ? viewport.FramebufferScale : g.IO.DisplayFramebufferScale;
    draw_data.OwnerViewport = cast(ImGuiViewport*, viewport);
    draw_data.Textures = &g.PlatformIO.Textures;
}
}

// Push a clipping rectangle for both ImGui logic (hit-testing etc.) and low-level ImDrawList rendering.
// - When using this function it is sane to ensure that float are perfectly rounded to integer values,
//   so that e.g. (int)(max.x-min.x) in user's render produce correct result.
// - If the code here changes, may need to update code of functions like NextColumn() and PushColumnClipRect():
//   some frequently called functions which to modify both channels and clipping simultaneously tend to use the
//   more specialized SetWindowClipRectBeforeSetChannel() to avoid extraneous updates of underlying ImDrawCmds.
// - This is analogous to PushFont()/PopFont() in the sense that are a mixing a global stack and a window stack,
//   which in the case of ClipRect is not so problematic but tends to be more restrictive for fonts.
void ImGui_PushClipRect(ImVec2 clip_rect_min, ImVec2 clip_rect_max, bool intersect_with_current_clip_rect) {
    ImGuiWindow* window = ImGui_GetCurrentWindow();
    ImDrawList_PushClipRect(window.DrawList, clip_rect_min, clip_rect_max, intersect_with_current_clip_rect);
    ImVec4 zz_cr = *ImVector_ImVec4_back(&window.DrawList._ClipRectStack); window.ClipRect = ImRect{ImVec2{zz_cr.x, zz_cr.y}, ImVec2{zz_cr.z, zz_cr.w}};
}

void ImGui_PopClipRect() {
    ImGuiWindow* window = ImGui_GetCurrentWindow();
    ImDrawList_PopClipRect(window.DrawList);
    ImVec4 zz_cr = *ImVector_ImVec4_back(&window.DrawList._ClipRectStack); window.ClipRect = ImRect{ImVec2{zz_cr.x, zz_cr.y}, ImVec2{zz_cr.z, zz_cr.w}};
}

private {
void ImGui_RenderDimmedBackgroundBehindWindow(ImGuiWindow* window, ImU32 col) {
    if (col & 0xFF000000) == 0 {
        return;
    }
    ImGuiViewportP* viewport = window.Viewport;
    ImRect viewport_rect = ImGuiViewportP_GetMainRect(viewport);
    {
        ImDrawList* draw_list = window.RootWindowDockTree.DrawList;
        ImDrawList_ChannelsMerge(draw_list);
        if draw_list.CmdBuffer.Size == 0 {
            ImDrawList_AddDrawCmd(draw_list);
        }
        ImDrawList_PushClipRect(draw_list, op_sub_ImVec2_ImVec2(viewport_rect.Min, ImVec2{1.0f, 1.0f}), op_add_ImVec2_ImVec2(viewport_rect.Max, ImVec2{1.0f, 1.0f}), false);
        ImDrawCmd cmd = *ImVector_ImDrawCmd_back(&draw_list.CmdBuffer);
        assert(cmd.ElemCount == 0);
        ImDrawList_AddRectFilled(draw_list, viewport_rect.Min, viewport_rect.Max, col, 0.0f, 0);
        cmd = *ImVector_ImDrawCmd_back(&draw_list.CmdBuffer);
        ImVector_ImDrawCmd_pop_back(&draw_list.CmdBuffer);
        ImVector_ImDrawCmd_push_front(&draw_list.CmdBuffer, cmd);
        ImDrawList_AddDrawCmd(draw_list);
        ImDrawList_PopClipRect(draw_list);
    }
    if window.RootWindow.DockIsActive != 0 {
        ImDrawList* draw_list = ImGui_FindFrontMostVisibleChildWindow(window.RootWindowDockTree).DrawList;
        ImDrawList_ChannelsMerge(draw_list);
        if draw_list.CmdBuffer.Size == 0 {
            ImDrawList_AddDrawCmd(draw_list);
        }
        ImDrawList_PushClipRect(draw_list, viewport_rect.Min, viewport_rect.Max, false);
        ImGui_RenderRectFilledWithHole(draw_list, ImGuiWindow_Rect(window.RootWindowDockTree), ImGuiWindow_Rect(window.RootWindow), col, 0.0f);
        ImDrawList_PopClipRect(draw_list);
    }
}
}

ImGuiWindow* ImGui_FindBottomMostVisibleWindowWithinBeginStack(ImGuiWindow* parent_window) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* bottom_most_visible_window = parent_window;
    for i32 i = ImGui_FindWindowDisplayIndex(parent_window); i >= 0; i-- {
        ImGuiWindow* window = g.Windows.Data[i];
        if (window.Flags & ImGuiWindowFlags_ChildWindow) != 0 {
            continue;
        }
        if ImGui_IsWindowWithinBeginStackOf(window, parent_window) == 0 {
            break;
        }
        if IsWindowActiveAndVisible(window) && GetWindowDisplayLayer(window) <= GetWindowDisplayLayer(parent_window) {
            bottom_most_visible_window = window;
        }
    }
    return bottom_most_visible_window;
}

// Important: AddWindowToDrawData() has not been called yet, meaning DockNodeHost windows needs a DrawList->ChannelsMerge() before usage.
// We call ChannelsMerge() lazily here at it is faster that doing a full iteration of g.Windows[] prior to calling RenderDimmedBackgrounds().
private {
void ImGui_RenderDimmedBackgrounds() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* modal_window = ImGui_GetTopMostAndVisiblePopupModal();
    if g.DimBgRatio <= 0.0f && g.NavWindowingHighlightAlpha <= 0.0f {
        return;
    }
    bool dim_bg_for_modal = modal_window != null;
    bool dim_bg_for_window_list = g.NavWindowingTargetAnim != null && g.NavWindowingTargetAnim.Active;
    if !dim_bg_for_modal && !dim_bg_for_window_list {
        return;
    }
    ImGuiViewport*[2] viewports_already_dimmed = {null, null};
    if dim_bg_for_modal != 0 {
        ImGuiWindow* dim_behind_window = ImGui_FindBottomMostVisibleWindowWithinBeginStack(modal_window);
        ImGui_RenderDimmedBackgroundBehindWindow(dim_behind_window, ImGui_GetColorU32(modal_window.DC.ModalDimBgColor, g.DimBgRatio));
        viewports_already_dimmed[0] = cast(ImGuiViewport*, modal_window.Viewport);
    } else if dim_bg_for_window_list != 0 {
        ImGui_RenderDimmedBackgroundBehindWindow(g.NavWindowingTargetAnim, ImGui_GetColorU32(ImGuiCol_NavWindowingDimBg, g.DimBgRatio));
        viewports_already_dimmed[0] = cast(ImGuiViewport*, g.NavWindowingTargetAnim.Viewport);
        if g.NavWindowingListWindow != null && g.NavWindowingListWindow.Active && g.NavWindowingListWindow.Viewport && g.NavWindowingListWindow.Viewport != g.NavWindowingTargetAnim.Viewport {
            ImGui_RenderDimmedBackgroundBehindWindow(g.NavWindowingListWindow, ImGui_GetColorU32(ImGuiCol_NavWindowingDimBg, g.DimBgRatio));
            viewports_already_dimmed[1] = cast(ImGuiViewport*, g.NavWindowingListWindow.Viewport);
        }
        ImGuiWindow* window = g.NavWindowingTargetAnim;
        var viewport = cast(ImGuiViewport*, window.Viewport);
        f32 distance = g.FontSize;
        ImRect bb = ImGuiWindow_Rect(window);
        ImRect_Expand(&bb, distance);
        if ImRect_GetWidth(&bb) >= viewport.Size.x && ImRect_GetHeight(&bb) >= viewport.Size.y {
            ImRect_Expand(&bb, -distance - 1.0f);
        }
        ImDrawList_ChannelsMerge(window.DrawList);
        if window.DrawList.CmdBuffer.Size == 0 {
            ImDrawList_AddDrawCmd(window.DrawList);
        }
        ImDrawList_PushClipRect(window.DrawList, viewport.Pos, op_add_ImVec2_ImVec2(viewport.Pos, viewport.Size), false);
        ImDrawList_AddRect(window.DrawList, bb.Min, bb.Max, ImGui_GetColorU32(ImGuiCol_NavWindowingHighlight, g.NavWindowingHighlightAlpha), window.WindowRounding, 3.0f, 0);
        ImDrawList_PopClipRect(window.DrawList);
    }
    {
        ImGuiViewportP** zz_rf_it_16 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_16 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_16 != zz_rf_end_16; zz_rf_it_16++ {
            ImGuiViewportP* viewport = *zz_rf_it_16;
            if cast(ImGuiViewport*, viewport) == viewports_already_dimmed[0] || cast(ImGuiViewport*, viewport) == viewports_already_dimmed[1] {
                continue;
            }
            if modal_window && viewport.Window && ImGui_IsWindowAbove(viewport.Window, modal_window) {
                continue;
            }
            ImDrawList* draw_list = ImGui_GetForegroundDrawList(cast(ImGuiViewport*, viewport));
            ImU32 dim_bg_col = ImGui_GetColorU32(dim_bg_for_modal != 0 ? ImGuiCol_ModalWindowDimBg : ImGuiCol_NavWindowingDimBg, g.DimBgRatio);
            ImDrawList_AddRectFilled(draw_list, viewport.Pos, op_add_ImVec2_ImVec2(viewport.Pos, viewport.Size), dim_bg_col, 0.0f, 0);
        }
    }
}
}

// This is normally called by Render(). You may want to call it directly if you want to avoid calling Render() but the gain will be very minimal.
void ImGui_EndFrame() {
    ImGuiContext* g = GImGui;
    assert(cast(i64, g.Initialized));
    if g.FrameCountEnded == g.FrameCount {
        return;
    }
    while true {
        if g.WithinFrameScope == 0 {
            if ImGui_ErrorLog("Forgot to call ImGui::NewFrame()?") != 0 {
                assert(g.WithinFrameScope && "Forgot to call ImGui::NewFrame()?");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    ImGui_CallContextHooks(g, ImGuiContextHookType_EndFramePre);
    if g.IO.ConfigErrorRecovery != 0 {
        ImGui_ErrorRecoveryTryToRecoverState(&g.StackSizesInNewFrame);
    }
    ImGui_ErrorCheckEndFrameSanityChecks();
    ImGui_ErrorCheckEndFrameFinalizeErrorTooltip();
    ImGuiPlatformImeData* ime_data = &g.PlatformImeData;
    if g.PlatformIO.Platform_SetImeDataFn != null && memcmp(ime_data, &g.PlatformImeDataPrev, cast(u64, sizeof(ImGuiPlatformImeData))) != 0 {
        ImGuiViewport* viewport = ImGui_FindViewportByID(ime_data.ViewportId);
        if viewport == null {
            viewport = ImGui_GetMainViewport();
        }
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventIO) != 0 {
            }
            if !(0 != 0) { break; }
        }
        g.PlatformIO.Platform_SetImeDataFn(g, viewport, ime_data);
    }
    g.WantTextInputNextFrame = ime_data.WantTextInput != 0 ? 1 : 0;
    g.WithinFrameScopeWithImplicitWindow = false;
    if g.CurrentWindow && g.CurrentWindow.IsFallbackWindow && g.CurrentWindow.WriteAccessed == false {
        g.CurrentWindow.Active = false;
        if g.NavWindow && g.NavWindow.RootWindow == g.CurrentWindow {
            ImGui_FocusWindow(null);
        }
    }
    ImGui_End();
    ImGui_NavEndFrame();
    ImGui_DockContextEndFrame(g);
    ImGui_SetCurrentViewport(null, null);
    if g.DragDropActive != 0 {
        bool is_delivered = g.DragDropPayload.Delivery;
        bool is_elapsed = g.DragDropSourceFrameCount + 1 < g.FrameCount && (g.DragDropSourceFlags & ImGuiDragDropFlags_PayloadAutoExpire || g.DragDropMouseButton == -1 || !ImGui_IsMouseDown(g.DragDropMouseButton));
        if is_delivered || is_elapsed {
            ImGui_ClearDragDrop();
        }
    }
    if g.DragDropActive && g.DragDropSourceFrameCount + 1 < g.FrameCount && !(g.DragDropSourceFlags & ImGuiDragDropFlags_SourceNoPreviewTooltip) {
        g.DragDropWithinSource = true;
        ImGui_SetTooltip("...");
        g.DragDropWithinSource = false;
    }
    g.WithinFrameScope = false;
    g.FrameCountEnded = g.FrameCount;
    ImGui_UpdateFontsEndFrame();
    ImGui_UpdateMouseMovingWindowEndFrame();
    ImGui_UpdateViewportsEndFrame();
    ImVector_ImGuiWindow_ptr_resize(&g.WindowsTempSortBuffer, 0);
    ImVector_ImGuiWindow_ptr_reserve(&g.WindowsTempSortBuffer, g.Windows.Size);
    {
        ImGuiWindow** zz_rf_it_17 = ImVector_ImGuiWindow_ptr_begin(&g.Windows);
        ImGuiWindow** zz_rf_end_17 = ImVector_ImGuiWindow_ptr_end(&g.Windows);
        for ; zz_rf_it_17 != zz_rf_end_17; zz_rf_it_17++ {
            ImGuiWindow* window = *zz_rf_it_17;
            if window.Active && window.Flags & ImGuiWindowFlags_ChildWindow {
                continue;
            }
            AddWindowToSortBuffer(&g.WindowsTempSortBuffer, window);
        }
    }
    assert(g.Windows.Size == g.WindowsTempSortBuffer.Size);
    ImVector_ImGuiWindow_ptr_swap(&g.Windows, &g.WindowsTempSortBuffer);
    g.IO.MetricsActiveWindows = g.WindowsActiveCount;
    ImGui_UpdateTexturesEndFrame();
    {
        ImFontAtlas** zz_rf_it_18 = ImVector_ImFontAtlas_ptr_begin(&g.FontAtlases);
        ImFontAtlas** zz_rf_end_18 = ImVector_ImFontAtlas_ptr_end(&g.FontAtlases);
        for ; zz_rf_it_18 != zz_rf_end_18; zz_rf_it_18++ {
            ImFontAtlas* atlas = *zz_rf_it_18;
            atlas.Locked = false;
        }
    }
    g.IO.MousePosPrev = g.IO.MousePos;
    g.IO.AppFocusLost = false;
    g.IO.MouseWheelH = 0.0f;
    g.IO.MouseWheel = g.IO.MouseWheelH;
    ImVector_ImWchar_resize(&g.IO.InputQueueCharacters, 0);
    ImGui_CallContextHooks(g, ImGuiContextHookType_EndFramePost);
}

// Prepare the data for rendering so you can call GetDrawData()
// (As with anything within the ImGui:: namespace this doesn't touch your GPU or graphics API at all:
// it is the role of the ImGui_ImplXXXX_RenderDrawData() function provided by the renderer backend)
void ImGui_Render() {
    ImGuiContext* g = GImGui;
    assert(cast(i64, g.Initialized));
    if g.FrameCountEnded != g.FrameCount {
        ImGui_EndFrame();
    }
    if g.FrameCountRendered == g.FrameCount {
        return;
    }
    g.FrameCountRendered = g.FrameCount;
    g.IO.MetricsRenderWindows = 0;
    ImGui_CallContextHooks(g, ImGuiContextHookType_RenderPre);
    {
        ImGuiViewportP** zz_rf_it_19 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_19 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_19 != zz_rf_end_19; zz_rf_it_19++ {
            ImGuiViewportP* viewport = *zz_rf_it_19;
            InitViewportDrawData(viewport);
            if viewport.BgFgDrawLists[0] != null && viewport.BgFgDrawListsLastTimeActive[0] == cast(f32, g.Time) {
                ImGui_AddDrawListToDrawDataEx(&viewport.DrawDataP, viewport.DrawDataBuilder.Layers[0], ImGui_GetBackgroundDrawList(cast(ImGuiViewport*, viewport)));
            }
        }
    }
    ImGui_RenderDimmedBackgrounds();
    ImGuiWindow*[2] windows_to_render_top_most;
    windows_to_render_top_most[0] = g.NavWindowingTarget && !(g.NavWindowingTarget.Flags & ImGuiWindowFlags_NoBringToFrontOnFocus) ? g.NavWindowingTarget.RootWindowDockTree : null;
    windows_to_render_top_most[1] = g.NavWindowingTarget != null ? g.NavWindowingListWindow : null;
    {
        ImGuiWindow** zz_rf_it_20 = ImVector_ImGuiWindow_ptr_begin(&g.Windows);
        ImGuiWindow** zz_rf_end_20 = ImVector_ImGuiWindow_ptr_end(&g.Windows);
        for ; zz_rf_it_20 != zz_rf_end_20; zz_rf_it_20++ {
            ImGuiWindow* window = *zz_rf_it_20;
            if IsWindowActiveAndVisible(window) && (window.Flags & ImGuiWindowFlags_ChildWindow) == 0 && window != windows_to_render_top_most[0] && window != windows_to_render_top_most[1] {
                AddRootWindowToDrawData(window);
            }
        }
    }
    for i32 n = 0; n < cast(i32, sizeof(windows_to_render_top_most) / sizeof(*windows_to_render_top_most)); n++ {
        if windows_to_render_top_most[n] && IsWindowActiveAndVisible(windows_to_render_top_most[n]) {
            AddRootWindowToDrawData(windows_to_render_top_most[n]);
        }
    }
    if g.IO.MouseDrawCursor && g.MouseCursor != ImGuiMouseCursor_None {
        ImGui_RenderMouseCursor(g.IO.MousePos, g.Style.MouseCursorScale, g.MouseCursor, cast(ImU32, 255) << 24 | cast(ImU32, 255) << 16 | cast(ImU32, 255) << 8 | cast(ImU32, 255) << 0, cast(ImU32, 255) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 0) << 8 | cast(ImU32, 0) << 0, cast(ImU32, 48) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 0) << 8 | cast(ImU32, 0) << 0);
    }
    g.IO.MetricsRenderIndices = 0;
    g.IO.MetricsRenderVertices = g.IO.MetricsRenderIndices;
    {
        ImGuiViewportP** zz_rf_it_22 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_22 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_22 != zz_rf_end_22; zz_rf_it_22++ {
            ImGuiViewportP* viewport = *zz_rf_it_22;
            FlattenDrawDataIntoSingleLayer(&viewport.DrawDataBuilder);
            if viewport.BgFgDrawLists[1] != null && viewport.BgFgDrawListsLastTimeActive[1] == cast(f32, g.Time) {
                ImGui_AddDrawListToDrawDataEx(&viewport.DrawDataP, viewport.DrawDataBuilder.Layers[0], ImGui_GetForegroundDrawList(cast(ImGuiViewport*, viewport)));
            }
            ImDrawData* draw_data = &viewport.DrawDataP;
            {
                ImDrawList** zz_rf_it_21 = ImVector_ImDrawList_ptr_begin(&draw_data.CmdLists);
                ImDrawList** zz_rf_end_21 = ImVector_ImDrawList_ptr_end(&draw_data.CmdLists);
                for ; zz_rf_it_21 != zz_rf_end_21; zz_rf_it_21++ {
                    ImDrawList* draw_list = *zz_rf_it_21;
                    ImDrawList__PopUnusedDrawCmd(draw_list);
                }
            }
            g.IO.MetricsRenderVertices += draw_data.TotalVtxCount;
            g.IO.MetricsRenderIndices += draw_data.TotalIdxCount;
        }
    }
    if (g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures) != 0 {
        ImFontAtlas** zz_rf_it_23 = ImVector_ImFontAtlas_ptr_begin(&g.FontAtlases);
        ImFontAtlas** zz_rf_end_23 = ImVector_ImFontAtlas_ptr_end(&g.FontAtlases);
        for ; zz_rf_it_23 != zz_rf_end_23; zz_rf_it_23++ {
            ImFontAtlas* atlas = *zz_rf_it_23;
            ImFontAtlasDebugLogTextureRequests(atlas);
        }
    }
    ImGui_CallContextHooks(g, ImGuiContextHookType_RenderPost);
}

// Calculate text size. Text can be multi-line. Optionally ignore text after a ## marker.
// CalcTextSize("") should return ImVec2(0.0f, g.FontSize)
ImVec2 ImGui_CalcTextSize(u8* text, u8* text_end, bool hide_text_after_double_hash, f32 wrap_width) {
    ImGuiContext* g = GImGui;
    u8* text_display_end;
    if hide_text_after_double_hash != 0 {
        text_display_end = ImGui_FindRenderedTextEnd(text, text_end);
    } else {
        text_display_end = text_end;
    }
    ImFont* font = g.Font;
    f32 font_size = g.FontSize;
    if text == text_display_end {
        return ImVec2{0.0f, font_size};
    }
    ImVec2 text_size = ImFont_CalcTextSizeA(font, font_size, FLT_MAX, wrap_width, text, text_display_end, null);
    text_size.x = ImCeilFast(text_size.x);
    return text_size;
}

// Find window given position, search front-to-back
// - Typically write output back to g.HoveredWindow and g.HoveredWindowUnderMovingWindow.
// - FIXME: Note that we have an inconsequential lag here: OuterRectClipped is updated in Begin(), so windows moved programmatically
//   with SetWindowPos() and not SetNextWindowPos() will have that rectangle lagging by a frame at the time FindHoveredWindow() is
//   called, aka before the next Begin(). Moving window isn't affected.
// - The 'find_first_and_in_any_viewport = true' mode is only used by TestEngine. It is simpler to maintain here.
void ImGui_FindHoveredWindowEx(ImVec2 pos, bool find_first_and_in_any_viewport, ImGuiWindow** out_hovered_window, ImGuiWindow** out_hovered_window_under_moving_window) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* hovered_window = null;
    ImGuiWindow* hovered_window_under_moving_window = null;
    ImGuiViewportP* backup_moving_window_viewport = null;
    if find_first_and_in_any_viewport == false && g.MovingWindow {
        backup_moving_window_viewport = g.MovingWindow.Viewport;
        g.MovingWindow.Viewport = g.MouseViewport;
        if (g.MovingWindow.Flags & ImGuiWindowFlags_NoMouseInputs) == 0 {
            hovered_window = g.MovingWindow;
        }
    }
    ImVec2 padding_regular = g.Style.TouchExtraPadding;
    ImVec2 padding_for_resize = ImMax(g.Style.TouchExtraPadding, ImVec2{
        g.Style.WindowBorderHoverPadding, g.Style.WindowBorderHoverPadding,
    });
    for i32 i = g.Windows.Size - 1; i >= 0; i-- {
        ImGuiWindow* window = g.Windows.Data[i];
        if !window.WasActive || window.Hidden {
            continue;
        }
        if (window.Flags & ImGuiWindowFlags_NoMouseInputs) != 0 {
            continue;
        }
        assert(cast(i64, window.Viewport));
        if window.Viewport != g.MouseViewport {
            continue;
        }
        ImVec2 hit_padding = (window.Flags & (ImGuiWindowFlags_NoResize | ImGuiWindowFlags_AlwaysAutoResize)) != 0 ? padding_regular : padding_for_resize;
        if ImRect_ContainsWithPad(&window.OuterRectClipped, pos, hit_padding) == 0 {
            continue;
        }
        if window.HitTestHoleSize.x != 0 {
            ImVec2 hole_pos;
            ImVec2_init(&hole_pos, window.Pos.x + cast(f32, window.HitTestHoleOffset.x), window.Pos.y + cast(f32, window.HitTestHoleOffset.y));
            ImVec2 hole_size;
            ImVec2_init(&hole_size, cast(f32, window.HitTestHoleSize.x), cast(f32, window.HitTestHoleSize.y));
            if ImRect_Contains(&ImRect{hole_pos, op_add_ImVec2_ImVec2(hole_pos, hole_size)}, pos) != 0 {
                continue;
            }
        }
        if find_first_and_in_any_viewport != 0 {
            hovered_window = window;
            break;
        } else {
            if hovered_window == null {
                hovered_window = window;
            }
            if hovered_window_under_moving_window == null && (!g.MovingWindow || window.RootWindowDockTree != g.MovingWindow.RootWindowDockTree) {
                hovered_window_under_moving_window = window;
            }
            if hovered_window && hovered_window_under_moving_window {
                break;
            }
        }
    }
    *out_hovered_window = hovered_window;
    if out_hovered_window_under_moving_window != null {
        *out_hovered_window_under_moving_window = hovered_window_under_moving_window;
    }
    if find_first_and_in_any_viewport == false && g.MovingWindow {
        g.MovingWindow.Viewport = backup_moving_window_viewport;
    }
}

bool ImGui_IsItemActive() {
    ImGuiContext* g = GImGui;
    if g.ActiveId != 0 {
        return g.ActiveId == g.LastItemData.ID;
    }
    return false;
}

bool ImGui_IsItemActivated() {
    ImGuiContext* g = GImGui;
    if g.ActiveId != 0 {
        if g.ActiveId == g.LastItemData.ID && g.ActiveIdPreviousFrame != g.LastItemData.ID {
            return true;
        }
    }
    return false;
}

bool ImGui_IsItemDeactivated() {
    ImGuiContext* g = GImGui;
    if (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HasDeactivated) != 0 {
        return (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_Deactivated) != 0;
    }
    return g.DeactivatedItemData.ID == g.LastItemData.ID && g.LastItemData.ID != 0 && g.DeactivatedItemData.ElapseFrame >= g.FrameCount;
}

// Since 1.92.9: consider using NoLiveEdit flags if all you need to that values are not written bo backing variable while typing.
bool ImGui_IsItemDeactivatedAfterEdit() {
    ImGuiContext* g = GImGui;
    return ImGui_IsItemDeactivated() && g.DeactivatedItemData.HasBeenEditedBefore;
}

// == (GetItemID() == GetFocusID() && GetFocusID() != 0)
bool ImGui_IsItemFocused() {
    ImGuiContext* g = GImGui;
    if g.NavId != g.LastItemData.ID || g.NavId == 0 {
        return false;
    }
    ImGuiWindow* window = g.CurrentWindow;
    if g.LastItemData.ID == window.ID && window.WriteAccessed {
        return false;
    }
    return true;
}

// Important: this can be useful but it is NOT equivalent to the behavior of e.g.Button()!
// Most widgets have specific reactions based on mouse-up/down state, mouse position etc.
bool ImGui_IsItemClicked(ImGuiMouseButton mouse_button) {
    return ImGui_IsMouseClicked(mouse_button) && ImGui_IsItemHovered(ImGuiHoveredFlags_None);
}

bool ImGui_IsItemToggledOpen() {
    ImGuiContext* g = GImGui;
    return (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_ToggledOpen) != 0 ? true : false;
}

// Call after a Selectable() or TreeNode() items inside a BeginMultiSelect()/EndMultiSelect() scope.
// - Useful if you need the per-item information before reaching EndMultiSelect(), e.g. for rendering purpose.
// Outside of a multi-select block:
// - It would be misleading/ambiguous to report this signal, as widgets return e.g. a pressed event,
//   and user code is in charge of altering selection in ways we cannot predict.
//   Prefer using 'if (IsItemClicked() && !IsItemToggledOpen())' for a manual reimplementation of selection.
bool ImGui_IsItemToggledSelection() {
    ImGuiContext* g = GImGui;
    assert(g.CurrentMultiSelect != null);
    return (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_ToggledSelection) != 0 ? true : false;
}

// IMPORTANT: If you are trying to check whether your mouse should be dispatched to Dear ImGui or to your underlying app,
// you should not use this function! Use the 'io.WantCaptureMouse' boolean for that!
// Refer to FAQ entry "How can I tell whether to dispatch mouse/keyboard to Dear ImGui or my application?" for details.
bool ImGui_IsAnyItemHovered() {
    ImGuiContext* g = GImGui;
    return g.HoveredId != 0 || g.HoveredIdPreviousFrame != 0;
}

bool ImGui_IsAnyItemActive() {
    ImGuiContext* g = GImGui;
    return g.ActiveId != 0;
}

bool ImGui_IsAnyItemFocused() {
    ImGuiContext* g = GImGui;
    return g.NavId != 0 && g.NavCursorVisible;
}

bool ImGui_IsItemVisible() {
    ImGuiContext* g = GImGui;
    return (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_Visible) != 0;
}

bool ImGui_IsItemEdited() {
    ImGuiContext* g = GImGui;
    return (g.LastItemData.StatusFlags & ImGuiItemStatusFlags_Edited) != 0;
}

// Allow next item to be overlapped by subsequent items.
// This works by requiring HoveredId to match for two subsequent frames,
// so if a following items overwrite it our interactions will naturally be disabled.
void ImGui_SetNextItemAllowOverlap() {
    ImGuiContext* g = GImGui;
    g.NextItemData.ItemFlagsSet |= ImGuiItemFlags_AllowOverlap;
}

// This is a shortcut for not taking ownership of 100+ keys, frequently used by drag operations.
// FIXME: It might be undesirable that this will likely disable KeyOwner-aware shortcuts systems. Consider a more fine-tuned version if needed?
void ImGui_SetActiveIdUsingAllKeyboardKeys() {
    ImGuiContext* g = GImGui;
    assert(g.ActiveId != 0);
    g.ActiveIdUsingNavDirMask = cast(ImU32, (1 << ImGuiDir_COUNT) - 1);
    g.ActiveIdUsingAllKeyboardKeys = true;
    ImGui_NavMoveRequestCancel();
}

ImGuiID ImGui_GetItemID() {
    ImGuiContext* g = GImGui;
    return g.LastItemData.ID;
}

ImVec2 ImGui_GetItemRectMin() {
    ImGuiContext* g = GImGui;
    return g.LastItemData.Rect.Min;
}

ImVec2 ImGui_GetItemRectMax() {
    ImGuiContext* g = GImGui;
    return g.LastItemData.Rect.Max;
}

ImVec2 ImGui_GetItemRectSize() {
    ImGuiContext* g = GImGui;
    return ImRect_GetSize(&g.LastItemData.Rect);
}

ImGuiItemFlags ImGui_GetItemFlags() {
    ImGuiContext* g = GImGui;
    return g.LastItemData.ItemFlags;
}

// Prior to v1.90 2023/10/16, the BeginChild() function took a 'bool border = false' parameter instead of 'ImGuiChildFlags child_flags = 0'.
// ImGuiChildFlags_Borders is defined as always == 1 in order to allow old code passing 'true'. Read comments in imgui.h for details!
bool ImGui_BeginChild(u8* str_id, ImVec2 size_arg, ImGuiChildFlags child_flags, ImGuiWindowFlags window_flags) {
    ImGuiID id = ImGuiWindow_GetID(ImGui_GetCurrentWindow(), str_id, null);
    return ImGui_BeginChildEx(str_id, id, size_arg, child_flags, window_flags);
}

bool ImGui_BeginChild(ImGuiID id, ImVec2 size_arg, ImGuiChildFlags child_flags, ImGuiWindowFlags window_flags) {
    return ImGui_BeginChildEx(null, id, size_arg, child_flags, window_flags);
}

bool ImGui_BeginChildEx(u8* name, ImGuiID id, ImVec2 size_arg, ImGuiChildFlags child_flags, ImGuiWindowFlags window_flags) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* parent_window = g.CurrentWindow;
    assert(id != 0);
    ImGuiChildFlags ImGuiChildFlags_SupportedMask_ = ImGuiChildFlags_Borders | ImGuiChildFlags_AlwaysUseWindowPadding | ImGuiChildFlags_ResizeX | ImGuiChildFlags_ResizeY | ImGuiChildFlags_AutoResizeX | ImGuiChildFlags_AutoResizeY | ImGuiChildFlags_AlwaysAutoResize | ImGuiChildFlags_FrameStyle | ImGuiChildFlags_NavFlattened;
    ignore ImGuiChildFlags_SupportedMask_;
    assert((child_flags & ~ImGuiChildFlags_SupportedMask_) == 0 && "Illegal ImGuiChildFlags value. Did you pass ImGuiWindowFlags values instead of ImGuiChildFlags?");
    assert((window_flags & ImGuiWindowFlags_AlwaysAutoResize) == 0 && "Cannot specify ImGuiWindowFlags_AlwaysAutoResize for BeginChild(). Use ImGuiChildFlags_AlwaysAutoResize!");
    if (child_flags & ImGuiChildFlags_AlwaysAutoResize) != 0 {
        assert((child_flags & (ImGuiChildFlags_ResizeX | ImGuiChildFlags_ResizeY)) == 0 && "Cannot use ImGuiChildFlags_ResizeX or ImGuiChildFlags_ResizeY with ImGuiChildFlags_AlwaysAutoResize!");
        assert((child_flags & (ImGuiChildFlags_AutoResizeX | ImGuiChildFlags_AutoResizeY)) != 0 && "Must use ImGuiChildFlags_AutoResizeX or ImGuiChildFlags_AutoResizeY with ImGuiChildFlags_AlwaysAutoResize!");
    }
    if (child_flags & ImGuiChildFlags_AutoResizeX) != 0 {
        child_flags &= ~ImGuiChildFlags_ResizeX;
    }
    if (child_flags & ImGuiChildFlags_AutoResizeY) != 0 {
        child_flags &= ~ImGuiChildFlags_ResizeY;
    }
    window_flags |= ImGuiWindowFlags_ChildWindow | ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoDocking;
    window_flags |= parent_window.Flags & ImGuiWindowFlags_NoMove;
    if (child_flags & (ImGuiChildFlags_AutoResizeX | ImGuiChildFlags_AutoResizeY | ImGuiChildFlags_AlwaysAutoResize)) != 0 {
        window_flags |= ImGuiWindowFlags_AlwaysAutoResize;
    }
    if (child_flags & (ImGuiChildFlags_ResizeX | ImGuiChildFlags_ResizeY)) == 0 {
        window_flags |= ImGuiWindowFlags_NoResize | ImGuiWindowFlags_NoSavedSettings;
    }
    if (child_flags & ImGuiChildFlags_FrameStyle) != 0 {
        ImGui_PushStyleColor(ImGuiCol_ChildBg, g.Style.Colors[ImGuiCol_FrameBg]);
        ImGui_PushStyleVar(ImGuiStyleVar_ChildRounding, g.Style.FrameRounding);
        ImGui_PushStyleVar(ImGuiStyleVar_ChildBorderSize, g.Style.FrameBorderSize);
        ImGui_PushStyleVar(ImGuiStyleVar_WindowPadding, g.Style.FramePadding);
        child_flags |= ImGuiChildFlags_Borders | ImGuiChildFlags_AlwaysUseWindowPadding;
        window_flags |= ImGuiWindowFlags_NoMove;
    }
    ImVec2 size_avail = ImGui_GetContentRegionAvail();
    ImVec2 size_default;
    ImVec2_init(&size_default, (child_flags & ImGuiChildFlags_AutoResizeX) != 0 ? 0.0f : size_avail.x, (child_flags & ImGuiChildFlags_AutoResizeY) != 0 ? 0.0f : size_avail.y);
    ImVec2 size = ImGui_CalcItemSize(size_arg, size_default.x, size_default.y);
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasSize) != 0 && (g.NextWindowData.SizeCond & ImGuiCond_Always) != 0 {
        if g.NextWindowData.SizeVal.x > 0.0f {
            size.x = g.NextWindowData.SizeVal.x;
            child_flags &= ~ImGuiChildFlags_ResizeX;
        }
        if g.NextWindowData.SizeVal.y > 0.0f {
            size.y = g.NextWindowData.SizeVal.y;
            child_flags &= ~ImGuiChildFlags_ResizeY;
        }
    }
    ImGui_SetNextWindowSize(size);
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasChildFlags) != 0 {
        g.NextWindowData.ChildFlags |= child_flags;
    } else {
        g.NextWindowData.ChildFlags = child_flags;
    }
    g.NextWindowData.HasFlags |= ImGuiNextWindowDataFlags_HasChildFlags;
    u8* temp_window_name;
    if name != null {
        ImFormatStringToTempBuffer(&temp_window_name, null, "%s/%s_%08X", parent_window.Name, name, id);
    } else {
        ImFormatStringToTempBuffer(&temp_window_name, null, "%s/%08X", parent_window.Name, id);
    }
    f32 backup_border_size = g.Style.ChildBorderSize;
    if (child_flags & ImGuiChildFlags_Borders) == 0 {
        g.Style.ChildBorderSize = 0.0f;
    }
    bool ret = ImGui_Begin(temp_window_name, null, window_flags);
    g.Style.ChildBorderSize = backup_border_size;
    if (child_flags & ImGuiChildFlags_FrameStyle) != 0 {
        ImGui_PopStyleVar(3);
        ImGui_PopStyleColor();
    }
    ImGuiWindow* child_window = g.CurrentWindow;
    child_window.ChildId = id;
    if child_window.BeginCount == 1 {
        parent_window.DC.CursorPos = child_window.Pos;
    }
    ImGuiID temp_id_for_activation = ImHashStr("##Child", 0, id);
    if g.ActiveId == temp_id_for_activation {
        ImGui_ClearActiveID();
    }
    if g.NavActivateId == id && !(child_flags & ImGuiChildFlags_NavFlattened) && (child_window.DC.NavLayersActiveMask != 0 || child_window.DC.NavWindowHasScrollY) {
        ImGui_FocusWindow(child_window);
        ImGui_NavInitWindow(child_window, false);
        ImGui_SetActiveID(temp_id_for_activation, child_window);
        g.ActiveIdSource = g.NavInputSource;
    }
    return ret;
}

void ImGui_EndChild() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* child_window = g.CurrentWindow;
    ImGuiID backup_within_end_child_id = g.WithinEndChildID;
    assert(child_window.Flags & ImGuiWindowFlags_ChildWindow);
    g.WithinEndChildID = child_window.ID;
    ImVec2 child_size = child_window.Size;
    ImGui_End();
    if child_window.BeginCount == 1 {
        ImGuiWindow* parent_window = g.CurrentWindow;
        ImRect bb;
        ImRect_init(&bb, parent_window.DC.CursorPos, op_add_ImVec2_ImVec2(parent_window.DC.CursorPos, child_size));
        ImGui_ItemSize(child_size);
        bool nav_flattened = (child_window.ChildFlags & ImGuiChildFlags_NavFlattened) != 0;
        if (child_window.DC.NavLayersActiveMask != 0 || child_window.DC.NavWindowHasScrollY) && !nav_flattened {
            ImGui_ItemAdd(bb, child_window.ChildId);
            ImGui_RenderNavCursor(bb, child_window.ChildId);
            if child_window.DC.NavLayersActiveMask == 0 && child_window == g.NavWindow {
                ImGui_RenderNavCursor(ImRect{
                    op_sub_ImVec2_ImVec2(bb.Min, ImVec2{2.0f, 2.0f}),
                    op_add_ImVec2_ImVec2(bb.Max, ImVec2{2.0f, 2.0f}),
                }, g.NavId, ImGuiNavRenderCursorFlags_Compact);
            }
        } else {
            ImGui_ItemAdd(bb, child_window.ChildId, null, ImGuiItemFlags_NoNav);
            if nav_flattened != 0 {
                parent_window.DC.NavLayersActiveMaskNext |= child_window.DC.NavLayersActiveMaskNext;
            }
        }
        if g.HoveredWindow == child_window {
            g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_HoveredWindow;
        }
        child_window.DC.ChildItemStatusFlags = g.LastItemData.StatusFlags;
    } else {
        ImGui_SetLastItemDataForChildWindowItem(child_window, ImGuiWindow_Rect(child_window));
    }
    g.WithinEndChildID = backup_within_end_child_id;
    g.LogLinePosY = -FLT_MAX;
}

ImGuiWindow* ImGui_FindFrontMostVisibleChildWindow(ImGuiWindow* window) {
    for i32 n = window.DC.ChildWindows.Size - 1; n >= 0; n-- {
        if IsWindowActiveAndVisible(window.DC.ChildWindows.Data[n]) != 0 {
            return ImGui_FindFrontMostVisibleChildWindow(window.DC.ChildWindows.Data[n]);
        }
    }
    return window;
}

private {
void SetWindowConditionAllowFlags(ImGuiWindow* window, ImGuiCond flags, bool enabled) {
    window.SetWindowPosAllowFlags = enabled != 0 ? window.SetWindowPosAllowFlags | flags : window.SetWindowPosAllowFlags & ~flags;
    window.SetWindowSizeAllowFlags = enabled != 0 ? window.SetWindowSizeAllowFlags | flags : window.SetWindowSizeAllowFlags & ~flags;
    window.SetWindowCollapsedAllowFlags = enabled != 0 ? window.SetWindowCollapsedAllowFlags | flags : window.SetWindowCollapsedAllowFlags & ~flags;
    window.SetWindowDockAllowFlags = enabled != 0 ? window.SetWindowDockAllowFlags | flags : window.SetWindowDockAllowFlags & ~flags;
}
}

ImGuiWindow* ImGui_FindWindowByID(ImGuiID id) {
    ImGuiContext* g = GImGui;
    return cast(ImGuiWindow*, ImGuiStorage_GetVoidPtr(&g.WindowsById, id));
}

ImGuiWindow* ImGui_FindWindowByName(u8* name) {
    ImGuiID id = ImHashStr(name);
    return ImGui_FindWindowByID(id);
}

private {
void ApplyWindowSettings(ImGuiWindow* window, ImGuiWindowSettings* settings) {
    if settings != null {
        ImGuiViewport* main_viewport = ImGui_GetMainViewport();
        window.ViewportPos = main_viewport.Pos;
        if settings.ViewportId != 0 {
            window.ViewportId = settings.ViewportId;
            window.ViewportPos = ImVec2{
                cast(f32, settings.ViewportPos.x), cast(f32, settings.ViewportPos.y),
            };
        }
        window.Pos = ImTrunc(ImVec2{
            cast(f32, settings.Pos.x) + window.ViewportPos.x,
            cast(f32, settings.Pos.y) + window.ViewportPos.y,
        });
        if settings.Size.x > 0 && settings.Size.y > 0 {
            window.SizeFull = ImTrunc(ImVec2{cast(f32, settings.Size.x), cast(f32, settings.Size.y)});
            window.Size = window.SizeFull;
            window.AutoFitFramesY = 0;
            window.AutoFitFramesX = window.AutoFitFramesY;
        }
        window.Collapsed = settings.Collapsed;
        window.DockId = settings.DockId;
        window.DockOrder = settings.DockOrder;
        SetWindowConditionAllowFlags(window, ImGuiCond_FirstUseEver, false);
    }
    window.DC.IdealMaxPos = window.Pos;
    window.DC.CursorMaxPos = window.DC.IdealMaxPos;
    window.DC.CursorStartPos = window.DC.CursorMaxPos;
    if (window.Flags & ImGuiWindowFlags_AlwaysAutoResize) != 0 {
        window.AutoFitFramesY = 2;
        window.AutoFitFramesX = window.AutoFitFramesY;
        window.AutoFitOnlyGrows = false;
    } else {
        window.AutoFitFramesX = cast(ImS8, window.Size.x <= 0.0f ? 2 : 0);
        window.AutoFitFramesY = cast(ImS8, window.Size.y <= 0.0f ? 2 : 0);
        window.AutoFitOnlyGrows = window.AutoFitFramesX > 0 || window.AutoFitFramesY > 0;
    }
}

// Note that 'settings' may be NULL.
// Sets _Once, _Appearing, _FirstUseEver. _FirstUseEver will be cleared again if there are settings.
void InitOrLoadWindowSettings(ImGuiWindow* window, ImGuiWindowSettings* settings) {
    ImGuiContext* g = GImGui;
    ImGuiViewport* main_viewport = ImGui_GetMainViewport();
    window.Pos = op_add_ImVec2_ImVec2(main_viewport.Pos, ImVec2{60.0f, 60.0f});
    window.SizeFull = ImVec2{0.0f, 0.0f};
    window.Size = window.SizeFull;
    window.ViewportPos = main_viewport.Pos;
    window.SetWindowDockAllowFlags = ImGuiCond_Always | ImGuiCond_Once | ImGuiCond_FirstUseEver | ImGuiCond_Appearing;
    window.SetWindowCollapsedAllowFlags = window.SetWindowDockAllowFlags;
    window.SetWindowSizeAllowFlags = window.SetWindowCollapsedAllowFlags;
    window.SetWindowPosAllowFlags = window.SetWindowSizeAllowFlags;
    ApplyWindowSettings(window, settings);
    if settings != null {
        settings.LastUsedDate = g.SessionDate;
    }
}

ImGuiWindow* CreateNewWindow(u8* name, ImGuiWindowFlags flags) {
    ImGuiContext* g = GImGui;
    var window = cast(ImGuiWindow*, ImGui_MemAlloc(cast(u64, sizeof(ImGuiWindow))));
    ImGuiWindow_init(window, g, name);
    window.Flags = flags;
    ImGuiStorage_SetVoidPtr(&g.WindowsById, window.ID, window);
    ImGuiWindowSettings* settings = null;
    if (flags & ImGuiWindowFlags_NoSavedSettings) == 0 {
        settings = ImGui_FindWindowSettingsByWindow(window);
        if settings != null {
            window.SettingsOffset = ImChunkStream_ImGuiWindowSettings_offset_from_ptr(&g.SettingsWindows, settings);
        }
    }
    InitOrLoadWindowSettings(window, settings);
    if (flags & ImGuiWindowFlags_NoBringToFrontOnFocus) != 0 {
        ImVector_ImGuiWindow_ptr_push_front(&g.Windows, window);
    } else {
        ImVector_ImGuiWindow_ptr_push_back(&g.Windows, window);
    }
    return window;
}

ImGuiWindow* GetWindowForTitleDisplay(ImGuiWindow* window) {
    return window.DockNodeAsHost != null ? window.DockNodeAsHost.VisibleWindow : window;
}

ImGuiWindow* GetWindowForTitleAndMenuHeight(ImGuiWindow* window) {
    return window.DockNodeAsHost && window.DockNodeAsHost.VisibleWindow ? window.DockNodeAsHost.VisibleWindow : window;
}

ImVec2 CalcWindowMinSize(ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    ImVec2 size_min;
    if window.Flags & ImGuiWindowFlags_ChildWindow && !(window.Flags & ImGuiWindowFlags_Popup) {
        size_min.x = (window.ChildFlags & ImGuiChildFlags_ResizeX) != 0 ? g.Style.WindowMinSize.x : 4.0f;
        size_min.y = (window.ChildFlags & ImGuiChildFlags_ResizeY) != 0 ? g.Style.WindowMinSize.y : 4.0f;
    } else {
        size_min.x = (window.Flags & ImGuiWindowFlags_AlwaysAutoResize) == 0 ? g.Style.WindowMinSize.x : 4.0f;
        size_min.y = (window.Flags & ImGuiWindowFlags_AlwaysAutoResize) == 0 ? g.Style.WindowMinSize.y : 4.0f;
    }
    ImGuiWindow* window_for_height = GetWindowForTitleAndMenuHeight(window);
    size_min.y = ImMax(size_min.y, window_for_height.TitleBarHeight + window_for_height.MenuBarHeight + ImMax(0.0f, g.Style.WindowRounding - 1.0f));
    return size_min;
}

ImVec2 CalcWindowSizeAfterConstraint(ImGuiWindow* window, ImVec2 size_desired) {
    ImGuiContext* g = GImGui;
    ImVec2 new_size = size_desired;
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasSizeConstraint) != 0 {
        ImRect cr = g.NextWindowData.SizeConstraintRect;
        new_size.x = cr.Min.x >= 0.0f && cr.Max.x >= 0.0f ? ImClamp(new_size.x, cr.Min.x, cr.Max.x) : window.SizeFull.x;
        new_size.y = cr.Min.y >= 0.0f && cr.Max.y >= 0.0f ? ImClamp(new_size.y, cr.Min.y, cr.Max.y) : window.SizeFull.y;
        if g.NextWindowData.SizeCallback != null {
            ImGuiSizeCallbackData data;
            data.UserData = g.NextWindowData.SizeCallbackUserData;
            data.Pos = window.Pos;
            data.CurrentSize = window.SizeFull;
            data.DesiredSize = new_size;
            g.NextWindowData.SizeCallback(&data);
            new_size = data.DesiredSize;
        }
        new_size.x = cast(f32, cast(i32, new_size.x));
        new_size.y = cast(f32, cast(i32, new_size.y));
    }
    ImVec2 size_min = CalcWindowMinSize(window);
    return ImMax(new_size, size_min);
}

void CalcWindowContentSizes(ImGuiWindow* window, ImVec2* content_size_current, ImVec2* content_size_ideal) {
    bool preserve_old_content_sizes = false;
    if window.Collapsed && window.AutoFitFramesX <= 0 && window.AutoFitFramesY <= 0 {
        preserve_old_content_sizes = true;
    } else if window.Hidden && window.HiddenFramesCannotSkipItems == 0 && window.HiddenFramesCanSkipItems > 0 {
        preserve_old_content_sizes = true;
    }
    if preserve_old_content_sizes != 0 {
        *content_size_current = window.ContentSize;
        *content_size_ideal = window.ContentSizeIdeal;
        return;
    }
    content_size_current.x = window.ContentSizeExplicit.x != 0.0f ? window.ContentSizeExplicit.x : ImTrunc64(window.DC.CursorMaxPos.x - window.DC.CursorStartPos.x);
    content_size_current.y = window.ContentSizeExplicit.y != 0.0f ? window.ContentSizeExplicit.y : ImTrunc64(window.DC.CursorMaxPos.y - window.DC.CursorStartPos.y);
    content_size_ideal.x = window.ContentSizeExplicit.x != 0.0f ? window.ContentSizeExplicit.x : ImTrunc64(ImMax(window.DC.CursorMaxPos.x, window.DC.IdealMaxPos.x) - window.DC.CursorStartPos.x);
    content_size_ideal.y = window.ContentSizeExplicit.y != 0.0f ? window.ContentSizeExplicit.y : ImTrunc64(ImMax(window.DC.CursorMaxPos.y, window.DC.IdealMaxPos.y) - window.DC.CursorStartPos.y);
}

ImVec2 CalcWindowAutoFitSize(ImGuiWindow* window, ImVec2 size_contents, i32 axis_mask) {
    ImGuiContext* g = GImGui;
    ImGuiStyle* style = &g.Style;
    f32 decoration_w_without_scrollbars = window.DecoOuterSizeX1 + window.DecoOuterSizeX2 - window.ScrollbarSizes.x;
    f32 decoration_h_without_scrollbars = window.DecoOuterSizeY1 + window.DecoOuterSizeY2 - window.ScrollbarSizes.y;
    ImVec2 size_pad = op_mul_ImVec2_float(window.WindowPadding, 2.0f);
    ImVec2 size_desired;
    size_desired.x = (axis_mask & 1) != 0 ? size_contents.x + size_pad.x + decoration_w_without_scrollbars : window.Size.x;
    size_desired.y = (axis_mask & 2) != 0 ? size_contents.y + size_pad.y + decoration_h_without_scrollbars : window.Size.y;
    var size_max = ImVec2{FLT_MAX, FLT_MAX};
    if (window.Flags & ImGuiWindowFlags_ChildWindow) == 0 || (window.Flags & ImGuiWindowFlags_Popup) != 0 {
        if window.ViewportOwned == 0 {
            size_max = op_sub_ImVec2_ImVec2(ImGui_GetMainViewport().WorkSize, op_mul_ImVec2_float(style.DisplaySafeAreaPadding, 2.0f));
        }
        i32 monitor_idx = window.ViewportAllowPlatformMonitorExtend;
        if monitor_idx >= 0 && monitor_idx < g.PlatformIO.Monitors.Size {
            size_max = op_sub_ImVec2_ImVec2(g.PlatformIO.Monitors.Data[monitor_idx].WorkSize, op_mul_ImVec2_float(style.DisplaySafeAreaPadding, 2.0f));
        }
    }
    if (window.Flags & ImGuiWindowFlags_Tooltip) != 0 {
        return ImMin(size_desired, size_max);
    } else {
        ImVec2 size_min = CalcWindowMinSize(window);
        ImVec2 size_auto_fit = ImClamp(size_desired, ImMin(size_min, size_max), size_max);
        ImVec2 size_auto_fit_after_constraint = CalcWindowSizeAfterConstraint(window, size_auto_fit);
        f32 size_contents_for_scrollbar_x = (axis_mask & 1) != 0 ? size_contents.x : window.ContentSize.x;
        f32 size_contents_for_scrollbar_y = (axis_mask & 2) != 0 ? size_contents.y : window.ContentSize.y;
        bool will_have_scrollbar_x = size_auto_fit_after_constraint.x < size_contents_for_scrollbar_x + size_pad.x + decoration_w_without_scrollbars && !(window.Flags & ImGuiWindowFlags_NoScrollbar) && window.Flags & ImGuiWindowFlags_HorizontalScrollbar || window.Flags & ImGuiWindowFlags_AlwaysHorizontalScrollbar;
        bool will_have_scrollbar_y = size_auto_fit_after_constraint.y < size_contents_for_scrollbar_y + size_pad.y + decoration_h_without_scrollbars && !(window.Flags & ImGuiWindowFlags_NoScrollbar) || window.Flags & ImGuiWindowFlags_AlwaysVerticalScrollbar;
        if will_have_scrollbar_x != 0 {
            size_auto_fit.y += style.ScrollbarSize;
        }
        if will_have_scrollbar_y != 0 {
            size_auto_fit.x += style.ScrollbarSize;
        }
        return size_auto_fit;
    }
}
}

ImVec2 ImGui_CalcWindowNextAutoFitSize(ImGuiWindow* window) {
    ImVec2 size_contents_current;
    ImVec2 size_contents_ideal;
    CalcWindowContentSizes(window, &size_contents_current, &size_contents_ideal);
    ImVec2 size_auto_fit = CalcWindowAutoFitSize(window, size_contents_ideal, ~0);
    ImVec2 size_final = CalcWindowSizeAfterConstraint(window, size_auto_fit);
    return size_final;
}

private {
ImGuiCol GetWindowBgColorIdx(ImGuiWindow* window) {
    if (window.Flags & (ImGuiWindowFlags_Tooltip | ImGuiWindowFlags_Popup)) != 0 {
        return ImGuiCol_PopupBg;
    }
    if window.Flags & ImGuiWindowFlags_ChildWindow && !window.DockIsActive {
        return ImGuiCol_ChildBg;
    }
    return ImGuiCol_WindowBg;
}

void CalcResizePosSizeFromAnyCorner(ImGuiWindow* window, ImVec2 corner_target_arg, ImVec2 corner_norm, ImVec2* out_pos, ImVec2* out_size) {
    ImVec2 corner_target = corner_target_arg;
    if (window.Flags & ImGuiWindowFlags_ChildWindow) != 0 {
        ImGuiWindow* parent_window = window.ParentWindow;
        ImGuiWindowFlags parent_flags = parent_window.Flags;
        ImRect limit_rect = parent_window.InnerRect;
        ImRect_Expand(&limit_rect, ImVec2{
            -ImMax(parent_window.WindowPadding.x, parent_window.WindowBorderSize),
            -ImMax(parent_window.WindowPadding.y, parent_window.WindowBorderSize),
        });
        if (parent_flags & (ImGuiWindowFlags_HorizontalScrollbar | ImGuiWindowFlags_AlwaysHorizontalScrollbar)) == 0 || parent_flags & ImGuiWindowFlags_NoScrollbar {
            corner_target.x = ImClamp(corner_target.x, limit_rect.Min.x, limit_rect.Max.x);
        }
        if (parent_flags & ImGuiWindowFlags_NoScrollbar) != 0 {
            corner_target.y = ImClamp(corner_target.y, limit_rect.Min.y, limit_rect.Max.y);
        }
    }
    ImVec2 pos_min = ImLerp(corner_target, window.Pos, corner_norm);
    ImVec2 pos_max = ImLerp(op_add_ImVec2_ImVec2(window.Pos, window.Size), corner_target, corner_norm);
    ImVec2 size_expected = op_sub_ImVec2_ImVec2(pos_max, pos_min);
    ImVec2 size_constrained = CalcWindowSizeAfterConstraint(window, size_expected);
    *out_pos = pos_min;
    if corner_norm.x == 0.0f {
        out_pos.x -= size_constrained.x - size_expected.x;
    }
    if corner_norm.y == 0.0f {
        out_pos.y -= size_constrained.y - size_expected.y;
    }
    *out_size = size_constrained;
}
ImGuiResizeGripDef[4] resize_grip_def = {
    ImGuiResizeGripDef{ImVec2{1.0f, 1.0f}, ImVec2{-1.0f, -1.0f}, 0, 3},
    ImGuiResizeGripDef{ImVec2{0.0f, 1.0f}, ImVec2{1.0f, -1.0f}, 3, 6},
    ImGuiResizeGripDef{ImVec2{0.0f, 0.0f}, ImVec2{1.0f, 1.0f}, 6, 9},
    ImGuiResizeGripDef{ImVec2{1.0f, 0.0f}, ImVec2{-1.0f, 1.0f}, 9, 12},
};
ImGuiResizeBorderDef[4] resize_border_def = {
    ImGuiResizeBorderDef{
        ImVec2{1.0f, 0.0f},
        ImVec2{0.0f, 1.0f},
        ImVec2{0.0f, 0.0f},
        3.141592653589793f * 1.0f,
    },
    ImGuiResizeBorderDef{
        ImVec2{-1.0f, 0.0f},
        ImVec2{1.0f, 0.0f},
        ImVec2{1.0f, 1.0f},
        3.141592653589793f * 0.0f,
    },
    ImGuiResizeBorderDef{
        ImVec2{0.0f, 1.0f},
        ImVec2{0.0f, 0.0f},
        ImVec2{1.0f, 0.0f},
        3.141592653589793f * 1.5f,
    },
    ImGuiResizeBorderDef{
        ImVec2{0.0f, -1.0f},
        ImVec2{1.0f, 1.0f},
        ImVec2{0.0f, 1.0f},
        3.141592653589793f * 0.5f,
    },
};

ImRect GetResizeBorderRect(ImGuiWindow* window, i32 border_n, f32 perp_padding, f32 thickness) {
    ImRect rect = ImGuiWindow_Rect(window);
    if thickness == 0.0f {
        rect.Max = op_sub_ImVec2_ImVec2(rect.Max, ImVec2{1.0f, 1.0f});
    }
    if border_n == ImGuiDir_Left {
        return ImRect{
            ImVec2{rect.Min.x - thickness, rect.Min.y + perp_padding},
            ImVec2{rect.Min.x + thickness, rect.Max.y - perp_padding},
        };
    }
    if border_n == ImGuiDir_Right {
        return ImRect{
            ImVec2{rect.Max.x - thickness, rect.Min.y + perp_padding},
            ImVec2{rect.Max.x + thickness, rect.Max.y - perp_padding},
        };
    }
    if border_n == ImGuiDir_Up {
        return ImRect{
            ImVec2{rect.Min.x + perp_padding, rect.Min.y - thickness},
            ImVec2{rect.Max.x - perp_padding, rect.Min.y + thickness},
        };
    }
    if border_n == ImGuiDir_Down {
        return ImRect{
            ImVec2{rect.Min.x + perp_padding, rect.Max.y - thickness},
            ImVec2{rect.Max.x - perp_padding, rect.Max.y + thickness},
        };
    }
    assert(0);
    return __cxx_make_ImRect();
}
}

// 0..3: corners (Lower-right, Lower-left, Unused, Unused)
ImGuiID ImGui_GetWindowResizeCornerID(ImGuiWindow* window, i32 n) {
    assert(n >= 0 && n < 4);
    ImGuiID id = window.DockIsActive != 0 ? window.DockNode.HostWindow.ID : window.ID;
    id = ImHashStr("#RESIZE", 0, id);
    id = ImHashData(&n, cast(u64, sizeof(i32)), id);
    return id;
}

// Borders (Left, Right, Up, Down)
ImGuiID ImGui_GetWindowResizeBorderID(ImGuiWindow* window, ImGuiDir dir) {
    assert(dir >= 0 && dir < 4);
    i32 n = dir + 4;
    ImGuiID id = window.DockIsActive != 0 ? window.DockNode.HostWindow.ID : window.ID;
    id = ImHashStr("#RESIZE", 0, id);
    id = ImHashData(&n, cast(u64, sizeof(i32)), id);
    return id;
}

// Handle resize for: Resize Grips, Borders, Gamepad
// Return true when using auto-fit (double-click on resize grip)
private {
i32 ImGui_UpdateWindowManualResize(ImGuiWindow* window, i32* border_hovered, i32* border_held, i32 resize_grip_count, ImU32* resize_grip_col, ImRect visibility_rect) {
    ImGuiContext* g = GImGui;
    ImGuiWindowFlags flags = window.Flags;
    if flags & ImGuiWindowFlags_NoResize || window.AutoFitFramesX > 0 || window.AutoFitFramesY > 0 {
        return false;
    }
    if flags & ImGuiWindowFlags_AlwaysAutoResize && (window.ChildFlags & (ImGuiChildFlags_ResizeX | ImGuiChildFlags_ResizeY)) == 0 {
        return false;
    }
    if window.WasActive == false {
        return false;
    }
    i32 ret_auto_fit_mask = 0x00;
    var grip_draw_size = cast(f32, cast(i32, ImMax(g.FontSize * 1.35f, window.WindowRounding + 1.0f + g.FontSize * 0.2f)));
    f32 grip_hover_inner_size = resize_grip_count > 0 ? cast(f32, cast(i32, grip_draw_size * 0.75f)) : 0.0f;
    f32 grip_hover_outer_size = g.WindowsBorderHoverPadding;
    ImRect clamp_rect = visibility_rect;
    bool window_move_from_title_bar = !(window.BgClickFlags & ImGuiWindowBgClickFlags_Move) && !(window.Flags & ImGuiWindowFlags_NoTitleBar);
    if window_move_from_title_bar != 0 {
        clamp_rect.Min.y -= window.TitleBarHeight;
    }
    ImVec2 pos_target;
    ImVec2_init(&pos_target, FLT_MAX, FLT_MAX);
    ImVec2 size_target;
    ImVec2_init(&size_target, FLT_MAX, FLT_MAX);
    bool clip_with_viewport_rect = !(g.IO.BackendFlags & ImGuiBackendFlags_HasMouseHoveredViewport) || g.IO.MouseHoveredViewport != window.ViewportId || !(window.Viewport.Flags & ImGuiViewportFlags_NoDecoration);
    if clip_with_viewport_rect != 0 {
        window.ClipRect = ImGuiViewportP_GetMainRect(window.Viewport);
    }
    window.DC.NavLayerCurrent = ImGuiNavLayer_Menu;
    ImGui_PushID("#RESIZE");
    for i32 resize_grip_n = 0; resize_grip_n < resize_grip_count; resize_grip_n++ {
        ImGuiResizeGripDef def = resize_grip_def[resize_grip_n];
        ImVec2 corner = ImLerp(window.Pos, op_add_ImVec2_ImVec2(window.Pos, window.Size), def.CornerPosN);
        bool hovered;
        bool held;
        ImRect resize_rect;
        ImRect_init(&resize_rect, op_sub_ImVec2_ImVec2(corner, op_mul_ImVec2_float(def.InnerDir, grip_hover_outer_size)), op_add_ImVec2_ImVec2(corner, op_mul_ImVec2_float(def.InnerDir, grip_hover_inner_size)));
        if resize_rect.Min.x > resize_rect.Max.x {
            { var zz_sw = resize_rect.Min.x; resize_rect.Min.x = resize_rect.Max.x; resize_rect.Max.x = zz_sw; }
        }
        if resize_rect.Min.y > resize_rect.Max.y {
            { var zz_sw = resize_rect.Min.y; resize_rect.Min.y = resize_rect.Max.y; resize_rect.Max.y = zz_sw; }
        }
        ImGuiID resize_grip_id = ImGuiWindow_GetID(window, resize_grip_n);
        ImGui_ItemAdd(resize_rect, resize_grip_id, null, ImGuiItemFlags_NoNav);
        ImGui_ButtonBehavior(resize_rect, resize_grip_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren | ImGuiButtonFlags_NoNavFocus);
        if hovered || held {
            ImGui_SetMouseCursor((resize_grip_n & 1) != 0 ? ImGuiMouseCursor_ResizeNESW : ImGuiMouseCursor_ResizeNWSE);
        }
        if held && g.IO.MouseDoubleClicked[0] {
            ImVec2 size_auto_fit = CalcWindowAutoFitSize(window, window.ContentSizeIdeal, ~0);
            size_target = CalcWindowSizeAfterConstraint(window, size_auto_fit);
            ret_auto_fit_mask = 0x03;
            ImGui_ClearActiveID();
        } else if held != 0 {
            var clamp_min = ImVec2{
                def.CornerPosN.x == 1.0f ? clamp_rect.Min.x : cast(f32, -FLT_MAX),
                def.CornerPosN.y == 1.0f || def.CornerPosN.y == 0.0f && window_move_from_title_bar ? clamp_rect.Min.y : cast(f32, -FLT_MAX),
            };
            var clamp_max = ImVec2{
                def.CornerPosN.x == 0.0f ? clamp_rect.Max.x : FLT_MAX,
                def.CornerPosN.y == 0.0f ? clamp_rect.Max.y : FLT_MAX,
            };
            ImVec2 corner_target = op_add_ImVec2_ImVec2(op_sub_ImVec2_ImVec2(g.IO.MousePos, g.ActiveIdClickOffset), ImLerp(op_mul_ImVec2_float(def.InnerDir, grip_hover_outer_size), op_mul_ImVec2_float(def.InnerDir, -grip_hover_inner_size), def.CornerPosN));
            corner_target = ImClamp(corner_target, clamp_min, clamp_max);
            CalcResizePosSizeFromAnyCorner(window, corner_target, def.CornerPosN, &pos_target, &size_target);
        }
        bool resize_grip_visible = held || hovered || resize_grip_n == 0 && (window.Flags & ImGuiWindowFlags_ChildWindow) == 0;
        if resize_grip_visible != 0 {
            resize_grip_col[resize_grip_n] = ImGui_GetColorU32(held != 0 ? ImGuiCol_ResizeGripActive : hovered != 0 ? ImGuiCol_ResizeGripHovered : ImGuiCol_ResizeGrip);
        }
    }
    i32 resize_border_mask = 0x00;
    if (window.Flags & ImGuiWindowFlags_ChildWindow) != 0 {
        resize_border_mask |= ((window.ChildFlags & ImGuiChildFlags_ResizeX) != 0 ? 0x02 : 0) | ((window.ChildFlags & ImGuiChildFlags_ResizeY) != 0 ? 0x08 : 0);
    } else {
        resize_border_mask = g.IO.ConfigWindowsResizeFromEdges != 0 ? 0x0F : 0x00;
    }
    for i32 border_n = 0; border_n < 4; border_n++ {
        if (resize_border_mask & 1 << border_n) == 0 {
            continue;
        }
        ImGuiResizeBorderDef def = resize_border_def[border_n];
        ImGuiAxis axis = border_n == ImGuiDir_Left || border_n == ImGuiDir_Right ? ImGuiAxis_X : ImGuiAxis_Y;
        bool hovered;
        bool held;
        ImRect border_rect = GetResizeBorderRect(window, border_n, grip_hover_inner_size, g.WindowsBorderHoverPadding);
        ImGuiID border_id = ImGuiWindow_GetID(window, border_n + 4);
        ImGui_ItemAdd(border_rect, border_id, null, ImGuiItemFlags_NoNav);
        ImGui_ButtonBehavior(border_rect, border_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren | ImGuiButtonFlags_NoNavFocus);
        if hovered && g.HoveredIdTimer <= WINDOWS_RESIZE_FROM_EDGES_FEEDBACK_TIMER {
            hovered = false;
        }
        if hovered || held {
            ImGui_SetMouseCursor(axis == ImGuiAxis_X ? ImGuiMouseCursor_ResizeEW : ImGuiMouseCursor_ResizeNS);
        }
        if held && g.IO.MouseDoubleClicked[0] {
            if border_n == 1 || border_n == 3 {
                ImVec2 size_auto_fit = CalcWindowAutoFitSize(window, window.ContentSizeIdeal, 1 << axis);
                cast(f32*, &size_target)[axis] = cast(f32*, &CalcWindowSizeAfterConstraint(window, size_auto_fit))[axis];
                ret_auto_fit_mask |= 1 << axis;
                held = false;
                hovered = held;
            }
            ImGui_ClearActiveID();
        } else if held != 0 {
            bool just_scrolled_manually_while_resizing = g.WheelingWindow != null && g.WheelingWindowScrolledFrame == g.FrameCount && ImGui_IsWindowChildOf(window, g.WheelingWindow, false, true);
            if g.ActiveIdIsJustActivated || just_scrolled_manually_while_resizing {
                g.WindowResizeBorderExpectedRect = border_rect;
                g.WindowResizeRelativeMode = false;
            }
            if window.Flags & ImGuiWindowFlags_ChildWindow && memcmp(&g.WindowResizeBorderExpectedRect, &border_rect, cast(u64, sizeof(ImRect))) != 0 {
                g.WindowResizeRelativeMode = true;
            }
            ImVec2 border_curr = op_add_ImVec2_ImVec2(window.Pos, op_mul_ImVec2_ImVec2(ImMin(def.SegmentN1, def.SegmentN2), window.Size));
            f32 border_target_rel_mode_for_axis = cast(f32*, &border_curr)[axis] + cast(f32*, &g.IO.MouseDelta)[axis];
            f32 border_target_abs_mode_for_axis = cast(f32*, &g.IO.MousePos)[axis] - cast(f32*, &g.ActiveIdClickOffset)[axis] + g.WindowsBorderHoverPadding;
            ImVec2 border_target = window.Pos;
            cast(f32*, &border_target)[axis] = border_target_abs_mode_for_axis;
            bool ignore_resize = false;
            if g.WindowResizeRelativeMode != 0 {
                cast(f32*, &border_target)[axis] = border_target_rel_mode_for_axis;
                if cast(f32*, &g.IO.MouseDelta)[axis] == 0.0f || cast(f32*, &g.IO.MouseDelta)[axis] > 0.0f == border_target_rel_mode_for_axis > border_target_abs_mode_for_axis {
                    ignore_resize = true;
                }
            }
            ImVec2 clamp_min;
            ImVec2_init(&clamp_min, border_n == ImGuiDir_Right ? clamp_rect.Min.x : cast(f32, -FLT_MAX), border_n == ImGuiDir_Down || border_n == ImGuiDir_Up && window_move_from_title_bar ? clamp_rect.Min.y : cast(f32, -FLT_MAX));
            ImVec2 clamp_max;
            ImVec2_init(&clamp_max, border_n == ImGuiDir_Left ? clamp_rect.Max.x : FLT_MAX, border_n == ImGuiDir_Up ? clamp_rect.Max.y : FLT_MAX);
            border_target = ImClamp(border_target, clamp_min, clamp_max);
            if ignore_resize == 0 {
                CalcResizePosSizeFromAnyCorner(window, border_target, ImMin(def.SegmentN1, def.SegmentN2), &pos_target, &size_target);
            }
        }
        if hovered != 0 {
            *border_hovered = border_n;
        }
        if held != 0 {
            *border_held = border_n;
        }
    }
    ImGui_PopID();
    window.DC.NavLayerCurrent = ImGuiNavLayer_Main;
    if g.NavWindowingTarget && g.NavWindowingTarget.RootWindowDockTree == window {
        ImVec2 nav_resize_dir;
        if g.NavInputSource == ImGuiInputSource_Keyboard && g.IO.KeyShift {
            nav_resize_dir = ImGui_GetKeyMagnitude2d(ImGuiKey_LeftArrow, ImGuiKey_RightArrow, ImGuiKey_UpArrow, ImGuiKey_DownArrow);
        }
        if g.NavInputSource == ImGuiInputSource_Gamepad {
            nav_resize_dir = ImGui_GetKeyMagnitude2d(ImGuiKey_GamepadDpadLeft, ImGuiKey_GamepadDpadRight, ImGuiKey_GamepadDpadUp, ImGuiKey_GamepadDpadDown);
        }
        if nav_resize_dir.x != 0.0f || nav_resize_dir.y != 0.0f {
            f32 NAV_RESIZE_SPEED = 600.0f;
            f32 resize_step = NAV_RESIZE_SPEED * g.IO.DeltaTime * ImGui_GetScale();
            g.NavWindowingAccumDeltaSize = op_add_ImVec2_ImVec2(g.NavWindowingAccumDeltaSize, op_mul_ImVec2_float(nav_resize_dir, resize_step));
            g.NavWindowingAccumDeltaSize = ImMax(g.NavWindowingAccumDeltaSize, op_sub_ImVec2_ImVec2(op_sub_ImVec2_ImVec2(clamp_rect.Min, window.Pos), window.Size));
            g.NavWindowingToggleLayer = false;
            g.NavHighlightItemUnderNav = true;
            resize_grip_col[0] = ImGui_GetColorU32(ImGuiCol_ResizeGripActive);
            ImVec2 accum_floored = ImTrunc(g.NavWindowingAccumDeltaSize);
            if accum_floored.x != 0.0f || accum_floored.y != 0.0f {
                size_target = CalcWindowSizeAfterConstraint(window, op_add_ImVec2_ImVec2(window.SizeFull, accum_floored));
                g.NavWindowingAccumDeltaSize = op_sub_ImVec2_ImVec2(g.NavWindowingAccumDeltaSize, accum_floored);
            }
        }
    }
    ImVec2 old_pos = window.Pos;
    ImVec2 old_size = window.SizeFull;
    if size_target.x != FLT_MAX && (window.Size.x != size_target.x || window.SizeFull.x != size_target.x) {
        window.SizeFull.x = size_target.x;
        window.Size.x = window.SizeFull.x;
    }
    if size_target.y != FLT_MAX && (window.Size.y != size_target.y || window.SizeFull.y != size_target.y) {
        window.SizeFull.y = size_target.y;
        window.Size.y = window.SizeFull.y;
    }
    if pos_target.x != FLT_MAX && window.Pos.x != ImTrunc(pos_target.x) {
        window.Pos.x = ImTrunc(pos_target.x);
    }
    if pos_target.y != FLT_MAX && window.Pos.y != ImTrunc(pos_target.y) {
        window.Pos.y = ImTrunc(pos_target.y);
    }
    if old_pos.x != window.Pos.x || old_pos.y != window.Pos.y || old_size.x != window.SizeFull.x || old_size.y != window.SizeFull.y {
        ImGui_MarkIniSettingsDirty(window);
    }
    if *border_held != -1 {
        g.WindowResizeBorderExpectedRect = GetResizeBorderRect(window, *border_held, grip_hover_inner_size, g.WindowsBorderHoverPadding);
    }
    return ret_auto_fit_mask;
}

void ClampWindowPos(ImGuiWindow* window, ImRect visibility_rect) {
    ImVec2 size_for_clamping = window.Size;
    bool move_from_title_bar_only = (window.BgClickFlags & ImGuiWindowBgClickFlags_Move) == 0;
    if move_from_title_bar_only && window.DockNodeAsHost {
        size_for_clamping.y = ImGui_GetFrameHeight();
    } else if move_from_title_bar_only && !(window.Flags & ImGuiWindowFlags_NoTitleBar) {
        size_for_clamping.y = window.TitleBarHeight;
    }
    window.Pos = ImClamp(window.Pos, op_sub_ImVec2_ImVec2(visibility_rect.Min, size_for_clamping), visibility_rect.Max);
}

void RenderWindowOuterSingleBorder(ImGuiWindow* window, i32 border_n, ImU32 border_col, f32 border_size) {
    ImGuiResizeBorderDef def = resize_border_def[border_n];
    f32 rounding = window.WindowRounding;
    ImRect border_r = GetResizeBorderRect(window, border_n, rounding, 0.0f);
    ImDrawList_PathArcTo(window.DrawList, op_add_ImVec2_ImVec2(op_add_ImVec2_ImVec2(ImLerp(border_r.Min, border_r.Max, def.SegmentN1), ImVec2{0.5f, 0.5f}), op_mul_ImVec2_float(def.InnerDir, rounding)), rounding, def.OuterAngle - 3.141592653589793f * 0.25f, def.OuterAngle, 0);
    ImDrawList_PathArcTo(window.DrawList, op_add_ImVec2_ImVec2(op_add_ImVec2_ImVec2(ImLerp(border_r.Min, border_r.Max, def.SegmentN2), ImVec2{0.5f, 0.5f}), op_mul_ImVec2_float(def.InnerDir, rounding)), rounding, def.OuterAngle, def.OuterAngle + 3.141592653589793f * 0.25f, 0);
    ImDrawList_PathStroke(window.DrawList, border_col, border_size, 0);
}

void ImGui_RenderWindowOuterBorders(ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    f32 border_size = window.WindowBorderSize;
    ImU32 border_col = ImGui_GetColorU32(ImGuiCol_Border);
    if border_size > 0.0f && (window.Flags & ImGuiWindowFlags_NoBackground) == 0 {
        ImDrawList_AddRect(window.DrawList, window.Pos, op_add_ImVec2_ImVec2(window.Pos, window.Size), border_col, window.WindowRounding, window.WindowBorderSize, 0);
    } else if border_size > 0.0f {
        if (window.ChildFlags & ImGuiChildFlags_ResizeX) != 0 {
            RenderWindowOuterSingleBorder(window, 1, border_col, border_size);
        }
        if (window.ChildFlags & ImGuiChildFlags_ResizeY) != 0 {
            RenderWindowOuterSingleBorder(window, 3, border_col, border_size);
        }
    }
    if window.ResizeBorderHovered != -1 || window.ResizeBorderHeld != -1 {
        i32 border_n = window.ResizeBorderHeld != -1 ? window.ResizeBorderHeld : window.ResizeBorderHovered;
        ImU32 border_col_resizing = ImGui_GetColorU32(window.ResizeBorderHeld != -1 ? ImGuiCol_SeparatorActive : ImGuiCol_SeparatorHovered);
        RenderWindowOuterSingleBorder(window, border_n, border_col_resizing, ImMax(2.0f, window.WindowBorderSize));
    }
    if g.Style.FrameBorderSize > 0.0f && !(window.Flags & ImGuiWindowFlags_NoTitleBar) && !window.DockIsActive {
        f32 y = window.Pos.y + window.TitleBarHeight - 1.0f;
        ImDrawList_AddLineH(window.DrawList, window.Pos.x + border_size * 0.5f, window.Pos.x + window.Size.x - border_size * 0.5f, y, border_col, g.Style.FrameBorderSize);
    }
}
}

// Draw background and borders
// Draw and handle scrollbars
void ImGui_RenderWindowDecorations(ImGuiWindow* window, ImRect title_bar_rect, bool title_bar_is_highlight, bool handle_borders_and_resize_grips, i32 resize_grip_count, ImU32* resize_grip_col, f32 resize_grip_draw_size) {
    ImGuiContext* g = GImGui;
    ImGuiStyle* style = &g.Style;
    ImGuiWindowFlags flags = window.Flags;
    assert(window.BeginCount == 0);
    window.SkipItems = false;
    window.DC.NavLayerCurrent = ImGuiNavLayer_Menu;
    f32 window_rounding = window.WindowRounding;
    f32 window_border_size = window.WindowBorderSize;
    if window.Collapsed != 0 {
        f32 backup_border_size = style.FrameBorderSize;
        g.Style.FrameBorderSize = window.WindowBorderSize;
        ImU32 title_bar_col = ImGui_GetColorU32(title_bar_is_highlight && g.NavCursorVisible ? ImGuiCol_TitleBgActive : ImGuiCol_TitleBgCollapsed);
        if window.ViewportOwned != 0 {
            title_bar_col |= 0xFF000000;
        }
        ImGui_RenderFrame(title_bar_rect.Min, title_bar_rect.Max, title_bar_col, true, window_rounding);
        g.Style.FrameBorderSize = backup_border_size;
    } else {
        if (flags & ImGuiWindowFlags_NoBackground) == 0 {
            bool is_docking_transparent_payload = false;
            if g.DragDropActive && g.FrameCount - g.DragDropAcceptFrameCount <= 1 && g.IO.ConfigDockingTransparentPayload {
                if ImGuiPayload_IsDataType(&g.DragDropPayload, "_IMWINDOW") && *cast(ImGuiWindow**, g.DragDropPayload.Data) == window {
                    is_docking_transparent_payload = true;
                }
            }
            ImU32 bg_col = ImGui_GetColorU32(GetWindowBgColorIdx(window));
            if window.ViewportOwned != 0 {
                bg_col |= 0xFF000000;
                if is_docking_transparent_payload != 0 {
                    window.Viewport.Alpha *= DOCKING_TRANSPARENT_PAYLOAD_ALPHA;
                }
            } else {
                bool override_alpha = false;
                f32 alpha = 1.0f;
                if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasBgAlpha) != 0 {
                    alpha = g.NextWindowData.BgAlphaVal;
                    override_alpha = true;
                }
                if is_docking_transparent_payload != 0 {
                    alpha *= DOCKING_TRANSPARENT_PAYLOAD_ALPHA;
                    override_alpha = true;
                }
                if override_alpha != 0 {
                    bg_col = bg_col & cast(u32, ~0xFF000000) | cast(u32, cast(i32, ImSaturate(alpha) * 255.0f + 0.5f) << 24);
                }
            }
            if window.DockIsActive != 0 {
                window.DockNode.LastBgColor = bg_col;
            }
            if (flags & ImGuiWindowFlags_DockNodeHost) != 0 {
                bg_col = 0;
            }
            if (bg_col & 0xFF000000) != 0 {
                ImRect bg_rect;
                ImRect_init(&bg_rect, op_add_ImVec2_ImVec2(window.Pos, ImVec2{0.0f, window.TitleBarHeight}), op_add_ImVec2_ImVec2(window.Pos, window.Size));
                ImDrawFlags bg_rounding_flags;
                if window.DockIsActive != 0 {
                    bg_rounding_flags = ImGui_CalcRoundingFlagsForRectInRect(bg_rect, ImGuiWindow_Rect(window.DockNode.HostWindow), 0.0f);
                } else {
                    bg_rounding_flags = (flags & ImGuiWindowFlags_NoTitleBar) != 0 ? ImDrawFlags_RoundCornersAll : ImDrawFlags_RoundCornersBottom;
                }
                ImDrawList* bg_draw_list = window.DockIsActive != 0 ? window.DockNode.HostWindow.DrawList : window.DrawList;
                if window.DockIsActive != 0 {
                    ImDrawList_ChannelsSetCurrent(bg_draw_list, 0);
                }
                ImDrawList_AddRectFilled(bg_draw_list, bg_rect.Min, bg_rect.Max, bg_col, window_rounding, bg_rounding_flags);
                if window.DockIsActive != 0 {
                    ImDrawList_ChannelsSetCurrent(bg_draw_list, 1);
                }
            }
        }
        if window.DockIsActive != 0 {
            window.DockNode.IsBgDrawnThisFrame = true;
        }
        if !(flags & ImGuiWindowFlags_NoTitleBar) && !window.DockIsActive {
            ImU32 title_bar_col = ImGui_GetColorU32(title_bar_is_highlight != 0 ? ImGuiCol_TitleBgActive : ImGuiCol_TitleBg);
            if window.ViewportOwned != 0 {
                title_bar_col |= 0xFF000000;
            }
            ImDrawList_AddRectFilled(window.DrawList, title_bar_rect.Min, title_bar_rect.Max, title_bar_col, window_rounding, ImDrawFlags_RoundCornersTop);
        }
        if (flags & ImGuiWindowFlags_MenuBar) != 0 {
            ImRect menu_bar_rect = ImGuiWindow_MenuBarRect(window);
            ImRect_ClipWith(&menu_bar_rect, ImGuiWindow_Rect(window));
            ImDrawList_AddRectFilled(window.DrawList, menu_bar_rect.Min, menu_bar_rect.Max, ImGui_GetColorU32(ImGuiCol_MenuBarBg), (flags & ImGuiWindowFlags_NoTitleBar) != 0 ? window_rounding : 0.0f, ImDrawFlags_RoundCornersTop);
            if style.FrameBorderSize > 0.0f && menu_bar_rect.Max.y < window.Pos.y + window.Size.y {
                ImDrawList_AddLineH(window.DrawList, menu_bar_rect.Min.x + window_border_size * 0.5f, menu_bar_rect.Max.x - window_border_size * 0.5f, menu_bar_rect.Max.y, ImGui_GetColorU32(ImGuiCol_Border), style.FrameBorderSize);
            }
        }
        ImGuiDockNode* node = window.DockNode;
        if window.DockIsActive && ImGuiDockNode_IsHiddenTabBar(node) && !ImGuiDockNode_IsNoTabBar(node) {
            f32 unhide_sz_draw = ImTrunc(g.FontSize * 0.7f);
            f32 unhide_sz_hit = ImTrunc(g.FontSize * 0.55f);
            ImVec2 p = node.Pos;
            ImRect r;
            ImRect_init(&r, p, op_add_ImVec2_ImVec2(p, ImVec2{unhide_sz_hit, unhide_sz_hit}));
            ImGuiID unhide_id = ImGuiWindow_GetID(window, "#UNHIDE", null);
            ImGui_KeepAliveID(unhide_id);
            bool hovered;
            bool held;
            if ImGui_ButtonBehavior(r, unhide_id, &hovered, &held, ImGuiButtonFlags_FlattenChildren) != 0 {
                node.WantHiddenTabBarToggle = true;
            } else if held && ImGui_IsMouseDragging(0) {
                ImGui_StartMouseMovingWindowOrNode(window, node, true);
            }
            ImU32 col = ImGui_GetColorU32(held && hovered || node.IsFocused && !hovered ? ImGuiCol_ButtonActive : hovered != 0 ? ImGuiCol_ButtonHovered : ImGuiCol_Button);
            ImDrawList_AddTriangleFilled(window.DrawList, p, op_add_ImVec2_ImVec2(p, ImVec2{unhide_sz_draw, 0.0f}), op_add_ImVec2_ImVec2(p, ImVec2{0.0f, unhide_sz_draw}), col);
        }
        if window.ScrollbarX != 0 {
            ImGui_Scrollbar(ImGuiAxis_X);
        }
        if window.ScrollbarY != 0 {
            ImGui_Scrollbar(ImGuiAxis_Y);
        }
        if handle_borders_and_resize_grips && !(flags & ImGuiWindowFlags_NoResize) {
            for i32 resize_grip_n = 0; resize_grip_n < resize_grip_count; resize_grip_n++ {
                ImU32 col = resize_grip_col[resize_grip_n];
                if (col & 0xFF000000) == 0 {
                    continue;
                }
                ImGuiResizeGripDef grip = resize_grip_def[resize_grip_n];
                ImVec2 corner = ImLerp(window.Pos, op_add_ImVec2_ImVec2(window.Pos, window.Size), grip.CornerPosN);
                var border_inner = cast(f32, cast(i32, window_border_size * 0.5f + 0.5f));
                ImDrawList_PathLineTo(window.DrawList, op_add_ImVec2_ImVec2(corner, op_mul_ImVec2_ImVec2(grip.InnerDir, (resize_grip_n & 1) != 0 ? ImVec2{border_inner, resize_grip_draw_size} : ImVec2{resize_grip_draw_size, border_inner})));
                ImDrawList_PathLineTo(window.DrawList, op_add_ImVec2_ImVec2(corner, op_mul_ImVec2_ImVec2(grip.InnerDir, (resize_grip_n & 1) != 0 ? ImVec2{resize_grip_draw_size, border_inner} : ImVec2{border_inner, resize_grip_draw_size})));
                ImDrawList_PathArcToFast(window.DrawList, ImVec2{
                    corner.x + grip.InnerDir.x * (window_rounding + border_inner),
                    corner.y + grip.InnerDir.y * (window_rounding + border_inner),
                }, window_rounding, grip.AngleMin12, grip.AngleMax12);
                ImDrawList_PathFillConvex(window.DrawList, col);
            }
        }
        if handle_borders_and_resize_grips && !window.DockNodeAsHost {
            ImGui_RenderWindowOuterBorders(window);
        }
    }
    window.DC.NavLayerCurrent = ImGuiNavLayer_Main;
}

// When inside a dock node, this is handled in DockNodeCalcTabBarLayout() instead.
// Render title text, collapse button, close button
void ImGui_RenderWindowTitleBarContents(ImGuiWindow* window, ImRect title_bar_rect, u8* name, bool* p_open) {
    ImGuiContext* g = GImGui;
    ImGuiStyle* style = &g.Style;
    ImGuiWindowFlags flags = window.Flags;
    bool has_close_button = p_open != null;
    bool has_collapse_button = !(flags & ImGuiWindowFlags_NoCollapse) && style.WindowMenuButtonPosition != ImGuiDir_None;
    ImGuiItemFlags item_flags_backup = g.CurrentItemFlags;
    g.CurrentItemFlags |= ImGuiItemFlags_NoNavDefaultFocus;
    window.DC.NavLayerCurrent = ImGuiNavLayer_Menu;
    f32 pad_l = style.FramePadding.x;
    f32 pad_r = style.FramePadding.x;
    f32 button_sz = g.FontSize;
    ImVec2 close_button_pos;
    ImVec2 collapse_button_pos;
    if has_close_button != 0 {
        close_button_pos = ImVec2{
            title_bar_rect.Max.x - pad_r - button_sz, title_bar_rect.Min.y + style.FramePadding.y,
        };
        pad_r += button_sz + style.ItemInnerSpacing.x;
    }
    if has_collapse_button && style.WindowMenuButtonPosition == ImGuiDir_Right {
        collapse_button_pos = ImVec2{
            title_bar_rect.Max.x - pad_r - button_sz, title_bar_rect.Min.y + style.FramePadding.y,
        };
        pad_r += button_sz + style.ItemInnerSpacing.x;
    }
    if has_collapse_button && style.WindowMenuButtonPosition == ImGuiDir_Left {
        collapse_button_pos = ImVec2{
            title_bar_rect.Min.x + pad_l, title_bar_rect.Min.y + style.FramePadding.y,
        };
        pad_l += button_sz + style.ItemInnerSpacing.x;
    }
    if has_collapse_button != 0 {
        if ImGui_CollapseButton(ImGuiWindow_GetID(window, "#COLLAPSE", null), collapse_button_pos, null) != 0 {
            window.WantCollapseToggle = true;
        }
    }
    if has_close_button != 0 {
        ImGuiItemFlags backup_item_flags = g.CurrentItemFlags;
        g.CurrentItemFlags |= ImGuiItemFlags_NoFocus;
        if ImGui_CloseButton(ImGuiWindow_GetID(window, "#CLOSE", null), close_button_pos) != 0 {
            *p_open = false;
        }
        g.CurrentItemFlags = backup_item_flags;
    }
    window.DC.NavLayerCurrent = ImGuiNavLayer_Main;
    g.CurrentItemFlags = item_flags_backup;
    f32 marker_size_x = (flags & ImGuiWindowFlags_UnsavedDocument) != 0 ? button_sz * 0.8f : 0.0f;
    ImVec2 text_size = op_add_ImVec2_ImVec2(ImGui_CalcTextSize(name, null, true), ImVec2{marker_size_x, 0.0f});
    if pad_l > style.FramePadding.x {
        pad_l += g.Style.ItemInnerSpacing.x;
    }
    if pad_r > style.FramePadding.x {
        pad_r += g.Style.ItemInnerSpacing.x;
    }
    if style.WindowTitleAlign.x > 0.0f && style.WindowTitleAlign.x < 1.0f {
        f32 centerness = ImSaturate(1.0f - fabs(style.WindowTitleAlign.x - 0.5f) * 2.0f);
        f32 pad_extend = ImMin(ImMax(pad_l, pad_r), ImRect_GetWidth(&title_bar_rect) - pad_l - pad_r - text_size.x);
        pad_l = ImMax(pad_l, pad_extend * centerness);
        pad_r = ImMax(pad_r, pad_extend * centerness);
    }
    ImRect layout_r;
    ImRect_init(&layout_r, title_bar_rect.Min.x + pad_l, title_bar_rect.Min.y, title_bar_rect.Max.x - pad_r, title_bar_rect.Max.y);
    ImRect clip_r;
    ImRect_init(&clip_r, layout_r.Min.x, layout_r.Min.y, ImMin(layout_r.Max.x + g.Style.ItemInnerSpacing.x, title_bar_rect.Max.x), layout_r.Max.y);
    if (flags & ImGuiWindowFlags_UnsavedDocument) != 0 {
        ImVec2 marker_pos;
        marker_pos.x = ImClamp(layout_r.Min.x + (ImRect_GetWidth(&layout_r) - text_size.x) * style.WindowTitleAlign.x + text_size.x, layout_r.Min.x, layout_r.Max.x);
        marker_pos.y = (layout_r.Min.y + layout_r.Max.y) * 0.5f;
        if marker_pos.x > layout_r.Min.x {
            ImGui_RenderBullet(window.DrawList, marker_pos, ImGui_GetColorU32(ImGuiCol_UnsavedMarker));
            clip_r.Max.x = ImMin(clip_r.Max.x, marker_pos.x - cast(f32, cast(i32, marker_size_x * 0.5f)));
        }
    }
    ImGui_RenderTextClipped(layout_r.Min, layout_r.Max, name, null, &text_size, style.WindowTitleAlign, &clip_r);
}

void ImGui_UpdateWindowParentAndRootLinks(ImGuiWindow* window, ImGuiWindowFlags flags, ImGuiWindow* parent_window) {
    window.ParentWindow = parent_window;
    window.RootWindowForNav = window;
    window.RootWindowForTitleBarHighlight = window.RootWindowForNav;
    window.RootWindowDockTree = window.RootWindowForTitleBarHighlight;
    window.RootWindowPopupTree = window.RootWindowDockTree;
    window.RootWindow = window.RootWindowPopupTree;
    if parent_window && flags & ImGuiWindowFlags_ChildWindow && !(flags & ImGuiWindowFlags_Tooltip) {
        window.RootWindowDockTree = parent_window.RootWindowDockTree;
        if !window.DockIsActive && !(parent_window.Flags & ImGuiWindowFlags_DockNodeHost) {
            window.RootWindow = parent_window.RootWindow;
        }
    }
    if parent_window && flags & ImGuiWindowFlags_Popup {
        window.RootWindowPopupTree = parent_window.RootWindowPopupTree;
    }
    if parent_window && !(flags & ImGuiWindowFlags_Modal) && flags & (ImGuiWindowFlags_ChildWindow | ImGuiWindowFlags_Popup | ImGuiWindowFlags_Tooltip) {
        window.RootWindowForTitleBarHighlight = parent_window.RootWindowForTitleBarHighlight;
    }
    while (window.RootWindowForNav.ChildFlags & ImGuiChildFlags_NavFlattened) != 0 {
        assert(window.RootWindowForNav.ParentWindow != null);
        window.RootWindowForNav = window.RootWindowForNav.ParentWindow;
    }
}

// [EXPERIMENTAL] Called by Begin(). NextWindowData is valid at this point.
// This is designed as a toy/test-bed for
void ImGui_UpdateWindowSkipRefresh(ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    window.SkipRefresh = false;
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasRefreshPolicy) == 0 {
        return;
    }
    if (g.NextWindowData.RefreshFlagsVal & ImGuiWindowRefreshFlags_TryToAvoidRefresh) != 0 {
        if window.Appearing != 0 {
            return;
        }
        if window.Hidden != 0 {
            return;
        }
        if g.NextWindowData.RefreshFlagsVal & ImGuiWindowRefreshFlags_RefreshOnHover && g.HoveredWindow {
            if window.RootWindow == g.HoveredWindow.RootWindow || ImGui_IsWindowWithinBeginStackOf(g.HoveredWindow.RootWindow, window) {
                return;
            }
        }
        if g.NextWindowData.RefreshFlagsVal & ImGuiWindowRefreshFlags_RefreshOnFocus && g.NavWindow {
            if window.RootWindow == g.NavWindow.RootWindow || ImGui_IsWindowWithinBeginStackOf(g.NavWindow.RootWindow, window) {
                return;
            }
        }
        window.DrawList = null;
        window.SkipRefresh = true;
    }
}

private {
void SetWindowActiveForSkipRefresh(ImGuiWindow* window) {
    window.Active = true;
    {
        ImGuiWindow** zz_rf_it_24 = ImVector_ImGuiWindow_ptr_begin(&window.DC.ChildWindows);
        ImGuiWindow** zz_rf_end_24 = ImVector_ImGuiWindow_ptr_end(&window.DC.ChildWindows);
        for ; zz_rf_it_24 != zz_rf_end_24; zz_rf_it_24++ {
            ImGuiWindow* child = *zz_rf_it_24;
            if child.Hidden == 0 {
                child.SkipRefresh = true;
                child.Active = child.SkipRefresh;
                SetWindowActiveForSkipRefresh(child);
            }
        }
    }
}
}

// Push a new Dear ImGui window to add widgets to.
// - A default window called "Debug" is automatically stacked at the beginning of every frame so you can use widgets without explicitly calling a Begin/End pair.
// - Begin/End can be called multiple times during the frame with the same window name to append content.
// - The window name is used as a unique identifier to preserve window information across frames (and save rudimentary information to the .ini file).
//   You can use the "##" or "###" markers to use the same label with different id, or same id with different label. See documentation at the top of this file.
// - Return false when window is collapsed, so you can early out in your code. You always need to call ImGui::End() even if false is returned.
// - Passing 'bool* p_open' displays a Close button on the upper-right corner of the window, the pointed value will be set to false when the button is pressed.
bool ImGui_Begin(u8* name, bool* p_open, ImGuiWindowFlags flags) {
    ImGuiContext* g = GImGui;
    ImGuiStyle style = g.Style;
    assert(name != null && name[0] != 0);
    assert(cast(i64, g.WithinFrameScope));
    assert(g.FrameCountEnded != g.FrameCount);
    ImGuiWindow* window = ImGui_FindWindowByName(name);
    bool window_just_created = window == null;
    if window_just_created != 0 {
        window = CreateNewWindow(name, flags);
    }
    if g.DebugBreakInWindow == window.ID {
        assert(0);
    }
    if (flags & ImGuiWindowFlags_NoInputs) == ImGuiWindowFlags_NoInputs {
        flags |= ImGuiWindowFlags_NoMove | ImGuiWindowFlags_NoResize;
    }
    i32 current_frame = g.FrameCount;
    bool first_begin_of_the_frame = window.LastFrameActive != current_frame;
    window.IsFallbackWindow = g.CurrentWindowStack.Size == 0 && g.WithinFrameScopeWithImplicitWindow;
    bool window_just_activated_by_user = window.LastFrameActive < current_frame - 1;
    if (flags & ImGuiWindowFlags_Popup) != 0 {
        ImGuiPopupData* popup_ref = &g.OpenPopupStack.Data[g.BeginPopupStack.Size];
        window_just_activated_by_user |= window.PopupId != popup_ref.PopupId;
        window_just_activated_by_user |= window != popup_ref.Window;
    }
    bool window_was_appearing = window.Appearing;
    if first_begin_of_the_frame != 0 {
        ImGui_UpdateWindowInFocusOrderList(window, window_just_created, flags);
        window.Appearing = window_just_activated_by_user;
        if window.Appearing != 0 {
            SetWindowConditionAllowFlags(window, ImGuiCond_Appearing, true);
        }
        window.FlagsPreviousFrame = window.Flags;
        window.Flags = cast(ImGuiWindowFlags, flags);
        window.ChildFlags = (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasChildFlags) != 0 ? g.NextWindowData.ChildFlags : 0;
        window.LastFrameActive = current_frame;
        window.LastTimeActive = cast(f32, g.Time);
        window.BeginOrderWithinParent = 0;
        window.BeginOrderWithinContext = cast(i16, g.WindowsActiveCount++);
    } else {
        flags = window.Flags;
    }
    assert(window.DockNode == null || window.DockNodeAsHost == null);
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasDock) != 0 {
        ImGui_SetWindowDock(window, g.NextWindowData.DockId, g.NextWindowData.DockCond);
    }
    if first_begin_of_the_frame != 0 {
        bool has_dock_node = window.DockId != 0 || window.DockNode != null;
        bool new_auto_dock_node = !has_dock_node && ImGui_GetWindowAlwaysWantOwnTabBar(window);
        bool dock_node_was_visible = window.DockNodeIsVisible;
        bool dock_tab_was_visible = window.DockTabIsVisible;
        window.DockTabIsVisible = false;
        window.DockNodeIsVisible = window.DockTabIsVisible;
        window.DockIsActive = window.DockNodeIsVisible;
        if has_dock_node || new_auto_dock_node {
            ImGui_BeginDocked(window, p_open);
            flags = window.Flags;
            if window.DockIsActive != 0 {
                assert(window.DockNode != null);
                g.NextWindowData.HasFlags &= ~ImGuiNextWindowDataFlags_HasSizeConstraint;
            }
            if window.DockTabIsVisible && !dock_tab_was_visible && dock_node_was_visible && !window.Appearing && !window_was_appearing {
                window.Appearing = true;
                SetWindowConditionAllowFlags(window, ImGuiCond_Appearing, true);
            }
        }
    }
    ImGuiWindow* parent_window_in_stack = window.DockIsActive && window.DockNode.HostWindow ? window.DockNode.HostWindow : ImVector_ImGuiWindowStackData_empty(&g.CurrentWindowStack) != 0 ? null : ImVector_ImGuiWindowStackData_back(&g.CurrentWindowStack).Window;
    ImGuiWindow* parent_window = first_begin_of_the_frame != 0 ? (flags & (ImGuiWindowFlags_ChildWindow | ImGuiWindowFlags_Popup | ImGuiWindowFlags_Tooltip)) != 0 ? parent_window_in_stack : null : window.ParentWindow;
    assert(parent_window != null || !(flags & ImGuiWindowFlags_ChildWindow));
    if window.IDStack.Size == 0 {
        ImVector_ImGuiID_push_back(&window.IDStack, window.ID);
    }
    g.CurrentWindow = window;
    ImVector_ImGuiWindowStackData_resize(&g.CurrentWindowStack, g.CurrentWindowStack.Size + 1);
    ImGuiWindowStackData* window_stack_data = ImVector_ImGuiWindowStackData_back(&g.CurrentWindowStack);
    window_stack_data.Window = window;
    window_stack_data.ParentLastItemDataBackup = g.LastItemData;
    window_stack_data.DisabledOverrideReenable = flags & ImGuiWindowFlags_Tooltip && g.CurrentItemFlags & ImGuiItemFlags_Disabled;
    window_stack_data.DisabledOverrideReenableAlphaBackup = 0.0f;
    ImGui_ErrorRecoveryStoreState(&window_stack_data.StackSizesInBegin);
    g.StackSizesInBeginForCurrentWindow = &window_stack_data.StackSizesInBegin;
    if (flags & ImGuiWindowFlags_ChildMenu) != 0 {
        g.BeginMenuDepth++;
    }
    if first_begin_of_the_frame != 0 {
        ImGui_UpdateWindowParentAndRootLinks(window, flags, parent_window);
        window.ParentWindowInBeginStack = parent_window_in_stack;
        window.ParentWindowForFocusRoute = window.RootWindow != window ? parent_window_in_stack : null;
        if window.ParentWindowForFocusRoute == null && window.DockNode != null {
            if (window.DockNode.MergedFlags & ImGuiDockNodeFlags_DockedWindowsInFocusRoute) != 0 {
                window.ParentWindowForFocusRoute = window.DockNode.HostWindow;
            }
        }
        if window.WindowClass.FocusRouteParentWindowId != 0 {
            window.ParentWindowForFocusRoute = ImGui_FindWindowByID(window.WindowClass.FocusRouteParentWindowId);
            assert(window.ParentWindowForFocusRoute != null);
        }
        window.FontWindowScaleParents = parent_window != null ? parent_window.FontWindowScaleParents * parent_window.FontWindowScale : 1.0f;
    }
    ImGui_PushFocusScope((window.ChildFlags & ImGuiChildFlags_NavFlattened) != 0 ? g.CurrentFocusScopeId : window.ID);
    window.NavRootFocusScopeId = g.CurrentFocusScopeId;
    if (flags & ImGuiWindowFlags_Popup) != 0 {
        ImGuiPopupData* popup_ref = &g.OpenPopupStack.Data[g.BeginPopupStack.Size];
        popup_ref.Window = window;
        popup_ref.ParentNavLayer = parent_window_in_stack.DC.NavLayerCurrent;
        ImVector_ImGuiPopupData_push_back(&g.BeginPopupStack, *popup_ref);
        window.PopupId = popup_ref.PopupId;
    }
    bool window_pos_set_by_api = false;
    bool window_size_x_set_by_api = false;
    bool window_size_y_set_by_api = false;
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasPos) != 0 {
        window_pos_set_by_api = (window.SetWindowPosAllowFlags & g.NextWindowData.PosCond) != 0;
        if window_pos_set_by_api && ImLengthSqr(g.NextWindowData.PosPivotVal) > 1.0e-5f {
            window.SetWindowPosVal = g.NextWindowData.PosVal;
            window.SetWindowPosPivot = g.NextWindowData.PosPivotVal;
            window.SetWindowPosAllowFlags &= ~(ImGuiCond_Once | ImGuiCond_FirstUseEver | ImGuiCond_Appearing);
        } else {
            ImGui_SetWindowPos(window, g.NextWindowData.PosVal, g.NextWindowData.PosCond);
        }
    }
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasSize) != 0 {
        window_size_x_set_by_api = (window.SetWindowSizeAllowFlags & g.NextWindowData.SizeCond) != 0 && g.NextWindowData.SizeVal.x > 0.0f;
        window_size_y_set_by_api = (window.SetWindowSizeAllowFlags & g.NextWindowData.SizeCond) != 0 && g.NextWindowData.SizeVal.y > 0.0f;
        if window.ChildFlags & ImGuiChildFlags_ResizeX && (window.SetWindowSizeAllowFlags & ImGuiCond_FirstUseEver) == 0 {
            g.NextWindowData.SizeVal.x = window.SizeFull.x;
        }
        if window.ChildFlags & ImGuiChildFlags_ResizeY && (window.SetWindowSizeAllowFlags & ImGuiCond_FirstUseEver) == 0 {
            g.NextWindowData.SizeVal.y = window.SizeFull.y;
        }
        ImGui_SetWindowSize(window, g.NextWindowData.SizeVal, g.NextWindowData.SizeCond);
    }
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasScroll) != 0 {
        if g.NextWindowData.ScrollVal.x >= 0.0f {
            window.ScrollTarget.x = g.NextWindowData.ScrollVal.x;
            window.ScrollTargetCenterRatio.x = 0.0f;
        }
        if g.NextWindowData.ScrollVal.y >= 0.0f {
            window.ScrollTarget.y = g.NextWindowData.ScrollVal.y;
            window.ScrollTargetCenterRatio.y = 0.0f;
        }
    }
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasContentSize) != 0 {
        window.ContentSizeExplicit = g.NextWindowData.ContentSizeVal;
    } else if first_begin_of_the_frame != 0 {
        window.ContentSizeExplicit = ImVec2{0.0f, 0.0f};
    }
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasWindowClass) != 0 {
        window.WindowClass = g.NextWindowData.WindowClass;
    }
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasCollapsed) != 0 {
        ImGui_SetWindowCollapsed(window, g.NextWindowData.CollapsedVal, g.NextWindowData.CollapsedCond);
    }
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasFocus) != 0 {
        ImGui_FocusWindow(window);
    }
    if window.Appearing != 0 {
        SetWindowConditionAllowFlags(window, ImGuiCond_Appearing, false);
    }
    ImGui_UpdateWindowSkipRefresh(window);
    if window_stack_data.DisabledOverrideReenable && window.RootWindow == window {
        ImGui_BeginDisabledOverrideReenable();
    }
    g.CurrentWindow = null;
    if first_begin_of_the_frame && !window.SkipRefresh {
        bool window_is_child_tooltip = flags & ImGuiWindowFlags_ChildWindow && flags & ImGuiWindowFlags_Tooltip;
        bool window_just_appearing_after_hidden_for_resize = window.HiddenFramesCannotSkipItems > 0;
        window.Active = true;
        window.HasCloseButton = p_open != null;
        window.ClipRect = ImRect{ImVec2{-FLT_MAX, -FLT_MAX}, ImVec2{FLT_MAX, FLT_MAX}};
        ImVector_ImGuiID_resize(&window.IDStack, 1);
        ImDrawList__ResetForNewFrame(window.DrawList);
        window.DC.CurrentTableIdx = -1;
        if (flags & ImGuiWindowFlags_DockNodeHost) != 0 {
            ImDrawList_ChannelsSplit(window.DrawList, 2);
            ImDrawList_ChannelsSetCurrent(window.DrawList, 1);
        }
        if window.MemoryCompacted != 0 {
            ImGui_GcAwakeTransientWindowBuffers(window);
        }
        bool window_title_visible_elsewhere = false;
        if window.Viewport && window.Viewport.Window == window || window.DockIsActive {
            window_title_visible_elsewhere = true;
        } else if g.NavWindowingListWindow != null && g.NavWindowingListWindow.WasActive && (flags & ImGuiWindowFlags_NoNavFocus) == 0 {
            window_title_visible_elsewhere = true;
        } else if (flags & ImGuiWindowFlags_ChildMenu) != 0 {
            window_title_visible_elsewhere = true;
        }
        if (window_title_visible_elsewhere || window_just_activated_by_user) && !window_just_created && strcmp(name, window.Name) != 0 {
            var buf_len = cast(u64, window.NameBufLen);
            window.Name = ImStrdupcpy(window.Name, &buf_len, name);
            window.NameBufLen = cast(i32, buf_len);
        }
        CalcWindowContentSizes(window, &window.ContentSize, &window.ContentSizeIdeal);
        if window.HiddenFramesCanSkipItems > 0 {
            window.HiddenFramesCanSkipItems--;
        }
        if window.HiddenFramesCannotSkipItems > 0 {
            window.HiddenFramesCannotSkipItems--;
        }
        if window.HiddenFramesForRenderOnly > 0 {
            window.HiddenFramesForRenderOnly--;
        }
        if window_just_created && (!window_size_x_set_by_api || !window_size_y_set_by_api) {
            window.HiddenFramesCannotSkipItems = 1;
        }
        if window_just_activated_by_user && (flags & (ImGuiWindowFlags_Popup | ImGuiWindowFlags_Tooltip)) != 0 {
            window.HiddenFramesCannotSkipItems = 1;
            if (flags & ImGuiWindowFlags_AlwaysAutoResize) != 0 {
                if window_size_x_set_by_api == 0 {
                    window.SizeFull.x = 0.0f;
                    window.Size.x = window.SizeFull.x;
                }
                if window_size_y_set_by_api == 0 {
                    window.SizeFull.y = 0.0f;
                    window.Size.y = window.SizeFull.y;
                }
                window.ContentSizeIdeal = ImVec2{0.0f, 0.0f};
                window.ContentSize = window.ContentSizeIdeal;
            }
        }
        ImGui_WindowSelectViewport(window);
        ImGui_SetCurrentViewport(window, window.Viewport);
        SetCurrentWindow(window);
        flags = window.Flags;
        if !window.DockIsActive && flags & ImGuiWindowFlags_ChildWindow {
            window.WindowBorderSize = style.ChildBorderSize;
        } else {
            window.WindowBorderSize = flags & (ImGuiWindowFlags_Popup | ImGuiWindowFlags_Tooltip) && !(flags & ImGuiWindowFlags_Modal) ? style.PopupBorderSize : style.WindowBorderSize;
        }
        window.WindowPadding = style.WindowPadding;
        if !window.DockIsActive && flags & ImGuiWindowFlags_ChildWindow && !(flags & ImGuiWindowFlags_Popup) && !(window.ChildFlags & ImGuiChildFlags_AlwaysUseWindowPadding) && window.WindowBorderSize == 0.0f {
            window.WindowPadding = ImVec2{
                0.0f, (flags & ImGuiWindowFlags_MenuBar) != 0 ? style.WindowPadding.y : 0.0f,
            };
        }
        window.DC.MenuBarOffset.x = ImMax(ImMax(window.WindowPadding.x, style.ItemSpacing.x), g.NextWindowData.MenuBarOffsetMinVal.x);
        window.DC.MenuBarOffset.y = g.NextWindowData.MenuBarOffsetMinVal.y;
        window.TitleBarHeight = (flags & ImGuiWindowFlags_NoTitleBar) != 0 ? 0.0f : g.FontSize + g.Style.FramePadding.y * 2.0f;
        window.MenuBarHeight = (flags & ImGuiWindowFlags_MenuBar) != 0 ? window.DC.MenuBarOffset.y + g.FontSize + g.Style.FramePadding.y * 2.0f : 0.0f;
        window.FontRefSize = g.FontSize;
        bool use_current_size_for_scrollbar_x = window_just_created;
        bool use_current_size_for_scrollbar_y = window_just_created;
        if window_size_x_set_by_api && window.ContentSizeExplicit.x != 0.0f {
            use_current_size_for_scrollbar_x = true;
        }
        if window_size_y_set_by_api && window.ContentSizeExplicit.y != 0.0f {
            use_current_size_for_scrollbar_y = true;
        }
        if !(flags & ImGuiWindowFlags_NoTitleBar) && !(flags & ImGuiWindowFlags_NoCollapse) && !window.DockIsActive {
            ImRect title_bar_rect = ImGuiWindow_TitleBarRect(window);
            if g.HoveredWindow == window && g.HoveredId == 0 && g.HoveredIdPreviousFrame == 0 && g.ActiveId == 0 && ImGui_IsMouseHoveringRect(title_bar_rect.Min, title_bar_rect.Max) {
                if g.IO.MouseClickedCount[0] == 2 && ImGui_GetKeyOwner(ImGuiKey_MouseLeft) == cast(ImGuiID, -1) {
                    window.WantCollapseToggle = true;
                    ImGui_SetKeyOwner(ImGuiKey_MouseLeft, window.MoveId);
                }
            }
            if window.WantCollapseToggle != 0 {
                window.Collapsed = !window.Collapsed;
                if window.Collapsed == 0 {
                    use_current_size_for_scrollbar_y = true;
                }
                ImGui_MarkIniSettingsDirty(window);
            }
        } else {
            window.Collapsed = false;
        }
        window.WantCollapseToggle = false;
        ImVec2 scrollbar_sizes_from_last_frame = window.ScrollbarSizes;
        window.DecoOuterSizeX1 = 0.0f;
        window.DecoOuterSizeX2 = 0.0f;
        window.DecoOuterSizeY1 = window.TitleBarHeight + window.MenuBarHeight;
        window.DecoOuterSizeY2 = 0.0f;
        window.ScrollbarSizes = ImVec2{0.0f, 0.0f};
        {
            bool size_auto_fit_x_always = !window_size_x_set_by_api && flags & ImGuiWindowFlags_AlwaysAutoResize && !window.Collapsed;
            bool size_auto_fit_y_always = !window_size_y_set_by_api && flags & ImGuiWindowFlags_AlwaysAutoResize && !window.Collapsed;
            bool size_auto_fit_x_current = !window_size_x_set_by_api && window.AutoFitFramesX > 0;
            bool size_auto_fit_y_current = !window_size_y_set_by_api && window.AutoFitFramesY > 0;
            i32 size_auto_fit_mask = 0;
            if size_auto_fit_x_always || size_auto_fit_x_current {
                size_auto_fit_mask |= 1 << ImGuiAxis_X;
            }
            if size_auto_fit_y_always || size_auto_fit_y_current {
                size_auto_fit_mask |= 1 << ImGuiAxis_Y;
            }
            ImVec2 size_auto_fit = CalcWindowAutoFitSize(window, window.ContentSizeIdeal, size_auto_fit_mask);
            ImVec2 old_size = window.SizeFull;
            if size_auto_fit_x_always || size_auto_fit_x_current {
                if size_auto_fit_x_always != 0 {
                    window.SizeFull.x = size_auto_fit.x;
                } else {
                    window.SizeFull.x = window.AutoFitOnlyGrows != 0 ? ImMax(window.SizeFull.x, size_auto_fit.x) : size_auto_fit.x;
                }
                use_current_size_for_scrollbar_x = true;
            }
            if size_auto_fit_y_always || size_auto_fit_y_current {
                if size_auto_fit_y_always != 0 {
                    window.SizeFull.y = size_auto_fit.y;
                } else {
                    window.SizeFull.y = window.AutoFitOnlyGrows != 0 ? ImMax(window.SizeFull.y, size_auto_fit.y) : size_auto_fit.y;
                }
                use_current_size_for_scrollbar_y = true;
            }
            if old_size.x != window.SizeFull.x || old_size.y != window.SizeFull.y {
                ImGui_MarkIniSettingsDirty(window);
            }
        }
        window.SizeFull = CalcWindowSizeAfterConstraint(window, window.SizeFull);
        window.Size = window.Collapsed && !(flags & ImGuiWindowFlags_ChildWindow) ? ImRect_GetSize(&ImGuiWindow_TitleBarRect(window)) : window.SizeFull;
        if window_just_activated_by_user != 0 {
            window.AutoPosLastDirection = ImGuiDir_None;
            if (flags & ImGuiWindowFlags_Popup) != 0 && !(flags & ImGuiWindowFlags_Modal) && !window_pos_set_by_api {
                window.Pos = ImVector_ImGuiPopupData_back(&g.BeginPopupStack).OpenPopupPos;
            }
        }
        if (flags & ImGuiWindowFlags_ChildWindow) != 0 {
            assert(parent_window && parent_window.Active);
            window.BeginOrderWithinParent = cast(i16, parent_window.DC.ChildWindows.Size);
            ImVector_ImGuiWindow_ptr_push_back(&parent_window.DC.ChildWindows, window);
            if !(flags & ImGuiWindowFlags_Popup) && !window_pos_set_by_api && !window_is_child_tooltip {
                window.Pos = parent_window.DC.CursorPos;
            }
        }
        bool window_pos_with_pivot = window.SetWindowPosVal.x != FLT_MAX && window.HiddenFramesCannotSkipItems == 0;
        if window_pos_with_pivot != 0 {
            ImGui_SetWindowPos(window, op_sub_ImVec2_ImVec2(window.SetWindowPosVal, op_mul_ImVec2_ImVec2(window.Size, window.SetWindowPosPivot)), 0);
        } else if (flags & ImGuiWindowFlags_ChildMenu) != 0 {
            window.Pos = ImGui_FindBestWindowPosForPopup(window);
        } else if (flags & ImGuiWindowFlags_Popup) != 0 && !window_pos_set_by_api && window_just_appearing_after_hidden_for_resize {
            window.Pos = ImGui_FindBestWindowPosForPopup(window);
        } else if (flags & ImGuiWindowFlags_Tooltip) != 0 && !window_pos_set_by_api && !window_is_child_tooltip {
            window.Pos = ImGui_FindBestWindowPosForPopup(window);
        }
        if window.ViewportAllowPlatformMonitorExtend >= 0 && !window.ViewportOwned && !(window.Viewport.Flags & ImGuiViewportFlags_IsMinimized) {
            if ImRect_Contains(&ImGuiViewportP_GetMainRect(window.Viewport), ImGuiWindow_Rect(window)) == 0 {
                window.Viewport = ImGui_AddUpdateViewport(window, window.ID, window.Pos, window.Size, ImGuiViewportFlags_NoFocusOnAppearing);
                ImGui_SetCurrentViewport(window, window.Viewport);
                SetCurrentWindow(window);
            }
        }
        if window.ViewportOwned != 0 {
            ImGui_WindowSyncOwnedViewport(window, parent_window_in_stack);
        }
        ImRect viewport_rect;
        viewport_rect = ImGuiViewportP_GetMainRect(window.Viewport);
        ImRect viewport_work_rect;
        viewport_work_rect = ImGuiViewportP_GetWorkRect(window.Viewport);
        ImVec2 visibility_padding = ImMax(style.DisplayWindowPadding, style.DisplaySafeAreaPadding);
        ImRect visibility_rect;
        ImRect_init(&visibility_rect, op_add_ImVec2_ImVec2(viewport_work_rect.Min, visibility_padding), op_sub_ImVec2_ImVec2(viewport_work_rect.Max, visibility_padding));
        if !window_pos_set_by_api && !(flags & ImGuiWindowFlags_ChildWindow) {
            if !window.ViewportOwned && ImRect_GetWidth(&viewport_rect) > 0.0f && ImRect_GetHeight(&viewport_rect) > 0.0f {
                ClampWindowPos(window, visibility_rect);
            } else if window.ViewportOwned && g.PlatformIO.Monitors.Size > 0 {
                if g.MovingWindow != null && window.RootWindowDockTree == g.MovingWindow.RootWindowDockTree {
                    visibility_rect = g.PlatformMonitorsFullWorkRect;
                } else {
                    ImGuiPlatformMonitor* monitor = ImGui_GetViewportPlatformMonitor(cast(ImGuiViewport*, window.Viewport));
                    visibility_rect = ImRect{
                        monitor.WorkPos, op_add_ImVec2_ImVec2(monitor.WorkPos, monitor.WorkSize),
                    };
                }
                ImRect_Expand(&visibility_rect, op_sub_ImVec2(visibility_padding));
                ClampWindowPos(window, visibility_rect);
            }
        }
        window.Pos = ImTrunc(window.Pos);
        if flags & ImGuiWindowFlags_ChildWindow && !window.DockIsActive {
            window.WindowRounding = style.ChildRounding;
        } else if window.RootWindowDockTree.ViewportOwned != 0 {
            window.WindowRounding = 0.0f;
        } else {
            window.WindowRounding = flags & ImGuiWindowFlags_Popup && !(flags & ImGuiWindowFlags_Modal) ? style.PopupRounding : style.WindowRounding;
        }
        bool want_focus = false;
        if window_just_activated_by_user && !(flags & ImGuiWindowFlags_NoFocusOnAppearing) {
            if (flags & ImGuiWindowFlags_Popup) != 0 {
                want_focus = true;
            } else if (window.DockIsActive || (flags & ImGuiWindowFlags_ChildWindow) == 0) && !(flags & ImGuiWindowFlags_Tooltip) {
                want_focus = true;
            }
        }
        when defined(IMGUI_ENABLE_TEST_ENGINE) {
            if g.TestEngineHookItems != 0 {
                assert(window.IDStack.Size == 1);
                window.IDStack.Size = 0;
                window.DC.NavLayerCurrent = ImGuiNavLayer_Menu;
                ignore *g;
                window.IDStack.Size = 1;
                window.DC.NavLayerCurrent = ImGuiNavLayer_Main;
            }
        }
        bool handle_borders_and_resize_grips = window.DockNodeAsHost || !window.DockIsActive;
        if flags & ImGuiWindowFlags_ChildWindow && window.ParentWindow.SkipItems {
            handle_borders_and_resize_grips = false;
        }
        i32 border_hovered = -1;
        i32 border_held = -1;
        ImU32[4] resize_grip_col;
        i32 resize_grip_count;
        if flags & ImGuiWindowFlags_ChildWindow && !(flags & ImGuiWindowFlags_Popup) {
            resize_grip_count = window.ChildFlags & ImGuiChildFlags_ResizeX && window.ChildFlags & ImGuiChildFlags_ResizeY ? 1 : 0;
        } else {
            resize_grip_count = g.IO.ConfigWindowsResizeFromEdges != 0 ? 2 : 1;
        }
        var resize_grip_draw_size = cast(f32, cast(i32, ImMax(g.FontSize * 1.1f, window.WindowRounding + 1.0f + g.FontSize * 0.2f)));
        if handle_borders_and_resize_grips && !window.Collapsed {
            i32 auto_fit_mask = ImGui_UpdateWindowManualResize(window, &border_hovered, &border_held, resize_grip_count, &resize_grip_col[0], visibility_rect);
            if auto_fit_mask != 0 {
                if (auto_fit_mask & 1 << ImGuiAxis_X) != 0 {
                    use_current_size_for_scrollbar_x = true;
                }
                if (auto_fit_mask & 1 << ImGuiAxis_Y) != 0 {
                    use_current_size_for_scrollbar_y = true;
                }
            }
        }
        window.ResizeBorderHovered = cast(i8, border_hovered);
        window.ResizeBorderHeld = cast(i8, border_held);
        if window.ViewportOwned != 0 {
            if window.Viewport.PlatformRequestMove == 0 {
                window.Viewport.Pos = window.Pos;
            }
            if window.Viewport.PlatformRequestResize == 0 {
                window.Viewport.Size = window.Size;
            }
            ImGuiViewportP_UpdateWorkRect(window.Viewport);
            viewport_rect = ImGuiViewportP_GetMainRect(window.Viewport);
        }
        window.ViewportPos = window.Viewport.Pos;
        if window.Collapsed == 0 {
            var avail_size_from_current_frame = ImVec2{
                window.SizeFull.x,
                window.SizeFull.y - (window.DecoOuterSizeY1 + window.DecoOuterSizeY2),
            };
            ImVec2 avail_size_from_last_frame = op_add_ImVec2_ImVec2(ImRect_GetSize(&window.InnerRect), scrollbar_sizes_from_last_frame);
            ImVec2 needed_size_from_last_frame = window_just_created != 0 ? ImVec2{0.0f, 0.0f} : op_add_ImVec2_ImVec2(window.ContentSize, op_mul_ImVec2_float(window.WindowPadding, 2.0f));
            f32 size_for_scrollbars_x = use_current_size_for_scrollbar_x != 0 ? avail_size_from_current_frame.x : avail_size_from_last_frame.x;
            f32 size_for_scrollbars_y = use_current_size_for_scrollbar_y != 0 ? avail_size_from_current_frame.y : avail_size_from_last_frame.y;
            bool scrollbar_x_prev = window.ScrollbarX;
            window.ScrollbarY = flags & ImGuiWindowFlags_AlwaysVerticalScrollbar || needed_size_from_last_frame.y > size_for_scrollbars_y && !(flags & ImGuiWindowFlags_NoScrollbar);
            window.ScrollbarX = flags & ImGuiWindowFlags_AlwaysHorizontalScrollbar || needed_size_from_last_frame.x > size_for_scrollbars_x - (window.ScrollbarY != 0 ? style.ScrollbarSize : 0.0f) && !(flags & ImGuiWindowFlags_NoScrollbar) && flags & ImGuiWindowFlags_HorizontalScrollbar;
            window.ScrollbarXStabilizeToggledHistory <<= 1;
            window.ScrollbarXStabilizeToggledHistory |= cast(ImU8, scrollbar_x_prev != window.ScrollbarX ? 0x01 : 0x00);
            bool scrollbar_x_stabilize = window.ScrollbarXStabilizeToggledHistory != 0 && ImCountSetBits(window.ScrollbarXStabilizeToggledHistory) >= 4;
            if scrollbar_x_stabilize != 0 {
                window.ScrollbarX = true;
            }
            window.ScrollbarXStabilizeEnabled = scrollbar_x_stabilize;
            if window.ScrollbarX && !window.ScrollbarY {
                window.ScrollbarY = needed_size_from_last_frame.y > size_for_scrollbars_y - style.ScrollbarSize && !(flags & ImGuiWindowFlags_NoScrollbar);
            }
            window.ScrollbarSizes = ImVec2{
                window.ScrollbarY != 0 ? style.ScrollbarSize : 0.0f,
                window.ScrollbarX != 0 ? style.ScrollbarSize : 0.0f,
            };
            window.DecoOuterSizeX2 += window.ScrollbarSizes.x;
            window.DecoOuterSizeY2 += window.ScrollbarSizes.y;
        }
        ImRect host_rect = flags & ImGuiWindowFlags_ChildWindow && !(flags & ImGuiWindowFlags_Popup) && !window_is_child_tooltip ? parent_window.ClipRect : viewport_rect;
        ImRect outer_rect = ImGuiWindow_Rect(window);
        ImRect title_bar_rect = ImGuiWindow_TitleBarRect(window);
        window.OuterRectClipped = outer_rect;
        if window.DockIsActive != 0 {
            window.OuterRectClipped.Min.y += window.TitleBarHeight;
        }
        ImRect_ClipWith(&window.OuterRectClipped, host_rect);
        window.InnerRect.Min.x = window.Pos.x + window.DecoOuterSizeX1;
        window.InnerRect.Min.y = window.Pos.y + window.DecoOuterSizeY1;
        window.InnerRect.Max.x = window.Pos.x + window.Size.x - window.DecoOuterSizeX2;
        window.InnerRect.Max.y = window.Pos.y + window.Size.y - window.DecoOuterSizeY2;
        f32 top_border_size = flags & ImGuiWindowFlags_MenuBar || !(flags & ImGuiWindowFlags_NoTitleBar) ? style.FrameBorderSize : window.WindowBorderSize;
        window.InnerClipRect.Min.x = ImFloor(0.5f + window.InnerRect.Min.x + window.WindowBorderSize * 0.5f);
        window.InnerClipRect.Min.y = ImFloor(0.5f + window.InnerRect.Min.y + top_border_size * 0.5f);
        window.InnerClipRect.Max.x = ImFloor(window.InnerRect.Max.x - window.WindowBorderSize * 0.5f);
        window.InnerClipRect.Max.y = ImFloor(window.InnerRect.Max.y - window.WindowBorderSize * 0.5f);
        ImRect_ClipWithFull(&window.InnerClipRect, host_rect);
        window.ScrollMax.x = ImMax(0.0f, window.ContentSize.x + window.WindowPadding.x * 2.0f - ImRect_GetWidth(&window.InnerRect));
        window.ScrollMax.y = ImMax(0.0f, window.ContentSize.y + window.WindowPadding.y * 2.0f - ImRect_GetHeight(&window.InnerRect));
        window.Scroll = CalcNextScrollFromScrollTargetAndClamp(window);
        window.ScrollTarget = ImVec2{FLT_MAX, FLT_MAX};
        window.DecoInnerSizeY1 = 0.0f;
        window.DecoInnerSizeX1 = window.DecoInnerSizeY1;
        assert(window.DrawList.CmdBuffer.Size == 1 && window.DrawList.CmdBuffer.Data[0].ElemCount == 0);
        ImDrawList_PushTexture(window.DrawList, g.Font.OwnerAtlas.TexRef);
        ImGui_PushClipRect(host_rect.Min, host_rect.Max, false);
        bool is_undocked_or_docked_visible = !window.DockIsActive || window.DockTabIsVisible;
        if is_undocked_or_docked_visible != 0 {
            bool render_decorations_in_parent = false;
            if flags & ImGuiWindowFlags_ChildWindow && !(flags & ImGuiWindowFlags_Popup) && !window_is_child_tooltip {
                ImGuiWindow* previous_child = parent_window.DC.ChildWindows.Size >= 2 ? parent_window.DC.ChildWindows.Data[parent_window.DC.ChildWindows.Size - 2] : null;
                bool previous_child_overlapping = previous_child != null ? ImRect_Overlaps(&ImGuiWindow_Rect(previous_child), ImGuiWindow_Rect(window)) : false;
                bool parent_is_empty = parent_window.DrawList.VtxBuffer.Size == 0;
                if ImVector_ImDrawCmd_back(&window.DrawList.CmdBuffer).ElemCount == 0 && !parent_is_empty && !previous_child_overlapping {
                    render_decorations_in_parent = true;
                }
            }
            if render_decorations_in_parent != 0 {
                window.DrawList = parent_window.DrawList;
            }
            ImGuiWindow* window_to_highlight = g.NavWindowingTarget != null ? g.NavWindowingTarget : g.NavWindow;
            bool title_bar_is_highlight = want_focus || window_to_highlight && (window.RootWindowForTitleBarHighlight == window_to_highlight.RootWindowForTitleBarHighlight || window.DockNode && window.DockNode == window_to_highlight.DockNode);
            ImGui_RenderWindowDecorations(window, title_bar_rect, title_bar_is_highlight, handle_borders_and_resize_grips, resize_grip_count, resize_grip_col, resize_grip_draw_size);
            if render_decorations_in_parent != 0 {
                window.DrawList = &window.DrawListInst;
            }
        }
        bool allow_scrollbar_x = !(flags & ImGuiWindowFlags_NoScrollbar) && flags & ImGuiWindowFlags_HorizontalScrollbar;
        bool allow_scrollbar_y = !(flags & ImGuiWindowFlags_NoScrollbar);
        f32 work_rect_size_x = window.ContentSizeExplicit.x != 0.0f ? window.ContentSizeExplicit.x : ImMax(allow_scrollbar_x != 0 ? window.ContentSize.x : 0.0f, window.Size.x - window.WindowPadding.x * 2.0f - (window.DecoOuterSizeX1 + window.DecoOuterSizeX2));
        f32 work_rect_size_y = window.ContentSizeExplicit.y != 0.0f ? window.ContentSizeExplicit.y : ImMax(allow_scrollbar_y != 0 ? window.ContentSize.y : 0.0f, window.Size.y - window.WindowPadding.y * 2.0f - (window.DecoOuterSizeY1 + window.DecoOuterSizeY2));
        window.WorkRect.Min.x = ImTrunc(window.InnerRect.Min.x - window.Scroll.x + ImMax(window.WindowPadding.x, window.WindowBorderSize));
        window.WorkRect.Min.y = ImTrunc(window.InnerRect.Min.y - window.Scroll.y + ImMax(window.WindowPadding.y, window.WindowBorderSize));
        window.WorkRect.Max.x = window.WorkRect.Min.x + work_rect_size_x;
        window.WorkRect.Max.y = window.WorkRect.Min.y + work_rect_size_y;
        window.ParentWorkRect = window.WorkRect;
        window.ContentRegionRect.Min.x = window.Pos.x - window.Scroll.x + window.WindowPadding.x + window.DecoOuterSizeX1;
        window.ContentRegionRect.Min.y = window.Pos.y - window.Scroll.y + window.WindowPadding.y + window.DecoOuterSizeY1;
        window.ContentRegionRect.Max.x = window.ContentRegionRect.Min.x + (window.ContentSizeExplicit.x != 0.0f ? window.ContentSizeExplicit.x : window.Size.x - window.WindowPadding.x * 2.0f - (window.DecoOuterSizeX1 + window.DecoOuterSizeX2));
        window.ContentRegionRect.Max.y = window.ContentRegionRect.Min.y + (window.ContentSizeExplicit.y != 0.0f ? window.ContentSizeExplicit.y : window.Size.y - window.WindowPadding.y * 2.0f - (window.DecoOuterSizeY1 + window.DecoOuterSizeY2));
        window.DC.Indent.x = window.DecoOuterSizeX1 + window.WindowPadding.x - window.Scroll.x;
        window.DC.GroupOffset.x = 0.0f;
        window.DC.ColumnsOffset.x = 0.0f;
        f64 start_pos_highp_x = cast(f64, window.Pos.x) + cast(f64, window.WindowPadding.x) - cast(f64, window.Scroll.x) + cast(f64, window.DecoOuterSizeX1) + cast(f64, window.DC.ColumnsOffset.x);
        f64 start_pos_highp_y = cast(f64, window.Pos.y) + cast(f64, window.WindowPadding.y) - cast(f64, window.Scroll.y) + cast(f64, window.DecoOuterSizeY1);
        window.DC.CursorStartPos = ImVec2{
            cast(f32, start_pos_highp_x), cast(f32, start_pos_highp_y),
        };
        window.DC.CursorStartPosLossyness = ImVec2{
            cast(f32, start_pos_highp_x - cast(f64, window.DC.CursorStartPos.x)),
            cast(f32, start_pos_highp_y - cast(f64, window.DC.CursorStartPos.y)),
        };
        window.DC.CursorPos = window.DC.CursorStartPos;
        window.DC.CursorPosPrevLine = window.DC.CursorPos;
        window.DC.CursorMaxPos = window.DC.CursorStartPos;
        window.DC.IdealMaxPos = window.DC.CursorStartPos;
        window.DC.PrevLineSize = ImVec2{0.0f, 0.0f};
        window.DC.CurrLineSize = window.DC.PrevLineSize;
        window.DC.PrevLineTextBaseOffset = 0.0f;
        window.DC.CurrLineTextBaseOffset = window.DC.PrevLineTextBaseOffset;
        window.DC.IsSetPos = false;
        window.DC.IsSameLine = window.DC.IsSetPos;
        window.DC.NavLayerCurrent = ImGuiNavLayer_Main;
        window.DC.NavLayersActiveMask = window.DC.NavLayersActiveMaskNext;
        window.DC.NavLayersActiveMaskNext = 0x00;
        window.DC.NavIsScrollPushableX = true;
        window.DC.NavHideHighlightOneFrame = false;
        window.DC.NavWindowHasScrollY = window.ScrollMax.y > 0.0f;
        window.DC.MenuBarAppending = false;
        ImGuiMenuColumns_Update(&window.DC.MenuColumns, style.ItemSpacing.x, window_just_activated_by_user);
        window.DC.TreeDepth = 0;
        window.DC.TreeRecordsClippedNodesY2Mask = 0x00;
        window.DC.TreeHasStackDataDepthMask = window.DC.TreeRecordsClippedNodesY2Mask;
        ImVector_ImGuiWindow_ptr_resize(&window.DC.ChildWindows, 0);
        window.DC.StateStorage = &window.StateStorage;
        window.DC.CurrentColumns = null;
        window.DC.LayoutType = ImGuiLayoutType_Vertical;
        window.DC.ParentLayoutType = parent_window != null ? parent_window.DC.LayoutType : ImGuiLayoutType_Vertical;
        bool is_resizable_width;
        if flags & ImGuiWindowFlags_ChildWindow && !window.DockIsActive {
            is_resizable_width = window.Size.x > 0.0f && !(window.ChildFlags & (ImGuiChildFlags_AutoResizeX | ImGuiChildFlags_AlwaysAutoResize));
        } else {
            is_resizable_width = window.Size.x > 0.0f && !(flags & ImGuiWindowFlags_AlwaysAutoResize);
        }
        if is_resizable_width != 0 {
            window.DC.ItemWidthDefault = ImTrunc(window.Size.x * 0.65f);
        } else {
            window.DC.ItemWidthDefault = ImTrunc(g.FontSize * 16.0f);
        }
        window.DC.ItemWidth = window.DC.ItemWidthDefault;
        ImVector_float_resize(&window.DC.ItemWidthStack, 0);
        window.DC.TextWrapPos = -1.0f;
        ImVector_float_resize(&window.DC.TextWrapPosStack, 0);
        if (flags & ImGuiWindowFlags_Modal) != 0 {
            window.DC.ModalDimBgColor = ImGui_ColorConvertFloat4ToU32(*ImGui_GetStyleColorVec4(ImGuiCol_ModalWindowDimBg));
        }
        if window.AutoFitFramesX > 0 {
            window.AutoFitFramesX--;
        }
        if window.AutoFitFramesY > 0 {
            window.AutoFitFramesY--;
        }
        ImGuiNextWindowData_ClearFlags(&g.NextWindowData);
        if want_focus != 0 {
            ImGui_FocusWindow(window, ImGuiFocusRequestFlags_UnlessBelowModal);
        }
        if want_focus && window == g.NavWindow {
            ImGui_NavInitWindow(window, false);
        }
        if p_open != null && window.Viewport.PlatformRequestClose && cast(ImGuiViewport*, window.Viewport) != ImGui_GetMainViewport() {
            if window.DockNode == null || (window.DockNode.MergedFlags & ImGuiDockNodeFlags_DockSpace) == 0 {
                while true {
                    if (g.DebugLogFlags & ImGuiDebugLogFlags_EventViewport) != 0 {
                    }
                    if !(0 != 0) { break; }
                }
                *p_open = false;
                g.NavWindowingToggleLayer = false;
            }
        }
        if g.IO.ConfigWindowsCopyContentsWithCtrlC != 0 {
            if g.NavWindow && g.NavWindow.RootWindow == window && g.ActiveId == 0 && ImGui_Shortcut(ImGuiMod_Ctrl | ImGuiKey_C) {
                ImGui_LogToClipboard(0);
            }
        }
        if !(flags & ImGuiWindowFlags_NoTitleBar) && !window.DockIsActive {
            ImGui_RenderWindowTitleBarContents(window, ImRect{
                ImVec2{title_bar_rect.Min.x + window.WindowBorderSize, title_bar_rect.Min.y},
                ImVec2{title_bar_rect.Max.x - window.WindowBorderSize, title_bar_rect.Max.y},
            }, name, p_open);
        } else if !(flags & ImGuiWindowFlags_NoTitleBar) && window.DockIsActive {
            ImGui_LogText("%.*s\n", cast(i32, cast(i64, ImGui_FindRenderedTextEnd(window.Name) - window.Name)), window.Name);
        }
        window.HitTestHoleSize.y = 0;
        window.HitTestHoleSize.x = window.HitTestHoleSize.y;
        if (flags & ImGuiWindowFlags_Tooltip) != 0 {
            g.TooltipPreviousWindow = window;
        }
        if (g.IO.ConfigFlags & ImGuiConfigFlags_DockingEnable) != 0 {
            if g.MovingWindow == window && (window.RootWindowDockTree.Flags & ImGuiWindowFlags_NoDocking) == 0 {
                ImGui_BeginDockableDragDropSource(window);
            }
            if g.DragDropActive && !(flags & ImGuiWindowFlags_NoDocking) {
                if g.MovingWindow == null || g.MovingWindow.RootWindowDockTree != window {
                    if window == window.RootWindowDockTree && !(window.Flags & ImGuiWindowFlags_DockNodeHost) {
                        ImGui_BeginDockableDragDropTarget(window);
                    }
                }
            }
        }
        window.BgClickFlags = (flags & ImGuiWindowFlags_ChildWindow) != 0 ? parent_window.BgClickFlags : g.IO.ConfigWindowsMoveFromTitleBarOnly != 0 ? ImGuiWindowBgClickFlags_None : ImGuiWindowBgClickFlags_Move;
        window.DC.WindowItemStatusFlags = ImGuiItemStatusFlags_None;
        window.DC.WindowItemStatusFlags |= ImGui_IsMouseHoveringRect(title_bar_rect.Min, title_bar_rect.Max, false) != 0 ? ImGuiItemStatusFlags_HoveredRect : 0;
        ImGui_SetLastItemDataForWindow(window, title_bar_rect);
        if g.DebugLocateId != 0 && (window.ID == g.DebugLocateId || window.MoveId == g.DebugLocateId) {
            ImGui_DebugLocateItemResolveWithLastItem();
        }
        when defined(IMGUI_ENABLE_TEST_ENGINE) {
            if (window.Flags & ImGuiWindowFlags_NoTitleBar) == 0 {
                window.DC.NavLayerCurrent = ImGuiNavLayer_Menu;
                window.DC.NavLayerCurrent = ImGuiNavLayer_Main;
            }
        }
    } else {
        if window.SkipRefresh != 0 {
            SetWindowActiveForSkipRefresh(window);
        }
        ImGui_SetCurrentViewport(window, window.Viewport);
        SetCurrentWindow(window);
        ImGuiNextWindowData_ClearFlags(&g.NextWindowData);
        ImGui_SetLastItemDataForWindow(window, ImGuiWindow_TitleBarRect(window));
    }
    if !(flags & ImGuiWindowFlags_DockNodeHost) && !window.SkipRefresh {
        ImGui_PushClipRect(window.InnerClipRect.Min, window.InnerClipRect.Max, true);
    }
    window.WriteAccessed = false;
    window.BeginCount++;
    if first_begin_of_the_frame && !window.SkipRefresh {
        if window.DockIsActive && !window.DockTabIsVisible {
            if window.LastFrameJustFocused == g.FrameCount {
                window.HiddenFramesCannotSkipItems = 1;
            } else {
                window.HiddenFramesCanSkipItems = 1;
            }
        }
        if flags & ImGuiWindowFlags_ChildWindow && !(flags & ImGuiWindowFlags_ChildMenu) {
            assert((flags & ImGuiWindowFlags_NoTitleBar) != 0 || window.DockIsActive);
            bool nav_request = window.ChildFlags & ImGuiChildFlags_NavFlattened && (g.NavAnyRequest && g.NavWindow && g.NavWindow.RootWindowForNav == window.RootWindowForNav);
            if !g.LogEnabled && !nav_request {
                if window.OuterRectClipped.Min.x >= window.OuterRectClipped.Max.x || window.OuterRectClipped.Min.y >= window.OuterRectClipped.Max.y {
                    if window.AutoFitFramesX > 0 || window.AutoFitFramesY > 0 {
                        window.HiddenFramesCannotSkipItems = 1;
                    } else {
                        window.HiddenFramesCanSkipItems = 1;
                    }
                }
            }
            if parent_window && (parent_window.Collapsed || parent_window.HiddenFramesCanSkipItems > 0) {
                window.HiddenFramesCanSkipItems = 1;
            }
            if parent_window && parent_window.HiddenFramesCannotSkipItems > 0 {
                window.HiddenFramesCannotSkipItems = 1;
            }
        }
        if style.Alpha <= 0.0f {
            window.HiddenFramesCanSkipItems = 1;
        }
        bool hidden_regular = window.HiddenFramesCanSkipItems > 0 || window.HiddenFramesCannotSkipItems > 0;
        window.Hidden = hidden_regular || window.HiddenFramesForRenderOnly > 0;
        if window.DisableInputsFrames > 0 {
            window.DisableInputsFrames--;
            window.Flags |= ImGuiWindowFlags_NoInputs;
        }
        bool skip_items = false;
        if window.Collapsed || !window.Active || hidden_regular {
            if window.AutoFitFramesX <= 0 && window.AutoFitFramesY <= 0 && window.HiddenFramesCannotSkipItems <= 0 {
                skip_items = true;
            }
        }
        window.SkipItems = skip_items;
        if window.SkipItems != 0 {
            window.DC.NavLayersActiveMaskNext = window.DC.NavLayersActiveMask;
        }
        if window.SkipItems && !window.Appearing {
            assert(window.Appearing == false);
        }
    } else if first_begin_of_the_frame != 0 {
        window.SkipItems = true;
    }
    when !(defined(IMGUI_DISABLE_DEBUG_TOOLS)) {
        if window.IsFallbackWindow == 0 {
            if g.IO.ConfigDebugBeginReturnValueOnce && window_just_created || g.IO.ConfigDebugBeginReturnValueLoop && g.DebugBeginReturnValueCullDepth == g.CurrentWindowStack.Size {
                if window.AutoFitFramesX > 0 {
                    window.AutoFitFramesX++;
                }
                if window.AutoFitFramesY > 0 {
                    window.AutoFitFramesY++;
                }
                return false;
            }
        }
    }
    return !window.SkipItems;
}

void ImGui_End() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    if g.CurrentWindowStack.Size <= 1 && g.WithinFrameScopeWithImplicitWindow {
        while true {
            if g.CurrentWindowStack.Size > 1 == 0 {
                if ImGui_ErrorLog("Calling End() too many times!") != 0 {
                    assert(g.CurrentWindowStack.Size > 1 && "Calling End() too many times!");
                }
            }
            if !(0 != 0) { break; }
        }
        return;
    }
    ImGuiWindowStackData* window_stack_data = ImVector_ImGuiWindowStackData_back(&g.CurrentWindowStack);
    if (window.Flags & ImGuiWindowFlags_Popup) != 0 {
        while true {
            if g.WithinEndPopupID == window.ID == 0 {
                if ImGui_ErrorLog("Must call EndPopup() and not End()!") != 0 {
                    assert(g.WithinEndPopupID == window.ID && "Must call EndPopup() and not End()!");
                }
            }
            if !(0 != 0) { break; }
        }
    }
    if window.Flags & ImGuiWindowFlags_ChildWindow && !(window.Flags & ImGuiWindowFlags_DockNodeHost) && !window.DockIsActive {
        while true {
            if g.WithinEndChildID == window.ID == 0 {
                if ImGui_ErrorLog("Must call EndChild() and not End()!") != 0 {
                    assert(g.WithinEndChildID == window.ID && "Must call EndChild() and not End()!");
                }
            }
            if !(0 != 0) { break; }
        }
    }
    if window.DC.CurrentColumns != null {
        ImGui_EndColumns();
    }
    if !(window.Flags & ImGuiWindowFlags_DockNodeHost) && !window.SkipRefresh {
        ImGui_PopClipRect();
    }
    ImGui_PopFocusScope();
    if window_stack_data.DisabledOverrideReenable && window.RootWindow == window {
        ImGui_EndDisabledOverrideReenable();
    }
    if window.SkipRefresh != 0 {
        assert(window.DrawList == null);
        window.DrawList = &window.DrawListInst;
    }
    if g.LogWindow == window {
        ImGui_LogFinish();
    }
    if window.DC.IsSetPos != 0 {
        ImGui_ErrorCheckUsingSetCursorPosToExtendParentBoundaries();
    }
    if window.DockNode && window.DockTabIsVisible {
        ImGuiWindow* host_window = window.DockNode.HostWindow;
        if host_window != null {
            host_window.DC.CursorMaxPos = op_sub_ImVec2_ImVec2(op_add_ImVec2_ImVec2(window.DC.CursorMaxPos, window.WindowPadding), host_window.WindowPadding);
        }
    }
    g.LastItemData = window_stack_data.ParentLastItemDataBackup;
    if (window.Flags & ImGuiWindowFlags_ChildMenu) != 0 {
        g.BeginMenuDepth--;
    }
    if (window.Flags & ImGuiWindowFlags_Popup) != 0 {
        ImVector_ImGuiPopupData_pop_back(&g.BeginPopupStack);
    }
    if g.IO.ConfigErrorRecovery != 0 {
        ImGui_ErrorRecoveryTryToRecoverWindowState(&window_stack_data.StackSizesInBegin);
    }
    ImVector_ImGuiWindowStackData_pop_back(&g.CurrentWindowStack);
    SetCurrentWindow(g.CurrentWindowStack.Size == 0 ? null : ImVector_ImGuiWindowStackData_back(&g.CurrentWindowStack).Window);
    if g.CurrentWindow != null {
        ImGui_SetCurrentViewport(g.CurrentWindow, g.CurrentWindow.Viewport);
    }
}

void ImGui_PushItemFlag(ImGuiItemFlags option, bool enabled) {
    ImGuiContext* g = GImGui;
    ImGuiItemFlags item_flags = g.CurrentItemFlags;
    assert(item_flags == *ImVector_ImGuiItemFlags_back(&g.ItemFlagsStack));
    if enabled != 0 {
        item_flags |= option;
    } else {
        item_flags &= ~option;
    }
    g.CurrentItemFlags = item_flags;
    ImVector_ImGuiItemFlags_push_back(&g.ItemFlagsStack, item_flags);
}

void ImGui_PopItemFlag() {
    ImGuiContext* g = GImGui;
    while true {
        if g.ItemFlagsStack.Size > 1 == 0 {
            if ImGui_ErrorLog("Calling PopItemFlag() too many times!") != 0 {
                assert(g.ItemFlagsStack.Size > 1 && "Calling PopItemFlag() too many times!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    ImVector_ImGuiItemFlags_pop_back(&g.ItemFlagsStack);
    g.CurrentItemFlags = *ImVector_ImGuiItemFlags_back(&g.ItemFlagsStack);
}

// BeginDisabled()/EndDisabled()
// - Those can be nested but it cannot be used to enable an already disabled section (a single BeginDisabled(true) in the stack is enough to keep everything disabled)
// - Visually this is currently altering alpha, but it is expected that in a future styling system this would work differently.
// - Feedback welcome at https://github.com/ocornut/imgui/issues/211
// - BeginDisabled(false)/EndDisabled() essentially does nothing but is provided to facilitate use of boolean expressions.
//   (as a micro-optimization: if you have tens of thousands of BeginDisabled(false)/EndDisabled() pairs, you might want to reformulate your code to avoid making those calls)
// - Note: mixing up BeginDisabled() and PushItemFlag(ImGuiItemFlags_Disabled) is currently NOT SUPPORTED.
void ImGui_BeginDisabled(bool disabled) {
    ImGuiContext* g = GImGui;
    bool was_disabled = (g.CurrentItemFlags & ImGuiItemFlags_Disabled) != 0;
    if !was_disabled && disabled {
        g.DisabledAlphaBackup = g.Style.Alpha;
        g.Style.Alpha *= g.Style.DisabledAlpha;
    }
    if was_disabled || disabled {
        g.CurrentItemFlags |= ImGuiItemFlags_Disabled;
    }
    ImVector_ImGuiItemFlags_push_back(&g.ItemFlagsStack, g.CurrentItemFlags);
    g.DisabledStackSize++;
}

void ImGui_EndDisabled() {
    ImGuiContext* g = GImGui;
    while true {
        if g.DisabledStackSize > 0 == 0 {
            if ImGui_ErrorLog("Calling EndDisabled() too many times!") != 0 {
                assert(g.DisabledStackSize > 0 && "Calling EndDisabled() too many times!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    g.DisabledStackSize--;
    bool was_disabled = (g.CurrentItemFlags & ImGuiItemFlags_Disabled) != 0;
    ImVector_ImGuiItemFlags_pop_back(&g.ItemFlagsStack);
    g.CurrentItemFlags = *ImVector_ImGuiItemFlags_back(&g.ItemFlagsStack);
    if was_disabled && (g.CurrentItemFlags & ImGuiItemFlags_Disabled) == 0 {
        g.Style.Alpha = g.DisabledAlphaBackup;
    }
}

// Could have been called BeginDisabledDisable() but it didn't want to be award nominated for most awkward function name.
// Ideally we would use a shared e.g. BeginDisabled()->BeginDisabledEx() but earlier needs to be optimal.
// The whole code for this is awkward, will reevaluate if we find a way to implement SetNextItemDisabled().
void ImGui_BeginDisabledOverrideReenable() {
    ImGuiContext* g = GImGui;
    assert(g.CurrentItemFlags & ImGuiItemFlags_Disabled);
    ImVector_ImGuiWindowStackData_back(&g.CurrentWindowStack).DisabledOverrideReenableAlphaBackup = g.Style.Alpha;
    g.Style.Alpha = g.DisabledAlphaBackup;
    g.CurrentItemFlags &= ~ImGuiItemFlags_Disabled;
    ImVector_ImGuiItemFlags_push_back(&g.ItemFlagsStack, g.CurrentItemFlags);
    g.DisabledStackSize++;
}

void ImGui_EndDisabledOverrideReenable() {
    ImGuiContext* g = GImGui;
    assert(g.DisabledStackSize > 0);
    g.DisabledStackSize--;
    ImVector_ImGuiItemFlags_pop_back(&g.ItemFlagsStack);
    g.CurrentItemFlags = *ImVector_ImGuiItemFlags_back(&g.ItemFlagsStack);
    g.Style.Alpha = ImVector_ImGuiWindowStackData_back(&g.CurrentWindowStack).DisabledOverrideReenableAlphaBackup;
}

// ATTENTION THIS IS IN LEGACY LOCAL SPACE.
void ImGui_PushTextWrapPos(f32 wrap_local_pos_x) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImVector_float_push_back(&window.DC.TextWrapPosStack, window.DC.TextWrapPos);
    window.DC.TextWrapPos = wrap_local_pos_x;
}

void ImGui_PopTextWrapPos() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    while true {
        if window.DC.TextWrapPosStack.Size > 0 == 0 {
            if ImGui_ErrorLog("Calling PopTextWrapPos() too many times!") != 0 {
                assert(window.DC.TextWrapPosStack.Size > 0 && "Calling PopTextWrapPos() too many times!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    window.DC.TextWrapPos = *ImVector_float_back(&window.DC.TextWrapPosStack);
    ImVector_float_pop_back(&window.DC.TextWrapPosStack);
}

private {
ImGuiWindow* GetCombinedRootWindow(ImGuiWindow* window, bool popup_hierarchy, bool dock_hierarchy) {
    ImGuiWindow* last_window = null;
    while last_window != window {
        last_window = window;
        window = window.RootWindow;
        if popup_hierarchy != 0 {
            window = window.RootWindowPopupTree;
        }
        if dock_hierarchy != 0 {
            window = window.RootWindowDockTree;
        }
    }
    return window;
}
}

bool ImGui_IsWindowChildOf(ImGuiWindow* window, ImGuiWindow* potential_parent, bool popup_hierarchy, bool dock_hierarchy) {
    ImGuiWindow* window_root = GetCombinedRootWindow(window, popup_hierarchy, dock_hierarchy);
    if window_root == potential_parent {
        return true;
    }
    while window != null {
        if window == potential_parent {
            return true;
        }
        if window == window_root {
            return false;
        }
        window = window.ParentWindow;
    }
    return false;
}

bool ImGui_IsWindowInBeginStack(ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    for i32 n = g.CurrentWindowStack.Size - 1; n >= 0; n-- {
        if g.CurrentWindowStack.Data[n].Window == window {
            return true;
        }
    }
    return false;
}

bool ImGui_IsWindowWithinBeginStackOf(ImGuiWindow* window, ImGuiWindow* potential_parent) {
    if window.RootWindow == potential_parent {
        return true;
    }
    while window != null {
        if window == potential_parent {
            return true;
        }
        window = window.ParentWindowInBeginStack;
    }
    return false;
}

bool ImGui_IsWindowAbove(ImGuiWindow* potential_above, ImGuiWindow* potential_below) {
    ImGuiContext* g = GImGui;
    i32 display_layer_delta = GetWindowDisplayLayer(potential_above) - GetWindowDisplayLayer(potential_below);
    if display_layer_delta != 0 {
        return display_layer_delta > 0;
    }
    for i32 i = g.Windows.Size - 1; i >= 0; i-- {
        ImGuiWindow* candidate_window = g.Windows.Data[i];
        if candidate_window == potential_above {
            return true;
        }
        if candidate_window == potential_below {
            return false;
        }
    }
    return false;
}

// Is current window hovered and hoverable (e.g. not blocked by a popup/modal)? See ImGuiHoveredFlags_ for options.
// IMPORTANT: If you are trying to check whether your mouse should be dispatched to Dear ImGui or to your underlying app,
// you should not use this function! Use the 'io.WantCaptureMouse' boolean for that!
// Refer to FAQ entry "How can I tell whether to dispatch mouse/keyboard to Dear ImGui or my application?" for details.
bool ImGui_IsWindowHovered(ImGuiHoveredFlags flags) {
    ImGuiContext* g = GImGui;
    while true {
        if (flags & ~ImGuiHoveredFlags_AllowedMaskForIsWindowHovered) == 0 == 0 {
            if ImGui_ErrorLog("Invalid flags for IsWindowHovered()!") != 0 {
                assert((flags & ~ImGuiHoveredFlags_AllowedMaskForIsWindowHovered) == 0 && "Invalid flags for IsWindowHovered()!");
            }
        }
        if !(0 != 0) { break; }
    }
    ImGuiWindow* ref_window = g.HoveredWindow;
    ImGuiWindow* cur_window = g.CurrentWindow;
    if ref_window == null {
        return false;
    }
    if (flags & ImGuiHoveredFlags_AnyWindow) == 0 {
        assert(cast(i64, cur_window));
        bool popup_hierarchy = (flags & ImGuiHoveredFlags_NoPopupHierarchy) == 0;
        bool dock_hierarchy = (flags & ImGuiHoveredFlags_DockHierarchy) != 0;
        if (flags & ImGuiHoveredFlags_RootWindow) != 0 {
            cur_window = GetCombinedRootWindow(cur_window, popup_hierarchy, dock_hierarchy);
        }
        bool result;
        if (flags & ImGuiHoveredFlags_ChildWindows) != 0 {
            result = ImGui_IsWindowChildOf(ref_window, cur_window, popup_hierarchy, dock_hierarchy);
        } else {
            result = ref_window == cur_window;
        }
        if result == 0 {
            return false;
        }
    }
    if ImGui_IsWindowContentHoverable(ref_window, flags) == 0 {
        return false;
    }
    if (flags & ImGuiHoveredFlags_AllowWhenBlockedByActiveItem) == 0 {
        if g.ActiveId != 0 && !g.ActiveIdAllowOverlap && g.ActiveId != ref_window.MoveId {
            return false;
        }
    }
    if (flags & ImGuiHoveredFlags_ForTooltip) != 0 {
        flags = ApplyHoverFlagsForTooltip(flags, g.Style.HoverFlagsForTooltipMouse);
    }
    if (flags & ImGuiHoveredFlags_Stationary) != 0 && g.HoverWindowUnlockedStationaryId != ref_window.ID {
        return false;
    }
    return true;
}

