bool op_eq_ImTextureRef_ImTextureRef(ImTextureRef lhs, ImTextureRef rhs) {
    return lhs._TexID == rhs._TexID && lhs._TexData == rhs._TexData;
}

bool op_ne_ImTextureRef_ImTextureRef(ImTextureRef lhs, ImTextureRef rhs) {
    return lhs._TexID != rhs._TexID || lhs._TexData != rhs._TexData;
}

i32 ImFontAtlasRectId_GetIndex(ImFontAtlasRectId id) {
    return id & 0x0007FFFF;
}

u32 ImFontAtlasRectId_GetGeneration(ImFontAtlasRectId id) {
    return cast(u32, id & 0x3FF00000) >> 20;
}

ImFontAtlasRectId ImFontAtlasRectId_Make(i32 index_idx, i32 gen_idx) {
    assert(index_idx >= 0 && index_idx <= 0x0007FFFF && gen_idx <= 0x3FF00000 >> 20);
    return cast(ImFontAtlasRectId, index_idx | gen_idx << 20);
}

