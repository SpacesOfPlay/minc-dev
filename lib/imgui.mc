void ImGui_SetWindowPos(ImGuiWindow* window, ImVec2 pos, ImGuiCond cond) {
    if cond && (window.SetWindowPosAllowFlags & cond) == 0 {
        return;
    }
    assert(cond == 0 || ImIsPowerOfTwo(cond));
    window.SetWindowPosAllowFlags &= ~(ImGuiCond_Once | ImGuiCond_FirstUseEver | ImGuiCond_Appearing);
    window.SetWindowPosVal = ImVec2{FLT_MAX, FLT_MAX};
    ImVec2 old_pos = window.Pos;
    window.Pos = ImTrunc(pos);
    ImVec2 offset = op_sub_ImVec2_ImVec2(window.Pos, old_pos);
    if offset.x == 0.0f && offset.y == 0.0f {
        return;
    }
    ImGui_MarkIniSettingsDirty(window);
    window.DC.CursorPos = op_add_ImVec2_ImVec2(window.DC.CursorPos, offset);
    window.DC.CursorMaxPos = op_add_ImVec2_ImVec2(window.DC.CursorMaxPos, offset);
    window.DC.IdealMaxPos = op_add_ImVec2_ImVec2(window.DC.IdealMaxPos, offset);
    window.DC.CursorStartPos = op_add_ImVec2_ImVec2(window.DC.CursorStartPos, offset);
}

void ImGui_SetWindowPos(ImVec2 pos, ImGuiCond cond) {
    ImGuiWindow* window = ImGui_GetCurrentWindowRead();
    ImGui_SetWindowPos(window, pos, cond);
}

