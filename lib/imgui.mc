            } else if t_with_flip < zero_point_center {
                result = -(logarithmic_zero_epsilon * ImPow(-v_min_fudged / logarithmic_zero_epsilon, 1.0f - t_with_flip / zero_point_snap_L));
            } else {
                result = logarithmic_zero_epsilon * ImPow(v_max_fudged / logarithmic_zero_epsilon, (t_with_flip - zero_point_snap_R) / (1.0f - zero_point_snap_R));
