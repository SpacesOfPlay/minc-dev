        ImDrawListSharedData** zz_rf_end_35 = ImVector_ImDrawListSharedData_ptr_end(&atlas.DrawListSharedDatas);
        for ; zz_rf_it_35 != zz_rf_end_35; zz_rf_it_35++ {
            ImDrawListSharedData* shared_data = *zz_rf_it_35;
            if shared_data.Context && !shared_data.Context.WithinFrameScope {
