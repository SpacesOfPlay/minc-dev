void ImGuiViewportP_dtor(ImGuiViewportP* self) {
    if self.BgFgDrawLists[0] != null {
        0;
    }
    if self.BgFgDrawLists[1] != null {
        0;
    }
}

void ImGuiViewportP_ClearRequestFlags(ImGuiViewportP* self) {
    self.PlatformRequestResize = false;
    self.PlatformRequestMove = self.PlatformRequestResize;
    self.PlatformRequestClose = self.PlatformRequestMove;
}

// Calculate work rect pos/size given a set of offset (we have 1 pair of offset for rect locked from last frame data, and 1 pair for currently building rect)
ImVec2 ImGuiViewportP_CalcWorkRectPos(ImGuiViewportP* self, ImVec2 inset_min) {
    return ImVec2{self.Pos.x + inset_min.x, self.Pos.y + inset_min.y};
}

ImVec2 ImGuiViewportP_CalcWorkRectSize(ImGuiViewportP* self, ImVec2 inset_min, ImVec2 inset_max) {
    return ImVec2{
        ImMax(0.0f, self.Size.x - inset_min.x - inset_max.x),
        ImMax(0.0f, self.Size.y - inset_min.y - inset_max.y),
    };
}

void ImGuiViewportP_UpdateWorkRect(ImGuiViewportP* self) {
    self.WorkPos = ImGuiViewportP_CalcWorkRectPos(self, self.WorkInsetMin);
    self.WorkSize = ImGuiViewportP_CalcWorkRectSize(self, self.WorkInsetMin, self.WorkInsetMax);
}

// Update public fields
// Helpers to retrieve ImRect (we don't need to store BuildWorkRect as every access tend to change it, hence the code asymmetry)
ImRect ImGuiViewportP_GetMainRect(ImGuiViewportP* self) {
    return ImRect{
        ImVec2{self.Pos.x, self.Pos.y},
        ImVec2{self.Pos.x + self.Size.x, self.Pos.y + self.Size.y},
    };
}

ImRect ImGuiViewportP_GetWorkRect(ImGuiViewportP* self) {
    return ImRect{
        ImVec2{self.WorkPos.x, self.WorkPos.y},
        ImVec2{self.WorkPos.x + self.WorkSize.x, self.WorkPos.y + self.WorkSize.y},
    };
}

ImRect ImGuiViewportP_GetBuildWorkRect(ImGuiViewportP* self) {
    ImVec2 pos = ImGuiViewportP_CalcWorkRectPos(self, self.BuildWorkInsetMin);
    ImVec2 size = ImGuiViewportP_CalcWorkRectSize(self, self.BuildWorkInsetMin, self.BuildWorkInsetMax);
    return ImRect{ImVec2{pos.x, pos.y}, ImVec2{pos.x + size.x, pos.y + size.y}};
}

