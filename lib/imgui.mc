//-----------------------------------------------------------------------------
// [SECTION] Settings support
//-----------------------------------------------------------------------------
// Windows data saved in imgui.ini file
// Because we never destroy or rename ImGuiWindowSettings, we can store the names in a separate buffer easily.
// (this is designed to be stored in a ImChunkStream buffer, with the variable-length Name following our structure)
struct ImGuiWindowSettings {
    ImGuiID ID;
    ImVec2ih Pos;
    ImVec2ih Size;
    ImVec2ih ViewportPos;
    ImGuiID ViewportId;
    ImGuiID DockId;
    ImGuiID ClassId;
    i16 DockOrder;
    ImGuiPackedDate LastUsedDate;
    bool Collapsed;
    bool IsChild;
    bool WantApply;
    bool WantDelete;
}

struct ImGuiSettingsCleanupArgs {
    ImGuiID TypeHashFilter;
    i32 DiscardOlderThanMonths;
    bool DiscardWhenMissingDate;
    bool DiscardAll;
    bool SetCurrentSessionDateToAll;
    bool SetCurrentSessionDateWhenMissingDate;
    i32 _DiscardOlderThanDate;
}

struct ImGuiSettingsHandler {
    u8* TypeName;
    ImGuiID TypeHash;
    fn(ImGuiContext*, ImGuiSettingsHandler*): void ClearAllFn;
    fn(ImGuiContext*, ImGuiSettingsHandler*): void ReadInitFn;
    fn(ImGuiContext*, ImGuiSettingsHandler*, u8*): void* ReadOpenFn;
    fn(ImGuiContext*, ImGuiSettingsHandler*, void*, u8*): void ReadLineFn;
    fn(ImGuiContext*, ImGuiSettingsHandler*): void ApplyAllFn;
    fn(ImGuiContext*, ImGuiSettingsHandler*, ImGuiTextBuffer*): void WriteAllFn;
    fn(ImGuiContext*, ImGuiSettingsHandler*, ImGuiSettingsCleanupArgs*): void CleanupFn;
    void* UserData;
}

struct ImGuiLocEntry {
    ImGuiLocKey Key;
    u8* Text;
}

struct ImGuiDebugAllocEntry {
