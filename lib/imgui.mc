void ImGuiContext_dtor(ImGuiContext* self) {
    assert(self.Initialized == false && "Forgot to call DestroyContext()?");
}

void ImGui_Initialize() {
    ImGuiContext* g = GImGui;
    assert(!g.Initialized && !g.SettingsLoaded);
    {
        ImGuiSettingsHandler ini_handler;
        ini_handler.TypeName = "Window";
        ini_handler.TypeHash = ImHashStr("Window");
        ini_handler.ClearAllFn = WindowSettingsHandler_ClearAll;
        ini_handler.CleanupFn = WindowSettingsHandler_Cleanup;
        ini_handler.ReadOpenFn = WindowSettingsHandler_ReadOpen;
        ini_handler.ReadLineFn = WindowSettingsHandler_ReadLine;
        ini_handler.ApplyAllFn = WindowSettingsHandler_ApplyAll;
        ini_handler.WriteAllFn = WindowSettingsHandler_WriteAll;
        ImGui_AddSettingsHandler(&ini_handler);
    }
    ImGui_TableSettingsAddSettingsHandler();
    ImGui_LocalizeRegisterEntries(GLocalizationEntriesEnUS, cast(i32, sizeof(GLocalizationEntriesEnUS) / sizeof(*GLocalizationEntriesEnUS)));
    g.PlatformIO.Platform_GetClipboardTextFn = Platform_GetClipboardTextFn_DefaultImpl;
    g.PlatformIO.Platform_SetClipboardTextFn = Platform_SetClipboardTextFn_DefaultImpl;
    g.PlatformIO.Platform_OpenInShellFn = Platform_OpenInShellFn_DefaultImpl;
    g.PlatformIO.Platform_SetImeDataFn = Platform_SetImeDataFn_DefaultImpl;
    var viewport = cast(ImGuiViewportP*, ImGui_MemAlloc(cast(u64, sizeof(ImGuiViewportP))));
    ImGuiViewportP_init(viewport);
    viewport.ID = ImGui_IMGUI_VIEWPORT_DEFAULT_ID;
    viewport.Idx = 0;
    viewport.PlatformWindowCreated = true;
    viewport.Flags = ImGuiViewportFlags_OwnedByApp;
    ImVector_ImGuiViewportP_ptr_push_back(&g.Viewports, viewport);
    ImVector_char_resize(&g.TempBuffer, 1024 * 3 + 1, 0);
    g.ViewportCreatedCount++;
    ImVector_ImGuiViewport_ptr_push_back(&g.PlatformIO.Viewports, cast(ImGuiViewport*, g.Viewports.Data[0]));
    for ImGuiKey key = ImGuiKey_NamedKey_BEGIN; key < ImGuiKey_NamedKey_END; key = cast(ImGuiKey, key + 1) {
        if key >= ImGuiKey_0 && key <= ImGuiKey_9 || key >= ImGuiKey_A && key <= ImGuiKey_Z || key >= ImGuiKey_Keypad0 && key <= ImGuiKey_Keypad9 || key == ImGuiKey_Tab || key == ImGuiKey_Space || key == ImGuiKey_Apostrophe || key == ImGuiKey_Comma || key == ImGuiKey_Minus || key == ImGuiKey_Period || key == ImGuiKey_Slash || key == ImGuiKey_Semicolon || key == ImGuiKey_Equal || key == ImGuiKey_LeftBracket || key == ImGuiKey_RightBracket || key == ImGuiKey_GraveAccent || key == ImGuiKey_KeypadDecimal || key == ImGuiKey_KeypadDivide || key == ImGuiKey_KeypadMultiply || key == ImGuiKey_KeypadSubtract || key == ImGuiKey_KeypadAdd || key == ImGuiKey_KeypadEqual {
        ignore key;
        }
    }
    ImGui_DockContextInitialize(g);
    ImFontAtlas* atlas = g.IO.Fonts;
    g.DrawListSharedData.Context = g;
    ImGui_RegisterFontAtlas(atlas);
    g.Initialized = true;
}

// This function is merely here to free heap allocations.
void ImGui_Shutdown() {
    ImGuiContext* g = GImGui;
    while true {
        if g.IO.BackendPlatformUserData == null == 0 {
            if ImGui_ErrorLog("Forgot to shutdown Platform backend?") != 0 {
                assert(g.IO.BackendPlatformUserData == null && "Forgot to shutdown Platform backend?");
            }
        }
        if !(0 != 0) { break; }
    }
    while true {
        if g.IO.BackendRendererUserData == null == 0 {
            if ImGui_ErrorLog("Forgot to shutdown Renderer backend?") != 0 {
                assert(g.IO.BackendRendererUserData == null && "Forgot to shutdown Renderer backend?");
            }
        }
        if !(0 != 0) { break; }
    }
    {
        ImGuiViewportP** zz_rf_it_6 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_6 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_6 != zz_rf_end_6; zz_rf_it_6++ {
            ImGuiViewportP* viewport = *zz_rf_it_6;
            ignore viewport;
            while true {
                if (viewport.RendererUserData == null && viewport.PlatformUserData == null && viewport.PlatformHandle == null) == 0 {
                    if ImGui_ErrorLog("Backend or app forgot to call DestroyPlatformWindows()?") != 0 {
                        assert(viewport.RendererUserData == null && viewport.PlatformUserData == null && viewport.PlatformHandle == null && "Backend or app forgot to call DestroyPlatformWindows()?");
                    }
                }
                if !(0 != 0) { break; }
            }
        }
    }
    {
        ImFontAtlas** zz_rf_it_7 = ImVector_ImFontAtlas_ptr_begin(&g.FontAtlases);
        ImFontAtlas** zz_rf_end_7 = ImVector_ImFontAtlas_ptr_end(&g.FontAtlases);
        for ; zz_rf_it_7 != zz_rf_end_7; zz_rf_it_7++ {
            ImFontAtlas* atlas = *zz_rf_it_7;
            ImGui_UnregisterFontAtlas(atlas);
            if atlas.OwnerContext == g {
                assert(atlas.RefCount == 0 && "Destroying context owning a ImFontAtlas which is still used elsewhere!");
                if atlas.RefCount == 0 {
                    atlas.Locked = false;
                    0;
                }
            }
        }
    }
    ImVector_ImVec2_clear(&g.DrawListSharedData.TempBuffer);
    if g.Initialized == 0 {
        return;
    }
    if g.SettingsLoaded && g.IO.IniFilename != null {
        ImGui_SaveIniSettingsToDisk(g.IO.IniFilename);
    }
    ImGui_DockContextShutdown(g);
    ImGui_CallContextHooks(g, ImGuiContextHookType_Shutdown);
    ImVector_ImGuiWindow_ptr_clear_delete(&g.Windows);
    ImVector_ImGuiWindow_ptr_clear(&g.WindowsFocusOrder);
    ImVector_ImGuiWindow_ptr_clear(&g.WindowsTempSortBuffer);
    g.CurrentWindow = null;
    ImVector_ImGuiWindowStackData_clear(&g.CurrentWindowStack);
    ImGuiStorage_Clear(&g.WindowsById);
    g.NavWindow = null;
    g.HoveredWindowUnderMovingWindow = null;
    g.HoveredWindow = g.HoveredWindowUnderMovingWindow;
    g.ActiveIdWindow = null;
    g.MovingWindow = null;
    ImGuiKeyRoutingTable_Clear(&g.KeysRoutingTable);
    ImVector_ImGuiColorMod_clear(&g.ColorStack);
    ImVector_ImGuiStyleMod_clear(&g.StyleVarStack);
    ImVector_ImFontStackData_clear(&g.FontStack);
    ImVector_ImGuiPopupData_clear(&g.OpenPopupStack);
    ImVector_ImGuiPopupData_clear(&g.BeginPopupStack);
    ImVector_ImGuiTreeNodeStackData_clear(&g.TreeNodeStack);
    g.MouseLastHoveredViewport = null;
    g.MouseViewport = g.MouseLastHoveredViewport;
    g.CurrentViewport = g.MouseViewport;
    ImVector_ImGuiViewportP_ptr_clear_delete(&g.Viewports);
    ImPool_ImGuiTabBar_Clear(&g.TabBars);
    ImVector_ImGuiPtrOrIndex_clear(&g.CurrentTabBarStack);
    ImVector_ImGuiShrinkWidthItem_clear(&g.ShrinkWidthBuffer);
    ImVector_ImGuiListClipperData_clear_destruct(&g.ClipperTempData);
    ImPool_ImGuiTable_Clear(&g.Tables);
    ImVector_ImGuiTableTempData_clear_destruct(&g.TablesTempData);
    ImVector_ImDrawChannel_clear(&g.DrawChannelsTempMergeBuffer);
    ImPool_ImGuiMultiSelectState_Clear(&g.MultiSelectStorage);
    ImVector_ImGuiMultiSelectTempData_clear_destruct(&g.MultiSelectTempData);
    ImVector_char_clear(&g.ClipboardHandlerData);
    ImVector_ImGuiID_clear(&g.MenusIdSubmittedThisFrame);
    ImGuiInputTextState_ClearFreeMemory(&g.InputTextState);
    ImGuiTextIndex_clear(&g.InputTextLineIndex);
    ImGuiInputTextDeactivatedState_ClearFreeMemory(&g.InputTextDeactivatedState);
    ImChunkStream_ImGuiWindowSettings_clear(&g.SettingsWindows);
    ImVector_ImGuiSettingsHandler_clear(&g.SettingsHandlers);
    if g.LogFile != null {
        ImFileClose(g.LogFile);
        g.LogFile = null;
    }
    ImGuiTextBuffer_clear(&g.LogBuffer);
    ImGuiTextBuffer_clear(&g.DebugLogBuf);
    ImGuiTextIndex_clear(&g.DebugLogIndex);
    g.Initialized = false;
}

// When using multiple context it can be helpful to give name a name.
// (A) Will be visible in debugger, (B) Will be included in all IMGUI_DEBUG_LOG() calls, (C) Should be <= 15 characters long.
void ImGui_SetContextName(ImGuiContext* ctx, u8* name) {
    ImStrncpy(ctx.ContextName, name, cast(u64, cast(i32, sizeof(ctx.ContextName) / sizeof(*ctx.ContextName))));
}

// No specific ordering/dependency support, will see as needed
ImGuiID ImGui_AddContextHook(ImGuiContext* ctx, ImGuiContextHook* hook) {
    ImGuiContext* g = ctx;
    assert(hook.Callback != null && hook.HookId == 0 && hook.Type != ImGuiContextHookType_PendingRemoval_);
    ImVector_ImGuiContextHook_push_back(&g.Hooks, *hook);
    ImVector_ImGuiContextHook_back(&g.Hooks).HookId = ++g.HookIdNext;
    return g.HookIdNext;
}

// Deferred removal, avoiding issue with changing vector while iterating it
void ImGui_RemoveContextHook(ImGuiContext* ctx, ImGuiID hook_id) {
    ImGuiContext* g = ctx;
    assert(hook_id != 0);
    {
        ImGuiContextHook* zz_rf_it_8 = ImVector_ImGuiContextHook_begin(&g.Hooks);
        ImGuiContextHook* zz_rf_end_8 = ImVector_ImGuiContextHook_end(&g.Hooks);
        for ; zz_rf_it_8 != zz_rf_end_8; zz_rf_it_8++ {
            ImGuiContextHook* hook = zz_rf_it_8;
            if hook.HookId == hook_id {
                hook.Type = ImGuiContextHookType_PendingRemoval_;
            }
        }
    }
}

// Call context hooks (used by e.g. test engine)
// We assume a small number of hooks so all stored in same array
void ImGui_CallContextHooks(ImGuiContext* ctx, ImGuiContextHookType hook_type) {
    ImGuiContext* g = ctx;
    {
        ImGuiContextHook* zz_rf_it_9 = ImVector_ImGuiContextHook_begin(&g.Hooks);
        ImGuiContextHook* zz_rf_end_9 = ImVector_ImGuiContextHook_end(&g.Hooks);
        for ; zz_rf_it_9 != zz_rf_end_9; zz_rf_it_9++ {
            ImGuiContextHook* hook = zz_rf_it_9;
            if hook.Type == hook_type {
                hook.Callback(g, hook);
            }
        }
    }
}

//-----------------------------------------------------------------------------
// [SECTION] MAIN CODE (most of the code! lots of stuff, needs tidying up!)
//-----------------------------------------------------------------------------
// ImGuiWindow is mostly a dumb struct. It merely has a constructor and a few helper methods
void ImGuiWindow_init(ImGuiWindow* self, ImGuiContext* ctx, u8* name) {
    memset(self, 0, cast(u64, sizeof(*self)));
    ImGuiWindowClass_init(&self.WindowClass);
    ImVec2_init(&self.ViewportPos);
    ImVec2_init(&self.Pos);
    ImVec2_init(&self.Size);
    ImVec2_init(&self.SizeFull);
    ImVec2_init(&self.ContentSize);
    ImVec2_init(&self.ContentSizeIdeal);
    ImVec2_init(&self.ContentSizeExplicit);
    ImVec2_init(&self.WindowPadding);
    ImVec2_init(&self.Scroll);
    ImVec2_init(&self.ScrollMax);
    ImVec2_init(&self.ScrollTarget);
    ImVec2_init(&self.ScrollTargetCenterRatio);
    ImVec2_init(&self.ScrollTargetEdgeSnapDist);
    ImVec2_init(&self.ScrollbarSizes);
    ImVec2_init(&self.SetWindowPosVal);
    ImVec2_init(&self.SetWindowPosPivot);
    ImVector_ImGuiID_init(&self.IDStack);
    memset(&self.DC, 0, cast(u64, sizeof(ImGuiWindowTempData)));
    ImRect_init(&self.OuterRectClipped);
    ImRect_init(&self.InnerRect);
    ImRect_init(&self.InnerClipRect);
    ImRect_init(&self.WorkRect);
    ImRect_init(&self.ParentWorkRect);
    ImRect_init(&self.ClipRect);
    ImRect_init(&self.ContentRegionRect);
    ImVec2ih_init(&self.HitTestHoleSize);
    ImVec2ih_init(&self.HitTestHoleOffset);
    memset(&self.StateStorage, 0, cast(u64, sizeof(ImGuiStorage)));
    ImVector_ImGuiOldColumns_init(&self.ColumnsStorage);
    memset(&self.DockStyle, 0, cast(u64, sizeof(ImGuiWindowDockStyle)));
    ImDrawList_init(&self.DrawListInst, null);
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
    self.Ctx = ctx;
    self.Name = ImStrdup(name);
    self.NameBufLen = cast(i32, strlen(name)) + 1;
    self.ID = ImHashStr(name);
    ImVector_ImGuiID_push_back(&self.IDStack, self.ID);
    self.ViewportAllowPlatformMonitorExtend = -1;
    self.ViewportPos = ImVec2{FLT_MAX, FLT_MAX};
    self.MoveId = ImGuiWindow_GetID(self, "#MOVE", null);
    self.TabId = ImGuiWindow_GetID(self, "#TAB", null);
    self.ScrollTarget = ImVec2{FLT_MAX, FLT_MAX};
    self.ScrollTargetCenterRatio = ImVec2{0.5f, 0.5f};
    self.AutoPosLastDirection = ImGuiDir_None;
    self.AutoFitFramesY = cast(ImS8, -1);
    self.AutoFitFramesX = self.AutoFitFramesY;
    self.SetWindowDockAllowFlags = 0;
    self.SetWindowCollapsedAllowFlags = self.SetWindowDockAllowFlags;
    self.SetWindowSizeAllowFlags = self.SetWindowCollapsedAllowFlags;
    self.SetWindowPosAllowFlags = self.SetWindowSizeAllowFlags;
    self.SetWindowPosPivot = ImVec2{FLT_MAX, FLT_MAX};
    self.SetWindowPosVal = self.SetWindowPosPivot;
    self.LastFrameActive = -1;
    self.LastFrameJustFocused = -1;
    self.LastTimeActive = -1.0f;
    self.FontRefSize = 0.0f;
    self.FontWindowScaleParents = 1.0f;
    self.FontWindowScale = self.FontWindowScaleParents;
    self.SettingsOffset = -1;
    self.DockOrder = -1;
    self.DrawList = &self.DrawListInst;
    self.DrawList._OwnerName = self.Name;
    ImDrawList__SetDrawListSharedData(self.DrawList, &self.Ctx.DrawListSharedData);
    self.NavPreferredScoringPosRel[1] = ImVec2{FLT_MAX, FLT_MAX};
    self.NavPreferredScoringPosRel[0] = self.NavPreferredScoringPosRel[1];
    ImGuiWindowClass_init(&self.WindowClass);
}

void ImGuiWindow_dtor(ImGuiWindow* self) {
    assert(self.DrawList == &self.DrawListInst);
    0;
    ImVector_ImGuiOldColumns_clear_destruct(&self.ColumnsStorage);
}

private {
void SetCurrentWindow(ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    g.CurrentWindow = window;
    g.StackSizesInBeginForCurrentWindow = g.CurrentWindow != null ? &ImVector_ImGuiWindowStackData_back(&g.CurrentWindowStack).StackSizesInBegin : null;
    g.CurrentTable = window && window.DC.CurrentTableIdx != -1 ? ImPool_ImGuiTable_GetByIndex(&g.Tables, window.DC.CurrentTableIdx) : null;
    if window != null {
        if (g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures) != 0 {
            var viewport = cast(ImGuiViewport*, window.Viewport);
            g.FontRasterizerDensity = viewport.FramebufferScale.x != 0.0f ? viewport.FramebufferScale.x : g.IO.DisplayFramebufferScale.x;
        }
        bool backup_skip_items = window.SkipItems;
        window.SkipItems = false;
        ImGui_UpdateCurrentFontSize(0.0f);
        window.SkipItems = backup_skip_items;
        ImGui_NavUpdateCurrentWindowIsScrollPushableX();
    }
}
}

void ImGui_GcCompactTransientMiscBuffers() {
    ImGuiContext* g = GImGui;
    ImVector_ImGuiItemFlags_clear(&g.ItemFlagsStack);
    ImVector_ImGuiGroupData_clear(&g.GroupStack);
    ImGuiTextIndex_clear(&g.InputTextLineIndex);
    g.MultiSelectTempDataStacked = 0;
    ImVector_ImGuiMultiSelectTempData_clear_destruct(&g.MultiSelectTempData);
    ImGui_TableGcCompactSettings();
    {
        ImFontAtlas** zz_rf_it_10 = ImVector_ImFontAtlas_ptr_begin(&g.FontAtlases);
        ImFontAtlas** zz_rf_end_10 = ImVector_ImFontAtlas_ptr_end(&g.FontAtlases);
        for ; zz_rf_it_10 != zz_rf_end_10; zz_rf_it_10++ {
            ImFontAtlas* atlas = *zz_rf_it_10;
            ImFontAtlas_CompactCache(atlas);
        }
    }
}

// Free up/compact internal window buffers, we can use this when a window becomes unused.
// Not freed:
// - ImGuiWindow, ImGuiWindowSettings, Name, StateStorage, ColumnsStorage (may hold useful data)
// This should have no noticeable visual effect. When the window reappear however, expect new allocation/buffer growth/copy cost.
// FIXME: Consider exposing of elaborating GC policy, e.g. being able to trim excessive ImDrawList gaps. (#9303)
void ImGui_GcCompactTransientWindowBuffers(ImGuiWindow* window) {
    window.MemoryCompacted = true;
    window.MemoryDrawListIdxCapacity = ImMin(cast(i32, cast(f32, window.DrawList.IdxBuffer.Size) * 1.05f), window.DrawList.IdxBuffer.Capacity);
    window.MemoryDrawListVtxCapacity = ImMin(cast(i32, cast(f32, window.DrawList.VtxBuffer.Size) * 1.05f), window.DrawList.VtxBuffer.Capacity);
    ImVector_ImGuiID_clear(&window.IDStack);
    ImDrawList__ClearFreeMemory(window.DrawList);
    ImVector_ImGuiWindow_ptr_clear(&window.DC.ChildWindows);
    ImVector_float_clear(&window.DC.ItemWidthStack);
    ImVector_float_clear(&window.DC.TextWrapPosStack);
}

void ImGui_GcAwakeTransientWindowBuffers(ImGuiWindow* window) {
    window.MemoryCompacted = false;
    ImVector_ImDrawIdx_reserve(&window.DrawList.IdxBuffer, window.MemoryDrawListIdxCapacity);
    ImVector_ImDrawVert_reserve(&window.DrawList.VtxBuffer, window.MemoryDrawListVtxCapacity);
    window.MemoryDrawListVtxCapacity = 0;
    window.MemoryDrawListIdxCapacity = window.MemoryDrawListVtxCapacity;
}

void ImGui_SetActiveID(ImGuiID id, ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    if g.ActiveId != 0 {
        ImGuiDeactivatedItemData* deactivated_data = &g.DeactivatedItemData;
        deactivated_data.ID = g.ActiveId;
        deactivated_data.ElapseFrame = g.LastItemData.ID == g.ActiveId ? g.FrameCount : g.FrameCount + 1;
        deactivated_data.HasBeenEditedBefore = g.ActiveIdHasBeenEditedBefore;
        deactivated_data.IsAlive = g.ActiveIdIsAlive == g.ActiveId;
        if g.InputTextState.ID == g.ActiveId {
            ImGui_InputTextDeactivateHook(g.ActiveId);
        }
        if g.MovingWindow != null && g.ActiveId == g.MovingWindow.MoveId {
            while true {
                if (g.DebugLogFlags & ImGuiDebugLogFlags_EventActiveId) != 0 {
                }
                if !(0 != 0) { break; }
            }
            ImGui_StopMouseMovingWindow();
        }
    }
    g.ActiveIdIsJustActivated = g.ActiveId != id;
    if g.ActiveIdIsJustActivated != 0 {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventActiveId) != 0 {
            }
            if !(0 != 0) { break; }
        }
        g.ActiveIdTimer = 0.0f;
        g.ActiveIdHasBeenPressedBefore = false;
        g.ActiveIdHasBeenEditedBefore = false;
        g.ActiveIdMouseButton = cast(ImS8, -1);
        if id != 0 {
            g.LastActiveId = id;
            g.LastActiveIdTimer = 0.0f;
        }
    }
    g.ActiveId = id;
    g.ActiveIdAllowOverlap = false;
    g.ActiveIdNoClearOnFocusLoss = false;
    g.ActiveIdWindow = window;
    g.ActiveIdHasBeenEditedThisFrame = false;
    g.ActiveIdFromShortcut = false;
    g.ActiveIdDisabledId = 0;
    if id != 0 {
        g.ActiveIdIsAlive = id;
        g.ActiveIdSource = g.NavActivateId == id || g.NavJustMovedToId == id ? g.NavInputSource : ImGuiInputSource_Mouse;
        assert(g.ActiveIdSource != ImGuiInputSource_None);
    }
    g.ActiveIdUsingNavDirMask = 0x00;
    g.ActiveIdUsingAllKeyboardKeys = false;
}

void ImGui_ClearActiveID() {
    ImGui_SetActiveID(0, null);
}

void ImGui_SetHoveredID(ImGuiID id) {
    ImGuiContext* g = GImGui;
    g.HoveredId = id;
    g.HoveredIdAllowOverlap = false;
    if id != 0 && g.HoveredIdPreviousFrame != id {
        g.HoveredIdNotActiveTimer = 0.0f;
        g.HoveredIdTimer = g.HoveredIdNotActiveTimer;
    }
}

ImGuiID ImGui_GetHoveredID() {
    ImGuiContext* g = GImGui;
    return g.HoveredId != 0 ? g.HoveredId : g.HoveredIdPreviousFrame;
}

void ImGui_MarkItemEdited(ImGuiID id) {
    ImGuiContext* g = GImGui;
    g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_EditedInternal;
    if (g.LastItemData.ItemFlags & ImGuiItemFlags_NoMarkEdited) != 0 {
        return;
    }
    g.LastItemData.StatusFlags |= ImGuiItemStatusFlags_Edited;
    if g.ActiveId == id || g.ActiveId == 0 {
        g.ActiveIdHasBeenEditedBefore = true;
        g.ActiveIdHasBeenEditedThisFrame = g.ActiveIdHasBeenEditedBefore;
        g.AnyIdHasBeenEditedThisFrame = g.ActiveIdHasBeenEditedThisFrame;
    }
    if g.DeactivatedItemData.ID == id {
        g.DeactivatedItemData.HasBeenEditedBefore = true;
    }
    assert(g.DragDropActive || g.ActiveId == id || g.ActiveId == 0 || g.DeactivatedItemData.ID == id || g.ActiveIdPreviousFrame == id || g.NavJustMovedToId || g.CurrentMultiSelect != null && g.BoxSelectState.IsActive);
}

bool ImGui_IsWindowContentHoverable(ImGuiWindow* window, ImGuiHoveredFlags flags) {
    ImGuiContext* g = GImGui;
    if g.NavWindow != null {
        ImGuiWindow* focused_root_window = g.NavWindow.RootWindowDockTree;
        if focused_root_window != null {
            if focused_root_window.WasActive && focused_root_window != window.RootWindowDockTree {
                bool want_inhibit = false;
                if (focused_root_window.Flags & ImGuiWindowFlags_Modal) != 0 {
                    want_inhibit = true;
                } else if focused_root_window.Flags & ImGuiWindowFlags_Popup && !(flags & ImGuiHoveredFlags_AllowWhenBlockedByPopup) {
                    want_inhibit = true;
                }
                if want_inhibit != 0 {
                    if ImGui_IsWindowWithinBeginStackOf(window.RootWindow, focused_root_window) == 0 {
                        return false;
                    }
                }
            }
        }
    }
    if window.Viewport != g.MouseViewport {
        if g.MovingWindow == null || window.RootWindowDockTree != g.MovingWindow.RootWindowDockTree {
            return false;
        }
    }
    return true;
}

private {
f32 CalcDelayFromHoveredFlags(ImGuiHoveredFlags flags) {
    ImGuiContext* g = GImGui;
    if (flags & ImGuiHoveredFlags_DelayNormal) != 0 {
        return g.Style.HoverDelayNormal;
    }
    if (flags & ImGuiHoveredFlags_DelayShort) != 0 {
        return g.Style.HoverDelayShort;
    }
    return 0.0f;
}

ImGuiHoveredFlags ApplyHoverFlagsForTooltip(ImGuiHoveredFlags user_flags, ImGuiHoveredFlags shared_flags) {
    if (user_flags & (ImGuiHoveredFlags_DelayNone | ImGuiHoveredFlags_DelayShort | ImGuiHoveredFlags_DelayNormal)) != 0 {
        shared_flags &= ~(ImGuiHoveredFlags_DelayNone | ImGuiHoveredFlags_DelayShort | ImGuiHoveredFlags_DelayNormal);
    }
    return user_flags | shared_flags;
}
}

// This is roughly matching the behavior of internal-facing ItemHoverable()
// - we allow hovering to be true when ActiveId==window->MoveID, so that clicking on non-interactive items such as a Text() item still returns true with IsItemHovered()
// - this should work even for non-interactive items that have no ID, so we cannot use LastItemId
bool ImGui_IsItemHovered(ImGuiHoveredFlags flags) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    while true {
        if (flags & ~ImGuiHoveredFlags_AllowedMaskForIsItemHovered) == 0 == 0 {
            if ImGui_ErrorLog("Invalid flags for IsItemHovered()!") != 0 {
                assert((flags & ~ImGuiHoveredFlags_AllowedMaskForIsItemHovered) == 0 && "Invalid flags for IsItemHovered()!");
            }
        }
        if !(0 != 0) { break; }
    }
    if g.NavHighlightItemUnderNav && g.NavCursorVisible && !(flags & ImGuiHoveredFlags_NoNavOverride) {
        if ImGui_IsItemFocused() == 0 {
            return false;
        }
        if g.LastItemData.ItemFlags & ImGuiItemFlags_Disabled && !(flags & ImGuiHoveredFlags_AllowWhenDisabled) {
            return false;
        }
        if (flags & ImGuiHoveredFlags_ForTooltip) != 0 {
            flags = ApplyHoverFlagsForTooltip(flags, g.Style.HoverFlagsForTooltipNav);
        }
    } else {
        ImGuiItemStatusFlags status_flags = g.LastItemData.StatusFlags;
        if (status_flags & ImGuiItemStatusFlags_HoveredRect) == 0 {
            return false;
        }
        if (flags & ImGuiHoveredFlags_ForTooltip) != 0 {
            flags = ApplyHoverFlagsForTooltip(flags, g.Style.HoverFlagsForTooltipMouse);
        }
        if g.HoveredWindow != window && (status_flags & ImGuiItemStatusFlags_HoveredWindow) == 0 {
            if (flags & ImGuiHoveredFlags_AllowWhenOverlappedByWindow) == 0 {
                return false;
            }
        }
        ImGuiID id = g.LastItemData.ID;
        if (flags & ImGuiHoveredFlags_AllowWhenBlockedByActiveItem) == 0 {
            if g.ActiveId != 0 && g.ActiveId != id && !g.ActiveIdAllowOverlap && !g.ActiveIdFromShortcut {
                bool cancel_is_hovered = true;
                if g.ActiveId == window.MoveId && (id == 0 || g.ActiveIdDisabledId == id) {
                    cancel_is_hovered = false;
                }
                if g.ActiveId == window.TabId {
                    cancel_is_hovered = false;
                }
                if cancel_is_hovered != 0 {
                    return false;
                }
            }
        }
        if !ImGui_IsWindowContentHoverable(window, flags) && !(g.LastItemData.ItemFlags & ImGuiItemFlags_NoWindowHoverableCheck) {
            return false;
        }
        if g.LastItemData.ItemFlags & ImGuiItemFlags_Disabled && !(flags & ImGuiHoveredFlags_AllowWhenDisabled) {
            return false;
        }
        if id == window.MoveId && window.WriteAccessed {
            return false;
        }
        if g.LastItemData.ItemFlags & ImGuiItemFlags_AllowOverlap && id != 0 {
            if (flags & ImGuiHoveredFlags_AllowWhenOverlappedByItem) == 0 {
                if g.HoveredIdPreviousFrame != g.LastItemData.ID {
                    return false;
                }
            }
        }
    }
    f32 delay = CalcDelayFromHoveredFlags(flags);
    if delay > 0.0f || flags & ImGuiHoveredFlags_Stationary {
        ImGuiID hover_delay_id = g.LastItemData.ID != 0 ? g.LastItemData.ID : ImGuiWindow_GetIDFromPos(window, g.LastItemData.Rect.Min);
        if flags & ImGuiHoveredFlags_NoSharedDelay && g.HoverItemDelayIdPreviousFrame != hover_delay_id {
            g.HoverItemDelayTimer = 0.0f;
        }
        g.HoverItemDelayId = hover_delay_id;
        if (flags & ImGuiHoveredFlags_Stationary) != 0 && g.HoverItemUnlockedStationaryId != hover_delay_id {
            return false;
        }
        if g.HoverItemDelayTimer < delay {
            return false;
        }
    }
    return true;
}

// Internal facing ItemHoverable() used when submitting widgets. THIS IS A SUBMISSION NOT A HOVER CHECK.
// Returns whether the item was hovered, logic differs slightly from IsItemHovered().
// (this does not rely on LastItemData it can be called from a ButtonBehavior() call not following an ItemAdd() call)
// FIXME-LEGACY: the 'ImGuiItemFlags item_flags' parameter was added on 2023-06-28.
// If you used this in your legacy/custom widgets code:
// - Commonly: if your ItemHoverable() call comes after an ItemAdd() call: pass 'item_flags = g.LastItemData.ItemFlags'.
// - Rare: otherwise you may pass 'item_flags = 0' (ImGuiItemFlags_None) unless you want to benefit from special behavior handled by ItemHoverable.
bool ImGui_ItemHoverable(ImRect bb, ImGuiID id, ImGuiItemFlags item_flags) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    when !(defined(IMGUI_DISABLE_DEBUG_TOOLS)) {
        if id != 0 && g.HoveredIdPreviousFrame == id && (item_flags & ImGuiItemFlags_AllowDuplicateId) == 0 {
            g.HoveredIdPreviousFrameItemCount++;
            if g.DebugDrawIdConflictsId == id {
                ImDrawList_AddRect(window.DrawList, op_sub_ImVec2_ImVec2(bb.Min, ImVec2{1.0f, 1.0f}), op_add_ImVec2_ImVec2(bb.Max, ImVec2{1.0f, 1.0f}), cast(ImU32, 255) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 0) << 8 | cast(ImU32, 255) << 0, 0.0f, 2.0f, 0);
            }
        }
    }
    if g.HoveredWindow != window {
        return false;
    }
    if ImGui_IsMouseHoveringRect(bb.Min, bb.Max) == 0 {
        return false;
    }
    if g.HoveredId != 0 && g.HoveredId != id && !g.HoveredIdAllowOverlap {
        return false;
    }
    if g.ActiveId != 0 && g.ActiveId != id && !g.ActiveIdAllowOverlap {
        if g.ActiveIdFromShortcut == 0 {
            return false;
        }
    }
    if !(item_flags & ImGuiItemFlags_NoWindowHoverableCheck) && !ImGui_IsWindowContentHoverable(window, ImGuiHoveredFlags_None) {
        g.HoveredIdIsDisabled = true;
        return false;
    }
    if id != 0 {
        if g.DragDropActive && g.DragDropPayload.SourceId == id && !(g.DragDropSourceFlags & ImGuiDragDropFlags_SourceNoDisableHover) {
            return false;
        }
        ImGui_SetHoveredID(id);
        if (item_flags & ImGuiItemFlags_AllowOverlap) != 0 {
            g.HoveredIdAllowOverlap = true;
            if g.HoveredIdPreviousFrame != id {
                return false;
            }
        }
        if id == g.LastItemData.ID && g.LastItemData.StatusFlags & ImGuiItemStatusFlags_HasShortcut && g.ActiveId != id {
            if ImGui_IsItemHovered(ImGuiHoveredFlags_ForTooltip | ImGuiHoveredFlags_DelayNormal) != 0 {
                ImGui_SetTooltip("%s", ImGui_GetKeyChordName(g.LastItemData.Shortcut));
            }
        }
    }
    if (item_flags & ImGuiItemFlags_Disabled) != 0 {
        if g.ActiveId == id && id != 0 {
            ImGui_ClearActiveID();
        }
        g.HoveredIdIsDisabled = true;
        return false;
    }
    when !(defined(IMGUI_DISABLE_DEBUG_TOOLS)) {
        if id != 0 {
            if g.DebugItemPickerActive && g.HoveredIdPreviousFrame == id {
                ImDrawList_AddRect(ImGui_GetForegroundDrawList(), bb.Min, bb.Max, cast(ImU32, 255) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 255) << 8 | cast(ImU32, 255) << 0, 0.0f, 1.0f, 0);
            }
            if g.DebugItemPickerBreakId == id {
                assert(0);
            }
        }
    }
    if g.NavHighlightItemUnderNav && (item_flags & ImGuiItemFlags_NoNavDisableMouseHover) == 0 {
        return false;
    }
    return true;
}

// FIXME: This is inlined/duplicated in ItemAdd()
// FIXME: The id != 0 path is not used by our codebase, may get rid of it?
bool ImGui_IsClippedEx(ImRect bb, ImGuiID id) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    if ImRect_Overlaps(&bb, window.ClipRect) == 0 {
        if id == 0 || id != g.ActiveId && id != g.ActiveIdPreviousFrame && id != g.NavId && id != g.NavActivateId {
            if g.ItemUnclipByLog == 0 {
                return true;
            }
        }
    }
    return false;
}

// This is also inlined in ItemAdd()
// Note: if ImGuiItemStatusFlags_HasDisplayRect is set, user needs to set g.LastItemData.DisplayRect.
void ImGui_SetLastItemData(ImGuiID item_id, ImGuiItemFlags item_flags, ImGuiItemStatusFlags status_flags, ImRect item_rect) {
    ImGuiContext* g = GImGui;
    g.LastItemData.ID = item_id;
    g.LastItemData.ItemFlags = item_flags;
    g.LastItemData.StatusFlags = status_flags;
    g.LastItemData.NavRect = item_rect;
    g.LastItemData.Rect = g.LastItemData.NavRect;
}

private {
void ImGui_SetLastItemDataForWindow(ImGuiWindow* window, ImRect rect) {
    ImGuiContext* g = GImGui;
    if window.DockIsActive != 0 {
        ImGui_SetLastItemData(window.MoveId, g.CurrentItemFlags, window.DC.DockTabItemStatusFlags, window.DC.DockTabItemRect);
    } else {
        ImGui_SetLastItemData(window.MoveId, g.CurrentItemFlags, window.DC.WindowItemStatusFlags, rect);
    }
}

void ImGui_SetLastItemDataForChildWindowItem(ImGuiWindow* window, ImRect rect) {
    ImGuiContext* g = GImGui;
    ImGui_SetLastItemData(window.ChildId, g.CurrentItemFlags, window.DC.ChildItemStatusFlags, rect);
}
}

f32 ImGui_CalcWrapWidthForPos(ImVec2 pos, f32 wrap_pos_x) {
    if wrap_pos_x < 0.0f {
        return 0.0f;
    }
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    if wrap_pos_x == 0.0f {
        wrap_pos_x = window.WorkRect.Max.x;
    } else if wrap_pos_x > 0.0f {
        wrap_pos_x += window.Pos.x - window.Scroll.x;
    }
    return ImMax(wrap_pos_x - pos.x, 1.0f);
}

// IM_ALLOC() == ImGui::MemAlloc()
void* ImGui_MemAlloc(u64 size) {
    void* ptr = GImAllocatorAllocFunc(size, GImAllocatorUserData);
    {
        ImGuiContext* ctx = GImGui;
        if ctx != null {
            ImGui_DebugAllocHook(&ctx.DebugAllocInfo, ctx.FrameCount, ptr, size);
        }
    }
    return ptr;
}

// IM_FREE() == ImGui::MemFree()
void ImGui_MemFree(void* ptr) {
    if ptr != null {
        ImGuiContext* ctx = GImGui;
        if ctx != null {
            ImGui_DebugAllocHook(&ctx.DebugAllocInfo, ctx.FrameCount, ptr, cast(u64, -1));
        }
    }
    return GImAllocatorFreeFunc(ptr, GImAllocatorUserData);
}

void ImGui_DemoMarker(u8* file, i32 line, u8* section) {
    ImGuiContext* g = GImGui;
    if g.DemoMarkerCallback != null {
        g.DemoMarkerCallback(file, line, section);
    }
}

// We record the number of allocation in recent frames, as a way to audit/sanitize our guiding principles of "no allocations on idle/repeating frames"
void ImGui_DebugAllocHook(ImGuiDebugAllocInfo* info, i32 frame_count, void* ptr, u64 size) {
}

