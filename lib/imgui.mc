ImGuiViewport* ImGui_GetMainViewport() {
    ImGuiContext* g = GImGui;
    return cast(ImGuiViewport*, g.Viewports.Data[0]);
}

// FIXME: This leaks access to viewports not listed in PlatformIO.Viewports[]. Problematic? (#4236)
ImGuiViewport* ImGui_FindViewportByID(ImGuiID viewport_id) {
    ImGuiContext* g = GImGui;
    {
        ImGuiViewportP** zz_rf_it_49 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_49 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_49 != zz_rf_end_49; zz_rf_it_49++ {
            ImGuiViewportP* viewport = *zz_rf_it_49;
            if viewport.ID == viewport_id {
                return cast(ImGuiViewport*, viewport);
            }
        }
