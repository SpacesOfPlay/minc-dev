    return zz_t;
}

void ImGuiPackedDate_init(ImGuiPackedDate* self, i32 yyyymmdd) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.Year = cast(ImU16, yyyymmdd / 10000 - 2000);
    self.Month = cast(ImU16, yyyymmdd / 100 % 100);
    self.Day = cast(ImU16, yyyymmdd % 100);
}

ImGuiPackedDate __cxx_make_ImGuiPackedDate(i32 yyyymmdd) {
    ImGuiPackedDate zz_mk;
    ImGuiPackedDate_init(&zz_mk, yyyymmdd);
    return zz_mk;
}

// Pack
bool ImGuiPackedDate_IsValid(ImGuiPackedDate* self) {
    return self.Year && self.Month && self.Day;
}

i32 ImGuiPackedDate_Unpack(ImGuiPackedDate* self) {
    return cast(i32, self.Year && self.Month && self.Day ? (self.Year + 2000) * 10000 + self.Month * 100 + self.Day : 0);
}

// Unpack
void ImGuiPackedDate_SubtractMonths(ImGuiPackedDate* self, i32 m) {
    while m > 0 {
        self.Year -= cast(ImU16, self.Month == 1);
        self.Month = cast(ImU16, self.Month == 1 ? 12 : self.Month - 1);
        m--;
    }
}

