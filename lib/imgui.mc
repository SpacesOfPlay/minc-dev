ImGuiDockContextPruneNodeData* ImPool_ImGuiDockContextPruneNodeData_GetOrAddByKey(ImPool_ImGuiDockContextPruneNodeData* self, ImGuiID key) {
    i32* p_idx = ImGuiStorage_GetIntRef(&self.Map, key, -1);
    if *p_idx != -1 {
        return &self.Buf.Data[*p_idx];
    }
    *p_idx = self.FreeIdx;
    return ImPool_ImGuiDockContextPruneNodeData_Add(self);
}

bool ImPool_ImGuiDockContextPruneNodeData_Contains(ImPool_ImGuiDockContextPruneNodeData* self, ImGuiDockContextPruneNodeData* p) {
    return p >= self.Buf.Data && p < self.Buf.Data + self.Buf.Size;
}

void ImPool_ImGuiDockContextPruneNodeData_Clear(ImPool_ImGuiDockContextPruneNodeData* self) {
    for i32 n = 0; n < self.Map.Data.Size; n++ {
        i32 idx = self.Map.Data.Data[n].val_i;
        if idx != -1 {
            self.Buf.Data[idx];
        }
    }
    ImGuiStorage_Clear(&self.Map);
    ImVector_ImGuiDockContextPruneNodeData_clear(&self.Buf);
    self.AliveCount = 0;
    self.FreeIdx = self.AliveCount;
}

ImGuiDockContextPruneNodeData* ImPool_ImGuiDockContextPruneNodeData_Add(ImPool_ImGuiDockContextPruneNodeData* self) {
    i32 idx = self.FreeIdx;
    if idx == self.Buf.Size {
        ImVector_ImGuiDockContextPruneNodeData_resize(&self.Buf, self.Buf.Size + 1);
        self.FreeIdx++;
    } else {
        self.FreeIdx = *cast(i32*, &self.Buf.Data[idx]);
    }
    ImGuiDockContextPruneNodeData_init(&self.Buf.Data[idx]);
    self.AliveCount++;
    return &self.Buf.Data[idx];
}

void ImPool_ImGuiDockContextPruneNodeData_Remove(ImPool_ImGuiDockContextPruneNodeData* self, ImGuiID key, ImGuiDockContextPruneNodeData* p) {
    ImPool_ImGuiDockContextPruneNodeData_Remove(self, key, ImPool_ImGuiDockContextPruneNodeData_GetIndex(self, p));
}

void ImPool_ImGuiDockContextPruneNodeData_Remove(ImPool_ImGuiDockContextPruneNodeData* self, ImGuiID key, ImPoolIdx idx) {
    self.Buf.Data[idx];
    *cast(i32*, &self.Buf.Data[idx]) = self.FreeIdx;
    self.FreeIdx = idx;
    ImGuiStorage_SetInt(&self.Map, key, -1);
    self.AliveCount--;
}

void ImPool_ImGuiDockContextPruneNodeData_Reserve(ImPool_ImGuiDockContextPruneNodeData* self, i32 capacity) {
    ImVector_ImGuiDockContextPruneNodeData_reserve(&self.Buf, capacity);
    ImVector_ImGuiStoragePair_reserve(&self.Map.Data, capacity);
}

i32 ImPool_ImGuiDockContextPruneNodeData_GetAliveCount(ImPool_ImGuiDockContextPruneNodeData* self) {
    return self.AliveCount;
}

i32 ImPool_ImGuiDockContextPruneNodeData_GetBufSize(ImPool_ImGuiDockContextPruneNodeData* self) {
    return self.Buf.Size;
}

i32 ImPool_ImGuiDockContextPruneNodeData_GetMapSize(ImPool_ImGuiDockContextPruneNodeData* self) {
    return self.Map.Data.Size;
}

ImGuiDockContextPruneNodeData* ImPool_ImGuiDockContextPruneNodeData_TryGetMapData(ImPool_ImGuiDockContextPruneNodeData* self, ImPoolIdx n) {
    i32 idx = self.Map.Data.Data[n].val_i;
    if idx == -1 {
        return null;
    }
    return ImPool_ImGuiDockContextPruneNodeData_GetByIndex(self, idx);
}

void ImChunkStream_ImGuiWindowSettings_clear(ImChunkStream_ImGuiWindowSettings* self) {
    ImVector_char_clear(&self.Buf);
}

bool ImChunkStream_ImGuiWindowSettings_empty(ImChunkStream_ImGuiWindowSettings* self) {
    return self.Buf.Size == 0;
}

i32 ImChunkStream_ImGuiWindowSettings_size(ImChunkStream_ImGuiWindowSettings* self) {
    return self.Buf.Size;
}

ImGuiWindowSettings* ImChunkStream_ImGuiWindowSettings_alloc_chunk(ImChunkStream_ImGuiWindowSettings* self, u64 sz) {
    u64 HDR_SZ = 4;
    sz = HDR_SZ + sz + cast(u64, 4 - 1) & cast(u64, ~(4 - 1));
    i32 off = self.Buf.Size;
    ImVector_char_resize(&self.Buf, off + cast(i32, sz));
    cast(i32*, cast(void*, self.Buf.Data + off))[0] = cast(i32, sz);
    return cast(ImGuiWindowSettings*, cast(void*, self.Buf.Data + off + cast(i32, HDR_SZ)));
}

ImGuiWindowSettings* ImChunkStream_ImGuiWindowSettings_begin(ImChunkStream_ImGuiWindowSettings* self) {
    u64 HDR_SZ = 4;
    if self.Buf.Data == null {
        return null;
    }
    return cast(ImGuiWindowSettings*, cast(void*, self.Buf.Data + HDR_SZ));
}

ImGuiWindowSettings* ImChunkStream_ImGuiWindowSettings_next_chunk(ImChunkStream_ImGuiWindowSettings* self, ImGuiWindowSettings* p) {
    u64 HDR_SZ = 4;
    assert(p >= ImChunkStream_ImGuiWindowSettings_begin(self) && p < ImChunkStream_ImGuiWindowSettings_end(self));
    p = cast(ImGuiWindowSettings*, cast(void*, cast(u8*, cast(void*, p)) + ImChunkStream_ImGuiWindowSettings_chunk_size(self, p)));
    if p == cast(ImGuiWindowSettings*, cast(void*, cast(u8*, ImChunkStream_ImGuiWindowSettings_end(self)) + HDR_SZ)) {
        return cast(ImGuiWindowSettings*, 0);
    }
    assert(p < ImChunkStream_ImGuiWindowSettings_end(self));
    return p;
}

i32 ImChunkStream_ImGuiWindowSettings_chunk_size(ImChunkStream_ImGuiWindowSettings* self, ImGuiWindowSettings* p) {
    return cast(i32*, p)[-1];
}

ImGuiWindowSettings* ImChunkStream_ImGuiWindowSettings_end(ImChunkStream_ImGuiWindowSettings* self) {
    return cast(ImGuiWindowSettings*, cast(void*, self.Buf.Data + self.Buf.Size));
}

i32 ImChunkStream_ImGuiWindowSettings_offset_from_ptr(ImChunkStream_ImGuiWindowSettings* self, ImGuiWindowSettings* p) {
    assert(p >= ImChunkStream_ImGuiWindowSettings_begin(self) && p < ImChunkStream_ImGuiWindowSettings_end(self));
    var off = cast(i64, cast(u8*, p) - self.Buf.Data);
    return cast(i32, off);
}

ImGuiWindowSettings* ImChunkStream_ImGuiWindowSettings_ptr_from_offset(ImChunkStream_ImGuiWindowSettings* self, i32 off) {
    assert(off >= 4 && off < self.Buf.Size);
    return cast(ImGuiWindowSettings*, cast(void*, self.Buf.Data + off));
}

void ImChunkStream_ImGuiWindowSettings_swap(ImChunkStream_ImGuiWindowSettings* self, ImChunkStream_ImGuiWindowSettings* rhs) {
    ImVector_char_swap(&rhs.Buf, &self.Buf);
}

