ImU64 ImGui_DebugTextureIDToU64(ImTextureID tex_id) {
    ImU64 v = 0;
    memcpy(&v, &tex_id, cast(u64, ImMin(cast(i32, sizeof(ImU64)), cast(i32, sizeof(ImTextureID)))));
    return v;
}

private {
u8* FormatTextureRefForDebugDisplay(u8* buf, i32 buf_size, ImTextureRef tex_ref) {
    u8* buf_p = buf;
    u8* buf_end = buf + buf_size;
    if tex_ref._TexData != null {
        buf_p += ImFormatString(buf_p, cast(u64, cast(i64, buf_end - buf_p)), "#%03d: ", tex_ref._TexData.UniqueID);
    }
    ImFormatString(buf_p, cast(u64, cast(i64, buf_end - buf_p)), "0x%X", ImGui_DebugTextureIDToU64(ImTextureRef_GetTexID(&tex_ref)));
    return buf;
}
}

