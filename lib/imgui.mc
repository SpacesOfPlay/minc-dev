void ImColor_init(ImColor* self, i32 r, i32 g, i32 b, i32 a) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.Value = ImVec4{
        cast(f32, r) * (1.0f / 255.0f), cast(f32, g) * (1.0f / 255.0f),
        cast(f32, b) * (1.0f / 255.0f), cast(f32, a) * (1.0f / 255.0f),
    };
