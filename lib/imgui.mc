}

bool ImGui_IsNamedKey(ImGuiKey key) {
    return key >= ImGuiKey_NamedKey_BEGIN && key < ImGuiKey_NamedKey_END;
}

bool ImGui_IsNamedKeyOrMod(ImGuiKey key) {
    return key >= ImGuiKey_NamedKey_BEGIN && key < ImGuiKey_NamedKey_END || key == ImGuiMod_Ctrl || key == ImGuiMod_Shift || key == ImGuiMod_Alt || key == ImGuiMod_Super;
}

bool ImGui_IsLegacyKey(ImGuiKey key) {
    return key >= 0 && key < 512;
}

bool ImGui_IsKeyboardKey(ImGuiKey key) {
    return key >= ImGuiKey_NamedKey_BEGIN && key < ImGuiKey_GamepadStart;
}

bool ImGui_IsGamepadKey(ImGuiKey key) {
    return key >= ImGuiKey_GamepadStart && key < ImGuiKey_GamepadRStickDown + 1;
}

bool ImGui_IsMouseKey(ImGuiKey key) {
    return key >= ImGuiKey_MouseLeft && key < ImGuiKey_MouseWheelY + 1;
}

bool ImGui_IsAliasKey(ImGuiKey key) {
    return key >= ImGuiKey_MouseLeft && key < ImGuiKey_MouseWheelY + 1;
}

bool ImGui_IsLRModKey(ImGuiKey key) {
    return key >= ImGuiKey_LeftCtrl && key <= ImGuiKey_RightSuper;
}

ImGuiKey ImGui_ConvertSingleModFlagToKey(ImGuiKey key) {
    if key == ImGuiMod_Ctrl {
        return ImGuiKey_ReservedForModCtrl;
    }
    if key == ImGuiMod_Shift {
        return ImGuiKey_ReservedForModShift;
    }
    if key == ImGuiMod_Alt {
        return ImGuiKey_ReservedForModAlt;
    }
    if key == ImGuiMod_Super {
        return ImGuiKey_ReservedForModSuper;
    }
    return key;
}

ImGuiKeyData* ImGui_GetKeyData(ImGuiKey key) {
    ImGuiContext* g = GImGui;
    return ImGui_GetKeyData(g, key);
}

ImGuiKey ImGui_MouseButtonToKey(ImGuiMouseButton button) {
    assert(button >= 0 && button < ImGuiMouseButton_COUNT);
    return cast(ImGuiKey, ImGuiKey_MouseLeft + button);
}

bool ImGui_IsActiveIdUsingNavDir(ImGuiDir dir) {
    ImGuiContext* g = GImGui;
    return (g.ActiveIdUsingNavDirMask & cast(u32, 1 << dir)) != 0;
}

ImGuiKeyOwnerData* ImGui_GetKeyOwnerData(ImGuiContext* ctx, ImGuiKey key) {
    if (key & ImGuiMod_Mask_) != 0 {
        key = ImGui_ConvertSingleModFlagToKey(key);
    }
    assert(cast(i64, ImGui_IsNamedKey(key)));
    return &ctx.KeysOwnerData[key - ImGuiKey_NamedKey_BEGIN];
}

ImGuiDockNode* ImGui_DockNodeGetRootNode(ImGuiDockNode* node) {
    while node.ParentNode != null {
        node = node.ParentNode;
    }
    return node;
}

bool ImGui_DockNodeIsInHierarchyOf(ImGuiDockNode* node, ImGuiDockNode* parent) {
    while node != null {
        if node == parent {
            return true;
        }
        node = node.ParentNode;
    }
    return false;
}

i32 ImGui_DockNodeGetDepth(ImGuiDockNode* node) {
    i32 depth = 0;
    while node.ParentNode != null {
        node = node.ParentNode;
        depth++;
    }
    return depth;
}

ImGuiID ImGui_DockNodeGetWindowMenuButtonId(ImGuiDockNode* node) {
    return ImHashStr("#COLLAPSE", 0, node.ID);
}

ImGuiDockNode* ImGui_GetWindowDockNode() {
    ImGuiContext* g = GImGui;
    return g.CurrentWindow.DockNode;
}

ImGuiDockNode* ImGui_DockBuilderGetCentralNode(ImGuiID node_id) {
    ImGuiDockNode* node = ImGui_DockBuilderGetNode(node_id);
    if node == null {
        return null;
    }
    return ImGui_DockNodeGetRootNode(node).CentralNode;
}

ImGuiID ImGui_GetCurrentFocusScope() {
    ImGuiContext* g = GImGui;
    return g.CurrentFocusScopeId;
}

ImGuiBoxSelectState* ImGui_GetBoxSelectState(ImGuiID id) {
    ImGuiContext* g = GImGui;
    return id != 0 && g.BoxSelectState.ID == id && g.BoxSelectState.IsActive ? &g.BoxSelectState : null;
}

ImGuiMultiSelectState* ImGui_GetMultiSelectState(ImGuiID id) {
