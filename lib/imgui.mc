// Known size hash
// It is ok to call ImHashData on a string with known length but the ### operator won't be supported.
// FIXME-OPT: Replace with e.g. FNV1a hash? CRC32 pretty much randomly access 1KB. Need to do proper measurements.
ImGuiID ImHashData(void* data_p, u64 data_size, ImGuiID seed) {
    ImU32 crc = ~seed;
    var data = cast(u8*, data_p);
    u8* data_end = cast(u8*, data_p) + data_size;
    ImU32* crc32_lut = GCrc32LookupTable;
    while data < data_end {
        crc = crc >> 8 ^ crc32_lut[crc & 0xFF ^ *data++];
    }
    return ~crc;
}

// Zero-terminated string hash, with support for ### to reset back to seed value.
// e.g. "label###id" outputs the same hash as "id" (and "label" is generally displayed by the UI functions)
// FIXME-OPT: Replace with e.g. FNV1a hash? CRC32 pretty much randomly access 1KB. Need to do proper measurements.
ImGuiID ImHashStr(u8* data_p, u64 data_size, ImGuiID seed) {
    seed = ~seed;
    ImU32 crc = seed;
    var data = cast(u8*, data_p);
    ImU32* crc32_lut = GCrc32LookupTable;
    if data_size != 0 {
        while data_size-- > 0 {
            u8 c = *data++;
            if c == 35 && data_size >= 2 && data[0] == 35 && data[1] == 35 {
                crc = seed;
                data += 2;
                data_size -= 2;
                continue;
            }
            crc = crc >> 8 ^ crc32_lut[crc & 0xFF ^ c];
        }
    } else {
        u8 c;
        while true {
            c = *data++;
            if c == 0 {
                break;
            }
            if c == 35 && data[0] == 35 && data[1] == 35 {
                crc = seed;
                data += 2;
                continue;
            }
            crc = crc >> 8 ^ crc32_lut[crc & 0xFF ^ c];
        }
    }
    return ~crc;
}

// Skip to the "###" marker if any. We don't skip past to match the behavior of GetID()
// FIXME-OPT: This is not designed to be optimal. Use with care.
u8* ImHashSkipUncontributingPrefix(u8* label) {
    u8* result = label;
    u8 c;
    while true {
        c = cast(u8, *label++);
        if c == 0 {
            break;
        }
        if c == 35 && label[0] == 35 && label[1] == 35 {
            result = label + 2;
        }
    }
    return result;
}

//-----------------------------------------------------------------------------
// [SECTION] MISC HELPERS/UTILITIES (File functions)
//-----------------------------------------------------------------------------
// Default file functions
// Helper: Load file content into memory
// Memory allocated with IM_ALLOC(), must be freed by user using IM_FREE() == ImGui::MemFree()
// This can't really be used with "rt" because fseek size won't match read size.
void* ImFileLoadToMemory(u8* filename, u8* mode, u64* out_file_size, i32 padding_bytes) {
    assert(filename && mode);
    if out_file_size != null {
        *out_file_size = 0;
    }
    ImFileHandle f;
    f = ImFileOpen(filename, mode);
    if f == null {
        return null;
    }
    var file_size = cast(u64, ImFileGetSize(f));
    if file_size == cast(u64, -1) {
        ImFileClose(f);
        return null;
    }
    void* file_data = ImGui_MemAlloc(file_size + cast(u64, padding_bytes));
    if file_data == null {
        ImFileClose(f);
        return null;
    }
    if ImFileRead(file_data, 1, file_size, f) != file_size {
        ImFileClose(f);
        ImGui_MemFree(file_data);
        return null;
    }
    if padding_bytes > 0 {
        memset(cast(void*, cast(u8*, file_data) + file_size), 0, cast(u64, padding_bytes));
    }
    ImFileClose(f);
    if out_file_size != null {
        *out_file_size = file_size;
    }
    return file_data;
}

//-----------------------------------------------------------------------------
// [SECTION] MISC HELPERS/UTILITIES (ImText* functions)
//-----------------------------------------------------------------------------
// Convert UTF-8 to 32-bit character, process single character input.
// A nearly-branchless UTF-8 decoder, based on work of Christopher Wellons (https://github.com/skeeto/branchless-utf8).
// We handle UTF-8 decoding error by skipping forward.
i32 ImTextCharFromUtf8(u32* out_char, u8* in_text, u8* in_text_end) {
    i32 len = ImTextCharFromUtf8__lengths[cast(i32, *cast(u8*, in_text)) >> 3];
    i32 wanted = len + (len != 0 ? 0 : 1);
    if in_text_end == null {
        in_text_end = in_text + wanted;
    }
    u8[4] s;
    s[0] = cast(u8, in_text + 0 < in_text_end ? in_text[0] : 0);
    s[1] = cast(u8, in_text + 1 < in_text_end ? in_text[1] : 0);
    s[2] = cast(u8, in_text + 2 < in_text_end ? in_text[2] : 0);
    s[3] = cast(u8, in_text + 3 < in_text_end ? in_text[3] : 0);
    *out_char = cast(u32, s[0] & ImTextCharFromUtf8__masks[len]) << 18;
    *out_char |= cast(u32, s[1] & 0x3f) << 12;
    *out_char |= cast(u32, s[2] & 0x3f) << 6;
    *out_char |= cast(u32, s[3] & 0x3f) << 0;
    *out_char >>= cast(u32, ImTextCharFromUtf8__shiftc[len]);
    i32 e = 0;
    e = cast(i32, *out_char < ImTextCharFromUtf8__mins[len]) << 6;
    e |= cast(i32, *out_char >> 11 == 0x1b) << 7;
    e |= cast(i32, *out_char > 0xFFFF) << 8;
    e |= cast(i32, s[1] & 0xc0) >> 2;
    e |= cast(i32, s[2] & 0xc0) >> 4;
    e |= cast(i32, s[3]) >> 6;
    e ^= 0x2a;
    e >>= ImTextCharFromUtf8__shifte[len];
    if e != 0 {
        wanted = ImMin(wanted, cast(i32, !!s[0]) + cast(i32, !!s[1]) + cast(i32, !!s[2]) + cast(i32, !!s[3]));
        *out_char = 0xFFFD;
    }
    return wanted;
}

i32 ImTextStrFromUtf8(ImWchar* buf, i32 buf_size, u8* in_text, u8* in_text_end, u8** in_text_remaining) {
    ImWchar* buf_out = buf;
    ImWchar* buf_end = buf + buf_size;
    while buf_out < buf_end - 1 && (!in_text_end || in_text < in_text_end) && *in_text {
        u32 c;
        in_text += ImTextCharFromUtf8(&c, in_text, in_text_end);
        *buf_out++ = cast(ImWchar, c);
    }
    *buf_out = 0;
    if in_text_remaining != null {
        *in_text_remaining = in_text;
    }
    return cast(i32, cast(i64, buf_out - buf));
}

i32 ImTextCountCharsFromUtf8(u8* in_text, u8* in_text_end) {
    i32 char_count = 0;
    while (!in_text_end || in_text < in_text_end) && *in_text {
        u32 c;
        in_text += ImTextCharFromUtf8(&c, in_text, in_text_end);
        char_count++;
    }
    return char_count;
}

// Based on stb_to_utf8() from github.com/nothings/stb/
private {
i32 ImTextCharToUtf8_inline(u8* buf, i32 buf_size, u32 c) {
    if c < 0x80 {
        buf[0] = cast(u8, c);
        return 1;
    }
    if c < 0x800 {
        if buf_size < 2 {
            return 0;
        }
        buf[0] = cast(u8, 0xc0 + (c >> 6));
        buf[1] = cast(u8, 0x80 + (c & 0x3f));
        return 2;
    }
    if c < 0x10000 {
        if buf_size < 3 {
            return 0;
        }
        buf[0] = cast(u8, 0xe0 + (c >> 12));
        buf[1] = cast(u8, 0x80 + (c >> 6 & 0x3f));
        buf[2] = cast(u8, 0x80 + (c & 0x3f));
        return 3;
    }
    if c <= 0x10FFFF {
        if buf_size < 4 {
            return 0;
        }
        buf[0] = cast(u8, 0xf0 + (c >> 18));
        buf[1] = cast(u8, 0x80 + (c >> 12 & 0x3f));
        buf[2] = cast(u8, 0x80 + (c >> 6 & 0x3f));
        buf[3] = cast(u8, 0x80 + (c & 0x3f));
        return 4;
    }
    return 0;
}
}

i32 ImTextCharToUtf8(u8* out_buf, u32 c) {
    i32 count = ImTextCharToUtf8_inline(out_buf, 5, c);
    out_buf[count] = 0;
    return count;
}

// Not optimal but we very rarely use this function.
i32 ImTextCountUtf8BytesFromChar(u8* in_text, u8* in_text_end) {
    u32 unused_var = 0;  // renamed from: unused
    return ImTextCharFromUtf8(&unused_var, in_text, in_text_end);
}

private {
i32 ImTextCountUtf8BytesFromChar(u32 c) {
    if c < 0x80 {
        return 1;
    }
    if c < 0x800 {
        return 2;
    }
    if c < 0x10000 {
        return 3;
    }
    if c <= 0x10FFFF {
        return 4;
    }
    return 3;
}
}

i32 ImTextStrToUtf8(u8* out_buf, i32 out_buf_size, ImWchar* in_text, ImWchar* in_text_end) {
    u8* buf_p = out_buf;
    u8* buf_end = out_buf + out_buf_size;
    while buf_p < buf_end - 1 && (!in_text_end || in_text < in_text_end) && *in_text {
        var c = cast(u32, *in_text++);
        if c < 0x80 {
            *buf_p++ = cast(u8, c);
        } else {
            buf_p += ImTextCharToUtf8_inline(buf_p, cast(i32, cast(i64, buf_end - buf_p) - 1), c);
        }
    }
    *buf_p = 0;
    return cast(i32, cast(i64, buf_p - out_buf));
}

i32 ImTextCountUtf8BytesFromStr(ImWchar* in_text, ImWchar* in_text_end) {
    i32 bytes_count = 0;
    while (!in_text_end || in_text < in_text_end) && *in_text {
        var c = cast(u32, *in_text++);
        if c < 0x80 {
            bytes_count++;
        } else {
            bytes_count += ImTextCountUtf8BytesFromChar(c);
        }
    }
    return bytes_count;
}

u8* ImTextFindPreviousUtf8Codepoint(u8* in_text_start, u8* in_p) {
    while in_p > in_text_start {
        in_p--;
        if (cast(i32, *in_p) & 0xC0) != 0x80 {
            return in_p;
        }
    }
    return in_text_start;
}

u8* ImTextFindValidUtf8CodepointEnd(u8* in_text_start, u8* in_text_end, u8* in_p) {
    if in_text_start == in_p {
        return in_text_start;
    }
    u8* prev = ImTextFindPreviousUtf8Codepoint(in_text_start, in_p);
    u32 prev_c;
    i32 prev_c_len = ImTextCharFromUtf8(&prev_c, prev, in_text_end);
    if prev_c != 0xFFFD && prev_c_len <= cast(i32, cast(i64, in_p - prev)) {
        return in_p;
    }
    return prev;
}

i32 ImTextCountLines(u8* in_text, u8* in_text_end) {
    if in_text_end == null {
        in_text_end = in_text + strlen(in_text);
    }
    i32 count = 0;
    while in_text < in_text_end {
        var line_end = cast(u8*, memchr(in_text, 10, cast(i64, in_text_end - in_text)));
        in_text = line_end != null ? line_end + 1 : in_text_end;
        count++;
    }
    return count;
}

//-----------------------------------------------------------------------------
// [SECTION] MISC HELPERS/UTILITIES (Color functions)
// Note: The Convert functions are early design which are not consistent with other API.
//-----------------------------------------------------------------------------
ImU32 ImAlphaBlendColors(ImU32 col_a, ImU32 col_b) {
    f32 t = cast(f32, col_b >> 24 & 0xFF) / 255.0f;
    i32 r = ImLerp(cast(i32, col_a >> 0) & 0xFF, cast(i32, col_b >> 0) & 0xFF, t);
    i32 g = ImLerp(cast(i32, col_a >> 8) & 0xFF, cast(i32, col_b >> 8) & 0xFF, t);
    i32 b = ImLerp(cast(i32, col_a >> 16) & 0xFF, cast(i32, col_b >> 16) & 0xFF, t);
    return cast(ImU32, 0xFF) << 24 | cast(ImU32, b) << 16 | cast(ImU32, g) << 8 | cast(ImU32, r) << 0;
}

ImVec4 ImGui_ColorConvertU32ToFloat4(ImU32 in) {
    f32 s = 1.0f / 255.0f;
    return ImVec4{
        cast(f32, in >> 0 & 0xFF) * s, cast(f32, in >> 8 & 0xFF) * s,
        cast(f32, in >> 16 & 0xFF) * s, cast(f32, in >> 24 & 0xFF) * s,
    };
}

ImU32 ImGui_ColorConvertFloat4ToU32(ImVec4 in) {
    ImU32 out;
    out = cast(ImU32, cast(i32, ImSaturate(in.x) * 255.0f + 0.5f)) << 0;
    out |= cast(ImU32, cast(i32, ImSaturate(in.y) * 255.0f + 0.5f)) << 8;
    out |= cast(ImU32, cast(i32, ImSaturate(in.z) * 255.0f + 0.5f)) << 16;
    out |= cast(ImU32, cast(i32, ImSaturate(in.w) * 255.0f + 0.5f)) << 24;
    return out;
}

// Convert rgb floats ([0-1],[0-1],[0-1]) to hsv floats ([0-1],[0-1],[0-1]), from Foley & van Dam p592
// Optimized http://lolengine.net/blog/2013/01/13/fast-rgb-to-hsv
void ImGui_ColorConvertRGBtoHSV(f32 r, f32 g, f32 b, f32* out_h, f32* out_s, f32* out_v) {
    f32 K = 0.0f;
    if g < b {
        { var zz_sw = g; g = b; b = zz_sw; }
        K = -1.0f;
    }
    if r < g {
        { var zz_sw = r; r = g; g = zz_sw; }
        K = -2.0f / 6.0f - K;
    }
    f32 chroma = r - (g < b ? g : b);
    *out_h = fabs(K + (g - b) / (6.0f * chroma + 1.0e-20f));
    *out_s = chroma / (r + 1.0e-20f);
    *out_v = r;
}

// Convert hsv floats ([0-1],[0-1],[0-1]) to rgb floats ([0-1],[0-1],[0-1]), from Foley & van Dam p593
// also http://en.wikipedia.org/wiki/HSL_and_HSV
void ImGui_ColorConvertHSVtoRGB(f32 h, f32 s, f32 v, f32* out_r, f32* out_g, f32* out_b) {
    if s == 0.0f {
        *out_b = v;
        *out_g = *out_b;
        *out_r = *out_g;
        return;
    }
    h = fmod(h, 1.0f) / (60.0f / 360.0f);
    var i = cast(i32, h);
    f32 f = h - cast(f32, i);
    f32 p = v * (1.0f - s);
    f32 q = v * (1.0f - s * f);
    f32 t = v * (1.0f - s * (1.0f - f));
    switch i {
        case 0: {
            *out_r = v;
            *out_g = t;
            *out_b = p;
        }
        case 1: {
            *out_r = q;
            *out_g = v;
            *out_b = p;
        }
        case 2: {
            *out_r = p;
            *out_g = v;
            *out_b = t;
        }
        case 3: {
            *out_r = p;
            *out_g = q;
            *out_b = v;
        }
        case 4: {
            *out_r = t;
            *out_g = p;
            *out_b = v;
        }
        case 5: {
            fallthrough;
        }
        default: {
            *out_r = v;
            *out_g = p;
            *out_b = q;
        }
    }
}

//-----------------------------------------------------------------------------
// [SECTION] ImGuiStorage
// Helper: Key->value storage
//-----------------------------------------------------------------------------
// std::lower_bound but without the bullshit
ImGuiStoragePair* ImLowerBound(ImGuiStoragePair* in_begin, ImGuiStoragePair* in_end, ImGuiID key) {
    ImGuiStoragePair* in_p = in_begin;
    var count = cast(u64, cast(i64, in_end - in_p));
    while count > 0 {
        u64 count2 = count >> 1;
        ImGuiStoragePair* mid = in_p + count2;
        if mid.key < key {
            in_p = ++mid;
            count -= count2 + 1;
        } else {
            count = count2;
        }
    }
    return in_p;
}

private {
i32 PairComparerByID(void* lhs, void* rhs) {
    ImGuiID lhs_v = cast(ImGuiStoragePair*, lhs).key;
    ImGuiID rhs_v = cast(ImGuiStoragePair*, rhs).key;
    return lhs_v > rhs_v ? 1 : lhs_v < rhs_v ? -1 : 0;
}
}

// For quicker full rebuild of a storage (instead of an incremental one), you may add all your contents and then sort once.
void ImGuiStorage_BuildSortByKey(ImGuiStorage* self) {
    ImQsort(self.Data.Data, cast(u64, self.Data.Size), cast(u64, sizeof(ImGuiStoragePair)), cast(fn(void*, void*): i32, PairComparerByID));
}

i32 ImGuiStorage_GetInt(ImGuiStorage* self, ImGuiID key, i32 default_val) {
    ImGuiStoragePair* it = ImLowerBound(self.Data.Data, self.Data.Data + self.Data.Size, key);
    if it == self.Data.Data + self.Data.Size || it.key != key {
        return default_val;
    }
    return it.val_i;
}

bool ImGuiStorage_GetBool(ImGuiStorage* self, ImGuiID key, bool default_val) {
    return ImGuiStorage_GetInt(self, key, default_val != 0 ? 1 : 0) != 0;
}

f32 ImGuiStorage_GetFloat(ImGuiStorage* self, ImGuiID key, f32 default_val) {
    ImGuiStoragePair* it = ImLowerBound(self.Data.Data, self.Data.Data + self.Data.Size, key);
    if it == self.Data.Data + self.Data.Size || it.key != key {
        return default_val;
    }
    return it.val_f;
}

void* ImGuiStorage_GetVoidPtr(ImGuiStorage* self, ImGuiID key) {
    ImGuiStoragePair* it = ImLowerBound(self.Data.Data, self.Data.Data + self.Data.Size, key);
    if it == self.Data.Data + self.Data.Size || it.key != key {
        return null;
    }
    return it.val_p;
}

// References are only valid until a new value is added to the storage. Calling a Set***() function or a Get***Ref() function invalidates the pointer.
i32* ImGuiStorage_GetIntRef(ImGuiStorage* self, ImGuiID key, i32 default_val) {
    ImGuiStoragePair* it = ImLowerBound(self.Data.Data, self.Data.Data + self.Data.Size, key);
    if it == self.Data.Data + self.Data.Size || it.key != key {
        it = ImVector_ImGuiStoragePair_insert(&self.Data, it, __cxx_make_ImGuiStoragePair(key, default_val));
    }
    return &it.val_i;
}

bool* ImGuiStorage_GetBoolRef(ImGuiStorage* self, ImGuiID key, bool default_val) {
    return cast(bool*, ImGuiStorage_GetIntRef(self, key, default_val != 0 ? 1 : 0));
}

f32* ImGuiStorage_GetFloatRef(ImGuiStorage* self, ImGuiID key, f32 default_val) {
    ImGuiStoragePair* it = ImLowerBound(self.Data.Data, self.Data.Data + self.Data.Size, key);
    if it == self.Data.Data + self.Data.Size || it.key != key {
        it = ImVector_ImGuiStoragePair_insert(&self.Data, it, __cxx_make_ImGuiStoragePair(key, default_val));
    }
    return &it.val_f;
}

void** ImGuiStorage_GetVoidPtrRef(ImGuiStorage* self, ImGuiID key, void* default_val) {
    ImGuiStoragePair* it = ImLowerBound(self.Data.Data, self.Data.Data + self.Data.Size, key);
    if it == self.Data.Data + self.Data.Size || it.key != key {
        it = ImVector_ImGuiStoragePair_insert(&self.Data, it, __cxx_make_ImGuiStoragePair(key, default_val));
    }
    return &it.val_p;
}

// FIXME-OPT: Need a way to reuse the result of lower_bound when doing GetInt()/SetInt() - not too bad because it only happens on explicit interaction (maximum one a frame)
void ImGuiStorage_SetInt(ImGuiStorage* self, ImGuiID key, i32 val) {
    ImGuiStoragePair* it = ImLowerBound(self.Data.Data, self.Data.Data + self.Data.Size, key);
    if it == self.Data.Data + self.Data.Size || it.key != key {
        ImVector_ImGuiStoragePair_insert(&self.Data, it, __cxx_make_ImGuiStoragePair(key, val));
    } else {
        it.val_i = val;
    }
}

void ImGuiStorage_SetBool(ImGuiStorage* self, ImGuiID key, bool val) {
    ImGuiStorage_SetInt(self, key, val != 0 ? 1 : 0);
}

void ImGuiStorage_SetFloat(ImGuiStorage* self, ImGuiID key, f32 val) {
    ImGuiStoragePair* it = ImLowerBound(self.Data.Data, self.Data.Data + self.Data.Size, key);
    if it == self.Data.Data + self.Data.Size || it.key != key {
        ImVector_ImGuiStoragePair_insert(&self.Data, it, __cxx_make_ImGuiStoragePair(key, val));
    } else {
        it.val_f = val;
    }
}

void ImGuiStorage_SetVoidPtr(ImGuiStorage* self, ImGuiID key, void* val) {
    ImGuiStoragePair* it = ImLowerBound(self.Data.Data, self.Data.Data + self.Data.Size, key);
    if it == self.Data.Data + self.Data.Size || it.key != key {
        ImVector_ImGuiStoragePair_insert(&self.Data, it, __cxx_make_ImGuiStoragePair(key, val));
    } else {
        it.val_p = val;
    }
}

void ImGuiStorage_SetAllInt(ImGuiStorage* self, i32 v) {
    for i32 i = 0; i < self.Data.Size; i++ {
        self.Data.Data[i].val_i = v;
    }
}

//-----------------------------------------------------------------------------
// [SECTION] ImGuiTextFilter
//-----------------------------------------------------------------------------
// Helper: Parse and apply text filters. In format "aaaaa[,bbbb][,ccccc]"
void ImGuiTextFilter_init(ImGuiTextFilter* self, u8* default_filter) {
    memset(self, 0, cast(u64, sizeof(*self)));
    ImVector_ImGuiTextRange_init(&self.Filters);
    self.InputBuf[0] = 0;
    self.CountGrep = 0;
    if default_filter != null {
        ImStrncpy(self.InputBuf, default_filter, cast(u64, cast(i32, sizeof(self.InputBuf) / sizeof(*self.InputBuf))));
        ImGuiTextFilter_Build(self);
    }
}

bool ImGuiTextFilter_Draw(ImGuiTextFilter* self, u8* label, f32 width) {
    if width != 0.0f {
        ImGui_SetNextItemWidth(width);
    }
    bool value_changed = ImGui_InputText(label, self.InputBuf, cast(u64, cast(i32, sizeof(self.InputBuf) / sizeof(*self.InputBuf))), 0, null, null);
    if value_changed != 0 {
        ImGuiTextFilter_Build(self);
    }
    return value_changed;
}

void ImGuiTextRange_split(ImGuiTextRange* self, u8 separator, ImVector_ImGuiTextRange* out) {
    ImVector_ImGuiTextRange_resize(out, 0);
    u8* wb = self.b;
    u8* we = wb;
    while we < self.e {
        if *we == separator {
            ImVector_ImGuiTextRange_push_back(out, ImGuiTextRange{wb, we});
            wb = we + 1;
        }
        we++;
    }
    if wb != we {
        ImVector_ImGuiTextRange_push_back(out, ImGuiTextRange{wb, we});
    }
}

void ImGuiTextFilter_Build(ImGuiTextFilter* self) {
    ImVector_ImGuiTextRange_resize(&self.Filters, 0);
    ImGuiTextRange input_range;
    ImGuiTextRange_init(&input_range, self.InputBuf, self.InputBuf + strlen(self.InputBuf));
    ImGuiTextRange_split(&input_range, 44, &self.Filters);
    self.CountGrep = 0;
    {
        ImGuiTextRange* zz_rf_it_2 = ImVector_ImGuiTextRange_begin(&self.Filters);
        ImGuiTextRange* zz_rf_end_2 = ImVector_ImGuiTextRange_end(&self.Filters);
        for ; zz_rf_it_2 != zz_rf_end_2; zz_rf_it_2++ {
            ImGuiTextRange* f = zz_rf_it_2;
            while f.b < f.e && ImCharIsBlankA(f.b[0]) {
                f.b++;
            }
            while f.e > f.b && ImCharIsBlankA(f.e[-1]) {
                f.e--;
            }
            if ImGuiTextRange_empty(f) != 0 {
                continue;
            }
            if f.b[0] != 45 {
                self.CountGrep += 1;
            }
        }
    }
}

bool ImGuiTextFilter_PassFilter(ImGuiTextFilter* self, u8* text, u8* text_end) {
    if self.Filters.Size == 0 {
        return true;
    }
    if text == null {
        text_end = "";
        text = text_end;
    }
    {
        ImGuiTextRange* zz_rf_it_3 = ImVector_ImGuiTextRange_begin(&self.Filters);
        ImGuiTextRange* zz_rf_end_3 = ImVector_ImGuiTextRange_end(&self.Filters);
        for ; zz_rf_it_3 != zz_rf_end_3; zz_rf_it_3++ {
            ImGuiTextRange f = *zz_rf_it_3;
            if f.b == f.e {
                continue;
            }
            if f.b[0] == 45 {
                if ImStristr(text, text_end, f.b + 1, f.e) != null {
                    return false;
                }
            } else {
                if ImStristr(text, text_end, f.b, f.e) != null {
                    return true;
                }
            }
        }
    }
    if self.CountGrep == 0 {
        return true;
    }
    return false;
}
//-----------------------------------------------------------------------------
// [SECTION] ImGuiTextBuffer, ImGuiTextIndex
//-----------------------------------------------------------------------------
// On some platform vsnprintf() takes va_list by reference and modifies it.
// va_copy is the 'correct' way to copy a va_list but Visual Studio prior to 2013 doesn't have it.
u8[1] ImGuiTextBuffer_EmptyString;

void ImGuiTextBuffer_append(ImGuiTextBuffer* self, u8* str_var, u8* str_end) {
    i32 len = str_end != null ? cast(i32, cast(i64, str_end - str_var)) : cast(i32, strlen(str_var));
    i32 write_off = self.Buf.Size != 0 ? self.Buf.Size : 1;
    i32 needed_sz = write_off + len;
    if write_off + len >= self.Buf.Capacity {
        i32 new_capacity = self.Buf.Capacity * 2;
        ImVector_char_reserve(&self.Buf, needed_sz > new_capacity ? needed_sz : new_capacity);
    }
    ImVector_char_resize(&self.Buf, needed_sz);
    memcpy(&self.Buf.Data[write_off - 1], str_var, cast(u64, len));
    self.Buf.Data[write_off - 1 + len] = 0;
}

void ImGuiTextBuffer_appendf(ImGuiTextBuffer* self, u8* fmt, ...) {
}

// Helper: Text buffer for logging/accumulating text
void ImGuiTextBuffer_appendfv(ImGuiTextBuffer* self, u8* fmt, void* args) {
}

void ImGuiTextIndex_append(ImGuiTextIndex* self, u8* base, i32 old_size, i32 new_size) {
    assert(old_size >= 0 && new_size >= old_size && new_size >= self.EndOffset);
    if old_size == new_size {
        return;
    }
    if self.EndOffset == 0 || base[self.EndOffset - 1] == 10 {
        ImVector_int_push_back(&self.Offsets, self.EndOffset);
    }
    u8* base_end = base + new_size;
    u8* p = base + old_size;
    while true {
        p = cast(u8*, memchr(p, 10, cast(i64, base_end - p)));
        if p != null == 0 {
            break;
        }
        if ++p < base_end {
            ImVector_int_push_back(&self.Offsets, cast(i32, cast(i64, p - base)));
        }
    }
    self.EndOffset = ImMax(self.EndOffset, new_size);
}

//-----------------------------------------------------------------------------
// [SECTION] ImGuiListClipper
//-----------------------------------------------------------------------------
// FIXME-TABLE: This prevents us from using ImGuiListClipper _inside_ a table cell.
// The problem we have is that without a Begin/End scheme for rows using the clipper is ambiguous.
private {
bool GetSkipItemForListClipping() {
    ImGuiContext* g = GImGui;
    return g.CurrentTable != null ? g.CurrentTable.HostSkipItems : g.CurrentWindow.SkipItems;
}

void ImGuiListClipper_SortAndFuseRanges(ImVector_ImGuiListClipperRange* ranges, i32 offset) {
    if ranges.Size - offset <= 1 { return; }
    for i32 sort_end = ranges.Size - offset - 1; sort_end > 0; sort_end = sort_end - 1 {
        for i32 i = offset; i < sort_end + offset; i = i + 1 {
            if ranges.Data[i].Min > ranges.Data[i + 1].Min {
                ImGuiListClipperRange zz_tmp = ranges.Data[i];
                ranges.Data[i] = ranges.Data[i + 1];
                ranges.Data[i + 1] = zz_tmp;
            }
        }
    }
    for i32 i = 1 + offset; i < ranges.Size; i = i + 1 {
        if ranges.Data[i - 1].Max < ranges.Data[i].Min { continue; }
        i32 zz_lo = ranges.Data[i - 1].Min; i32 zz_nlo = ranges.Data[i].Min;
        ranges.Data[i - 1].Min = zz_lo < zz_nlo ? zz_lo : zz_nlo;
        i32 zz_hi = ranges.Data[i - 1].Max; i32 zz_nhi = ranges.Data[i].Max;
        ranges.Data[i - 1].Max = zz_hi > zz_nhi ? zz_hi : zz_nhi;
        ImVector_ImGuiListClipperRange_erase(ranges, ranges.Data + i);
        i = i - 1;
    }
}

void ImGuiListClipper_SeekCursorAndSetupPrevLine(ImGuiListClipper* clipper, f32 pos_y, f32 line_height) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    f32 off_y = pos_y - window.DC.CursorPos.y;
    window.DC.CursorPos.y = pos_y;
    window.DC.CursorMaxPos.y = ImMax(window.DC.CursorMaxPos.y, pos_y - g.Style.ItemSpacing.y);
    window.DC.CursorPosPrevLine.y = window.DC.CursorPos.y - line_height;
    window.DC.PrevLineSize.y = line_height - g.Style.ItemSpacing.y;
    {
        ImGuiOldColumns* columns = window.DC.CurrentColumns;
        if columns != null {
            columns.LineMinY = window.DC.CursorPos.y;
        }
    }
    {
        ImGuiTable* table = g.CurrentTable;
        if table != null {
            if table.IsInsideRow != 0 {
                ImGui_TableEndRow(table);
            }
            var row_increase = cast(i32, off_y / line_height + 0.5f);
            if row_increase > 0 && (clipper.Flags & ImGuiListClipperFlags_NoSetTableRowCounters) == 0 {
                table.CurrentRow += row_increase;
                table.RowBgColorCounter += row_increase;
            }
            table.RowPosY2 = window.DC.CursorPos.y;
        }
    }
}
}

void ImGuiListClipper_init(ImGuiListClipper* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
}

void ImGuiListClipper_dtor(ImGuiListClipper* self) {
    ImGuiListClipper_End(self);
}

void ImGuiListClipper_Begin(ImGuiListClipper* self, i32 items_count, f32 items_height) {
    self.Ctx = ImGui_GetCurrentContext();
    ImGuiContext* g = self.Ctx;
    ImGuiWindow* window = g.CurrentWindow;
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventClipper) != 0 {
        }
        if !(0 != 0) { break; }
    }
    {
        ImGuiTable* table = g.CurrentTable;
        if table != null {
            if table.IsInsideRow != 0 {
                ImGui_TableEndRow(table);
            }
        }
    }
    self.StartPosY = window.DC.CursorPos.y;
    self.ItemsHeight = items_height;
    self.ItemsCount = items_count;
    self.DisplayStart = -1;
    self.DisplayEnd = 0;
    if ++g.ClipperTempDataStacked > g.ClipperTempData.Size {
        ImVector_ImGuiListClipperData_resize(&g.ClipperTempData, g.ClipperTempDataStacked, __cxx_make_ImGuiListClipperData());
    }
    ImGuiListClipperData* data = &g.ClipperTempData.Data[g.ClipperTempDataStacked - 1];
    ImGuiListClipperData_Reset(data, self);
    data.LossynessOffset = window.DC.CursorStartPosLossyness.y;
    self.TempData = data;
    self.StartSeekOffsetY = data.LossynessOffset;
}

void ImGuiListClipper_End(ImGuiListClipper* self) {
    {
        var data = cast(ImGuiListClipperData*, self.TempData);
        if data != null {
            ImGuiContext* g = self.Ctx;
            while true {
                if (g.DebugLogFlags & ImGuiDebugLogFlags_EventClipper) != 0 {
                }
                if !(0 != 0) { break; }
            }
            if self.ItemsCount >= 0 && self.ItemsCount < INT_MAX && self.DisplayStart >= 0 {
                ImGuiListClipper_SeekCursorForItem(self, self.ItemsCount);
            }
            assert(data.ListClipper == self);
            data.StepNo = data.Ranges.Size;
            if --g.ClipperTempDataStacked > 0 {
                data = &g.ClipperTempData.Data[g.ClipperTempDataStacked - 1];
                data.ListClipper.TempData = data;
            }
            self.TempData = null;
        }
    }
    self.DisplayEnd = self.ItemsCount;
    self.DisplayStart = self.DisplayEnd;
    self.ItemsCount = -1;
}

void ImGuiListClipper_IncludeItemsByIndex(ImGuiListClipper* self, i32 item_begin, i32 item_end) {
    var data = cast(ImGuiListClipperData*, self.TempData);
    assert(self.DisplayStart < 0);
    assert(item_begin <= item_end);
    if item_begin < item_end {
        ImVector_ImGuiListClipperRange_push_back(&data.Ranges, ImGuiListClipperRange_FromIndices(item_begin, item_end));
    }
}

// This is already called while stepping.
// The ONLY reason you may want to call this is if you passed INT_MAX to ImGuiListClipper::Begin() because you couldn't step item count beforehand.
void ImGuiListClipper_SeekCursorForItem(ImGuiListClipper* self, i32 item_n) {
    var pos_y = cast(f32, self.StartPosY + self.StartSeekOffsetY + cast(f64, item_n) * cast(f64, self.ItemsHeight));
    ImGuiListClipper_SeekCursorAndSetupPrevLine(self, pos_y, self.ItemsHeight);
}

private {
bool ImGuiListClipper_StepInternal(ImGuiListClipper* clipper) {
    ImGuiContext* g = clipper.Ctx;
    ImGuiWindow* window = g.CurrentWindow;
    var data = cast(ImGuiListClipperData*, clipper.TempData);
    assert(data != null && "Called ImGuiListClipper::Step() too many times, or before ImGuiListClipper::Begin() ?");
    ImGuiTable* table = g.CurrentTable;
    if table && table.IsInsideRow {
        ImGui_TableEndRow(table);
    }
    if clipper.ItemsCount == 0 || GetSkipItemForListClipping() {
        return false;
    }
    if data.StepNo == 0 && table != null && !table.IsUnfrozenRows {
        clipper.DisplayStart = data.ItemsFrozen;
        clipper.DisplayEnd = ImMin(data.ItemsFrozen + 1, clipper.ItemsCount);
        if clipper.DisplayStart < clipper.DisplayEnd {
            data.ItemsFrozen++;
        }
        return true;
    }
    bool calc_clipping = false;
    if data.StepNo == 0 {
        clipper.StartPosY = window.DC.CursorPos.y;
        if clipper.ItemsHeight <= 0.0f {
            ImVector_ImGuiListClipperRange_push_front(&data.Ranges, ImGuiListClipperRange_FromIndices(data.ItemsFrozen, data.ItemsFrozen + 1));
            clipper.DisplayStart = ImMax(data.Ranges.Data[0].Min, data.ItemsFrozen);
            clipper.DisplayEnd = ImMin(data.Ranges.Data[0].Max, clipper.ItemsCount);
            data.StepNo = 1;
            return true;
        }
        calc_clipping = true;
    }
    if clipper.ItemsHeight <= 0.0f {
        assert(data.StepNo == 1);
        bool affected_by_floating_point_precision = ImIsFloatAboveGuaranteedIntegerPrecision(cast(f32, clipper.StartPosY)) || ImIsFloatAboveGuaranteedIntegerPrecision(window.DC.CursorPos.y);
        if affected_by_floating_point_precision != 0 {
            clipper.ItemsHeight = window.DC.PrevLineSize.y + g.Style.ItemSpacing.y;
            window.DC.CursorPos.y = cast(f32, clipper.StartPosY + cast(f64, clipper.ItemsHeight));
        } else {
            clipper.ItemsHeight = cast(f32, cast(f64, window.DC.CursorPos.y) - clipper.StartPosY) / cast(f32, clipper.DisplayEnd - clipper.DisplayStart);
        }
        if clipper.ItemsHeight == 0.0f && clipper.ItemsCount == INT_MAX {
            return false;
        }
        if clipper.ItemsHeight <= 0.0f {
            while true {
                if clipper.ItemsHeight > 0.0f == 0 {
                    if ImGui_ErrorLog("ImGuiListClipper: Failed to calculate item height! First item hasn't been submitted by user code, or has not moved the cursor vertically!") != 0 {
                        assert(clipper.ItemsHeight > 0.0f && "ImGuiListClipper: Failed to calculate item height! First item hasn't been submitted by user code, or has not moved the cursor vertically!");
                    }
                }
                if !(0 != 0) { break; }
            }
            return false;
        }
        if table != null {
            assert(cast(f64, table.RowPosY1) == clipper.StartPosY && table.RowPosY2 == window.DC.CursorPos.y);
        }
        calc_clipping = true;
    }
    i32 already_submitted = clipper.DisplayEnd;
    if calc_clipping != 0 {
        clipper.StartSeekOffsetY = cast(f64, data.LossynessOffset) - cast(f64, data.ItemsFrozen) * cast(f64, clipper.ItemsHeight);
        if g.LogEnabled != 0 {
            ImVector_ImGuiListClipperRange_push_back(&data.Ranges, ImGuiListClipperRange_FromIndices(0, clipper.ItemsCount));
        } else {
            bool is_nav_request = g.NavMoveScoringItems && g.NavWindow && g.NavWindow.RootWindowForNav == window.RootWindowForNav;
            i32 nav_off_min = is_nav_request && g.NavMoveClipDir == ImGuiDir_Up ? -1 : 0;
            i32 nav_off_max = is_nav_request && g.NavMoveClipDir == ImGuiDir_Down ? 1 : 0;
            if is_nav_request != 0 {
                ImVector_ImGuiListClipperRange_push_back(&data.Ranges, ImGuiListClipperRange_FromPositions(g.NavScoringRect.Min.y, g.NavScoringRect.Max.y, nav_off_min, nav_off_max));
                if ImRect_IsInverted(&g.NavScoringNoClipRect) == 0 {
                    ImVector_ImGuiListClipperRange_push_back(&data.Ranges, ImGuiListClipperRange_FromPositions(g.NavScoringNoClipRect.Min.y, g.NavScoringNoClipRect.Max.y, nav_off_min, nav_off_max));
                }
            }
            if is_nav_request && g.NavMoveFlags & ImGuiNavMoveFlags_IsTabbing && g.NavTabbingDir == -1 {
                ImVector_ImGuiListClipperRange_push_back(&data.Ranges, ImGuiListClipperRange_FromIndices(clipper.ItemsCount - 1, clipper.ItemsCount));
            }
            ImRect nav_rect_abs = ImGui_WindowRectRelToAbs(window, window.NavRectRel[0]);
            if g.NavId != 0 && window.NavLastIds[0] == g.NavId {
                ImVector_ImGuiListClipperRange_push_back(&data.Ranges, ImGuiListClipperRange_FromPositions(nav_rect_abs.Min.y, nav_rect_abs.Max.y, 0, 0));
            }
            f32 min_y = window.ClipRect.Min.y;
            f32 max_y = window.ClipRect.Max.y;
            ImGuiBoxSelectState* bs = &g.BoxSelectState;
            if bs.IsActive && bs.Window == window {
                f32 pad_y = g.Style.ItemSpacing.y;
                min_y -= pad_y;
                max_y += pad_y;
                if bs.UnclipMode != 0 {
                    ImVector_ImGuiListClipperRange_push_back(&data.Ranges, ImGuiListClipperRange_FromPositions(bs.UnclipRect.Min.y - pad_y, bs.UnclipRect.Max.y + pad_y, 0, 0));
                }
            }
            ImVector_ImGuiListClipperRange_push_back(&data.Ranges, ImGuiListClipperRange_FromPositions(min_y, max_y, nav_off_min, nav_off_max));
        }
        {
            ImGuiListClipperRange* zz_rf_it_4 = ImVector_ImGuiListClipperRange_begin(&data.Ranges);
            ImGuiListClipperRange* zz_rf_end_4 = ImVector_ImGuiListClipperRange_end(&data.Ranges);
            for ; zz_rf_it_4 != zz_rf_end_4; zz_rf_it_4++ {
                ImGuiListClipperRange* range = zz_rf_it_4;
                if range.PosToIndexConvert != 0 {
                    var m1 = cast(i32, (cast(f64, range.Min) - cast(f64, window.DC.CursorPos.y) - cast(f64, data.LossynessOffset)) / cast(f64, clipper.ItemsHeight));
                    var m2 = cast(i32, (cast(f64, range.Max) - cast(f64, window.DC.CursorPos.y) - cast(f64, data.LossynessOffset)) / cast(f64, clipper.ItemsHeight) + 0.999999f);
                    range.Min = ImClamp(already_submitted + m1 + range.PosToIndexOffsetMin, already_submitted, clipper.ItemsCount - 1);
                    range.Max = ImClamp(already_submitted + m2 + range.PosToIndexOffsetMax, range.Min + 1, clipper.ItemsCount);
                    range.PosToIndexConvert = false;
                }
            }
        }
        ImGuiListClipper_SortAndFuseRanges(&data.Ranges, data.StepNo);
    }
    while data.StepNo < data.Ranges.Size {
        clipper.DisplayStart = ImMax(data.Ranges.Data[data.StepNo].Min, already_submitted);
        clipper.DisplayEnd = ImMin(data.Ranges.Data[data.StepNo].Max, clipper.ItemsCount);
        data.StepNo++;
        if clipper.DisplayStart >= clipper.DisplayEnd {
            continue;
        }
        if clipper.DisplayStart > already_submitted {
            ImGuiListClipper_SeekCursorForItem(clipper, clipper.DisplayStart);
        }
        return true;
    }
    if clipper.ItemsCount < INT_MAX {
        ImGuiListClipper_SeekCursorForItem(clipper, clipper.ItemsCount);
    }
    return false;
}
}

bool ImGuiListClipper_Step(ImGuiListClipper* self) {
    ImGuiContext* g = self.Ctx;
    bool need_items_height = self.ItemsHeight <= 0.0f;
    bool ret = ImGuiListClipper_StepInternal(self);
    if ret && self.DisplayStart >= self.DisplayEnd {
        ret = false;
    }
    if g.CurrentTable && g.CurrentTable.IsUnfrozenRows == false {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventClipper) != 0 {
            }
            if !(0 != 0) { break; }
        }
    }
    if need_items_height && self.ItemsHeight > 0.0f {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventClipper) != 0 {
            }
            if !(0 != 0) { break; }
        }
    }
    if ret != 0 {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventClipper) != 0 {
            }
            if !(0 != 0) { break; }
        }
    } else {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventClipper) != 0 {
            }
            if !(0 != 0) { break; }
        }
        ImGuiListClipper_End(self);
    }
    return ret;
}

// Generic helper, equivalent to old ImGui::CalcListClipping() but stateless
void ImGui_CalcClipRectVisibleItemsY(ImRect clip_rect, ImVec2 pos, f32 items_height, i32* out_visible_start, i32* out_visible_end) {
    *out_visible_start = ImMax(cast(i32, (clip_rect.Min.y - pos.y) / items_height), 0);
    *out_visible_end = ImMax(cast(i32, ceil((clip_rect.Max.y - pos.y) / items_height)), *out_visible_start);
}

//-----------------------------------------------------------------------------
// [SECTION] STYLING
//-----------------------------------------------------------------------------
ImGuiStyle* ImGui_GetStyle() {
    assert(GImGui != null && "No current context. Did you call ImGui::CreateContext() and ImGui::SetCurrentContext() ?");
    return &GImGui.Style;
}

ImU32 ImGui_GetColorU32(ImGuiCol idx, f32 alpha_mul) {
    ImGuiStyle* style = &GImGui.Style;
    ImVec4 c = style.Colors[idx];
    c.w *= style.Alpha * alpha_mul;
    return ImGui_ColorConvertFloat4ToU32(c);
}

ImU32 ImGui_GetColorU32(ImVec4 col) {
    ImGuiStyle* style = &GImGui.Style;
    ImVec4 c = col;
    c.w *= style.Alpha;
    return ImGui_ColorConvertFloat4ToU32(c);
}

ImVec4* ImGui_GetStyleColorVec4(ImGuiCol idx) {
    ImGuiStyle* style = &GImGui.Style;
    return &style.Colors[idx];
}

ImU32 ImGui_GetColorU32(ImU32 col, f32 alpha_mul) {
    ImGuiStyle* style = &GImGui.Style;
    alpha_mul *= style.Alpha;
    if alpha_mul >= 1.0f {
        return col;
    }
    ImU32 a = (col & 0xFF000000) >> 24;
    a = cast(ImU32, cast(f32, a) * alpha_mul);
    return col & cast(u32, ~0xFF000000) | a << 24;
}

// FIXME: This may incur a round-trip (if the end user got their data from a float4) but eventually we aim to store the in-flight colors as ImU32
void ImGui_PushStyleColor(ImGuiCol idx, ImU32 col) {
    ImGuiContext* g = GImGui;
    ImGuiColorMod backup;
    backup.Col = idx;
    backup.BackupValue = g.Style.Colors[idx];
    ImVector_ImGuiColorMod_push_back(&g.ColorStack, backup);
    if g.DebugFlashStyleColorIdx != idx {
        g.Style.Colors[idx] = ImGui_ColorConvertU32ToFloat4(col);
    }
}

void ImGui_PushStyleColor(ImGuiCol idx, ImVec4 col) {
    ImGuiContext* g = GImGui;
    ImGuiColorMod backup;
    backup.Col = idx;
    backup.BackupValue = g.Style.Colors[idx];
    ImVector_ImGuiColorMod_push_back(&g.ColorStack, backup);
    if g.DebugFlashStyleColorIdx != idx {
        g.Style.Colors[idx] = col;
    }
}

void ImGui_PopStyleColor(i32 count) {
    ImGuiContext* g = GImGui;
    if g.ColorStack.Size < count {
        while true {
            if 0 == 0 {
                if ImGui_ErrorLog("Calling PopStyleColor() too many times!") != 0 {
                    assert(0 && "Calling PopStyleColor() too many times!");
                }
            }
            if !(0 != 0) { break; }
        }
        count = g.ColorStack.Size;
    }
    while count > 0 {
        ImGuiColorMod* backup = ImVector_ImGuiColorMod_back(&g.ColorStack);
        g.Style.Colors[backup.Col] = backup.BackupValue;
        ImVector_ImGuiColorMod_pop_back(&g.ColorStack);
        count--;
    }
}
