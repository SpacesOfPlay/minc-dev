    return false;
}

bool DataTypeClampT_ImS64(ImS64* v, ImS64* v_min, ImS64* v_max) {
    if v_min && *v < *v_min {
        *v = *v_min;
        return true;
    }
    if v_max && *v > *v_max {
        *v = *v_max;
        return true;
    }
    return false;
}

