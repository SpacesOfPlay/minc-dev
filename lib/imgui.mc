    if *lhs < *rhs {
        return -1;
    }
    if *lhs > *rhs {
        return 1;
    }
    return 0;
}

i32 DataTypeCompareT_ImS32(ImS32* lhs, ImS32* rhs) {
    if *lhs < *rhs {
        return -1;
    }
    if *lhs > *rhs {
        return 1;
    }
    return 0;
}

i32 DataTypeCompareT_ImU32(ImU32* lhs, ImU32* rhs) {
    if *lhs < *rhs {
        return -1;
    }
    if *lhs > *rhs {
        return 1;
    }
    return 0;
}

i32 DataTypeCompareT_ImS64(ImS64* lhs, ImS64* rhs) {
    if *lhs < *rhs {
        return -1;
    }
    if *lhs > *rhs {
        return 1;
    }
    return 0;
}

i32 DataTypeCompareT_ImU64(ImU64* lhs, ImU64* rhs) {
    if *lhs < *rhs {
        return -1;
    }
    if *lhs > *rhs {
        return 1;
    }
    return 0;
}

i32 DataTypeCompareT_float(f32* lhs, f32* rhs) {
    if *lhs < *rhs {
        return -1;
    }
    if *lhs > *rhs {
        return 1;
    }
    return 0;
}

i32 DataTypeCompareT_double(f64* lhs, f64* rhs) {
    if *lhs < *rhs {
        return -1;
    }
    if *lhs > *rhs {
        return 1;
    }
    return 0;
}
}

i32 ImGui_DataTypeCompare(ImGuiDataType data_type, void* arg_1, void* arg_2) {
    switch data_type {
        case ImGuiDataType_S8: {
            return DataTypeCompareT_ImS8(cast(ImS8*, arg_1), cast(ImS8*, arg_2));
        }
        case ImGuiDataType_U8: {
            return DataTypeCompareT_ImU8(cast(ImU8*, arg_1), cast(ImU8*, arg_2));
        }
        case ImGuiDataType_S16: {
            return DataTypeCompareT_ImS16(cast(ImS16*, arg_1), cast(ImS16*, arg_2));
        }
        case ImGuiDataType_U16: {
            return DataTypeCompareT_ImU16(cast(ImU16*, arg_1), cast(ImU16*, arg_2));
        }
        case ImGuiDataType_S32: {
            return DataTypeCompareT_ImS32(cast(ImS32*, arg_1), cast(ImS32*, arg_2));
        }
        case ImGuiDataType_U32: {
            return DataTypeCompareT_ImU32(cast(ImU32*, arg_1), cast(ImU32*, arg_2));
        }
        case ImGuiDataType_S64: {
            return DataTypeCompareT_ImS64(cast(ImS64*, arg_1), cast(ImS64*, arg_2));
        }
        case ImGuiDataType_U64: {
            return DataTypeCompareT_ImU64(cast(ImU64*, arg_1), cast(ImU64*, arg_2));
        }
        case ImGuiDataType_Float: {
            return DataTypeCompareT_float(cast(f32*, arg_1), cast(f32*, arg_2));
        }
        case ImGuiDataType_Double: {
            return DataTypeCompareT_double(cast(f64*, arg_1), cast(f64*, arg_2));
        }
        case ImGuiDataType_COUNT: {
        }
    }
    assert(0);
    return 0;
}

private {
bool DataTypeClampT_ImS8(ImS8* v, ImS8* v_min, ImS8* v_max) {
    if v_min && *v < *v_min {
        *v = *v_min;
        return true;
    }
    if v_max && *v > *v_max {
        *v = *v_max;
        return true;
    }
    return false;
}

bool DataTypeClampT_ImU8(ImU8* v, ImU8* v_min, ImU8* v_max) {
    if v_min && *v < *v_min {
        *v = *v_min;
        return true;
