ImVec2 ImRect_GetCenter(ImRect* self) {
    return ImVec2{(self.Min.x + self.Max.x) * 0.5f, (self.Min.y + self.Max.y) * 0.5f};
}

ImVec2 ImRect_GetSize(ImRect* self) {
    return ImVec2{self.Max.x - self.Min.x, self.Max.y - self.Min.y};
}

f32 ImRect_GetWidth(ImRect* self) {
    return self.Max.x - self.Min.x;
}

f32 ImRect_GetHeight(ImRect* self) {
    return self.Max.y - self.Min.y;
}

f32 ImRect_GetArea(ImRect* self) {
    return (self.Max.x - self.Min.x) * (self.Max.y - self.Min.y);
}

ImVec2 ImRect_GetTL(ImRect* self) {
    return self.Min;
}

// Top-left
ImVec2 ImRect_GetTR(ImRect* self) {
    return ImVec2{self.Max.x, self.Min.y};
}

// Top-right
ImVec2 ImRect_GetBL(ImRect* self) {
    return ImVec2{self.Min.x, self.Max.y};
}

// Bottom-left
ImVec2 ImRect_GetBR(ImRect* self) {
    return self.Max;
}

// Bottom-right
bool ImRect_Contains(ImRect* self, ImVec2 p) {
    return p.x >= self.Min.x && p.y >= self.Min.y && p.x < self.Max.x && p.y < self.Max.y;
}

bool ImRect_Contains(ImRect* self, ImRect r) {
    return r.Min.x >= self.Min.x && r.Min.y >= self.Min.y && r.Max.x <= self.Max.x && r.Max.y <= self.Max.y;
}

bool ImRect_ContainsWithPad(ImRect* self, ImVec2 p, ImVec2 pad) {
    return p.x >= self.Min.x - pad.x && p.y >= self.Min.y - pad.y && p.x < self.Max.x + pad.x && p.y < self.Max.y + pad.y;
}

bool ImRect_Overlaps(ImRect* self, ImRect r) {
    return r.Min.y < self.Max.y && r.Max.y > self.Min.y && r.Min.x < self.Max.x && r.Max.x > self.Min.x;
}

void ImRect_Add(ImRect* self, ImVec2 p) {
    if self.Min.x > p.x {
        self.Min.x = p.x;
    }
    if self.Min.y > p.y {
        self.Min.y = p.y;
    }
    if self.Max.x < p.x {
        self.Max.x = p.x;
    }
    if self.Max.y < p.y {
        self.Max.y = p.y;
    }
}

void ImRect_Add(ImRect* self, ImRect r) {
    if self.Min.x > r.Min.x {
        self.Min.x = r.Min.x;
    }
    if self.Min.y > r.Min.y {
        self.Min.y = r.Min.y;
    }
    if self.Max.x < r.Max.x {
        self.Max.x = r.Max.x;
    }
    if self.Max.y < r.Max.y {
        self.Max.y = r.Max.y;
    }
}

void ImRect_AddX(ImRect* self, f32 x) {
    if self.Min.x > x {
        self.Min.x = x;
    }
    if self.Max.x < x {
        self.Max.x = x;
    }
}

void ImRect_AddY(ImRect* self, f32 y) {
    if self.Min.y > y {
        self.Min.y = y;
    }
    if self.Max.y < y {
        self.Max.y = y;
    }
}

void ImRect_Expand(ImRect* self, f32 amount) {
    self.Min.x -= amount;
    self.Min.y -= amount;
    self.Max.x += amount;
    self.Max.y += amount;
}

void ImRect_Expand(ImRect* self, ImVec2 amount) {
    self.Min.x -= amount.x;
    self.Min.y -= amount.y;
    self.Max.x += amount.x;
    self.Max.y += amount.y;
}

void ImRect_Translate(ImRect* self, ImVec2 d) {
    self.Min.x += d.x;
    self.Min.y += d.y;
    self.Max.x += d.x;
    self.Max.y += d.y;
}

void ImRect_TranslateX(ImRect* self, f32 dx) {
    self.Min.x += dx;
    self.Max.x += dx;
}

void ImRect_TranslateY(ImRect* self, f32 dy) {
    self.Min.y += dy;
    self.Max.y += dy;
}

void ImRect_ClipWith(ImRect* self, ImRect r) {
    self.Min = ImMax(self.Min, r.Min);
    self.Max = ImMin(self.Max, r.Max);
}

// Simple version, may lead to an inverted rectangle, which is fine for Contains/Overlaps test but not for display.
void ImRect_ClipWithFull(ImRect* self, ImRect r) {
    self.Min = ImClamp(self.Min, r.Min, r.Max);
    self.Max = ImClamp(self.Max, r.Min, r.Max);
}

// Full version, ensure both points are fully clipped.
bool ImRect_IsInverted(ImRect* self) {
    return self.Min.x > self.Max.x || self.Min.y > self.Max.y;
}

ImVec4 ImRect_ToVec4(ImRect* self) {
    return ImVec4{self.Min.x, self.Min.y, self.Max.x, self.Max.y};
}

ImVec4* ImRect_AsVec4(ImRect* self) {
    return &*cast(ImVec4*, &self.Min.x);
}

u64 ImBitArrayGetStorageSizeInBytes(i32 bitcount) {
    return cast(u64, bitcount + 31 >> 5) << 2;
}

void ImBitArrayClearAllBits(ImU32* arr, i32 bitcount) {
    memset(arr, 0, ImBitArrayGetStorageSizeInBytes(bitcount));
}

bool ImBitArrayTestBit(ImU32* arr, i32 n) {
    ImU32 mask = cast(ImU32, 1) << cast(u32, n & 31);
    return (arr[n >> 5] & mask) != 0;
}

void ImBitArrayClearBit(ImU32* arr, i32 n) {
    ImU32 mask = cast(ImU32, 1) << cast(u32, n & 31);
    arr[n >> 5] &= ~mask;
}

void ImBitArraySetBit(ImU32* arr, i32 n) {
    ImU32 mask = cast(ImU32, 1) << cast(u32, n & 31);
    arr[n >> 5] |= mask;
}

void ImBitArraySetBitRange(ImU32* arr, i32 n, i32 n2) {
    n2--;
    while n <= n2 {
        i32 a_mod = n & 31;
        i32 b_mod = (n2 > (n | 31) ? 31 : n2 & 31) + 1;
        ImU32 mask = cast(ImU32, (cast(ImU64, 1) << cast(u64, b_mod)) - 1) & ~cast(ImU32, (cast(ImU64, 1) << cast(u64, a_mod)) - 1);
        arr[n >> 5] |= mask;
        n = n + 32 & ~31;
    }
}

