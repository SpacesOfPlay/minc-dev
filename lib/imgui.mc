void ImGui_SetCurrentViewport(ImGuiWindow* current_window, ImGuiViewportP* viewport) {
    ImGuiContext* g = GImGui;
    ignore current_window;
    if viewport != null {
        viewport.LastFrameActive = g.FrameCount;
    }
    if g.CurrentViewport == viewport {
        return;
    }
    g.CurrentDpiScale = viewport != null ? viewport.DpiScale : 1.0f;
    g.CurrentViewport = viewport;
    assert(g.CurrentDpiScale > 0.0f && g.CurrentDpiScale < 99.0f);
    if g.IO.ConfigDpiScaleFonts != 0 {
        g.Style.FontScaleDpi = g.CurrentDpiScale;
    }
    if g.CurrentViewport && g.PlatformIO.Platform_OnChangedViewport {
        g.PlatformIO.Platform_OnChangedViewport(cast(ImGuiViewport*, g.CurrentViewport));
    }
}

void ImGui_SetWindowViewport(ImGuiWindow* window, ImGuiViewportP* viewport) {
    if window.ViewportOwned && window.Viewport.Window == window {
        window.Viewport.Size = ImVec2{0.0f, 0.0f};
    }
    window.Viewport = viewport;
    window.ViewportId = viewport.ID;
    window.ViewportOwned = viewport.Window == window;
}

private {
bool ImGui_GetWindowAlwaysWantOwnViewport(ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    if g.IO.ConfigViewportsNoAutoMerge || window.WindowClass.ViewportFlagsOverrideSet & ImGuiViewportFlags_NoAutoMerge {
        if (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable) != 0 {
            if window.DockIsActive == 0 {
                if (window.Flags & (ImGuiWindowFlags_ChildWindow | ImGuiWindowFlags_ChildMenu | ImGuiWindowFlags_Tooltip)) == 0 {
                    if (window.Flags & ImGuiWindowFlags_Popup) == 0 || (window.Flags & ImGuiWindowFlags_Modal) != 0 {
                        return true;
                    }
                }
            }
        }
    }
    return false;
}

// Heuristic, see #8948: depends on how backends handle OS-level parenting.
// Due to how parent viewport stack is layed out, note that IsViewportAbove(a,b) isn't always the same as !IsViewportAbove(b,a).
bool IsViewportAbove(ImGuiViewportP* potential_above, ImGuiViewportP* potential_below) {
    ImGuiContext* g = GImGui;
    if (g.IO.BackendFlags & ImGuiBackendFlags_HasParentViewport) != 0 {
        for ImGuiViewport* v = cast(ImGuiViewport*, potential_above); v != null && v.ParentViewport; v = v.ParentViewport {
            if v.ParentViewport == cast(ImGuiViewport*, potential_below) {
                return true;
            }
        }
    } else {
        if potential_above.ParentViewport == cast(ImGuiViewport*, potential_below) {
            return true;
        }
    }
    if potential_above.LastFocusedStampCount > potential_below.LastFocusedStampCount {
        return true;
    }
    return false;
}

bool ImGui_UpdateTryMergeWindowIntoHostViewport(ImGuiWindow* window, ImGuiViewportP* viewport_dst) {
    ImGuiContext* g = GImGui;
    assert(window == window.RootWindowDockTree);
    ImGuiViewportP* viewport_src = window.Viewport;
    if viewport_src == viewport_dst {
        return false;
    }
    if (viewport_dst.Flags & ImGuiViewportFlags_CanHostOtherWindows) == 0 {
        return false;
    }
    if (viewport_dst.Flags & ImGuiViewportFlags_IsMinimized) != 0 {
        return false;
    }
    if ImRect_Contains(&ImGuiViewportP_GetMainRect(viewport_dst), ImGuiWindow_Rect(window)) == 0 {
        return false;
    }
    if ImGui_GetWindowAlwaysWantOwnViewport(window) != 0 {
        return false;
    }
    {
        ImGuiViewportP** zz_rf_it_51 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_51 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_51 != zz_rf_end_51; zz_rf_it_51++ {
            ImGuiViewportP* viewport_obstructing = *zz_rf_it_51;
            if viewport_obstructing == viewport_src || viewport_obstructing == viewport_dst || !viewport_obstructing.PlatformWindowCreated {
                continue;
            }
            if ImRect_Overlaps(&ImGuiViewportP_GetMainRect(viewport_obstructing), ImGuiWindow_Rect(window)) != 0 {
                if IsViewportAbove(viewport_obstructing, viewport_dst) != 0 {
                    if viewport_src == null || IsViewportAbove(viewport_src, viewport_obstructing) {
                        return false;
                    }
                }
            }
        }
    }
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventViewport) != 0 {
        }
        if !(0 != 0) { break; }
    }
    if window.ViewportOwned != 0 {
        for i32 n = 0; n < g.Windows.Size; n++ {
            if g.Windows.Data[n].Viewport == viewport_src {
                ImGui_SetWindowViewport(g.Windows.Data[n], viewport_dst);
            }
        }
    }
    ImGui_SetWindowViewport(window, viewport_dst);
    if (window.Flags & ImGuiWindowFlags_NoBringToFrontOnFocus) == 0 {
        ImGui_BringWindowToDisplayFront(window);
    }
    return true;
}

// FIXME: handle 0 to N host viewports
bool ImGui_UpdateTryMergeWindowIntoHostViewports(ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    return ImGui_UpdateTryMergeWindowIntoHostViewport(window, g.Viewports.Data[0]);
}
}

// Translate Dear ImGui windows when a Host Viewport has been moved
// (This additionally keeps windows at the same place when ImGuiConfigFlags_ViewportsEnable is toggled!)
void ImGui_TranslateWindowsInViewport(ImGuiViewportP* viewport, ImVec2 old_pos, ImVec2 new_pos, ImVec2 old_size, ImVec2 new_size) {
    ImGuiContext* g = GImGui;
    assert(viewport.Window == null && viewport.Flags & ImGuiViewportFlags_CanHostOtherWindows);
    bool translate_all_windows = (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable) != (g.ConfigFlagsLastFrame & ImGuiConfigFlags_ViewportsEnable);
    ImRect test_still_fit_rect;
    ImRect_init(&test_still_fit_rect, old_pos, op_add_ImVec2_ImVec2(old_pos, old_size));
    ImVec2 delta_pos = op_sub_ImVec2_ImVec2(new_pos, old_pos);
    {
        ImGuiWindow** zz_rf_it_52 = ImVector_ImGuiWindow_ptr_begin(&g.Windows);
        ImGuiWindow** zz_rf_end_52 = ImVector_ImGuiWindow_ptr_end(&g.Windows);
        for ; zz_rf_it_52 != zz_rf_end_52; zz_rf_it_52++ {
            ImGuiWindow* window = *zz_rf_it_52;
            if translate_all_windows || window.Viewport == viewport && (op_eq_ImVec2_ImVec2(old_size, new_size) || ImRect_Contains(&test_still_fit_rect, ImGuiWindow_Rect(window))) {
                TranslateWindow(window, delta_pos);
            }
        }
    }
}

// Scale all windows (position, size). Use when e.g. changing DPI. (This is a lossy operation!)
void ImGui_ScaleWindowsInViewport(ImGuiViewportP* viewport, f32 scale) {
    ImGuiContext* g = GImGui;
    if viewport.Window != null {
        ScaleWindow(viewport.Window, scale);
    } else {
        {
            ImGuiWindow** zz_rf_it_53 = ImVector_ImGuiWindow_ptr_begin(&g.Windows);
            ImGuiWindow** zz_rf_end_53 = ImVector_ImGuiWindow_ptr_end(&g.Windows);
            for ; zz_rf_it_53 != zz_rf_end_53; zz_rf_it_53++ {
                ImGuiWindow* window = *zz_rf_it_53;
                if window.Viewport == viewport {
                    ScaleWindow(window, scale);
                }
            }
        }
    }
}

// If the backend doesn't support ImGuiBackendFlags_HasMouseHoveredViewport or doesn't honor ImGuiViewportFlags_NoInputs for it, we do a search ourselves.
// A) It won't take account of the possibility that non-imgui windows may be in-between our dragged window and our target window.
// B) It requires Platform_GetWindowFocus to be implemented by backend.
ImGuiViewportP* ImGui_FindHoveredViewportFromPlatformWindowStack(ImVec2 mouse_platform_pos) {
    ImGuiContext* g = GImGui;
    ImGuiViewportP* best_candidate = null;
    {
        ImGuiViewportP** zz_rf_it_54 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_54 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_54 != zz_rf_end_54; zz_rf_it_54++ {
            ImGuiViewportP* viewport = *zz_rf_it_54;
            if !(viewport.Flags & (ImGuiViewportFlags_NoInputs | ImGuiViewportFlags_IsMinimized)) && ImRect_Contains(&ImGuiViewportP_GetMainRect(viewport), mouse_platform_pos) {
                if best_candidate == null || best_candidate.LastFocusedStampCount < viewport.LastFocusedStampCount {
                    if viewport.PlatformWindowCreated != 0 {
                        best_candidate = viewport;
                    }
                }
            }
        }
    }
    return best_candidate;
}

// Update viewports and monitor infos
// Note that this is running even if 'ImGuiConfigFlags_ViewportsEnable' is not set, in order to clear unused viewports (if any) and update monitor info.
private {
void ImGui_UpdateViewportsNewFrame() {
    ImGuiContext* g = GImGui;
    assert(g.PlatformIO.Viewports.Size <= g.Viewports.Size);
    bool viewports_enabled = (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable) != 0;
    if viewports_enabled != 0 {
        ImGuiViewportP* focused_viewport = null;
        {
            ImGuiViewportP** zz_rf_it_55 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
            ImGuiViewportP** zz_rf_end_55 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
            for ; zz_rf_it_55 != zz_rf_end_55; zz_rf_it_55++ {
                ImGuiViewportP* viewport = *zz_rf_it_55;
                bool platform_funcs_available = viewport.PlatformWindowCreated;
                if g.PlatformIO.Platform_GetWindowMinimized && platform_funcs_available {
                    bool is_minimized = g.PlatformIO.Platform_GetWindowMinimized(cast(ImGuiViewport*, viewport));
                    if is_minimized != 0 {
                        viewport.Flags |= ImGuiViewportFlags_IsMinimized;
                    } else {
                        viewport.Flags &= ~ImGuiViewportFlags_IsMinimized;
                    }
                }
                if g.PlatformIO.Platform_GetWindowFocus && platform_funcs_available {
                    bool is_focused = g.PlatformIO.Platform_GetWindowFocus(cast(ImGuiViewport*, viewport));
                    if is_focused != 0 {
                        viewport.Flags |= ImGuiViewportFlags_IsFocused;
                    } else {
                        viewport.Flags &= ~ImGuiViewportFlags_IsFocused;
                    }
                    if is_focused != 0 {
                        focused_viewport = viewport;
                    }
                }
            }
        }
        if focused_viewport && g.PlatformLastFocusedViewportId != focused_viewport.ID {
            while true {
                if (g.DebugLogFlags & ImGuiDebugLogFlags_EventViewport) != 0 {
                }
                if !(0 != 0) { break; }
            }
            ImGuiViewport* prev_focused_viewport = ImGui_FindViewportByID(g.PlatformLastFocusedViewportId);
            bool prev_focused_has_been_destroyed = prev_focused_viewport == null || prev_focused_viewport.PlatformWindowCreated == false;
            if focused_viewport.LastFocusedStampCount != g.ViewportFocusedStampCount {
                focused_viewport.LastFocusedStampCount = ++g.ViewportFocusedStampCount;
            }
            g.PlatformLastFocusedViewportId = focused_viewport.ID;
            bool apply_imgui_focus_on_focused_viewport = !ImGui_IsAnyMouseDown() && !prev_focused_has_been_destroyed;
            if apply_imgui_focus_on_focused_viewport && g.IO.ConfigViewportsPlatformFocusSetsImGuiFocus {
                focused_viewport.LastFocusedHadNavWindow |= g.NavWindow != null && g.NavWindow.Viewport == focused_viewport;
                ImGuiFocusRequestFlags focus_request_flags = ImGuiFocusRequestFlags_UnlessBelowModal | ImGuiFocusRequestFlags_RestoreFocusedChild;
                if focused_viewport.Window != null {
                    ImGui_FocusWindow(focused_viewport.Window, focus_request_flags);
                } else if focused_viewport.LastFocusedHadNavWindow != 0 {
                    ImGui_FocusTopMostWindowUnderOne(null, null, cast(ImGuiViewport*, focused_viewport), focus_request_flags);
                } else {
                    ImGui_FocusWindow(null, focus_request_flags);
                }
            }
        }
        if focused_viewport != null {
            focused_viewport.LastFocusedHadNavWindow = g.NavWindow != null && g.NavWindow.Viewport == focused_viewport;
        }
    }
    ImGuiViewportP* main_viewport = g.Viewports.Data[0];
    assert(main_viewport.ID == ImGui_IMGUI_VIEWPORT_DEFAULT_ID);
    assert(main_viewport.Window == null);
    ImVec2 main_viewport_pos = viewports_enabled != 0 ? g.PlatformIO.Platform_GetWindowPos(cast(ImGuiViewport*, main_viewport)) : ImVec2{0.0f, 0.0f};
    ImVec2 main_viewport_size = g.IO.DisplaySize;
    ImVec2 main_viewport_framebuffer_scale = g.IO.DisplayFramebufferScale;
    if viewports_enabled && main_viewport.Flags & ImGuiViewportFlags_IsMinimized {
        main_viewport_pos = main_viewport.Pos;
        main_viewport_size = main_viewport.Size;
        main_viewport_framebuffer_scale = main_viewport.FramebufferScale;
    }
    ImGui_AddUpdateViewport(null, ImGui_IMGUI_VIEWPORT_DEFAULT_ID, main_viewport_pos, main_viewport_size, ImGuiViewportFlags_OwnedByApp | ImGuiViewportFlags_CanHostOtherWindows);
    f32 memory_compact_start_time = g.GcCompactAll || g.IO.ConfigMemoryCompactTimer < 0.0f ? FLT_MAX : cast(f32, g.Time) - g.IO.ConfigMemoryCompactTimer;
    g.CurrentDpiScale = 0.0f;
    g.CurrentViewport = null;
    g.MouseViewport = null;
    for i32 n = 0; n < g.Viewports.Size; n++ {
        ImGuiViewportP* viewport = g.Viewports.Data[n];
        viewport.Idx = n;
        if n > 0 && viewport.LastFrameActive < g.FrameCount - 2 {
            ImGui_DestroyViewport(viewport);
            n--;
            continue;
        }
        bool platform_funcs_available = viewport.PlatformWindowCreated;
        if viewports_enabled != 0 {
            if !(viewport.Flags & ImGuiViewportFlags_IsMinimized) && platform_funcs_available {
                if viewport.PlatformRequestMove != 0 {
                    viewport.LastPlatformPos = g.PlatformIO.Platform_GetWindowPos(cast(ImGuiViewport*, viewport));
                    viewport.Pos = viewport.LastPlatformPos;
                }
                if viewport.PlatformRequestResize != 0 {
                    viewport.LastPlatformSize = g.PlatformIO.Platform_GetWindowSize(cast(ImGuiViewport*, viewport));
                    viewport.Size = viewport.LastPlatformSize;
                }
                if g.PlatformIO.Platform_GetWindowFramebufferScale != null {
                    viewport.FramebufferScale = g.PlatformIO.Platform_GetWindowFramebufferScale(cast(ImGuiViewport*, viewport));
                }
            }
        }
        ImGui_UpdateViewportPlatformMonitor(viewport);
        viewport.WorkInsetMin = viewport.BuildWorkInsetMin;
        viewport.WorkInsetMax = viewport.BuildWorkInsetMax;
        viewport.BuildWorkInsetMax = ImVec2{0.0f, 0.0f};
        viewport.BuildWorkInsetMin = viewport.BuildWorkInsetMax;
        if g.PlatformIO.Platform_GetWindowWorkAreaInsets != null && platform_funcs_available {
            ImVec4 insets = g.PlatformIO.Platform_GetWindowWorkAreaInsets(cast(ImGuiViewport*, viewport));
            assert(insets.x >= 0.0f && insets.y >= 0.0f && insets.z >= 0.0f && insets.w >= 0.0f);
            viewport.BuildWorkInsetMin = ImVec2{insets.x, insets.y};
            viewport.BuildWorkInsetMax = ImVec2{insets.z, insets.w};
        }
        ImGuiViewportP_UpdateWorkRect(viewport);
        for i32 dl_n = 0; dl_n < cast(i32, sizeof(viewport.BgFgDrawLists) / sizeof(*viewport.BgFgDrawLists)); dl_n++ {
            if viewport.BgFgDrawListsLastTimeActive[dl_n] < memory_compact_start_time && viewport.BgFgDrawLists[dl_n] != null {
                0;
                viewport.BgFgDrawLists[dl_n] = null;
            }
        }
        viewport.Alpha = 1.0f;
        ImVec2 viewport_delta_pos = op_sub_ImVec2_ImVec2(viewport.Pos, viewport.LastPos);
        if viewport.Flags & ImGuiViewportFlags_CanHostOtherWindows && (viewport_delta_pos.x != 0.0f || viewport_delta_pos.y != 0.0f) {
            ImGui_TranslateWindowsInViewport(viewport, viewport.LastPos, viewport.Pos, viewport.LastSize, viewport.Size);
        }
        f32 new_dpi_scale;
        if g.PlatformIO.Platform_GetWindowDpiScale && platform_funcs_available {
            new_dpi_scale = g.PlatformIO.Platform_GetWindowDpiScale(cast(ImGuiViewport*, viewport));
        } else if viewport.PlatformMonitor != -1 {
            new_dpi_scale = g.PlatformIO.Monitors.Data[viewport.PlatformMonitor].DpiScale;
        } else {
            new_dpi_scale = viewport.DpiScale != 0.0f ? viewport.DpiScale : 1.0f;
        }
        assert(new_dpi_scale > 0.0f && new_dpi_scale < 99.0f);
        if viewport.DpiScale != 0.0f && new_dpi_scale != viewport.DpiScale {
            f32 scale_factor = new_dpi_scale / viewport.DpiScale;
            if g.IO.ConfigDpiScaleViewports != 0 {
                ImGui_ScaleWindowsInViewport(viewport, scale_factor);
            }
        }
        viewport.DpiScale = new_dpi_scale;
    }
    g.PlatformMonitorsFullWorkRect = ImRect{ImVec2{FLT_MAX, FLT_MAX}, ImVec2{-FLT_MAX, -FLT_MAX}};
    if g.PlatformIO.Monitors.Size == 0 {
        ImGuiPlatformMonitor* monitor = &g.FallbackMonitor;
        monitor.MainPos = main_viewport.Pos;
        monitor.MainSize = main_viewport.Size;
        monitor.WorkPos = main_viewport.WorkPos;
        monitor.WorkSize = main_viewport.WorkSize;
        monitor.DpiScale = main_viewport.DpiScale;
        ImRect_Add(&g.PlatformMonitorsFullWorkRect, monitor.WorkPos);
        ImRect_Add(&g.PlatformMonitorsFullWorkRect, op_add_ImVec2_ImVec2(monitor.WorkPos, monitor.WorkSize));
    } else {
        g.FallbackMonitor = g.PlatformIO.Monitors.Data[0];
    }
    {
        ImGuiPlatformMonitor* zz_rf_it_56 = ImVector_ImGuiPlatformMonitor_begin(&g.PlatformIO.Monitors);
        ImGuiPlatformMonitor* zz_rf_end_56 = ImVector_ImGuiPlatformMonitor_end(&g.PlatformIO.Monitors);
        for ; zz_rf_it_56 != zz_rf_end_56; zz_rf_it_56++ {
            ImGuiPlatformMonitor* monitor = zz_rf_it_56;
            ImRect_Add(&g.PlatformMonitorsFullWorkRect, monitor.WorkPos);
            ImRect_Add(&g.PlatformMonitorsFullWorkRect, op_add_ImVec2_ImVec2(monitor.WorkPos, monitor.WorkSize));
        }
    }
    if viewports_enabled == 0 {
        g.MouseViewport = main_viewport;
        return;
    }
    ImGuiViewportP* viewport_hovered = null;
    if (g.IO.BackendFlags & ImGuiBackendFlags_HasMouseHoveredViewport) != 0 {
        viewport_hovered = g.IO.MouseHoveredViewport != 0 ? cast(ImGuiViewportP*, ImGui_FindViewportByID(g.IO.MouseHoveredViewport)) : null;
        if viewport_hovered && viewport_hovered.Flags & ImGuiViewportFlags_NoInputs {
            viewport_hovered = ImGui_FindHoveredViewportFromPlatformWindowStack(g.IO.MousePos);
        }
    } else {
        viewport_hovered = ImGui_FindHoveredViewportFromPlatformWindowStack(g.IO.MousePos);
    }
    if viewport_hovered != null {
        g.MouseLastHoveredViewport = viewport_hovered;
    } else if g.MouseLastHoveredViewport == null {
        g.MouseLastHoveredViewport = g.Viewports.Data[0];
    }
    if g.MovingWindow && g.MovingWindow.Viewport {
        g.MouseViewport = g.MovingWindow.Viewport;
    } else {
        g.MouseViewport = g.MouseLastHoveredViewport;
    }
    bool is_mouse_dragging_with_an_expected_destination = g.DragDropActive;
    if is_mouse_dragging_with_an_expected_destination && viewport_hovered == null {
        viewport_hovered = g.MouseLastHoveredViewport;
    }
    if is_mouse_dragging_with_an_expected_destination || g.ActiveId == 0 || !ImGui_IsAnyMouseDown() {
        if viewport_hovered != null && viewport_hovered != g.MouseViewport && !(viewport_hovered.Flags & ImGuiViewportFlags_NoInputs) {
            g.MouseViewport = viewport_hovered;
        }
    }
    assert(g.MouseViewport != null);
}

// Update user-facing viewport list (g.Viewports -> g.PlatformIO.Viewports after filtering out some)
void ImGui_UpdateViewportsEndFrame() {
    ImGuiContext* g = GImGui;
    ImVector_ImGuiViewport_ptr_resize(&g.PlatformIO.Viewports, 0);
    for i32 i = 0; i < g.Viewports.Size; i++ {
        ImGuiViewportP* viewport = g.Viewports.Data[i];
        viewport.LastPos = viewport.Pos;
        viewport.LastSize = viewport.Size;
        if viewport.LastFrameActive < g.FrameCount || viewport.Size.x <= 0.0f || viewport.Size.y <= 0.0f {
            if i > 0 {
                continue;
            }
        }
        if viewport.Window && !IsWindowActiveAndVisible(viewport.Window) {
            continue;
        }
        if i > 0 {
            assert(viewport.Window != null);
        }
        ImVector_ImGuiViewport_ptr_push_back(&g.PlatformIO.Viewports, cast(ImGuiViewport*, viewport));
    }
    ImGuiViewportP_ClearRequestFlags(g.Viewports.Data[0]);
}
}

// FIXME: We should ideally refactor the system to call this every frame (we currently don't)
ImGuiViewportP* ImGui_AddUpdateViewport(ImGuiWindow* window, ImGuiID id, ImVec2 pos, ImVec2 size, ImGuiViewportFlags flags) {
    ImGuiContext* g = GImGui;
    assert(id != 0);
    flags |= ImGuiViewportFlags_IsPlatformWindow;
    if window != null {
        bool window_can_use_inputs = (window.Flags & ImGuiWindowFlags_NoMouseInputs && window.Flags & ImGuiWindowFlags_NoNavInputs) == false;
        if g.MovingWindow && g.MovingWindow.RootWindowDockTree == window {
            flags |= ImGuiViewportFlags_NoInputs | ImGuiViewportFlags_NoFocusOnAppearing;
        }
        if window_can_use_inputs == 0 {
            flags |= ImGuiViewportFlags_NoInputs;
        }
        if (window.Flags & ImGuiWindowFlags_NoFocusOnAppearing) != 0 {
            flags |= ImGuiViewportFlags_NoFocusOnAppearing;
        }
    }
    var viewport = cast(ImGuiViewportP*, ImGui_FindViewportByID(id));
    if viewport != null {
        ImVec2 prev_pos = viewport.Pos;
        ImVec2 prev_size = viewport.Size;
        if !viewport.PlatformRequestMove || viewport.ID == ImGui_IMGUI_VIEWPORT_DEFAULT_ID {
            viewport.Pos = pos;
        }
        if !viewport.PlatformRequestResize || viewport.ID == ImGui_IMGUI_VIEWPORT_DEFAULT_ID {
            viewport.Size = size;
        }
        viewport.Flags = flags | viewport.Flags & (ImGuiViewportFlags_IsMinimized | ImGuiViewportFlags_IsFocused);
        if op_ne_ImVec2_ImVec2(prev_pos, viewport.Pos) || op_ne_ImVec2_ImVec2(prev_size, viewport.Size) {
            ImGui_UpdateViewportPlatformMonitor(viewport);
        }
    } else {
        viewport = cast(ImGuiViewportP*, ImGui_MemAlloc(cast(u64, sizeof(ImGuiViewportP))));
        ImGuiViewportP_init(viewport);
        viewport.ID = id;
        viewport.Idx = g.Viewports.Size;
        viewport.LastPos = pos;
        viewport.Pos = viewport.LastPos;
        viewport.LastSize = size;
        viewport.Size = viewport.LastSize;
        viewport.Flags = flags;
        ImGui_UpdateViewportPlatformMonitor(viewport);
        ImVector_ImGuiViewportP_ptr_push_back(&g.Viewports, viewport);
        g.ViewportCreatedCount++;
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventViewport) != 0 {
            }
            if !(0 != 0) { break; }
        }
        viewport.LastFocusedStampCount = ++g.ViewportFocusedStampCount;
        g.DrawListSharedData.ClipRectFullscreen.x = ImMin(g.DrawListSharedData.ClipRectFullscreen.x, viewport.Pos.x);
        g.DrawListSharedData.ClipRectFullscreen.y = ImMin(g.DrawListSharedData.ClipRectFullscreen.y, viewport.Pos.y);
        g.DrawListSharedData.ClipRectFullscreen.z = ImMax(g.DrawListSharedData.ClipRectFullscreen.z, viewport.Pos.x + viewport.Size.x);
        g.DrawListSharedData.ClipRectFullscreen.w = ImMax(g.DrawListSharedData.ClipRectFullscreen.w, viewport.Pos.y + viewport.Size.y);
        viewport.DpiScale = ImGui_GetViewportPlatformMonitor(cast(ImGuiViewport*, viewport)).DpiScale;
    }
    viewport.Window = window;
    viewport.LastFrameActive = g.FrameCount;
    ImGuiViewportP_UpdateWorkRect(viewport);
    assert(window == null || viewport.ID == window.ID);
    if window != null {
        window.ViewportOwned = true;
    }
    return viewport;
}

private {
void ImGui_DestroyViewport(ImGuiViewportP* viewport) {
    ImGuiContext* g = GImGui;
    {
        ImGuiWindow** zz_rf_it_57 = ImVector_ImGuiWindow_ptr_begin(&g.Windows);
        ImGuiWindow** zz_rf_end_57 = ImVector_ImGuiWindow_ptr_end(&g.Windows);
        for ; zz_rf_it_57 != zz_rf_end_57; zz_rf_it_57++ {
            ImGuiWindow* window = *zz_rf_it_57;
            if window.Viewport != viewport {
                continue;
            }
            window.Viewport = null;
            window.ViewportOwned = false;
        }
    }
    if viewport == g.MouseLastHoveredViewport {
        g.MouseLastHoveredViewport = null;
    }
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventViewport) != 0 {
        }
        if !(0 != 0) { break; }
    }
    ImGui_DestroyPlatformWindow(viewport);
    assert(ImVector_ImGuiViewport_ptr_contains(&g.PlatformIO.Viewports, cast(ImGuiViewport*, viewport)) == false);
    assert(g.Viewports.Data[viewport.Idx] == viewport);
    ImVector_ImGuiViewportP_ptr_erase(&g.Viewports, g.Viewports.Data + viewport.Idx);
    0;
}

// FIXME-VIEWPORT: This is all super messy and ought to be clarified or rewritten.
void ImGui_WindowSelectViewport(ImGuiWindow* window) {
    ImGuiContext* g = GImGui;
    ImGuiWindowFlags flags = window.Flags;
    window.ViewportAllowPlatformMonitorExtend = -1;
    var main_viewport = cast(ImGuiViewportP*, cast(void*, ImGui_GetMainViewport()));
    if (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable) == 0 {
        ImGui_SetWindowViewport(window, main_viewport);
        return;
    }
    window.ViewportOwned = false;
    if flags & (ImGuiWindowFlags_Popup | ImGuiWindowFlags_Tooltip) && window.Appearing {
        window.Viewport = null;
        window.ViewportId = 0;
    }
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasViewport) == 0 {
        if window.Viewport == null && window.ParentWindow && (!window.ParentWindow.IsFallbackWindow || window.ParentWindow.WasActive) {
            window.Viewport = window.ParentWindow.Viewport;
        }
        if window.Viewport == null && window.ViewportId != 0 {
            window.Viewport = cast(ImGuiViewportP*, ImGui_FindViewportByID(window.ViewportId));
            if window.Viewport == null && window.ViewportPos.x != FLT_MAX && window.ViewportPos.y != FLT_MAX {
                window.Viewport = ImGui_AddUpdateViewport(window, window.ID, window.ViewportPos, window.Size, ImGuiViewportFlags_None);
            }
        }
    }
    bool lock_viewport = false;
    if (g.NextWindowData.HasFlags & ImGuiNextWindowDataFlags_HasViewport) != 0 {
        window.Viewport = cast(ImGuiViewportP*, ImGui_FindViewportByID(g.NextWindowData.ViewportId));
        window.ViewportId = g.NextWindowData.ViewportId;
        if window.Viewport && (window.Flags & ImGuiWindowFlags_DockNodeHost) != 0 && window.Viewport.Window != null {
            window.Viewport.Window = window;
            window.ViewportId = window.ID;
            window.Viewport.ID = window.ViewportId;
        }
        lock_viewport = true;
    } else if flags & ImGuiWindowFlags_ChildWindow || flags & ImGuiWindowFlags_ChildMenu {
        if window.DockNode && window.DockNode.HostWindow {
            assert(window.DockNode.HostWindow.Viewport == window.ParentWindow.Viewport);
        }
        window.Viewport = window.ParentWindow.Viewport;
    } else if window.DockNode && window.DockNode.HostWindow {
        window.Viewport = window.DockNode.HostWindow.Viewport;
    } else if (flags & ImGuiWindowFlags_Tooltip) != 0 {
        window.Viewport = g.MouseViewport;
    } else if ImGui_GetWindowAlwaysWantOwnViewport(window) != 0 {
        window.Viewport = ImGui_AddUpdateViewport(window, window.ID, window.Pos, window.Size, ImGuiViewportFlags_None);
    } else if g.MovingWindow && g.MovingWindow.RootWindowDockTree == window && ImGui_IsMousePosValid() {
        if window.Viewport != null && window.Viewport.Window == window {
            window.Viewport = ImGui_AddUpdateViewport(window, window.ID, window.Pos, window.Size, ImGuiViewportFlags_None);
        }
    } else {
        bool try_to_merge_into_host_viewport = window.Viewport && window == window.Viewport.Window && (g.ActiveId == 0 || g.ActiveIdAllowOverlap);
        if try_to_merge_into_host_viewport != 0 {
            ImGui_UpdateTryMergeWindowIntoHostViewports(window);
        }
    }
    if window.Viewport == null {
        if ImGui_UpdateTryMergeWindowIntoHostViewport(window, main_viewport) == 0 {
            window.Viewport = ImGui_AddUpdateViewport(window, window.ID, window.Pos, window.Size, ImGuiViewportFlags_None);
        }
    }
    if lock_viewport == 0 {
        if (flags & (ImGuiWindowFlags_Tooltip | ImGuiWindowFlags_Popup)) != 0 {
            ImVec2 mouse_ref = (flags & ImGuiWindowFlags_Tooltip) != 0 ? g.IO.MousePos : ImVector_ImGuiPopupData_back(&g.BeginPopupStack).OpenMousePos;
            bool use_mouse_ref = !g.NavCursorVisible || !g.NavHighlightItemUnderNav || !g.NavWindow;
            bool mouse_valid = ImGui_IsMousePosValid(&mouse_ref);
            if (window.Appearing || flags & (ImGuiWindowFlags_Tooltip | ImGuiWindowFlags_ChildMenu)) && (!use_mouse_ref || mouse_valid) {
                window.ViewportAllowPlatformMonitorExtend = ImGui_FindPlatformMonitorForPos(use_mouse_ref && mouse_valid ? mouse_ref : ImGui_NavCalcPreferredRefPos(window.Flags));
            } else {
                window.ViewportAllowPlatformMonitorExtend = window.Viewport.PlatformMonitor;
            }
        } else if window.Viewport && window != window.Viewport.Window && window.Viewport.Window && !(flags & ImGuiWindowFlags_ChildWindow) && window.DockNode == null {
            bool will_be_visible = (window.DockIsActive && !window.DockTabIsVisible ? false : true) != 0;
            if window.Flags & ImGuiWindowFlags_DockNodeHost && window.Viewport.LastFrameActive < g.FrameCount && will_be_visible {
                while true {
                    if (g.DebugLogFlags & ImGuiDebugLogFlags_EventViewport) != 0 {
                    }
                    if !(0 != 0) { break; }
                }
                window.Viewport.Window = window;
                window.Viewport.ID = window.ID;
                window.Viewport.LastNameHash = 0;
            } else if ImGui_UpdateTryMergeWindowIntoHostViewports(window) == 0 {
                window.Viewport = ImGui_AddUpdateViewport(window, window.ID, window.Pos, window.Size, ImGuiViewportFlags_NoFocusOnAppearing);
            }
        } else if window.ViewportAllowPlatformMonitorExtend < 0 && (flags & ImGuiWindowFlags_ChildWindow) == 0 {
            window.ViewportAllowPlatformMonitorExtend = window.Viewport.PlatformMonitor;
        }
    }
    window.ViewportOwned = window == window.Viewport.Window;
    window.ViewportId = window.Viewport.ID;
}
}

void ImGui_WindowSyncOwnedViewport(ImGuiWindow* window, ImGuiWindow* parent_window_in_stack) {
    ImGuiContext* g = GImGui;
    bool viewport_rect_changed = false;
    if window.Viewport.PlatformRequestMove != 0 {
        window.Pos = window.Viewport.Pos;
        ImGui_MarkIniSettingsDirty(window);
    } else if memcmp(&window.Viewport.Pos, &window.Pos, cast(u64, sizeof(window.Pos))) != 0 {
        viewport_rect_changed = true;
        window.Viewport.Pos = window.Pos;
    }
    if window.Viewport.PlatformRequestResize != 0 {
        window.SizeFull = window.Viewport.Size;
        window.Size = window.SizeFull;
        ImGui_MarkIniSettingsDirty(window);
    } else if memcmp(&window.Viewport.Size, &window.Size, cast(u64, sizeof(window.Size))) != 0 {
        viewport_rect_changed = true;
        window.Viewport.Size = window.Size;
    }
    ImGuiViewportP_UpdateWorkRect(window.Viewport);
    if viewport_rect_changed != 0 {
        ImGui_UpdateViewportPlatformMonitor(window.Viewport);
    }
    ImGuiViewportFlags viewport_flags_to_clear = ImGuiViewportFlags_TopMost | ImGuiViewportFlags_NoTaskBarIcon | ImGuiViewportFlags_NoDecoration | ImGuiViewportFlags_NoRendererClear;
    ImGuiViewportFlags viewport_flags = window.Viewport.Flags & ~viewport_flags_to_clear;
    ImGuiWindowFlags window_flags = window.Flags;
    bool is_modal = (window_flags & ImGuiWindowFlags_Modal) != 0;
    bool is_short_lived_floating_window = (window_flags & (ImGuiWindowFlags_ChildMenu | ImGuiWindowFlags_Tooltip | ImGuiWindowFlags_Popup)) != 0;
    if (window_flags & ImGuiWindowFlags_Tooltip) != 0 {
        viewport_flags |= ImGuiViewportFlags_TopMost;
    }
    if (g.IO.ConfigViewportsNoTaskBarIcon || is_short_lived_floating_window) && !is_modal {
        viewport_flags |= ImGuiViewportFlags_NoTaskBarIcon;
    }
    if g.IO.ConfigViewportsNoDecoration || is_short_lived_floating_window {
        viewport_flags |= ImGuiViewportFlags_NoDecoration;
    }
    if is_short_lived_floating_window && !is_modal {
        viewport_flags |= ImGuiViewportFlags_NoFocusOnAppearing | ImGuiViewportFlags_NoFocusOnClick;
    }
    if window.WindowClass.ViewportFlagsOverrideSet != 0 {
        viewport_flags |= window.WindowClass.ViewportFlagsOverrideSet;
    }
    if window.WindowClass.ViewportFlagsOverrideClear != 0 {
        viewport_flags &= ~window.WindowClass.ViewportFlagsOverrideClear;
    }
    if (window_flags & ImGuiWindowFlags_NoBackground) == 0 {
        viewport_flags |= ImGuiViewportFlags_NoRendererClear;
    }
    window.Viewport.Flags = viewport_flags;
    window.Viewport.PlatformIconData = window.WindowClass.PlatformIconData;
    if window.WindowClass.ParentViewportId != cast(ImGuiID, -1) {
        ImGuiID old_parent_viewport_id = window.Viewport.ParentViewportId;
        window.Viewport.ParentViewportId = window.WindowClass.ParentViewportId;
        if window.Viewport.ParentViewportId != old_parent_viewport_id {
            window.Viewport.ParentViewport = ImGui_FindViewportByID(window.Viewport.ParentViewportId);
        }
    } else if window_flags & (ImGuiWindowFlags_Popup | ImGuiWindowFlags_Tooltip) && parent_window_in_stack && (!parent_window_in_stack.IsFallbackWindow || parent_window_in_stack.WasActive) {
        window.Viewport.ParentViewport = cast(ImGuiViewport*, parent_window_in_stack.Viewport);
        window.Viewport.ParentViewportId = parent_window_in_stack.Viewport.ID;
    } else {
        window.Viewport.ParentViewport = g.IO.ConfigViewportsNoDefaultParent != 0 ? null : ImGui_GetMainViewport();
        window.Viewport.ParentViewportId = cast(ImGuiID, g.IO.ConfigViewportsNoDefaultParent != 0 ? 0 : ImGui_IMGUI_VIEWPORT_DEFAULT_ID);
    }
}

// Called by user at the end of the main loop, after EndFrame()
// This will handle the creation/update of all OS windows via function defined in the ImGuiPlatformIO api.
void ImGui_UpdatePlatformWindows() {
    ImGuiContext* g = GImGui;
    assert(g.FrameCountEnded == g.FrameCount && "Forgot to call Render() or EndFrame() before UpdatePlatformWindows()?");
    assert(g.FrameCountPlatformEnded < g.FrameCount);
    g.FrameCountPlatformEnded = g.FrameCount;
    if (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable) == 0 {
        return;
    }
    for i32 i = 1; i < g.Viewports.Size; i++ {
        ImGuiViewportP* viewport = g.Viewports.Data[i];
        bool destroy_platform_window = false;
        destroy_platform_window |= viewport.LastFrameActive < g.FrameCount - 1;
        destroy_platform_window |= viewport.Window && !IsWindowActiveAndVisible(viewport.Window);
        if destroy_platform_window != 0 {
            ImGui_DestroyPlatformWindow(viewport);
            continue;
        }
        if viewport.LastFrameActive < g.FrameCount || viewport.Size.x <= 0.0f || viewport.Size.y <= 0.0f {
            continue;
        }
        bool is_new_platform_window = viewport.PlatformWindowCreated == false;
        if is_new_platform_window != 0 {
            while true {
                if (g.DebugLogFlags & ImGuiDebugLogFlags_EventViewport) != 0 {
                }
                if !(0 != 0) { break; }
            }
            g.PlatformIO.Platform_CreateWindow(cast(ImGuiViewport*, viewport));
            if g.PlatformIO.Renderer_CreateWindow != null {
                g.PlatformIO.Renderer_CreateWindow(cast(ImGuiViewport*, viewport));
            }
            g.PlatformWindowsCreatedCount++;
            viewport.LastNameHash = 0;
            viewport.LastPlatformSize = ImVec2{FLT_MAX, FLT_MAX};
            viewport.LastPlatformPos = viewport.LastPlatformSize;
            viewport.LastRendererSize = viewport.Size;
            viewport.PlatformWindowCreated = true;
        }
        if (viewport.LastPlatformPos.x != viewport.Pos.x || viewport.LastPlatformPos.y != viewport.Pos.y) && !viewport.PlatformRequestMove {
            g.PlatformIO.Platform_SetWindowPos(cast(ImGuiViewport*, viewport), viewport.Pos);
        }
        if (viewport.LastPlatformSize.x != viewport.Size.x || viewport.LastPlatformSize.y != viewport.Size.y) && !viewport.PlatformRequestResize {
            g.PlatformIO.Platform_SetWindowSize(cast(ImGuiViewport*, viewport), viewport.Size);
        }
        if (viewport.LastRendererSize.x != viewport.Size.x || viewport.LastRendererSize.y != viewport.Size.y) && g.PlatformIO.Renderer_SetWindowSize {
            g.PlatformIO.Renderer_SetWindowSize(cast(ImGuiViewport*, viewport), viewport.Size);
        }
        viewport.LastPlatformPos = viewport.Pos;
        viewport.LastRendererSize = viewport.Size;
        viewport.LastPlatformSize = viewport.LastRendererSize;
        {
            ImGuiWindow* window_for_title = GetWindowForTitleDisplay(viewport.Window);
            if window_for_title != null {
                u8* title_begin = window_for_title.Name;
                var title_end = cast(u8*, cast(i64, ImGui_FindRenderedTextEnd(title_begin)));
                ImGuiID title_hash = ImHashStr(title_begin, cast(u64, cast(i64, title_end - title_begin)));
                if viewport.LastNameHash != title_hash {
                    u8 title_end_backup_c = *title_end;
                    *title_end = 0;
                    g.PlatformIO.Platform_SetWindowTitle(cast(ImGuiViewport*, viewport), title_begin);
                    *title_end = title_end_backup_c;
                    viewport.LastNameHash = title_hash;
                }
            }
        }
        if viewport.LastAlpha != viewport.Alpha && g.PlatformIO.Platform_SetWindowAlpha {
            g.PlatformIO.Platform_SetWindowAlpha(cast(ImGuiViewport*, viewport), viewport.Alpha);
        }
        viewport.LastAlpha = viewport.Alpha;
        if g.PlatformIO.Platform_UpdateWindow != null {
            g.PlatformIO.Platform_UpdateWindow(cast(ImGuiViewport*, viewport));
        }
        if is_new_platform_window != 0 {
            if g.FrameCount < 3 {
                viewport.Flags |= ImGuiViewportFlags_NoFocusOnAppearing;
            }
            g.PlatformIO.Platform_ShowWindow(cast(ImGuiViewport*, viewport));
        }
        ImGuiViewportP_ClearRequestFlags(viewport);
    }
}

// This is a default/basic function for performing the rendering/swap of multiple Platform Windows.
// Custom renderers may prefer to not call this function at all, and instead iterate the publicly exposed platform data and handle rendering/sync themselves.
// The Render/Swap functions stored in ImGuiPlatformIO are merely here to allow for this helper to exist, but you can do it yourself:
//
//    ImGuiPlatformIO& platform_io = ImGui::GetPlatformIO();
//    for (int i = 1; i < platform_io.Viewports.Size; i++)
//        if ((platform_io.Viewports[i]->Flags & ImGuiViewportFlags_Minimized) == 0)
//            MyRenderFunction(platform_io.Viewports[i], my_args);
//    for (int i = 1; i < platform_io.Viewports.Size; i++)
//        if ((platform_io.Viewports[i]->Flags & ImGuiViewportFlags_Minimized) == 0)
//            MySwapBufferFunction(platform_io.Viewports[i], my_args);
//
void ImGui_RenderPlatformWindowsDefault(void* platform_render_arg, void* renderer_render_arg) {
    ImGuiPlatformIO* platform_io = ImGui_GetPlatformIO();
    for i32 i = 1; i < platform_io.Viewports.Size; i++ {
        ImGuiViewport* viewport = platform_io.Viewports.Data[i];
        if (viewport.Flags & ImGuiViewportFlags_IsMinimized) != 0 {
            continue;
        }
        if platform_io.Platform_RenderWindow != null {
            platform_io.Platform_RenderWindow(viewport, platform_render_arg);
        }
        if platform_io.Renderer_RenderWindow != null {
            platform_io.Renderer_RenderWindow(viewport, renderer_render_arg);
        }
    }
    for i32 i = 1; i < platform_io.Viewports.Size; i++ {
        ImGuiViewport* viewport = platform_io.Viewports.Data[i];
        if (viewport.Flags & ImGuiViewportFlags_IsMinimized) != 0 {
            continue;
        }
        if platform_io.Platform_SwapBuffers != null {
            platform_io.Platform_SwapBuffers(viewport, platform_render_arg);
        }
        if platform_io.Renderer_SwapBuffers != null {
            platform_io.Renderer_SwapBuffers(viewport, renderer_render_arg);
        }
    }
}

private {
i32 ImGui_FindPlatformMonitorForPos(ImVec2 pos) {
    ImGuiContext* g = GImGui;
    for i32 monitor_n = 0; monitor_n < g.PlatformIO.Monitors.Size; monitor_n++ {
        ImGuiPlatformMonitor monitor = g.PlatformIO.Monitors.Data[monitor_n];
        if ImRect_Contains(&ImRect{
            monitor.MainPos, op_add_ImVec2_ImVec2(monitor.MainPos, monitor.MainSize),
        }, pos) != 0 {
            return monitor_n;
        }
    }
    return -1;
}

// Search for the monitor with the largest intersection area with the given rectangle
// We generally try to avoid searching loops but the monitor count should be very small here
// FIXME-OPT: We could test the last monitor used for that viewport first, and early
i32 ImGui_FindPlatformMonitorForRect(ImRect rect) {
    ImGuiContext* g = GImGui;
    i32 monitor_count = g.PlatformIO.Monitors.Size;
    if monitor_count <= 1 {
        return monitor_count - 1;
    }
    f32 surface_threshold = ImMax(ImRect_GetWidth(&rect) * ImRect_GetHeight(&rect) * 0.5f, 1.0f);
    i32 best_monitor_n = 0;
    f32 best_monitor_surface = 0.001f;
    for i32 monitor_n = 0; monitor_n < g.PlatformIO.Monitors.Size && best_monitor_surface < surface_threshold; monitor_n++ {
        ImGuiPlatformMonitor monitor = g.PlatformIO.Monitors.Data[monitor_n];
        var monitor_rect = ImRect{
            monitor.MainPos, op_add_ImVec2_ImVec2(monitor.MainPos, monitor.MainSize),
        };
        if ImRect_Contains(&monitor_rect, rect) != 0 {
            return monitor_n;
        }
        ImRect overlapping_rect = rect;
        ImRect_ClipWithFull(&overlapping_rect, monitor_rect);
        f32 overlapping_surface = ImRect_GetWidth(&overlapping_rect) * ImRect_GetHeight(&overlapping_rect);
        if overlapping_surface < best_monitor_surface {
            continue;
        }
        best_monitor_surface = overlapping_surface;
        best_monitor_n = monitor_n;
    }
    return best_monitor_n;
}

// Update monitor from viewport rectangle (we'll use this info to clamp windows and save windows lost in a removed monitor)
void ImGui_UpdateViewportPlatformMonitor(ImGuiViewportP* viewport) {
    viewport.PlatformMonitor = cast(i16, ImGui_FindPlatformMonitorForRect(ImGuiViewportP_GetMainRect(viewport)));
}
}

// Return value is always != NULL, but don't hold on it across frames.
ImGuiPlatformMonitor* ImGui_GetViewportPlatformMonitor(ImGuiViewport* viewport_p) {
    ImGuiContext* g = GImGui;
    var viewport = cast(ImGuiViewportP*, cast(void*, viewport_p));
    i32 monitor_idx = viewport.PlatformMonitor;
    if monitor_idx >= 0 && monitor_idx < g.PlatformIO.Monitors.Size {
        return &g.PlatformIO.Monitors.Data[monitor_idx];
    }
    return &g.FallbackMonitor;
}

void ImGui_DestroyPlatformWindow(ImGuiViewportP* viewport) {
    ImGuiContext* g = GImGui;
    if viewport.PlatformWindowCreated != 0 {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventViewport) != 0 {
            }
            if !(0 != 0) { break; }
        }
        if g.PlatformIO.Renderer_DestroyWindow != null {
            g.PlatformIO.Renderer_DestroyWindow(cast(ImGuiViewport*, viewport));
        }
        if g.PlatformIO.Platform_DestroyWindow != null {
            g.PlatformIO.Platform_DestroyWindow(cast(ImGuiViewport*, viewport));
        }
        assert(viewport.RendererUserData == null && viewport.PlatformUserData == null);
        if viewport.ID != ImGui_IMGUI_VIEWPORT_DEFAULT_ID {
            viewport.PlatformWindowCreated = false;
        }
    } else {
        assert(viewport.RendererUserData == null && viewport.PlatformUserData == null && viewport.PlatformHandle == null);
    }
    viewport.PlatformHandle = null;
    viewport.PlatformUserData = viewport.PlatformHandle;
    viewport.RendererUserData = viewport.PlatformUserData;
    ImGuiViewportP_ClearRequestFlags(viewport);
}

void ImGui_DestroyPlatformWindows() {
    ImGuiContext* g = GImGui;
    {
        ImGuiViewportP** zz_rf_it_58 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_58 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_58 != zz_rf_end_58; zz_rf_it_58++ {
            ImGuiViewportP* viewport = *zz_rf_it_58;
            ImGui_DestroyPlatformWindow(viewport);
        }
    }
}

void ImGuiDockRequest_init(ImGuiDockRequest* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.Type = ImGuiDockRequestType_None;
    self.UndockTargetWindow = null;
    self.DockPayload = self.UndockTargetWindow;
    self.DockTargetWindow = self.DockPayload;
    self.UndockTargetNode = null;
    self.DockTargetNode = self.UndockTargetNode;
    self.DockSplitDir = ImGuiDir_None;
    self.DockSplitRatio = 0.5f;
    self.DockSplitOuter = false;
}

ImGuiDockRequest* __cxx_new_ImGuiDockRequest(void* p) {
    ImGuiDockRequest_init(cast(ImGuiDockRequest*, p));
    return cast(ImGuiDockRequest*, p);
}

ImGuiDockRequest __cxx_make_ImGuiDockRequest() {
    ImGuiDockRequest zz_t;
    ImGuiDockRequest_init(&zz_t);
    return zz_t;
}

void ImGuiDockPreviewData_init(ImGuiDockPreviewData* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    ImGuiDockNode_init(&self.FutureNode, 0);
    self.IsSplitDirExplicit = false;
    self.IsSidesAvailable = self.IsSplitDirExplicit;
    self.IsCenterAvailable = self.IsSidesAvailable;
    self.IsDropAllowed = self.IsCenterAvailable;
    self.SplitNode = null;
    self.SplitDir = ImGuiDir_None;
    self.SplitRatio = 0.0f;
    for i32 n = 0; n < cast(i32, sizeof(self.DropRectsDraw) / sizeof(*self.DropRectsDraw)); n++ {
        self.DropRectsDraw[n] = ImRect{ImVec2{FLT_MAX, FLT_MAX}, ImVec2{-FLT_MAX, -FLT_MAX}};
    }
}

ImGuiDockPreviewData* __cxx_new_ImGuiDockPreviewData(void* p) {
    ImGuiDockPreviewData_init(cast(ImGuiDockPreviewData*, p));
    return cast(ImGuiDockPreviewData*, p);
}

ImGuiDockPreviewData __cxx_make_ImGuiDockPreviewData() {
    ImGuiDockPreviewData zz_t;
    ImGuiDockPreviewData_init(&zz_t);
    return zz_t;
}

void ImGuiDockNodeSettings_init(ImGuiDockNodeSettings* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    ImVec2ih_init(&self.Pos);
    ImVec2ih_init(&self.Size);
    ImVec2ih_init(&self.SizeRef);
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
    self.SplitAxis = cast(i8, ImGuiAxis_None);
}

ImGuiDockNodeSettings* __cxx_new_ImGuiDockNodeSettings(void* p) {
    ImGuiDockNodeSettings_init(cast(ImGuiDockNodeSettings*, p));
    return cast(ImGuiDockNodeSettings*, p);
