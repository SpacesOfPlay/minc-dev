    return null;
}

ImGuiViewport* ImGui_FindViewportByPlatformHandle(void* platform_handle) {
    ImGuiContext* g = GImGui;
    {
        ImGuiViewportP** zz_rf_it_50 = ImVector_ImGuiViewportP_ptr_begin(&g.Viewports);
        ImGuiViewportP** zz_rf_end_50 = ImVector_ImGuiViewportP_ptr_end(&g.Viewports);
        for ; zz_rf_it_50 != zz_rf_end_50; zz_rf_it_50++ {
            ImGuiViewportP* viewport = *zz_rf_it_50;
