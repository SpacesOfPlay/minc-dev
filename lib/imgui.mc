    ImGuiDockNodeSettings_init(&zz_t);
    return zz_t;
}

private {
u8* ImGui_DockNodeGetHostWindowTitle(ImGuiDockNode* node, u8* buf, i32 buf_size) {
    ImFormatString(buf, cast(u64, buf_size), "##DockNode_%02X", node.ID);
    return buf;
}
}

//-----------------------------------------------------------------------------
// Docking: ImGuiDockContext
//-----------------------------------------------------------------------------
// The lifetime model is different from the one of regular windows: we always create a ImGuiDockNode for each ImGuiDockNodeSettings,
// or we always hold the entire docking node tree. Nodes are frequently hidden, e.g. if the window(s) or child nodes they host are not active.
// At boot time only, we run a simple GC to remove nodes that have no references.
// Because dock node settings (which are small, contiguous structures) are always mirrored by their corresponding dock nodes (more complete structures),
// we can also very easily recreate the nodes from scratch given the settings data (this is what DockContextRebuild() does).
// This is convenient as docking reconfiguration can be implemented by mostly poking at the simpler settings data.
//-----------------------------------------------------------------------------
// - DockContextInitialize()
// - DockContextShutdown()
// - DockContextClearNodes()
// - DockContextRebuildNodes()
// - DockContextNewFrameUpdateUndocking()
// - DockContextNewFrameUpdateDocking()
// - DockContextEndFrame()
// - DockContextFindNodeByID()
// - DockContextBindNodeToWindow()
// - DockContextGenNodeID()
// - DockContextAddNode()
// - DockContextRemoveNode()
// - ImGuiDockContextPruneNodeData
// - DockContextPruneUnusedSettingsNodes()
// - DockContextBuildNodesFromSettings()
// - DockContextBuildAddWindowsToNodes()
//-----------------------------------------------------------------------------
void ImGui_DockContextInitialize(ImGuiContext* ctx) {
    ImGuiContext* g = ctx;
    ImGuiSettingsHandler ini_handler;
    ini_handler.TypeName = "Docking";
    ini_handler.TypeHash = ImHashStr("Docking");
    ini_handler.ClearAllFn = ImGui_DockSettingsHandler_ClearAll;
    ini_handler.ReadInitFn = ImGui_DockSettingsHandler_ClearAll;
    ini_handler.ReadOpenFn = ImGui_DockSettingsHandler_ReadOpen;
    ini_handler.ReadLineFn = ImGui_DockSettingsHandler_ReadLine;
    ini_handler.ApplyAllFn = ImGui_DockSettingsHandler_ApplyAll;
    ini_handler.WriteAllFn = ImGui_DockSettingsHandler_WriteAll;
    ImVector_ImGuiSettingsHandler_push_back(&g.SettingsHandlers, ini_handler);
    g.DockNodeWindowMenuHandler = &ImGui_DockNodeWindowMenuHandler_Default;
}

void ImGui_DockContextShutdown(ImGuiContext* ctx) {
    ImGuiDockContext* dc = &ctx.DockContext;
    for i32 n = 0; n < dc.Nodes.Data.Size; n++ {
        var node = cast(ImGuiDockNode*, dc.Nodes.Data.Data[n].val_p);
        if node != null {
            ImGui_DockContextDeleteNode(ctx, node);
        }
    }
}

void ImGui_DockContextClearNodes(ImGuiContext* ctx, ImGuiID root_id, bool clear_settings_refs) {
    ignore ctx;
    assert(ctx == GImGui);
    ImGui_DockBuilderRemoveNodeDockedWindows(root_id, clear_settings_refs);
    ImGui_DockBuilderRemoveNodeChildNodes(root_id);
}

// [DEBUG] This function also acts as a defacto test to make sure we can rebuild from scratch without a glitch
// (Different from DockSettingsHandler_ClearAll() + DockSettingsHandler_ApplyAll() because this reuses current settings!)
void ImGui_DockContextRebuildNodes(ImGuiContext* ctx) {
    ImGuiContext* g = ctx;
    ImGuiDockContext* dc = &ctx.DockContext;
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
        }
        if !(0 != 0) { break; }
    }
    ImGui_SaveIniSettingsToMemory();
    ImGuiID root_id = 0;
    ImGui_DockContextClearNodes(ctx, root_id, false);
    ImGui_DockContextBuildNodesFromSettings(ctx, dc.NodesSettings.Data, dc.NodesSettings.Size);
    ImGui_DockContextBuildAddWindowsToNodes(ctx, root_id);
}

// Docking context update function, called by NewFrame()
void ImGui_DockContextNewFrameUpdateUndocking(ImGuiContext* ctx) {
    ImGuiContext* g = ctx;
    ImGuiDockContext* dc = &ctx.DockContext;
    if (g.IO.ConfigFlags & ImGuiConfigFlags_DockingEnable) == 0 {
        if dc.Nodes.Data.Size > 0 || dc.Requests.Size > 0 {
            ImGui_DockContextClearNodes(ctx, 0, true);
        }
        return;
    }
    if g.IO.ConfigDockingNoSplit != 0 {
        for i32 n = 0; n < dc.Nodes.Data.Size; n++ {
            var node = cast(ImGuiDockNode*, dc.Nodes.Data.Data[n].val_p);
            if node != null {
                if ImGuiDockNode_IsRootNode(node) && ImGuiDockNode_IsSplitNode(node) {
                    ImGui_DockBuilderRemoveNodeChildNodes(node.ID);
                }
            }
        }
    }
    if dc.WantFullRebuild != 0 {
        ImGui_DockContextRebuildNodes(ctx);
        dc.WantFullRebuild = false;
    }
    {
        ImGuiDockRequest* zz_rf_it_59 = ImVector_ImGuiDockRequest_begin(&dc.Requests);
        ImGuiDockRequest* zz_rf_end_59 = ImVector_ImGuiDockRequest_end(&dc.Requests);
        for ; zz_rf_it_59 != zz_rf_end_59; zz_rf_it_59++ {
            ImGuiDockRequest* req = zz_rf_it_59;
            if req.Type == ImGuiDockRequestType_Undock && req.UndockTargetWindow {
                ImGui_DockContextProcessUndockWindow(ctx, req.UndockTargetWindow);
            } else if req.Type == ImGuiDockRequestType_Undock && req.UndockTargetNode {
                ImGui_DockContextProcessUndockNode(ctx, req.UndockTargetNode);
            }
        }
    }
}

// Docking context update function, called by NewFrame()
void ImGui_DockContextNewFrameUpdateDocking(ImGuiContext* ctx) {
    ImGuiContext* g = ctx;
    ImGuiDockContext* dc = &ctx.DockContext;
    if (g.IO.ConfigFlags & ImGuiConfigFlags_DockingEnable) == 0 {
        return;
    }
    g.DebugHoveredDockNode = null;
    {
        ImGuiWindow* hovered_window = g.HoveredWindowUnderMovingWindow;
        if hovered_window != null {
            if hovered_window.DockNodeAsHost != null {
                g.DebugHoveredDockNode = ImGui_DockNodeTreeFindVisibleNodeByPos(hovered_window.DockNodeAsHost, g.IO.MousePos);
            } else if hovered_window.RootWindow.DockNode != null {
                g.DebugHoveredDockNode = hovered_window.RootWindow.DockNode;
            }
        }
    }
    {
        ImGuiDockRequest* zz_rf_it_60 = ImVector_ImGuiDockRequest_begin(&dc.Requests);
        ImGuiDockRequest* zz_rf_end_60 = ImVector_ImGuiDockRequest_end(&dc.Requests);
        for ; zz_rf_it_60 != zz_rf_end_60; zz_rf_it_60++ {
            ImGuiDockRequest* req = zz_rf_it_60;
            if req.Type == ImGuiDockRequestType_Dock {
                ImGui_DockContextProcessDock(ctx, req);
            }
        }
    }
    ImVector_ImGuiDockRequest_resize(&dc.Requests, 0);
    for i32 n = 0; n < dc.Nodes.Data.Size; n++ {
        var node = cast(ImGuiDockNode*, dc.Nodes.Data.Data[n].val_p);
        if node != null {
            if ImGuiDockNode_IsFloatingNode(node) != 0 {
                ImGui_DockNodeUpdate(node);
            }
        }
    }
}

void ImGui_DockContextEndFrame(ImGuiContext* ctx) {
    ImGuiContext* g = ctx;
    ImGuiDockContext* dc = &g.DockContext;
    for i32 n = 0; n < dc.Nodes.Data.Size; n++ {
        var node = cast(ImGuiDockNode*, dc.Nodes.Data.Data[n].val_p);
        if node != null {
            if node.LastFrameActive == g.FrameCount && node.IsVisible && node.HostWindow && ImGuiDockNode_IsLeafNode(node) && !node.IsBgDrawnThisFrame {
                ImRect bg_rect;
                ImRect_init(&bg_rect, op_add_ImVec2_ImVec2(node.Pos, ImVec2{0.0f, ImGui_GetFrameHeight()}), op_add_ImVec2_ImVec2(node.Pos, node.Size));
                ImDrawFlags bg_rounding_flags = ImGui_CalcRoundingFlagsForRectInRect(bg_rect, ImGuiWindow_Rect(node.HostWindow), g.Style.DockingSeparatorSize);
                ImDrawList_ChannelsSetCurrent(node.HostWindow.DrawList, 0);
                ImDrawList_AddRectFilled(node.HostWindow.DrawList, bg_rect.Min, bg_rect.Max, node.LastBgColor, node.HostWindow.WindowRounding, bg_rounding_flags);
            }
        }
    }
}

ImGuiDockNode* ImGui_DockContextFindNodeByID(ImGuiContext* ctx, ImGuiID id) {
    return cast(ImGuiDockNode*, ImGuiStorage_GetVoidPtr(&ctx.DockContext.Nodes, id));
}

ImGuiID ImGui_DockContextGenNodeID(ImGuiContext* ctx) {
    ImGuiID id = 0x0001;
    while ImGui_DockContextFindNodeByID(ctx, id) != null {
        id++;
    }
    return id;
}

private {
ImGuiDockNode* ImGui_DockContextAddNode(ImGuiContext* ctx, ImGuiID id) {
    ImGuiContext* g = ctx;
    if id == 0 {
        id = ImGui_DockContextGenNodeID(ctx);
    } else {
        assert(ImGui_DockContextFindNodeByID(ctx, id) == null);
    }
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
        }
        if !(0 != 0) { break; }
    }
    var node = cast(ImGuiDockNode*, ImGui_MemAlloc(cast(u64, sizeof(ImGuiDockNode))));
    ImGuiDockNode_init(node, id);
    ImGuiStorage_SetVoidPtr(&ctx.DockContext.Nodes, node.ID, node);
    return node;
}

void ImGui_DockContextRemoveNode(ImGuiContext* ctx, ImGuiDockNode* node, bool merge_sibling_into_parent_node) {
    ImGuiContext* g = ctx;
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
        }
        if !(0 != 0) { break; }
    }
    assert(ImGui_DockContextFindNodeByID(ctx, node.ID) == node);
    assert(node.ChildNodes[0] == null && node.ChildNodes[1] == null);
    assert(node.Windows.Size == 0);
    if node.HostWindow != null {
        node.HostWindow.DockNodeAsHost = null;
    }
    ImGuiDockNode* parent_node = node.ParentNode;
    bool merge = merge_sibling_into_parent_node && parent_node != null;
    if merge != 0 {
        assert(parent_node.ChildNodes[0] == node || parent_node.ChildNodes[1] == node);
        ImGuiDockNode* sibling_node = parent_node.ChildNodes[0] == node ? parent_node.ChildNodes[1] : parent_node.ChildNodes[0];
        ImGui_DockNodeTreeMerge(g, parent_node, sibling_node);
    } else {
        for i32 n = 0; parent_node && n < cast(i32, sizeof(parent_node.ChildNodes) / sizeof(*parent_node.ChildNodes)); n++ {
            if parent_node.ChildNodes[n] == node {
                node.ParentNode.ChildNodes[n] = null;
            }
        }
        ImGui_DockContextDeleteNode(ctx, node);
    }
}

// Raw-ish delete
void ImGui_DockContextDeleteNode(ImGuiContext* ctx, ImGuiDockNode* node) {
    ImGuiDockContext* dc = &ctx.DockContext;
    if node.TabBar != null {
        0;
    }
    node.TabBar = null;
    ImGuiStorage_SetVoidPtr(&dc.Nodes, node.ID, null);
    0;
}

i32 DockNodeComparerDepthMostFirst(void* lhs, void* rhs) {
    ImGuiDockNode* a = *cast(ImGuiDockNode**, lhs);
    ImGuiDockNode* b = *cast(ImGuiDockNode**, rhs);
    return ImGui_DockNodeGetDepth(b) - ImGui_DockNodeGetDepth(a);
}
}

void ImGuiDockContextPruneNodeData_init(ImGuiDockContextPruneNodeData* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    self.CountChildNodes = 0;
    self.CountChildWindows = self.CountChildNodes;
    self.CountWindows = self.CountChildWindows;
    self.RootId = 0;
}

ImGuiDockContextPruneNodeData* __cxx_new_ImGuiDockContextPruneNodeData(void* p) {
    ImGuiDockContextPruneNodeData_init(cast(ImGuiDockContextPruneNodeData*, p));
    return cast(ImGuiDockContextPruneNodeData*, p);
}

ImGuiDockContextPruneNodeData __cxx_make_ImGuiDockContextPruneNodeData() {
    ImGuiDockContextPruneNodeData zz_t;
    ImGuiDockContextPruneNodeData_init(&zz_t);
    return zz_t;
}

// Garbage collect unused nodes (run once at init time)
private {
void ImGui_DockContextPruneUnusedSettingsNodes(ImGuiContext* ctx) {
    ImGuiContext* g = ctx;
    ImGuiDockContext* dc = &ctx.DockContext;
    assert(g.Windows.Size == 0);
    ImPool_ImGuiDockContextPruneNodeData pool;
    ImPool_ImGuiDockContextPruneNodeData_Reserve(&pool, dc.NodesSettings.Size);
    for i32 settings_n = 0; settings_n < dc.NodesSettings.Size; settings_n++ {
        ImGuiDockNodeSettings* settings = &dc.NodesSettings.Data[settings_n];
        if ImPool_ImGuiDockContextPruneNodeData_GetByKey(&pool, settings.ID) != null {
            settings.ID = 0;
            continue;
        }
        ImGuiDockContextPruneNodeData* parent_data = settings.ParentNodeId != 0 ? ImPool_ImGuiDockContextPruneNodeData_GetByKey(&pool, settings.ParentNodeId) : null;
        ImPool_ImGuiDockContextPruneNodeData_GetOrAddByKey(&pool, settings.ID).RootId = parent_data != null ? parent_data.RootId : settings.ID;
        if settings.ParentNodeId != 0 {
            { ImGuiDockContextPruneNodeData* zz_pnd = ImPool_ImGuiDockContextPruneNodeData_GetOrAddByKey(&pool, settings.ParentNodeId); zz_pnd.CountChildNodes++; }
        }
    }
    for i32 settings_n = 0; settings_n < dc.NodesSettings.Size; settings_n++ {
        ImGuiDockNodeSettings* settings = &dc.NodesSettings.Data[settings_n];
        if settings.ParentWindowId != 0 {
            ImGuiWindowSettings* window_settings = ImGui_FindWindowSettingsByID(settings.ParentWindowId);
            if window_settings != null {
                if window_settings.DockId != 0 {
                    ImGuiDockContextPruneNodeData* data = ImPool_ImGuiDockContextPruneNodeData_GetByKey(&pool, window_settings.DockId);
                    if data != null {
                        data.CountChildNodes++;
                    }
                }
            }
        }
    }
    for ImGuiWindowSettings* settings = ImChunkStream_ImGuiWindowSettings_begin(&g.SettingsWindows); settings != null; settings = ImChunkStream_ImGuiWindowSettings_next_chunk(&g.SettingsWindows, settings) {
        ImGuiID dock_id = settings.DockId;
        if dock_id != 0 {
            ImGuiDockContextPruneNodeData* data = ImPool_ImGuiDockContextPruneNodeData_GetByKey(&pool, dock_id);
            if data != null {
                data.CountWindows++;
                {
                    ImGuiDockContextPruneNodeData* data_root = data.RootId == dock_id ? data : ImPool_ImGuiDockContextPruneNodeData_GetByKey(&pool, data.RootId);
                    if data_root != null {
                        data_root.CountChildWindows++;
                    }
                }
            }
        }
    }
    for i32 settings_n = 0; settings_n < dc.NodesSettings.Size; settings_n++ {
        ImGuiDockNodeSettings* settings = &dc.NodesSettings.Data[settings_n];
        ImGuiDockContextPruneNodeData* data = ImPool_ImGuiDockContextPruneNodeData_GetByKey(&pool, settings.ID);
        if data == null || data.CountWindows > 1 {
            continue;
        }
        ImGuiDockContextPruneNodeData* data_root = settings.ID == data.RootId ? data : ImPool_ImGuiDockContextPruneNodeData_GetByKey(&pool, data.RootId);
        ImGuiDockContextPruneNodeData* data_parent = settings.ParentNodeId != 0 ? ImPool_ImGuiDockContextPruneNodeData_GetByKey(&pool, settings.ParentNodeId) : null;
        bool remove_var = false;  // renamed from: remove
        remove_var |= data.CountWindows == 1 && settings.ParentNodeId == 0 && data.CountChildNodes == 0 && !(settings.Flags & ImGuiDockNodeFlags_CentralNode);
        remove_var |= data.CountWindows == 0 && settings.ParentNodeId == 0 && data.CountChildNodes == 0;
        remove_var |= data_root == null || data_root.CountChildWindows == 0;
        if remove_var != 0 {
            while true {
                if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
                }
                if !(0 != 0) { break; }
            }
            ImGui_DockSettingsRemoveNodeReferences(&settings.ID, 1);
            settings.ID = 0;
        } else if data_parent && data_parent.CountChildNodes == 1 {
            while true {
                if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
                }
                if !(0 != 0) { break; }
            }
            ImGui_DockSettingsRenameNodeReferences(settings.ID, settings.ParentNodeId);
            settings.ID = 0;
        }
    }
}

void ImGui_DockContextBuildNodesFromSettings(ImGuiContext* ctx, ImGuiDockNodeSettings* node_settings_array, i32 node_settings_count) {
    ImGuiContext* g = ctx;
    ignore *g;
    for i32 node_n = 0; node_n < node_settings_count; node_n++ {
        ImGuiDockNodeSettings* settings = &node_settings_array[node_n];
        if settings.ID == 0 {
            continue;
        }
        if ImGui_DockContextFindNodeByID(ctx, settings.ID) != null {
            while true {
                if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
                }
                if !(0 != 0) { break; }
            }
            continue;
        }
        ImGuiDockNode* node = ImGui_DockContextAddNode(ctx, settings.ID);
        node.ParentNode = settings.ParentNodeId != 0 ? ImGui_DockContextFindNodeByID(ctx, settings.ParentNodeId) : null;
        node.Pos = ImVec2{cast(f32, settings.Pos.x), cast(f32, settings.Pos.y)};
        node.Size = ImVec2{cast(f32, settings.Size.x), cast(f32, settings.Size.y)};
        node.SizeRef = ImVec2{cast(f32, settings.SizeRef.x), cast(f32, settings.SizeRef.y)};
        node.AuthorityForViewport = cast(ImU8, ImGuiDataAuthority_DockNode);
        node.AuthorityForSize = node.AuthorityForViewport;
        node.AuthorityForPos = node.AuthorityForSize;
        if node.ParentNode && node.ParentNode.ChildNodes[0] == null {
            node.ParentNode.ChildNodes[0] = node;
        } else if node.ParentNode && node.ParentNode.ChildNodes[1] == null {
            node.ParentNode.ChildNodes[1] = node;
        }
        node.SelectedTabId = settings.SelectedTabId;
        node.SplitAxis = cast(ImGuiAxis, settings.SplitAxis);
        ImGuiDockNode_SetLocalFlags(node, settings.Flags & ImGuiDockNodeFlags_SavedFlagsMask_);
        u8[20] host_window_title;
        ImGuiDockNode* root_node = ImGui_DockNodeGetRootNode(node);
        node.HostWindow = ImGui_FindWindowByName(ImGui_DockNodeGetHostWindowTitle(root_node, host_window_title, cast(i32, sizeof(host_window_title) / sizeof(*host_window_title))));
    }
}
}

void ImGui_DockContextBuildAddWindowsToNodes(ImGuiContext* ctx, ImGuiID root_id) {
    ImGuiContext* g = ctx;
    {
        ImGuiWindow** zz_rf_it_61 = ImVector_ImGuiWindow_ptr_begin(&g.Windows);
        ImGuiWindow** zz_rf_end_61 = ImVector_ImGuiWindow_ptr_end(&g.Windows);
        for ; zz_rf_it_61 != zz_rf_end_61; zz_rf_it_61++ {
            ImGuiWindow* window = *zz_rf_it_61;
            if window.DockId == 0 || window.LastFrameActive < g.FrameCount - 1 {
                continue;
            }
            if window.DockNode != null {
                continue;
            }
            ImGuiDockNode* node = ImGui_DockContextFindNodeByID(ctx, window.DockId);
            assert(node != null);
            if root_id == 0 || ImGui_DockNodeGetRootNode(node).ID == root_id {
                ImGui_DockNodeAddWindow(node, window, true);
            }
        }
    }
}

//-----------------------------------------------------------------------------
// Docking: ImGuiDockContext Docking/Undocking functions
//-----------------------------------------------------------------------------
// - DockContextQueueDock()
// - DockContextQueueUndockWindow()
// - DockContextQueueUndockNode()
// - DockContextQueueNotifyRemovedNode()
// - DockContextProcessDock()
// - DockContextProcessUndockWindow()
// - DockContextProcessUndockNode()
// - DockContextCalcDropPosForDocking()
//-----------------------------------------------------------------------------
void ImGui_DockContextQueueDock(ImGuiContext* ctx, ImGuiWindow* target, ImGuiDockNode* target_node, ImGuiWindow* payload, ImGuiDir split_dir, f32 split_ratio, bool split_outer) {
    assert(target != payload);
    ImGuiDockRequest req;
    req.Type = ImGuiDockRequestType_Dock;
    req.DockTargetWindow = target;
    req.DockTargetNode = target_node;
    req.DockPayload = payload;
    req.DockSplitDir = split_dir;
    req.DockSplitRatio = split_ratio;
    req.DockSplitOuter = split_outer;
    ImVector_ImGuiDockRequest_push_back(&ctx.DockContext.Requests, req);
}

void ImGui_DockContextQueueUndockWindow(ImGuiContext* ctx, ImGuiWindow* window) {
    ImGuiDockRequest req;
    req.Type = ImGuiDockRequestType_Undock;
    req.UndockTargetWindow = window;
    ImVector_ImGuiDockRequest_push_back(&ctx.DockContext.Requests, req);
}

void ImGui_DockContextQueueUndockNode(ImGuiContext* ctx, ImGuiDockNode* node) {
    ImGuiDockRequest req;
    req.Type = ImGuiDockRequestType_Undock;
    req.UndockTargetNode = node;
    ImVector_ImGuiDockRequest_push_back(&ctx.DockContext.Requests, req);
}

void ImGui_DockContextQueueNotifyRemovedNode(ImGuiContext* ctx, ImGuiDockNode* node) {
    ImGuiDockContext* dc = &ctx.DockContext;
    {
        ImGuiDockRequest* zz_rf_it_62 = ImVector_ImGuiDockRequest_begin(&dc.Requests);
        ImGuiDockRequest* zz_rf_end_62 = ImVector_ImGuiDockRequest_end(&dc.Requests);
        for ; zz_rf_it_62 != zz_rf_end_62; zz_rf_it_62++ {
            ImGuiDockRequest* req = zz_rf_it_62;
            if req.DockTargetNode == node {
                req.Type = ImGuiDockRequestType_None;
            }
        }
    }
}

void ImGui_DockContextProcessDock(ImGuiContext* ctx, ImGuiDockRequest* req) {
    assert(req.Type == ImGuiDockRequestType_Dock && req.DockPayload != null || req.Type == ImGuiDockRequestType_Split && req.DockPayload == null);
    assert(req.DockTargetWindow != null || req.DockTargetNode != null);
    ImGuiContext* g = ctx;
    ignore *g;
    ImGuiWindow* payload_window = req.DockPayload;
    ImGuiWindow* target_window = req.DockTargetWindow;
    ImGuiDockNode* node = req.DockTargetNode;
    if payload_window != null {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
            }
            if !(0 != 0) { break; }
        }
    } else {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
            }
            if !(0 != 0) { break; }
        }
    }
    ImGuiID next_selected_id = 0;
    ImGuiDockNode* payload_node = null;
    if payload_window != null {
        payload_node = payload_window.DockNodeAsHost;
        payload_window.DockNodeAsHost = null;
        if payload_node && ImGuiDockNode_IsLeafNode(payload_node) {
            next_selected_id = payload_node.TabBar.NextSelectedTabId != 0 ? payload_node.TabBar.NextSelectedTabId : payload_node.TabBar.SelectedTabId;
        }
        if payload_node == null {
            next_selected_id = payload_window.TabId;
        }
    }
    if node != null {
        assert(node.LastFrameAlive <= g.FrameCount);
    }
    if node && target_window && node == target_window.DockNodeAsHost {
        assert(node.Windows.Size > 0 || ImGuiDockNode_IsSplitNode(node) || ImGuiDockNode_IsCentralNode(node));
    }
    if node == null {
        node = ImGui_DockContextAddNode(ctx, 0);
        node.Pos = target_window.Pos;
        node.Size = target_window.Size;
        if target_window.DockNodeAsHost == null {
            ImGui_DockNodeAddWindow(node, target_window, true);
            node.TabBar.Tabs.Data[0].Flags &= ~ImGuiTabItemFlags_Unsorted;
            target_window.DockIsActive = true;
        }
    }
    ImGuiDir split_dir = req.DockSplitDir;
    if split_dir != ImGuiDir_None {
        ImGuiAxis split_axis = split_dir == ImGuiDir_Left || split_dir == ImGuiDir_Right ? ImGuiAxis_X : ImGuiAxis_Y;
        i32 split_inheritor_child_idx = split_dir == ImGuiDir_Left || split_dir == ImGuiDir_Up ? 1 : 0;
        f32 split_ratio = req.DockSplitRatio;
        ImGui_DockNodeTreeSplit(ctx, node, split_axis, split_inheritor_child_idx, split_ratio, payload_node);
        ImGuiDockNode* new_node = node.ChildNodes[split_inheritor_child_idx ^ 1];
        new_node.HostWindow = node.HostWindow;
        node = new_node;
    }
    ImGuiDockNode_SetLocalFlags(node, node.LocalFlags & ~ImGuiDockNodeFlags_HiddenTabBar);
    if node != payload_node {
        if node.Windows.Size > 0 && node.TabBar == null {
            ImGui_DockNodeAddTabBar(node);
            for i32 n = 0; n < node.Windows.Size; n++ {
                ImGui_TabBarAddTab(node.TabBar, ImGuiTabItemFlags_None, node.Windows.Data[n]);
            }
        }
        if payload_node != null {
            if ImGuiDockNode_IsSplitNode(payload_node) != 0 {
                if node.Windows.Size > 0 {
                    assert(payload_node.OnlyNodeWithWindows != null);
                    ImGuiDockNode* visible_node = payload_node.OnlyNodeWithWindows;
                    if visible_node.TabBar != null {
                        assert(visible_node.TabBar.Tabs.Size > 0);
                    }
                    ImGui_DockNodeMoveWindows(node, visible_node);
                    ImGui_DockNodeMoveWindows(visible_node, node);
                    ImGui_DockSettingsRenameNodeReferences(node.ID, visible_node.ID);
                }
                if ImGuiDockNode_IsCentralNode(node) != 0 {
                    ImGuiDockNode* last_focused_node = ImGui_DockContextFindNodeByID(ctx, payload_node.LastFocusedNodeId);
                    assert(last_focused_node != null);
                    ImGuiDockNode* last_focused_root_node = ImGui_DockNodeGetRootNode(last_focused_node);
                    assert(last_focused_root_node == ImGui_DockNodeGetRootNode(payload_node));
                    ImGuiDockNode_SetLocalFlags(last_focused_node, last_focused_node.LocalFlags | ImGuiDockNodeFlags_CentralNode);
                    ImGuiDockNode_SetLocalFlags(node, node.LocalFlags & ~ImGuiDockNodeFlags_CentralNode);
                    last_focused_root_node.CentralNode = last_focused_node;
                }
                assert(node.Windows.Size == 0);
                ImGui_DockNodeMoveChildNodes(node, payload_node);
            } else {
                ImGuiID payload_dock_id = payload_node.ID;
                ImGui_DockNodeMoveWindows(node, payload_node);
                ImGui_DockSettingsRenameNodeReferences(payload_dock_id, node.ID);
            }
            ImGui_DockContextRemoveNode(ctx, payload_node, true);
        } else if payload_window != null {
            ImGuiID payload_dock_id = payload_window.DockId;
            node.VisibleWindow = payload_window;
            ImGui_DockNodeAddWindow(node, payload_window, true);
            if payload_dock_id != 0 {
                ImGui_DockSettingsRenameNodeReferences(payload_dock_id, node.ID);
            }
        }
    } else {
        node.WantHiddenTabBarUpdate = true;
    }
    {
        ImGuiTabBar* tab_bar = node.TabBar;
        if tab_bar != null {
            tab_bar.NextSelectedTabId = next_selected_id;
        }
    }
    ImGui_MarkIniSettingsDirty();
}

// Problem:
//   Undocking a large (~full screen) window would leave it so large that the bottom right sizing corner would more
//   than likely be off the screen and the window would be hard to resize to fit on screen. This can be particularly problematic
//   with 'ConfigWindowsMoveFromTitleBarOnly=true' and/or with 'ConfigWindowsResizeFromEdges=false' as well (the later can be
//   due to missing ImGuiBackendFlags_HasMouseCursors backend flag).
// Solution:
//   When undocking a window we currently force its maximum size to 90% of the host viewport or monitor.
// Reevaluate this when we implement preserving docked/undocked size ("docking_wip/undocked_size" branch).
private {
ImVec2 FixLargeWindowsWhenUndocking(ImVec2 size, ImGuiViewport* ref_viewport) {
    if ref_viewport == null {
        return size;
    }
    ImGuiContext* g = GImGui;
    ImVec2 max_size = ImTrunc(op_mul_ImVec2_float(ref_viewport.WorkSize, 0.9f));
    if (g.ConfigFlagsCurrFrame & ImGuiConfigFlags_ViewportsEnable) != 0 {
        ImGuiPlatformMonitor* monitor = ImGui_GetViewportPlatformMonitor(ref_viewport);
        max_size = ImTrunc(op_mul_ImVec2_float(monitor.WorkSize, 0.9f));
    }
    return ImMin(size, max_size);
}
}

void ImGui_DockContextProcessUndockWindow(ImGuiContext* ctx, ImGuiWindow* window, bool clear_persistent_docking_ref) {
    ImGuiContext* g = ctx;
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
        }
        if !(0 != 0) { break; }
    }
    if window.DockNode != null {
        ImGui_DockNodeRemoveWindow(window.DockNode, window, cast(ImGuiID, clear_persistent_docking_ref != 0 ? 0 : window.DockId));
    } else {
        window.DockId = 0;
    }
    window.Collapsed = false;
    window.DockIsActive = false;
    window.DockTabIsVisible = false;
    window.DockNodeIsVisible = window.DockTabIsVisible;
    window.SizeFull = FixLargeWindowsWhenUndocking(window.SizeFull, cast(ImGuiViewport*, window.Viewport));
    window.Size = window.SizeFull;
    ImGui_MarkIniSettingsDirty();
}

void ImGui_DockContextProcessUndockNode(ImGuiContext* ctx, ImGuiDockNode* node) {
    ImGuiContext* g = ctx;
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventDocking) != 0 {
        }
        if !(0 != 0) { break; }
    }
    assert(cast(i64, ImGuiDockNode_IsLeafNode(node)));
    assert(node.Windows.Size >= 1);
    if ImGuiDockNode_IsRootNode(node) || ImGuiDockNode_IsCentralNode(node) {
        ImGuiDockNode* new_node = ImGui_DockContextAddNode(ctx, 0);
        new_node.Pos = node.Pos;
        new_node.Size = node.Size;
        new_node.SizeRef = node.SizeRef;
        ImGui_DockNodeMoveWindows(new_node, node);
        ImGui_DockSettingsRenameNodeReferences(node.ID, new_node.ID);
        node = new_node;
    } else {
        assert(node.ParentNode.ChildNodes[0] == node || node.ParentNode.ChildNodes[1] == node);
        i32 index_in_parent = node.ParentNode.ChildNodes[0] == node ? 0 : 1;
        node.ParentNode.ChildNodes[index_in_parent] = null;
        ImGui_DockNodeTreeMerge(ctx, node.ParentNode, node.ParentNode.ChildNodes[index_in_parent ^ 1]);
        node.ParentNode.AuthorityForViewport = cast(ImU8, ImGuiDataAuthority_Window);
        node.ParentNode = null;
    }
    {
        ImGuiWindow** zz_rf_it_63 = ImVector_ImGuiWindow_ptr_begin(&node.Windows);
        ImGuiWindow** zz_rf_end_63 = ImVector_ImGuiWindow_ptr_end(&node.Windows);
        for ; zz_rf_it_63 != zz_rf_end_63; zz_rf_it_63++ {
            ImGuiWindow* window = *zz_rf_it_63;
            window.Flags &= ~ImGuiWindowFlags_ChildWindow;
            if window.ParentWindow != null {
                ImVector_ImGuiWindow_ptr_find_erase(&window.ParentWindow.DC.ChildWindows, window);
            }
            ImGui_UpdateWindowParentAndRootLinks(window, window.Flags, null);
        }
    }
    node.AuthorityForSize = cast(ImU8, ImGuiDataAuthority_DockNode);
    node.AuthorityForPos = node.AuthorityForSize;
    node.Size = FixLargeWindowsWhenUndocking(node.Size, cast(ImGuiViewport*, node.Windows.Data[0].Viewport));
    node.WantMouseMove = true;
    ImGui_MarkIniSettingsDirty();
}

// This is mostly used for automation.
bool ImGui_DockContextCalcDropPosForDocking(ImGuiWindow* target, ImGuiDockNode* target_node, ImGuiWindow* payload_window, ImGuiDockNode* payload_node, ImGuiDir split_dir, bool split_outer, ImVec2* out_pos) {
    if target != null && target_node == null {
        target_node = target.DockNode;
    }
    if target_node && target_node.ParentNode == null && ImGuiDockNode_IsCentralNode(target_node) && split_dir != ImGuiDir_None {
        split_outer = true;
    }
    ImGuiDockPreviewData split_data;
    ImGui_DockNodePreviewDockSetup(target, target_node, payload_window, payload_node, &split_data, false, split_outer);
    if ImRect_IsInverted(&split_data.DropRectsDraw[split_dir + 1]) != 0 {
        return false;
    }
    *out_pos = ImRect_GetCenter(&split_data.DropRectsDraw[split_dir + 1]);
    return true;
}

