    window.ParentWindowForFocusRoute = parent_window;
}

ImRect ImGui_WindowRectAbsToRel(ImGuiWindow* window, ImRect r) {
    ImVec2 off = window.DC.CursorStartPos;
    return ImRect{
        ImVec2{r.Min.x - off.x, r.Min.y - off.y},
        ImVec2{r.Max.x - off.x, r.Max.y - off.y},
    };
}

ImRect ImGui_WindowRectRelToAbs(ImGuiWindow* window, ImRect r) {
    ImVec2 off = window.DC.CursorStartPos;
    return ImRect{
        ImVec2{r.Min.x + off.x, r.Min.y + off.y},
        ImVec2{r.Max.x + off.x, r.Max.y + off.y},
    };
}

ImVec2 ImGui_WindowPosAbsToRel(ImGuiWindow* window, ImVec2 p) {
    ImVec2 off = window.DC.CursorStartPos;
    return ImVec2{p.x - off.x, p.y - off.y};
}

ImVec2 ImGui_WindowPosRelToAbs(ImGuiWindow* window, ImVec2 p) {
    ImVec2 off = window.DC.CursorStartPos;
    return ImVec2{p.x + off.x, p.y + off.y};
}

