// Note: this will likely be called ActivateItem() once we rework our Focus/Activation system!
// But ActivateItem() should function without altering scroll/focus?
void ImGui_SetKeyboardFocusHere(i32 offset) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    assert(offset >= -1);
    while true {
        if (g.DebugLogFlags & ImGuiDebugLogFlags_EventFocus) != 0 {
        }
        if !(0 != 0) { break; }
    }
    if g.DragDropActive || g.MovingWindow != null {
        while true {
            if (g.DebugLogFlags & ImGuiDebugLogFlags_EventFocus) != 0 {
            }
            if !(0 != 0) { break; }
        }
        return;
    }
    ImGui_SetNavWindow(window);
    ImGuiNavMoveFlags move_flags = ImGuiNavMoveFlags_IsTabbing | ImGuiNavMoveFlags_Activate | ImGuiNavMoveFlags_FocusApi | ImGuiNavMoveFlags_NoSetNavCursorVisible;
    ImGuiScrollFlags scroll_flags = window.Appearing != 0 ? ImGuiScrollFlags_KeepVisibleEdgeX | ImGuiScrollFlags_AlwaysCenterY : ImGuiScrollFlags_KeepVisibleEdgeX | ImGuiScrollFlags_KeepVisibleEdgeY;
    ImGui_NavMoveRequestSubmit(ImGuiDir_None, offset < 0 ? ImGuiDir_Up : ImGuiDir_Down, move_flags, scroll_flags);
    if offset == -1 {
        ImGui_NavMoveRequestResolveWithLastItem(&g.NavMoveResultLocal);
    } else {
        g.NavTabbingDir = 1;
        g.NavTabbingCounter = offset + 1;
    }
}

void ImGui_SetItemDefaultFocus() {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    if window.Appearing == 0 {
        return;
    }
    if g.NavWindow != window.RootWindowForNav || !g.NavInitRequest && g.NavInitResult.ID == 0 || g.NavLayer != window.DC.NavLayerCurrent {
        return;
    }
    g.NavInitRequest = false;
    ImGui_NavApplyItemToResult(&g.NavInitResult);
    ImGui_NavUpdateAnyRequestFlag();
    if ImRect_Contains(&window.ClipRect, g.LastItemData.Rect) == 0 {
        ImGui_ScrollToRectEx(window, g.LastItemData.Rect, ImGuiScrollFlags_None);
    }
}

void ImGui_SetStateStorage(ImGuiStorage* tree) {
    ImGuiWindow* window = GImGui.CurrentWindow;
    window.DC.StateStorage = tree != null ? tree : &window.StateStorage;
}

ImGuiStorage* ImGui_GetStateStorage() {
    ImGuiWindow* window = GImGui.CurrentWindow;
    return window.DC.StateStorage;
}

bool ImGui_IsRectVisible(ImVec2 size) {
    ImGuiWindow* window = GImGui.CurrentWindow;
    return ImRect_Overlaps(&window.ClipRect, ImRect{
        window.DC.CursorPos, op_add_ImVec2_ImVec2(window.DC.CursorPos, size),
    });
}

bool ImGui_IsRectVisible(ImVec2 rect_min, ImVec2 rect_max) {
    ImGuiWindow* window = GImGui.CurrentWindow;
    return ImRect_Overlaps(&window.ClipRect, ImRect{rect_min, rect_max});
}

//-----------------------------------------------------------------------------
// [SECTION] FONTS, TEXTURES
//-----------------------------------------------------------------------------
// Most of the relevant font logic is in imgui_draw.cpp.
// Those are high-level support functions.
//-----------------------------------------------------------------------------
// - UpdateTexturesNewFrame() [Internal]
// - UpdateTexturesEndFrame() [Internal]
// - UpdateFontsNewFrame() [Internal]
// - UpdateFontsEndFrame() [Internal]
// - GetDefaultFont() [Internal]
// - RegisterUserTexture() [Internal]
// - UnregisterUserTexture() [Internal]
// - RegisterFontAtlas() [Internal]
// - UnregisterFontAtlas() [Internal]
// - SetCurrentFont() [Internal]
// - UpdateCurrentFontSize() [Internal]
// - SetFontRasterizerDensity() [Internal]
// - PushFont()
// - PopFont()
//-----------------------------------------------------------------------------
private {
void ImGui_UpdateTexturesNewFrame() {
    ImGuiContext* g = GImGui;
    bool has_textures = (g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures) != 0;
    {
        ImFontAtlas** zz_rf_it_26 = ImVector_ImFontAtlas_ptr_begin(&g.FontAtlases);
        ImFontAtlas** zz_rf_end_26 = ImVector_ImFontAtlas_ptr_end(&g.FontAtlases);
        for ; zz_rf_it_26 != zz_rf_end_26; zz_rf_it_26++ {
            ImFontAtlas* atlas = *zz_rf_it_26;
            if atlas.OwnerContext == g {
                ImFontAtlasUpdateNewFrame(atlas, g.FrameCount, has_textures);
            } else {
                assert(atlas.Builder != null && atlas.Builder.FrameCount != -1);
                assert(atlas.RendererHasTextures == has_textures);
            }
        }
    }
    {
        ImTextureData** zz_rf_it_27 = ImVector_ImTextureData_ptr_begin(&g.UserTextures);
        ImTextureData** zz_rf_end_27 = ImVector_ImTextureData_ptr_end(&g.UserTextures);
        for ; zz_rf_it_27 != zz_rf_end_27; zz_rf_it_27++ {
            ImTextureData* tex = *zz_rf_it_27;
            ImTextureDataUpdateNewFrame(tex);
        }
    }
}

// Build a single texture list
void ImGui_UpdateTexturesEndFrame() {
    ImGuiContext* g = GImGui;
    ImVector_ImTextureData_ptr_resize(&g.PlatformIO.Textures, 0);
    {
        ImFontAtlas** zz_rf_it_29 = ImVector_ImFontAtlas_ptr_begin(&g.FontAtlases);
        ImFontAtlas** zz_rf_end_29 = ImVector_ImFontAtlas_ptr_end(&g.FontAtlases);
        for ; zz_rf_it_29 != zz_rf_end_29; zz_rf_it_29++ {
            ImFontAtlas* atlas = *zz_rf_it_29;
            {
                ImTextureData** zz_rf_it_28 = ImVector_ImTextureData_ptr_begin(&atlas.TexList);
                ImTextureData** zz_rf_end_28 = ImVector_ImTextureData_ptr_end(&atlas.TexList);
                for ; zz_rf_it_28 != zz_rf_end_28; zz_rf_it_28++ {
                    ImTextureData* tex = *zz_rf_it_28;
                    tex.RefCount = cast(u16, atlas.RefCount);
                    ImVector_ImTextureData_ptr_push_back(&g.PlatformIO.Textures, tex);
                }
            }
        }
    }
    {
        ImTextureData** zz_rf_it_30 = ImVector_ImTextureData_ptr_begin(&g.UserTextures);
        ImTextureData** zz_rf_end_30 = ImVector_ImTextureData_ptr_end(&g.UserTextures);
        for ; zz_rf_it_30 != zz_rf_end_30; zz_rf_it_30++ {
            ImTextureData* tex = *zz_rf_it_30;
            ImVector_ImTextureData_ptr_push_back(&g.PlatformIO.Textures, tex);
        }
    }
}
}

void ImGui_UpdateFontsNewFrame() {
    ImGuiContext* g = GImGui;
    if (g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures) == 0 {
        ImFontAtlas** zz_rf_it_31 = ImVector_ImFontAtlas_ptr_begin(&g.FontAtlases);
        ImFontAtlas** zz_rf_end_31 = ImVector_ImFontAtlas_ptr_end(&g.FontAtlases);
        for ; zz_rf_it_31 != zz_rf_end_31; zz_rf_it_31++ {
            ImFontAtlas* atlas = *zz_rf_it_31;
            atlas.Locked = true;
        }
    }
    if g.Style._NextFrameFontSizeBase != 0.0f {
        g.Style.FontSizeBase = g.Style._NextFrameFontSizeBase;
        g.Style._NextFrameFontSizeBase = 0.0f;
    }
    ImFont* font = ImGui_GetDefaultFont();
    if g.Style.FontSizeBase <= 0.0f {
        g.Style.FontSizeBase = font.LegacySize > 0.0f ? font.LegacySize : FONT_DEFAULT_SIZE_BASE;
    }
    g.Font = font;
    g.FontSizeBase = g.Style.FontSizeBase;
    g.FontSize = 0.0f;
    var font_stack_data = ImFontStackData{font, g.Style.FontSizeBase, g.Style.FontSizeBase};
    ImGui_SetCurrentFont(font_stack_data.Font, font_stack_data.FontSizeBeforeScaling, 0.0f);
    ImVector_ImFontStackData_push_back(&g.FontStack, font_stack_data);
    assert(cast(i64, ImFont_IsLoaded(g.Font)));
}

void ImGui_UpdateFontsEndFrame() {
    ImGui_PopFont();
}

ImFont* ImGui_GetDefaultFont() {
    ImGuiContext* g = GImGui;
    ImFontAtlas* atlas = g.IO.Fonts;
    if atlas.Builder == null || atlas.Fonts.Size == 0 {
        ImFontAtlasBuildMain(atlas);
    }
    return g.IO.FontDefault != null ? g.IO.FontDefault : atlas.Fonts.Data[0];
}

// EXPERIMENTAL. Use ImTextureDataQueueUpload() to queue updates. Textures logic will be automatically be updated in NewFrame().
void ImGui_RegisterUserTexture(ImTextureData* tex) {
    ImGuiContext* g = GImGui;
    tex.RefCount++;
    ImVector_ImTextureData_ptr_push_back(&g.UserTextures, tex);
}

void ImGui_UnregisterUserTexture(ImTextureData* tex) {
    ImGuiContext* g = GImGui;
    assert(tex.RefCount > 0);
    tex.RefCount--;
    ImVector_ImTextureData_ptr_find_erase(&g.UserTextures, tex);
}

void ImGui_RegisterFontAtlas(ImFontAtlas* atlas) {
    ImGuiContext* g = GImGui;
    if g.FontAtlases.Size == 0 {
        assert(atlas == g.IO.Fonts);
    }
    atlas.RefCount++;
    ImVector_ImFontAtlas_ptr_push_back(&g.FontAtlases, atlas);
    ImFontAtlasAddDrawListSharedData(atlas, &g.DrawListSharedData);
    {
        ImTextureData** zz_rf_it_32 = ImVector_ImTextureData_ptr_begin(&atlas.TexList);
        ImTextureData** zz_rf_end_32 = ImVector_ImTextureData_ptr_end(&atlas.TexList);
        for ; zz_rf_it_32 != zz_rf_end_32; zz_rf_it_32++ {
            ImTextureData* tex = *zz_rf_it_32;
            tex.RefCount = cast(u16, atlas.RefCount);
        }
    }
}

void ImGui_UnregisterFontAtlas(ImFontAtlas* atlas) {
    ImGuiContext* g = GImGui;
    assert(atlas.RefCount > 0);
    ImFontAtlasRemoveDrawListSharedData(atlas, &g.DrawListSharedData);
    ImVector_ImFontAtlas_ptr_find_erase(&g.FontAtlases, atlas);
    atlas.RefCount--;
    {
        ImTextureData** zz_rf_it_33 = ImVector_ImTextureData_ptr_begin(&atlas.TexList);
        ImTextureData** zz_rf_end_33 = ImVector_ImTextureData_ptr_end(&atlas.TexList);
        for ; zz_rf_it_33 != zz_rf_end_33; zz_rf_it_33++ {
            ImTextureData* tex = *zz_rf_it_33;
            tex.RefCount = cast(u16, atlas.RefCount);
        }
    }
}

// Use ImDrawList::_SetTexture(), making our shared g.FontStack[] authoritative against window-local ImDrawList.
// - Whereas ImDrawList::PushTexture()/PopTexture() is not to be used across Begin() calls.
// - Note that we don't propagate current texture id when e.g. Begin()-ing into a new window, we never really did...
//   - Some code paths never really fully worked with multiple atlas textures.
//   - The right-ish solution may be to remove _SetTexture() and make AddText/RenderText lazily call PushTexture()/PopTexture()
//     the same way AddImage() does, but then all other primitives would also need to? I don't think we should tackle this problem
//     because we have a concrete need and a test bed for multiple atlas textures.
// FIXME-NEWATLAS-V2: perhaps we can now leverage ImFontAtlasUpdateDrawListsTextures() ?
void ImGui_SetCurrentFont(ImFont* font, f32 font_size_before_scaling, f32 font_size_after_scaling) {
    ImGuiContext* g = GImGui;
    g.Font = font;
    g.FontSizeBase = font_size_before_scaling;
    ImGui_UpdateCurrentFontSize(font_size_after_scaling);
    if font != null {
        assert(font && ImFont_IsLoaded(font));
        ImFontAtlas* atlas = font.OwnerAtlas;
        g.DrawListSharedData.FontAtlas = atlas;
        g.DrawListSharedData.Font = font;
        ImFontAtlasUpdateDrawListsSharedData(atlas);
        if g.CurrentWindow != null {
            ImDrawList__SetTexture(g.CurrentWindow.DrawList, atlas.TexRef);
        }
    }
}

void ImGui_UpdateCurrentFontSize(f32 restore_font_size_after_scaling) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    g.Style.FontSizeBase = g.FontSizeBase;
    f32 final_size = restore_font_size_after_scaling > 0.0f ? restore_font_size_after_scaling : 0.0f;
    if final_size == 0.0f {
        final_size = g.FontSizeBase;
        final_size *= g.Style.FontScaleMain;
        final_size *= g.Style.FontScaleDpi;
        if window != null {
            final_size *= window.FontWindowScale;
        }
    }
    final_size = ImGui_GetRoundedFontSize(final_size);
    final_size = ImClamp(final_size, 1.0f, 512.0f);
    if g.Font != null && g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures {
        g.Font.CurrentRasterizerDensity = g.FontRasterizerDensity;
    }
    g.FontSize = final_size;
    g.DrawListSharedData.FontSize = g.FontSize;
    if window != null && window.SkipItems {
        ImGuiTable* table = g.CurrentTable;
        bool allow_early_out = table == null || table.CurrentColumn != -1 && table.Columns.Data[table.CurrentColumn].IsSkipItems == false;
        if allow_early_out != 0 {
            return;
        }
    }
    g.FontBaked = g.Font != null && window != null ? ImFont_GetFontBaked(g.Font, final_size, -1.0f) : null;
    g.FontBakedScale = g.FontBaked != null ? g.FontSize / g.FontBaked.Size : 0.0f;
    g.DrawListSharedData.FontScale = g.FontBakedScale;
}

// Exposed in case user may want to override setting density.
// IMPORTANT: Begin()/End() is overriding density. Be considerate of this you change it.
void ImGui_SetFontRasterizerDensity(f32 rasterizer_density) {
    ImGuiContext* g = GImGui;
    assert(g.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures);
    if g.FontRasterizerDensity == rasterizer_density {
        return;
    }
    g.FontRasterizerDensity = rasterizer_density;
    ImGui_UpdateCurrentFontSize(0.0f);
}

// If you want to scale an existing font size! Read comments in imgui.h!
void ImGui_PushFont(ImFont* font, f32 font_size_base) {
    ImGuiContext* g = GImGui;
    if font == null {
        font = g.Font;
    }
    assert(font != null);
    assert(font_size_base >= 0.0f);
    ImVector_ImFontStackData_push_back(&g.FontStack, ImFontStackData{g.Font, g.FontSizeBase, g.FontSize});
    if font_size_base == 0.0f {
        font_size_base = g.FontSizeBase;
    }
    ImGui_SetCurrentFont(font, font_size_base, 0.0f);
}

void ImGui_PopFont() {
    ImGuiContext* g = GImGui;
    while true {
        if g.FontStack.Size > 0 == 0 {
            if ImGui_ErrorLog("Calling PopFont() too many times!") != 0 {
                assert(g.FontStack.Size > 0 && "Calling PopFont() too many times!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    ImFontStackData* font_stack_data = ImVector_ImFontStackData_back(&g.FontStack);
    ImGui_SetCurrentFont(font_stack_data.Font, font_stack_data.FontSizeBeforeScaling, font_stack_data.FontSizeAfterScaling);
    ImVector_ImFontStackData_pop_back(&g.FontStack);
}

//-----------------------------------------------------------------------------
// [SECTION] ID STACK
//-----------------------------------------------------------------------------
// This is one of the very rare legacy case where we use ImGuiWindow methods,
// it should ideally be flattened at some point but it's been used a lots by widgets.
ImGuiID ImGuiWindow_GetID(ImGuiWindow* self, u8* str_var, u8* str_end) {
    ImGuiID seed = *ImVector_ImGuiID_back(&self.IDStack);
    ImGuiID id = ImHashStr(str_var, cast(u64, str_end != null ? cast(i64, str_end - str_var) : 0), seed);
    ImGuiContext* g = self.Ctx;
    if g.DebugHookIdInfoId == id {
        ImGui_DebugHookIdInfo(id, ImGuiDataType_String, str_var, str_end);
    }
    return id;
}

ImGuiID ImGuiWindow_GetID(ImGuiWindow* self, void* ptr) {
    ImGuiID seed = *ImVector_ImGuiID_back(&self.IDStack);
    ImGuiID id = ImHashData(&ptr, cast(u64, sizeof(void*)), seed);
    ImGuiContext* g = self.Ctx;
    if g.DebugHookIdInfoId == id {
        ImGui_DebugHookIdInfo(id, ImGuiDataType_Pointer, ptr, null);
    }
    return id;
}

ImGuiID ImGuiWindow_GetID(ImGuiWindow* self, i32 n) {
    ImGuiID seed = *ImVector_ImGuiID_back(&self.IDStack);
    ImGuiID id = ImHashData(&n, cast(u64, sizeof(n)), seed);
    ImGuiContext* g = self.Ctx;
    if g.DebugHookIdInfoId == id {
        ImGui_DebugHookIdInfo(id, ImGuiDataType_S32, cast(void*, cast(i64, n)), null);
    }
    return id;
}

// This is only used in rare/specific situations to manufacture an ID out of nowhere.
// FIXME: Consider instead storing last non-zero ID + count of successive zero-ID, and combine those?
ImGuiID ImGuiWindow_GetIDFromPos(ImGuiWindow* self, ImVec2 p_abs) {
    ImGuiID seed = *ImVector_ImGuiID_back(&self.IDStack);
    ImVec2 p_rel = ImGui_WindowPosAbsToRel(self, p_abs);
    ImGuiID id = ImHashData(&p_rel, cast(u64, sizeof(p_rel)), seed);
    return id;
}

// "
ImGuiID ImGuiWindow_GetIDFromRectangle(ImGuiWindow* self, ImRect r_abs) {
    ImGuiID seed = *ImVector_ImGuiID_back(&self.IDStack);
    ImRect r_rel = ImGui_WindowRectAbsToRel(self, r_abs);
    ImGuiID id = ImHashData(&r_rel, cast(u64, sizeof(r_rel)), seed);
    return id;
}

void ImGui_PushID(u8* str_id) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiID id = ImGuiWindow_GetID(window, str_id, null);
    ImVector_ImGuiID_push_back(&window.IDStack, id);
}

void ImGui_PushID(u8* str_id_begin, u8* str_id_end) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiID id = ImGuiWindow_GetID(window, str_id_begin, str_id_end);
    ImVector_ImGuiID_push_back(&window.IDStack, id);
}

void ImGui_PushID(void* ptr_id) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiID id = ImGuiWindow_GetID(window, ptr_id);
    ImVector_ImGuiID_push_back(&window.IDStack, id);
}

void ImGui_PushID(i32 int_id) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    ImGuiID id = ImGuiWindow_GetID(window, int_id);
    ImVector_ImGuiID_push_back(&window.IDStack, id);
}

// Push a given id value ignoring the ID stack as a seed.
void ImGui_PushOverrideID(ImGuiID id) {
    ImGuiContext* g = GImGui;
    ImGuiWindow* window = g.CurrentWindow;
    if g.DebugHookIdInfoId == id {
        ImGui_DebugHookIdInfo(id, ImGuiDataType_ID, null, null);
    }
    ImVector_ImGuiID_push_back(&window.IDStack, id);
}

// Helper to avoid a common series of PushOverrideID -> GetID() -> PopID() call
// (note that when using this pattern, ID Stack Tool will tend to not display the intermediate stack level.
//  for that to work we would need to do PushOverrideID() -> ItemAdd() -> PopID() which would alter widget code a little more)
ImGuiID ImGui_GetIDWithSeed(u8* str_var, u8* str_end, ImGuiID seed) {
    ImGuiID id = ImHashStr(str_var, cast(u64, str_end != null ? cast(i64, str_end - str_var) : 0), seed);
    ImGuiContext* g = GImGui;
    if g.DebugHookIdInfoId == id {
        ImGui_DebugHookIdInfo(id, ImGuiDataType_String, str_var, str_end);
    }
    return id;
}

ImGuiID ImGui_GetIDWithSeed(i32 n, ImGuiID seed) {
    ImGuiID id = ImHashData(&n, cast(u64, sizeof(n)), seed);
    ImGuiContext* g = GImGui;
    if g.DebugHookIdInfoId == id {
        ImGui_DebugHookIdInfo(id, ImGuiDataType_S32, cast(void*, cast(i64, n)), null);
    }
    return id;
}

void ImGui_PopID() {
    ImGuiWindow* window = GImGui.CurrentWindow;
    while true {
        if window.IDStack.Size > 1 == 0 {
            if ImGui_ErrorLog("Calling PopID() too many times!") != 0 {
                assert(window.IDStack.Size > 1 && "Calling PopID() too many times!");
            }
            return;
        }
        if !(0 != 0) { break; }
    }
    ImVector_ImGuiID_pop_back(&window.IDStack);
}

ImGuiID ImGui_GetID(u8* str_id) {
    ImGuiWindow* window = GImGui.CurrentWindow;
    return ImGuiWindow_GetID(window, str_id, null);
}

ImGuiID ImGui_GetID(u8* str_id_begin, u8* str_id_end) {
    ImGuiWindow* window = GImGui.CurrentWindow;
    return ImGuiWindow_GetID(window, str_id_begin, str_id_end);
}

ImGuiID ImGui_GetID(void* ptr_id) {
    ImGuiWindow* window = GImGui.CurrentWindow;
    return ImGuiWindow_GetID(window, ptr_id);
}

ImGuiID ImGui_GetID(i32 int_id) {
    ImGuiWindow* window = GImGui.CurrentWindow;
    return ImGuiWindow_GetID(window, int_id);
}

