// Clang/GCC warnings with -Weverything
// Debug options
// Default font size if unspecified in both style.FontSizeBase and AddFontXXX() calls.
private {
f32 FONT_DEFAULT_SIZE_BASE = 20.0f;
// When using Ctrl+Tab (or Gamepad Square+L/R) we delay the visual a little in order to reduce visual noise doing a fast switch.
f32 NAV_WINDOWING_HIGHLIGHT_DELAY = 0.2f;
// Time before the highlight and screen dimming starts fading in
f32 NAV_WINDOWING_LIST_APPEAR_DELAY = 0.15f;
// Time before the window list starts to appear
f32 NAV_ACTIVATE_HIGHLIGHT_TIMER = 0.1f;
// Time to highlight an item activated by a shortcut.
f32 NAV_ACTIVATE_INPUT_WITH_GAMEPAD_DELAY = 0.6f;
// Time to hold activation button (e.g. FaceDown) to turn the activation into a text input.
f32 WINDOWS_RESIZE_FROM_EDGES_FEEDBACK_TIMER = 0.04f;
// Reduce visual noise by only highlighting the border after a certain time.
f32 WINDOWS_MOUSE_WHEEL_SCROLL_LOCK_TIMER = 0.7f;
// Lock scrolled window (so it doesn't pick child windows that are scrolling through) for a certain time, unless mouse moved.
// Tooltip offset
ImVec2 TOOLTIP_DEFAULT_OFFSET_MOUSE = ImVec2{16.0f, 10.0f};
// Multiplied by g.Style.MouseCursorScale
ImVec2 TOOLTIP_DEFAULT_OFFSET_TOUCH = ImVec2{0.0f, -20.0f};
// Multiplied by g.Style.MouseCursorScale
ImVec2 TOOLTIP_DEFAULT_PIVOT_TOUCH = ImVec2{0.5f, 1.0f};
// Multiplied by g.Style.MouseCursorScale
// Docking
f32 DOCKING_TRANSPARENT_PAYLOAD_ALPHA = 0.5f;
}
// Viewports
ImGuiID ImGui_IMGUI_VIEWPORT_DEFAULT_ID = 0x11111111;
ImGuiContext* GImGui = null;

// Memory Allocator functions. Use SetAllocatorFunctions() to change them.
// - You probably don't want to modify that mid-program, and if you use global/static e.g. ImVector<> instances you may need to keep them accessible during program destruction.
// - DLL users: read comments above.
private {
void* MallocWrapper(u64 size, void* user_data) {
    ignore user_data;
    return alloc(cast(i64, size));
}

void FreeWrapper(void* ptr, void* user_data) {
    ignore user_data;
    free(ptr);
}
ImGuiMemAllocFunc GImAllocatorAllocFunc = MallocWrapper;
ImGuiMemFreeFunc GImAllocatorFreeFunc = FreeWrapper;
void* GImAllocatorUserData = null;
}

