    return self.Value;
}

void ImColor_SetHSV(ImColor* self, f32 h, f32 s, f32 v, f32 a) {
    ImGui_ColorConvertHSVtoRGB(h, s, v, &self.Value.x, &self.Value.y, &self.Value.z);
    self.Value.w = a;
}

ImColor ImColor_HSV(f32 h, f32 s, f32 v, f32 a) {
    f32 r;
    f32 g;
    f32 b;
    ImGui_ColorConvertHSVtoRGB(h, s, v, &r, &g, &b);
    return __cxx_make_ImColor(r, g, b, a);
}

