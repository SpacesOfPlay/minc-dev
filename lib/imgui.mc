        return &table.InstanceDataFirst;
    }
    return &table.InstanceDataExtra.Data[instance_no - 1];
}

ImGuiID ImGui_TableGetInstanceID(ImGuiTable* table, i32 instance_no) {
    return ImGui_TableGetInstanceData(table, instance_no).TableInstanceID;
}

