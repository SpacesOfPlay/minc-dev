void ImFontAtlas_init(ImFontAtlas* self) {
    memset(self, 0, cast(u64, sizeof(*self)));
    ImTextureRef_init(&self.TexRef);
    ImVector_ImTextureData_ptr_init(&self.TexList);
    ImVec2_init(&self.TexUvScale);
    ImVec2_init(&self.TexUvWhitePixel);
    ImVector_ImFont_ptr_init(&self.Fonts);
    ImVector_ImFontConfig_init(&self.Sources);
    ImVector_ImDrawListSharedData_ptr_init(&self.DrawListSharedDatas);
    memset(cast(void*, self), 0, cast(u64, sizeof(*self)));
    self.TexDesiredFormat = ImTextureFormat_RGBA32;
    self.TexGlyphPadding = 1;
    self.TexMinWidth = 512;
    self.TexMinHeight = 128;
    self.TexMaxWidth = 8192;
    self.TexMaxHeight = 8192;
    self.TexRef._TexID = cast(ImTextureID, 0);
    self.RendererHasTextures = false;
    self.TexNextUniqueID = 1;
    self.FontNextUniqueID = 1;
    self.Builder = null;
}

void ImFontAtlas_dtor(ImFontAtlas* self) {
    assert(!self.Locked && "Cannot modify a locked ImFontAtlas!");
    self.RendererHasTextures = false;
    ImFontAtlas_ClearFonts(self);
    ImFontAtlas_ClearTexData(self);
    ImVector_ImTextureData_ptr_clear_delete(&self.TexList);
    self.TexData = null;
}

// You probably should not call this directly. It is not well specified.
// If you want to replace all your fonts mid-frame, most likely you should instead call ClearFonts() then load the new fonts.
// Calling this mid-frame will discard the CPU-side copy of the texture data which is generally unreliable as you may have textures queued for creation or updates.
void ImFontAtlas_Clear(ImFontAtlas* self) {
    while true {
        ImGuiContext* g2 = GImGui;
        if g2 && g2.DebugLogFlags & ImGuiDebugLogFlags_EventFont {
        }
        if !(0 != 0) { break; }
    }
    bool backup_renderer_has_textures = self.RendererHasTextures;
    self.RendererHasTextures = false;
    ImFontAtlas_ClearFonts(self);
    ImFontAtlas_ClearTexData(self);
    self.RendererHasTextures = backup_renderer_has_textures;
}

void ImFontAtlas_ClearFonts(ImFontAtlas* self) {
    while true {
        ImGuiContext* g2 = GImGui;
        if g2 && g2.DebugLogFlags & ImGuiDebugLogFlags_EventFont {
        }
        if !(0 != 0) { break; }
    }
    assert(!self.Locked && "Cannot modify a locked ImFontAtlas!");
    {
        ImFont** zz_rf_it_6 = ImVector_ImFont_ptr_begin(&self.Fonts);
        ImFont** zz_rf_end_6 = ImVector_ImFont_ptr_end(&self.Fonts);
        for ; zz_rf_it_6 != zz_rf_end_6; zz_rf_it_6++ {
            ImFont* font = *zz_rf_it_6;
            ImFontAtlasBuildNotifySetFont(self, font, null);
        }
    }
    ImFontAtlasBuildDestroy(self);
    ImFontAtlas_ClearInputData(self);
    ImVector_ImFont_ptr_clear_delete(&self.Fonts);
    self.TexIsBuilt = false;
    {
        ImDrawListSharedData** zz_rf_it_7 = ImVector_ImDrawListSharedData_ptr_begin(&self.DrawListSharedDatas);
        ImDrawListSharedData** zz_rf_end_7 = ImVector_ImDrawListSharedData_ptr_end(&self.DrawListSharedDatas);
        for ; zz_rf_it_7 != zz_rf_end_7; zz_rf_it_7++ {
            ImDrawListSharedData* shared_data = *zz_rf_it_7;
            if shared_data.FontAtlas == self {
                shared_data.Font = null;
                shared_data.FontSize = 0.0f;
                shared_data.FontScale = shared_data.FontSize;
            }
        }
    }
}

void ImFontAtlas_ClearInputData(ImFontAtlas* self) {
    assert(!self.Locked && "Cannot modify a locked ImFontAtlas!");
    {
        ImFont** zz_rf_it_8 = ImVector_ImFont_ptr_begin(&self.Fonts);
        ImFont** zz_rf_end_8 = ImVector_ImFont_ptr_end(&self.Fonts);
        for ; zz_rf_it_8 != zz_rf_end_8; zz_rf_it_8++ {
            ImFont* font = *zz_rf_it_8;
            ImFontAtlasFontDestroyOutput(self, font);
        }
    }
    {
        ImFontConfig* zz_rf_it_9 = ImVector_ImFontConfig_begin(&self.Sources);
        ImFontConfig* zz_rf_end_9 = ImVector_ImFontConfig_end(&self.Sources);
        for ; zz_rf_it_9 != zz_rf_end_9; zz_rf_it_9++ {
            ImFontConfig* font_cfg = zz_rf_it_9;
            ImFontAtlasFontDestroySourceData(self, font_cfg);
        }
    }
    {
        ImFont** zz_rf_it_10 = ImVector_ImFont_ptr_begin(&self.Fonts);
        ImFont** zz_rf_end_10 = ImVector_ImFont_ptr_end(&self.Fonts);
        for ; zz_rf_it_10 != zz_rf_end_10; zz_rf_it_10++ {
            ImFont* font = *zz_rf_it_10;
            ImVector_ImFontConfig_ptr_clear(&font.Sources);
            font.Flags |= ImFontFlags_NoLoadGlyphs;
        }
    }
    ImVector_ImFontConfig_clear(&self.Sources);
}

// Clear CPU-side copy of the texture data.
void ImFontAtlas_ClearTexData(ImFontAtlas* self) {
    assert(!self.Locked && "Cannot modify a locked ImFontAtlas!");
    assert(self.RendererHasTextures == false && "Not supported for dynamic atlases, but you may call Clear().");
    {
        ImTextureData** zz_rf_it_11 = ImVector_ImTextureData_ptr_begin(&self.TexList);
        ImTextureData** zz_rf_end_11 = ImVector_ImTextureData_ptr_end(&self.TexList);
        for ; zz_rf_it_11 != zz_rf_end_11; zz_rf_it_11++ {
            ImTextureData* tex = *zz_rf_it_11;
            ImTextureData_DestroyPixels(tex);
        }
    }
}

void ImFontAtlas_CompactCache(ImFontAtlas* self) {
    ImFontAtlasTextureCompact(self);
}

void ImFontAtlas_SetFontLoader(ImFontAtlas* self, ImFontLoader* font_loader) {
    ImFontAtlasBuildSetupFontLoader(self, font_loader);
}

private {
void ImFontAtlasBuildUpdateRendererHasTexturesFromContext(ImFontAtlas* atlas) {
    {
        ImDrawListSharedData** zz_rf_it_12 = ImVector_ImDrawListSharedData_ptr_begin(&atlas.DrawListSharedDatas);
        ImDrawListSharedData** zz_rf_end_12 = ImVector_ImDrawListSharedData_ptr_end(&atlas.DrawListSharedDatas);
        for ; zz_rf_it_12 != zz_rf_end_12; zz_rf_it_12++ {
            ImDrawListSharedData* shared_data = *zz_rf_it_12;
            {
                ImGuiContext* imgui_ctx = shared_data.Context;
                if imgui_ctx != null {
                    atlas.RendererHasTextures = (imgui_ctx.IO.BackendFlags & ImGuiBackendFlags_RendererHasTextures) != 0;
                    break;
                }
            }
        }
    }
}
}

// Called by NewFrame() for atlases owned by a context.
// If you manually manage font atlases, you'll need to call this yourself.
// - 'frame_count' needs to be provided because we can gc/prioritize baked fonts based on their age.
// - 'frame_count' may not match those of all imgui contexts using this atlas, as contexts may be updated as different frequencies. But generally you can use ImGui::GetFrameCount() on one of your context.
void ImFontAtlasUpdateNewFrame(ImFontAtlas* atlas, i32 frame_count, bool renderer_has_textures) {
    assert(atlas.Builder == null || atlas.Builder.FrameCount < frame_count);
    atlas.RendererHasTextures = renderer_has_textures;
    for i32 tex_n = 0; tex_n < atlas.TexList.Size; tex_n++ {
        ImTextureData* tex = atlas.TexList.Data[tex_n];
        if tex.Status == ImTextureStatus_WantCreate && atlas.RendererHasTextures {
            assert(tex.TexID == cast(ImTextureID, 0) && tex.BackendUserData == null && "Backend set texture's TexID/BackendUserData but did not update Status to OK.");
        }
        bool remove_from_list = ImTextureDataUpdateNewFrame(tex);
        if remove_from_list != 0 {
            assert(atlas.TexData != tex);
            ImTextureData_DestroyPixels(tex);
            0;
            ImVector_ImTextureData_ptr_erase(&atlas.TexList, ImVector_ImTextureData_ptr_begin(&atlas.TexList) + tex_n);
            tex_n--;
        }
    }
    if atlas.RendererHasTextures != 0 {
        atlas.TexIsBuilt = true;
        if atlas.Builder == null {
            ImFontAtlasBuildMain(atlas);
        }
    }
    if atlas.RendererHasTextures == 0 {
        while true {
            if atlas.TexIsBuilt == 0 {
                if ImGui_ErrorLog("Backend does not support ImGuiBackendFlags_RendererHasTextures, and font atlas is not built! Update backend OR make sure you called ImGui_ImplXXXX_NewFrame() function for renderer backend, which should call io.Fonts->GetTexDataAsRGBA32() / GetTexDataAsAlpha8().") != 0 {
                    assert(atlas.TexIsBuilt && "Backend does not support ImGuiBackendFlags_RendererHasTextures, and font atlas is not built! Update backend OR make sure you called ImGui_ImplXXXX_NewFrame() function for renderer backend, which should call io.Fonts->GetTexDataAsRGBA32() / GetTexDataAsAlpha8().");
                }
            }
            if !(0 != 0) { break; }
        }
    }
    if atlas.TexIsBuilt && atlas.Builder.PreloadedAllGlyphsRanges {
        while true {
            if atlas.RendererHasTextures == false == 0 {
                if ImGui_ErrorLog("Called ImFontAtlas::Build() before ImGuiBackendFlags_RendererHasTextures got set! With new backends: you don't need to call Build().") != 0 {
                    assert(atlas.RendererHasTextures == false && "Called ImFontAtlas::Build() before ImGuiBackendFlags_RendererHasTextures got set! With new backends: you don't need to call Build().");
                }
            }
            if !(0 != 0) { break; }
        }
    }
    ImFontAtlasBuilder* builder = atlas.Builder;
    builder.FrameCount = frame_count;
    {
        ImFont** zz_rf_it_13 = ImVector_ImFont_ptr_begin(&atlas.Fonts);
        ImFont** zz_rf_end_13 = ImVector_ImFont_ptr_end(&atlas.Fonts);
        for ; zz_rf_it_13 != zz_rf_end_13; zz_rf_it_13++ {
            ImFont* font = *zz_rf_it_13;
            font.LastBaked = null;
        }
    }
    if builder.BakedDiscardedCount > 0 {
        i32 dst_n = 0;
        i32 src_n = 0;
        for ; src_n < builder.BakedPool.Size; src_n++ {
            ImFontBaked* p_src = ImStableVector_ImFontBaked_32_index(&builder.BakedPool, src_n);
            if p_src.WantDestroy != 0 {
                continue;
            }
            ImFontBaked* p_dst = ImStableVector_ImFontBaked_32_index(&builder.BakedPool, dst_n++);
            if p_dst == p_src {
                continue;
            }
            memcpy(p_dst, p_src, cast(u64, sizeof(ImFontBaked)));
            ImGuiStorage_SetVoidPtr(&builder.BakedMap, p_dst.BakedId, p_dst);
        }
        assert(dst_n + builder.BakedDiscardedCount == src_n);
        builder.BakedPool.Size -= builder.BakedDiscardedCount;
        builder.BakedDiscardedCount = 0;
    }
}

bool ImTextureDataUpdateNewFrame(ImTextureData* tex) {
    bool remove_from_list = false;
    if tex.Status == ImTextureStatus_OK {
        ImVector_ImTextureRect_resize(&tex.Updates, 0);
        tex.UpdateRect.y = cast(u16, ~0);
        tex.UpdateRect.x = tex.UpdateRect.y;
        tex.UpdateRect.h = 0;
        tex.UpdateRect.w = tex.UpdateRect.h;
    }
    if tex.WantDestroyNextFrame && tex.Status != ImTextureStatus_Destroyed && tex.Status != ImTextureStatus_WantDestroy {
        assert(tex.Status == ImTextureStatus_OK || tex.Status == ImTextureStatus_WantCreate || tex.Status == ImTextureStatus_WantUpdates);
        tex.Status = ImTextureStatus_WantDestroy;
    }
    if tex.Status == ImTextureStatus_WantDestroy && tex.TexID == cast(ImTextureID, 0) && tex.BackendUserData == null && tex.QueueUserData == null {
        tex.Status = ImTextureStatus_Destroyed;
    }
    if tex.Status == ImTextureStatus_Destroyed {
        assert(tex.TexID == cast(ImTextureID, 0) && tex.BackendUserData == null && "Backend set texture Status to Destroyed but did not clear TexID/BackendUserData!");
        assert(tex.QueueUserData == null && "Texture queue set Status to Destroyed but did not clear QueueUserData!");
        if tex.WantDestroyNextFrame != 0 {
            remove_from_list = true;
        } else {
            tex.Status = ImTextureStatus_WantCreate;
        }
    }
    if tex.Status == ImTextureStatus_WantDestroy {
        tex.UnusedFrames++;
    }
    return remove_from_list;
}

void ImFontAtlasTextureBlockConvert(u8* src_pixels, ImTextureFormat src_fmt, i32 src_pitch, u8* dst_pixels, ImTextureFormat dst_fmt, i32 dst_pitch, i32 w, i32 h) {
    assert(src_pixels != null && dst_pixels != null);
    if src_fmt == dst_fmt {
        i32 line_sz = w * ImTextureDataGetFormatBytesPerPixel(src_fmt);
        for i32 ny = h; ny > 0; ny-- {
            memcpy(dst_pixels, src_pixels, cast(u64, line_sz));
            src_pixels += src_pitch;
            dst_pixels += dst_pitch;
        }
    } else if src_fmt == ImTextureFormat_Alpha8 && dst_fmt == ImTextureFormat_RGBA32 {
        for i32 ny = h; ny > 0; ny-- {
            var src_p = cast(ImU8*, src_pixels);
            var dst_p = cast(ImU32*, cast(void*, dst_pixels));
            for i32 nx = w; nx > 0; nx-- {
                *dst_p++ = cast(ImU32, cast(u32, *src_p++)) << 24 | cast(ImU32, 255) << 16 | cast(ImU32, 255) << 8 | cast(ImU32, 255) << 0;
            }
            src_pixels += src_pitch;
            dst_pixels += dst_pitch;
        }
    } else if src_fmt == ImTextureFormat_RGBA32 && dst_fmt == ImTextureFormat_Alpha8 {
        for i32 ny = h; ny > 0; ny-- {
            var src_p = cast(ImU32*, cast(void*, src_pixels));
            var dst_p = cast(ImU8*, dst_pixels);
            for i32 nx = w; nx > 0; nx-- {
                *dst_p++ = cast(ImU8, *src_p++ >> 24 & 0xFF);
            }
            src_pixels += src_pitch;
            dst_pixels += dst_pitch;
        }
    } else {
        assert(0);
    }
}

// Source buffer may be written to (used for in-place mods).
// Post-process hooks may eventually be added here.
void ImFontAtlasTextureBlockPostProcess(ImFontAtlasPostProcessData* data) {
    if data.FontSrc.RasterizerMultiply != 1.0f {
        ImFontAtlasTextureBlockPostProcessMultiply(data, data.FontSrc.RasterizerMultiply);
    }
}

void ImFontAtlasTextureBlockPostProcessMultiply(ImFontAtlasPostProcessData* data, f32 multiply_factor) {
    var pixels = cast(u8*, data.Pixels);
    i32 pitch = data.Pitch;
    if data.Format == ImTextureFormat_Alpha8 {
        for i32 ny = data.Height; ny > 0; ny-- {
            var p = cast(ImU8*, pixels);
            for i32 nx = data.Width; nx > 0; nx-- {
                var v = cast(u32, ImMin(cast(i32, cast(u32, cast(f32, *p) * multiply_factor)), cast(i32, cast(u32, 255))));
                *p = cast(u8, v);
                p++;
            }
            pixels += pitch;
        }
    } else if data.Format == ImTextureFormat_RGBA32 {
        for i32 ny = data.Height; ny > 0; ny-- {
            var p = cast(ImU32*, cast(void*, pixels));
            for i32 nx = data.Width; nx > 0; nx-- {
                var a = cast(u32, ImMin(cast(i32, cast(u32, cast(f32, *p >> 24 & 0xFF) * multiply_factor)), cast(i32, cast(u32, 255))));
                *p = cast(ImU32, a) << 24 | cast(ImU32, *p >> 16 & 0xFF) << 16 | cast(ImU32, *p >> 8 & 0xFF) << 8 | cast(ImU32, *p >> 0 & 0xFF) << 0;
                p++;
            }
            pixels += pitch;
        }
    } else {
        assert(0);
    }
}

// Fill with single color. We don't use this directly but it is convenient for anyone working on uploading custom rects.
void ImFontAtlasTextureBlockFill(ImTextureData* dst_tex, i32 dst_x, i32 dst_y, i32 w, i32 h, ImU32 col) {
    if dst_tex.Format == ImTextureFormat_Alpha8 {
        var col_a = cast(ImU8, col >> 24 & 0xFF);
        for i32 y = 0; y < h; y++ {
            memset(cast(ImU8*, ImTextureData_GetPixelsAt(dst_tex, dst_x, dst_y + y)), col_a, cast(u64, w));
        }
    } else {
        for i32 y = 0; y < h; y++ {
            var p = cast(ImU32*, ImTextureData_GetPixelsAt(dst_tex, dst_x, dst_y + y));
            for i32 x = w; x > 0; x-- {
                *p = col;
                p++;
            }
        }
    }
}

// Copy block from one texture to another
void ImFontAtlasTextureBlockCopy(ImTextureData* src_tex, i32 src_x, i32 src_y, ImTextureData* dst_tex, i32 dst_x, i32 dst_y, i32 w, i32 h) {
    assert(src_tex.Pixels != null && dst_tex.Pixels != null);
    assert(src_tex.Format == dst_tex.Format);
    assert(src_x >= 0 && src_x + w <= src_tex.Width);
    assert(src_y >= 0 && src_y + h <= src_tex.Height);
    assert(dst_x >= 0 && dst_x + w <= dst_tex.Width);
    assert(dst_y >= 0 && dst_y + h <= dst_tex.Height);
    for i32 y = 0; y < h; y++ {
        memcpy(ImTextureData_GetPixelsAt(dst_tex, dst_x, dst_y + y), ImTextureData_GetPixelsAt(src_tex, src_x, src_y + y), cast(u64, w * dst_tex.BytesPerPixel));
    }
}

void ImFontAtlasTextureBlockQueueUpload(ImFontAtlas* atlas, ImTextureData* tex, i32 x, i32 y, i32 w, i32 h) {
    ImTextureDataQueueUpload(tex, x, y, w, h);
    atlas.TexIsBuilt = false;
}

// Queue texture block update for renderer backend
void ImTextureDataQueueUpload(ImTextureData* tex, i32 x, i32 y, i32 w, i32 h) {
    assert(tex.Status != ImTextureStatus_WantDestroy && tex.Status != ImTextureStatus_Destroyed);
    assert(x >= 0 && x <= 0xFFFF && y >= 0 && y <= 0xFFFF && w >= 0 && x + w <= 0x10000 && h >= 0 && y + h <= 0x10000);
    var req = ImTextureRect{cast(u16, x), cast(u16, y), cast(u16, w), cast(u16, h)};
    i32 new_x1 = ImMax(tex.UpdateRect.w == 0 ? 0 : tex.UpdateRect.x + tex.UpdateRect.w, cast(i32, req.x + req.w));
    i32 new_y1 = ImMax(tex.UpdateRect.h == 0 ? 0 : tex.UpdateRect.y + tex.UpdateRect.h, cast(i32, req.y + req.h));
    tex.UpdateRect.x = cast(u16, ImMin(cast(i32, tex.UpdateRect.x), cast(i32, req.x)));
    tex.UpdateRect.y = cast(u16, ImMin(cast(i32, tex.UpdateRect.y), cast(i32, req.y)));
    tex.UpdateRect.w = cast(u16, new_x1 - tex.UpdateRect.x);
    tex.UpdateRect.h = cast(u16, new_y1 - tex.UpdateRect.y);
    tex.UsedRect.x = cast(u16, ImMin(cast(i32, tex.UsedRect.x), cast(i32, req.x)));
    tex.UsedRect.y = cast(u16, ImMin(cast(i32, tex.UsedRect.y), cast(i32, req.y)));
    tex.UsedRect.w = cast(u16, ImMax(cast(i32, tex.UsedRect.x + tex.UsedRect.w), cast(i32, req.x + req.w)) - tex.UsedRect.x);
    tex.UsedRect.h = cast(u16, ImMax(cast(i32, tex.UsedRect.y + tex.UsedRect.h), cast(i32, req.y + req.h)) - tex.UsedRect.y);
    if tex.Status == ImTextureStatus_OK || tex.Status == ImTextureStatus_WantUpdates {
        tex.Status = ImTextureStatus_WantUpdates;
        ImVector_ImTextureRect_push_back(&tex.Updates, req);
    }
}

ImFont* ImFontAtlas_AddFont(ImFontAtlas* self, ImFontConfig* font_cfg_in) {
    assert(!self.Locked && "Cannot modify a locked ImFontAtlas!");
    assert(font_cfg_in.FontData != null && font_cfg_in.FontDataSize > 0 || font_cfg_in.FontLoader != null);
    assert(font_cfg_in.RasterizerDensity > 0.0f && "Is ImFontConfig struct correctly initialized?");
    if font_cfg_in.GlyphOffset.x != 0.0f || font_cfg_in.GlyphOffset.y != 0.0f || font_cfg_in.GlyphMinAdvanceX != 0.0f || font_cfg_in.GlyphMaxAdvanceX != FLT_MAX {
        assert(font_cfg_in.SizePixels != 0.0f && "Specifying glyph offset/advances requires a reference size to base it on.");
    }
    if self.Builder == null {
        ImFontAtlasBuildInit(self);
    }
    bool is_first_font = self.Fonts.Size == 0;
    ImFont* font;
    if font_cfg_in.MergeMode == 0 {
        font = cast(ImFont*, ImGui_MemAlloc(cast(u64, sizeof(ImFont))));
        ImFont_init(font);
        font.FontId = cast(ImGuiID, self.FontNextUniqueID++);
        font.Flags = font_cfg_in.Flags;
        font.LegacySize = font_cfg_in.SizePixels;
        font.CurrentRasterizerDensity = font_cfg_in.RasterizerDensity;
        ImVector_ImFont_ptr_push_back(&self.Fonts, font);
    } else {
        assert(self.Fonts.Size > 0 && "Cannot use MergeMode for the first font!");
        font = font_cfg_in.DstFont != null ? font_cfg_in.DstFont : *ImVector_ImFont_ptr_back(&self.Fonts);
        ImFontAtlasFontDiscardBakes(self, font, 0);
    }
    ImVector_ImFontConfig_push_back(&self.Sources, *font_cfg_in);
    ImFontConfig* font_cfg = ImVector_ImFontConfig_back(&self.Sources);
    if font_cfg.DstFont == null {
        font_cfg.DstFont = font;
    }
    ImVector_ImFontConfig_ptr_push_back(&font.Sources, font_cfg);
    ImFontAtlasBuildUpdatePointers(self);
    if font_cfg.GlyphExcludeRanges != null {
        i32 size = 0;
        for ImWchar* p = font_cfg.GlyphExcludeRanges; p[0] != 0; p++ {
            size++;
        }
        assert((size & 1) == 0 && "GlyphExcludeRanges[] size must be multiple of two!");
        assert(size <= 64 && "GlyphExcludeRanges[] size must be small!");
        font_cfg.GlyphExcludeRanges = cast(ImWchar*, ImMemdup(font_cfg.GlyphExcludeRanges, cast(u64, sizeof(font_cfg.GlyphExcludeRanges[0]) * (size + 1))));
    }
    if font_cfg.FontLoader != null {
        assert(font_cfg.FontLoader.FontBakedLoadGlyph != null);
        assert(font_cfg.FontLoader.LoaderInit == null && font_cfg.FontLoader.LoaderShutdown == null);
    }
    if font_cfg_in.MergeMode && font_cfg_in.SizePixels > 0.0f {
        assert((font.Flags & ImFontFlags_ImplicitRefSize) == 0 && "Cannot use MergeMode with an explicit reference size when the destination font used an implicit reference size!");
    }
    assert(font_cfg.FontLoaderData == null);
    if ImFontAtlasFontSourceInit(self, font_cfg) == 0 {
        ImFontAtlasFontDestroySourceData(self, font_cfg);
        ImVector_ImFontConfig_pop_back(&self.Sources);
        ImVector_ImFontConfig_ptr_pop_back(&font.Sources);
        if font_cfg.MergeMode == 0 {
            0;
            ImVector_ImFont_ptr_pop_back(&self.Fonts);
        }
        return null;
    }
    ImFontAtlasFontSourceAddToFont(self, font, font_cfg);
    if is_first_font != 0 {
        ImFontAtlasBuildNotifySetFont(self, null, font);
    }
    return font;
}

private {
u32 Decode85Byte(u8 c) {
    return c >= 92 ? c - 36 : c - 35;
}

void Decode85(u8* src, u8* dst) {
    while *src != 0 {
        u32 tmp = Decode85Byte(cast(u8, src[0])) + 85 * (Decode85Byte(cast(u8, src[1])) + 85 * (Decode85Byte(cast(u8, src[2])) + 85 * (Decode85Byte(cast(u8, src[3])) + 85 * Decode85Byte(cast(u8, src[4])))));
        dst[0] = cast(u8, tmp >> 0 & 0xFF);
        dst[1] = cast(u8, tmp >> 8 & 0xFF);
        dst[2] = cast(u8, tmp >> 16 & 0xFF);
        dst[3] = cast(u8, tmp >> 24 & 0xFF);
        src += 5;
        dst += 4;
    }
}
}

// This duplicates some of the logic in UpdateFontsNewFrame() which is a bit chicken-and-eggy/tricky to extract due to variety of codepaths and possible initialization ordering.
private {
f32 GetExpectedContextFontSize(ImGuiContext* ctx) {
    return (ctx.Style.FontSizeBase > 0.0f ? ctx.Style.FontSizeBase : 13.0f) * ctx.Style.FontScaleMain * ctx.Style.FontScaleDpi;
}
}

// Legacy function with heuristic to select Pixel or Vector font.
// The selection is based on (style.FontSizeBase * style.FontScaleMain * style.FontScaleDpi) reaching a small threshold at the time of adding the default font.
// Prefer calling AddFontDefaultVector() or AddFontDefaultBitmap() based on your own logic.
ImFont* ImFontAtlas_AddFontDefault(ImFontAtlas* self, ImFontConfig* font_cfg) {
    if self.OwnerContext == null || GetExpectedContextFontSize(self.OwnerContext) >= 15.0f {
        return ImFontAtlas_AddFontDefaultVector(self, font_cfg);
    } else {
        return ImFontAtlas_AddFontDefaultBitmap(self, font_cfg);
    }
}

// Load embedded ProggyClean.ttf. Default size 13, disable oversampling.
// If you want a similar font which may be better scaled, consider using AddFontDefaultVector().
ImFont* ImFontAtlas_AddFontDefaultBitmap(ImFontAtlas* self, ImFontConfig* font_cfg_template) {
    ImFontConfig font_cfg = font_cfg_template != null ? *font_cfg_template : __cxx_make_ImFontConfig();
    if font_cfg_template == null {
        font_cfg.PixelSnapH = true;
    }
    if font_cfg.SizePixels <= 0.0f {
        font_cfg.SizePixels = 13.0f;
        font_cfg.Flags |= ImFontFlags_ImplicitRefSize;
    }
    if font_cfg.Name[0] == 0 {
        ImFormatString(font_cfg.Name, cast(u64, cast(i32, sizeof(font_cfg.Name) / sizeof(*font_cfg.Name))), "ProggyClean.ttf");
    }
    font_cfg.EllipsisChar = cast(ImWchar, 0x0085);
    font_cfg.GlyphOffset.y += 1.0f * (font_cfg.SizePixels / 13.0f);
    i32 ttf_compressed_size = 0;
    u8* ttf_compressed = ImGui_GetDefaultCompressedFontDataProggyClean(&ttf_compressed_size);
    return ImFontAtlas_AddFontFromMemoryCompressedTTF(self, ttf_compressed, ttf_compressed_size, font_cfg.SizePixels, &font_cfg, null);
}

// Load a minimal version of ProggyForever, designed to match our good old ProggyClean, but nicely scalable.
// (See build script in https://github.com/ocornut/proggyforever for details)
ImFont* ImFontAtlas_AddFontDefaultVector(ImFontAtlas* self, ImFontConfig* font_cfg_template) {
    ImFontConfig font_cfg = font_cfg_template != null ? *font_cfg_template : __cxx_make_ImFontConfig();
    if font_cfg_template == null {
        font_cfg.PixelSnapH = true;
    }
    if font_cfg.SizePixels <= 0.0f {
        font_cfg.SizePixels = 13.0f;
        font_cfg.Flags |= ImFontFlags_ImplicitRefSize;
    }
    if font_cfg.Name[0] == 0 {
        ImFormatString(font_cfg.Name, cast(u64, cast(i32, sizeof(font_cfg.Name) / sizeof(*font_cfg.Name))), "ProggyForever.ttf");
    }
    font_cfg.ExtraSizeScale *= 1.015f;
    font_cfg.GlyphOffset.y += 0.5f * (font_cfg.SizePixels / 16.0f);
    i32 ttf_compressed_size = 0;
    u8* ttf_compressed = ImGui_GetDefaultCompressedFontDataProggyForever(&ttf_compressed_size);
    return ImFontAtlas_AddFontFromMemoryCompressedTTF(self, ttf_compressed, ttf_compressed_size, font_cfg.SizePixels, &font_cfg, null);
}

ImFont* ImFontAtlas_AddFontFromFileTTF(ImFontAtlas* self, u8* filename, f32 size_pixels, ImFontConfig* font_cfg_template, ImWchar* glyph_ranges) {
    assert(!self.Locked && "Cannot modify a locked ImFontAtlas!");
    u64 data_size = 0;
    void* data = ImFileLoadToMemory(filename, "rb", &data_size, 0);
    if data == null {
        if font_cfg_template == null || (font_cfg_template.Flags & ImFontFlags_NoLoadError) == 0 {
            while true {
                if 0 == 0 {
                    if ImGui_ErrorLog("Could not load font file!") != 0 {
                        assert(0 && "Could not load font file!");
                    }
                }
                if !(0 != 0) { break; }
            }
        }
        return null;
    }
    ImFontConfig font_cfg = font_cfg_template != null ? *font_cfg_template : __cxx_make_ImFontConfig();
    if font_cfg.Name[0] == 0 {
        u8* p;
        for p = filename + strlen(filename); p > filename && p[-1] != 47 && p[-1] != 92; p-- {
        }
        ImFormatString(font_cfg.Name, cast(u64, cast(i32, sizeof(font_cfg.Name) / sizeof(*font_cfg.Name))), "%s", p);
    }
    return ImFontAtlas_AddFontFromMemoryTTF(self, data, cast(i32, data_size), size_pixels, &font_cfg, glyph_ranges);
}

// NB: Transfer ownership of 'font_data' to ImFontAtlas, unless font_cfg_template->FontDataOwnedByAtlas == false. Owned TTF buffer will be deleted after Build().
ImFont* ImFontAtlas_AddFontFromMemoryTTF(ImFontAtlas* self, void* font_data, i32 font_data_size, f32 size_pixels, ImFontConfig* font_cfg_template, ImWchar* glyph_ranges) {
    assert(!self.Locked && "Cannot modify a locked ImFontAtlas!");
    ImFontConfig font_cfg = font_cfg_template != null ? *font_cfg_template : __cxx_make_ImFontConfig();
    assert(font_cfg.FontData == null);
    assert(font_data_size > 100 && "Incorrect value for font_data_size!");
    font_cfg.FontData = font_data;
    font_cfg.FontDataSize = font_data_size;
    font_cfg.SizePixels = size_pixels > 0.0f ? size_pixels : font_cfg.SizePixels;
    if glyph_ranges != null {
        font_cfg.GlyphRanges = glyph_ranges;
    }
    return ImFontAtlas_AddFont(self, &font_cfg);
}

ImFont* ImFontAtlas_AddFontFromMemoryCompressedTTF(ImFontAtlas* self, void* compressed_ttf_data, i32 compressed_ttf_size, f32 size_pixels, ImFontConfig* font_cfg_template, ImWchar* glyph_ranges) {
    u32 buf_decompressed_size = stb_decompress_length(cast(u8*, compressed_ttf_data));
    var buf_decompressed_data = cast(u8*, ImGui_MemAlloc(buf_decompressed_size));
    stb_decompress(buf_decompressed_data, cast(u8*, compressed_ttf_data), cast(u32, compressed_ttf_size));
    ImFontConfig font_cfg = font_cfg_template != null ? *font_cfg_template : __cxx_make_ImFontConfig();
    assert(font_cfg.FontData == null);
    font_cfg.FontDataOwnedByAtlas = true;
    return ImFontAtlas_AddFontFromMemoryTTF(self, buf_decompressed_data, cast(i32, buf_decompressed_size), size_pixels, &font_cfg, glyph_ranges);
}

ImFont* ImFontAtlas_AddFontFromMemoryCompressedBase85TTF(ImFontAtlas* self, u8* compressed_ttf_data_base85, f32 size_pixels, ImFontConfig* font_cfg, ImWchar* glyph_ranges) {
    i32 compressed_ttf_size = (cast(i32, strlen(compressed_ttf_data_base85)) + 4) / 5 * 4;
    void* compressed_ttf = ImGui_MemAlloc(cast(u64, compressed_ttf_size));
    Decode85(cast(u8*, compressed_ttf_data_base85), cast(u8*, compressed_ttf));
    ImFont* font = ImFontAtlas_AddFontFromMemoryCompressedTTF(self, compressed_ttf, compressed_ttf_size, size_pixels, font_cfg, glyph_ranges);
    ImGui_MemFree(compressed_ttf);
    return font;
}

// On font removal we need to remove references (otherwise we could queue removal?)
// We allow old_font == new_font which forces updating all values (e.g. sizes)
void ImFontAtlasBuildNotifySetFont(ImFontAtlas* atlas, ImFont* old_font, ImFont* new_font) {
    {
        ImDrawListSharedData** zz_rf_it_15 = ImVector_ImDrawListSharedData_ptr_begin(&atlas.DrawListSharedDatas);
        ImDrawListSharedData** zz_rf_end_15 = ImVector_ImDrawListSharedData_ptr_end(&atlas.DrawListSharedDatas);
        for ; zz_rf_it_15 != zz_rf_end_15; zz_rf_it_15++ {
            ImDrawListSharedData* shared_data = *zz_rf_it_15;
            if shared_data.Font == old_font {
                shared_data.Font = new_font;
            }
            {
                ImGuiContext* ctx = shared_data.Context;
                if ctx != null {
                    if old_font == null && ctx.Font == null && ctx.FontSizeBase == 0.0f {
                        continue;
                    }
                    if ctx.IO.FontDefault == old_font {
                        ctx.IO.FontDefault = new_font;
                    }
                    if ctx.Font == old_font {
                        ImGuiContext* curr_ctx = ImGui_GetCurrentContext();
                        bool need_bind_ctx = ctx != curr_ctx;
                        if need_bind_ctx != 0 {
                            ImGui_SetCurrentContext(ctx);
                        }
                        ImGui_SetCurrentFont(new_font, ctx.FontSizeBase, ctx.FontSize);
                        if need_bind_ctx != 0 {
                            ImGui_SetCurrentContext(curr_ctx);
                        }
                    }
                    {
                        ImFontStackData* zz_rf_it_14 = ImVector_ImFontStackData_begin(&ctx.FontStack);
                        ImFontStackData* zz_rf_end_14 = ImVector_ImFontStackData_end(&ctx.FontStack);
                        for ; zz_rf_it_14 != zz_rf_end_14; zz_rf_it_14++ {
                            ImFontStackData* font_stack_data = zz_rf_it_14;
                            if font_stack_data.Font == old_font {
                                font_stack_data.Font = new_font;
                            }
                        }
                    }
                }
            }
        }
    }
}

void ImFontAtlas_RemoveFont(ImFontAtlas* self, ImFont* font) {
    assert(!self.Locked && "Cannot modify a locked ImFontAtlas!");
    ImFontAtlasFontDestroyOutput(self, font);
    {
        ImFontConfig** zz_rf_it_16 = ImVector_ImFontConfig_ptr_begin(&font.Sources);
        ImFontConfig** zz_rf_end_16 = ImVector_ImFontConfig_ptr_end(&font.Sources);
        for ; zz_rf_it_16 != zz_rf_end_16; zz_rf_it_16++ {
            ImFontConfig* src = *zz_rf_it_16;
            ImFontAtlasFontDestroySourceData(self, src);
        }
    }
    for i32 src_n = 0; src_n < self.Sources.Size; src_n++ {
        if self.Sources.Data[src_n].DstFont == font {
            ImVector_ImFontConfig_erase(&self.Sources, &self.Sources.Data[src_n--]);
        }
    }
    bool removed = ImVector_ImFont_ptr_find_erase(&self.Fonts, font);
    assert(cast(i64, removed));
    ignore removed;
    ImFontAtlasBuildUpdatePointers(self);
    font.OwnerAtlas = null;
    0;
    ImFont* new_current_font = ImVector_ImFont_ptr_empty(&self.Fonts) != 0 ? null : self.Fonts.Data[0];
    ImFontAtlasBuildNotifySetFont(self, font, new_current_font);
}

// At it is common to do an AddCustomRect() followed by a GetCustomRect(), we provide an optional 'ImFontAtlasRect* out_r = NULL' argument to retrieve the info straight away.
ImFontAtlasRectId ImFontAtlas_AddCustomRect(ImFontAtlas* self, i32 width, i32 height, ImFontAtlasRect* out_r) {
    assert(width > 0 && width <= 0xFFFF);
    assert(height > 0 && height <= 0xFFFF);
    if self.Builder == null {
        ImFontAtlasBuildInit(self);
    }
    ImFontAtlasRectId r_id = ImFontAtlasPackAddRect(self, width, height);
    if r_id == -1 {
        return -1;
    }
    if out_r != null {
        ImFontAtlas_GetCustomRect(self, r_id, out_r);
    }
    if self.RendererHasTextures != 0 {
        ImTextureRect* r = ImFontAtlasPackGetRect(self, r_id);
        ImFontAtlasTextureBlockQueueUpload(self, self.TexData, cast(i32, r.x), cast(i32, r.y), cast(i32, r.w), cast(i32, r.h));
    }
    return r_id;
}

void ImFontAtlas_RemoveCustomRect(ImFontAtlas* self, ImFontAtlasRectId id) {
    if ImFontAtlasPackGetRectSafe(self, id) == null {
        return;
    }
    ImFontAtlasPackDiscardRect(self, id);
}

bool ImFontAtlas_GetCustomRect(ImFontAtlas* self, ImFontAtlasRectId id, ImFontAtlasRect* out_r) {
    ImTextureRect* r = ImFontAtlasPackGetRectSafe(self, id);
    if r == null {
        return false;
    }
    assert(self.TexData.Width > 0 && self.TexData.Height > 0);
    if out_r == null {
        return true;
    }
    out_r.x = r.x;
    out_r.y = r.y;
    out_r.w = r.w;
    out_r.h = r.h;
    out_r.uv0 = op_mul_ImVec2_ImVec2(ImVec2{cast(f32, r.x), cast(f32, r.y)}, self.TexUvScale);
    out_r.uv1 = op_mul_ImVec2_ImVec2(ImVec2{cast(f32, r.x + r.w), cast(f32, r.y + r.h)}, self.TexUvScale);
    return true;
}

bool ImFontAtlasGetMouseCursorTexData(ImFontAtlas* atlas, ImGuiMouseCursor cursor_type, ImVec2* out_offset, ImVec2* out_size, ImVec2* out_uv_border, ImVec2* out_uv_fill) {
    if cursor_type <= ImGuiMouseCursor_None || cursor_type >= ImGuiMouseCursor_COUNT {
        return false;
    }
    if (atlas.Flags & ImFontAtlasFlags_NoMouseCursors) != 0 {
        return false;
    }
    ImTextureRect* r = ImFontAtlasPackGetRect(atlas, atlas.Builder.PackIdMouseCursors);
    ImVec2 pos = op_add_ImVec2_ImVec2(FONT_ATLAS_DEFAULT_TEX_CURSOR_DATA[cursor_type][0], ImVec2{cast(f32, r.x), cast(f32, r.y)});
    ImVec2 size = FONT_ATLAS_DEFAULT_TEX_CURSOR_DATA[cursor_type][1];
    *out_size = size;
    *out_offset = FONT_ATLAS_DEFAULT_TEX_CURSOR_DATA[cursor_type][2];
    out_uv_border[0] = op_mul_ImVec2_ImVec2(pos, atlas.TexUvScale);
    out_uv_border[1] = op_mul_ImVec2_ImVec2(op_add_ImVec2_ImVec2(pos, size), atlas.TexUvScale);
    pos.x += cast(f32, FONT_ATLAS_DEFAULT_TEX_DATA_W + 1);
    out_uv_fill[0] = op_mul_ImVec2_ImVec2(pos, atlas.TexUvScale);
    out_uv_fill[1] = op_mul_ImVec2_ImVec2(op_add_ImVec2_ImVec2(pos, size), atlas.TexUvScale);
    return true;
}

// When atlas->RendererHasTextures = true, this is only called if no font were loaded.
void ImFontAtlasBuildMain(ImFontAtlas* atlas) {
    assert(!atlas.Locked && "Cannot modify a locked ImFontAtlas!");
    if atlas.TexData && atlas.TexData.Format != atlas.TexDesiredFormat {
        ImFontAtlasBuildClear(atlas);
    }
    if atlas.Builder == null {
        ImFontAtlasBuildInit(atlas);
    }
    if atlas.Sources.Size == 0 {
        ImFontAtlas_AddFontDefault(atlas, null);
    }
    ImFontAtlasBuildUpdateRendererHasTexturesFromContext(atlas);
    if atlas.RendererHasTextures == false {
        ImFontAtlasBuildLegacyPreloadAllGlyphRanges(atlas);
    }
    atlas.TexIsBuilt = true;
}

void ImFontAtlasBuildGetOversampleFactors(ImFontConfig* src, ImFontBaked* baked, i32* out_oversample_h, i32* out_oversample_v) {
    f32 raster_size = baked.Size * baked.RasterizerDensity * src.RasterizerDensity;
    *out_oversample_h = src.OversampleH != 0 ? src.OversampleH : raster_size > 36.0f || src.PixelSnapH ? 1 : 2;
    *out_oversample_v = src.OversampleV != 0 ? src.OversampleV : 1;
}

// Setup main font loader for the atlas
// Every font source (ImFontConfig) will use this unless ImFontConfig::FontLoader specify a custom loader.
void ImFontAtlasBuildSetupFontLoader(ImFontAtlas* atlas, ImFontLoader* font_loader) {
    if atlas.FontLoader == font_loader {
        return;
    }
    assert(!atlas.Locked && "Cannot modify a locked ImFontAtlas!");
    {
        ImFont** zz_rf_it_17 = ImVector_ImFont_ptr_begin(&atlas.Fonts);
        ImFont** zz_rf_end_17 = ImVector_ImFont_ptr_end(&atlas.Fonts);
        for ; zz_rf_it_17 != zz_rf_end_17; zz_rf_it_17++ {
            ImFont* font = *zz_rf_it_17;
            ImFontAtlasFontDestroyOutput(atlas, font);
        }
    }
    if atlas.Builder && atlas.FontLoader && atlas.FontLoader.LoaderShutdown {
        atlas.FontLoader.LoaderShutdown(atlas);
    }
    atlas.FontLoader = font_loader;
    atlas.FontLoaderName = font_loader != null ? font_loader.Name : "NULL";
    assert(atlas.FontLoaderData == null);
    if atlas.Builder && atlas.FontLoader && atlas.FontLoader.LoaderInit {
        atlas.FontLoader.LoaderInit(atlas);
    }
    {
        ImFont** zz_rf_it_18 = ImVector_ImFont_ptr_begin(&atlas.Fonts);
        ImFont** zz_rf_end_18 = ImVector_ImFont_ptr_end(&atlas.Fonts);
        for ; zz_rf_it_18 != zz_rf_end_18; zz_rf_it_18++ {
            ImFont* font = *zz_rf_it_18;
            ImFontAtlasFontInitOutput(atlas, font);
        }
    }
    {
        ImFont** zz_rf_it_20 = ImVector_ImFont_ptr_begin(&atlas.Fonts);
        ImFont** zz_rf_end_20 = ImVector_ImFont_ptr_end(&atlas.Fonts);
        for ; zz_rf_it_20 != zz_rf_end_20; zz_rf_it_20++ {
            ImFont* font = *zz_rf_it_20;
            {
                ImFontConfig** zz_rf_it_19 = ImVector_ImFontConfig_ptr_begin(&font.Sources);
                ImFontConfig** zz_rf_end_19 = ImVector_ImFontConfig_ptr_end(&font.Sources);
                for ; zz_rf_it_19 != zz_rf_end_19; zz_rf_it_19++ {
                    ImFontConfig* src = *zz_rf_it_19;
                    ImFontAtlasFontSourceAddToFont(atlas, font, src);
                }
            }
        }
    }
}

// Preload all glyph ranges for legacy backends.
// This may lead to multiple texture creation which might be a little slower than before.
void ImFontAtlasBuildLegacyPreloadAllGlyphRanges(ImFontAtlas* atlas) {
    atlas.Builder.PreloadedAllGlyphsRanges = true;
    {
        ImFont** zz_rf_it_22 = ImVector_ImFont_ptr_begin(&atlas.Fonts);
        ImFont** zz_rf_end_22 = ImVector_ImFont_ptr_end(&atlas.Fonts);
        for ; zz_rf_it_22 != zz_rf_end_22; zz_rf_it_22++ {
            ImFont* font = *zz_rf_it_22;
            ImFontBaked* baked = ImFont_GetFontBaked(font, font.LegacySize, -1.0f);
            if font.FallbackChar != 0 {
                ImFontBaked_FindGlyph(baked, font.FallbackChar);
            }
            if font.EllipsisChar != 0 {
                ImFontBaked_FindGlyph(baked, font.EllipsisChar);
            }
            {
                ImFontConfig** zz_rf_it_21 = ImVector_ImFontConfig_ptr_begin(&font.Sources);
                ImFontConfig** zz_rf_end_21 = ImVector_ImFontConfig_ptr_end(&font.Sources);
                for ; zz_rf_it_21 != zz_rf_end_21; zz_rf_it_21++ {
                    ImFontConfig* src = *zz_rf_it_21;
                    ImWchar* ranges = src.GlyphRanges != null ? src.GlyphRanges : ImFontAtlas_GetGlyphRangesDefault(atlas);
                    for ; ranges[0] != 0; ranges += 2 {
                        for u32 c = ranges[0]; c <= ranges[1] && c <= 0xFFFF; c++ {
                            ImFontBaked_FindGlyph(baked, cast(ImWchar, c));
                        }
                    }
                }
            }
        }
    }
}

// FIXME: May make ImFont::Sources a ImSpan<> and move ownership to ImFontAtlas
void ImFontAtlasBuildUpdatePointers(ImFontAtlas* atlas) {
    {
        ImFont** zz_rf_it_23 = ImVector_ImFont_ptr_begin(&atlas.Fonts);
        ImFont** zz_rf_end_23 = ImVector_ImFont_ptr_end(&atlas.Fonts);
        for ; zz_rf_it_23 != zz_rf_end_23; zz_rf_it_23++ {
            ImFont* font = *zz_rf_it_23;
            ImVector_ImFontConfig_ptr_resize(&font.Sources, 0);
        }
    }
    {
        ImFontConfig* zz_rf_it_24 = ImVector_ImFontConfig_begin(&atlas.Sources);
        ImFontConfig* zz_rf_end_24 = ImVector_ImFontConfig_end(&atlas.Sources);
        for ; zz_rf_it_24 != zz_rf_end_24; zz_rf_it_24++ {
            ImFontConfig* src = zz_rf_it_24;
            ImVector_ImFontConfig_ptr_push_back(&src.DstFont.Sources, src);
        }
    }
}

// Render a white-colored bitmap encoded in a string
void ImFontAtlasBuildRenderBitmapFromString(ImFontAtlas* atlas, i32 x, i32 y, i32 w, i32 h, u8* in_str, u8 in_marker_char) {
    ImTextureData* tex = atlas.TexData;
    assert(x >= 0 && x + w <= tex.Width);
    assert(y >= 0 && y + h <= tex.Height);
    switch tex.Format {
        case ImTextureFormat_Alpha8: {
            {
                var out_p = cast(ImU8*, ImTextureData_GetPixelsAt(tex, x, y));
                for i32 off_y = 0; off_y < h; off_y++ {
                    for i32 off_x = 0; off_x < w; off_x++ {
                        out_p[off_x] = cast(ImU8, in_str[off_x] == in_marker_char ? 0xFF : 0x00);
                    }
                    out_p += tex.Width;
                    in_str += w;
                }
                break case;
            }
        }
        case ImTextureFormat_RGBA32: {
            {
                var out_p = cast(ImU32*, ImTextureData_GetPixelsAt(tex, x, y));
                for i32 off_y = 0; off_y < h; off_y++ {
                    for i32 off_x = 0; off_x < w; off_x++ {
                        out_p[off_x] = in_str[off_x] == in_marker_char ? cast(ImU32, 255) << 24 | cast(ImU32, 255) << 16 | cast(ImU32, 255) << 8 | cast(ImU32, 255) << 0 : cast(ImU32, 0) << 24 | cast(ImU32, 0) << 16 | cast(ImU32, 0) << 8 | cast(ImU32, 0) << 0;
                    }
                    out_p += tex.Width;
                    in_str += w;
                }
                break case;
            }
        }
    }
}

private {
void ImFontAtlasBuildUpdateTexDataBasic(ImFontAtlas* atlas) {
    ImFontAtlasBuilder* builder = atlas.Builder;
    ImVec2i pack_size = (atlas.Flags & ImFontAtlasFlags_NoMouseCursors) != 0 ? ImVec2i{2, 2} : ImVec2i{
        FONT_ATLAS_DEFAULT_TEX_DATA_W * 2 + 1, FONT_ATLAS_DEFAULT_TEX_DATA_H,
    };
    ImFontAtlasRect r;
    bool add_and_draw = ImFontAtlas_GetCustomRect(atlas, builder.PackIdMouseCursors, &r) == false;
    if add_and_draw != 0 {
        builder.PackIdMouseCursors = ImFontAtlas_AddCustomRect(atlas, pack_size.x, pack_size.y, &r);
        assert(builder.PackIdMouseCursors != -1);
        if (atlas.Flags & ImFontAtlasFlags_NoMouseCursors) != 0 {
            ImFontAtlasBuildRenderBitmapFromString(atlas, cast(i32, r.x), cast(i32, r.y), 2, 2, "XXXX", 88);
        } else {
            var x_for_white = cast(i32, r.x);
            i32 x_for_black = r.x + FONT_ATLAS_DEFAULT_TEX_DATA_W + 1;
            ImFontAtlasBuildRenderBitmapFromString(atlas, x_for_white, cast(i32, r.y), FONT_ATLAS_DEFAULT_TEX_DATA_W, FONT_ATLAS_DEFAULT_TEX_DATA_H, FONT_ATLAS_DEFAULT_TEX_DATA_PIXELS, 46);
            ImFontAtlasBuildRenderBitmapFromString(atlas, x_for_black, cast(i32, r.y), FONT_ATLAS_DEFAULT_TEX_DATA_W, FONT_ATLAS_DEFAULT_TEX_DATA_H, FONT_ATLAS_DEFAULT_TEX_DATA_PIXELS, 88);
        }
    }
    atlas.TexUvWhitePixel = ImVec2{
        (cast(f32, r.x) + 0.5f) * atlas.TexUvScale.x, (cast(f32, r.y) + 0.5f) * atlas.TexUvScale.y,
    };
}

void ImFontAtlasBuildUpdateTexDataLines(ImFontAtlas* atlas) {
    if (atlas.Flags & ImFontAtlasFlags_NoBakedLines) != 0 {
        return;
    }
    ImTextureData* tex = atlas.TexData;
    ImFontAtlasBuilder* builder = atlas.Builder;
    ImFontAtlasRect r;
    bool add_and_draw = ImFontAtlas_GetCustomRect(atlas, builder.PackIdLinesTexData, &r) == false;
    if add_and_draw != 0 {
        var pack_size = ImVec2i{32 + 2, 32 + 1};
        builder.PackIdLinesTexData = ImFontAtlas_AddCustomRect(atlas, pack_size.x, pack_size.y, &r);
        assert(builder.PackIdLinesTexData != -1);
    }
    for i32 n = 0; n < 32 + 1; n++ {
        i32 y = n;
        i32 line_width = n;
        i32 pad_left = (r.w - line_width) / 2;
        i32 pad_right = r.w - (pad_left + line_width);
        assert(pad_left + line_width + pad_right == cast(i32, r.w) && y < cast(i32, r.h));
        if add_and_draw && tex.Format == ImTextureFormat_Alpha8 {
            var write_ptr = cast(ImU8*, ImTextureData_GetPixelsAt(tex, cast(i32, r.x), r.y + y));
            for i32 i = 0; i < pad_left; i++ {
                *(write_ptr + i) = 0x00;
            }
            for i32 i = 0; i < line_width; i++ {
                *(write_ptr + pad_left + i) = 0xFF;
            }
            for i32 i = 0; i < pad_right; i++ {
                *(write_ptr + pad_left + line_width + i) = 0x00;
            }
        } else if add_and_draw && tex.Format == ImTextureFormat_RGBA32 {
            var write_ptr = cast(ImU32*, ImTextureData_GetPixelsAt(tex, cast(i32, r.x), r.y + y));
            for i32 i = 0; i < pad_left; i++ {
                *(write_ptr + i) = cast(ImU32, 0) << 24 | cast(ImU32, 255) << 16 | cast(ImU32, 255) << 8 | cast(ImU32, 255) << 0;
            }
            for i32 i = 0; i < line_width; i++ {
                *(write_ptr + pad_left + i) = cast(ImU32, 255) << 24 | cast(ImU32, 255) << 16 | cast(ImU32, 255) << 8 | cast(ImU32, 255) << 0;
            }
            for i32 i = 0; i < pad_right; i++ {
                *(write_ptr + pad_left + line_width + i) = cast(ImU32, 0) << 24 | cast(ImU32, 255) << 16 | cast(ImU32, 255) << 8 | cast(ImU32, 255) << 0;
            }
        }
        ImVec2 uv0 = op_mul_ImVec2_ImVec2(ImVec2{cast(f32, r.x + pad_left - 1), cast(f32, r.y + y)}, atlas.TexUvScale);
        ImVec2 uv1 = op_mul_ImVec2_ImVec2(ImVec2{
            cast(f32, r.x + pad_left + line_width + 1), cast(f32, r.y + y + 1),
        }, atlas.TexUvScale);
        f32 half_v = (uv0.y + uv1.y) * 0.5f;
        atlas.TexUvLines[n] = ImVec4{uv0.x, half_v, uv1.x, half_v};
    }
}
}

//-----------------------------------------------------------------------------------------------------------------------------
// Was tempted to lazily init FontSrc but wouldn't save much + makes it more complicated to detect invalid data at AddFont()
bool ImFontAtlasFontInitOutput(ImFontAtlas* atlas, ImFont* font) {
    bool ret = true;
    {
        ImFontConfig** zz_rf_it_25 = ImVector_ImFontConfig_ptr_begin(&font.Sources);
        ImFontConfig** zz_rf_end_25 = ImVector_ImFontConfig_ptr_end(&font.Sources);
        for ; zz_rf_it_25 != zz_rf_end_25; zz_rf_it_25++ {
            ImFontConfig* src = *zz_rf_it_25;
            if ImFontAtlasFontSourceInit(atlas, src) == 0 {
                ret = false;
            }
        }
    }
    assert(cast(i64, ret));
    return ret;
}

// Keep source/input FontData
void ImFontAtlasFontDestroyOutput(ImFontAtlas* atlas, ImFont* font) {
    ImFont_ClearOutputData(font);
    {
        ImFontConfig** zz_rf_it_26 = ImVector_ImFontConfig_ptr_begin(&font.Sources);
        ImFontConfig** zz_rf_end_26 = ImVector_ImFontConfig_ptr_end(&font.Sources);
        for ; zz_rf_it_26 != zz_rf_end_26; zz_rf_it_26++ {
            ImFontConfig* src = *zz_rf_it_26;
            ImFontLoader* loader = src.FontLoader != null ? src.FontLoader : atlas.FontLoader;
            if loader && loader.FontSrcDestroy != null {
                loader.FontSrcDestroy(atlas, src);
            }
        }
    }
}

void ImFontAtlasFontRebuildOutput(ImFontAtlas* atlas, ImFont* font) {
    ImFontAtlasFontDestroyOutput(atlas, font);
    ImFontAtlasFontInitOutput(atlas, font);
}

//-----------------------------------------------------------------------------------------------------------------------------
bool ImFontAtlasFontSourceInit(ImFontAtlas* atlas, ImFontConfig* src) {
    ImFontLoader* loader = src.FontLoader != null ? src.FontLoader : atlas.FontLoader;
    if loader.FontSrcInit != null && !loader.FontSrcInit(atlas, src) {
        return false;
    }
    return true;
}

void ImFontAtlasFontSourceAddToFont(ImFontAtlas* atlas, ImFont* font, ImFontConfig* src) {
    if src.MergeMode == false {
        ImFont_ClearOutputData(font);
        font.OwnerAtlas = atlas;
        assert(font.Sources.Data[0] == src);
    }
    atlas.TexIsBuilt = false;
    ImFontAtlasBuildSetupFontSpecialGlyphs(atlas, font, src);
}

void ImFontAtlasFontDestroySourceData(ImFontAtlas* atlas, ImFontConfig* src) {
    ignore atlas;
    if src.FontDataOwnedByAtlas != 0 {
        ImGui_MemFree(src.FontData);
    }
    src.FontData = null;
    if src.GlyphExcludeRanges != null {
        ImGui_MemFree(cast(void*, src.GlyphExcludeRanges));
    }
    src.GlyphExcludeRanges = null;
}

// Create a compact, baked "..." if it doesn't exist, by using the ".".
// This may seem overly complicated right now but the point is to exercise and improve a technique which should be increasingly used.
// FIXME-NEWATLAS: This borrows too much from FontLoader's FontLoadGlyph() handlers and suggest that we should add further helpers.
private {
ImFontGlyph* ImFontAtlasBuildSetupFontBakedEllipsis(ImFontAtlas* atlas, ImFontBaked* baked) {
    ImFont* font = baked.OwnerFont;
    assert(font.EllipsisChar != 0);
    ImFontGlyph* dot_glyph = ImFontBaked_FindGlyphNoFallback(baked, cast(ImWchar, 46));
    if dot_glyph == null {
        dot_glyph = ImFontBaked_FindGlyphNoFallback(baked, cast(ImWchar, 0xFF0E));
    }
    if dot_glyph == null {
        return null;
    }
    ImFontAtlasRectId dot_r_id = dot_glyph.PackId;
    ImTextureRect* dot_r = ImFontAtlasPackGetRect(atlas, dot_r_id);
    i32 dot_spacing = 1;
    f32 dot_step = dot_glyph.X1 - dot_glyph.X0 + cast(f32, dot_spacing);
    ImFontAtlasRectId pack_id = ImFontAtlasPackAddRect(atlas, cast(i32, dot_r.w * 3 + cast(u32, dot_spacing * 2)), cast(i32, dot_r.h));
    ImTextureRect* r = ImFontAtlasPackGetRect(atlas, pack_id);
    ImFontGlyph glyph_in = __cxx_make_ImFontGlyph();
    ImFontGlyph* glyph = &glyph_in;
    glyph.Codepoint = font.EllipsisChar;
    glyph.AdvanceX = ImMax(dot_glyph.AdvanceX, dot_glyph.X0 + dot_step * 3.0f - cast(f32, dot_spacing));
    glyph.X0 = dot_glyph.X0;
    glyph.Y0 = dot_glyph.Y0;
    glyph.X1 = dot_glyph.X0 + dot_step * 3.0f - cast(f32, dot_spacing);
    glyph.Y1 = dot_glyph.Y1;
    glyph.Visible = true;
    glyph.PackId = pack_id;
    glyph = ImFontAtlasBakedAddFontGlyph(atlas, baked, null, glyph);
    dot_glyph = null;
    dot_r = ImFontAtlasPackGetRect(atlas, dot_r_id);
    ImTextureData* tex = atlas.TexData;
    for i32 n = 0; n < 3; n++ {
        ImFontAtlasTextureBlockCopy(tex, cast(i32, dot_r.x), cast(i32, dot_r.y), tex, r.x + (dot_r.w + dot_spacing) * n, cast(i32, r.y), cast(i32, dot_r.w), cast(i32, dot_r.h));
    }
    ImFontAtlasTextureBlockQueueUpload(atlas, tex, cast(i32, r.x), cast(i32, r.y), cast(i32, r.w), cast(i32, r.h));
    return glyph;
}

// Load fallback in order to obtain its index
// (this is called from in hot-path so we avoid extraneous parameters to minimize impact on code size)
void ImFontAtlasBuildSetupFontBakedFallback(ImFontBaked* baked) {
    assert(baked.FallbackGlyphIndex == -1);
    assert(baked.FallbackAdvanceX == 0.0f);
    ImFont* font = baked.OwnerFont;
    ImFontGlyph* fallback_glyph = null;
    if font.FallbackChar != 0 {
        fallback_glyph = ImFontBaked_FindGlyphNoFallback(baked, font.FallbackChar);
    }
    if fallback_glyph == null {
        ImFontGlyph* space_glyph = ImFontBaked_FindGlyphNoFallback(baked, cast(ImWchar, 32));
        ImFontGlyph glyph;
        glyph.Codepoint = 0;
        glyph.AdvanceX = space_glyph != null ? space_glyph.AdvanceX : cast(f32, cast(i32, baked.Size * 0.4f + 0.5f));
        fallback_glyph = ImFontAtlasBakedAddFontGlyph(font.OwnerAtlas, baked, null, &glyph);
    }
    baked.FallbackGlyphIndex = ImVector_ImFontGlyph_index_from_ptr(&baked.Glyphs, fallback_glyph);
    baked.FallbackAdvanceX = fallback_glyph.AdvanceX;
}

void ImFontAtlasBuildSetupFontBakedBlanks(ImFontAtlas* atlas, ImFontBaked* baked) {
    ImFontGlyph* space_glyph = ImFontBaked_FindGlyphNoFallback(baked, cast(ImWchar, 32));
    if space_glyph != null {
        space_glyph.Visible = false;
    }
    if ImFontBaked_FindGlyphNoFallback(baked, 9) == null && space_glyph != null {
        ImFontGlyph tab_glyph;
        tab_glyph.Codepoint = 9;
        tab_glyph.AdvanceX = space_glyph.AdvanceX * 4.0f;
        ImFontAtlasBakedAddFontGlyph(atlas, baked, null, &tab_glyph);
    }
}
}

// Load/identify special glyphs
// (note that this is called again for fonts with MergeMode)
void ImFontAtlasBuildSetupFontSpecialGlyphs(ImFontAtlas* atlas, ImFont* font, ImFontConfig* src) {
    ignore atlas;
    assert(cast(i64, ImVector_ImFontConfig_ptr_contains(&font.Sources, src)));
    ImWchar[4] fallback_chars = {
        font.FallbackChar, cast(ImWchar, 0xFFFD), cast(ImWchar, 63), cast(ImWchar, 32),
    };
    if font.FallbackChar == 0 {
        ImWchar* zz_rf_it_27 = &fallback_chars[0];
        ImWchar* zz_rf_end_27 = &fallback_chars[0] + sizeof(fallback_chars) / sizeof(*fallback_chars);
        for ; zz_rf_it_27 != zz_rf_end_27; zz_rf_it_27++ {
            ImWchar candidate_char = *zz_rf_it_27;
            if candidate_char != 0 && ImFont_IsGlyphInFont(font, candidate_char) {
                font.FallbackChar = cast(ImWchar, candidate_char);
                break;
            }
        }
    }
    ImWchar[3] ellipsis_chars = {src.EllipsisChar, cast(ImWchar, 0x2026), cast(ImWchar, 0x0085)};
    if font.EllipsisChar == 0 {
        ImWchar* zz_rf_it_28 = &ellipsis_chars[0];
        ImWchar* zz_rf_end_28 = &ellipsis_chars[0] + sizeof(ellipsis_chars) / sizeof(*ellipsis_chars);
        for ; zz_rf_it_28 != zz_rf_end_28; zz_rf_it_28++ {
            ImWchar candidate_char = *zz_rf_it_28;
            if candidate_char != 0 && ImFont_IsGlyphInFont(font, candidate_char) {
                font.EllipsisChar = candidate_char;
                break;
            }
        }
    }
    if font.EllipsisChar == 0 {
        font.EllipsisChar = 0x0085;
        font.EllipsisAutoBake = true;
    }
}

void ImFontAtlasBakedDiscardFontGlyph(ImFontAtlas* atlas, ImFont* font, ImFontBaked* baked, ImFontGlyph* glyph) {
    if glyph.PackId != -1 {
        ImFontAtlasPackDiscardRect(atlas, glyph.PackId);
        glyph.PackId = -1;
    }
    var c = cast(ImWchar, glyph.Codepoint);
    assert(font.FallbackChar != c && font.EllipsisChar != c);
    assert(glyph >= baked.Glyphs.Data && glyph < baked.Glyphs.Data + baked.Glyphs.Size);
    ignore font;
    baked.IndexLookup.Data[c] = cast(ImU16, -1);
    baked.IndexAdvanceX.Data[c] = baked.FallbackAdvanceX;
}

ImFontBaked* ImFontAtlasBakedAdd(ImFontAtlas* atlas, ImFont* font, f32 font_size, f32 font_rasterizer_density, ImGuiID baked_id) {
