    var count = cast(i64, it_last - it);
    var off = cast(i64, it - self.Data);
    memmove(self.Data + off, self.Data + off + count, (cast(u64, self.Size) - cast(u64, off) - cast(u64, count)) * cast(u64, sizeof(ImVec2)));
