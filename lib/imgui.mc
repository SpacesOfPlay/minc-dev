//-----------------------------------------------------------------------------
// [SECTION] Macros
//-----------------------------------------------------------------------------
// Internal Drag and Drop payload types. String starting with '_' are reserved for Dear ImGui.
// Debug Printing Into TTY
// (since IMGUI_VERSION_NUM >= 18729: IMGUI_DEBUG_LOG was reworked into IMGUI_DEBUG_PRINTF (and removed framecount from it). If you were using a #define IMGUI_DEBUG_LOG please rename)
when !(defined(IMGUI_DEBUG_PRINTF)) {
}
// Debug Logging for ShowDebugLogWindow(). This is designed for relatively rare events so please don't spam.
// Debug options (also see ones on top of imgui.cpp)
//#define IMGUI_DEBUG_BOXSELECT
// Static Asserts
// "Paranoid" Debug Asserts are meant to only be enabled during specific debugging/work, otherwise would slow down the code too much.
// We currently don't have many of those so the effect is currently negligible, but onward intent to add more aggressive ones in the code.
//#define IMGUI_DEBUG_PARANOID
// Misc Macros
//#define IM_FLOOR IM_TRUNC             // [OBSOLETE] Renamed in 1.90.0 (Sept 2023)
// Hint for branch prediction
// Enforce cdecl calling convention for functions called by the standard library, in case compilation settings changed the default to e.g. __vectorcall
// Warnings
// Debug Tools
// Use 'Metrics/Debugger->Tools->Item Picker' to break into the call-stack of a specific item.
// This will call IM_DEBUG_BREAK() which you may redefine yourself. See https://github.com/scottt/debugbreak for more reference.
when !(defined(IM_DEBUG_BREAK)) {
}
// Format specifiers, printing 64-bit hasn't been decently standardized...
// In a real application you should be using PRId64 and PRIu64 from <inttypes.h> (non-windows) and on Windows define them yourself.
// Helpers: Sorting
when !(defined(ImQsort)) {

void ImQsort(void* base, u64 count, u64 size_of_element, fn(void*, void*): i32 compare_func) {
    if count > 1 {
        qsort(base, count, size_of_element, compare_func);
    }
}
}

bool ImIsPowerOfTwo(i32 v) {
    return v != 0 && (v & v - 1) == 0;
}

bool ImIsPowerOfTwo(ImU64 v) {
    return v != 0 && (v & v - 1) == 0;
}

i32 ImUpperPowerOfTwo(i32 v) {
    v--;
    v |= v >> 1;
    v |= v >> 2;
    v |= v >> 4;
    v |= v >> 8;
    v |= v >> 16;
    v++;
    return v;
}

u32 ImCountSetBits(u32 v) {
    u32 count = 0;
    while v > 0 {
        v = v & v - 1;
        count++;
    }
    return count;
}

u8 ImToUpper(u8 c) {
    return cast(u8, c >= 97 && c <= 122 ? cast(i32, c) & ~32 : c);
}

bool ImCharIsBlankA(u8 c) {
    return c == 32 || c == 9;
}

bool ImCharIsBlankW(u32 c) {
    return c == 32 || c == 9 || c == 0x3000;
}

bool ImCharIsXdigitA(u8 c) {
    return c >= 48 && c <= 57 || c >= 65 && c <= 70 || c >= 97 && c <= 102;
}

ImFileHandle ImFileOpen(u8* _0, u8* _1) {
    return null;
}

bool ImFileClose(ImFileHandle _0) {
    return false;
}

ImU64 ImFileGetSize(ImFileHandle _0) {
    return cast(ImU64, -1);
}

ImU64 ImFileRead(void* _0, ImU64 _1, ImU64 _2, ImFileHandle _3) {
    return 0;
}

ImU64 ImFileWrite(void* _0, ImU64 _1, ImU64 _2, ImFileHandle _3) {
    return 0;
}
// Helpers: Maths
// - Wrapper for standard libs functions. (Note that imgui_demo.cpp does _not_ use them to keep the code easy to copy)
when !(defined(IMGUI_DISABLE_DEFAULT_MATH_FUNCTIONS)) {

f32 ImPow(f32 x, f32 y) {
    return pow(x, y);
}

f64 ImPow(f64 x, f64 y) {
    return pow(x, y);
}

f32 ImLog(f32 x) {
    return log(x);
}

f64 ImLog(f64 x) {
    return log(x);
}

i32 ImAbs(i32 x) {
    return x < 0 ? -x : x;
}

f32 ImAbs(f32 x) {
    return fabs(x);
}

f64 ImAbs(f64 x) {
    return fabs(x);
}

f32 ImSign(f32 x) {
    return x < 0.0f ? -1.0f : x > 0.0f ? 1.0f : 0.0f;
}

f64 ImSign(f64 x) {
    return x < 0.0 ? -1.0 : x > 0.0 ? 1.0 : 0.0;
}

f32 ImRsqrt(f32 x) {
    return 1.0f / sqrt(x);
}

f64 ImRsqrt(f64 x) {
    return 1.0 / sqrt(x);
}
}

// - ImMin/ImMax/ImClamp/ImLerp/ImSwap are used by widgets which support variety of types: signed/unsigned int/long long float/double
// (Exceptionally using templates here but we could also redefine them for those types)
f32 ImMin(f32 lhs, f32 rhs) {
    return lhs < rhs ? lhs : rhs;
}

i32 ImMin(i32 lhs, i32 rhs) {
    return lhs < rhs ? lhs : rhs;
}

f32 ImMax(f32 lhs, f32 rhs) {
    return lhs >= rhs ? lhs : rhs;
}

i32 ImMax(i32 lhs, i32 rhs) {
    return lhs >= rhs ? lhs : rhs;
}

f32 ImClamp(f32 v, f32 mn, f32 mx) {
    return v < mn ? mn : v > mx ? mx : v;
}

i32 ImClamp(i32 v, i32 mn, i32 mx) {
    return v < mn ? mn : v > mx ? mx : v;
}

f32 ImLerp(f64 a, f64 b, f32 t) {
    return cast(f32, a + (b - a) * cast(f64, t));
}

i32 ImLerp_f64_unused(f64 a, f64 b, f32 t) {
    return cast(i32, a + (b - a) * cast(f64, t));
}

f32 ImLerp(f32 a, f32 b, f32 t) {
    return a + (b - a) * t;
}

i32 ImLerp(i32 a, i32 b, f32 t) {
    return cast(i32, cast(f32, a) + cast(f32, b - a) * t);
}

void ImSwap(f32* a, f32* b) {
    f32 tmp = *a;
    *a = *b;
    *b = tmp;
}

void ImSwap(i32* a, i32* b) {
    i32 tmp = *a;
    *a = *b;
    *b = tmp;
}

f32 ImAddClampOverflow(f32 a, f32 b, f32 mn, f32 mx) {
    if b < 0.0f && a < mn - b {
        return mn;
    }
    if b > 0.0f && a > mx - b {
        return mx;
    }
    return a + b;
}

i32 ImAddClampOverflow(i32 a, i32 b, i32 mn, i32 mx) {
    if b < 0 && a < mn - b {
        return mn;
    }
    if b > 0 && a > mx - b {
        return mx;
    }
    return a + b;
}

f32 ImSubClampOverflow(f32 a, f32 b, f32 mn, f32 mx) {
    if b > 0.0f && a < mn + b {
        return mn;
    }
    if b < 0.0f && a > mx + b {
        return mx;
    }
    return a - b;
}

i32 ImSubClampOverflow(i32 a, i32 b, i32 mn, i32 mx) {
    if b > 0 && a < mn + b {
        return mn;
    }
    if b < 0 && a > mx + b {
        return mx;
    }
    return a - b;
}

ImVec2 ImMin(ImVec2 lhs, ImVec2 rhs) {
    return ImVec2{lhs.x < rhs.x ? lhs.x : rhs.x, lhs.y < rhs.y ? lhs.y : rhs.y};
}

ImVec2 ImMax(ImVec2 lhs, ImVec2 rhs) {
    return ImVec2{lhs.x >= rhs.x ? lhs.x : rhs.x, lhs.y >= rhs.y ? lhs.y : rhs.y};
}

ImVec2 ImClamp(ImVec2 v, ImVec2 mn, ImVec2 mx) {
    return ImVec2{
        v.x < mn.x ? mn.x : v.x > mx.x ? mx.x : v.x, v.y < mn.y ? mn.y : v.y > mx.y ? mx.y : v.y,
    };
}

ImVec2 ImLerp(ImVec2 a, ImVec2 b, f32 t) {
    return ImVec2{a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t};
}

ImVec2 ImLerp(ImVec2 a, ImVec2 b, ImVec2 t) {
    return ImVec2{a.x + (b.x - a.x) * t.x, a.y + (b.y - a.y) * t.y};
}

ImVec4 ImLerp(ImVec4 a, ImVec4 b, f32 t) {
    return ImVec4{
        a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t, a.w + (b.w - a.w) * t,
    };
}

f32 ImSaturate(f32 f) {
    return f < 0.0f ? 0.0f : f > 1.0f ? 1.0f : f;
}

f32 ImLengthSqr(ImVec2 lhs) {
    return lhs.x * lhs.x + lhs.y * lhs.y;
}

f32 ImLengthSqr(ImVec4 lhs) {
    return lhs.x * lhs.x + lhs.y * lhs.y + lhs.z * lhs.z + lhs.w * lhs.w;
}

f32 ImInvLength(ImVec2 lhs, f32 fail_value) {
    f32 d = lhs.x * lhs.x + lhs.y * lhs.y;
    if d > 0.0f {
        return ImRsqrt(d);
    }
    return fail_value;
}

f32 ImTrunc(f32 f) {
    return cast(f32, cast(i32, f));
}

ImVec2 ImTrunc(ImVec2 v) {
    return ImVec2{cast(f32, cast(i32, v.x)), cast(f32, cast(i32, v.y))};
}

f32 ImFloor(f32 f) {
    return cast(f32, f >= 0.0f || cast(f32, cast(i32, f)) == f ? cast(i32, f) : cast(i32, f) - 1);
}

ImVec2 ImFloor(ImVec2 v) {
    return ImVec2{ImFloor(v.x), ImFloor(v.y)};
}

f32 ImTrunc64(f32 f) {
    return cast(f32, cast(ImS64, f));
}

f32 ImRound64(f32 f) {
    return cast(f32, cast(ImS64, f + 0.5f));
}

f32 ImCeilFast(f32 f) {
    var i = cast(i32, f);
    return cast(f32, i + cast(i32, f > cast(f32, i)));
}

i32 ImModPositive(i32 a, i32 b) {
    return (a + b) % b;
}

f32 ImDot(ImVec2 a, ImVec2 b) {
    return a.x * b.x + a.y * b.y;
}

ImVec2 ImRotate(ImVec2 v, f32 cos_a, f32 sin_a) {
    return ImVec2{v.x * cos_a - v.y * sin_a, v.x * sin_a + v.y * cos_a};
}

f32 ImLinearSweep(f32 current, f32 target, f32 speed) {
    if current < target {
        return ImMin(current + speed, target);
    }
    if current > target {
        return ImMax(current - speed, target);
    }
    return current;
}

f32 ImLinearRemapClamp(f32 s0, f32 s1, f32 d0, f32 d1, f32 x) {
    return ImSaturate((x - s0) / (s1 - s0)) * (d1 - d0) + d0;
}

ImVec2 ImMul(ImVec2 lhs, ImVec2 rhs) {
    return ImVec2{lhs.x * rhs.x, lhs.y * rhs.y};
}

bool ImIsFloatAboveGuaranteedIntegerPrecision(f32 f) {
    return f <= -16777216.0f || f >= 16777216.0f;
}

f32 ImExponentialMovingAverage(f32 avg, f32 sample, i32 n) {
    avg -= avg / cast(f32, n);
    avg += sample / cast(f32, n);
    return avg;
}

f32 ImTriangleArea(ImVec2 a, ImVec2 b, ImVec2 c) {
    return fabs(a.x * (b.y - c.y) + b.x * (c.y - a.y) + c.x * (a.y - b.y)) * 0.5f;
}

bool ImTriangleIsClockwise(ImVec2 a, ImVec2 b, ImVec2 c) {
    return (b.x - a.x) * (c.y - b.y) - (c.x - b.x) * (b.y - a.y) > 0.0f;
}

