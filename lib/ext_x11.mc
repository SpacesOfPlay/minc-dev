u64 DefaultRootWindow(Display* display) { return XDefaultRootWindow(display); }
i32 DefaultScreen(Display* display) { return XDefaultScreen(display); }
i32 DefaultDepth(Display* display, i32 screen) { return XDefaultDepth(display, screen); }
Visual* DefaultVisual(Display* display, i32 screen) { return XDefaultVisual(display, screen); }
i32 DisplayWidth(Display* display, i32 screen) { return XDisplayWidth(display, screen); }
i32 DisplayHeight(Display* display, i32 screen) { return XDisplayHeight(display, screen); }
