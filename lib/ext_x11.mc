// --- type aliases ---
type XErrorHandler = fn(Display*, XErrorEvent*): i32;

// --- real XDefault*/XDisplay* used by the macro wrappers ---
extern "libX11.so.6" {
    i32 XDefaultScreen(Display* display);
    u64 XDefaultRootWindow(Display* display);
    Visual* XDefaultVisual(Display* display, i32 screen);
    i32 XDefaultDepth(Display* display, i32 screen);
    i32 XDisplayWidth(Display* display, i32 screen);
    i32 XDisplayHeight(Display* display, i32 screen);
}
// Core keycode range; a fallback for when XkbGetMap(which=0) returns
// an empty descriptor (e.g. under Xwayland).
extern "libX11.so.6" i32 XDisplayKeycodes(Display* display, i32* min_keycodes, i32* max_keycodes);

// --- entry points (real .so bindings) ---
extern "libX11.so.6" {
    u64 XInternAtom(Display* display, u8* name, i32 only_if_exists);
    XErrorHandler XSetErrorHandler(XErrorHandler handler);
    i32 XSync(Display* display, i32 discard);
    void* XOpenDisplay(u8* name);
    i32 XCloseDisplay(Display* display);
    u64 XCreateWindow(Display* display, u64 parent, i32 x, i32 y, u32 width, u32 height, u32 border_width, i32 depth, u32 class, Visual* visual, u64 valuemask, XSetWindowAttributes* attrs);
    i32 XDestroyWindow(Display* display, u64 window);
    i32 XMapWindow(Display* display, u64 window);
    i32 XUnmapWindow(Display* display, u64 window);
    i32 XFlush(Display* display);
    i32 XPending(Display* display);
    i32 XNextEvent(Display* display, XEvent* event);
    i32 XChangeProperty(Display* display, u64 window, u64 property, u64 type, i32 format, i32 mode, u8* data, i64 nelements);
    i32 XSetWMProtocols(Display* display, u64 window, u64* protocols, i32 count);
    void XSetWMNormalHints(Display* display, u64 window, XSizeHints* hints);
    i32 XFree(void* data);
    u64 XCreateColormap(Display* display, u64 window, Visual* visual, i32 alloc);
    i32 XFreeColormap(Display* display, u64 colormap);
    i32 XGetWindowAttributes(Display* display, u64 window, XWindowAttributes* attrs);
    u64* XGetKeyboardMapping(Display* display, i32 first_keycode, i32 keycode_count, i32* keysyms_per_keycode);
    i32 XGetWindowProperty(Display* display, u64 window, u64 property, i64 long_offset, i64 long_length, i32 delete, u64 req_type, u64* actual_type, i32* actual_format, u64* nitems, u64* bytes_after, u8** prop);
    u8* XResourceManagerString(Display* display);
    void* XrmGetStringDatabase(u8* data);
    i32 XrmGetResource(void* db, u8* name, u8* class, u8** type, void* value);
    void XrmDestroyDatabase(void* db);
    i32 XInitThreads();
    void XrmInitialize();
    i32 XkbSetDetectableAutoRepeat(Display* display, i32 detectable, i32* supported);
    void* XAllocSizeHints();
    i32 XLookupString(XKeyEvent* event, u8* buffer, i32 bytes, u64* keysym, void* compose);
}
